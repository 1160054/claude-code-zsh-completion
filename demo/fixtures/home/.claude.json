{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "postgres": {
      "command": "uvx",
      "args": ["mcp-server-postgres"]
    },
    "sentry": {
      "type": "sse",
      "url": "https://mcp.sentry.dev/sse"
    }
  }
}
