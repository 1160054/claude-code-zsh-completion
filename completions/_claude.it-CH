#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Configurare e gestire server MCP'
    'plugin:Gestire plugin Claude Code'
    'agents:Gestire agenti in background'
    'attach:Aprire una sessione in background in questo terminale'
    'logs:Stampare l'\''output recente del terminale di una sessione in background'
    'stop:Fermare una sessione in background (la conversazione viene conservata)'
    'respawn:Riavviare una sessione in background perché esegua la versione corrente di Claude Code'
    'rm:Eliminare una sessione in background, e il suo worktree quando è sicuro farlo'
    'auth:Gestire autenticazione'
    'auto-mode:Ispezionare o reimpostare la configurazione del classificatore della modalità automatica'
    'gateway:Avviare il gateway aziendale di autenticazione/telemetria'
    'import:Importare la configurazione di un altro agente di programmazione IA in Claude Code'
    'project:Gestire lo stato del progetto Claude Code'
    'ultrareview:Eseguire una revisione del codice multi-agente ospitata nel cloud e stampare i risultati'
    'setup-token:Configurare token di autenticazione a lungo termine (richiede abbonamento Claude)'
    'doctor:Verifica stato per aggiornatore automatico Claude Code'
    'update:Verificare e installare aggiornamenti'
    'install:Installare build nativa Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Attivare modalità debug con filtraggio opzionale per categoria (es: "api,hooks" o "!statsig,!file")]:filter:'
    '--verbose[Sovrascrivere impostazione modalità dettagliata dal file di configurazione]'
    '(-p --print)'{-p,--print}'[Stampare risposta e uscire (per uso con pipe). Nota: usare solo in directory sicure]'
    '--output-format[Formato output (con --print): "text" (predefinito), "json" (risultato singolo), o "stream-json" (streaming in tempo reale)]:format:(text json stream-json)'
    '--json-schema[Schema JSON per validazione output strutturato]:schema:'
    '--include-partial-messages[Includere frammenti di messaggi parziali man mano che arrivano (con --print e --output-format=stream-json)]'
    '--input-format[Formato input (con --print): "text" (predefinito) o "stream-json" (input streaming in tempo reale)]:format:(text stream-json)'
    '--mcp-debug[\[Deprecato. Usare --debug invece\] Attivare modalità debug MCP (mostra errori server MCP)]'
    '--dangerously-skip-permissions[Saltare tutti i controlli di permessi. Consigliato solo per sandbox senza accesso a internet]'
    '--allow-dangerously-skip-permissions[Abilitare opzione per saltare controlli di permessi senza abilitare per impostazione predefinita]'
    '--restricted[Modalità ristretta: rimuovere gli strumenti che eseguono comandi o codice e WebFetch, ignorare le impostazioni user/project/local e limitare gli strumenti per i file alle directory di lavoro]'
    '--max-budget-usd[Importo massimo in dollari da spendere per le chiamate API (solo --print)]:amount:'
    '--replay-user-messages[Rinviare messaggi utente da stdin su stdout per conferma]'
    '--allowed-tools[Elenco separato da virgole o spazi di nomi di strumenti consentiti (es: "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Elenco separato da virgole o spazi di nomi di strumenti consentiti (formato camelCase)]:tools:'
    '--tools[Specificare elenco di strumenti disponibili dal set integrato. Solo modalità stampa]:tools:'
    '--disallowed-tools[Elenco separato da virgole o spazi di nomi di strumenti non consentiti (es: "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Elenco separato da virgole o spazi di nomi di strumenti non consentiti (formato camelCase)]:tools:'
    '--mcp-config[Caricare server MCP da file JSON o stringa (separati da spazi)]:configs:'
    '--system-prompt[Prompt di sistema da usare per la sessione]:prompt:'
    '--system-prompt-file[Leggere il prompt di sistema da un file]:file:_files'
    '--append-system-prompt[Aggiungere prompt di sistema al prompt di sistema predefinito]:prompt:'
    '--append-system-prompt-file[Leggere il prompt di sistema da un file e aggiungerlo al prompt di sistema predefinito]:file:_files'
    '--system-prompt-snapshot[Registrare il prompt di sistema una volta per conversazione e riutilizzarlo tale e quale a ogni richiesta e ripresa (on, predefinito) oppure rigenerarlo a ogni richiesta (off)]:mode:(on off)'
    '--permission-mode[Modalità permessi da usare per la sessione]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Chi risponde alle richieste di permesso con --print: "host" (l'\''host SDK o --permission-prompt-tool) oppure "none" (tutto ciò che richiederebbe una conferma viene negato)]:target:(host none)'
    '--permission-prompt-tool[Strumento MCP da usare per le richieste di permesso (solo --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Continuare la conversazione più recente]'
    '(-r --resume)'{-r,--resume}'[Riprendere una conversazione - specificare ID sessione o selezionare interattivamente]:sessionId:_claude_sessions'
    '--fork-session[Creare nuovo ID sessione invece di riutilizzare ID sessione originale quando si riprende (con --resume o --continue)]'
    '--no-session-persistence[Disabilitare la persistenza della sessione - le sessioni non verranno salvate (solo --print)]'
    '--model[Modello per sessione corrente. Specificare alias per modello più recente (es: '\''sonnet'\'' o '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agente per la sessione corrente. Sovrascrive l'\''impostazione '\''agent'\'']:agent:_claude_agent_names'
    '--betas[Intestazioni beta da includere nelle richieste API (solo utenti con chiave API)]:betas:'
    '--fallback-model[Abilitare fallback automatico al modello specificato quando il modello predefinito è sovraccarico (solo --print)]:model:_claude_model_names'
    '--settings[Percorso a file JSON di impostazioni o stringa JSON per caricare impostazioni aggiuntive]:file-or-json:_files'
    '--add-dir[Directory aggiuntive per consentire accesso agli strumenti]:directories:_directories'
    '--ide[Connessione automatica all'\''IDE all'\''avvio se esattamente un IDE valido è disponibile]'
    '--desktop[Aprire nell'\''app Claude Desktop invece che nel terminale (con --continue o --resume <id> per scegliere la sessione)]'
    '--strict-mcp-config[Usare solo server MCP da --mcp-config e ignorare tutte le altre impostazioni MCP]'
    '--session-id[ID sessione specifico da usare per la conversazione (deve essere UUID valido)]:uuid:'
    '--agents[Oggetto JSON che definisce agenti personalizzati]:json:'
    '--setting-sources[Elenco separato da virgole di sorgenti di impostazioni da caricare (user, project, local)]:sources:'
    '--plugin-dir[Directory per caricare plugin solo per questa sessione (ripetibile)]:paths:_directories'
    '--disable-slash-commands[Disabilitare tutti i comandi slash]'
    '(--bg --background)'{--bg,--background}'[Avviare la sessione come agente in background e ritornare immediatamente]'
    '(-w --worktree)'{-w,--worktree}'[Creare un nuovo git worktree per questa sessione (opzionalmente specificare un nome)]::name:'
    '--tmux=-[Creare una sessione tmux per il worktree (richiede --worktree). Usa i pannelli nativi di iTerm2 quando disponibili; --tmux=classic per il tmux tradizionale]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Impostare un nome visualizzato per questa sessione]:name:'
    '--effort[Livello di impegno per la sessione corrente]:level:(low medium high xhigh max)'
    '--autocompact[Dimensione della finestra di compattazione automatica (auto, oppure da 100k a 1M di token)]:size:(auto)'
    '--debug-file[Scrivere i log di debug in un percorso di file specifico (attiva implicitamente la modalità debug)]:path:_files'
    '--from-pr[Riprendere una sessione collegata a una PR per numero/URL, o aprire il selettore interattivo]::value:'
    '--teleport[Riprendere una sessione teleport, opzionalmente specificare l'\''ID sessione]::session:'
    '--cloud[Creare una sessione cloud con la descrizione indicata, oppure collegarsi a una esistente tramite ID sessione o URL claude.ai/code]::description-or-session:'
    '--environment[Creare una nuova sessione cloud eseguita nell'\''ambiente self-hosted indicato (ccpool_...)]:environment_id:'
    '--remote-control[Avviare una sessione interattiva con Remote Control abilitato (opzionalmente con nome)]::name:'
    '--remote-control-session-name-prefix[Prefisso per i nomi delle sessioni Remote Control generati automaticamente]:prefix:'
    '--chrome[Abilitare l'\''integrazione di Claude in Chrome]'
    '--no-chrome[Disabilitare l'\''integrazione di Claude in Chrome]'
    '--plugin-url[Recuperare un file .zip di plugin da un URL solo per questa sessione (ripetibile)]:url:'
    '--file[Risorse file da scaricare all'\''avvio (formato: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Abilitare i suggerimenti di prompt (emette un prompt successivo previsto in modalità print/SDK)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Inoltrare il testo e i blocchi di ragionamento dei subagenti come messaggi (con --print e stream-json)]'
    '--include-hook-events[Includere tutti gli eventi del ciclo di vita degli hook nel flusso di output (con stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Spostare le sezioni per-macchina nel primo messaggio utente per migliorare il riutilizzo della cache dei prompt]'
    '--brief[Abilitare lo strumento SendUserMessage per la comunicazione agente-utente]'
    '--safe-mode[Avviare con tutte le personalizzazioni disabilitate (utile per risolvere una configurazione danneggiata)]'
    '--bare[Modalità minima: saltare hook, LSP, sincronizzazione plugin, attribuzione, auto-memory e rilevamento automatico di CLAUDE.md]'
    '--ax-screen-reader[Generare output compatibile con gli screen reader (testo semplice, senza bordi decorativi o animazioni)]'
    '(-v --version)'{-v,--version}'[Visualizzare numero di versione]'
    '(-h --help)'{-h,--help}'[Visualizzare aiuto per il comando]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude commands' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto per il comando]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "nessun argomento"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Avviare un server MCP Claude Code'
    'add:Aggiungere un server MCP a Claude Code'
    'remove:Rimuovere un server MCP'
    'list:Elencare server MCP configurati'
    'get:Ottenere dettagli server MCP'
    'add-json:Aggiungere un server MCP (stdio o SSE) con stringa JSON'
    'add-from-claude-desktop:Importare server MCP da Claude Desktop (solo Mac e WSL)'
    'reset-project-choices:Ripristinare tutti i server con ambito di progetto (.mcp.json) approvati/rifiutati in questo progetto'
    'login:Autenticare con un server MCP (HTTP, SSE o connettore claude.ai)'
    'logout:Cancellare le credenziali OAuth memorizzate per un server MCP'
    'help:Visualizzare aiuto'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp commands' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Attivare modalità debug]' \
            '--verbose[Sovrascrivere impostazione modalità dettagliata dal file di configurazione]' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambito configurazione (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Tipo trasporto (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Impostare variabile d'\''ambiente (es: -e CHIAVE=valore)]:env:' \
            '(-H --header)'{-H,--header}'[Impostare intestazione WebSocket]:header:' \
            '--client-id[ID client OAuth per i server HTTP/SSE]:clientId:' \
            '--client-secret[Richiedere il client secret OAuth (oppure impostare la variabile d'\''ambiente MCP_CLIENT_SECRET)]' \
            '--callback-port[Porta fissa per il callback OAuth (per server che richiedono URI di reindirizzamento preregistrati)]:port:' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambito configurazione (local, user, project) - rimuovere da ambito esistente se non specificato]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambito configurazione (local, user, project)]:scope:(local user project)' \
            '--client-secret[Richiedere il client secret OAuth (oppure impostare la variabile d'\''ambiente MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambito configurazione (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]'
          ;;
        login)
          _arguments \
            '--no-browser[Stampare l'\''URL di autorizzazione invece di aprire un browser (per sessioni SSH/headless)]' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Validare un plugin o manifesto marketplace'
    'marketplace:Gestire marketplace Claude Code'
    'list:Elencare plugin installati'
    'details:Mostrare l'\''inventario dei componenti e il costo previsto in token per un plugin'
    'configure:Mostrare le opzioni di un plugin e quali non sono impostate, oppure salvare i valori da stdin'
    'install:Installare un plugin dai marketplace disponibili'
    'i:Installare un plugin dai marketplace disponibili (forma breve di install)'
    'init:Creare la struttura di un nuovo plugin (caricato automaticamente alla sessione successiva)'
    'new:Creare la struttura di un nuovo plugin (alias per init)'
    'uninstall:Disinstallare un plugin installato'
    'remove:Disinstallare un plugin installato (alias per uninstall)'
    'enable:Abilitare un plugin disabilitato'
    'disable:Disabilitare un plugin abilitato'
    'update:Aggiornare un plugin all'\''ultima versione'
    'eval:Eseguire casi di valutazione su un plugin e riportare i risultati con punteggio'
    'prune:Rimuovere le dipendenze installate automaticamente che non sono più necessarie'
    'autoremove:Rimuovere le dipendenze installate automaticamente che non sono più necessarie (alias per prune)'
    'tag:Creare un tag git {name}--v{version} per il rilascio di un plugin'
    'test:Eseguire i test di un mod'
    'help:Visualizzare aiuto'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin commands' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Trattare gli avvisi come errori (codice di uscita 1)]' \
            '--json[Stampare il rapporto di validazione come JSON (stessi codici di uscita)]' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambito installazione]:scope:(user project local)' \
            '*--config[Impostare un'\''opzione userConfig dichiarata nel manifesto del plugin (ripetibile)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Accettare il comando dichiarato dal marketplace mostrato senza richiesta di conferma]' \
            '--json[Stampare una riga di risultato leggibile dalla macchina invece del messaggio per le persone]' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambito installazione]:scope:(user project local)' \
            '--keep-data[Conservare la directory dei dati persistenti del plugin]' \
            '--prune[Rimuovere anche le dipendenze installate automaticamente che non sono più necessarie]' \
            '(-y --yes)'{-y,--yes}'[Saltare la richiesta di conferma di --prune]' \
            '--json[Stampare una riga di risultato leggibile dalla macchina invece del messaggio per le persone (non con --prune)]' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambito installazione]:scope:(user project local)' \
            '--json[Stampare una riga di risultato leggibile dalla macchina invece del messaggio per le persone]' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Disabilitare tutti i plugin abilitati]' \
            '(-s --scope)'{-s,--scope}'[Ambito installazione]:scope:(user project local)' \
            '--json[Stampare una riga di risultato leggibile dalla macchina invece del messaggio per le persone]' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambito installazione]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Accettare il comando dichiarato dal marketplace mostrato senza richiesta di conferma]' \
            '--json[Stampare una riga di risultato leggibile dalla macchina invece del messaggio per le persone]' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Output come JSON]' \
            '--available[Includere i plugin disponibili dai marketplace (richiede --json)]' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambito in cui eseguire la pulizia]:scope:(user project local)' \
            '--dry-run[Elencare cosa verrebbe rimosso senza rimuovere nulla]' \
            '(-y --yes)'{-y,--yes}'[Saltare la richiesta di conferma]' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]'
          ;;
        configure)
          _arguments \
            '--json[Output come JSON]' \
            '--values-stdin[Leggere i valori delle opzioni da stdin come oggetto JSON di stringhe su una riga; le opzioni omesse mantengono il loro valore]' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Descrizione del manifesto]:text:' \
            '--author[Nome dell'\''autore (predefinito: git config user.name)]:name:' \
            '--author-email[Email dell'\''autore (predefinito: git config user.email)]:email:' \
            '--with[Componenti di cui creare anche la struttura]:components:' \
            '(-f --force)'{-f,--force}'[Sovrascrivere un .claude-plugin/ esistente nella destinazione]' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Filtrare i casi per glob del nome]:glob:' \
            '*--tag[Filtrare i casi per tag (ripetibile)]:tag:' \
            '--runs[Sovrascrivere il numero di esecuzioni per caso (predefinito: case.runs, altrimenti 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Eseguire fino a n esecuzioni dell'\''agente contemporaneamente (1-8; predefinito 1)]:n:' \
            '--model[Sovrascrivere il modello per tutti i casi]:model:_claude_model_names' \
            '--judge-model[Sovrascrivere il modello del valutatore LLM (predefinito: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Tetto massimo di costo; se raggiunto, interrompere e riportare i risultati parziali (codice di uscita 2)]:usd:' \
            '--output-dir[Directory per aggregate-result.json]:dir:_directories' \
            '--eval-dir[Nome della directory (sotto il plugin) che contiene i casi di valutazione]:dir:' \
            '--json[Stampare il risultato completo dell'\''esecuzione come JSON su stdout, oppure scriverlo in questo file .json]::path:_files' \
            '--threshold[Uscire con codice di uscita 1 se il punteggio di un caso è sotto questa soglia (predefinito: 1.0)]:threshold:' \
            '*--allow-tools[Autorizzazione dell'\''operatore per gli strumenti soggetti ad approvazione (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Eseguire lo scaffold_script di ogni caso (esegue bash fornito dall'\''autore con il tuo account; disattivato per impostazione predefinita)]' \
            '(--scaffold)--no-scaffold[Saltare esplicitamente scaffold_script]' \
            '--trust-plugin[Dichiarare di fidarsi di questo plugin e della sua suite di valutazione, saltando la richiesta di fiducia alla prima esecuzione (per la CI)]' \
            '--ablation[Eseguire anche un gruppo di controllo senza plugin e riportare la differenza di punteggio]:mode:(none with-without)' \
            '--mocks[Sostituti simulati (mock) dei server MCP, da <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Con --mocks record: avviare anche i processi reali dei server MCP che non hanno un mock]' \
            '--keep-temp[Conservare le directory di struttura per il debug]' \
            '--verbose[Registrare gli eventi di traccia per messaggio nel log di debug]' \
            '--report[Scrivere il rapporto HTML autonomo in questo percorso invece che nella directory dei risultati]:path:_files' \
            '(--no-publish)--publish-report[Richiedere anche la pubblicazione del rapporto su claude.ai]' \
            '(--publish-report)--no-publish[Mantenere il rapporto HTML solo in locale; non pubblicarlo su claude.ai]' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Eseguire il push del tag su --remote dopo averlo creato]' \
            '--dry-run[Stampare cosa verrebbe taggato senza creare il tag]' \
            '(-f --force)'{-f,--force}'[Saltare i controlli su albero di lavoro con modifiche e tag già esistente]' \
            '(-m --message)'{-m,--message}'[Messaggio di annotazione del tag (usare %s per la versione)]:msg:' \
            '--remote[Remote su cui eseguire il push con --push]:name:' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Aggiungere un marketplace da URL, percorso o repository GitHub'
    'list:Elencare marketplace configurati'
    'remove:Rimuovere un marketplace configurato'
    'rm:Rimuovere un marketplace configurato (alias per remove)'
    'update:Aggiornare marketplace dalla fonte - aggiornare tutti se nessun nome specificato'
    'help:Visualizzare aiuto'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace commands' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Limitare il checkout a directory specifiche tramite git sparse-checkout (per i monorepo)]:paths:' \
            '--scope[Dove dichiarare il marketplace]:scope:(user project local)' \
            '--claudeai[Aggiungere il marketplace con questo nome che claude.ai ospita per te]' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Output come JSON]' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Rimuovere la dichiarazione del marketplace da un ambito di impostazioni specifico (omettere per rimuoverla da tutti gli ambiti)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Forzare installazione anche se già installato]' \
    '(-h --help)'{-h,--help}'[Visualizzare aiuto]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Directory aggiuntiva per consentire accesso agli strumenti nelle sessioni avviate]:directory:_directories' \
    '--agent[Agente predefinito per le sessioni avviate dalla vista agenti]:agent:_claude_agent_names' \
    '--all[Con --json: includere anche le sessioni in background completate]' \
    '--allow-dangerously-skip-permissions[Rendere disponibile la modalità bypass-permissions alle sessioni avviate]' \
    '--cwd[Mostrare solo le sessioni in background avviate sotto il percorso]:path:_directories' \
    '--dangerously-skip-permissions[Alias di --permission-mode bypassPermissions]' \
    '--effort[Livello di impegno predefinito per le sessioni avviate]:level:(low medium high xhigh max)' \
    '--json[Stampare le sessioni attive come array JSON e uscire]' \
    '*--mcp-config[Configurazione del server MCP da applicare alle sessioni avviate]:config:' \
    '--model[Modello predefinito per le sessioni avviate dalla vista agenti]:model:_claude_model_names' \
    '--permission-mode[Modalità permessi predefinita per le sessioni avviate]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Caricare plugin dalla directory per la vista agenti e le sessioni avviate]:path:_directories' \
    '--setting-sources[Elenco separato da virgole di sorgenti di impostazioni da caricare (user, project, local)]:sources:' \
    '--settings[File delle impostazioni o stringa JSON da applicare]:file-or-json:_files' \
    '--strict-mcp-config[Usare solo server MCP da --mcp-config nelle sessioni avviate]' \
    '--restricted[Eseguire le sessioni avviate in modalità ristretta]' \
    '(-h --help)'{-h,--help}'[Visualizzare aiuto per il comando]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Accedere al tuo account Anthropic'
    'logout:Disconnettere dal tuo account Anthropic'
    'status:Mostrare lo stato dell'\''autenticazione'
    'help:Visualizzare aiuto'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Visualizzare aiuto per il comando]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth commands' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Precompilare l'\''indirizzo email nella pagina di accesso]:email:' \
            '--sso[Forzare il flusso di accesso SSO]' \
            '(--claudeai)--console[Usare Anthropic Console (fatturazione in base all'\''uso dell'\''API) invece dell'\''abbonamento Claude]' \
            '(--console)--claudeai[Usare l'\''abbonamento Claude (predefinito)]' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto per il comando]'
          ;;
        status)
          _arguments \
            '(--text)--json[Output come JSON (predefinito)]' \
            '(--json)--text[Output come testo leggibile]' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto per il comando]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto per il comando]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Stampare la configurazione effettiva della modalità automatica come JSON'
    'critique:Ottenere feedback AI sulle tue regole personalizzate della modalità automatica'
    'defaults:Stampare le regole predefinite della modalità automatica come JSON'
    'reset:Reimpostare la configurazione della modalità automatica ai valori predefiniti di fabbrica'
    'help:Visualizzare aiuto'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Visualizzare aiuto per il comando]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode commands' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Sovrascrivere il modello utilizzato]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto per il comando]'
          ;;
        defaults)
          _arguments \
            '--label[Mostrare solo le regole la cui etichetta inizia con questo prefisso (senza distinzione tra maiuscole e minuscole)]:prefix:' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto per il comando]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Saltare la richiesta di conferma]' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto per il comando]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto per il comando]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Percorso al file di configurazione YAML del gateway]:path:_files' \
    '(-h --help)'{-h,--help}'[Visualizzare aiuto per il comando]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Eliminare tutto lo stato di Claude Code per un progetto (trascrizioni, task, cronologia dei file, voce di configurazione)'
    'help:Visualizzare aiuto'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Visualizzare aiuto per il comando]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project commands' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Elencare cosa verrebbe eliminato senza eliminare nulla]' \
            '(-y --yes)'{-y,--yes}'[Saltare la richiesta di conferma]' \
            '(-i --interactive)'{-i,--interactive}'[Chiedere conferma per ogni elemento prima di eliminarlo]' \
            '(1)--all[Eliminare lo stato di tutti i progetti (incompatibile con un percorso)]' \
            '(-h --help)'{-h,--help}'[Visualizzare aiuto per il comando]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Stampare il payload grezzo bugs.json invece dei risultati formattati]' \
    '--timeout[Minuti massimi di attesa per il completamento della revisione (predefinito: 45)]:minutes:' \
    '(--no-post)--post[Pubblicare i risultati della revisione completata sulla PR a tuo nome (solo destinazioni PR; un semplice commento, non una review)]' \
    '(--post)--no-post[Non pubblicare i risultati sulla PR (predefinito)]' \
    '(-h --help)'{-h,--help}'[Visualizzare aiuto per il comando]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Riavviare tutte le sessioni in background in esecuzione]' \
    '(-h --help)'{-h,--help}'[Visualizzare aiuto per il comando]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Scartare anche i commit non inviati e le modifiche non committate del worktree (passare il commit@worktree-id riportato da un precedente claude rm)]:commit@worktree-id:' \
    '--force-remove-worktree[Eliminare la directory del worktree anche se l'\''hook WorktreeRemove o git non sono riusciti a rimuoverla (passare il worktree-id riportato da un precedente claude rm)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Visualizzare aiuto per il comando]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Mostrare cosa verrebbe importato senza scrivere nulla]' \
    '--yes[Saltare il selettore interattivo (in ambienti headless, passare --yes=<digest> dall'\''anteprima di /import)]' \
    '(-h --help)'{-h,--help}'[Visualizzare aiuto per il comando]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
