#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Конфигуриране и управление на MCP сървъри'
    'plugin:Управление на плъгини на Claude Code'
    'agents:Управление на фонови агенти'
    'attach:Отваряне на фонова сесия в този терминал'
    'logs:Извеждане на последния терминален изход на фонова сесия'
    'stop:Спиране на фонова сесия (разговорът ѝ се запазва)'
    'respawn:Рестартиране на фонова сесия, за да работи с текущата версия на Claude Code'
    'rm:Изтриване на фонова сесия и нейния worktree, когато това е безопасно'
    'remote-control:Управление на локални сесии от claude.ai/code или мобилното приложение Claude'
    'daemon:Управление на супервайзора на фоновите сесии'
    'auth:Управление на автентикацията'
    'auto-mode:Преглед или нулиране на конфигурацията на класификатора за автоматичен режим'
    'gateway:Стартиране на корпоративния шлюз за автентикация/телеметрия'
    'self-hosted-runner:Хостване на облачни сесии на Claude Code на тази машина или контейнер'
    'import:Импортиране на конфигурация от друг AI агент за програмиране в Claude Code'
    'project:Управление на състоянието на проект на Claude Code'
    'purge:Изтриване на цялото състояние на Claude Code за проект (стенограми, задачи, история на файлове, конфигурационен запис)'
    'ultrareview:Изпълнение на облачно хостван преглед на код с множество агенти и извеждане на констатациите'
    'setup-token:Настройване на токен за дългосрочна автентикация (изисква Claude абонамент)'
    'doctor:Проверка на здравето на системата за автоматично обновяване на Claude Code'
    'update:Проверка и инсталиране на актуализации'
    'install:Инсталиране на нативна версия на Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Активиране на режим за отстраняване на грешки с опционално филтриране по категории (напр. "api,hooks" или "!statsig,!file")]:filter:'
    '--verbose[Презаписване на настройката за подробен режим от конфигурационния файл]'
    '(-p --print)'{-p,--print}'[Извеждане на отговор и изход (за използване с pipe). Забележка: използвайте само в доверени директории]'
    '--output-format[Формат на изхода (с --print): "text" (по подразбиране), "json" (единичен резултат), или "stream-json" (потоково предаване в реално време)]:format:(text json stream-json)'
    '--json-schema[JSON схема за валидиране на структуриран изход]:schema:'
    '--include-partial-messages[Включване на частични фрагменти от съобщения при тяхното пристигане (с --print и --output-format=stream-json)]'
    '--input-format[Формат на входа (с --print): "text" (по подразбиране) или "stream-json" (потоково въвеждане в реално време)]:format:(text stream-json)'
    '--dangerously-skip-permissions[Заобикаляне на всички проверки за разрешения. Препоръчително само за изолирани среди без интернет достъп]'
    '--allow-dangerously-skip-permissions[Активиране на опция за заобикаляне на проверки за разрешения без активиране по подразбиране]'
    '--restricted[Ограничен режим: премахва инструментите, които изпълняват команди или код, и WebFetch, игнорира настройките user/project/local и ограничава файловите инструменти до работните директории]'
    '--max-budget-usd[Максимална сума в долари за изразходване по API повиквания (само --print)]:amount:'
    '--max-turns[Ограничаване на броя агентни ходове (само --print)]:turns:'
    '--replay-user-messages[Повторно изпращане на потребителски съобщения от stdin към stdout за потвърждение]'
    '--allowed-tools[Списък на разрешени имена на инструменти разделени със запетая или интервал (напр. "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Списък на разрешени имена на инструменти разделени със запетая или интервал (формат camelCase)]:tools:'
    '--tools[Указване на списък с налични инструменти от вградения набор. Само в режим print]:tools:'
    '--disallowed-tools[Списък на забранени имена на инструменти разделени със запетая или интервал (напр. "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Списък на забранени имена на инструменти разделени със запетая или интервал (формат camelCase)]:tools:'
    '--mcp-config[Зареждане на MCP сървъри от JSON файл или низ (разделени с интервали)]:configs:'
    '--system-prompt[Системен промпт за използване в сесията]:prompt:'
    '--system-prompt-file[Четене на системен промпт от файл]:file:_files'
    '--append-system-prompt[Добавяне на системен промпт към стандартния системен промпт]:prompt:'
    '--append-system-prompt-file[Четене на системен промпт от файл и добавяне към стандартния системен промпт]:file:_files'
    '(--append-subagent-system-prompt-file)--append-subagent-system-prompt[Добавяне на текст към системния промпт на всеки подагент (само --print)]:prompt:'
    '(--append-subagent-system-prompt)--append-subagent-system-prompt-file[Четене на текст от файл и добавянето му към системните промптове на подагентите (само --print)]:file:_files'
    '--system-prompt-snapshot[Записване на системния промпт веднъж на разговор и дословното му повторно използване при всяка заявка и възобновяване (on, по подразбиране) или генерирането му наново при всяка заявка (off)]:mode:(on off)'
    '--permission-mode[Режим на разрешения за използване в сесията]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Кой отговаря на заявките за разрешение с --print: "host" (SDK хостът или --permission-prompt-tool) или "none" (всичко, което би изисквало потвърждение, се отхвърля)]:target:(host none)'
    '--permission-prompt-tool[MCP инструмент за заявките за разрешение (само --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Продължаване на последния разговор]'
    '(-r --resume)'{-r,--resume}'[Възобновяване на разговор - укажете идентификатор на сесия или изберете интерактивно]:sessionId:_claude_sessions'
    '--fork-session[Създаване на нов идентификатор на сесия вместо повторно използване на оригиналния при възобновяване (с --resume или --continue)]'
    '--no-session-persistence[Деактивиране на постоянство на сесии - сесиите няма да бъдат запазвани (само --print)]'
    '--model[Модел за текущата сесия. Укажете псевдоним за най-новия модел (напр. '\''sonnet'\'' или '\''opus'\'')]:model:_claude_model_names'
    '--agent[Агент за текущата сесия. Заменя настройката '\''agent'\'']:agent:_claude_agent_names'
    '--betas[Бета заглавки за включване в API заявки (само за потребители с API ключ)]:betas:'
    '--fallback-model[Активиране на автоматично превключване към указания модел когато моделът по подразбиране е претоварен (само --print)]:model:_claude_model_names'
    '--settings[Път към JSON файл с настройки или JSON низ за зареждане на допълнителни настройки]:file-or-json:_files'
    '--add-dir[Допълнителни директории за предоставяне на достъп на инструменти]:directories:_directories'
    '--ide[Автоматично свързване към IDE при стартиране ако е налична точно една валидна IDE]'
    '--desktop[Отваряне в приложението Claude Desktop вместо в терминала (с --continue или --resume <id> за избор на сесията)]'
    '--strict-mcp-config[Използване само на MCP сървъри от --mcp-config и игнориране на всички други MCP настройки]'
    '--session-id[Конкретен идентификатор на сесия за използване в разговора (трябва да е валиден UUID)]:uuid:'
    '--agents[JSON обект дефиниращ потребителски агенти]:json:'
    '--advisor[Активиране на сървърния инструмент за съветник за тази сесия с псевдоним на модел или пълен идентификатор на модел]:model:_claude_model_names'
    '--teammate-mode[Как се показват съотборниците в агентния екип]:mode:(in-process auto tmux iterm2)'
    '--setting-sources[Списък на източници на настройки разделени със запетая за зареждане (user, project, local)]:sources:'
    '--plugin-dir[Директория за зареждане на плъгини само за тази сесия (може да се повтаря)]:paths:_directories'
    '--disable-slash-commands[Деактивиране на всички команди с наклонена черта]'
    '(--bg --background)'{--bg,--background}'[Стартиране на сесията като фонов агент и незабавно връщане]'
    '(-w --worktree)'{-w,--worktree}'[Създаване на нов git worktree за тази сесия (по желание укажете име)]::name:'
    '--tmux=-[Създаване на tmux сесия за worktree (изисква --worktree). Използва нативните панели на iTerm2, когато са налични; --tmux=classic за традиционен tmux]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Задаване на показвано име за тази сесия]:name:'
    '--effort[Ниво на усилие за текущата сесия]:level:(low medium high xhigh max)'
    '--autocompact[Размер на прозореца за автоматично уплътняване (auto или 100k-1M токена)]:size:(auto)'
    '--debug-file[Записване на дневници за отстраняване на грешки в конкретен файлов път (имплицитно активира режима за отстраняване на грешки)]:path:_files'
    '--from-pr[Възобновяване на сесия свързана с PR по номер/URL, или отваряне на интерактивен избор]::value:'
    '--teleport[Възобновяване на teleport сесия, по желание укажете идентификатор на сесия]::session:'
    '(--remote)--cloud[Създаване на облачна сесия с даденото описание или свързване към съществуваща по идентификатор на сесия или claude.ai/code URL]::description-or-session:'
    '(--cloud)--remote[Остарял псевдоним за --cloud]::description-or-session:'
    '--environment[Създаване на нова облачна сесия, която работи в дадената самостоятелно хоствана среда (ccpool_...)]:environment_id:'
    '--ref[С --environment: базиране на checkout на новата сесия върху именуван ref вместо локалния HEAD]:branch:'
    '(--remote-control --rc)'{--remote-control,--rc}'[Стартиране на интерактивна сесия с активирано дистанционно управление (по желание с име)]::name:'
    '--remote-control-session-name-prefix[Префикс за автоматично генерирани имена на сесии за дистанционно управление]:prefix:'
    '--chrome[Активиране на интеграцията на Claude в Chrome]'
    '--no-chrome[Деактивиране на интеграцията на Claude в Chrome]'
    '--plugin-url[Изтегляне на плъгин .zip от URL само за тази сесия (може да се повтаря)]:url:'
    '--file[Файлови ресурси за изтегляне при стартиране (формат: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Активиране на предложения за промпт (извежда предсказан следващ промпт в режим print/SDK)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Препращане на текст и блокове с разсъждения на подагент като съобщения (с --print и stream-json)]'
    '--include-hook-events[Включване на всички събития от жизнения цикъл на hook в изходния поток (с stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Преместване на секциите за отделна машина в първото потребителско съобщение за подобряване на повторното използване на кеша за промпти]'
    '--brief[Активиране на инструмента SendUserMessage за комуникация от агент към потребител]'
    '*--channels[(Изследователски преглед) MCP сървъри, чиито известия от канали да се слушат (plugin\:<name>@<marketplace>)]:entries:'
    '*--dangerously-load-development-channels[Активиране на канали извън одобрения списък с разрешени, за локална разработка (plugin\:<name>@<marketplace> или server\:<name>)]:entries:'
    '--init[Изпълнение на Setup hooks със съпоставителя init преди сесията (само --print)]'
    '--init-only[Изпълнение на Setup и SessionStart hooks, след това изход без започване на разговор]'
    '--maintenance[Изпълнение на Setup hooks със съпоставителя maintenance преди сесията (само --print)]'
    '--safe-mode[Стартиране с деактивирани всички персонализации (полезно за отстраняване на проблеми с повредена конфигурация)]'
    '--bare[Минимален режим: пропуска hooks, LSP, синхронизация на плъгини, атрибуция, автоматична памет и автоматично откриване на CLAUDE.md]'
    '--ax-screen-reader[Извеждане на изход подходящ за екранни четци (плосък текст, без декоративни рамки или анимации)]'
    '(-v --version)'{-v,--version}'[Извеждане на номер на версия]'
    '(-h --help)'{-h,--help}'[Показване на помощ за команда]'
  )

  # Stop at the first non-option word, so that the options after a command reach
  # that command's own specs instead of being consumed here
  _arguments -C -A '-*' \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude commands' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin|plugins)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Показване на помощ за команда]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        remote-control|rc|remote|sync|bridge)
          _claude_remote_control
          ;;
        daemon)
          _claude_daemon
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        self-hosted-runner)
          _claude_self_hosted_runner
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        purge)
          _claude_purge
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update|upgrade)
          _arguments \
            '(-h --help)'{-h,--help}'[Показване на помощ за команда]'
          ;;
        *)
          # Not a command but the prompt: options may still follow it
          _arguments \
            $main_options \
            '*: :'
          ;;
      esac
      ;;
  esac
  local ret=$?

  # The last step, such as listing commands for --r, can fail although options
  # were added before it. Report success then: on failure zsh moves on to the
  # next completers, and _correct or _approximate pile on corrections
  (( compstate[nmatches] > 0 )) || return $ret
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Стартиране на MCP сървър на Claude Code'
    'add:Добавяне на MCP сървър към Claude Code'
    'remove:Премахване на MCP сървър'
    'list:Показване на списък с конфигурирани MCP сървъри'
    'get:Получаване на детайли за MCP сървър'
    'add-json:Добавяне на MCP сървър (stdio или SSE) с JSON низ'
    'add-from-claude-desktop:Импортиране на MCP сървъри от Claude Desktop (само Mac и WSL)'
    'reset-project-choices:Нулиране на всички одобрени/отхвърлени сървъри с обхват на проект (.mcp.json) в този проект'
    'login:Автентикация с MCP сървър (HTTP, SSE или claude.ai конектор)'
    'logout:Изчистване на съхранените OAuth удостоверения за MCP сървър'
    'help:Показване на помощ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Показване на помощ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp commands' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Активиране на режим за отстраняване на грешки]' \
            '--verbose[Презаписване на настройката за подробен режим от конфигурационния файл]' \
            '(-h --help)'{-h,--help}'[Показване на помощ]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Обхват на конфигурация (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Тип транспорт (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Задаване на променлива на средата (напр. -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Задаване на WebSocket заглавка]:header:' \
            '--client-id[OAuth идентификатор на клиент за HTTP/SSE сървъри]:clientId:' \
            '--client-secret[Запитване за OAuth тайна на клиента (или задайте променливата на средата MCP_CLIENT_SECRET)]' \
            '--callback-port[Фиксиран порт за OAuth callback (за сървъри, изискващи предварително регистрирани URI за пренасочване)]:port:' \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Обхват на конфигурация (local, user, project) - премахване от съществуващ обхват ако не е указано]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Показване на помощ]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Обхват на конфигурация (local, user, project)]:scope:(local user project)' \
            '--client-secret[Запитване за OAuth тайна на клиента (или задайте променливата на средата MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Обхват на конфигурация (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Показване на помощ]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Показване на помощ]'
          ;;
        login)
          _arguments \
            '--no-browser[Извеждане на URL за оторизация вместо отваряне на браузър (за SSH/headless сесии)]' \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Валидиране на плъгин или манифест на маркетплейс'
    'marketplace:Управление на маркетплейси на Claude Code'
    'list:Показване на списък с инсталирани плъгини'
    'details:Показване на инвентар на компоненти и прогнозна цена в токени за плъгин'
    'configure:Показване на опциите на плъгин и кои от тях не са зададени, или запазване на стойности от stdin'
    'install:Инсталиране на плъгин от налични маркетплейси'
    'i:Инсталиране на плъгин от налични маркетплейси (съкращение за install)'
    'init:Създаване на скеле за нов плъгин (автоматично зареждане при следваща сесия)'
    'new:Създаване на скеле за нов плъгин (псевдоним за init)'
    'uninstall:Деинсталиране на инсталиран плъгин'
    'remove:Деинсталиране на инсталиран плъгин (псевдоним за uninstall)'
    'enable:Активиране на деактивиран плъгин'
    'disable:Деактивиране на активиран плъгин'
    'update:Актуализиране на плъгин до най-новата версия'
    'eval:Изпълнение на eval случаи срещу плъгин и докладване на оценени резултати'
    'prune:Премахване на автоматично инсталирани зависимости които вече не са необходими'
    'autoremove:Премахване на автоматично инсталирани зависимости, които вече не са необходими (псевдоним за prune)'
    'tag:Създаване на git таг {name}--v{version} за издание на плъгин'
    'test:Изпълнение на тестовете на мод'
    'help:Показване на помощ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Показване на помощ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin commands' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Третиране на предупрежденията като грешки (код на изход 1)]' \
            '--profile[Изход с код 1 и когато посоченият каталог би отказал подаване на плъгина заради проверка, която тази команда изпълнява]:name:(directory)' \
            '--json[Извеждане на доклада от валидирането като JSON (същите кодове на изход)]' \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Обхват на инсталация]:scope:(user project local)' \
            '--accept-command[Приемане на декларираната от маркетплейса команда, чийто sha256 предишно изпълнение с --json е докладвало като shownCommand.sha256]:sha256:' \
            '*--config[Задаване на опция userConfig, декларирана в манифеста на плъгина (може да се повтаря)]:key=value:' \
            '--marketplace[Инсталиране на плъгина по самото му име от маркетплейса в този източник (owner/repo, git или https URL, или път), като при нужда маркетплейсът първо се добавя]:source:' \
            '--registry[За инсталация package@npm: разрешаване и изтегляне от този npm регистър]:url:' \
            '(-y --yes)'{-y,--yes}'[Приемане на показаната команда, декларирана от маркетплейса, без запитване за потвърждение]' \
            '--json[Извеждане на един машинно четим ред с резултат вместо съобщение за човек]' \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Обхват на инсталация]:scope:(user project local)' \
            '--keep-data[Запазване на директорията с постоянни данни на плъгина]' \
            '--prune[Премахване също на автоматично инсталирани зависимости, които вече не са необходими]' \
            '(-y --yes)'{-y,--yes}'[Пропускане на запитването за потвърждение на --prune]' \
            '--json[Извеждане на един машинно четим ред с резултат вместо съобщение за човек (не с --prune)]' \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Обхват на инсталация]:scope:(user project local)' \
            '--json[Извеждане на един машинно четим ред с резултат вместо съобщение за човек]' \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Деактивиране на всички активирани плъгини]' \
            '(-s --scope)'{-s,--scope}'[Обхват на инсталация]:scope:(user project local)' \
            '--json[Извеждане на един машинно четим ред с резултат вместо съобщение за човек]' \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '--accept-command[Приемане на декларираната от маркетплейса команда, чийто sha256 предишно изпълнение с --json е докладвало като shownCommand.sha256]:sha256:' \
            '(-s --scope)'{-s,--scope}'[Обхват на инсталация]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Приемане на показаната команда, декларирана от маркетплейса, без запитване за потвърждение]' \
            '--json[Извеждане на един машинно четим ред с резултат вместо съобщение за човек]' \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Извеждане като JSON]' \
            '--available[Включване на наличните плъгини от маркетплейси (изисква --json)]' \
            '--data-size[Измерване на директорията със запазени данни на всеки инсталиран плъгин или само на посочения плъгин (изисква --json)]::plugin:_claude_installed_plugins' \
            '(-h --help)'{-h,--help}'[Показване на помощ]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Почистване в обхват]:scope:(user project local)' \
            '--dry-run[Показване на списък с това, което би било премахнато, без премахване]' \
            '(-y --yes)'{-y,--yes}'[Пропускане на запитването за потвърждение]' \
            '(-h --help)'{-h,--help}'[Показване на помощ]'
          ;;
        configure)
          _arguments \
            '--json[Извеждане като JSON]' \
            '--values-stdin[Четене на стойностите на опциите от stdin като JSON обект с едноредови низове; непосочените опции запазват стойностите си]' \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Описание в манифеста]:text:' \
            '--author[Име на автора (по подразбиране: git config user.name)]:name:' \
            '--author-email[Имейл на автора (по подразбиране: git config user.email)]:email:' \
            '--with[Компоненти, за които също да се създаде скеле]:components:' \
            '(-f --force)'{-f,--force}'[Презаписване на съществуваща .claude-plugin/ в целта]' \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '1:name:'
          ;;
        eval)
          if [[ $words[2] == init ]]; then
            _arguments \
              '--bare[Записване на празен шаблон вместо провеждане на интервюто]' \
              '--eval-dir[Директория под текущата директория, в която да се записват случаите]:dir:_directories' \
              '(-i --interactive)'{-i,--interactive}'[Провеждане на авторското интервю (изисква интерактивен терминал)]' \
              '(-h --help)'{-h,--help}'[Показване на помощ]' \
              '::name:'
            return
          fi
          _arguments \
            '--case[Филтриране на случаите по glob шаблон за име]:glob:' \
            '*--tag[Филтриране на случаите по етикет (може да се повтаря)]:tag:' \
            '--runs[Замяна на броя изпълнения за всеки случай (по подразбиране: case.runs, иначе 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Едновременно изпълнение на до n изпълнения на агент (1-8; по подразбиране 1)]:n:' \
            '--model[Замяна на модела за всички случаи]:model:_claude_model_names' \
            '--judge-model[Замяна на модела на LLM оценителя (по подразбиране: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Твърд таван на разходите; при достигането му прекъсване и докладване на частичните резултати (код на изход 2)]:usd:' \
            '--output-dir[Директория за aggregate-result.json]:dir:_directories' \
            '--eval-dir[Име на директорията (под плъгина), съдържаща eval случаите]:dir:' \
            '--json[Извеждане на пълния резултат от изпълнението като JSON в stdout или записването му в този .json файл]::path:_files' \
            '--threshold[Завършване с код на изход 1, ако оценката на някой случай е под този праг (по подразбиране: 1.0)]:threshold:' \
            '*--allow-tools[Разрешение от оператора за ограничени инструменти (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '*--disallow-tools[Вградени инструменти, които да са недостъпни за Claude във всеки случай, дори ако са разрешени]:tools:' \
            '(--no-scaffold)--scaffold[Изпълнение на scaffold_script на всеки случай (изпълнява предоставен от автора bash от ваше име; изключено по подразбиране)]' \
            '(--scaffold)--no-scaffold[Изрично пропускане на scaffold_script]' \
            '--trust-plugin[Потвърждение, че имате доверие на този плъгин и неговия eval набор, с пропускане на запитването за доверие при първо изпълнение (за CI)]' \
            '--ablation[Изпълнение на контролна група без плъгин и докладване на разликата в оценката]:mode:(none with-without)' \
            '--mocks[Mock заместители за MCP сървъри, от <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[С --mocks record: стартиране също на реалните процеси на MCP сървъри, които нямат mock]' \
            '--keep-temp[Запазване на директориите със скеле за отстраняване на грешки]' \
            '--verbose[Записване на trace събития за всяко съобщение в дневника за отстраняване на грешки]' \
            '--report[Записване на самостоятелния HTML доклад в този път вместо в директорията с резултати]:path:_files' \
            '(--no-publish)--publish-report[Изискване също на публикуване на доклада в claude.ai]' \
            '(--publish-report)--no-publish[Запазване на HTML доклада само локално; пропускане на публикуването му в claude.ai]' \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '::target: _alternative "commands\:eval command\:(init)" "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Изпращане (push) на тага към --remote след създаването му]' \
            '--dry-run[Извеждане на това, което би получило таг, без създаване на тага]' \
            '(-f --force)'{-f,--force}'[Пропускане на проверките за непочистено работно дърво и вече съществуващ таг]' \
            '(-m --message)'{-m,--message}'[Съобщение за анотация на тага (използвайте %s за версията)]:msg:' \
            '--remote[Remote, към което да се изпраща с --push]:name:' \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Добавяне на маркетплейс от URL, път или GitHub хранилище'
    'list:Показване на списък с конфигурирани маркетплейси'
    'remove:Премахване на конфигуриран маркетплейс'
    'rm:Премахване на конфигуриран маркетплейс (псевдоним за remove)'
    'update:Актуализиране на маркетплейс от източника - актуализиране на всички ако името не е указано'
    'help:Показване на помощ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Показване на помощ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace commands' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Ограничаване на checkout до конкретни директории чрез git sparse-checkout (за монорепозиторита)]:paths:' \
            '--scope[Къде да се декларира маркетплейсът]:scope:(user project local)' \
            '--json[Извеждане на един машинно четим ред с резултат като последен ред в stdout]' \
            '--claudeai[Добавяне на маркетплейса с това име, който claude.ai хоства за вас]' \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Извеждане като JSON]' \
            '(-h --help)'{-h,--help}'[Показване на помощ]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Премахване на декларацията на маркетплейса от конкретен обхват на настройки (пропуснете, за да се премахне от всеки обхват)]:scope:(user project local)' \
            '--json[Извеждане на един машинно четим ред с резултат като последен ред в stdout]' \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '--json[С име на маркетплейс: извеждане на един машинно четим ред с резултат като последен ред в stdout]' \
            '(-h --help)'{-h,--help}'[Показване на помощ]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Принудителна инсталация дори ако вече е инсталирано]' \
    '(-h --help)'{-h,--help}'[Показване на помощ]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Допълнителна директория за предоставяне на достъп на инструменти в изпратени сесии]:directory:_directories' \
    '--agent[Агент по подразбиране за сесии изпратени от изгледа за агенти]:agent:_claude_agent_names' \
    '--all[С --json: включване също на завършени фонови сесии]' \
    '--allow-dangerously-skip-permissions[Предоставяне на режима за заобикаляне на разрешения на изпратени сесии]' \
    '--cwd[Показване само на фонови сесии стартирани под път]:path:_directories' \
    '--dangerously-skip-permissions[Псевдоним за --permission-mode bypassPermissions]' \
    '--effort[Ниво на усилие по подразбиране за изпратени сесии]:level:(low medium high xhigh max)' \
    '--json[Извеждане на активни сесии като JSON масив и изход]' \
    '*--mcp-config[Конфигурация на MCP сървър за прилагане към изпратени сесии]:config:' \
    '--model[Модел по подразбиране за сесии изпратени от изгледа за агенти]:model:_claude_model_names' \
    '--permission-mode[Режим на разрешения по подразбиране за изпратени сесии]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Зареждане на плъгини от директория за изгледа за агенти и изпратени сесии]:path:_directories' \
    '--setting-sources[Списък на източници на настройки разделени със запетая за зареждане (user, project, local)]:sources:' \
    '--settings[Файл с настройки или JSON низ за прилагане]:file-or-json:_files' \
    '--strict-mcp-config[Използване само на MCP сървъри от --mcp-config в изпратени сесии]' \
    '--restricted[Стартиране на изпратени сесии в ограничен режим]' \
    '(-h --help)'{-h,--help}'[Показване на помощ за команда]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Влизане във вашия Anthropic акаунт'
    'logout:Излизане от вашия Anthropic акаунт'
    'status:Показване на статуса на автентикация'
    'help:Показване на помощ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Показване на помощ за команда]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth commands' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Предварително попълване на имейл адреса на страницата за вход]:email:' \
            '--sso[Принудителен вход чрез SSO]' \
            '(--claudeai)--console[Използване на Anthropic Console (таксуване според използването на API) вместо Claude абонамент]' \
            '(--console)--claudeai[Използване на Claude абонамент (по подразбиране)]' \
            '(-h --help)'{-h,--help}'[Показване на помощ за команда]'
          ;;
        status)
          _arguments \
            '(--text)--json[Извеждане като JSON (по подразбиране)]' \
            '(--json)--text[Извеждане като четим за човек текст]' \
            '(-h --help)'{-h,--help}'[Показване на помощ за команда]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Показване на помощ за команда]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Извеждане на действащата конфигурация за автоматичен режим като JSON'
    'critique:Получаване на обратна връзка от AI за вашите персонализирани правила за автоматичен режим'
    'defaults:Извеждане на правилата по подразбиране за автоматичен режим като JSON'
    'reset:Нулиране на конфигурацията за автоматичен режим до стойностите по подразбиране'
    'help:Показване на помощ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Показване на помощ за команда]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode commands' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Замяна на използвания модел]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Показване на помощ за команда]'
          ;;
        defaults)
          _arguments \
            '--label[Показване само на правилата, чийто етикет започва с този префикс (без значение от регистъра)]:prefix:' \
            '(-h --help)'{-h,--help}'[Показване на помощ за команда]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Пропускане на запитването за потвърждение]' \
            '(-h --help)'{-h,--help}'[Показване на помощ за команда]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Показване на помощ за команда]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Път към YAML конфигурация на шлюза]:path:_files' \
    '(-h --help)'{-h,--help}'[Показване на помощ за команда]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Изтриване на цялото състояние на Claude Code за проект (стенограми, задачи, история на файлове, конфигурационен запис)'
    'help:Показване на помощ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Показване на помощ за команда]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project commands' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Показване на списък с това, което би било изтрито, без да се изтрива нищо]' \
            '(-y --yes)'{-y,--yes}'[Пропускане на запитването за потвърждение]' \
            '(-i --interactive)'{-i,--interactive}'[Запитване за всеки елемент преди изтриване]' \
            '(1)--all[Изтриване на състоянието за всеки проект (взаимно изключващо се с път)]' \
            '(-h --help)'{-h,--help}'[Показване на помощ за команда]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_purge() {
  _arguments \
    '--dry-run[Показване на списък с това, което би било изтрито, без да се изтрива нищо]' \
    '(-y --yes)'{-y,--yes}'[Пропускане на запитването за потвърждение]' \
    '(-i --interactive)'{-i,--interactive}'[Запитване за всеки елемент преди изтриване]' \
    '(1)--all[Изтриване на състоянието за всеки проект (взаимно изключващо се с път)]' \
    '(-h --help)'{-h,--help}'[Показване на помощ за команда]' \
    '(--all)::path:_directories'
}

_claude_ultrareview() {
  _arguments \
    '--json[Извеждане на суровия bugs.json вместо форматирани констатации]' \
    '--timeout[Максимален брой минути за изчакване прегледът да завърши (по подразбиране: 45)]:minutes:' \
    '(--no-post)--post[Публикуване на констатациите от завършения преглед в PR от ваше име (само за PR цели; един обикновен коментар, не преглед)]' \
    '(--post)--no-post[Без публикуване на констатациите в PR (по подразбиране)]' \
    '--trust-workspace[Доверяване на текущата папка само за това изпълнение, без питане (за скриптове и CI)]' \
    '(-h --help)'{-h,--help}'[Показване на помощ за команда]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Рестартиране на всички работещи фонови сесии]' \
    '(-h --help)'{-h,--help}'[Показване на помощ за команда]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Отхвърляне също на неизпратените (push) commit-и и некомитнатите промени на worktree (подайте commit@worktree-id, докладван от предишно claude rm)]:commit@worktree-id:' \
    '--force-remove-worktree[Изтриване на директорията на worktree, дори ако hook-ът WorktreeRemove или git не са успели да я премахнат (подайте worktree-id, докладван от предишно claude rm)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Показване на помощ за команда]' \
    '1:session:_claude_background_sessions'
}

_claude_self_hosted_runner() {
  _arguments \
    '--api-url[Базов URL на API (по подразбиране: https://api.anthropic.com)]:url:' \
    '--environment-secret-file[Път до файла с тайна на средата]:path:_files' \
    '--lock-to-account[Заключване на runner към един акаунт при регистрация]:id:' \
    '--client-label[Етикет за наблюдаемост, изпращан при регистрация (по подразбиране: hostname)]:label:' \
    '(--proxy-authorization-file --agent-proxy-url)--proxy-authorization-command[Команда, чийто stdout е заглавката Proxy-Authorization за изходящи проксита]:shell command:' \
    '(--proxy-authorization-command --agent-proxy-url)--proxy-authorization-file[Файл, съдържащ заглавката Proxy-Authorization за изходящи проксита]:path:_files' \
    '(--proxy-authorization-command --proxy-authorization-file)--agent-proxy-url[Маршрутизиране на всяка сесия през агентното прокси на този URL (само https)]:url:' \
    '--capacity[Максимален брой едновременни сесии (по подразбиране: 1)]:n:' \
    '--base-dir[Базова директория за checkout на хранилища (по подразбиране: /workspace)]:path:_directories' \
    '--exec-path[Изпълним файл за стартиране на дъщерни сесии (по подразбиране: този изпълним файл)]:path:_files' \
    '--hooks-dir[Директория със скриптове за hooks на жизнения цикъл (checkout, command, post-session)]:path:_directories' \
    '--session-stop-grace-sec[Колко дълго да се чака чист изход след края на сесия (по подразбиране: 5)]:n:' \
    '--post-session-hook-timeout-sec[Лимит за SIGTERM за hook-а post-session (по подразбиране: 60)]:n:' \
    '--checkout-hook-timeout-min[Лимит на реално време за всяко изпълнение на hook-а checkout (по подразбиране: 30; 0 изключва)]:n:' \
    '--drain-wait-sec[При SIGTERM/SIGINT изчакване до N секунди за текущата работа (по подразбиране: 0)]:n:' \
    '--drain-marker-file[Маркерен файл, с който хостът обявява плавно освобождаване]:path:_files' \
    '*--git-ssh-rewrite[Пренаписване на URL адреси на източници https://<host>/... към git@<host>:... (може да се повтаря)]:host:' \
    '*--git-host-rewrite[Пренаписване на URL адреси на източници https://<f>/... към https://<t>/... (може да се повтаря)]:from=to:' \
    '--use-anthropic-git-proxy[Използване на git, управляван от Anthropic. ВНИМАНИЕ: изтрива и заменя git конфигурацията на ниво HOME, използвайте само под отделен акаунт]' \
    '--configure-git[Задаване на глобалната git идентичност и активиране на подписване на commit-и чрез услугата за подписване на Anthropic. Записва ~/.gitconfig]' \
    '--push-outcome-on-release[Push на проследяваните клонове с резултати при незавършен край на сесия, иницииран от runner]' \
    '--trust-workspace[Предварително записване на постоянно доверие за пътищата на хранилището на всяка сесия (по подразбиране: true)]::bool:(true false)' \
    '--remove-session-state[Премахване на състоянието на сесията при нейния край (по подразбиране: false)]::bool:(true false)' \
    '--diff-finds-nested-repository[Показване на хранилище, клонирано в подпапка, в панела Changes; изисква --capacity 1 (по подразбиране: false)]::bool:(true false)' \
    '--confine-repo-settings[Режим на защитата за ограничаване на настройките, commit-нати в хранилището (по подразбиране: warn)]:mode:(warn enforce off)' \
    '--server-auto-mode-lists[Кои списъци на класификатора за auto режим от сървъра може да получи една сесия (по подразбиране: no-allow)]:mode:(all no-allow none)' \
    '--host-config-snapshot[Къде се пази снимката на конфигурацията на хоста при стартиране (по подразбиране: disk)]:mode:(disk memory)' \
    '--health-port[Порт за HTTP слушателя /healthz (по подразбиране: 8080; 0 изключва)]:port:' \
    '--log-level[Ниво на логване (по подразбиране: info)]:level:(info debug)' \
    '--log-file[Копиране на логовете на runner и във файл в режим на добавяне (като tee)]:path:_files' \
    '--exit-if-unused-min[Изход от runner, ако не получи работа в продължение на N минути]:n:' \
    '--drain-grace-sec[Секунди за продължаване на проверката за работа след края на активните сесии (по подразбиране: 0)]:n:' \
    '--retire-at[Извеждане на runner от употреба в това абсолютно Unix време, в секунди]:epoch-seconds:' \
    '--defer-shutdown-max-min[При първия SIGTERM/SIGINT спиране на приемането на работа и завършване на изключването M минути по-късно (по подразбиране: 0)]:m:' \
    '--release-idle-session-min[Освобождаване на слот за сесия след N минути без въвеждане от потребителя]:n:' \
    '--startup-timeout-min[Освобождаване на слот за сесия, ако дъщерният процес не е приключил стартирането след N минути (по подразбиране: 15; 0 изключва)]:n:' \
    '--kill-session-after-min[Ограничаване на реалното време на живот на дъщерния процес на сесия до N минути]:n:' \
    '--debug-token-dir[САМО ЗА ОТСТРАНЯВАНЕ НА ГРЕШКИ: записва активни токени на диска. Не използвайте в production]:path:_directories' \
    '(-h --help)'{-h,--help}'[Показване на това помощно съобщение]'
}

_claude_remote_control() {
  _arguments \
    '--name[Име на сесията (показва се в claude.ai/code)]:name:' \
    '--remote-control-session-name-prefix[Префикс за автоматично генерирани имена на сесии (по подразбиране: hostname)]:prefix:' \
    '(-c --continue --session-id)'{-c,--continue}'[Повторно свързване към последната записана сесия за тази директория или някой от нейните git worktree]' \
    '(-c --continue --session-id)--session-id[Повторно свързване към конкретна сесия по идентификатор]:id:' \
    '--permission-mode[Режим на разрешения за стартираните сесии]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)' \
    '(--no-chrome)--chrome[Активиране на Claude in Chrome за стартираните сесии]' \
    '(--chrome)--no-chrome[Деактивиране на Claude in Chrome за стартираните сесии]' \
    '(-d --debug)'{-d,--debug}'[Активиране на режим за отстраняване на грешки с опционално филтриране по категории]::filter:' \
    '--debug-file[Записване на логове за отстраняване на грешки във файл]:path:_files' \
    '(-v --verbose)'{-v,--verbose}'[Активиране на подробен изход]' \
    '--spawn[Режим на стартиране (по подразбиране: same-dir)]:mode:(same-dir worktree session)' \
    '--capacity[Максимален брой едновременни сесии в режим worktree или same-dir (по подразбиране: 32)]:n:' \
    '(--no-create-session-in-dir)--create-session-in-dir[Предварително създаване на сесия в текущата директория (по подразбиране)]' \
    '(--create-session-in-dir)--no-create-session-in-dir[Без предварително създаване на сесия в текущата директория]' \
    '(-h --help)'{-h,--help}'[Показване на тази помощ]'
}

_claude_daemon() {
  local -a daemon_commands common_options
  daemon_commands=(
    'run:Изпълнение на супервайзора на преден план'
    'status:Показване на pid, версия и време на работа на daemon'
    'logs:Проследяване на лога на daemon (Ctrl-C за спиране)'
    'uninstall:Премахване на фоновата услуга (launchctl/systemd)'
    'stop:Изключване на супервайзора и прекратяване на фоновите сесии'
  )
  common_options=(
    '--json-path[Конфигурационен файл (по подразбиране: ~/.claude/daemon.json)]:path:_files'
    '--log-file[Лог файл (по подразбиране: ~/.claude/daemon.log)]:path:_files'
    '(-h --help)'{-h,--help}'[Показване на тази помощ]'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    $common_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'daemon commands' daemon_commands
      ;;
    args)
      case $words[1] in
        run)
          _arguments \
            $common_options \
            '::json-path:_files'
          ;;
        stop)
          _arguments \
            $common_options \
            '--any[Спиране и на временен (не като услуга) daemon]' \
            '--keep-workers[Оставяне на откачените сесии да работят]'
          ;;
        status|logs|uninstall)
          _arguments \
            $common_options
          ;;
      esac
      ;;
  esac
}

_claude_import() {
  _arguments \
    '--dry-run[Показване на това, което би било импортирано, без да се записва нищо]' \
    '--yes[Пропускане на интерактивния избор (в headless среди подайте --yes=<digest> от прегледа на /import)]' \
    '(-h --help)'{-h,--help}'[Показване на помощ за команда]' \
    '::source:(codex gemini cursor)'
}

# compinit autoloads this file, and that first call only defines the functions
# above: complete right away so the first TAB already works. Sourced directly,
# there is nothing to complete yet, only the registration.
if [[ $funcstack[1] == _claude ]]; then
  _claude "$@"
else
  (( $+_comps[claude] )) || compdef _claude claude
fi
