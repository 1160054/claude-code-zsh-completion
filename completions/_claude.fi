#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Määritä ja hallinnoi MCP-palvelimia'
    'plugin:Hallinnoi Claude Code -laajennuksia'
    'agents:Hallinnoi taustagentteja'
    'attach:Avaa taustaistunto tässä päätteessä'
    'logs:Tulosta taustaistunnon viimeaikainen päätetuloste'
    'stop:Pysäytä taustaistunto (sen keskustelu säilytetään)'
    'respawn:Käynnistä taustaistunto uudelleen, jotta se käyttää nykyistä Claude Code -versiota'
    'rm:Poista taustaistunto ja myös sen työpuu, jos työpuun poistaminen on turvallista'
    'auth:Hallinnoi todennusta'
    'auto-mode:Tarkastele tai nollaa automaattitilan luokittelijan asetukset'
    'gateway:Suorita yritystason todennus-/telemetriayhdyskäytävä'
    'import:Tuo määritys toisesta tekoälykoodausagentista Claude Codeen'
    'project:Hallinnoi Claude Code -projektin tilaa'
    'ultrareview:Suorita pilvipohjainen moniagenttinen koodikatselmus ja tulosta havainnot'
    'setup-token:Määritä pitkäaikainen todennustunnus (vaatii Claude-tilauksen)'
    'doctor:Terveystarkastus Claude Code automaattiselle päivittäjälle'
    'update:Tarkista ja asenna päivitykset'
    'install:Asenna Claude Code native build'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Ota käyttöön virheenkorjaustila valinnaisella luokkasuodatuksella (esim. "api,hooks" tai "!statsig,!file")]:filter:'
    '--verbose[Ohita yksityiskohtainen tila asetustiedostosta]'
    '(-p --print)'{-p,--print}'[Tulosta vastaus ja poistu (käytettäväksi putkien kanssa). Huom: käytä vain luotetuissa hakemistoissa]'
    '--output-format[Tulosteen muoto (--print-vaihtoehdon kanssa): "text" (oletus), "json" (yksittäinen tulos) tai "stream-json" (reaaliaikainen suoratoisto)]:format:(text json stream-json)'
    '--json-schema[JSON-skeema rakenteelliselle tulosteen validoinnille]:schema:'
    '--include-partial-messages[Sisällytä osittaiset viestikappaleet saapuessaan (--print ja --output-format=stream-json -vaihtoehtojen kanssa)]'
    '--input-format[Syötteen muoto (--print-vaihtoehdon kanssa): "text" (oletus) tai "stream-json" (reaaliaikainen suoratoisto)]:format:(text stream-json)'
    '--mcp-debug[\[Vanhentunut. Käytä --debug sen sijaan\] Ota käyttöön MCP-virheenkorjaustila (näyttää MCP-palvelinvirheet)]'
    '--dangerously-skip-permissions[Ohita kaikki käyttöoikeustarkistukset. Suositellaan vain hiekkalaatikoille ilman internet-yhteyttä]'
    '--allow-dangerously-skip-permissions[Ota käyttöön vaihtoehto ohittaa käyttöoikeustarkistukset ottamatta oletuksena käyttöön]'
    '--restricted[Rajoitettu tila: poista komentoja tai koodia suorittavat työkalut sekä WebFetch, ohita user/project/local-asetukset ja rajaa tiedostotyökalut työhakemistoihin]'
    '--max-budget-usd[Enimmäisdollarimäärä API-kutsuihin käytettäväksi (vain --print)]:amount:'
    '--replay-user-messages[Lähetä uudelleen käyttäjäviestit stdin:stä stdout:iin vahvistusta varten]'
    '--allowed-tools[Pilkulla tai välilyönnillä erotettu luettelo sallituista työkalujen nimistä (esim. "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Pilkulla tai välilyönnillä erotettu luettelo sallituista työkalujen nimistä (camelCase-muoto)]:tools:'
    '--tools[Määritä luettelo käytettävissä olevista työkaluista sisäänrakennetusta joukosta. Vain tulostustila]:tools:'
    '--disallowed-tools[Pilkulla tai välilyönnillä erotettu luettelo kielletyistä työkalujen nimistä (esim. "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Pilkulla tai välilyönnillä erotettu luettelo kielletyistä työkalujen nimistä (camelCase-muoto)]:tools:'
    '--mcp-config[Lataa MCP-palvelimet JSON-tiedostosta tai merkkijonosta (välilyönnillä erotettu)]:configs:'
    '--system-prompt[Järjestelmäkehote istuntoa varten]:prompt:'
    '--system-prompt-file[Lue järjestelmäkehote tiedostosta]:file:_files'
    '--append-system-prompt[Liitä järjestelmäkehote oletuskehote perään]:prompt:'
    '--append-system-prompt-file[Lue järjestelmäkehote tiedostosta ja liitä se oletusjärjestelmäkehotteen perään]:file:_files'
    '--system-prompt-snapshot[Tallenna järjestelmäkehote kerran keskustelua kohden ja käytä sitä sanatarkasti uudelleen jokaisessa pyynnössä ja jatkettaessa (on, oletus) tai muodosta se uudelleen jokaisessa pyynnössä (off)]:mode:(on off)'
    '--permission-mode[Käyttöoikeustila istuntoa varten]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Kuka vastaa käyttöoikeuskehotteisiin --print-vaihtoehdon kanssa: "host" (SDK-isäntä tai --permission-prompt-tool) tai "none" (kaikki, mikä vaatisi kehotteen, hylätään)]:target:(host none)'
    '--permission-prompt-tool[MCP-työkalu käyttöoikeuskehotteita varten (vain --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Jatka viimeisintä keskustelua]'
    '(-r --resume)'{-r,--resume}'[Jatka keskustelua - määritä istunto-tunnus tai valitse interaktiivisesti]:sessionId:_claude_sessions'
    '--fork-session[Luo uusi istunto-tunnus alkuperäisen istunto-tunnuksen uudelleenkäytön sijaan jatkettaessa (--resume tai --continue -vaihtoehtojen kanssa)]'
    '--no-session-persistence[Poista istunnon säilyvyys käytöstä - istuntoja ei tallenneta (vain --print)]'
    '--model[Malli nykyiselle istunnolle. Määritä alias uusimmalle mallille (esim. '\''sonnet'\'' tai '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agentti nykyiselle istunnolle. Ohittaa '\''agent'\''-asetuksen]:agent:_claude_agent_names'
    '--betas[Beta-otsikot sisällytettäväksi API-pyyntöihin (vain API-avaimen käyttäjät)]:betas:'
    '--fallback-model[Ota käyttöön automaattinen varamalli kun oletusmalli on ylikuormitettu (vain --print)]:model:_claude_model_names'
    '--settings[Polku asetuksiin JSON-tiedostoon tai JSON-merkkijonoon lisäasetusten lataamiseksi]:file-or-json:_files'
    '--add-dir[Lisähakemistot työkalukäyttöä varten]:directories:_directories'
    '--ide[Yhdistä automaattisesti IDE:hen käynnistettäessä, jos täsmälleen yksi kelvollinen IDE on käytettävissä]'
    '--desktop[Avaa Claude Desktop -sovelluksessa päätteen sijaan (istunnon valitsemiseksi --continue- tai --resume <id> -vaihtoehdon kanssa)]'
    '--strict-mcp-config[Käytä vain --mcp-config-vaihtoehdon MCP-palvelimia ja ohita kaikki muut MCP-asetukset]'
    '--session-id[Tietty istunto-tunnus keskustelua varten (on oltava kelvollinen UUID)]:uuid:'
    '--agents[JSON-objekti mukautettujen agenttien määrittämiseksi]:json:'
    '--setting-sources[Pilkulla erotettu luettelo asetuslähteitä ladattavaksi (user, project, local)]:sources:'
    '--plugin-dir[Hakemisto laajennusten lataamiseen vain tälle istunnolle (toistettavissa)]:paths:_directories'
    '--disable-slash-commands[Poista käytöstä kaikki kauttaviivakomennot]'
    '(--bg --background)'{--bg,--background}'[Käynnistä istunto taustagenttina ja palaa välittömästi]'
    '(-w --worktree)'{-w,--worktree}'[Luo uusi git-työpuu tälle istunnolle (voit valinnaisesti määrittää nimen)]::name:'
    '--tmux=-[Luo tmux-istunto työpuulle (vaatii --worktree). Käyttää iTerm2:n natiiveja ruutuja, kun saatavilla; --tmux=classic perinteiselle tmuxille]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Aseta näyttönimi tälle istunnolle]:name:'
    '--effort[Panostustaso nykyiselle istunnolle]:level:(low medium high xhigh max)'
    '--autocompact[Automaattisen tiivistyksen ikkunan koko (auto tai 100k-1M tokenia)]:size:(auto)'
    '--debug-file[Kirjoita virheenkorjauslokit tiettyyn tiedostopolkuun (ottaa implisiittisesti käyttöön virheenkorjaustilan)]:path:_files'
    '--from-pr[Jatka PR:ään numeron/URL:n perusteella linkitettyä istuntoa tai avaa interaktiivinen valitsin]::value:'
    '--teleport[Jatka teleport-istuntoa, voit valinnaisesti määrittää istunto-tunnuksen]::session:'
    '--cloud[Luo pilvi-istunto annetulla kuvauksella tai liity olemassa olevaan istunto-tunnuksen tai claude.ai/code-URL:n perusteella]::description-or-session:'
    '--environment[Luo uusi pilvi-istunto, joka suoritetaan annetussa itse isännöidyssä ympäristössä (ccpool_...)]:environment_id:'
    '--remote-control[Käynnistä interaktiivinen istunto etäohjaus käytössä (valinnaisesti nimetty)]::name:'
    '--remote-control-session-name-prefix[Etuliite automaattisesti luoduille etäohjausistuntojen nimille]:prefix:'
    '--chrome[Ota käyttöön Claude in Chrome -integraatio]'
    '--no-chrome[Poista käytöstä Claude in Chrome -integraatio]'
    '--plugin-url[Nouda laajennuksen .zip URL-osoitteesta vain tälle istunnolle (toistettavissa)]:url:'
    '--file[Ladattavat tiedostoresurssit käynnistyksessä (muoto: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Ota käyttöön kehote-ehdotukset (tuottaa ennustetun seuraavan kehotteen print-/SDK-tilassa)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Välitä aliagentin teksti ja ajattelulohkot viesteinä (--print ja stream-json -vaihtoehtojen kanssa)]'
    '--include-hook-events[Sisällytä kaikki hook-elinkaaritapahtumat tulostevirtaan (stream-json-vaihtoehdon kanssa)]'
    '--exclude-dynamic-system-prompt-sections[Siirrä konekohtaiset osiot ensimmäiseen käyttäjäviestiin kehotevälimuistin uudelleenkäytön parantamiseksi]'
    '--brief[Ota käyttöön SendUserMessage-työkalu agentin ja käyttäjän väliseen viestintään]'
    '--safe-mode[Käynnistä kaikki mukautukset poistettuina käytöstä (hyödyllinen rikkoutuneen määrityksen vianmäärityksessä)]'
    '--bare[Minimitila: ohita hookit, LSP, laajennusten synkronointi, attribuutio, automaattimuisti ja CLAUDE.md-automaattitunnistus]'
    '--ax-screen-reader[Renderöi näytönlukijaystävällinen tuloste (tasainen teksti, ei koristereunuksia tai animaatioita)]'
    '(-v --version)'{-v,--version}'[Näytä versionumero]'
    '(-h --help)'{-h,--help}'[Näytä ohjeet komennolle]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude-komennot' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Näytä ohjeet komennolle]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "ei argumentteja"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Käynnistä Claude Code MCP-palvelin'
    'add:Lisää MCP-palvelin Claude Codeen'
    'remove:Poista MCP-palvelin'
    'list:Luettele määritetyt MCP-palvelimet'
    'get:Hae MCP-palvelimen tiedot'
    'add-json:Lisää MCP-palvelin (stdio tai SSE) JSON-merkkijonolla'
    'add-from-claude-desktop:Tuo MCP-palvelimet Claude Desktopista (vain Mac ja WSL)'
    'reset-project-choices:Nollaa kaikki hyväksytyt/hylätyt projektikohtaiset (.mcp.json) palvelimet tässä projektissa'
    'login:Todenna MCP-palvelimella (HTTP, SSE tai claude.ai-liitin)'
    'logout:Tyhjennä MCP-palvelimen tallennetut OAuth-tunnistetiedot'
    'help:Näytä ohje'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Näytä ohje]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp-komennot' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Ota käyttöön virheenkorjaustila]' \
            '--verbose[Ohita yksityiskohtainen tila asetustiedostosta]' \
            '(-h --help)'{-h,--help}'[Näytä ohje]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Määritysalue (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Kuljetustyyppi (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Aseta ympäristömuuttuja (esim. -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Aseta WebSocket-otsikko]:header:' \
            '--client-id[OAuth-asiakastunnus HTTP/SSE-palvelimille]:clientId:' \
            '--client-secret[Kysy OAuth-asiakassalaisuutta (tai aseta ympäristömuuttuja MCP_CLIENT_SECRET)]' \
            '--callback-port[Kiinteä portti OAuth-takaisinkutsulle (palvelimille, jotka vaativat ennalta rekisteröidyt uudelleenohjaus-URI:t)]:port:' \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Määritysalue (local, user, project) - poista olemassa olevalta alueelta jos määrittämätön]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Näytä ohje]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Määritysalue (local, user, project)]:scope:(local user project)' \
            '--client-secret[Kysy OAuth-asiakassalaisuutta (tai aseta ympäristömuuttuja MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Määritysalue (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Näytä ohje]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Näytä ohje]'
          ;;
        login)
          _arguments \
            '--no-browser[Tulosta valtuutus-URL selaimen avaamisen sijaan (SSH-/headless-istunnoille)]' \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Validoi laajennus tai markkinapaikan manifesti'
    'marketplace:Hallinnoi Claude Code -markkinapaikkoja'
    'list:Luettele asennetut laajennukset'
    'details:Näytä laajennuksen komponenttiluettelo ja arvioitu token-kustannus'
    'configure:Näytä laajennuksen asetukset ja mitkä niistä ovat asettamatta, tai tallenna arvot stdin:stä'
    'install:Asenna laajennus saatavilla olevista markkinapaikoista'
    'i:Asenna laajennus saatavilla olevista markkinapaikoista (lyhyt muoto install:lle)'
    'init:Luo uuden laajennuksen runko (latautuu automaattisesti seuraavassa istunnossa)'
    'new:Luo uuden laajennuksen runko (alias init:lle)'
    'uninstall:Poista asennettu laajennus'
    'remove:Poista asennettu laajennus (alias uninstall:lle)'
    'enable:Ota käyttöön poistettu laajennus'
    'disable:Poista käytöstä käytössä oleva laajennus'
    'update:Päivitä laajennus uusimpaan versioon'
    'eval:Suorita eval-tapaukset laajennusta vasten ja raportoi pisteytetyt tulokset'
    'prune:Poista automaattisesti asennetut riippuvuudet joita ei enää tarvita'
    'autoremove:Poista automaattisesti asennetut riippuvuudet, joita ei enää tarvita (alias prune:lle)'
    'tag:Luo {name}--v{version} git-tagi laajennuksen julkaisulle'
    'test:Suorita modin testit'
    'help:Näytä ohje'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Näytä ohje]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin-komennot' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Käsittele varoitukset virheinä (poistumiskoodi 1)]' \
            '--json[Tulosta validointiraportti JSON-muodossa (samat poistumiskoodit)]' \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Asennusalue]:scope:(user project local)' \
            '*--config[Aseta laajennuksen manifestissa määritelty userConfig-asetus (toistettavissa)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Hyväksy näytetty markkinapaikan määrittelemä komento ilman vahvistuskehotetta]' \
            '--json[Tulosta yksi koneluettava tulosrivi ihmisille tarkoitetun viestin sijaan]' \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Asennusalue]:scope:(user project local)' \
            '--keep-data[Säilytä laajennuksen pysyvien tietojen hakemisto]' \
            '--prune[Poista myös automaattisesti asennetut riippuvuudet, joita ei enää tarvita]' \
            '(-y --yes)'{-y,--yes}'[Ohita --prune-vahvistuskehote]' \
            '--json[Tulosta yksi koneluettava tulosrivi ihmisille tarkoitetun viestin sijaan (ei --prune-vaihtoehdon kanssa)]' \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Asennusalue]:scope:(user project local)' \
            '--json[Tulosta yksi koneluettava tulosrivi ihmisille tarkoitetun viestin sijaan]' \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Poista käytöstä kaikki käytössä olevat laajennukset]' \
            '(-s --scope)'{-s,--scope}'[Asennusalue]:scope:(user project local)' \
            '--json[Tulosta yksi koneluettava tulosrivi ihmisille tarkoitetun viestin sijaan]' \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Asennusalue]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Hyväksy näytetty markkinapaikan määrittelemä komento ilman vahvistuskehotetta]' \
            '--json[Tulosta yksi koneluettava tulosrivi ihmisille tarkoitetun viestin sijaan]' \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Tulosta JSON-muodossa]' \
            '--available[Sisällytä saatavilla olevat laajennukset markkinapaikoista (vaatii --json)]' \
            '(-h --help)'{-h,--help}'[Näytä ohje]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Karsi annetulla alueella]:scope:(user project local)' \
            '--dry-run[Luettele, mitä poistettaisiin, poistamatta mitään]' \
            '(-y --yes)'{-y,--yes}'[Ohita vahvistuskehote]' \
            '(-h --help)'{-h,--help}'[Näytä ohje]'
          ;;
        configure)
          _arguments \
            '--json[Tulosta JSON-muodossa]' \
            '--values-stdin[Lue asetusten arvot stdin:stä JSON-objektina, jonka arvot ovat yksirivisiä merkkijonoja; pois jätetyt asetukset säilyttävät arvonsa]' \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Manifestin kuvaus]:text:' \
            '--author[Tekijän nimi (oletus: git config user.name)]:name:' \
            '--author-email[Tekijän sähköposti (oletus: git config user.email)]:email:' \
            '--with[Komponentit, joille luodaan myös runko]:components:' \
            '(-f --force)'{-f,--force}'[Korvaa kohteessa jo oleva .claude-plugin/]' \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Suodata tapaukset nimen glob-kuviolla]:glob:' \
            '*--tag[Suodata tapaukset tagin perusteella (toistettavissa)]:tag:' \
            '--runs[Ohita tapauskohtainen ajojen määrä (oletus: case.runs, muuten 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Suorita enintään n agenttiajoa kerrallaan (1-8; oletus 1)]:n:' \
            '--model[Ohita malli kaikille tapauksille]:model:_claude_model_names' \
            '--judge-model[Ohita LLM-arvioijan malli (oletus: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Ehdoton kustannuskatto; keskeytä ja raportoi osittaiset tulokset, jos se ylittyy (poistumiskoodi 2)]:usd:' \
            '--output-dir[Hakemisto aggregate-result.json-tiedostolle]:dir:_directories' \
            '--eval-dir[Hakemiston nimi (laajennuksen alla), joka sisältää eval-tapaukset]:dir:' \
            '--json[Tulosta koko ajon tulos JSON-muodossa stdout:iin tai kirjoita se tähän .json-tiedostoon]::path:_files' \
            '--threshold[Poistu poistumiskoodilla 1, jos jonkin tapauksen pisteet jäävät tämän kynnyksen alle (oletus: 1.0)]:threshold:' \
            '*--allow-tools[Operaattorin lupa rajoitetuille työkaluille (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Suorita kunkin tapauksen scaffold_script (suorittaa tekijän toimittaman bashin sinun nimissäsi; oletuksena pois päältä)]' \
            '(--scaffold)--no-scaffold[Ohita scaffold_script nimenomaisesti]' \
            '--trust-plugin[Vahvista, että luotat tähän laajennukseen ja sen eval-sarjaan, ja ohita ensimmäisen ajon luottamuskehote (CI:tä varten)]' \
            '--ablation[Suorita vertailuryhmä ilman laajennusta ja raportoi pisteiden ero]:mode:(none with-without)' \
            '--mocks[Mock-korvikkeet MCP-palvelimille hakemistosta <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[--mocks record -vaihtoehdon kanssa: käynnistä myös todelliset MCP-palvelinprosessit, joilla ei ole mockia]' \
            '--keep-temp[Säilytä runkohakemistot virheenkorjausta varten]' \
            '--verbose[Kirjaa viestikohtaiset jäljitystapahtumat virheenkorjauslokiin]' \
            '--report[Kirjoita itsenäinen HTML-raportti tähän polkuun tuloshakemiston sijaan]:path:_files' \
            '(--no-publish)--publish-report[Vaadi myös raportin julkaiseminen claude.ai:hin]' \
            '(--publish-report)--no-publish[Pidä HTML-raportti vain paikallisena; ohita sen julkaiseminen claude.ai:hin]' \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Työnnä tagi --remote-etärepositorioon sen luomisen jälkeen]' \
            '--dry-run[Tulosta, mitä tagattaisiin, luomatta tagia]' \
            '(-f --force)'{-f,--force}'[Ohita tarkistukset commitoimattomista muutoksista työhakemistossa ja jo olemassa olevasta tagista]' \
            '(-m --message)'{-m,--message}'[Tagin annotaatioviesti (käytä %s versiolle)]:msg:' \
            '--remote[Etärepositorio, johon työnnetään --push-vaihtoehdolla]:name:' \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Lisää markkinapaikka URL-osoitteesta, polusta tai GitHub-repositoriosta'
    'list:Luettele määritetyt markkinapaikat'
    'remove:Poista määritetty markkinapaikka'
    'rm:Poista määritetty markkinapaikka (alias remove:lle)'
    'update:Päivitä markkinapaikka lähteestä - päivitä kaikki jos nimeä ei ole määritetty'
    'help:Näytä ohje'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Näytä ohje]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace-komennot' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Rajoita checkout tiettyihin hakemistoihin git sparse-checkoutin avulla (monorepoille)]:paths:' \
            '--scope[Mihin markkinapaikka määritellään]:scope:(user project local)' \
            '--claudeai[Lisää tämänniminen markkinapaikka, jota claude.ai isännöi puolestasi]' \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Tulosta JSON-muodossa]' \
            '(-h --help)'{-h,--help}'[Näytä ohje]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Poista markkinapaikan määrittely tietyltä asetusalueelta (jätä pois poistaaksesi sen kaikilta alueilta)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Näytä ohje]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Pakota asennus vaikka jo asennettu]' \
    '(-h --help)'{-h,--help}'[Näytä ohje]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Lisähakemisto työkalukäyttöä varten lähetetyissä istunnoissa]:directory:_directories' \
    '--agent[Oletusagentti agenttinäkymästä lähetetyille istunnoille]:agent:_claude_agent_names' \
    '--all[--json-vaihtoehdon kanssa: sisällytä myös valmiit taustaistunnot]' \
    '--allow-dangerously-skip-permissions[Tee ohituskäyttöoikeustila saataville lähetetyille istunnoille]' \
    '--cwd[Näytä vain polun alla käynnistetyt taustaistunnot]:path:_directories' \
    '--dangerously-skip-permissions[Alias --permission-mode bypassPermissions -asetukselle]' \
    '--effort[Oletuspanostustaso lähetetyille istunnoille]:level:(low medium high xhigh max)' \
    '--json[Tulosta aktiiviset istunnot JSON-taulukkona ja poistu]' \
    '*--mcp-config[MCP-palvelinmääritys lähetetyille istunnoille sovellettavaksi]:config:' \
    '--model[Oletusmalli agenttinäkymästä lähetetyille istunnoille]:model:_claude_model_names' \
    '--permission-mode[Oletuskäyttöoikeustila lähetetyille istunnoille]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Lataa laajennukset hakemistosta agenttinäkymälle ja lähetetyille istunnoille]:path:_directories' \
    '--setting-sources[Pilkulla erotettu luettelo asetuslähteitä ladattavaksi (user, project, local)]:sources:' \
    '--settings[Asetustiedosto tai JSON-merkkijono sovellettavaksi]:file-or-json:_files' \
    '--strict-mcp-config[Käytä vain --mcp-config-vaihtoehdon MCP-palvelimia lähetetyissä istunnoissa]' \
    '--restricted[Käynnistä lähetetyt istunnot rajoitetussa tilassa]' \
    '(-h --help)'{-h,--help}'[Näytä ohjeet komennolle]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Kirjaudu sisään Anthropic-tiliisi'
    'logout:Kirjaudu ulos Anthropic-tilistäsi'
    'status:Näytä todennuksen tila'
    'help:Näytä ohje'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Näytä ohjeet komennolle]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth-komennot' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Esitäytä sähköpostiosoite kirjautumissivulle]:email:' \
            '--sso[Pakota SSO-kirjautumiskulku]' \
            '(--claudeai)--console[Käytä Anthropic Consolea (API-käyttöön perustuva laskutus) Claude-tilauksen sijaan]' \
            '(--console)--claudeai[Käytä Claude-tilausta (oletus)]' \
            '(-h --help)'{-h,--help}'[Näytä ohjeet komennolle]'
          ;;
        status)
          _arguments \
            '(--text)--json[Tulosta JSON-muodossa (oletus)]' \
            '(--json)--text[Tulosta ihmisluettavana tekstinä]' \
            '(-h --help)'{-h,--help}'[Näytä ohjeet komennolle]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Näytä ohjeet komennolle]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Tulosta voimassa oleva automaattitilan määritys JSON-muodossa'
    'critique:Hanki tekoälypalaute mukautetuille automaattitilan säännöille'
    'defaults:Tulosta oletusautomaattitilan säännöt JSON-muodossa'
    'reset:Nollaa automaattitilan määritys toimitettuihin oletuksiin'
    'help:Näytä ohje'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Näytä ohjeet komennolle]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode-komennot' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Ohita käytettävä malli]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Näytä ohjeet komennolle]'
          ;;
        defaults)
          _arguments \
            '--label[Näytä vain säännöt, joiden nimiö alkaa tällä etuliitteellä (kirjainkoolla ei väliä)]:prefix:' \
            '(-h --help)'{-h,--help}'[Näytä ohjeet komennolle]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Ohita vahvistuskehote]' \
            '(-h --help)'{-h,--help}'[Näytä ohjeet komennolle]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Näytä ohjeet komennolle]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Polku yhdyskäytävän YAML-määritykseen]:path:_files' \
    '(-h --help)'{-h,--help}'[Näytä ohjeet komennolle]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Poista kaikki Claude Code -tila projektilta (transkriptit, tehtävät, tiedostohistoria, määrityskohta)'
    'help:Näytä ohje'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Näytä ohjeet komennolle]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project-komennot' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Luettele, mitä poistettaisiin, poistamatta mitään]' \
            '(-y --yes)'{-y,--yes}'[Ohita vahvistuskehote]' \
            '(-i --interactive)'{-i,--interactive}'[Kysy vahvistus jokaiselle kohteelle ennen poistamista]' \
            '(1)--all[Tyhjennä tila kaikilta projekteilta (ei voi käyttää yhdessä polun kanssa)]' \
            '(-h --help)'{-h,--help}'[Näytä ohjeet komennolle]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Tulosta raaka bugs.json-hyötykuorma muotoiltujen havaintojen sijaan]' \
    '--timeout[Enimmäisminuuttimäärä katselmuksen valmistumisen odottamiseen (oletus: 45)]:minutes:' \
    '(--no-post)--post[Julkaise valmiin katselmuksen havainnot PR:ään sinun nimissäsi (vain PR-kohteet; yksi tavallinen kommentti, ei katselmus)]' \
    '(--post)--no-post[Älä julkaise havaintoja PR:ään (oletus)]' \
    '(-h --help)'{-h,--help}'[Näytä ohjeet komennolle]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Käynnistä uudelleen kaikki käynnissä olevat taustaistunnot]' \
    '(-h --help)'{-h,--help}'[Näytä ohjeet komennolle]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Hylkää myös työpuun työntämättömät commitit ja commitoimattomat muutokset (anna commit@worktree-id, jonka aiempi claude rm ilmoitti)]:commit@worktree-id:' \
    '--force-remove-worktree[Poista työpuuhakemisto, vaikka WorktreeRemove-hook tai git ei pystynyt poistamaan sitä (anna worktree-id, jonka aiempi claude rm ilmoitti)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Näytä ohjeet komennolle]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Näytä, mitä tuotaisiin, kirjoittamatta mitään]' \
    '--yes[Ohita interaktiivinen valitsin (headless-ympäristöissä anna --yes=<digest> /import-esikatselusta)]' \
    '(-h --help)'{-h,--help}'[Näytä ohjeet komennolle]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
