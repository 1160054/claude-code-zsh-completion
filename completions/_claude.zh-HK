#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:設定同管理 MCP 伺服器'
    'plugin:管理 Claude Code 插件'
    'agents:管理背景代理'
    'attach:喺呢個終端機中開啟背景會話'
    'logs:列印背景會話最近嘅終端機輸出'
    'stop:停止背景會話（佢嘅對話會保留）'
    'respawn:重新啟動背景會話，令佢執行目前嘅 Claude Code 版本'
    'rm:刪除背景會話，並喺安全時一併刪除佢嘅工作樹'
    'auth:管理認證'
    'auto-mode:檢查或重設自動模式分類器設定'
    'gateway:執行企業認證/遙測閘道'
    'import:將其他 AI 編程代理嘅設定匯入 Claude Code'
    'project:管理 Claude Code 專案狀態'
    'ultrareview:執行雲端託管嘅多代理程式碼審查並列印結果'
    'setup-token:設定長期認證令牌（需要 Claude 訂閱）'
    'doctor:Claude Code 自動更新程式嘅健康檢查'
    'update:檢查同安裝更新'
    'install:安裝 Claude Code 原生建置版本'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[啟用除錯模式，可選類別篩選（例如 "api,hooks" 或 "!statsig,!file"）]:filter:'
    '--verbose[覆寫設定檔中嘅詳細模式設定]'
    '(-p --print)'{-p,--print}'[輸出回應然後結束（用於管道）。注意：只喺受信任嘅目錄中使用]'
    '--output-format[輸出格式（配合 --print）："text"（預設）、"json"（單一結果）或 "stream-json"（即時串流）]:format:(text json stream-json)'
    '--json-schema[用於結構化輸出驗證嘅 JSON 結構描述]:schema:'
    '--include-partial-messages[包含部分訊息區塊（配合 --print 同 --output-format=stream-json）]'
    '--input-format[輸入格式（配合 --print）："text"（預設）或 "stream-json"（即時串流輸入）]:format:(text stream-json)'
    '--mcp-debug[【已棄用。請改用 --debug】啟用 MCP 除錯模式（顯示 MCP 伺服器錯誤）]'
    '--dangerously-skip-permissions[略過所有權限檢查。僅建議用於無網絡存取嘅沙盒環境]'
    '--allow-dangerously-skip-permissions[啟用略過權限檢查嘅選項，但唔會預設啟用]'
    '--restricted[受限模式：移除執行命令或程式碼嘅工具同 WebFetch，忽略 user/project/local 設定，並將檔案工具限制喺工作目錄內]'
    '--max-budget-usd[花喺 API 呼叫上嘅美元金額上限（僅限 --print）]:amount:'
    '--replay-user-messages[喺 stdout 重新發送由 stdin 輸入嘅用戶訊息以進行確認]'
    '--allowed-tools[以逗號或空格分隔嘅允許工具名稱列表（例如 "Bash(git:*) Edit"）]:tools:'
    '--allowedTools[以逗號或空格分隔嘅允許工具名稱列表（駝峰式格式）]:tools:'
    '--tools[指定由內建集合中可用嘅工具列表。僅限輸出模式]:tools:'
    '--disallowed-tools[以逗號或空格分隔嘅禁用工具名稱列表（例如 "Bash(git:*) Edit"）]:tools:'
    '--disallowedTools[以逗號或空格分隔嘅禁用工具名稱列表（駝峰式格式）]:tools:'
    '--mcp-config[由 JSON 檔案或字串載入 MCP 伺服器（以空格分隔）]:configs:'
    '--system-prompt[會話使用嘅系統提示]:prompt:'
    '--system-prompt-file[由檔案讀取系統提示]:file:_files'
    '--append-system-prompt[將系統提示附加到預設系統提示]:prompt:'
    '--append-system-prompt-file[由檔案讀取系統提示並附加到預設系統提示]:file:_files'
    '--system-prompt-snapshot[每個對話記錄一次系統提示，並喺之後每次請求同恢復時原樣重用（on，預設），或者每次請求重新產生（off）]:mode:(on off)'
    '--permission-mode[會話使用嘅權限模式]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[使用 --print 時由邊個回答權限提示："host"（SDK 主機或 --permission-prompt-tool）或 "none"（任何需要提示嘅操作都會被拒絕）]:target:(host none)'
    '--permission-prompt-tool[用於權限提示嘅 MCP 工具（僅限 --print）]:tool:'
    '(-c --continue)'{-c,--continue}'[繼續最近嘅對話]'
    '(-r --resume)'{-r,--resume}'[恢復對話 - 指定會話 ID 或互動式選擇]:sessionId:_claude_sessions'
    '--fork-session[喺恢復時建立新嘅會話 ID，而唔係重用原有會話 ID（配合 --resume 或 --continue）]'
    '--no-session-persistence[停用會話持續性 - 會話將唔會儲存（僅限 --print）]'
    '--model[目前會話嘅模型。指定最新模型嘅別名（例如 '\''sonnet'\'' 或 '\''opus'\''）]:model:_claude_model_names'
    '--agent[目前會話嘅代理。覆寫 '\''agent'\'' 設定]:agent:_claude_agent_names'
    '--betas[要包含喺 API 請求中嘅 Beta 標頭（僅限 API 金鑰用戶）]:betas:'
    '--fallback-model[當預設模型負載過重時自動後備到指定模型（僅限 --print）]:model:_claude_model_names'
    '--settings[設定 JSON 檔案路徑或 JSON 字串以載入額外設定]:file-or-json:_files'
    '--add-dir[允許工具存取嘅額外目錄]:directories:_directories'
    '--ide[如果恰好有一個有效嘅 IDE，喺啟動時自動連接到 IDE]'
    '--desktop[喺 Claude Desktop 應用程式中開啟，而唔係終端機（配合 --continue 或 --resume <id> 選擇會話）]'
    '--strict-mcp-config[只使用 --mcp-config 中嘅 MCP 伺服器，忽略所有其他 MCP 設定]'
    '--session-id[用於對話嘅特定會話 ID（必須係有效嘅 UUID）]:uuid:'
    '--agents[定義自訂代理嘅 JSON 物件]:json:'
    '--setting-sources[以逗號分隔嘅要載入嘅設定來源列表（user、project、local）]:sources:'
    '--plugin-dir[僅為呢個會話載入插件嘅目錄（可重複）]:paths:_directories'
    '--disable-slash-commands[停用所有斜線命令]'
    '(--bg --background)'{--bg,--background}'[以背景代理啟動會話並立即返回]'
    '(-w --worktree)'{-w,--worktree}'[為呢個會話建立新嘅 git 工作樹（可選擇指定名稱）]::name:'
    '--tmux=-[為工作樹建立 tmux 會話（需要 --worktree）。可用時使用 iTerm2 原生窗格；傳統 tmux 請用 --tmux=classic]::mode:(classic)'
    '(-n --name)'{-n,--name}'[為呢個會話設定顯示名稱]:name:'
    '--effort[目前會話嘅努力程度]:level:(low medium high xhigh max)'
    '--autocompact[自動壓縮視窗大小（auto，或 100k 至 1M 個令牌）]:size:(auto)'
    '--debug-file[將除錯記錄寫入特定檔案路徑（隱含啟用除錯模式）]:path:_files'
    '--from-pr[恢復依編號/URL 連結至 PR 嘅會話，或開啟互動式選擇器]::value:'
    '--teleport[恢復傳送會話，可選擇指定會話 ID]::session:'
    '--cloud[用指定嘅描述建立雲端會話，或透過會話 ID 或 claude.ai/code URL 連接到現有會話]::description-or-session:'
    '--environment[建立喺指定自行託管環境（ccpool_...）上執行嘅新雲端會話]:environment_id:'
    '--remote-control[啟動已啟用遠端控制嘅互動式會話（可選擇命名）]::name:'
    '--remote-control-session-name-prefix[自動產生嘅遠端控制會話名稱嘅前綴]:prefix:'
    '--chrome[啟用 Claude in Chrome 整合]'
    '--no-chrome[停用 Claude in Chrome 整合]'
    '--plugin-url[僅為呢個會話由 URL 擷取插件 .zip（可重複）]:url:'
    '--file[啟動時要下載嘅檔案資源（格式：file_id:relative_path）]:specs:'
    '--prompt-suggestions[啟用提示建議（喺列印/SDK 模式下發出預測嘅下一個提示）]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[將子代理文字同思考區塊轉發為訊息（配合 --print 同 stream-json）]'
    '--include-hook-events[喺輸出串流中包含所有 hook 生命週期事件（配合 stream-json）]'
    '--exclude-dynamic-system-prompt-sections[將每台機器嘅區段移至第一則用戶訊息以改善提示快取重用]'
    '--brief[啟用 SendUserMessage 工具以進行代理對用戶嘅通訊]'
    '--safe-mode[啟動時停用所有自訂項目（適合疑難排解損毀嘅設定）]'
    '--bare[最小模式：略過 hooks、LSP、插件同步、屬性標示、自動記憶同 CLAUDE.md 自動探索]'
    '--ax-screen-reader[呈現螢幕助讀程式友善嘅輸出（純文字，無裝飾性邊框或動畫）]'
    '(-v --version)'{-v,--version}'[輸出版本號]'
    '(-h --help)'{-h,--help}'[顯示命令說明]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude commands' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[顯示命令說明]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "no arguments"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:啟動 Claude Code MCP 伺服器'
    'add:將 MCP 伺服器添加到 Claude Code'
    'remove:移除 MCP 伺服器'
    'list:列出已設定嘅 MCP 伺服器'
    'get:取得 MCP 伺服器詳情'
    'add-json:使用 JSON 字串添加 MCP 伺服器（stdio 或 SSE）'
    'add-from-claude-desktop:由 Claude Desktop 匯入 MCP 伺服器（僅限 Mac 同 WSL）'
    'reset-project-choices:重設呢個專案中所有已批准/已拒絕嘅專案範圍（.mcp.json）伺服器'
    'login:向 MCP 伺服器認證（HTTP、SSE 或 claude.ai 連接器）'
    'logout:清除 MCP 伺服器嘅已儲存 OAuth 認證資訊'
    'help:顯示說明'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[顯示說明]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp commands' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[啟用除錯模式]' \
            '--verbose[覆寫設定檔中嘅詳細模式設定]' \
            '(-h --help)'{-h,--help}'[顯示說明]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[設定範圍（local、user、project）]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[傳輸類型（stdio、sse、http）]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[設定環境變數（例如 -e KEY=value）]:env:' \
            '(-H --header)'{-H,--header}'[設定 WebSocket 標頭]:header:' \
            '--client-id[HTTP/SSE 伺服器嘅 OAuth 用戶端 ID]:clientId:' \
            '--client-secret[提示輸入 OAuth 用戶端密鑰（或設定 MCP_CLIENT_SECRET 環境變數）]' \
            '--callback-port[OAuth 回呼嘅固定連接埠（用於需要預先註冊重新導向 URI 嘅伺服器）]:port:' \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[設定範圍（local、user、project） - 若未指定則由現有範圍移除]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[顯示說明]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[設定範圍（local、user、project）]:scope:(local user project)' \
            '--client-secret[提示輸入 OAuth 用戶端密鑰（或設定 MCP_CLIENT_SECRET 環境變數）]' \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[設定範圍（local、user、project）]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[顯示說明]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[顯示說明]'
          ;;
        login)
          _arguments \
            '--no-browser[列印授權 URL 而唔開啟瀏覽器（用於 SSH/無頭會話）]' \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:驗證插件或市集清單'
    'marketplace:管理 Claude Code 市集'
    'list:列出已安裝嘅插件'
    'details:顯示插件嘅元件清單同預估令牌成本'
    'configure:顯示插件嘅選項同邊啲未設定，或者由 stdin 儲存值'
    'install:由可用市集安裝插件'
    'i:由可用市集安裝插件（install 嘅簡寫）'
    'init:建立新插件嘅骨架（下次會話自動載入）'
    'new:建立新插件嘅骨架（init 嘅別名）'
    'uninstall:解除安裝已安裝嘅插件'
    'remove:解除安裝已安裝嘅插件（uninstall 嘅別名）'
    'enable:啟用已停用嘅插件'
    'disable:停用已啟用嘅插件'
    'update:將插件更新至最新版本'
    'eval:對插件執行評估案例並回報評分結果'
    'prune:移除唔再需要嘅自動安裝相依項目'
    'autoremove:移除唔再需要嘅自動安裝相依項目（prune 嘅別名）'
    'tag:為插件版本建立 {name}--v{version} git 標籤'
    'test:執行 mod 嘅測試'
    'help:顯示說明'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[顯示說明]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin commands' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[將警告視為錯誤（結束代碼 1）]' \
            '--json[以 JSON 輸出驗證報告（結束代碼相同）]' \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[安裝範圍]:scope:(user project local)' \
            '*--config[設定插件清單中宣告嘅 userConfig 選項（可重複）]:key=value:' \
            '(-y --yes)'{-y,--yes}'[唔經確認提示就接受顯示嘅市集宣告命令]' \
            '--json[列印一行機器可讀嘅結果，而唔係俾人睇嘅訊息]' \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[安裝範圍]:scope:(user project local)' \
            '--keep-data[保留插件嘅持久資料目錄]' \
            '--prune[同時移除唔再需要嘅自動安裝相依項目]' \
            '(-y --yes)'{-y,--yes}'[略過 --prune 嘅確認提示]' \
            '--json[列印一行機器可讀嘅結果，而唔係俾人睇嘅訊息（唔可以同 --prune 一齊用）]' \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[安裝範圍]:scope:(user project local)' \
            '--json[列印一行機器可讀嘅結果，而唔係俾人睇嘅訊息]' \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[停用所有已啟用嘅插件]' \
            '(-s --scope)'{-s,--scope}'[安裝範圍]:scope:(user project local)' \
            '--json[列印一行機器可讀嘅結果，而唔係俾人睇嘅訊息]' \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[安裝範圍]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[唔經確認提示就接受顯示嘅市集宣告命令]' \
            '--json[列印一行機器可讀嘅結果，而唔係俾人睇嘅訊息]' \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[以 JSON 輸出]' \
            '--available[包含市集中可用嘅插件（需要 --json）]' \
            '(-h --help)'{-h,--help}'[顯示說明]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[喺指定範圍內清理]:scope:(user project local)' \
            '--dry-run[列出將會移除嘅項目但唔實際移除]' \
            '(-y --yes)'{-y,--yes}'[略過確認提示]' \
            '(-h --help)'{-h,--help}'[顯示說明]'
          ;;
        configure)
          _arguments \
            '--json[以 JSON 輸出]' \
            '--values-stdin[由 stdin 讀取選項值，格式為單行字串組成嘅 JSON 物件；未提供嘅選項保留原值]' \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[清單描述]:text:' \
            '--author[作者姓名（預設：git config user.name）]:name:' \
            '--author-email[作者電郵（預設：git config user.email）]:email:' \
            '--with[一併建立骨架嘅元件]:components:' \
            '(-f --force)'{-f,--force}'[覆寫目標位置現有嘅 .claude-plugin/]' \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[按名稱 glob 篩選案例]:glob:' \
            '*--tag[按標籤篩選案例（可重複）]:tag:' \
            '--runs[覆寫每個案例嘅執行次數（預設：case.runs，否則為 3）]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[同時進行最多 n 次代理執行（1 至 8；預設 1）]:n:' \
            '--model[覆寫所有案例嘅模型]:model:_claude_model_names' \
            '--judge-model[覆寫 LLM 評分模型（預設：haiku）]:model:_claude_model_names' \
            '--max-cost-usd[硬性成本上限；到達時中止並回報部分結果（結束代碼 2）]:usd:' \
            '--output-dir[存放 aggregate-result.json 嘅目錄]:dir:_directories' \
            '--eval-dir[存放評估案例嘅目錄名稱（位於插件之下）]:dir:' \
            '--json[將完整執行結果以 JSON 列印到 stdout，或寫入呢個 .json 檔案]::path:_files' \
            '--threshold[任何案例分數低於呢個門檻時以結束代碼 1 結束（預設：1.0）]:threshold:' \
            '*--allow-tools[操作者對受限工具（Bash、Write、Edit、WebFetch、mcp__*）嘅授權]:tools:' \
            '(--no-scaffold)--scaffold[執行每個案例嘅 scaffold_script（以你嘅身分執行作者提供嘅 bash；預設關閉）]' \
            '(--scaffold)--no-scaffold[明確略過 scaffold_script]' \
            '--trust-plugin[聲明你信任呢個插件同佢嘅評估套件，略過首次執行嘅信任提示（用於 CI）]' \
            '--ablation[執行冇插件嘅基準對照組並回報分數差異]:mode:(none with-without)' \
            '--mocks[MCP 伺服器嘅模擬替身（來自 <eval dir>/mocks/）]:mode:(record off)' \
            '--allow-real-servers[使用 --mocks record 時，同時啟動冇模擬嘅真實 MCP 伺服器程序]' \
            '--keep-temp[保留 scaffold 目錄以便除錯]' \
            '--verbose[將每則訊息嘅追蹤事件記錄到除錯記錄]' \
            '--report[將獨立嘅 HTML 報告寫入呢個路徑，而唔係結果目錄]:path:_files' \
            '(--no-publish)--publish-report[同時要求將報告發佈到 claude.ai]' \
            '(--publish-report)--no-publish[只喺本機保留 HTML 報告；唔發佈到 claude.ai]' \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[建立標籤後推送到 --remote]' \
            '--dry-run[列印將會建立嘅標籤但唔實際建立]' \
            '(-f --force)'{-f,--force}'[略過工作樹有未提交變更同標籤已存在嘅檢查]' \
            '(-m --message)'{-m,--message}'[標籤註解訊息（用 %s 代表版本）]:msg:' \
            '--remote[使用 --push 時推送到嘅遠端]:name:' \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:由 URL、路徑或 GitHub 儲存庫添加市集'
    'list:列出已設定嘅市集'
    'remove:移除已設定嘅市集'
    'rm:移除已設定嘅市集（remove 嘅別名）'
    'update:由來源更新市集 - 如未指定名稱則更新所有'
    'help:顯示說明'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[顯示說明]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace commands' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[透過 git sparse-checkout 只簽出特定目錄（用於單一儲存庫）]:paths:' \
            '--scope[喺邊度宣告市集]:scope:(user project local)' \
            '--claudeai[添加 claude.ai 為你託管嘅呢個名稱嘅市集]' \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[以 JSON 輸出]' \
            '(-h --help)'{-h,--help}'[顯示說明]'
          ;;
        remove|rm)
          _arguments \
            '--scope[由特定設定範圍移除市集宣告（省略則由所有範圍移除）]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[顯示說明]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[即使已安裝都強制安裝]' \
    '(-h --help)'{-h,--help}'[顯示說明]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[喺派發嘅會話中允許工具存取嘅額外目錄]:directory:_directories' \
    '--agent[由代理檢視派發嘅會話嘅預設代理]:agent:_claude_agent_names' \
    '--all[配合 --json：同時包含已完成嘅背景會話]' \
    '--allow-dangerously-skip-permissions[讓派發嘅會話可使用略過權限模式]' \
    '--cwd[只顯示喺路徑下啟動嘅背景會話]:path:_directories' \
    '--dangerously-skip-permissions[--permission-mode bypassPermissions 嘅別名]' \
    '--effort[派發嘅會話嘅預設努力程度]:level:(low medium high xhigh max)' \
    '--json[將作用中會話列印為 JSON 陣列並結束]' \
    '*--mcp-config[要套用至派發嘅會話嘅 MCP 伺服器設定]:config:' \
    '--model[由代理檢視派發嘅會話嘅預設模型]:model:_claude_model_names' \
    '--permission-mode[派發嘅會話嘅預設權限模式]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[為代理檢視同派發嘅會話由目錄載入插件]:path:_directories' \
    '--setting-sources[以逗號分隔嘅要載入嘅設定來源列表（user、project、local）]:sources:' \
    '--settings[要套用嘅設定檔或 JSON 字串]:file-or-json:_files' \
    '--strict-mcp-config[喺派發嘅會話中只使用 --mcp-config 中嘅 MCP 伺服器]' \
    '--restricted[以受限模式啟動派發嘅會話]' \
    '(-h --help)'{-h,--help}'[顯示命令說明]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:登入你嘅 Anthropic 帳戶'
    'logout:登出你嘅 Anthropic 帳戶'
    'status:顯示認證狀態'
    'help:顯示說明'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[顯示命令說明]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth commands' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[喺登入頁面預先填入電郵地址]:email:' \
            '--sso[強制使用 SSO 登入流程]' \
            '(--claudeai)--console[使用 Anthropic Console（按 API 用量計費）而唔係 Claude 訂閱]' \
            '(--console)--claudeai[使用 Claude 訂閱（預設）]' \
            '(-h --help)'{-h,--help}'[顯示命令說明]'
          ;;
        status)
          _arguments \
            '(--text)--json[以 JSON 輸出（預設）]' \
            '(--json)--text[以人類可讀嘅文字輸出]' \
            '(-h --help)'{-h,--help}'[顯示命令說明]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[顯示命令說明]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:將有效嘅自動模式設定列印為 JSON'
    'critique:取得 AI 對你嘅自訂自動模式規則嘅回饋'
    'defaults:將預設嘅自動模式規則列印為 JSON'
    'reset:將自動模式設定重設為出廠預設值'
    'help:顯示說明'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[顯示命令說明]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode commands' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[覆寫所使用嘅模型]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[顯示命令說明]'
          ;;
        defaults)
          _arguments \
            '--label[只顯示標籤以呢個前綴開頭嘅規則（唔區分大小寫）]:prefix:' \
            '(-h --help)'{-h,--help}'[顯示命令說明]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[略過確認提示]' \
            '(-h --help)'{-h,--help}'[顯示命令說明]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[顯示命令說明]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[閘道 YAML 設定嘅路徑]:path:_files' \
    '(-h --help)'{-h,--help}'[顯示命令說明]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:刪除專案嘅所有 Claude Code 狀態（記錄稿、工作、檔案歷程記錄、設定項目）'
    'help:顯示說明'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[顯示命令說明]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project commands' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[列出將會刪除嘅項目但唔實際刪除任何嘢]' \
            '(-y --yes)'{-y,--yes}'[略過確認提示]' \
            '(-i --interactive)'{-i,--interactive}'[刪除前逐項確認]' \
            '(1)--all[清除所有專案嘅狀態（唔可以同路徑一齊用）]' \
            '(-h --help)'{-h,--help}'[顯示命令說明]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[列印原始 bugs.json 承載而非格式化嘅結果]' \
    '--timeout[等待審查完成嘅最長分鐘數（預設：45）]:minutes:' \
    '(--no-post)--post[以你嘅身分將完成嘅審查結果發佈到 PR（僅限 PR 目標；一則普通留言，而唔係 review）]' \
    '(--post)--no-post[唔將結果發佈到 PR（預設）]' \
    '(-h --help)'{-h,--help}'[顯示命令說明]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[重新啟動所有執行中嘅背景會話]' \
    '(-h --help)'{-h,--help}'[顯示命令說明]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[同時捨棄工作樹中未推送嘅提交同未提交嘅變更（傳入之前 claude rm 回報嘅 commit@worktree-id）]:commit@worktree-id:' \
    '--force-remove-worktree[即使 WorktreeRemove hook 或 git 無法移除，都刪除工作樹目錄（傳入之前 claude rm 回報嘅 worktree-id）]:worktree-id:' \
    '(-h --help)'{-h,--help}'[顯示命令說明]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[顯示將會匯入嘅內容但唔寫入任何嘢]' \
    '--yes[略過互動式選擇器（喺無頭環境中，傳入 /import 預覽中嘅 --yes=<digest>）]' \
    '(-h --help)'{-h,--help}'[顯示命令說明]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
