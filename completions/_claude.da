}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Kassér også worktreets ikke-pushede commits og ucommittede ændringer (angiv det commit@worktree-id, som en tidligere claude rm rapporterede)]:commit@worktree-id:' \
    '--force-remove-worktree[Slet worktree-mappen, selvom WorktreeRemove-hooket eller git ikke kunne fjerne den (angiv det worktree-id, som en tidligere claude rm rapporterede)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Vis hjælp til kommando]' \
    '1:session:_claude_background_sessions'
}

_claude_self_hosted_runner() {
  _arguments \
    '--api-url[API-basis-URL (standard: https://api.anthropic.com)]:url:' \
    '--environment-secret-file[Sti til miljøets hemmelighedsfil]:path:_files' \
    '--lock-to-account[Lås runneren til én enkelt konto ved registrering]:id:' \
    '--client-label[Observabilitetsetiket sendt ved registrering (standard: hostname)]:label:' \
    '(--proxy-authorization-file --agent-proxy-url)--proxy-authorization-command[Kommando, hvis stdout er Proxy-Authorization-headeren til egress-proxyer]:shell command:' \
    '(--proxy-authorization-command --agent-proxy-url)--proxy-authorization-file[Fil med Proxy-Authorization-headeren til egress-proxyer]:path:_files' \
    '(--proxy-authorization-command --proxy-authorization-file)--agent-proxy-url[Send alle sessioner gennem agent-proxyen på denne URL (kun https)]:url:' \
    '--capacity[Maks. samtidige sessioner (standard: 1)]:n:' \
    '--base-dir[Basismappe til repo-checkouts (standard: /workspace)]:path:_directories' \
    '--exec-path[Binær fil, der startes til underordnede sessioner (standard: denne binære fil)]:path:_files' \
    '--hooks-dir[Mappe med livscyklus-hookscripts (checkout, command, post-session)]:path:_directories' \
    '--session-stop-grace-sec[Hvor længe der ventes på en ren afslutning, efter en session slutter (standard: 5)]:n:' \
    '--post-session-hook-timeout-sec[SIGTERM-budget for post-session-hooket (standard: 60)]:n:' \
    '--checkout-hook-timeout-min[Vægurstidsbudget for hver kørsel af checkout-hooket (standard: 30; 0 deaktiverer)]:n:' \
    '--drain-wait-sec[Ved SIGTERM/SIGINT: vent op til N sekunder på igangværende arbejde (standard: 0)]:n:' \
    '--drain-marker-file[Markørfil, hvormed værten annoncerer en kontrolleret afvikling]:path:_files' \
    '*--git-ssh-rewrite[Omskriv kilde-URL’er https://<host>/... til git@<host>:... (kan gentages)]:host:' \
    '*--git-host-rewrite[Omskriv kilde-URL’er https://<f>/... til https://<t>/... (kan gentages)]:from=to:' \
    '--use-anthropic-git-proxy[Brug Anthropic-administreret git. ADVARSEL: sletter og erstatter git-konfigurationen på HOME-niveau, brug kun under en dedikeret konto]' \
    '--configure-git[Angiv den globale git-identitet og aktivér commit-signering via Anthropics signeringstjeneste. Skriver ~/.gitconfig]' \
    '--push-outcome-on-release[Push sporede resultatbranches, når en session afsluttes ufuldført på runnerens initiativ]' \
    '--trust-workspace[Forudfyld gemt tillid for hver sessions repo-stier (standard: true)]::bool:(true false)' \
    '--remove-session-state[Fjern sessionsspecifik tilstand, når en session slutter (standard: false)]::bool:(true false)' \
    '--diff-finds-nested-repository[Vis et repository klonet i en undermappe i Changes-ruden; kræver --capacity 1 (standard: false)]::bool:(true false)' \
    '--confine-repo-settings[Afgrænsningsvagttilstand for repo-committede indstillinger (standard: warn)]:mode:(warn enforce off)' \
    '--server-auto-mode-lists[Hvilke auto-tilstandsklassifikatorlister fra serveren en session må modtage (standard: no-allow)]:mode:(all no-allow none)' \
    '--host-config-snapshot[Hvor opstartsøjebliksbilledet af værtskonfigurationen opbevares (standard: disk)]:mode:(disk memory)' \
    '--health-port[Port til /healthz-HTTP-lytteren (standard: 8080; 0 deaktiverer)]:port:' \
    '--log-level[Logniveau (standard: info)]:level:(info debug)' \
    '--log-file[Skriv også runner-logs til en fil i tilføjelsestilstand (som tee)]:path:_files' \
    '--exit-if-unused-min[Afslut runneren, hvis den aldrig får tildelt arbejde i N minutter]:n:' \
    '--drain-grace-sec[Sekunder, der fortsat polles efter arbejde, efter aktive sessioner er færdige (standard: 0)]:n:' \
    '--retire-at[Pensionér runneren på dette absolutte Unix-tidspunkt i sekunder]:epoch-seconds:' \
    '--defer-shutdown-max-min[Ved første SIGTERM/SIGINT: stop med at tage arbejde, og afslut nedlukningen M minutter senere (standard: 0)]:m:' \
    '--release-idle-session-min[Frigiv en sessionsplads efter N minutter uden brugerinput]:n:' \
    '--startup-timeout-min[Frigiv en sessionsplads, hvis underprocessen ikke er færdig med at starte op efter N minutter (standard: 15; 0 deaktiverer)]:n:' \
    '--kill-session-after-min[Begræns vægurslevetiden for en sessionsunderproces til N minutter]:n:' \
    '--debug-token-dir[KUN TIL FEJLFINDING: skriver aktive tokens til disk. Brug ikke i produktion]:path:_directories' \
    '(-h --help)'{-h,--help}'[Vis denne hjælpemeddelelse]'
}

_claude_remote_control() {
  _arguments \
    '--name[Navn til sessionen (vises i claude.ai/code)]:name:' \
    '--remote-control-session-name-prefix[Præfiks til automatisk genererede sessionsnavne (standard: hostname)]:prefix:' \
    '(-c --continue --session-id)'{-c,--continue}'[Tilknyt igen til den session, der sidst blev registreret for denne mappe eller et af dens git-worktrees]' \
    '(-c --continue --session-id)--session-id[Tilknyt igen til en bestemt session via ID]:id:' \
    '--permission-mode[Tilladelsestilstand for startede sessioner]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)' \
    '(--no-chrome)--chrome[Aktivér Claude in Chrome for startede sessioner]' \
    '(--chrome)--no-chrome[Deaktivér Claude in Chrome for startede sessioner]' \
    '(-d --debug)'{-d,--debug}'[Aktivér fejlfindingstilstand med valgfri kategorifiltrering]::filter:' \
    '--debug-file[Skriv fejlfindingslogfiler til fil]:path:_files' \
    '(-v --verbose)'{-v,--verbose}'[Aktivér detaljeret output]' \
    '--spawn[Starttilstand (standard: same-dir)]:mode:(same-dir worktree session)' \
    '--capacity[Maks. samtidige sessioner i worktree- eller same-dir-tilstand (standard: 32)]:n:' \
    '(--no-create-session-in-dir)--create-session-in-dir[Opret en session på forhånd i den aktuelle mappe (standard)]' \
    '(--create-session-in-dir)--no-create-session-in-dir[Opret ikke en session på forhånd i den aktuelle mappe]' \
    '(-h --help)'{-h,--help}'[Vis denne hjælp]'
}

_claude_daemon() {
  local -a daemon_commands common_options
  daemon_commands=(
    'run:Kør supervisoren i forgrunden'
    'status:Vis daemonens pid, version og oppetid'
    'logs:Følg daemon-loggen (Ctrl-C for at stoppe)'
    'uninstall:Fjern baggrundstjenesten (launchctl/systemd)'
    'stop:Luk supervisoren ned og afslut baggrundssessioner'
  )
  common_options=(
    '--json-path[Konfigurationsfil (standard: ~/.claude/daemon.json)]:path:_files'
    '--log-file[Logfil (standard: ~/.claude/daemon.log)]:path:_files'
    '(-h --help)'{-h,--help}'[Vis denne hjælp]'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    $common_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'daemon-kommandoer' daemon_commands
      ;;
    args)
      case $words[1] in
        run)
          _arguments \
            $common_options \
            '::json-path:_files'
          ;;
        stop)
          _arguments \
            $common_options \
            '--any[Stop også en midlertidig daemon (ikke-tjeneste)]' \
            '--keep-workers[Lad frakoblede sessioner køre videre]'
          ;;
        status|logs|uninstall)
          _arguments \
            $common_options
          ;;
      esac
      ;;
  esac
}

_claude_import() {
  _arguments \
    '--dry-run[Vis, hvad der ville blive importeret, uden at skrive noget]' \
    '--yes[Spring den interaktive vælger over (på headless-flader, angiv --yes=<digest> fra /import-forhåndsvisningen)]' \
    '(-h --help)'{-h,--help}'[Vis hjælp til kommando]' \
    '::source:(codex gemini cursor)'
}

# compinit autoloads this file, and that first call only defines the functions
# above: complete right away so the first TAB already works. Sourced directly,
# there is nothing to complete yet, only the registration.
if [[ $funcstack[1] == _claude ]]; then
  _claude "$@"
else
  (( $+_comps[claude] )) || compdef _claude claude
fi
