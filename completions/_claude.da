#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Konfigurer og administrer MCP-servere'
    'plugin:Administrer Claude Code-plugins'
    'agents:Administrer baggrundsagenter'
    'attach:Åbn en baggrundssession i denne terminal'
    'logs:Udskriv det seneste terminaloutput fra en baggrundssession'
    'stop:Stop en baggrundssession (samtalen bevares)'
    'respawn:Genstart en baggrundssession, så den kører den aktuelle Claude Code-version'
    'rm:Slet en baggrundssession og dens worktree, når det er sikkert'
    'auth:Administrer godkendelse'
    'auto-mode:Inspicér eller nulstil konfiguration af auto-tilstandsklassificering'
    'gateway:Kør enterprise-godkendelses-/telemetri-gateway'
    'import:Importér konfiguration fra en anden AI-kodningsagent til Claude Code'
    'project:Administrer Claude Code-projekttilstand'
    'ultrareview:Kør en cloud-hostet multi-agent kodegennemgang og udskriv resultaterne'
    'setup-token:Konfigurer langsigtet godkendelsestoken (kræver Claude-abonnement)'
    'doctor:Sundhedstjek for Claude Code auto-opdatering'
    'update:Søg efter og installer opdateringer'
    'install:Installer Claude Code native build'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Aktivér fejlfindingstilstand med valgfri kategorifiltrering (f.eks. "api,hooks" eller "!statsig,!file")]:filter:'
    '--verbose[Tilsidesæt detaljeret tilstand fra konfigurationsfil]'
    '(-p --print)'{-p,--print}'[Udskriv svar og afslut (til brug med pipes). Bemærk: brug kun i betroede mapper]'
    '--output-format[Outputformat (med --print): "text" (standard), "json" (enkelt resultat) eller "stream-json" (realtidsstreaming)]:format:(text json stream-json)'
    '--json-schema[JSON-skema til struktureret outputvalidering]:schema:'
    '--include-partial-messages[Inkluder delvise beskedbidder når de ankommer (med --print og --output-format=stream-json)]'
    '--input-format[Inputformat (med --print): "text" (standard) eller "stream-json" (realtidsstreaming)]:format:(text stream-json)'
    '--mcp-debug[\[Forældet. Brug --debug i stedet\] Aktivér MCP-fejlfindingstilstand (viser MCP-serverfejl)]'
    '--dangerously-skip-permissions[Omgå alle tilladelseskontroller. Anbefales kun til sandkasser uden internetadgang]'
    '--allow-dangerously-skip-permissions[Aktivér mulighed for at omgå tilladelseskontroller uden at aktivere som standard]'
    '--restricted[Begrænset tilstand: fjern værktøjerne, der kører kommandoer eller kode, samt WebFetch, ignorer user/project/local-indstillinger, og begræns filværktøjer til arbejdsmapperne]'
    '--max-budget-usd[Maksimalt dollarbeløb at bruge på API-kald (kun --print)]:amount:'
    '--replay-user-messages[Gensend brugermeddelelser fra stdin på stdout til bekræftelse]'
    '--allowed-tools[Komma- eller mellemrumsepareret liste over tilladte værktøjsnavne (f.eks. "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Komma- eller mellemrumsepareret liste over tilladte værktøjsnavne (camelCase-format)]:tools:'
    '--tools[Angiv liste over tilgængelige værktøjer fra indbygget sæt. Kun udskriftstilstand]:tools:'
    '--disallowed-tools[Komma- eller mellemrumsepareret liste over ikke-tilladte værktøjsnavne (f.eks. "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Komma- eller mellemrumsepareret liste over ikke-tilladte værktøjsnavne (camelCase-format)]:tools:'
    '--mcp-config[Indlæs MCP-servere fra JSON-fil eller streng (mellemrumsepareret)]:configs:'
    '--system-prompt[Systemprompt til brug for session]:prompt:'
    '--system-prompt-file[Læs systemprompt fra en fil]:file:_files'
    '--append-system-prompt[Tilføj systemprompt til standard systemprompt]:prompt:'
    '--append-system-prompt-file[Læs systemprompt fra en fil og tilføj den til standard systemprompt]:file:_files'
    '--system-prompt-snapshot[Gem systemprompten én gang pr. samtale og genbrug den ordret ved hver anmodning og genoptagelse (on, standard), eller generér den på ny ved hver anmodning (off)]:mode:(on off)'
    '--permission-mode[Tilladelsestilstand til brug for session]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Hvem der besvarer tilladelsesprompter med --print: "host" (SDK-værten eller --permission-prompt-tool) eller "none" (alt, der ville give en prompt, afvises)]:target:(host none)'
    '--permission-prompt-tool[MCP-værktøj til tilladelsesprompter (kun --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Fortsæt den seneste samtale]'
    '(-r --resume)'{-r,--resume}'[Genoptag en samtale - angiv sessions-ID eller vælg interaktivt]:sessionId:_claude_sessions'
    '--fork-session[Opret nyt sessions-ID i stedet for at genbruge oprindeligt sessions-ID ved genoptagelse (med --resume eller --continue)]'
    '--no-session-persistence[Deaktivér sessionspersistens - sessioner gemmes ikke (kun --print)]'
    '--model[Model til aktuel session. Angiv alias for seneste model (f.eks. '\''sonnet'\'' eller '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agent til den aktuelle session. Tilsidesætter '\''agent'\''-indstillingen]:agent:_claude_agent_names'
    '--betas[Beta-headers at inkludere i API-anmodninger (kun API-nøglebrugere)]:betas:'
    '--fallback-model[Aktivér automatisk tilbagefald til angivet model når standardmodellen er overbelastet (kun --print)]:model:_claude_model_names'
    '--settings[Sti til indstillinger JSON-fil eller JSON-streng til at indlæse yderligere indstillinger]:file-or-json:_files'
    '--add-dir[Yderligere mapper til at tillade værktøjsadgang]:directories:_directories'
    '--ide[Tilslut automatisk til IDE ved opstart hvis præcis én gyldig IDE er tilgængelig]'
    '--desktop[Åbn i Claude Desktop-appen i stedet for terminalen (med --continue eller --resume <id> for at vælge sessionen)]'
    '--strict-mcp-config[Brug kun MCP-servere fra --mcp-config og ignorer alle andre MCP-indstillinger]'
    '--session-id[Specifikt sessions-ID til brug for samtale (skal være gyldig UUID)]:uuid:'
    '--agents[JSON-objekt der definerer brugerdefinerede agenter]:json:'
    '--setting-sources[Kommasepareret liste over indstillingskilder at indlæse (user, project, local)]:sources:'
    '--plugin-dir[Mappe til at indlæse plugins fra kun for denne session (kan gentages)]:paths:_directories'
    '--disable-slash-commands[Deaktivér alle skråstregskommandoer]'
    '(--bg --background)'{--bg,--background}'[Start sessionen som en baggrundsagent og returnér med det samme]'
    '(-w --worktree)'{-w,--worktree}'[Opret et nyt git-worktree til denne session (angiv eventuelt et navn)]::name:'
    '--tmux=-[Opret en tmux-session til worktreet (kræver --worktree). Bruger iTerm2'\''s native ruder, når de er tilgængelige; --tmux=classic for traditionel tmux]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Angiv et visningsnavn til denne session]:name:'
    '--effort[Indsatsniveau for den aktuelle session]:level:(low medium high xhigh max)'
    '--autocompact[Vinduesstørrelse for auto-komprimering (auto eller 100k-1M tokens)]:size:(auto)'
    '--debug-file[Skriv fejlfindingslogfiler til en bestemt filsti (aktiverer implicit fejlfindingstilstand)]:path:_files'
    '--from-pr[Genoptag en session knyttet til en PR via nummer/URL, eller åbn interaktiv vælger]::value:'
    '--teleport[Genoptag en teleport-session, angiv eventuelt sessions-ID]::session:'
    '--cloud[Opret en cloud-session med den angivne beskrivelse, eller tilslut til en eksisterende via sessions-ID eller claude.ai/code-URL]::description-or-session:'
    '--environment[Opret en ny cloud-session, der kører i det angivne selvhostede miljø (ccpool_...)]:environment_id:'
    '--remote-control[Start en interaktiv session med Remote Control aktiveret (kan navngives)]::name:'
    '--remote-control-session-name-prefix[Præfiks til automatisk genererede Remote Control-sessionsnavne]:prefix:'
    '--chrome[Aktivér Claude i Chrome-integration]'
    '--no-chrome[Deaktivér Claude i Chrome-integration]'
    '--plugin-url[Hent et plugin-.zip fra en URL kun for denne session (kan gentages)]:url:'
    '--file[Filressourcer at downloade ved opstart (format: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Aktivér promptforslag (udsender en forudsagt næste prompt i print/SDK-tilstand)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Videresend underagenttekst og tænkeblokke som beskeder (med --print og stream-json)]'
    '--include-hook-events[Inkluder alle hook-livscyklushændelser i outputstrømmen (med stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Flyt per-maskine-sektioner ind i den første brugermeddelelse for at forbedre genbrug af promptcache]'
    '--brief[Aktivér SendUserMessage-værktøjet til agent-til-bruger-kommunikation]'
    '--safe-mode[Start med alle tilpasninger deaktiveret (nyttigt til fejlfinding af en ødelagt konfiguration)]'
    '--bare[Minimal tilstand: spring hooks, LSP, plugin-synkronisering, tilskrivning, auto-hukommelse og automatisk CLAUDE.md-registrering over]'
    '--ax-screen-reader[Gengiv skærmlæservenligt output (flad tekst, ingen dekorative kanter eller animationer)]'
    '(-v --version)'{-v,--version}'[Vis versionsnummer]'
    '(-h --help)'{-h,--help}'[Vis hjælp til kommando]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude-kommandoer' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Vis hjælp til kommando]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "ingen argumenter"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Start en Claude Code MCP-server'
    'add:Tilføj en MCP-server til Claude Code'
    'remove:Fjern en MCP-server'
    'list:Vis konfigurerede MCP-servere'
    'get:Hent MCP-serverdetaljer'
    'add-json:Tilføj en MCP-server (stdio eller SSE) med JSON-streng'
    'add-from-claude-desktop:Importér MCP-servere fra Claude Desktop (kun Mac og WSL)'
    'reset-project-choices:Nulstil alle godkendte/afviste projektomfattende (.mcp.json) servere i dette projekt'
    'login:Godkend med en MCP-server (HTTP, SSE eller claude.ai-connector)'
    'logout:Ryd gemte OAuth-legitimationsoplysninger for en MCP-server'
    'help:Vis hjælp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Vis hjælp]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp-kommandoer' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Aktivér fejlfindingstilstand]' \
            '--verbose[Tilsidesæt detaljeret tilstand fra konfigurationsfil]' \
            '(-h --help)'{-h,--help}'[Vis hjælp]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurationsomfang (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Transporttype (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Angiv miljøvariabel (f.eks. -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Angiv WebSocket-header]:header:' \
            '--client-id[OAuth-klient-ID til HTTP/SSE-servere]:clientId:' \
            '--client-secret[Spørg efter OAuth-klienthemmelighed (eller angiv miljøvariablen MCP_CLIENT_SECRET)]' \
            '--callback-port[Fast port til OAuth-callback (til servere, der kræver forhåndsregistrerede omdirigerings-URI'\''er)]:port:' \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurationsomfang (local, user, project) - fjern fra eksisterende omfang hvis uspecificeret]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Vis hjælp]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurationsomfang (local, user, project)]:scope:(local user project)' \
            '--client-secret[Spørg efter OAuth-klienthemmelighed (eller angiv miljøvariablen MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurationsomfang (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Vis hjælp]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Vis hjælp]'
          ;;
        login)
          _arguments \
            '--no-browser[Udskriv godkendelses-URL'\''en i stedet for at åbne en browser (til SSH/headless-sessioner)]' \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Validér et plugin eller marketplace-manifest'
    'marketplace:Administrer Claude Code-markedspladser'
    'list:Vis installerede plugins'
    'details:Vis komponentoversigt og forventet token-omkostning for et plugin'
    'configure:Vis et plugins indstillinger og hvilke der ikke er angivet, eller gem værdier fra stdin'
    'install:Installér et plugin fra tilgængelige markedspladser'
    'i:Installér et plugin fra tilgængelige markedspladser (kort for install)'
    'init:Opret et nyt plugin-skelet (indlæses automatisk i næste session)'
    'new:Opret et nyt plugin-skelet (alias for init)'
    'uninstall:Afinstallér et installeret plugin'
    'remove:Afinstallér et installeret plugin (alias for uninstall)'
    'enable:Aktivér et deaktiveret plugin'
    'disable:Deaktivér et aktiveret plugin'
    'update:Opdatér et plugin til den seneste version'
    'eval:Kør eval-tilfælde mod et plugin og rapportér scorede resultater'
    'prune:Fjern automatisk installerede afhængigheder der ikke længere er nødvendige'
    'autoremove:Fjern automatisk installerede afhængigheder, der ikke længere er nødvendige (alias for prune)'
    'tag:Opret et {name}--v{version} git-tag til en plugin-udgivelse'
    'test:Kør et mods tests'
    'help:Vis hjælp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Vis hjælp]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin-kommandoer' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Behandl advarsler som fejl (afslutningskode 1)]' \
            '--json[Udskriv valideringsrapporten som JSON (samme afslutningskoder)]' \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Installationsomfang]:scope:(user project local)' \
            '*--config[Angiv en userConfig-indstilling erklæret i plugin-manifestet (kan gentages)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Accepter den viste kommando erklæret af markedspladsen uden bekræftelsesprompten]' \
            '--json[Udskriv én maskinlæsbar resultatlinje i stedet for den menneskelæsbare besked]' \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Installationsomfang]:scope:(user project local)' \
            '--keep-data[Bevar pluginets mappe med persistente data]' \
            '--prune[Fjern også automatisk installerede afhængigheder, der ikke længere er nødvendige]' \
            '(-y --yes)'{-y,--yes}'[Spring bekræftelsesprompten for --prune over]' \
            '--json[Udskriv én maskinlæsbar resultatlinje i stedet for den menneskelæsbare besked (ikke med --prune)]' \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Installationsomfang]:scope:(user project local)' \
            '--json[Udskriv én maskinlæsbar resultatlinje i stedet for den menneskelæsbare besked]' \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Deaktivér alle aktiverede plugins]' \
            '(-s --scope)'{-s,--scope}'[Installationsomfang]:scope:(user project local)' \
            '--json[Udskriv én maskinlæsbar resultatlinje i stedet for den menneskelæsbare besked]' \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Installationsomfang]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Accepter den viste kommando erklæret af markedspladsen uden bekræftelsesprompten]' \
            '--json[Udskriv én maskinlæsbar resultatlinje i stedet for den menneskelæsbare besked]' \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Output som JSON]' \
            '--available[Inkluder tilgængelige plugins fra markedspladser (kræver --json)]' \
            '(-h --help)'{-h,--help}'[Vis hjælp]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ryd op i omfang]:scope:(user project local)' \
            '--dry-run[Vis, hvad der ville blive fjernet, uden at fjerne noget]' \
            '(-y --yes)'{-y,--yes}'[Spring bekræftelsesprompten over]' \
            '(-h --help)'{-h,--help}'[Vis hjælp]'
          ;;
        configure)
          _arguments \
            '--json[Output som JSON]' \
            '--values-stdin[Læs indstillingsværdier fra stdin som et JSON-objekt med enkeltlinjestrenge; udeladte indstillinger beholder deres værdier]' \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Beskrivelse i manifestet]:text:' \
            '--author[Forfatternavn (standard: git config user.name)]:name:' \
            '--author-email[Forfatterens e-mail (standard: git config user.email)]:email:' \
            '--with[Komponenter, der også skal oprettes skelet for]:components:' \
            '(-f --force)'{-f,--force}'[Overskriv en eksisterende .claude-plugin/ på målet]' \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Filtrér tilfælde efter navne-glob]:glob:' \
            '*--tag[Filtrér tilfælde efter tag (kan gentages)]:tag:' \
            '--runs[Tilsidesæt antal kørsler pr. tilfælde (standard: case.runs, ellers 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Udfør op til n agentkørsler ad gangen (1-8; standard 1)]:n:' \
            '--model[Tilsidesæt model for alle tilfælde]:model:_claude_model_names' \
            '--judge-model[Tilsidesæt model til LLM-bedømmer (standard: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Fast omkostningsloft; afbryd og rapportér delvise resultater, hvis det nås (afslutningskode 2)]:usd:' \
            '--output-dir[Mappe til aggregate-result.json]:dir:_directories' \
            '--eval-dir[Mappenavn (under pluginet), der indeholder eval-tilfældene]:dir:' \
            '--json[Udskriv det fulde kørselsresultat som JSON til stdout, eller skriv det til denne .json-fil]::path:_files' \
            '--threshold[Afslut med afslutningskode 1, hvis et tilfældes score er under denne tærskel (standard: 1.0)]:threshold:' \
            '*--allow-tools[Operatørtilladelse til begrænsede værktøjer (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Kør hvert tilfældes scaffold_script (kører forfatterleveret bash under din bruger; slået fra som standard)]' \
            '(--scaffold)--no-scaffold[Spring eksplicit scaffold_script over]' \
            '--trust-plugin[Bekræft, at du har tillid til dette plugin og dets eval-suite, og spring tillidsprompten ved første kørsel over (til CI)]' \
            '--ablation[Kør en kontrolgruppe uden plugin som sammenligningsgrundlag og rapportér scoreforskellen]:mode:(none with-without)' \
            '--mocks[Mock-erstatninger for MCP-servere, fra <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Med --mocks record: start også de rigtige MCP-serverprocesser, der ikke har en mock]' \
            '--keep-temp[Bevar skeletmapper til fejlfinding]' \
            '--verbose[Log sporingshændelser pr. besked til fejlfindingsloggen]' \
            '--report[Skriv den selvstændige HTML-rapport til denne sti i stedet for resultatmappen]:path:_files' \
            '(--no-publish)--publish-report[Kræv også, at rapporten publiceres på claude.ai]' \
            '(--publish-report)--no-publish[Behold kun HTML-rapporten lokalt; spring publicering på claude.ai over]' \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Push tagget til --remote efter oprettelse]' \
            '--dry-run[Udskriv, hvad der ville blive tagget, uden at oprette tagget]' \
            '(-f --force)'{-f,--force}'[Spring kontrollerne for ucommittede ændringer i arbejdstræet og eksisterende tag over]' \
            '(-m --message)'{-m,--message}'[Annotationsbesked til tagget (brug %s for versionen)]:msg:' \
            '--remote[Remote at pushe til med --push]:name:' \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Tilføj en markedsplads fra URL, sti eller GitHub-repository'
    'list:Vis konfigurerede markedspladser'
    'remove:Fjern en konfigureret markedsplads'
    'rm:Fjern en konfigureret markedsplads (alias for remove)'
    'update:Opdatér markedsplads fra kilde - opdatér alle hvis intet navn er angivet'
    'help:Vis hjælp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Vis hjælp]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace-kommandoer' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Begræns checkout til bestemte mapper via git sparse-checkout (til monorepos)]:paths:' \
            '--scope[Hvor markedspladsen skal erklæres]:scope:(user project local)' \
            '--claudeai[Tilføj markedspladsen med dette navn, som claude.ai hoster for dig]' \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Output som JSON]' \
            '(-h --help)'{-h,--help}'[Vis hjælp]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Fjern markedspladserklæringen fra et bestemt indstillingsomfang (udelad for at fjerne den fra alle omfang)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Vis hjælp]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Gennemtving installation selvom allerede installeret]' \
    '(-h --help)'{-h,--help}'[Vis hjælp]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Yderligere mappe til at tillade værktøjsadgang i afsendte sessioner]:directory:_directories' \
    '--agent[Standardagent for sessioner afsendt fra agentvisning]:agent:_claude_agent_names' \
    '--all[Med --json: inkluder også afsluttede baggrundssessioner]' \
    '--allow-dangerously-skip-permissions[Gør bypass-permissions-tilstand tilgængelig for afsendte sessioner]' \
    '--cwd[Vis kun baggrundssessioner startet under sti]:path:_directories' \
    '--dangerously-skip-permissions[Alias for --permission-mode bypassPermissions]' \
    '--effort[Standardindsatsniveau for afsendte sessioner]:level:(low medium high xhigh max)' \
    '--json[Udskriv aktive sessioner som et JSON-array og afslut]' \
    '*--mcp-config[MCP-serverkonfiguration at anvende på afsendte sessioner]:config:' \
    '--model[Standardmodel for sessioner afsendt fra agentvisning]:model:_claude_model_names' \
    '--permission-mode[Standardtilladelsestilstand for afsendte sessioner]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Indlæs plugins fra mappe til agentvisningen og afsendte sessioner]:path:_directories' \
    '--setting-sources[Kommasepareret liste over indstillingskilder at indlæse (user, project, local)]:sources:' \
    '--settings[Indstillingsfil eller JSON-streng at anvende]:file-or-json:_files' \
    '--strict-mcp-config[Brug kun MCP-servere fra --mcp-config i afsendte sessioner]' \
    '--restricted[Start afsendte sessioner i begrænset tilstand]' \
    '(-h --help)'{-h,--help}'[Vis hjælp til kommando]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Log ind på din Anthropic-konto'
    'logout:Log ud fra din Anthropic-konto'
    'status:Vis godkendelsesstatus'
    'help:Vis hjælp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Vis hjælp til kommando]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth-kommandoer' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Udfyld e-mailadressen på forhånd på login-siden]:email:' \
            '--sso[Gennemtving SSO-loginforløb]' \
            '(--claudeai)--console[Brug Anthropic Console (fakturering efter API-forbrug) i stedet for Claude-abonnement]' \
            '(--console)--claudeai[Brug Claude-abonnement (standard)]' \
            '(-h --help)'{-h,--help}'[Vis hjælp til kommando]'
          ;;
        status)
          _arguments \
            '(--text)--json[Output som JSON (standard)]' \
            '(--json)--text[Output som menneskelæsbar tekst]' \
            '(-h --help)'{-h,--help}'[Vis hjælp til kommando]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Vis hjælp til kommando]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Udskriv den effektive auto-tilstandskonfiguration som JSON'
    'critique:Få AI-feedback på dine brugerdefinerede auto-tilstandsregler'
    'defaults:Udskriv standard auto-tilstandsreglerne som JSON'
    'reset:Nulstil auto-tilstandskonfiguration til de leverede standarder'
    'help:Vis hjælp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Vis hjælp til kommando]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode-kommandoer' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Tilsidesæt hvilken model der bruges]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Vis hjælp til kommando]'
          ;;
        defaults)
          _arguments \
            '--label[Vis kun regler, hvis etiket starter med dette præfiks (uden forskel på store og små bogstaver)]:prefix:' \
            '(-h --help)'{-h,--help}'[Vis hjælp til kommando]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Spring bekræftelsesprompten over]' \
            '(-h --help)'{-h,--help}'[Vis hjælp til kommando]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Vis hjælp til kommando]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Sti til gateway YAML-konfiguration]:path:_files' \
    '(-h --help)'{-h,--help}'[Vis hjælp til kommando]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Slet al Claude Code-tilstand for et projekt (transskriptioner, opgaver, filhistorik, konfigurationspost)'
    'help:Vis hjælp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Vis hjælp til kommando]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project-kommandoer' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Vis, hvad der ville blive slettet, uden at slette noget]' \
            '(-y --yes)'{-y,--yes}'[Spring bekræftelsesprompten over]' \
            '(-i --interactive)'{-i,--interactive}'[Spørg for hvert element før sletning]' \
            '(1)--all[Slet tilstand for alle projekter (kan ikke kombineres med en sti)]' \
            '(-h --help)'{-h,--help}'[Vis hjælp til kommando]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Udskriv den rå bugs.json-nyttelast i stedet for formaterede resultater]' \
    '--timeout[Maksimalt antal minutter at vente på at gennemgangen bliver færdig (standard: 45)]:minutes:' \
    '(--no-post)--post[Post de færdige gennemgangsfund på PR'\''en i dit navn (kun PR-mål; én almindelig kommentar, ikke et review)]' \
    '(--post)--no-post[Post ikke fundene på PR'\''en (standard)]' \
    '(-h --help)'{-h,--help}'[Vis hjælp til kommando]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Genstart alle kørende baggrundssessioner]' \
    '(-h --help)'{-h,--help}'[Vis hjælp til kommando]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Kassér også worktreets ikke-pushede commits og ucommittede ændringer (angiv det commit@worktree-id, som en tidligere claude rm rapporterede)]:commit@worktree-id:' \
    '--force-remove-worktree[Slet worktree-mappen, selvom WorktreeRemove-hooket eller git ikke kunne fjerne den (angiv det worktree-id, som en tidligere claude rm rapporterede)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Vis hjælp til kommando]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Vis, hvad der ville blive importeret, uden at skrive noget]' \
    '--yes[Spring den interaktive vælger over (på headless-flader, angiv --yes=<digest> fra /import-forhåndsvisningen)]' \
    '(-h --help)'{-h,--help}'[Vis hjælp til kommando]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
