#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:MCP sunucularını yapılandır ve yönet'
    'plugin:Claude Code eklentilerini yönet'
    'agents:Arka plan ajanlarını yönet'
    'attach:Bir arka plan oturumunu bu terminalde aç'
    'logs:Bir arka plan oturumunun son terminal çıktısını yazdır'
    'stop:Bir arka plan oturumunu durdur (konuşması korunur)'
    'respawn:Bir arka plan oturumunu mevcut Claude Code sürümüyle çalışacak şekilde yeniden başlat'
    'rm:Bir arka plan oturumunu ve güvenliyse worktree'\''sini sil'
    'auth:Kimlik doğrulamayı yönet'
    'auto-mode:Otomatik mod sınıflandırıcı yapılandırmasını incele veya sıfırla'
    'gateway:Kurumsal kimlik doğrulama/telemetri ağ geçidini çalıştır'
    'import:Başka bir yapay zekâ kodlama ajanının yapılandırmasını Claude Code'\''a aktar'
    'project:Claude Code proje durumunu yönet'
    'ultrareview:Bulut tabanlı çok ajanlı bir kod incelemesi çalıştır ve bulguları yazdır'
    'setup-token:Uzun süreli kimlik doğrulama belirteci ayarla (Claude aboneliği gerektirir)'
    'doctor:Claude Code otomatik güncelleyicisi için sağlık kontrolü'
    'update:Güncellemeleri kontrol et ve kur'
    'install:Claude Code yerel derlemesini kur'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Opsiyonel kategori filtreleme ile hata ayıklama modunu etkinleştir (örn. "api,hooks" veya "!statsig,!file")]:filter:'
    '--verbose[Yapılandırma dosyasındaki ayrıntılı mod ayarını geçersiz kıl]'
    '(-p --print)'{-p,--print}'[Yanıtı yazdır ve çık (pipe kullanımı için). Not: yalnızca güvenilir dizinlerde kullanın]'
    '--output-format[Çıktı formatı (--print ile): "text" (varsayılan), "json" (tek sonuç), veya "stream-json" (gerçek zamanlı akış)]:format:(text json stream-json)'
    '--json-schema[Yapılandırılmış çıktı doğrulaması için JSON şeması]:schema:'
    '--include-partial-messages[Kısmi mesaj parçalarını geldikçe dahil et (--print ve --output-format=stream-json ile)]'
    '--input-format[Girdi formatı (--print ile): "text" (varsayılan) veya "stream-json" (gerçek zamanlı akış girişi)]:format:(text stream-json)'
    '--mcp-debug[\[Kullanımdan kaldırıldı. Bunun yerine --debug kullanın\] MCP hata ayıklama modunu etkinleştir (MCP sunucu hatalarını gösterir)]'
    '--dangerously-skip-permissions[Tüm izin kontrollerini atla. Yalnızca internet erişimi olmayan korumalı alanlar için önerilir]'
    '--allow-dangerously-skip-permissions[Varsayılan olarak etkinleştirmeden izin kontrollerini atlama seçeneğini etkinleştir]'
    '--restricted[Kısıtlı mod: komut veya kod çalıştıran araçları ve WebFetch'\''i kaldırır, user/project/local ayarlarını yok sayar ve dosya araçlarını çalışma dizinleriyle sınırlar]'
    '--max-budget-usd[API çağrılarına harcanacak maksimum dolar tutarı (yalnızca --print)]:amount:'
    '--replay-user-messages[Onay için stdin üzerinden kullanıcı mesajlarını stdout üzerine yeniden gönder]'
    '--allowed-tools[İzin verilen araç isimlerinin virgül veya boşlukla ayrılmış listesi (örn. "Bash(git:*) Edit")]:tools:'
    '--allowedTools[İzin verilen araç isimlerinin virgül veya boşlukla ayrılmış listesi (camelCase formatı)]:tools:'
    '--tools[Yerleşik setten kullanılabilir araçların listesini belirt. Yalnızca yazdırma modu]:tools:'
    '--disallowed-tools[İzin verilmeyen araç isimlerinin virgül veya boşlukla ayrılmış listesi (örn. "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[İzin verilmeyen araç isimlerinin virgül veya boşlukla ayrılmış listesi (camelCase formatı)]:tools:'
    '--mcp-config[MCP sunucularını JSON dosyasından veya dizeden yükle (boşlukla ayrılmış)]:configs:'
    '--system-prompt[Oturum için kullanılacak sistem istemi]:prompt:'
    '--system-prompt-file[Sistem istemini bir dosyadan oku]:file:_files'
    '--append-system-prompt[Varsayılan sistem istemine sistem istemi ekle]:prompt:'
    '--append-system-prompt-file[Sistem istemini bir dosyadan oku ve varsayılan sistem istemine ekle]:file:_files'
    '--system-prompt-snapshot[Sistem istemini konuşma başına bir kez kaydet ve her istekte ve devam ettirmede aynen yeniden kullan (on, varsayılan) ya da her istekte yeniden oluştur (off)]:mode:(on off)'
    '--permission-mode[Oturum için kullanılacak izin modu]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[--print ile izin istemlerini kimin yanıtlayacağı: "host" (SDK ana bilgisayarı veya --permission-prompt-tool) ya da "none" (istem gerektiren her şey reddedilir)]:target:(host none)'
    '--permission-prompt-tool[İzin istemleri için kullanılacak MCP aracı (yalnızca --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[En son konuşmaya devam et]'
    '(-r --resume)'{-r,--resume}'[Bir konuşmayı sürdür - oturum kimliği belirt veya etkileşimli seç]:sessionId:_claude_sessions'
    '--fork-session[Sürdürürken orijinal oturum kimliğini yeniden kullanmak yerine yeni oturum kimliği oluştur (--resume veya --continue ile)]'
    '--no-session-persistence[Oturum kalıcılığını devre dışı bırak - oturumlar kaydedilmez (yalnızca --print)]'
    '--model[Mevcut oturum için model. En son model için takma ad belirt (örn. '\''sonnet'\'' veya '\''opus'\'')]:model:_claude_model_names'
    '--agent[Mevcut oturum için ajan. '\''agent'\'' ayarını geçersiz kılar]:agent:_claude_agent_names'
    '--betas[API isteklerine dahil edilecek beta başlıkları (yalnızca API anahtarı kullanıcıları)]:betas:'
    '--fallback-model[Varsayılan model aşırı yüklendiğinde belirtilen modele otomatik geri dönüşü etkinleştir (yalnızca --print)]:model:_claude_model_names'
    '--settings[Ek ayarları yüklemek için ayarlar JSON dosyasının yolu veya JSON dizesi]:file-or-json:_files'
    '--add-dir[Araç erişimine izin verilecek ek dizinler]:directories:_directories'
    '--ide[Tam olarak bir geçerli IDE mevcutsa başlangıçta IDE ile otomatik bağlan]'
    '--strict-mcp-config[Yalnızca --mcp-config üzerinden MCP sunucularını kullan ve diğer tüm MCP ayarlarını yoksay]'
    '--session-id[Konuşma için kullanılacak belirli oturum kimliği (geçerli UUID olmalı)]:uuid:'
    '--agents[Özel ajanları tanımlayan JSON nesnesi]:json:'
    '--setting-sources[Yüklenecek ayar kaynaklarının virgülle ayrılmış listesi (user, project, local)]:sources:'
    '--plugin-dir[Yalnızca bu oturum için eklentilerin yükleneceği dizin (tekrarlanabilir)]:paths:_directories'
    '--disable-slash-commands[Tüm eğik çizgi komutlarını devre dışı bırak]'
    '(--bg --background)'{--bg,--background}'[Oturumu arka plan ajanı olarak başlat ve hemen dön]'
    '(-w --worktree)'{-w,--worktree}'[Bu oturum için yeni bir git worktree oluştur (isteğe bağlı olarak bir isim belirt)]::name:'
    '--tmux=-[Worktree için bir tmux oturumu oluştur (--worktree gerektirir). Mümkün olduğunda yerel iTerm2 bölmelerini kullanır; geleneksel tmux için --tmux=classic]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Bu oturum için bir görünen ad ayarla]:name:'
    '--effort[Mevcut oturum için çaba düzeyi]:level:(low medium high xhigh max)'
    '--autocompact[Otomatik sıkıştırma pencere boyutu (auto veya 100k-1M jeton)]:size:(auto)'
    '--debug-file[Hata ayıklama günlüklerini belirli bir dosya yoluna yaz (dolaylı olarak hata ayıklama modunu etkinleştirir)]:path:_files'
    '--from-pr[Bir PR ile bağlantılı oturumu numara/URL ile sürdür veya etkileşimli seçici aç]::value:'
    '--teleport[Bir teleport oturumunu sürdür, isteğe bağlı olarak oturum kimliği belirt]::session:'
    '--cloud[Verilen açıklamayla bir bulut oturumu oluştur veya oturum kimliği ya da claude.ai/code URL'\''si ile mevcut bir oturuma bağlan]::description-or-session:'
    '--environment[Belirtilen kendi barındırılan ortamda (ccpool_...) çalışan yeni bir bulut oturumu oluştur]:environment_id:'
    '--remote-control[Uzaktan Kontrol etkinleştirilmiş etkileşimli bir oturum başlat (isteğe bağlı olarak adlandırılmış)]::name:'
    '--remote-control-session-name-prefix[Otomatik oluşturulan Uzaktan Kontrol oturum adları için önek]:prefix:'
    '--chrome[Chrome entegrasyonunda Claude'\''u etkinleştir]'
    '--no-chrome[Chrome entegrasyonunda Claude'\''u devre dışı bırak]'
    '--plugin-url[Yalnızca bu oturum için bir URL'\''den bir eklenti .zip dosyası getir (tekrarlanabilir)]:url:'
    '--file[Başlangıçta indirilecek dosya kaynakları (format: file_id:relative_path)]:specs:'
    '--prompt-suggestions[İstem önerilerini etkinleştir (yazdırma/SDK modunda tahmini bir sonraki istemi yayınlar)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Alt ajan metnini ve düşünme bloklarını mesaj olarak ilet (--print ve stream-json ile)]'
    '--include-hook-events[Tüm hook yaşam döngüsü olaylarını çıktı akışına dahil et (stream-json ile)]'
    '--exclude-dynamic-system-prompt-sections[İstem önbelleği yeniden kullanımını iyileştirmek için makineye özel bölümleri ilk kullanıcı mesajına taşı]'
    '--brief[Ajandan kullanıcıya iletişim için SendUserMessage aracını etkinleştir]'
    '--safe-mode[Tüm özelleştirmeler devre dışı olarak başlat (bozuk bir yapılandırmayı gidermek için kullanışlı)]'
    '--bare[Minimal mod: hookları, LSP'\''yi, eklenti senkronizasyonunu, atıfları, otomatik belleği ve CLAUDE.md otomatik keşfini atla]'
    '--ax-screen-reader[Ekran okuyucu dostu çıktı oluştur (düz metin, dekoratif kenarlıklar veya animasyonlar olmadan)]'
    '(-v --version)'{-v,--version}'[Sürüm numarasını göster]'
    '(-h --help)'{-h,--help}'[Komut için yardım göster]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude komutları' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Komut için yardım göster]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "argüman yok"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Claude Code MCP sunucusu başlat'
    'add:Claude Code içine bir MCP sunucusu ekle'
    'remove:Bir MCP sunucusunu kaldır'
    'list:Yapılandırılmış MCP sunucularını listele'
    'get:MCP sunucu detaylarını al'
    'add-json:JSON dizesi ile bir MCP sunucusu (stdio veya SSE) ekle'
    'add-from-claude-desktop:Claude Desktop uygulamasından MCP sunucularını içe aktar (yalnızca Mac ve WSL)'
    'reset-project-choices:Bu projedeki tüm onaylanmış/reddedilmiş proje kapsamlı (.mcp.json) sunucuları sıfırla'
    'login:Bir MCP sunucusuyla kimlik doğrula (HTTP, SSE veya claude.ai bağlayıcısı)'
    'logout:Bir MCP sunucusu için saklanan OAuth kimlik bilgilerini temizle'
    'help:Yardım göster'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Yardım göster]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp komutları' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Hata ayıklama modunu etkinleştir]' \
            '--verbose[Yapılandırma dosyasındaki ayrıntılı mod ayarını geçersiz kıl]' \
            '(-h --help)'{-h,--help}'[Yardım göster]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Yapılandırma kapsamı (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Taşıma türü (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Ortam değişkeni ayarla (örn. -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[WebSocket başlığı ayarla]:header:' \
            '--client-id[HTTP/SSE sunucuları için OAuth istemci kimliği]:clientId:' \
            '--client-secret[OAuth istemci gizli anahtarını sor (veya MCP_CLIENT_SECRET ortam değişkenini ayarla)]' \
            '--callback-port[OAuth geri çağrısı için sabit bağlantı noktası (önceden kayıtlı yönlendirme URI'\''si gerektiren sunucular için)]:port:' \
            '(-h --help)'{-h,--help}'[Yardım göster]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Yapılandırma kapsamı (local, user, project) - belirtilmezse mevcut kapsamdan kaldır]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Yardım göster]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Yardım göster]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Yardım göster]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Yapılandırma kapsamı (local, user, project)]:scope:(local user project)' \
            '--client-secret[OAuth istemci gizli anahtarını sor (veya MCP_CLIENT_SECRET ortam değişkenini ayarla)]' \
            '(-h --help)'{-h,--help}'[Yardım göster]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Yapılandırma kapsamı (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Yardım göster]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Yardım göster]'
          ;;
        login)
          _arguments \
            '--no-browser[Tarayıcı açmak yerine yetkilendirme URL'\''sini yazdır (SSH/başsız oturumlar için)]' \
            '(-h --help)'{-h,--help}'[Yardım göster]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Yardım göster]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Bir eklenti veya pazar yeri bildirimini doğrula'
    'marketplace:Claude Code pazar yerlerini yönet'
    'list:Kurulu eklentileri listele'
    'details:Bir eklenti için bileşen envanterini ve öngörülen belirteç maliyetini göster'
    'install:Mevcut pazar yerlerinden bir eklenti kur'
    'i:Mevcut pazar yerlerinden bir eklenti kur (install için kısa form)'
    'init:Yeni bir eklenti iskeleti oluştur (sonraki oturumda otomatik yüklenir)'
    'new:Yeni bir eklenti iskeleti oluştur (init için takma ad)'
    'uninstall:Kurulu bir eklentiyi kaldır'
    'remove:Kurulu bir eklentiyi kaldır (uninstall için takma ad)'
    'enable:Devre dışı bir eklentiyi etkinleştir'
    'disable:Etkin bir eklentiyi devre dışı bırak'
    'update:Bir eklentiyi en son sürüme güncelle'
    'eval:Bir eklentiye karşı değerlendirme durumlarını çalıştır ve puanlanan sonuçları raporla'
    'prune:Artık gerekmeyen otomatik kurulan bağımlılıkları kaldır'
    'autoremove:Artık gerekmeyen otomatik kurulan bağımlılıkları kaldır (prune için takma ad)'
    'tag:Bir eklenti sürümü için {name}--v{version} git etiketi oluştur'
    'help:Yardım göster'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Yardım göster]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin komutları' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Uyarıları hata olarak değerlendir (çıkış 1)]' \
            '--json[Doğrulama raporunu JSON olarak çıktıla (aynı çıkış kodları)]' \
            '(-h --help)'{-h,--help}'[Yardım göster]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Kurulum kapsamı]:scope:(user project local)' \
            '*--config[Eklenti bildiriminde tanımlanan bir userConfig seçeneğini ayarla (tekrarlanabilir)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Gösterilen pazar yeri tarafından bildirilen komutu onay istemi olmadan kabul et]' \
            '--json[İnsan için mesaj yerine makine tarafından okunabilir tek satırlık sonuç yazdır]' \
            '(-h --help)'{-h,--help}'[Yardım göster]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Kurulum kapsamı]:scope:(user project local)' \
            '--keep-data[Eklentinin kalıcı veri dizinini koru]' \
            '--prune[Artık gerekmeyen otomatik kurulan bağımlılıkları da kaldır]' \
            '(-y --yes)'{-y,--yes}'[--prune onay istemini atla]' \
            '--json[İnsan için mesaj yerine makine tarafından okunabilir tek satırlık sonuç yazdır (--prune ile birlikte kullanılamaz)]' \
            '(-h --help)'{-h,--help}'[Yardım göster]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Kurulum kapsamı]:scope:(user project local)' \
            '--json[İnsan için mesaj yerine makine tarafından okunabilir tek satırlık sonuç yazdır]' \
            '(-h --help)'{-h,--help}'[Yardım göster]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Etkin tüm eklentileri devre dışı bırak]' \
            '(-s --scope)'{-s,--scope}'[Kurulum kapsamı]:scope:(user project local)' \
            '--json[İnsan için mesaj yerine makine tarafından okunabilir tek satırlık sonuç yazdır]' \
            '(-h --help)'{-h,--help}'[Yardım göster]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Kurulum kapsamı]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Gösterilen pazar yeri tarafından bildirilen komutu onay istemi olmadan kabul et]' \
            '--json[İnsan için mesaj yerine makine tarafından okunabilir tek satırlık sonuç yazdır]' \
            '(-h --help)'{-h,--help}'[Yardım göster]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[JSON olarak çıktıla]' \
            '--available[Pazar yerlerindeki kullanılabilir eklentileri de dahil et (--json gerektirir)]' \
            '(-h --help)'{-h,--help}'[Yardım göster]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Temizlik yapılacak kapsam]:scope:(user project local)' \
            '--dry-run[Kaldırmadan nelerin kaldırılacağını listele]' \
            '(-y --yes)'{-y,--yes}'[Onay istemini atla]' \
            '(-h --help)'{-h,--help}'[Yardım göster]'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Yardım göster]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Bildirim açıklaması]:text:' \
            '--author[Yazar adı (varsayılan: git config user.name)]:name:' \
            '--author-email[Yazar e-postası (varsayılan: git config user.email)]:email:' \
            '--with[Ayrıca iskeleti oluşturulacak bileşenler]:components:' \
            '(-f --force)'{-f,--force}'[Hedefteki mevcut .claude-plugin/ dizininin üzerine yaz]' \
            '(-h --help)'{-h,--help}'[Yardım göster]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Vakaları ad glob'\''una göre filtrele]:glob:' \
            '*--tag[Vakaları etikete göre filtrele (tekrarlanabilir)]:tag:' \
            '--runs[Vaka başına çalıştırma sayısını geçersiz kıl (varsayılan: case.runs, yoksa 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Aynı anda en fazla n ajan çalıştır (1-8; varsayılan 1)]:n:' \
            '--model[Tüm vakalar için modeli geçersiz kıl]:model:_claude_model_names' \
            '--judge-model[LLM değerlendirici modelini geçersiz kıl (varsayılan: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Kesin maliyet tavanı; aşılırsa durdur ve kısmi sonuçları raporla (çıkış 2)]:usd:' \
            '--output-dir[aggregate-result.json için dizin]:dir:_directories' \
            '--eval-dir[Değerlendirme vakalarını tutan dizin adı (eklentinin altında)]:dir:' \
            '--json[Tam çalıştırma sonucunu JSON olarak stdout'\''a yazdır veya bu .json dosyasına yaz]::path:_files' \
            '--threshold[Herhangi bir vakanın puanı bu eşiğin altındaysa 1 ile çık (varsayılan: 1.0)]:threshold:' \
            '*--allow-tools[Kısıtlı araçlar (Bash, Write, Edit, WebFetch, mcp__*) için operatör izni]:tools:' \
            '(--no-scaffold)--scaffold[Her vakanın scaffold_script'\''ini çalıştır (yazarın sağladığı bash'\''i sizin adınıza çalıştırır; varsayılan olarak kapalı)]' \
            '(--scaffold)--no-scaffold[scaffold_script'\''i açıkça atla]' \
            '--trust-plugin[Bu eklentiye ve değerlendirme paketine güvendiğinizi belirterek ilk çalıştırmadaki güven istemini atla (CI için)]' \
            '--ablation[Eklentisiz bir temel çalıştırma da yap ve puan farkını raporla]:mode:(none with-without)' \
            '--mocks[MCP sunucuları için sahte yedekler (<eval dir>/mocks/ içinden)]:mode:(record off)' \
            '--allow-real-servers[--mocks record ile: sahtesi olmayan gerçek MCP sunucu süreçlerini de başlat]' \
            '--keep-temp[Hata ayıklama için scaffold dizinlerini koru]' \
            '--verbose[Mesaj başına izleme olaylarını hata ayıklama günlüğüne kaydet]' \
            '--report[Bağımsız HTML raporunu sonuç dizini yerine bu yola yaz]:path:_files' \
            '(--no-publish)--publish-report[Raporun claude.ai'\''da yayımlanmasını da zorunlu kıl]' \
            '(--publish-report)--no-publish[HTML raporunu yalnızca yerelde tut; claude.ai'\''da yayımlama]' \
            '(-h --help)'{-h,--help}'[Yardım göster]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Etiketi oluşturduktan sonra --remote'\''a gönder]' \
            '--dry-run[Oluşturmadan nelerin etiketleneceğini yazdır]' \
            '(-f --force)'{-f,--force}'[Kirli çalışma ağacı ve etiket zaten var denetimlerini atla]' \
            '(-m --message)'{-m,--message}'[Etiket açıklama mesajı (sürüm için %s kullanın)]:msg:' \
            '--remote[--push ile gönderilecek uzak depo]:name:' \
            '(-h --help)'{-h,--help}'[Yardım göster]' \
            '::path:_files'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:URL, yol veya GitHub deposundan bir pazar yeri ekle'
    'list:Yapılandırılmış pazar yerlerini listele'
    'remove:Yapılandırılmış bir pazar yerini kaldır'
    'rm:Yapılandırılmış bir pazar yerini kaldır (remove için takma ad)'
    'update:Pazar yerini kaynaktan güncelle - isim belirtilmezse tümünü güncelle'
    'help:Yardım göster'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Yardım göster]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace komutları' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[git sparse-checkout ile checkout'\''u belirli dizinlerle sınırla (monorepo'\''lar için)]:paths:' \
            '--scope[Pazar yerinin nerede bildirileceği]:scope:(user project local)' \
            '--claudeai[claude.ai'\''ın sizin için barındırdığı bu addaki pazar yerini ekle]' \
            '(-h --help)'{-h,--help}'[Yardım göster]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[JSON olarak çıktıla]' \
            '(-h --help)'{-h,--help}'[Yardım göster]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Pazar yeri bildirimini belirli bir ayar kapsamından kaldır (tüm kapsamlardan kaldırmak için boş bırakın)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Yardım göster]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Yardım göster]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Zaten kurulu olsa bile kurulumu zorla]' \
    '(-h --help)'{-h,--help}'[Yardım göster]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Görevlendirilen oturumlarda araç erişimine izin verilecek ek dizin]:directory:_directories' \
    '--agent[Ajan görünümünden görevlendirilen oturumlar için varsayılan ajan]:agent:_claude_agent_names' \
    '--all[--json ile: tamamlanmış arka plan oturumlarını da dahil et]' \
    '--allow-dangerously-skip-permissions[Görevlendirilen oturumlarda izinleri atlama modunu kullanılabilir yap]' \
    '--cwd[Yalnızca yol altında başlatılan arka plan oturumlarını göster]:path:_directories' \
    '--dangerously-skip-permissions[--permission-mode bypassPermissions için takma ad]' \
    '--effort[Görevlendirilen oturumlar için varsayılan çaba düzeyi]:level:(low medium high xhigh max)' \
    '--json[Etkin oturumları JSON dizisi olarak yazdır ve çık]' \
    '*--mcp-config[Görevlendirilen oturumlara uygulanacak MCP sunucu yapılandırması]:config:' \
    '--model[Ajan görünümünden görevlendirilen oturumlar için varsayılan model]:model:_claude_model_names' \
    '--permission-mode[Görevlendirilen oturumlar için varsayılan izin modu]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Ajan görünümü ve görevlendirilen oturumlar için dizinden eklenti yükle]:path:_directories' \
    '--setting-sources[Yüklenecek ayar kaynaklarının virgülle ayrılmış listesi (user, project, local)]:sources:' \
    '--settings[Uygulanacak ayarlar dosyası veya JSON dizesi]:file-or-json:_files' \
    '--strict-mcp-config[Görevlendirilen oturumlarda yalnızca --mcp-config üzerinden MCP sunucularını kullan]' \
    '--restricted[Başlatılan oturumları kısıtlı modda başlat]' \
    '(-h --help)'{-h,--help}'[Komut için yardım göster]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Anthropic hesabınızda oturum açın'
    'logout:Anthropic hesabınızdan çıkış yapın'
    'status:Kimlik doğrulama durumunu göster'
    'help:Yardım göster'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Komut için yardım göster]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth komutları' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Giriş sayfasında e-posta adresini önceden doldur]:email:' \
            '--sso[SSO giriş akışını zorla]' \
            '(--claudeai)--console[Claude aboneliği yerine Anthropic Console (API kullanım faturalandırması) kullan]' \
            '(--console)--claudeai[Claude aboneliğini kullan (varsayılan)]' \
            '(-h --help)'{-h,--help}'[Komut için yardım göster]'
          ;;
        status)
          _arguments \
            '(--text)--json[JSON olarak çıktıla (varsayılan)]' \
            '(--json)--text[İnsan tarafından okunabilir metin olarak çıktıla]' \
            '(-h --help)'{-h,--help}'[Komut için yardım göster]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Komut için yardım göster]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Etkin otomatik mod yapılandırmasını JSON olarak yazdır'
    'critique:Özel otomatik mod kurallarınız hakkında AI geri bildirimi al'
    'defaults:Varsayılan otomatik mod kurallarını JSON olarak yazdır'
    'reset:Otomatik mod yapılandırmasını gönderilen varsayılanlara sıfırla'
    'help:Yardım göster'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Komut için yardım göster]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode komutları' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Kullanılan modeli geçersiz kıl]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Komut için yardım göster]'
          ;;
        defaults)
          _arguments \
            '--label[Yalnızca etiketi bu önekle başlayan kuralları göster (büyük/küçük harf duyarsız)]:prefix:' \
            '(-h --help)'{-h,--help}'[Komut için yardım göster]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Onay istemini atla]' \
            '(-h --help)'{-h,--help}'[Komut için yardım göster]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Komut için yardım göster]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Ağ geçidi YAML yapılandırmasının yolu]:path:_files' \
    '(-h --help)'{-h,--help}'[Komut için yardım göster]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Bir proje için tüm Claude Code durumunu sil (transkriptler, görevler, dosya geçmişi, yapılandırma girişi)'
    'help:Yardım göster'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Komut için yardım göster]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project komutları' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Hiçbir şeyi silmeden nelerin silineceğini listele]' \
            '(-y --yes)'{-y,--yes}'[Onay istemini atla]' \
            '(-i --interactive)'{-i,--interactive}'[Silmeden önce her öğe için sor]' \
            '(1)--all[Tüm projelerin durumunu temizle (bir yolla birlikte kullanılamaz)]' \
            '(-h --help)'{-h,--help}'[Komut için yardım göster]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Biçimlendirilmiş bulgular yerine ham bugs.json içeriğini yazdır]' \
    '--timeout[İncelemenin bitmesini beklemek için maksimum dakika (varsayılan: 45)]:minutes:' \
    '(--no-post)--post[Tamamlanan inceleme bulgularını sizin adınıza PR'\''a gönder (yalnızca PR hedefleri; review değil, tek bir düz yorum)]' \
    '(--post)--no-post[Bulguları PR'\''a gönderme (varsayılan)]' \
    '(-h --help)'{-h,--help}'[Komut için yardım göster]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Çalışan tüm arka plan oturumlarını yeniden başlat]' \
    '(-h --help)'{-h,--help}'[Komut için yardım göster]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Worktree'\''nin gönderilmemiş commit'\''lerini ve commit'\''lenmemiş değişikliklerini de at (önceki bir claude rm'\''in bildirdiği commit@worktree-id değerini geçirin)]:commit@worktree-id:' \
    '--force-remove-worktree[WorktreeRemove kancası veya git kaldıramamış olsa bile worktree dizinini sil (önceki bir claude rm'\''in bildirdiği worktree-id değerini geçirin)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Komut için yardım göster]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Hiçbir şey yazmadan nelerin içe aktarılacağını göster]' \
    '--yes[Etkileşimli seçiciyi atla (başsız ortamlarda /import önizlemesindeki --yes=<digest> değerini geçirin)]' \
    '(-h --help)'{-h,--help}'[Komut için yardım göster]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
