#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Kònfigùrëjë ë sprôwiô serwerama MCP'
    'plugin:Sprôwiô wtëkama Claude Code'
    'agents:Sprôwiô agentama w tle'
    'attach:Òtmikô sesjã w tle w tim terminalu'
    'logs:Wëpisëje slédné wińdzenié terminala sesje w tle'
    'stop:Zatrzëmiwô sesjã w tle (ji rozmòwa òstôwô zachòwónô)'
    'respawn:Pòwtórno zrëszô sesjã w tle, żebë dzejała na aktualny wersje Claude Code'
    'rm:Rëmô sesjã w tle, a téż ji worktree, czej to je bezpieczné'
    'auth:Sprôwiô ùwierzëtelnianim'
    'auto-mode:Przezérô abò resetëje kònfigùracjã klasyfikatora auto mòdusa'
    'gateway:Zrëszô przedsãbiorstwòwą bramã aùth/telemetrie'
    'import:Impòrtëje kònfigùracjã z jinégò agenta AI do pisaniô kòdu do Claude Code'
    'project:Sprôwiô stanã projektu Claude Code'
    'ultrareview:Zrëszô wielo-agentowi przezérk kòdu w chmùrze ë wëpisëje nalôzczi'
    'setup-token:Nastôwi dłudżotrwałi tokén ùwierzëtelnianiô (wëmôgô abònamentu Claude)'
    'doctor:Kòntrola zdrowiô aùto-aktualizatora Claude Code'
    'update:Sprawdzë ë zainstalëje aktualizacje'
    'install:Instalëje nôtëwną kòmpilacjã Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Włączë debug mòdus z òpcjonalnym filtrowanim kategorii (np. "api,hooks" abò "!statsig,!file")]:filter:'
    '--verbose[Nadpiszë nastôw verbose mòdusa z plika kònfigùracje]'
    '(-p --print)'{-p,--print}'[Wëpiszë òdpòwiésc ë wińdzë (do ùżëcô z pipe). Bôczënk: ùżiwôj le w zaùfónych katalogach]'
    '--output-format[Fòrmat wińdzeniô (z --print): "text" (domëslny), "json" (jedno realtat), abò "stream-json" (strumieniowanié w reálnym czasu)]:format:(text json stream-json)'
    '--json-schema[JSON schema do walidacje structurowónégò wińdzeniô]:schema:'
    '--include-partial-messages[Dołączë częsãdné kawałczi wiadła jak przëchôdają (z --print ë --output-format=stream-json)]'
    '--input-format[Fòrmat wéńdzeniô (z --print): "text" (domëslny) abò "stream-json" (strumieniowé wéńdzenié w reálnym czasu)]:format:(text stream-json)'
    '--mcp-debug[\[Òprzestóné. Brëkùj --debug w môl tegò\] Włączë MCP debug mòdus (pòkazëje felë serwera MCP)]'
    '--dangerously-skip-permissions[Òbińdzë wszëtczé kòntrolë zezwòleniów. Zalécóné le dlô sandboxów bez przistãpù do internetu]'
    '--allow-dangerously-skip-permissions[Włączë òpcjã òbeńdzeniô kòntrolów zezwòleniów bez włączaniô domëslno]'
    '--restricted[Ògrańczony mòdus: ùsuń nôrzãdza, chtërne zrëszają kòmandë abò kòd, ë WebFetch, ignorëj nastôwë user/project/local ë ògrańczë nôrzãdza plików do robòczich katalogów]'
    '--max-budget-usd[Maksymalnô kwòta w dolarach do wëdaniô na wołania API (le --print)]:amount:'
    '--replay-user-messages[Pòwtórno wëslë wiadła brëkòwnika ze stdin na stdout do pòcwierdzeniô]'
    '--allowed-tools[Lësta dozwòlonych mionów nôrzãdzów òddzelonô kòmą abò spacją (np. "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Lësta dozwòlonych mionów nôrzãdzów òddzelonô kòmą abò spacją (fòrmat camelCase)]:tools:'
    '--tools[Òkreslë lëstã przistãpnych nôrzãdzów z wbùdowónégò zbioru. Le w print mòdusu]:tools:'
    '--disallowed-tools[Lësta zakôzónych mionów nôrzãdzów òddzelonô kòmą abò spacją (np. "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Lësta zakôzónych mionów nôrzãdzów òddzelonô kòmą abò spacją (fòrmat camelCase)]:tools:'
    '--mcp-config[Wczëtôj serwerë MCP z plika JSON abò cygù (òddzelonégò spacją)]:configs:'
    '--system-prompt[Systemòwi prompt do ùżëcô dlô sesje]:prompt:'
    '--system-prompt-file[Wczëtôj systemòwi prompt z plika]:file:_files'
    '--append-system-prompt[Dodôj systemòwi prompt do domëslnégò systemòwégò promptu]:prompt:'
    '--append-system-prompt-file[Wczëtôj systemòwi prompt z plika ë dodôj gò do domëslnégò systemòwégò promptu]:file:_files'
    '--system-prompt-snapshot[Zapiszë systemòwi prompt rôz na rozmòwã ë brëkùj gò dosłowno przë kòżdi prosbie ë wznowienim (on, domëslno) abò renderëjë gò nowò przë kòżdi prosbie (off)]:mode:(on off)'
    '--permission-mode[Mòdus zezwòleniów do ùżëcô dlô sesje]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Chto òdpòwiôdô na pëtania ò zezwòlenié z --print: "host" (host SDK abò --permission-prompt-tool) abò "none" (wszëtkò, co bë pëtało, je òdrzuconé)]:target:(host none)'
    '--permission-prompt-tool[Nôrzãdzé MCP do ùżëcô przë pëtaniach ò zezwòlenié (le --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Kòntinuùjë nônowszą rozmòwã]'
    '(-r --resume)'{-r,--resume}'[Wznowi rozmòwã - pòdôj ID sesje abò wëbierzë interaktiwno]:sessionId:_claude_sessions'
    '--fork-session[Ùsôdzë nowé ID sesje w môl brëkòwaniô òriginalnégò ID sesje przë wznôwianim (z --resume abò --continue)]'
    '--no-session-persistence[Wëłączë trwałosc sesje - sesje nie bãdą zapisóné (le --print)]'
    '--model[Model dlô aktualny sesje. Pòdôj alias dlô nônowszégò modelu (np. '\''sonnet'\'' abò '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agent dlô aktualny sesje. Nadpisëje nastôw '\''agent'\'']:agent:_claude_agent_names'
    '--betas[Beta nagłówczi do dołączeniô w prosbach API (le brëkòwnicë z klucza API)]:betas:'
    '--fallback-model[Włączë aùtomatny fallback do òkreslonégò modelu, czej domëslny model je przecążony (le --print)]:model:_claude_model_names'
    '--settings[Stegna do plika JSON z nastôwama abò cygù JSON do wczëtaniô dodôwkòwëch nastôwów]:file-or-json:_files'
    '--add-dir[Dodôwkòwé katalodżi do zezwòleniô przistãpù nôrzãdzóm]:directories:_directories'
    '--ide[Aùtomatno pòłączë z IDE przë sztarce, jeżlë je przistãpné akùrat jedno wôżné IDE]'
    '--desktop[Òtemkni w aplikacji Claude Desktop w môl terminala (z --continue abò --resume <id>, żebë wëbrac sesjã)]'
    '--strict-mcp-config[Brëkùj le serwerów MCP z --mcp-config ë ignorëj wszëtczé jiné nastôwë MCP]'
    '--session-id[Kònkretné ID sesje do ùżëcô dlô rozmòwë (mùszi bëc wôżny UUID)]:uuid:'
    '--agents[Òbiekt JSON òpisëjący włôsné agentë]:json:'
    '--setting-sources[Lësta zdrojów nastôwów do wczëtaniô òddzelonô kòmą (user, project, local)]:sources:'
    '--plugin-dir[Katalog do wczëtaniô wtëków le dlô ti sesje (mòże pòwtôrzac)]:paths:_directories'
    '--disable-slash-commands[Wëłączë wszëtczé slash-kòmandë]'
    '(--bg --background)'{--bg,--background}'[Zrëszë sesjã jakò agent w tle ë zarô wrócë]'
    '(-w --worktree)'{-w,--worktree}'[Ùsôdzë nowi git worktree dlô ti sesje (òpcjonalno pòdôj miono)]::name:'
    '--tmux=-[Ùsôdzë sesjã tmux dlô worktree (wëmôgô --worktree). Brëkùje nôtëwnëch panelów iTerm2, czej są przistãpné; --tmux=classic dlô tradicjowégò tmux]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Nastôwi wëskrzënioné miono dlô ti sesje]:name:'
    '--effort[Rówizna wësiłkù dlô aktualny sesje]:level:(low medium high xhigh max)'
    '--autocompact[Wiôlgòsc òkna aùto-kòmpaktowaniô (auto, abò 100k-1M tokenów)]:size:(auto)'
    '--debug-file[Zapiszë debug logi do kònkretny stegnë plika (dorozëmno włączô debug mòdus)]:path:_files'
    '--from-pr[Wznowi sesjã sparłãczoną z PR przez numer/URL, abò òtemkni interaktiwny wëbiérnik]::value:'
    '--teleport[Wznowi sesjã teleport, òpcjonalno pòdôj ID sesje]::session:'
    '--cloud[Ùsôdzë sesjã w chmùrze z pòdónym òpisënkã abò pòdłączë sã do jistniejący przez ID sesje abò URL claude.ai/code]::description-or-session:'
    '--environment[Ùsôdzë nową sesjã w chmùrze, chtërna dzejô w pòdónym samòhòstowónym strzodowiskù (ccpool_...)]:environment_id:'
    '--remote-control[Zrëszë interaktiwną sesjã z włączonym Remote Control (òpcjonalno z mionã)]::name:'
    '--remote-control-session-name-prefix[Prefiks dlô aùtomatno generowónëch mionów sesji Remote Control]:prefix:'
    '--chrome[Włączë integracjã Claude w Chrome]'
    '--no-chrome[Wëłączë integracjã Claude w Chrome]'
    '--plugin-url[Pòbierzë wtëk .zip z URL le dlô ti sesje (mòże pòwtôrzac)]:url:'
    '--file[Zdroje plików do pòbraniô przë sztarce (fòrmat: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Włączë pòdpòwiescë promptów (emitëje przewidzóny pòstãpny prompt w print/SDK mòdusu)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Przekazëje tekst subagenta ë blokë mëszleniô jakò wiadła (z --print ë stream-json)]'
    '--include-hook-events[Dołączë wszëtczé eventë żëcowégò cyklu hooków w strumieniu wińdzeniô (z stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Przeniesë sekcje przëpisóné do maszinë do pierszégò wiadła brëkòwnika, żebë pòlepszëc pòwtórné ùżëcé prompt-cache]'
    '--brief[Włączë nôrzãdzé SendUserMessage do kòmùnikacje agent-do-brëkòwnika]'
    '--safe-mode[Zrëszë z wëłączonyma wszëtczima przëstosowaniama (przëdatné do rozwiązywaniô problemów zepsùti kònfigùracje)]'
    '--bare[Minimalny mòdus: przeskòczë hooczi, LSP, synchronizacjã wtëków, atribùcjã, auto-pamiãc ë auto-òdkrëwanié CLAUDE.md]'
    '--ax-screen-reader[Renderëje wińdzenié przëjazné dlô czëtnika ekranu (płôsczi tekst, bez dekoracjnëch ramów abò animacji)]'
    '(-v --version)'{-v,--version}'[Wëpiszë numer wersje]'
    '(-h --help)'{-h,--help}'[Pòkôżë pòmòc dlô kòmandë]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'klôda kòmandë' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc dlô kòmandë]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "felëje argùmentów"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Zrëszô serwer MCP Claude Code'
    'add:Dodôwô serwer MCP do Claude Code'
    'remove:Ùsëwô serwer MCP'
    'list:Lëstëje skònfigùrowóné serwerë MCP'
    'get:Wëdostôwô drobnotë serwera MCP'
    'add-json:Dodôwô serwer MCP (stdio abò SSE) z cygã JSON'
    'add-from-claude-desktop:Impòrtëje serwerë MCP z Claude Desktop (le Mac ë WSL)'
    'reset-project-choices:Resetëje wszëtczé zatwiérdzoné/òdrzuconé serwerë z zasygù projektu (.mcp.json) w tim projekce'
    'login:Ùwierzëtelniwô z serwerã MCP (HTTP, SSE, abò konektor claude.ai)'
    'logout:Wëczëszczô przechòwóné pòwierzenia OAuth dlô serwera MCP'
    'help:Pòkôżë pòmòc'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp kòmandë' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Włączë debug mòdus]' \
            '--verbose[Nadpiszë nastôw verbose mòdusa z plika kònfigùracje]' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Zasyg kònfigùracje (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Ôrt transpòrtu (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Nastôwi zmienną strzodowiskòwą (np. -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Nastôwi nagłówk WebSocket]:header:' \
            '--client-id[ID klienta OAuth dlô serwerów HTTP/SSE]:clientId:' \
            '--client-secret[Pëtôj ò tajemnicã klienta OAuth (abò nastôwi zmienną strzodowiskòwą MCP_CLIENT_SECRET)]' \
            '--callback-port[Stałi pòrt dlô callbacku OAuth (dlô serwerów, chtërne wëmôgają wczasniészi registracje URI przekierowaniô)]:port:' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Zasyg kònfigùracje (local, user, project) - ùsëwô z jistniejącégò zasygù, jeżlë nie òkreslono]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Zasyg kònfigùracje (local, user, project)]:scope:(local user project)' \
            '--client-secret[Pëtôj ò tajemnicã klienta OAuth (abò nastôwi zmienną strzodowiskòwą MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Zasyg kònfigùracje (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]'
          ;;
        login)
          _arguments \
            '--no-browser[Wëpiszë URL ùwierzëtelnianiô w môl òtmikaniô przezérnika (dlô sesji SSH/bez ekranu)]' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Walidëje manifest wtëkù abò rënkù'
    'marketplace:Sprôwiô rënkama Claude Code'
    'list:Lëstëje zainstalowóné wtëczi'
    'details:Pòkazëje inwentôrz kòmpònentów ë przewidzóny kòszt tokenów dlô wtëkù'
    'configure:Pòkazëje òpcje wtëkù ë chtërne nie są nastôwioné, abò zapisëje wôrtnoscë ze stdin'
    'install:Instalëje wtëk z przistãpnëch rënków'
    'i:Instalëje wtëk z przistãpnëch rënków (skrócenié dlô install)'
    'init:Ùsôdzô rusztowanié nowégò wtëkù (aùtomatno wczëtô w pòstãpny sesje)'
    'new:Ùsôdzô rusztowanié nowégò wtëkù (alias dlô init)'
    'uninstall:Òdinstalëje zainstalowóny wtëk'
    'remove:Òdinstalëje zainstalowóny wtëk (alias dlô uninstall)'
    'enable:Włączô wëłączony wtëk'
    'disable:Wëłączô włączony wtëk'
    'update:Aktualizëje wtëk do nônowszi wersje'
    'eval:Zrëszô przëpôdczi eval procëm wtëkòwi ë rapòrtëje òcenioné realtatë'
    'prune:Ùsëwô aùtomatno zainstalowóné zanôleżnoscë, chtërne ju nie są nótné'
    'autoremove:Ùsëwô aùtomatno zainstalowóné zanôleżnoscë, chtërne ju nie są nótné (alias dlô prune)'
    'tag:Ùsôdzô git tag {name}--v{version} dlô wëdôwkù wtëkù'
    'test:Zrëszô testë modu'
    'help:Pòkôżë pòmòc'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'wtëkòwé kòmandë' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Traktëjë òstrzeżenia jakò felë (kòd zakùńczeniô 1)]' \
            '--json[Wëpiszë rapòrt walidacje jakò JSON (te same kòdë zakùńczeniô)]' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Zasyg instalacje]:scope:(user project local)' \
            '*--config[Nastôwi òpcjã userConfig zadeklarowóną w manifesce wtëkù (mòże pòwtôrzac)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Przëjmi wëskrzënioną kòmandã zadeklarowóną przez rënk bez pëtaniô ò pòcwierdzenié]' \
            '--json[Wëpiszë jedną réżkã realtatu do czëtaniô przez maszinã w môl wiadła dlô człowieka]' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Zasyg instalacje]:scope:(user project local)' \
            '--keep-data[Zachòwôj katalog trwałëch pòdôwków wtëkù]' \
            '--prune[Ùsuń téż aùtomatno zainstalowóné zanôleżnoscë, chtërne ju nie są nótné]' \
            '(-y --yes)'{-y,--yes}'[Przeskòczë pëtanié ò pòcwierdzenié --prune]' \
            '--json[Wëpiszë jedną réżkã realtatu do czëtaniô przez maszinã w môl wiadła dlô człowieka (nie z --prune)]' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Zasyg instalacje]:scope:(user project local)' \
            '--json[Wëpiszë jedną réżkã realtatu do czëtaniô przez maszinã w môl wiadła dlô człowieka]' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Wëłączë wszëtczé włączoné wtëczi]' \
            '(-s --scope)'{-s,--scope}'[Zasyg instalacje]:scope:(user project local)' \
            '--json[Wëpiszë jedną réżkã realtatu do czëtaniô przez maszinã w môl wiadła dlô człowieka]' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Zasyg instalacje]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Przëjmi wëskrzënioną kòmandã zadeklarowóną przez rënk bez pëtaniô ò pòcwierdzenié]' \
            '--json[Wëpiszë jedną réżkã realtatu do czëtaniô przez maszinã w môl wiadła dlô człowieka]' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Wińdzenié jakò JSON]' \
            '--available[Dołączë przistãpné wtëczi z rënków (wëmôgô --json)]' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Wëczëszczë w zasygù]:scope:(user project local)' \
            '--dry-run[Wëpiszë, co bë bëło ùsënióné, bez ùsëwaniô]' \
            '(-y --yes)'{-y,--yes}'[Przeskòczë pëtanié ò pòcwierdzenié]' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]'
          ;;
        configure)
          _arguments \
            '--json[Wińdzenié jakò JSON]' \
            '--values-stdin[Wczëtôj wôrtnoscë òpcji ze stdin jakò òbiekt JSON z jednoréżkòwëch cygów; pòminiãté òpcje zachòwëją swòje wôrtnoscë]' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Òpisënk manifestu]:text:' \
            '--author[Miono ùsôdzcë (domëslno: git config user.name)]:name:' \
            '--author-email[E-mail ùsôdzcë (domëslno: git config user.email)]:email:' \
            '--with[Kòmpònentë, do chtërnëch téż ùsadzëc rusztowanié]:components:' \
            '(-f --force)'{-f,--force}'[Nadpiszë jistniejący .claude-plugin/ w môlu docélowim]' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Filtrëjë przëpôdczi wedle wzorca glob miona]:glob:' \
            '*--tag[Filtrëjë przëpôdczi wedle tagù (mòże pòwtôrzac)]:tag:' \
            '--runs[Nadpiszë lëczbã przebiegów na przëpôdk (domëslno: case.runs, jinak 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Zrëszôj do n przebiegów agenta naròz (1-8; domëslno 1)]:n:' \
            '--model[Nadpiszë model dlô wszëtczich przëpôdków]:model:_claude_model_names' \
            '--judge-model[Nadpiszë model òceniwôcza LLM (domëslno: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Twardi górny limit kòsztów; przë jegò dosygniãcu przerwi ë zrapòrtëjë dzélowé realtatë (kòd zakùńczeniô 2)]:usd:' \
            '--output-dir[Katalog dlô aggregate-result.json]:dir:_directories' \
            '--eval-dir[Miono katalogù (pòd wtëkã), w chtërnym są przëpôdczi eval]:dir:' \
            '--json[Wëpiszë fùl realtat przebiegù jakò JSON na stdout abò zapiszë gò do tegò plika .json]::path:_files' \
            '--threshold[Zakùńczë z kòdã zakùńczeniô 1, jeżlë jaczi wënik przëpôdkù je niżi tegò prógù (domëslno: 1.0)]:threshold:' \
            '*--allow-tools[Zezwòlenié òperatora dlô zabezpieczonëch nôrzãdzów (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Zrëszë scaffold_script kòżdégò przëpôdkù (zrëszô bash dostarczony przez ùsôdzcã pòd twòjim kòntã; domëslno wëłączoné)]' \
            '(--scaffold)--no-scaffold[Wprost przeskòczë scaffold_script]' \
            '--trust-plugin[Pòcwierdzë, że ùfôsz temù wtëkòwi ë jegò zestôwòwi eval, przeskakùjąc pëtanié ò zaùfanié przë pierszim zrëszenim (dlô CI)]' \
            '--ablation[Zrëszë kòntrolną grëpã bez wtëkù ë zrapòrtëjë różnicã wëników]:mode:(none with-without)' \
            '--mocks[Zastãpné atrapë dlô serwerów MCP, z <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Z --mocks record: zrëszë téż prôwdzëwé procesë serwerów MCP, chtërne ni mają atrapë]' \
            '--keep-temp[Zachòwôj katalodżi rusztowaniô do debugòwaniô]' \
            '--verbose[Zapisëjë eventë szlachù dlô kòżdégò wiadła w debug logù]' \
            '--report[Zapiszë samòstójny rapòrt HTML na tã stegnã w môl katalogù realtatów]:path:_files' \
            '(--no-publish)--publish-report[Wëmôgôj téż òpùblikòwaniô rapòrtu na claude.ai]' \
            '(--publish-report)--no-publish[Trzëmôj rapòrt HTML le lokalno; przeskòczë jegò pùblikòwanié na claude.ai]' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Wëslë tag do --remote pò jegò ùsôdzenim]' \
            '--dry-run[Wëpiszë, co bë bëło òtagòwóné, bez ùsôdzaniô tagù]' \
            '(-f --force)'{-f,--force}'[Przeskòczë kòntrolë zmienionégò robòczégò drzewa ë ju jistniejącégò tagù]' \
            '(-m --message)'{-m,--message}'[Wiadło adnotacje tagù (brëkùj %s dlô wersje)]:msg:' \
            '--remote[Remote, do chtërnégò wësłac z --push]:name:' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Dodôwô rënk z URL, stegnë abò repòzytorium GitHub'
    'list:Lëstëje skònfigùrowóné rënczi'
    'remove:Ùsëwô skònfigùrowóny rënk'
    'rm:Ùsëwô skònfigùrowóny rënk (alias dlô remove)'
    'update:Aktualizëje rënk ze zdroju - aktualizëje wszëtczé, jeżlë miono nie pòdóné'
    'help:Pòkôżë pòmòc'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'rënk kòmandë' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Ògrańczë checkout do òkreslonëch katalogów przez git sparse-checkout (dlô monorepò)]:paths:' \
            '--scope[Dze zadeklarowac rënk]:scope:(user project local)' \
            '--claudeai[Dodôj rënk ò tim mionie, chtëren claude.ai hòstëje dlô ce]' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Wińdzenié jakò JSON]' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Ùsuń deklaracjã rënkù z òkreslonégò zasygù nastôwów (pòmiń, żebë ùsënąc jã z kòżdégò zasygù)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Wëmùszë instalacjã nawetka jeżlë ju zainstalowóné]' \
    '(-h --help)'{-h,--help}'[Pòkôżë pòmòc]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Dodôwkòwi katalog do zezwòleniô przistãpù nôrzãdzóm w wësłónëch sesjach]:directory:_directories' \
    '--agent[Domëslny agent dlô sesji wësłónëch z wëzdrzatkù agenta]:agent:_claude_agent_names' \
    '--all[Z --json: dołączë téż zakùńczoné sesje w tle]' \
    '--allow-dangerously-skip-permissions[Ùczëni mòdus òbińdzeniô zezwòleniów przistãpnym dlô wësłónëch sesji]' \
    '--cwd[Pòkażë le sesje w tle zrëszóné pòd stegną]:path:_directories' \
    '--dangerously-skip-permissions[Alias dlô --permission-mode bypassPermissions]' \
    '--effort[Domëslnô rówizna wësiłkù dlô wësłónëch sesji]:level:(low medium high xhigh max)' \
    '--json[Wëpiszë aktiwné sesje jakò tôfla JSON ë wińdzë]' \
    '*--mcp-config[Kònfigùracjô serwera MCP do zastosowaniô w wësłónëch sesjach]:config:' \
    '--model[Domëslny model dlô sesji wësłónëch z wëzdrzatkù agenta]:model:_claude_model_names' \
    '--permission-mode[Domëslny mòdus zezwòleniów dlô wësłónëch sesji]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Wczëtôj wtëczi z katalogù dlô wëzdrzatkù agenta ë wësłónëch sesji]:path:_directories' \
    '--setting-sources[Lësta zdrojów nastôwów do wczëtaniô òddzelonô kòmą (user, project, local)]:sources:' \
    '--settings[Plik z nastôwama abò cyg JSON do zastosowaniô]:file-or-json:_files' \
    '--strict-mcp-config[Brëkùj le serwerów MCP z --mcp-config w wësłónëch sesjach]' \
    '--restricted[Zrëszôj wësłóné sesje w ògrańczonym mòdusu]' \
    '(-h --help)'{-h,--help}'[Pòkôżë pòmòc dlô kòmandë]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Zalogùjë sã do twòjégò kònta Anthropic'
    'logout:Wëlogùjë sã z twòjégò kònta Anthropic'
    'status:Pòkazëje status ùwierzëtelnianiô'
    'help:Pòkôżë pòmòc'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Pòkôżë pòmòc dlô kòmandë]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'ùwierzëtelnianié kòmandë' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Wstãpno wpiszë adresã e-mail na starnie logòwaniô]:email:' \
            '--sso[Wëmùszë logòwanié przez SSO]' \
            '(--claudeai)--console[Brëkùj Anthropic Console (płacenié za ùżëcé API) w môl abònamentu Claude]' \
            '(--console)--claudeai[Brëkùj abònamentu Claude (domëslno)]' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc dlô kòmandë]'
          ;;
        status)
          _arguments \
            '(--text)--json[Wińdzenié jakò JSON (domëslno)]' \
            '(--json)--text[Wińdzenié jakò tekst do czëtaniô przez człowieka]' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc dlô kòmandë]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc dlô kòmandë]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Wëpisëje òbowiązëjącą kònfigùracjã auto mòdusa jakò JSON'
    'critique:Dostôwô AI òpiniã ò twòjich włôsnëch regùłach auto mòdusa'
    'defaults:Wëpisëje domëslné regùłë auto mòdusa jakò JSON'
    'reset:Resetëje kònfigùracjã auto mòdusa do dostarczonëch domëslnëch'
    'help:Pòkôżë pòmòc'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Pòkôżë pòmòc dlô kòmandë]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mòdus kòmandë' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Nadpiszë, jaczi model je brëkòwóny]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc dlô kòmandë]'
          ;;
        defaults)
          _arguments \
            '--label[Pòkôżë le regùłë, chtërnëch etikéta zaczinô sã tim prefiksã (bez różnicë wiôldżich ë môłëch lëterów)]:prefix:' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc dlô kòmandë]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Przeskòczë pëtanié ò pòcwierdzenié]' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc dlô kòmandë]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc dlô kòmandë]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Stegna do kònfigùracje YAML bramë]:path:_files' \
    '(-h --help)'{-h,--help}'[Pòkôżë pòmòc dlô kòmandë]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Rëmô całi stón Claude Code dlô projektu (transkriptë, zadania, historiô plików, wpis kònfigùracje)'
    'help:Pòkôżë pòmòc'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Pòkôżë pòmòc dlô kòmandë]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'projektowé kòmandë' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Wëpiszë, co bë bëło rëmniãté, bez rëmaniô czegòkòlwiek]' \
            '(-y --yes)'{-y,--yes}'[Przeskòczë pëtanié ò pòcwierdzenié]' \
            '(-i --interactive)'{-i,--interactive}'[Pëtôj ò kòżdi element przed rëmanim]' \
            '(1)--all[Rëmôj stón dlô kòżdégò projektu (wzajemno wëkluczô sã ze stegną)]' \
            '(-h --help)'{-h,--help}'[Pòkôżë pòmòc dlô kòmandë]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Wëpiszë sërowi ładënk bugs.json w môl sfòrmatowónëch nalôzków]' \
    '--timeout[Maksymalnô lëczba minut na żdanié na zakùńczenié przezérkù (domëslno: 45)]:minutes:' \
    '(--no-post)--post[Òpùblikùjë nalôzczi zakùńczonégò przezérkù w PR pòd twòjim kòntã (le dlô célów PR; jeden prosti kòmentôrz, nie przezérk)]' \
    '(--post)--no-post[Nie pùblikùjë nalôzków w PR (domëslno)]' \
    '(-h --help)'{-h,--help}'[Pòkôżë pòmòc dlô kòmandë]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Pòwtórno zrëszë kòżdą dzejającą sesjã w tle]' \
    '(-h --help)'{-h,--help}'[Pòkôżë pòmòc dlô kòmandë]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Òdrzëni téż niewësłóné kòmitë ë niezakòmitowóné zmianë worktree (pòdôj commit@worktree-id, jaczi zgłosył wczasniészi claude rm)]:commit@worktree-id:' \
    '--force-remove-worktree[Rëmôj katalog worktree, nawetka jeżlë hook WorktreeRemove abò git nie mògł gò ùsënąc (pòdôj worktree-id, jaczi zgłosył wczasniészi claude rm)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Pòkôżë pòmòc dlô kòmandë]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Pòkôżë, co bë bëło zaimpòrtowóné, bez zapisywaniô czegòkòlwiek]' \
    '--yes[Przeskòczë interaktiwny wëbiérnik (na pòwierzchniach bez ekranu pòdôj --yes=<digest> z pòdzéraniô /import)]' \
    '(-h --help)'{-h,--help}'[Pòkôżë pòmòc dlô kòmandë]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
