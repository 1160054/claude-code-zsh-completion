#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:MCP серверларын көйләү һәм идарә итү'
    'plugin:Claude Code плагиннарын идарә итү'
    'agents:Фон агентларын идарә итү'
    'attach:Фон сессиясен бу терминалда ачу'
    'logs:Фон сессиясенең соңгы терминал чыгышын бастыру'
    'stop:Фон сессиясен туктату (аның сөйләшүе саклана)'
    'respawn:Фон сессиясен агымдагы Claude Code версиясендә эшләсен өчен яңадан башлау'
    'rm:Фон сессиясен, һәм куркынычсыз булганда аның worktree-ын бетерү'
    'auth:Аутентификацияне идарә итү'
    'auto-mode:Автомат режим классификаторы көйләвен карау яки торгызу'
    'gateway:Предприятие аутентификация/телеметрия шлюзын эшләтү'
    'import:Башка ИИ кодлау агентыннан көйләүне Claude Code-ка импортлау'
    'project:Claude Code проект халәтен идарә итү'
    'ultrareview:Болытта урнашкан күп агентлы код тикшерүен эшләтү һәм табылмаларны бастыру'
    'setup-token:Озак вакытлы аутентификация токенын көйләү (Claude язылуы кирәк)'
    'doctor:Claude Code автомат яңартучы өчен сәламәтлек тикшерүе'
    'update:Яңартуларны тикшерү һәм урнаштыру'
    'install:Claude Code туры төзелешен урнаштыру'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Категория фильтрлау белән җайлау режимын кабызу (мәсәлән, "api,hooks" яки "!statsig,!file")]:filter:'
    '--verbose[Көйләү файлыннан җентекле режим көйләвен кире кагу]'
    '(-p --print)'{-p,--print}'[Җавапны бастырып чыгару һәм чыгу (торбалар белән кулланыр өчен). Искәрмә: тик ышанычлы каталогларда кулланыгыз]'
    '--output-format[Чыгыш форматы (--print белән): "text" (килешенгән), "json" (бер нәтиҗә), яки "stream-json" (реаль вакыт агымы)]:format:(text json stream-json)'
    '--json-schema[Структуралы чыгышны тикшерү өчен JSON схемасы]:schema:'
    '--include-partial-messages[Килгәндә өлешчә хәбәр кисәкләрен кертү (--print һәм --output-format=stream-json белән)]'
    '--input-format[Кертү форматы (--print белән): "text" (килешенгән) яки "stream-json" (реаль вакыт агымы кертүе)]:format:(text stream-json)'
    '--mcp-debug[\[Искергән. Аның урынына --debug кулланыгыз\] MCP җайлау режимын кабызу (MCP сервер хаталарын күрсәтә)]'
    '--dangerously-skip-permissions[Барлык рөхсәт тикшерүләрен узып китү. Тик интернетка керә алмаган sandbox мохит өчен тәкъдим ителә]'
    '--allow-dangerously-skip-permissions[Килешенгән буларак кабызмыйча рөхсәт тикшерүләрен узып китү вариантын кабызу]'
    '--restricted[Чикләнгән режим: боерыклар яки код эшләтүче коралларны һәм WebFetch-ны бетерү, user/project/local көйләүләрен санга сукмау, һәм файл коралларын эш каталоглары белән чикләү]'
    '--max-budget-usd[API чакыруларына тотыла торган максималь доллар суммасы (тик --print)]:amount:'
    '--replay-user-messages[Раслау өчен stdin-нан stdout-ка кулланучы хәбәрләрен кабат җибәрү]'
    '--allowed-tools[Өтер яки буш урын белән аерылган рөхсәт ителгән корал исемнәре исемлеге (мәсәлән, "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Өтер яки буш урын белән аерылган рөхсәт ителгән корал исемнәре исемлеге (camelCase форматы)]:tools:'
    '--tools[Эчке җыелмадан булган кораллар исемлеген күрсәтү. Тик бастыру режимы]:tools:'
    '--disallowed-tools[Өтер яки буш урын белән аерылган тыелган корал исемнәре исемлеге (мәсәлән, "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Өтер яки буш урын белән аерылган тыелган корал исемнәре исемлеге (camelCase форматы)]:tools:'
    '--mcp-config[JSON файлыннан яки юлдан MCP серверларын йөкләү (буш урын белән аерылган)]:configs:'
    '--system-prompt[Сессия өчен система чакыруы]:prompt:'
    '--system-prompt-file[Система чакыруын файлдан уку]:file:_files'
    '--append-system-prompt[Килешенгән система чакыруына система чакыруын өстәү]:prompt:'
    '--append-system-prompt-file[Система чакыруын файлдан уку һәм килешенгән система чакыруына өстәү]:file:_files'
    '--system-prompt-snapshot[Система чакыруын һәр сөйләшүгә бер тапкыр язып алу һәм аны һәр запроста һәм дәвам иткәндә сүзгә-сүз кабат куллану (on, килешенгән) яки аны һәр запроста яңадан ясау (off)]:mode:(on off)'
    '--permission-mode[Сессия өчен рөхсәт режимы]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[--print белән рөхсәт сорауларына кем җавап бирә: "host" (SDK хосты яки --permission-prompt-tool) яки "none" (сорау чыгарачак һәрнәрсә кире кагыла)]:target:(host none)'
    '--permission-prompt-tool[Рөхсәт сораулары өчен кулланыла торган MCP коралы (тик --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Иң соңгы сөйләшүне дәвам итү]'
    '(-r --resume)'{-r,--resume}'[Сөйләшүне дәвам итү - сессия идентификаторын күрсәтегез яки интерактив сайлагыз]:sessionId:_claude_sessions'
    '--fork-session[Дәвам иткәндә оригиналь сессия идентификаторын кабат кулланмыйча яңа сессия идентификаторы ясау (--resume яки --continue белән)]'
    '--no-session-persistence[Сессия саклауны сүндерү - сессияләр сакланмаячак (тик --print)]'
    '--model[Агымдагы сессия өчен модель. Иң яңа модель өчен лакап исем күрсәтегез (мәсәлән, '\''sonnet'\'' яки '\''opus'\'')]:model:_claude_model_names'
    '--agent[Агымдагы сессия өчен агент. '\''agent'\'' көйләвен кире кага]:agent:_claude_agent_names'
    '--betas[API запросларына кертеләчәк бета башлыклары (тик API ачкычы кулланучылар)]:betas:'
    '--fallback-model[Килешенгән модель артык йөкләнгәндә күрсәтелгән модельгә автомат кире кайтуны кабызу (тик --print)]:model:_claude_model_names'
    '--settings[Өстәмә көйләүләр йөкләү өчен көйләүләр JSON файлы яки JSON юл юлы]:file-or-json:_files'
    '--add-dir[Корал керүенә рөхсәт бирү өчен өстәмә каталоглар]:directories:_directories'
    '--ide[Башлангычта төгәл бер дөрес IDE булса, автомат рәвештә IDE-га тоташу]'
    '--desktop[Терминал урынына Claude Desktop кушымтасында ачу (сессияне сайлау өчен --continue яки --resume <id> белән)]'
    '--strict-mcp-config[Тик --mcp-config-тан MCP серверларын кулланыгыз һәм бөтен башка MCP көйләүләрен санга сукмагыз]'
    '--session-id[Сөйләшү өчен махсус сессия идентификаторы (дөрес UUID булырга тиеш)]:uuid:'
    '--agents[Махсуслаштырылган агентларны билгеләүче JSON объекты]:json:'
    '--setting-sources[Йөкләү өчен өтер белән аерылган көйләү чыганаклары исемлеге (user, project, local)]:sources:'
    '--plugin-dir[Тик бу сессия өчен плагиннар йөкләү өчен каталог (кабатланырлык)]:paths:_directories'
    '--disable-slash-commands[Барлык slash боерыкларын сүндерү]'
    '(--bg --background)'{--bg,--background}'[Сессияне фон агенты буларак башлау һәм шунда ук кайту]'
    '(-w --worktree)'{-w,--worktree}'[Бу сессия өчен яңа git worktree ясау (теләсә исем күрсәтегез)]::name:'
    '--tmux=-[Worktree өчен tmux сессиясе ясау (--worktree кирәк). Мөмкин булганда iTerm2-ның үз панельләрен куллана; гадәти tmux өчен --tmux=classic]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Бу сессия өчен күрсәтелә торган исем билгеләү]:name:'
    '--effort[Агымдагы сессия өчен көч дәрәҗәсе]:level:(low medium high xhigh max)'
    '--autocompact[Автомат кысу тәрәзәсе зурлыгы (auto, яки 100k-1M токен)]:size:(auto)'
    '--debug-file[Җайлау журналларын махсус файл юлына язу (яшерен рәвештә җайлау режимын кабыза)]:path:_files'
    '--from-pr[Номер/URL буенча PR белән бәйле сессияне дәвам итү, яки интерактив сайлаучыны ачу]::value:'
    '--teleport[Teleport сессиясен дәвам итү, теләсә сессия идентификаторын күрсәтегез]::session:'
    '--cloud[Бирелгән тасвирлама белән болыт сессиясе ясау, яки сессия идентификаторы яки claude.ai/code URL буенча булган сессиягә тоташу]::description-or-session:'
    '--environment[Бирелгән үз-хостлы мохиттә (ccpool_...) эшли торган яңа болыт сессиясе ясау]:environment_id:'
    '--remote-control[Ерактан идарә кабызылган интерактив сессия башлау (теләсә исемле)]::name:'
    '--remote-control-session-name-prefix[Автомат ясалган Ерактан идарә сессия исемнәре өчен префикс]:prefix:'
    '--chrome[Chrome интеграциясендә Claude-ны кабызу]'
    '--no-chrome[Chrome интеграциясендә Claude-ны сүндерү]'
    '--plugin-url[Тик бу сессия өчен URL-дан плагин .zip алу (кабатланырлык)]:url:'
    '--file[Башлангычта йөкләнәчәк файл ресурслары (формат: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Чакыру тәкъдимнәрен кабызу (print/SDK режимында фаразланган чираттагы чакыруны чыгара)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Субагент текстын һәм уйлау блокларын хәбәр буларак җибәрү (--print һәм stream-json белән)]'
    '--include-hook-events[Чыгыш агымына барлык hook тормыш циклы вакыйгаларын кертү (stream-json белән)]'
    '--exclude-dynamic-system-prompt-sections[Prompt-cache кабат кулланылуын яхшырту өчен һәр-машина бүлекләрен беренче кулланучы хәбәренә күчерү]'
    '--brief[Агент-кулланучы аралашуы өчен SendUserMessage коралын кабызу]'
    '--safe-mode[Барлык җайлаштырулар сүндерелгән хәлдә башлау (ватык көйләүне төзәтү өчен файдалы)]'
    '--bare[Минималь режим: hook, LSP, плагин синхронлау, атрибуция, авто-хәтер һәм CLAUDE.md авто-табуны узып китү]'
    '--ax-screen-reader[Экран укучыга уңайлы чыгыш ясау (тигез текст, бизәкле кырыйлар яки анимацияләр юк)]'
    '(-v --version)'{-v,--version}'[Версия номерын чыгару]'
    '(-h --help)'{-h,--help}'[Боерык өчен ярдәм күрсәтү]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude commands' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Боерык өчен ярдәм күрсәтү]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "аргументлар юк"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Claude Code MCP серверын башлау'
    'add:Claude Code-ка MCP серверын өстәү'
    'remove:MCP серверын бетерү'
    'list:Көйләнгән MCP серверлары исемлеге'
    'get:MCP сервер детальләрен алу'
    'add-json:JSON юлы белән MCP серверын өстәү (stdio яки SSE)'
    'add-from-claude-desktop:Claude Desktop-тан MCP серверларын импортлау (тик Mac һәм WSL)'
    'reset-project-choices:Бу проектта барлык расланган/кире кагылган проект өлкәсендәге (.mcp.json) серверларны торгызу'
    'login:MCP сервер белән аутентификацияләнү (HTTP, SSE, яки claude.ai бәйләнеше)'
    'logout:MCP сервер өчен сакланган OAuth таныклыкларын чистарту'
    'help:Ярдәм күрсәтү'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp commands' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Җайлау режимын кабызу]' \
            '--verbose[Көйләү файлыннан җентекле режим көйләвен кире кагу]' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Көйләү өлкәсе (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Ташу төре (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Мохит үзгәрүчесен көйләү (мәсәлән, -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[WebSocket башын көйләү]:header:' \
            '--client-id[HTTP/SSE серверлары өчен OAuth клиент идентификаторы]:clientId:' \
            '--client-secret[OAuth клиент серен сорау (яки MCP_CLIENT_SECRET мохит үзгәрүчесен көйләгез)]' \
            '--callback-port[OAuth кире чакыруы өчен билгеләнгән порт (алдан теркәлгән юнәлтү URI-лары таләп иткән серверлар өчен)]:port:' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Көйләү өлкәсе (local, user, project) - күрсәтелмәсә булган өлкәдән бетерү]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Көйләү өлкәсе (local, user, project)]:scope:(local user project)' \
            '--client-secret[OAuth клиент серен сорау (яки MCP_CLIENT_SECRET мохит үзгәрүчесен көйләгез)]' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Көйләү өлкәсе (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]'
          ;;
        login)
          _arguments \
            '--no-browser[Браузер ачу урынына авторизация URL-ын бастыру (SSH/экрансыз сессияләр өчен)]' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Плагин яки базар манифестын раслау'
    'marketplace:Claude Code базарларын идарә итү'
    'list:Урнаштырылган плагиннар исемлеге'
    'details:Плагин өчен компонент исемлеген һәм фаразланган токен бәясен күрсәтү'
    'configure:Плагин параметрларын һәм аларның кайсылары көйләнмәгәнен күрсәтү, яки кыйммәтләрне stdin-нан саклау'
    'install:Булган базарлардан плагин урнаштыру'
    'i:Булган базарлардан плагин урнаштыру (install өчен кыска)'
    'init:Яңа плагин каркасын ясау (чираттагы сессиядә автомат йөкләнә)'
    'new:Яңа плагин каркасын ясау (init өчен лакап исем)'
    'uninstall:Урнаштырылган плагинны бетерү'
    'remove:Урнаштырылган плагинны бетерү (uninstall өчен лакап исем)'
    'enable:Сүндерелгән плагинны кабызу'
    'disable:Кабызылган плагинны сүндерү'
    'update:Плагинны иң яңа версиягә яңарту'
    'eval:Плагинга каршы eval очракларын эшләтү һәм бәяләнгән нәтиҗәләрне хәбәр итү'
    'prune:Кирәкми торган автомат урнаштырылган бәйлелекләрне бетерү'
    'autoremove:Инде кирәкми торган автомат урнаштырылган бәйлелекләрне бетерү (prune өчен лакап исем)'
    'tag:Плагин чыгарылышы өчен {name}--v{version} git тамгасы ясау'
    'test:Мод тестларын эшләтү'
    'help:Ярдәм күрсәтү'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin commands' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Кисәтүләрне хата дип санау (чыгу коды 1)]' \
            '--json[Раслау хисабын JSON буларак чыгару (шул ук чыгу кодлары)]' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Урнаштыру өлкәсе]:scope:(user project local)' \
            '*--config[Плагин манифестында игълан ителгән userConfig параметрын көйләү (кабатланырлык)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Күрсәтелгән, базар игълан иткән боерыкны раслау соравыннан башка кабул итү]' \
            '--json[Кеше өчен хәбәр урынына машина укый ала торган бер нәтиҗә юлын бастыру]' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Урнаштыру өлкәсе]:scope:(user project local)' \
            '--keep-data[Плагинның даими мәгълүмат каталогын саклау]' \
            '--prune[Инде кирәкми торган автомат урнаштырылган бәйлелекләрне дә бетерү]' \
            '(-y --yes)'{-y,--yes}'[--prune раслау соравын узып китү]' \
            '--json[Кеше өчен хәбәр урынына машина укый ала торган бер нәтиҗә юлын бастыру (--prune белән түгел)]' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Урнаштыру өлкәсе]:scope:(user project local)' \
            '--json[Кеше өчен хәбәр урынына машина укый ала торган бер нәтиҗә юлын бастыру]' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Барлык кабызылган плагиннарны сүндерү]' \
            '(-s --scope)'{-s,--scope}'[Урнаштыру өлкәсе]:scope:(user project local)' \
            '--json[Кеше өчен хәбәр урынына машина укый ала торган бер нәтиҗә юлын бастыру]' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Урнаштыру өлкәсе]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Күрсәтелгән, базар игълан иткән боерыкны раслау соравыннан башка кабул итү]' \
            '--json[Кеше өчен хәбәр урынына машина укый ала торган бер нәтиҗә юлын бастыру]' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[JSON буларак чыгару]' \
            '--available[Базарлардагы булган плагиннарны кертү (--json кирәк)]' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Күрсәтелгән өлкәдә чистарту]:scope:(user project local)' \
            '--dry-run[Бетермичә, нәрсә бетереләчәген исемлеккә чыгару]' \
            '(-y --yes)'{-y,--yes}'[Раслау соравын узып китү]' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]'
          ;;
        configure)
          _arguments \
            '--json[JSON буларак чыгару]' \
            '--values-stdin[Параметр кыйммәтләрен stdin-нан бер юллы текст кыйммәтләреннән торган JSON объекты буларак уку; күрсәтелмәгән параметрлар үз кыйммәтләрен саклый]' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Манифест тасвирламасы]:text:' \
            '--author[Автор исеме (килешенгән: git config user.name)]:name:' \
            '--author-email[Автор email-ы (килешенгән: git config user.email)]:email:' \
            '--with[Шулай ук каркасы ясалачак компонентлар]:components:' \
            '(-f --force)'{-f,--force}'[Максаттагы булган .claude-plugin/ өстеннән язу]' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Очракларны исем glob үрнәге буенча фильтрлау]:glob:' \
            '*--tag[Очракларны тамга буенча фильтрлау (кабатланырлык)]:tag:' \
            '--runs[Һәр очрак өчен эшләтүләр санын кире кагу (килешенгән: case.runs, юк исә 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Бер үк вакытта n-га кадәр агент эшләтүен башкару (1-8; килешенгән 1)]:n:' \
            '--model[Барлык очраклар өчен модельне кире кагу]:model:_claude_model_names' \
            '--judge-model[LLM бәяләүче моделен кире кагу (килешенгән: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Каты чыгым чиге; җитсә, туктату һәм өлешчә нәтиҗәләрне хәбәр итү (чыгу коды 2)]:usd:' \
            '--output-dir[aggregate-result.json өчен каталог]:dir:_directories' \
            '--eval-dir[Eval очракларын тоткан каталог исеме (плагин астында)]:dir:' \
            '--json[Тулы эшләтү нәтиҗәсен JSON буларак stdout-ка бастыру, яки аны бу .json файлына язу]::path:_files' \
            '--threshold[Берәр очрак бәясе бу чиктән түбән булса, 1 чыгу коды белән чыгу (килешенгән: 1.0)]:threshold:' \
            '*--allow-tools[Чикләнгән кораллар өчен оператор рөхсәте (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Һәр очракның scaffold_script-ын эшләтү (автор биргән bash-ны сезнең исемнән эшләтә; килешенгән буенча сүнек)]' \
            '(--scaffold)--no-scaffold[scaffold_script-ны ачыктан-ачык узып китү]' \
            '--trust-plugin[Бу плагинга һәм аның eval җыелмасына ышануыгызны раслау, беренче эшләтүдәге ышаныч соравын узып китеп (CI өчен)]' \
            '--ablation[Плагинсыз чагыштыру төркемен (baseline) эшләтү һәм бәяләр аермасын хәбәр итү]:mode:(none with-without)' \
            '--mocks[MCP серверлары өчен ялган алмаштыргычлар (mock), <eval dir>/mocks/ эченнән]:mode:(record off)' \
            '--allow-real-servers[--mocks record белән: mock-ы булмаган чын MCP сервер процессларын да башлау]' \
            '--keep-temp[Җайлау өчен каркас каталогларын саклау]' \
            '--verbose[Һәр хәбәр өчен эз вакыйгаларын җайлау журналына язу]' \
            '--report[Мөстәкыйль HTML хисабын нәтиҗәләр каталогы урынына бу юлга язу]:path:_files' \
            '(--no-publish)--publish-report[Хисапны claude.ai-да бастырып чыгаруны да таләп итү]' \
            '(--publish-report)--no-publish[HTML хисабын тик җирле саклау; аны claude.ai-да бастырып чыгаруны узып китү]' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Тамганы ясаганнан соң --remote-ка җибәрү]' \
            '--dry-run[Ясамыйча, нәрсә тамгаланачагын бастыру]' \
            '(-f --force)'{-f,--force}'[Эш агачы чиста булмауны һәм тамга инде булуны тикшерүләрне узып китү]' \
            '(-m --message)'{-m,--message}'[Тамга аңлатма хәбәре (версия өчен %s кулланыгыз)]:msg:' \
            '--remote[--push белән җибәрү өчен remote]:name:' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:URL, юл яки GitHub репозиториясеннән базар өстәү'
    'list:Көйләнгән базарлар исемлеге'
    'remove:Көйләнгән базарны бетерү'
    'rm:Көйләнгән базарны бетерү (remove өчен лакап исем)'
    'update:Чыганактан базарны яңарту - исеме күрсәтелмәсә барысын яңарту'
    'help:Ярдәм күрсәтү'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace commands' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[git sparse-checkout ярдәмендә checkout-ны билгеле каталоглар белән чикләү (монорепозиторияләр өчен)]:paths:' \
            '--scope[Базарны кайда игълан итәргә]:scope:(user project local)' \
            '--claudeai[claude.ai сезнең өчен урнаштырган шушы исемле базарны өстәү]' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[JSON буларак чыгару]' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Базар игъланын билгеле көйләү өлкәсеннән бетерү (һәр өлкәдән бетерү өчен күрсәтмәгез)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Инде урнаштырылган булса да мәҗбүри урнаштыру]' \
    '(-h --help)'{-h,--help}'[Ярдәм күрсәтү]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Җибәрелгән сессияләрдә корал керүенә рөхсәт бирү өчен өстәмә каталог]:directory:_directories' \
    '--agent[Агент күренешеннән җибәрелгән сессияләр өчен килешенгән агент]:agent:_claude_agent_names' \
    '--all[--json белән: тәмамланган фон сессияләрен дә кертү]' \
    '--allow-dangerously-skip-permissions[Җибәрелгән сессияләргә рөхсәт-узу режимын мөмкин итү]' \
    '--cwd[Тик юл астында башланган фон сессияләрен күрсәтү]:path:_directories' \
    '--dangerously-skip-permissions[--permission-mode bypassPermissions өчен лакап исем]' \
    '--effort[Җибәрелгән сессияләр өчен килешенгән көч дәрәҗәсе]:level:(low medium high xhigh max)' \
    '--json[Актив сессияләрне JSON массивы буларак бастыру һәм чыгу]' \
    '*--mcp-config[Җибәрелгән сессияләргә куллану өчен MCP сервер көйләүе]:config:' \
    '--model[Агент күренешеннән җибәрелгән сессияләр өчен килешенгән модель]:model:_claude_model_names' \
    '--permission-mode[Җибәрелгән сессияләр өчен килешенгән рөхсәт режимы]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Агент күренеше һәм җибәрелгән сессияләр өчен каталогтан плагиннар йөкләү]:path:_directories' \
    '--setting-sources[Йөкләү өчен өтер белән аерылган көйләү чыганаклары исемлеге (user, project, local)]:sources:' \
    '--settings[Куллану өчен көйләүләр файлы яки JSON юлы]:file-or-json:_files' \
    '--strict-mcp-config[Җибәрелгән сессияләрдә тик --mcp-config-тан MCP серверларын куллану]' \
    '--restricted[Җибәрелгән сессияләрне чикләнгән режимда башлау]' \
    '(-h --help)'{-h,--help}'[Боерык өчен ярдәм күрсәтү]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Anthropic хисабыгызга керү'
    'logout:Anthropic хисабыгыздан чыгу'
    'status:Аутентификация халәтен күрсәтү'
    'help:Ярдәм күрсәтү'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Боерык өчен ярдәм күрсәтү]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth commands' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Керү битендә email адресын алдан тутыру]:email:' \
            '--sso[SSO керү агымын мәҗбүри куллану]' \
            '(--claudeai)--console[Claude язылуы урынына Anthropic Console (API куллану буенча түләү) куллану]' \
            '(--console)--claudeai[Claude язылуын куллану (килешенгән)]' \
            '(-h --help)'{-h,--help}'[Боерык өчен ярдәм күрсәтү]'
          ;;
        status)
          _arguments \
            '(--text)--json[JSON буларак чыгару (килешенгән)]' \
            '(--json)--text[Кеше укый ала торган текст буларак чыгару]' \
            '(-h --help)'{-h,--help}'[Боерык өчен ярдәм күрсәтү]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Боерык өчен ярдәм күрсәтү]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Гамәлдәге автомат режим көйләвен JSON буларак бастыру'
    'critique:Махсус автомат режим кагыйдәләрегезгә ИИ фикерен алу'
    'defaults:Килешенгән автомат режим кагыйдәләрен JSON буларак бастыру'
    'reset:Автомат режим көйләвен җибәрелгән килешенгәннәргә торгызу'
    'help:Ярдәм күрсәтү'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Боерык өчен ярдәм күрсәтү]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode commands' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Кулланыла торган модельне кире кагу]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Боерык өчен ярдәм күрсәтү]'
          ;;
        defaults)
          _arguments \
            '--label[Тик тамгасы шушы префикс белән башланган кагыйдәләрне күрсәтү (регистрга карамастан)]:prefix:' \
            '(-h --help)'{-h,--help}'[Боерык өчен ярдәм күрсәтү]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Раслау соравын узып китү]' \
            '(-h --help)'{-h,--help}'[Боерык өчен ярдәм күрсәтү]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Боерык өчен ярдәм күрсәтү]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Шлюз YAML көйләвенә юл]:path:_files' \
    '(-h --help)'{-h,--help}'[Боерык өчен ярдәм күрсәтү]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Проект өчен барлык Claude Code халәтен бетерү (транскриптлар, бурычлар, файл тарихы, көйләү язмасы)'
    'help:Ярдәм күрсәтү'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Боерык өчен ярдәм күрсәтү]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project commands' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Берни дә бетермичә, нәрсә бетереләчәген исемлеккә чыгару]' \
            '(-y --yes)'{-y,--yes}'[Раслау соравын узып китү]' \
            '(-i --interactive)'{-i,--interactive}'[Бетерү алдыннан һәр элемент өчен сорау]' \
            '(1)--all[Һәр проект өчен халәтне бетерү (юл белән бергә кулланылмый)]' \
            '(-h --help)'{-h,--help}'[Боерык өчен ярдәм күрсәтү]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Форматланган табылмалар урынына чи bugs.json йөген бастыру]' \
    '--timeout[Тикшерү тәмамлануын көтү өчен максималь минутлар (килешенгән: 45)]:minutes:' \
    '(--no-post)--post[Тәмамланган тикшерү табылмаларын PR-га сезнең исемнән урнаштыру (тик PR максатлары; тикшерү түгел, бер гади аңлатма)]' \
    '(--post)--no-post[Табылмаларны PR-га урнаштырмау (килешенгән)]' \
    '(-h --help)'{-h,--help}'[Боерык өчен ярдәм күрсәтү]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Эшләп торган һәр фон сессиясен яңадан башлау]' \
    '(-h --help)'{-h,--help}'[Боерык өчен ярдәм күрсәтү]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Worktree-ның җибәрелмәгән коммитларын һәм коммитланмаган үзгәрешләрен дә ташлау (алдагы claude rm хәбәр иткән commit@worktree-id-ны бирегез)]:commit@worktree-id:' \
    '--force-remove-worktree[WorktreeRemove hook яки git бетерә алмаса да, worktree каталогын бетерү (алдагы claude rm хәбәр иткән worktree-id-ны бирегез)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Боерык өчен ярдәм күрсәтү]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Берни дә язмыйча, нәрсә импортланачагын күрсәтү]' \
    '--yes[Интерактив сайлаучыны узып китү (экрансыз мохитләрдә /import алдан карау эченнән --yes=<digest> бирегез)]' \
    '(-h --help)'{-h,--help}'[Боерык өчен ярдәм күрсәтү]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
