_claude_self_hosted_runner() {
  _arguments \
    '--api-url[Osnovni URL API-ja (podrazumevano: https://api.anthropic.com)]:url:' \
    '--environment-secret-file[Putanja do datoteke sa tajnom okruženja]:path:_files' \
    '--lock-to-account[Zaključaj runner na jedan nalog pri registraciji]:id:' \
    '--client-label[Oznaka za opservabilnost poslata pri registraciji (podrazumevano: hostname)]:label:' \
    '(--proxy-authorization-file --agent-proxy-url)--proxy-authorization-command[Naredba čiji je stdout Proxy-Authorization zaglavlje za izlazne proksije]:shell command:' \
    '(--proxy-authorization-command --agent-proxy-url)--proxy-authorization-file[Datoteka sa Proxy-Authorization zaglavljem za izlazne proksije]:path:_files' \
    '(--proxy-authorization-command --proxy-authorization-file)--agent-proxy-url[Usmeri svaku sesiju kroz agentski proksi na ovom URL-u (samo https)]:url:' \
    '--capacity[Maksimalan broj istovremenih sesija (podrazumevano: 1)]:n:' \
    '--base-dir[Osnovni direktorijum za checkout repozitorijuma (podrazumevano: /workspace)]:path:_directories' \
    '--exec-path[Binarna datoteka koja se pokreće za podređene sesije (podrazumevano: ova binarna datoteka)]:path:_files' \
    '--hooks-dir[Direktorijum skripti hookova životnog ciklusa (checkout, command, post-session)]:path:_directories' \
    '--session-stop-grace-sec[Koliko dugo čekati na čist izlaz nakon završetka sesije (podrazumevano: 5)]:n:' \
    '--post-session-hook-timeout-sec[SIGTERM vremenski budžet za post-session hook (podrazumevano: 60)]:n:' \
    '--checkout-hook-timeout-min[Budžet stvarnog vremena za svako pokretanje checkout hooka (podrazumevano: 30; 0 onemogućava)]:n:' \
    '--drain-wait-sec[Na SIGTERM/SIGINT čekaj do N sekundi na rad u toku (podrazumevano: 0)]:n:' \
    '--drain-marker-file[Datoteka-oznaka kojom host najavljuje kontrolisano pražnjenje]:path:_files' \
    '*--git-ssh-rewrite[Prepiši izvorne URL-ove https://<host>/... u git@<host>:... (može se ponavljati)]:host:' \
    '*--git-host-rewrite[Prepiši izvorne URL-ove https://<f>/... u https://<t>/... (može se ponavljati)]:from=to:' \
    '--use-anthropic-git-proxy[Koristi git kojim upravlja Anthropic. UPOZORENJE: briše i zamenjuje git konfiguraciju na nivou HOME, koristite samo pod namenskim nalogom]' \
    '--configure-git[Postavi globalni git identitet i omogući potpisivanje komitova preko Anthropic usluge za potpisivanje. Upisuje ~/.gitconfig]' \
    '--push-outcome-on-release[Pošalji praćene grane sa rezultatima kada runner završi nedovršenu sesiju]' \
    '--trust-workspace[Unapred postavi trajno poverenje za putanje repozitorijuma svake sesije (podrazumevano: true)]::bool:(true false)' \
    '--remove-session-state[Ukloni stanje pojedinačne sesije kada se sesija završi (podrazumevano: false)]::bool:(true false)' \
    '--diff-finds-nested-repository[Prikaži repozitorijum kloniran u podfasciklu u oknu Changes; zahteva --capacity 1 (podrazumevano: false)]::bool:(true false)' \
    '--confine-repo-settings[Režim zaštite za ograničavanje podešavanja komitovanih u repozitorijum (podrazumevano: warn)]:mode:(warn enforce off)' \
    '--server-auto-mode-lists[Koje liste klasifikatora automatskog režima sa servera sesija sme da primi (podrazumevano: no-allow)]:mode:(all no-allow none)' \
    '--host-config-snapshot[Gde se čuva početni snimak konfiguracije hosta (podrazumevano: disk)]:mode:(disk memory)' \
    '--health-port[Port za /healthz HTTP slušalac (podrazumevano: 8080; 0 onemogućava)]:port:' \
    '--log-level[Nivo dnevnika (podrazumevano: info)]:level:(info debug)' \
    '--log-file[Kopiraj i dnevnike runnera u datoteku u režimu dodavanja]:path:_files' \
    '--exit-if-unused-min[Izađi iz runnera ako mu N minuta nije dodeljen nikakav rad]:n:' \
    '--drain-grace-sec[Sekunde nastavka proveravanja za rad nakon završetka aktivnih sesija (podrazumevano: 0)]:n:' \
    '--retire-at[Penzioniši runner u ovo apsolutno Unix vreme, u sekundama]:epoch-seconds:' \
    '--defer-shutdown-max-min[Na prvi SIGTERM/SIGINT prestani da primaš rad i završi gašenje M minuta kasnije (podrazumevano: 0)]:m:' \
    '--release-idle-session-min[Oslobodi mesto sesije nakon N minuta bez korisničkog unosa]:n:' \
    '--startup-timeout-min[Oslobodi mesto sesije ako podređeni proces nije završio pokretanje nakon N minuta (podrazumevano: 15; 0 onemogućava)]:n:' \
    '--kill-session-after-min[Ograniči životni vek podređene sesije u stvarnom vremenu na N minuta]:n:' \
    '--debug-token-dir[SAMO ZA OTKLANJANJE GREŠAKA: upisuje žive tokene na disk. Ne koristiti u produkciji]:path:_directories' \
    '(-h --help)'{-h,--help}'[Prikaži ovu poruku pomoći]'
}

_claude_remote_control() {
  _arguments \
    '--name[Ime sesije (prikazuje se u claude.ai/code)]:name:' \
    '--remote-control-session-name-prefix[Prefiks za automatski generisana imena sesija (podrazumevano: hostname)]:prefix:' \
    '(-c --continue --session-id)'{-c,--continue}'[Ponovo se poveži na sesiju poslednju zabeleženu za ovaj direktorijum ili jedno od njegovih git radnih stabala]' \
    '(-c --continue --session-id)--session-id[Ponovo se poveži na određenu sesiju po ID-ju]:id:' \
    '--permission-mode[Režim dozvola za pokrenute sesije]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)' \
    '(--no-chrome)--chrome[Omogući Claude in Chrome za pokrenute sesije]' \
    '(--chrome)--no-chrome[Onemogući Claude in Chrome za pokrenute sesije]' \
    '(-d --debug)'{-d,--debug}'[Omogući režim za otklanjanje grešaka uz opcionalno filtriranje kategorija]::filter:' \
    '--debug-file[Zapiši dnevnike otklanjanja grešaka u datoteku]:path:_files' \
    '(-v --verbose)'{-v,--verbose}'[Omogući detaljan izlaz]' \
    '--spawn[Režim pokretanja (podrazumevano: same-dir)]:mode:(same-dir worktree session)' \
    '--capacity[Maksimalan broj istovremenih sesija u worktree ili same-dir režimu (podrazumevano: 32)]:n:' \
    '(--no-create-session-in-dir)--create-session-in-dir[Unapred napravi sesiju u trenutnom direktorijumu (podrazumevano)]' \
    '(--create-session-in-dir)--no-create-session-in-dir[Ne pravi sesiju unapred u trenutnom direktorijumu]' \
    '(-h --help)'{-h,--help}'[Prikaži ovu pomoć]'
}

_claude_daemon() {
  local -a daemon_commands common_options
  daemon_commands=(
    'run:Pokreni nadzornika u prvom planu'
    'status:Prikaži pid, verziju i vreme rada demona'
    'logs:Prati dnevnik demona (Ctrl-C za zaustavljanje)'
    'uninstall:Ukloni pozadinsku uslugu (launchctl/systemd)'
    'stop:Ugasi nadzornika i prekini pozadinske sesije'
  )
  common_options=(
    '--json-path[Konfiguraciona datoteka (podrazumevano: ~/.claude/daemon.json)]:path:_files'
    '--log-file[Datoteka dnevnika (podrazumevano: ~/.claude/daemon.log)]:path:_files'
    '(-h --help)'{-h,--help}'[Prikaži ovu pomoć]'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    $common_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'daemon naredbe' daemon_commands
      ;;
    args)
      case $words[1] in
        run)
          _arguments \
            $common_options \
            '::json-path:_files'
          ;;
        stop)
          _arguments \
            $common_options \
            '--any[Zaustavi i privremeni demon (koji nije usluga)]' \
            '--keep-workers[Ostavi odvojene sesije da rade]'
          ;;
        status|logs|uninstall)
          _arguments \
            $common_options
          ;;
      esac
      ;;
  esac
}

_claude_import() {
  _arguments \
    '--dry-run[Prikaži šta bi bilo uvezeno bez upisivanja ičega]' \
    '--yes[Preskoči interaktivni birač (na headless okruženjima prosledi --yes=<digest> iz /import pregleda)]' \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
    '::source:(codex gemini cursor)'
}

# compinit autoloads this file, and that first call only defines the functions
# above: complete right away so the first TAB already works. Sourced directly,
# there is nothing to complete yet, only the registration.
if [[ $funcstack[1] == _claude ]]; then
  _claude "$@"
else
  (( $+_comps[claude] )) || compdef _claude claude
fi
