#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Налаштувати та керувати MCP серверами'
    'plugin:Керувати плагінами Claude Code'
    'agents:Керувати фоновими агентами'
    'attach:Відкрити фонову сесію в цьому терміналі'
    'logs:Вивести останній вивід термінала фонової сесії'
    'stop:Зупинити фонову сесію (її розмова зберігається)'
    'respawn:Перезапустити фонову сесію, щоб вона працювала на поточній версії Claude Code'
    'rm:Видалити фонову сесію, а також її worktree, якщо це безпечно'
    'auth:Керувати автентифікацією'
    'auto-mode:Переглянути або скинути конфігурацію класифікатора авторежиму'
    'gateway:Запустити корпоративний шлюз автентифікації/телеметрії'
    'import:Імпортувати конфігурацію з іншого ШІ-агента для програмування в Claude Code'
    'project:Керувати станом проекту Claude Code'
    'ultrareview:Запустити хмарний багатоагентний огляд коду та вивести результати'
    'setup-token:Налаштувати токен довгострокової автентифікації (потрібна підписка Claude)'
    'doctor:Перевірка здоров'\''я системи автооновлення Claude Code'
    'update:Перевірити та встановити оновлення'
    'install:Встановити нативну збірку Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Увімкнути режим налагодження з опціональним фільтруванням категорій (наприклад, "api,hooks" або "!statsig,!file")]:filter:'
    '--verbose[Перевизначити налаштування режиму детального виводу з конфігураційного файлу]'
    '(-p --print)'{-p,--print}'[Вивести відповідь та вийти (для використання з pipe). Примітка: використовуйте лише в довірених директоріях]'
    '--output-format[Формат виводу (з --print): "text" (за замовчуванням), "json" (один результат), або "stream-json" (потокове передавання в реальному часі)]:format:(text json stream-json)'
    '--json-schema[JSON схема для валідації структурованого виводу]:schema:'
    '--include-partial-messages[Включити часткові фрагменти повідомлень при їх надходженні (з --print та --output-format=stream-json)]'
    '--input-format[Формат вводу (з --print): "text" (за замовчуванням) або "stream-json" (потокове введення в реальному часі)]:format:(text stream-json)'
    '--mcp-debug[\[Застаріле. Використовуйте --debug замість цього\] Увімкнути режим налагодження MCP (показує помилки MCP сервера)]'
    '--dangerously-skip-permissions[Обійти всі перевірки дозволів. Рекомендується лише для пісочниць без доступу до інтернету]'
    '--allow-dangerously-skip-permissions[Увімкнути опцію обходу перевірок дозволів без увімкнення за замовчуванням]'
    '--restricted[Обмежений режим: прибрати інструменти, що виконують команди чи код, та WebFetch, ігнорувати налаштування user/project/local і обмежити файлові інструменти робочими директоріями]'
    '--max-budget-usd[Максимальна сума в доларах для витрат на API виклики (лише --print)]:amount:'
    '--replay-user-messages[Повторно надіслати повідомлення користувача з stdin на stdout для підтвердження]'
    '--allowed-tools[Список дозволених імен інструментів через кому або пробіл (наприклад, "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Список дозволених імен інструментів через кому або пробіл (формат camelCase)]:tools:'
    '--tools[Вказати список доступних інструментів з вбудованого набору. Лише в режимі print]:tools:'
    '--disallowed-tools[Список заборонених імен інструментів через кому або пробіл (наприклад, "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Список заборонених імен інструментів через кому або пробіл (формат camelCase)]:tools:'
    '--mcp-config[Завантажити MCP сервери з JSON файлу або рядка (розділені пробілами)]:configs:'
    '--system-prompt[Системний промпт для використання в сесії]:prompt:'
    '--system-prompt-file[Прочитати системний промпт з файлу]:file:_files'
    '--append-system-prompt[Додати системний промпт до стандартного системного промпту]:prompt:'
    '--append-system-prompt-file[Прочитати системний промпт з файлу та додати його до стандартного системного промпту]:file:_files'
    '--system-prompt-snapshot[Записати системний промпт один раз за розмову та дослівно використовувати його повторно в кожному запиті й при відновленні (on, за замовчуванням) або формувати його заново для кожного запиту (off)]:mode:(on off)'
    '--permission-mode[Режим дозволів для використання в сесії]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Хто відповідає на запити дозволів з --print: "host" (хост SDK або --permission-prompt-tool) або "none" (усе, що потребувало б запиту, відхиляється)]:target:(host none)'
    '--permission-prompt-tool[MCP інструмент для запитів дозволів (лише --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Продовжити останню розмову]'
    '(-r --resume)'{-r,--resume}'[Відновити розмову - вкажіть ідентифікатор сесії або виберіть інтерактивно]:sessionId:_claude_sessions'
    '--fork-session[Створити новий ідентифікатор сесії замість повторного використання оригінального при відновленні (з --resume або --continue)]'
    '--no-session-persistence[Вимкнути збереження сесій - сесії не будуть збережені (лише --print)]'
    '--model[Модель для поточної сесії. Вкажіть псевдонім для останньої моделі (наприклад, '\''sonnet'\'' або '\''opus'\'')]:model:_claude_model_names'
    '--agent[Агент для поточної сесії. Перевизначає налаштування '\''agent'\'']:agent:_claude_agent_names'
    '--betas[Бета-заголовки для включення в API запити (лише для користувачів з API ключем)]:betas:'
    '--fallback-model[Увімкнути автоматичний перехід на вказану модель, коли модель за замовчуванням перевантажена (лише --print)]:model:_claude_model_names'
    '--settings[Шлях до JSON файлу налаштувань або JSON рядок для завантаження додаткових налаштувань]:file-or-json:_files'
    '--add-dir[Додаткові директорії для надання доступу інструментам]:directories:_directories'
    '--ide[Автоматично підключитися до IDE при запуску, якщо доступна рівно одна валідна IDE]'
    '--desktop[Відкрити в застосунку Claude Desktop замість термінала (з --continue або --resume <id>, щоб вибрати сесію)]'
    '--strict-mcp-config[Використовувати лише MCP сервери з --mcp-config та ігнорувати всі інші налаштування MCP]'
    '--session-id[Конкретний ідентифікатор сесії для використання в розмові (має бути валідний UUID)]:uuid:'
    '--agents[JSON об'\''єкт, що визначає користувацькі агенти]:json:'
    '--setting-sources[Список джерел налаштувань через кому для завантаження (user, project, local)]:sources:'
    '--plugin-dir[Директорія для завантаження плагінів лише для цієї сесії (можна повторювати)]:paths:_directories'
    '--disable-slash-commands[Вимкнути всі slash-команди]'
    '(--bg --background)'{--bg,--background}'[Запустити сесію як фоновий агент і одразу повернутися]'
    '(-w --worktree)'{-w,--worktree}'[Створити новий git worktree для цієї сесії (за бажанням вкажіть назву)]::name:'
    '--tmux=-[Створити tmux сесію для worktree (потребує --worktree). Використовує нативні панелі iTerm2, якщо доступні; --tmux=classic для традиційного tmux]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Встановити відображуване ім'\''я для цієї сесії]:name:'
    '--effort[Рівень зусиль для поточної сесії]:level:(low medium high xhigh max)'
    '--autocompact[Розмір вікна автоматичного стиснення (auto або 100k-1M токенів)]:size:(auto)'
    '--debug-file[Записувати логи налагодження у вказаний файл (неявно вмикає режим налагодження)]:path:_files'
    '--from-pr[Відновити сесію, пов'\''язану з PR за номером/URL, або відкрити інтерактивний вибір]::value:'
    '--teleport[Відновити teleport-сесію, за бажанням вкажіть ідентифікатор сесії]::session:'
    '--cloud[Створити хмарну сесію з вказаним описом або підключитися до існуючої за ідентифікатором сесії чи URL claude.ai/code]::description-or-session:'
    '--environment[Створити нову хмарну сесію, що працює у вказаному власному (self-hosted) середовищі (ccpool_...)]:environment_id:'
    '--remote-control[Запустити інтерактивну сесію з увімкненим Remote Control (за бажанням з назвою)]::name:'
    '--remote-control-session-name-prefix[Префікс для автоматично згенерованих імен сесій Remote Control]:prefix:'
    '--chrome[Увімкнути інтеграцію Claude в Chrome]'
    '--no-chrome[Вимкнути інтеграцію Claude в Chrome]'
    '--plugin-url[Завантажити .zip плагіна з URL лише для цієї сесії (можна повторювати)]:url:'
    '--file[Файлові ресурси для завантаження при запуску (формат: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Увімкнути пропозиції промптів (видає передбачений наступний промпт у режимі print/SDK)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Пересилати текст субагента та блоки роздумів як повідомлення (з --print та stream-json)]'
    '--include-hook-events[Включити всі події життєвого циклу хуків у вихідний потік (з stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Перемістити специфічні для машини секції у перше повідомлення користувача для покращення повторного використання кешу промптів]'
    '--brief[Увімкнути інструмент SendUserMessage для комунікації агента з користувачем]'
    '--safe-mode[Запустити з усіма вимкненими налаштуваннями (корисно для усунення несправностей зламаної конфігурації)]'
    '--bare[Мінімальний режим: пропустити хуки, LSP, синхронізацію плагінів, атрибуцію, автопам'\''ять та автовиявлення CLAUDE.md]'
    '--ax-screen-reader[Виводити дружній до програм читання з екрана вивід (плоский текст, без декоративних рамок чи анімацій)]'
    '(-v --version)'{-v,--version}'[Вивести номер версії]'
    '(-h --help)'{-h,--help}'[Показати довідку для команди]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'команди claude' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Показати довідку для команди]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "без аргументів"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Запустити MCP сервер Claude Code'
    'add:Додати MCP сервер до Claude Code'
    'remove:Видалити MCP сервер'
    'list:Показати список налаштованих MCP серверів'
    'get:Отримати деталі MCP сервера'
    'add-json:Додати MCP сервер (stdio або SSE) з JSON рядком'
    'add-from-claude-desktop:Імпортувати MCP сервери з Claude Desktop (лише Mac та WSL)'
    'reset-project-choices:Скинути всі схвалені/відхилені сервери з областю дії проекту (.mcp.json) в цьому проекті'
    'login:Автентифікуватися на MCP сервері (HTTP, SSE або конектор claude.ai)'
    'logout:Очистити збережені облікові дані OAuth для MCP сервера'
    'help:Показати довідку'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Показати довідку]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'команди mcp' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Увімкнути режим налагодження]' \
            '--verbose[Перевизначити налаштування режиму детального виводу з конфігураційного файлу]' \
            '(-h --help)'{-h,--help}'[Показати довідку]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Область дії конфігурації (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Тип транспорту (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Встановити змінну середовища (наприклад, -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Встановити заголовок WebSocket]:header:' \
            '--client-id[Ідентифікатор клієнта OAuth для HTTP/SSE серверів]:clientId:' \
            '--client-secret[Запитати секрет клієнта OAuth (або встановіть змінну середовища MCP_CLIENT_SECRET)]' \
            '--callback-port[Фіксований порт для зворотного виклику OAuth (для серверів, що вимагають попередньо зареєстрованих URI перенаправлення)]:port:' \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Область дії конфігурації (local, user, project) - видалити з існуючої області, якщо не вказано]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Показати довідку]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Область дії конфігурації (local, user, project)]:scope:(local user project)' \
            '--client-secret[Запитати секрет клієнта OAuth (або встановіть змінну середовища MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Область дії конфігурації (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Показати довідку]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Показати довідку]'
          ;;
        login)
          _arguments \
            '--no-browser[Вивести URL авторизації замість відкриття браузера (для SSH/headless сесій)]' \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Валідувати плагін або маніфест маркетплейсу'
    'marketplace:Керувати маркетплейсами Claude Code'
    'list:Показати список встановлених плагінів'
    'details:Показати інвентар компонентів та прогнозовану вартість у токенах для плагіна'
    'configure:Показати опції плагіна та які з них не задані, або зберегти значення з stdin'
    'install:Встановити плагін з доступних маркетплейсів'
    'i:Встановити плагін з доступних маркетплейсів (скорочено для install)'
    'init:Створити каркас нового плагіна (автозавантаження в наступній сесії)'
    'new:Створити каркас нового плагіна (псевдонім для init)'
    'uninstall:Видалити встановлений плагін'
    'remove:Видалити встановлений плагін (псевдонім для uninstall)'
    'enable:Увімкнути вимкнений плагін'
    'disable:Вимкнути увімкнений плагін'
    'update:Оновити плагін до останньої версії'
    'eval:Запустити тестові випадки для плагіна та повідомити оцінені результати'
    'prune:Видалити автоматично встановлені залежності, які більше не потрібні'
    'autoremove:Видалити автоматично встановлені залежності, які більше не потрібні (псевдонім для prune)'
    'tag:Створити git тег {name}--v{version} для релізу плагіна'
    'test:Запустити тести мода'
    'help:Показати довідку'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Показати довідку]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'команди plugin' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Вважати попередження помилками (код виходу 1)]' \
            '--json[Вивести звіт валідації у форматі JSON (ті самі коди виходу)]' \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Область встановлення]:scope:(user project local)' \
            '*--config[Встановити опцію userConfig, оголошену в маніфесті плагіна (можна повторювати)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Прийняти показану команду, оголошену маркетплейсом, без запиту підтвердження]' \
            '--json[Вивести один машиночитаний рядок результату замість повідомлення для людини]' \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Область встановлення]:scope:(user project local)' \
            '--keep-data[Зберегти директорію постійних даних плагіна]' \
            '--prune[Також видалити автоматично встановлені залежності, які більше не потрібні]' \
            '(-y --yes)'{-y,--yes}'[Пропустити запит підтвердження --prune]' \
            '--json[Вивести один машиночитаний рядок результату замість повідомлення для людини (не з --prune)]' \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Область встановлення]:scope:(user project local)' \
            '--json[Вивести один машиночитаний рядок результату замість повідомлення для людини]' \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Вимкнути всі увімкнені плагіни]' \
            '(-s --scope)'{-s,--scope}'[Область встановлення]:scope:(user project local)' \
            '--json[Вивести один машиночитаний рядок результату замість повідомлення для людини]' \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Область встановлення]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Прийняти показану команду, оголошену маркетплейсом, без запиту підтвердження]' \
            '--json[Вивести один машиночитаний рядок результату замість повідомлення для людини]' \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Вивести у форматі JSON]' \
            '--available[Включити доступні плагіни з маркетплейсів (потребує --json)]' \
            '(-h --help)'{-h,--help}'[Показати довідку]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Очистити в області дії]:scope:(user project local)' \
            '--dry-run[Показати список того, що буде видалено, без видалення]' \
            '(-y --yes)'{-y,--yes}'[Пропустити запит підтвердження]' \
            '(-h --help)'{-h,--help}'[Показати довідку]'
          ;;
        configure)
          _arguments \
            '--json[Вивести у форматі JSON]' \
            '--values-stdin[Прочитати значення опцій з stdin як JSON об'\''єкт однорядкових рядків; невказані опції зберігають свої значення]' \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Опис у маніфесті]:text:' \
            '--author[Ім'\''я автора (за замовчуванням: git config user.name)]:name:' \
            '--author-email[Email автора (за замовчуванням: git config user.email)]:email:' \
            '--with[Компоненти, для яких також створити каркас]:components:' \
            '(-f --force)'{-f,--force}'[Перезаписати існуючу .claude-plugin/ у цільовому розташуванні]' \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Фільтрувати тестові випадки за glob-шаблоном назви]:glob:' \
            '*--tag[Фільтрувати тестові випадки за тегом (можна повторювати)]:tag:' \
            '--runs[Перевизначити кількість запусків на тестовий випадок (за замовчуванням: case.runs, інакше 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Виконувати до n запусків агента одночасно (1-8; за замовчуванням 1)]:n:' \
            '--model[Перевизначити модель для всіх тестових випадків]:model:_claude_model_names' \
            '--judge-model[Перевизначити модель LLM-оцінювача (за замовчуванням: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Жорстка межа витрат; у разі досягнення перервати та повідомити часткові результати (код виходу 2)]:usd:' \
            '--output-dir[Директорія для aggregate-result.json]:dir:_directories' \
            '--eval-dir[Назва директорії (всередині плагіна), що містить тестові випадки eval]:dir:' \
            '--json[Вивести повний результат запуску у форматі JSON у stdout або записати його в цей .json файл]::path:_files' \
            '--threshold[Завершити з кодом виходу 1, якщо оцінка будь-якого тестового випадку нижча за цей поріг (за замовчуванням: 1.0)]:threshold:' \
            '*--allow-tools[Дозвіл оператора для інструментів з обмеженим доступом (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Запускати scaffold_script кожного тестового випадку (виконує наданий автором bash від вашого імені; за замовчуванням вимкнено)]' \
            '(--scaffold)--no-scaffold[Явно пропустити scaffold_script]' \
            '--trust-plugin[Підтвердити, що ви довіряєте цьому плагіну та його набору eval, пропустивши запит довіри при першому запуску (для CI)]' \
            '--ablation[Запустити контрольну групу без плагіна та повідомити різницю в оцінці]:mode:(none with-without)' \
            '--mocks[Mock-замінники для MCP серверів з <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[З --mocks record: також запустити процеси реальних MCP серверів, для яких немає mock]' \
            '--keep-temp[Зберегти директорії каркаса для налагодження]' \
            '--verbose[Записувати події трасування для кожного повідомлення в лог налагодження]' \
            '--report[Записати автономний HTML звіт за цим шляхом замість директорії результатів]:path:_files' \
            '(--no-publish)--publish-report[Також вимагати публікації звіту на claude.ai]' \
            '(--publish-report)--no-publish[Зберігати HTML звіт лише локально; не публікувати його на claude.ai]' \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Надіслати тег у --remote після його створення]' \
            '--dry-run[Вивести, що буде позначено тегом, без його створення]' \
            '(-f --force)'{-f,--force}'[Пропустити перевірки незакомічених змін у робочому дереві та наявності тегу]' \
            '(-m --message)'{-m,--message}'[Повідомлення анотації тегу (використовуйте %s для версії)]:msg:' \
            '--remote[Remote, у який надсилати з --push]:name:' \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Додати маркетплейс з URL, шляху або GitHub репозиторію'
    'list:Показати список налаштованих маркетплейсів'
    'remove:Видалити налаштований маркетплейс'
    'rm:Видалити налаштований маркетплейс (псевдонім для remove)'
    'update:Оновити маркетплейс з джерела - оновити всі, якщо назва не вказана'
    'help:Показати довідку'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Показати довідку]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'команди marketplace' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Обмежити checkout конкретними директоріями через git sparse-checkout (для монорепозиторіїв)]:paths:' \
            '--scope[Де оголосити маркетплейс]:scope:(user project local)' \
            '--claudeai[Додати маркетплейс з цією назвою, який claude.ai розміщує для вас]' \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Вивести у форматі JSON]' \
            '(-h --help)'{-h,--help}'[Показати довідку]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Видалити оголошення маркетплейсу з конкретної області дії налаштувань (не вказуйте, щоб видалити з усіх областей)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Показати довідку]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Примусове встановлення, навіть якщо вже встановлено]' \
    '(-h --help)'{-h,--help}'[Показати довідку]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Додаткова директорія для надання доступу інструментам у відправлених сесіях]:directory:_directories' \
    '--agent[Агент за замовчуванням для сесій, відправлених з перегляду агентів]:agent:_claude_agent_names' \
    '--all[З --json: також включити завершені фонові сесії]' \
    '--allow-dangerously-skip-permissions[Зробити режим обходу дозволів доступним для відправлених сесій]' \
    '--cwd[Показати лише фонові сесії, запущені за шляхом]:path:_directories' \
    '--dangerously-skip-permissions[Псевдонім для --permission-mode bypassPermissions]' \
    '--effort[Рівень зусиль за замовчуванням для відправлених сесій]:level:(low medium high xhigh max)' \
    '--json[Вивести активні сесії як JSON масив і вийти]' \
    '*--mcp-config[Конфігурація MCP сервера для застосування до відправлених сесій]:config:' \
    '--model[Модель за замовчуванням для сесій, відправлених з перегляду агентів]:model:_claude_model_names' \
    '--permission-mode[Режим дозволів за замовчуванням для відправлених сесій]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Завантажувати плагіни з директорії для перегляду агентів та відправлених сесій]:path:_directories' \
    '--setting-sources[Список джерел налаштувань через кому для завантаження (user, project, local)]:sources:' \
    '--settings[Файл налаштувань або JSON рядок для застосування]:file-or-json:_files' \
    '--strict-mcp-config[Використовувати лише MCP сервери з --mcp-config у відправлених сесіях]' \
    '--restricted[Запускати відправлені сесії в обмеженому режимі]' \
    '(-h --help)'{-h,--help}'[Показати довідку для команди]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Увійти в обліковий запис Anthropic'
    'logout:Вийти з облікового запису Anthropic'
    'status:Показати статус автентифікації'
    'help:Показати довідку'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Показати довідку для команди]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'команди auth' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Попередньо заповнити адресу електронної пошти на сторінці входу]:email:' \
            '--sso[Примусово використати вхід через SSO]' \
            '(--claudeai)--console[Використовувати Anthropic Console (оплата за використання API) замість підписки Claude]' \
            '(--console)--claudeai[Використовувати підписку Claude (за замовчуванням)]' \
            '(-h --help)'{-h,--help}'[Показати довідку для команди]'
          ;;
        status)
          _arguments \
            '(--text)--json[Вивести у форматі JSON (за замовчуванням)]' \
            '(--json)--text[Вивести як текст, зручний для читання людиною]' \
            '(-h --help)'{-h,--help}'[Показати довідку для команди]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Показати довідку для команди]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Вивести ефективну конфігурацію авторежиму у форматі JSON'
    'critique:Отримати відгук ШІ про ваші користувацькі правила авторежиму'
    'defaults:Вивести стандартні правила авторежиму у форматі JSON'
    'reset:Скинути конфігурацію авторежиму до стандартних значень'
    'help:Показати довідку'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Показати довідку для команди]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'команди auto-mode' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Перевизначити модель, що використовується]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Показати довідку для команди]'
          ;;
        defaults)
          _arguments \
            '--label[Показати лише правила, мітка яких починається з цього префікса (без урахування регістру)]:prefix:' \
            '(-h --help)'{-h,--help}'[Показати довідку для команди]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Пропустити запит підтвердження]' \
            '(-h --help)'{-h,--help}'[Показати довідку для команди]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Показати довідку для команди]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Шлях до YAML конфігурації шлюзу]:path:_files' \
    '(-h --help)'{-h,--help}'[Показати довідку для команди]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Видалити весь стан Claude Code для проекту (транскрипти, завдання, історія файлів, запис конфігурації)'
    'help:Показати довідку'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Показати довідку для команди]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'команди project' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Показати список того, що буде видалено, нічого не видаляючи]' \
            '(-y --yes)'{-y,--yes}'[Пропустити запит підтвердження]' \
            '(-i --interactive)'{-i,--interactive}'[Запитувати підтвердження для кожного елемента перед видаленням]' \
            '(1)--all[Очистити стан для всіх проектів (несумісно із зазначенням шляху)]' \
            '(-h --help)'{-h,--help}'[Показати довідку для команди]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Вивести необроблений вміст bugs.json замість форматованих результатів]' \
    '--timeout[Максимальна кількість хвилин очікування завершення огляду (за замовчуванням: 45)]:minutes:' \
    '(--no-post)--post[Опублікувати результати завершеного огляду в PR від вашого імені (лише для цілей PR; один звичайний коментар, а не рев'\''ю)]' \
    '(--post)--no-post[Не публікувати результати в PR (за замовчуванням)]' \
    '(-h --help)'{-h,--help}'[Показати довідку для команди]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Перезапустити всі запущені фонові сесії]' \
    '(-h --help)'{-h,--help}'[Показати довідку для команди]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Також відкинути ненадіслані коміти та незакомічені зміни worktree (передайте commit@worktree-id, який повідомила попередня команда claude rm)]:commit@worktree-id:' \
    '--force-remove-worktree[Видалити директорію worktree, навіть якщо хук WorktreeRemove або git не змогли її видалити (передайте worktree-id, який повідомила попередня команда claude rm)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Показати довідку для команди]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Показати, що буде імпортовано, нічого не записуючи]' \
    '--yes[Пропустити інтерактивний вибір (у headless середовищах передайте --yes=<digest> з попереднього перегляду /import)]' \
    '(-h --help)'{-h,--help}'[Показати довідку для команди]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
