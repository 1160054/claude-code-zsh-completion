#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Configurer et gérer les serveurs MCP'
    'plugin:Gérer les plugins Claude Code'
    'agents:Gérer les agents en arrière-plan'
    'attach:Ouvrir une session en arrière-plan dans ce terminal'
    'logs:Afficher la sortie terminal récente d'\''une session en arrière-plan'
    'stop:Arrêter une session en arrière-plan (sa conversation est conservée)'
    'respawn:Redémarrer une session en arrière-plan pour qu'\''elle utilise la version actuelle de Claude Code'
    'rm:Supprimer une session en arrière-plan, et son worktree quand c'\''est sans risque'
    'auth:Gérer l'\''authentification'
    'auto-mode:Inspecter ou réinitialiser la configuration du classificateur du mode automatique'
    'gateway:Exécuter la passerelle d'\''authentification/télémétrie d'\''entreprise'
    'import:Importer la configuration d'\''un autre agent de codage IA dans Claude Code'
    'project:Gérer l'\''état du projet Claude Code'
    'ultrareview:Exécuter une revue de code multi-agents hébergée dans le cloud et afficher les résultats'
    'setup-token:Configurer le jeton d'\''authentification à long terme (nécessite un abonnement Claude)'
    'doctor:Vérification de santé du système de mise à jour automatique de Claude Code'
    'update:Vérifier et installer les mises à jour'
    'install:Installer la version native de Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Activer le mode débogage avec filtrage optionnel par catégorie (ex. "api,hooks" ou "!statsig,!file")]:filter:'
    '--verbose[Remplacer le paramètre de mode détaillé du fichier de configuration]'
    '(-p --print)'{-p,--print}'[Afficher la réponse et quitter (pour utilisation avec pipes). Note: utiliser uniquement dans des répertoires de confiance]'
    '--output-format[Format de sortie (avec --print): "text" (par défaut), "json" (résultat unique) ou "stream-json" (diffusion en temps réel)]:format:(text json stream-json)'
    '--json-schema[Schéma JSON pour la validation de sortie structurée]:schema:'
    '--include-partial-messages[Inclure les fragments de messages partiels dès leur arrivée (avec --print et --output-format=stream-json)]'
    '--input-format[Format d'\''entrée (avec --print): "text" (par défaut) ou "stream-json" (entrée en flux temps réel)]:format:(text stream-json)'
    '--mcp-debug[\[Obsolète. Utiliser --debug à la place\] Activer le mode débogage MCP (affiche les erreurs du serveur MCP)]'
    '--dangerously-skip-permissions[Contourner toutes les vérifications de permissions. Recommandé uniquement pour les bacs à sable sans accès Internet]'
    '--allow-dangerously-skip-permissions[Activer l'\''option de contournement des vérifications de permissions sans l'\''activer par défaut]'
    '--restricted[Mode restreint : retire les outils qui exécutent des commandes ou du code ainsi que WebFetch, ignore les paramètres user/project/local et confine les outils de fichiers aux répertoires de travail]'
    '--max-budget-usd[Montant maximum en dollars à dépenser pour les appels API (--print uniquement)]:amount:'
    '--replay-user-messages[Renvoyer les messages utilisateur depuis stdin sur stdout pour confirmation]'
    '--allowed-tools[Liste séparée par des virgules ou des espaces de noms d'\''outils autorisés (ex. "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Liste séparée par des virgules ou des espaces de noms d'\''outils autorisés (format camelCase)]:tools:'
    '--tools[Spécifier la liste des outils disponibles depuis l'\''ensemble intégré. Mode impression uniquement]:tools:'
    '--disallowed-tools[Liste séparée par des virgules ou des espaces de noms d'\''outils interdits (ex. "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Liste séparée par des virgules ou des espaces de noms d'\''outils interdits (format camelCase)]:tools:'
    '--mcp-config[Charger les serveurs MCP depuis un fichier JSON ou une chaîne (séparés par des espaces)]:configs:'
    '--system-prompt[Invite système à utiliser pour la session]:prompt:'
    '--system-prompt-file[Lire le prompt système depuis un fichier]:file:_files'
    '--append-system-prompt[Ajouter une invite système à l'\''invite système par défaut]:prompt:'
    '--append-system-prompt-file[Lire le prompt système depuis un fichier et l'\''ajouter au prompt système par défaut]:file:_files'
    '--system-prompt-snapshot[Enregistrer le prompt système une fois par conversation et le réutiliser tel quel à chaque requête et reprise (on, par défaut) ou le régénérer à chaque requête (off)]:mode:(on off)'
    '--permission-mode[Mode de permissions à utiliser pour la session]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Qui répond aux demandes de permission avec --print : "host" (l'\''hôte SDK ou --permission-prompt-tool) ou "none" (tout ce qui demanderait une permission est refusé)]:target:(host none)'
    '--permission-prompt-tool[Outil MCP à utiliser pour les demandes de permission (--print uniquement)]:tool:'
    '(-c --continue)'{-c,--continue}'[Continuer la conversation la plus récente]'
    '(-r --resume)'{-r,--resume}'[Reprendre une conversation - spécifier l'\''ID de session ou sélectionner interactivement]:sessionId:_claude_sessions'
    '--fork-session[Créer un nouvel ID de session au lieu de réutiliser l'\''ID de session original lors de la reprise (avec --resume ou --continue)]'
    '--no-session-persistence[Désactiver la persistance de session - les sessions ne seront pas enregistrées (--print uniquement)]'
    '--model[Modèle pour la session actuelle. Spécifier un alias du modèle le plus récent (ex. '\''sonnet'\'' ou '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agent pour la session actuelle. Remplace le paramètre '\''agent'\'']:agent:_claude_agent_names'
    '--betas[En-têtes bêta à inclure dans les requêtes API (utilisateurs avec clé API uniquement)]:betas:'
    '--fallback-model[Activer le basculement automatique vers le modèle spécifié lorsque le modèle par défaut est surchargé (--print uniquement)]:model:_claude_model_names'
    '--settings[Chemin vers le fichier JSON de paramètres ou chaîne JSON pour charger des paramètres supplémentaires]:file-or-json:_files'
    '--add-dir[Répertoires supplémentaires pour autoriser l'\''accès aux outils]:directories:_directories'
    '--ide[Se connecter automatiquement à l'\''IDE au démarrage si exactement un IDE valide est disponible]'
    '--strict-mcp-config[Utiliser uniquement les serveurs MCP de --mcp-config et ignorer tous les autres paramètres MCP]'
    '--session-id[ID de session spécifique à utiliser pour la conversation (doit être un UUID valide)]:uuid:'
    '--agents[Objet JSON définissant des agents personnalisés]:json:'
    '--setting-sources[Liste séparée par des virgules de sources de paramètres à charger (user, project, local)]:sources:'
    '--plugin-dir[Répertoire depuis lequel charger les plugins pour cette session uniquement (répétable)]:paths:_directories'
    '--disable-slash-commands[Désactiver toutes les commandes slash]'
    '(--bg --background)'{--bg,--background}'[Démarrer la session en tant qu'\''agent en arrière-plan et revenir immédiatement]'
    '(-w --worktree)'{-w,--worktree}'[Créer un nouveau worktree git pour cette session (spécifier un nom en option)]::name:'
    '--tmux=-[Créer une session tmux pour le worktree (nécessite --worktree). Utilise les panneaux natifs d'\''iTerm2 si disponibles ; --tmux=classic pour le tmux traditionnel]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Définir un nom d'\''affichage pour cette session]:name:'
    '--effort[Niveau d'\''effort pour la session actuelle]:level:(low medium high xhigh max)'
    '--autocompact[Taille de la fenêtre de compactage automatique (auto, ou de 100k à 1M de tokens)]:size:(auto)'
    '--debug-file[Écrire les journaux de débogage dans un chemin de fichier spécifique (active implicitement le mode débogage)]:path:_files'
    '--from-pr[Reprendre une session liée à une PR par numéro/URL, ou ouvrir le sélecteur interactif]::value:'
    '--teleport[Reprendre une session teleport, en spécifiant éventuellement l'\''ID de session]::session:'
    '--cloud[Créer une session cloud avec la description donnée, ou se rattacher à une session existante par ID de session ou URL claude.ai/code]::description-or-session:'
    '--environment[Créer une nouvelle session cloud exécutée sur l'\''environnement auto-hébergé indiqué (ccpool_...)]:environment_id:'
    '--remote-control[Démarrer une session interactive avec le contrôle à distance activé (nommée en option)]::name:'
    '--remote-control-session-name-prefix[Préfixe pour les noms de session de contrôle à distance générés automatiquement]:prefix:'
    '--chrome[Activer l'\''intégration Claude dans Chrome]'
    '--no-chrome[Désactiver l'\''intégration Claude dans Chrome]'
    '--plugin-url[Récupérer un plugin .zip depuis une URL pour cette session uniquement (répétable)]:url:'
    '--file[Ressources de fichiers à télécharger au démarrage (format: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Activer les suggestions d'\''invite (émet une invite suivante prédite en mode print/SDK)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Transférer le texte et les blocs de réflexion des sous-agents en tant que messages (avec --print et stream-json)]'
    '--include-hook-events[Inclure tous les événements de cycle de vie des hooks dans le flux de sortie (avec stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Déplacer les sections propres à la machine dans le premier message utilisateur pour améliorer la réutilisation du cache d'\''invite]'
    '--brief[Activer l'\''outil SendUserMessage pour la communication agent-utilisateur]'
    '--safe-mode[Démarrer avec toutes les personnalisations désactivées (utile pour dépanner une configuration défectueuse)]'
    '--bare[Mode minimal: ignorer les hooks, LSP, la synchronisation des plugins, l'\''attribution, l'\''auto-mémoire et la découverte automatique de CLAUDE.md]'
    '--ax-screen-reader[Afficher une sortie adaptée aux lecteurs d'\''écran (texte plat, sans bordures décoratives ni animations)]'
    '(-v --version)'{-v,--version}'[Afficher le numéro de version]'
    '(-h --help)'{-h,--help}'[Afficher l'\''aide de la commande]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'commandes claude' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide de la commande]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "aucun argument"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Démarrer un serveur MCP Claude Code'
    'add:Ajouter un serveur MCP à Claude Code'
    'remove:Supprimer un serveur MCP'
    'list:Lister les serveurs MCP configurés'
    'get:Obtenir les détails du serveur MCP'
    'add-json:Ajouter un serveur MCP (stdio ou SSE) avec une chaîne JSON'
    'add-from-claude-desktop:Importer des serveurs MCP depuis Claude Desktop (Mac et WSL uniquement)'
    'reset-project-choices:Réinitialiser tous les serveurs de portée projet (.mcp.json) approuvés/refusés dans ce projet'
    'login:S'\''authentifier auprès d'\''un serveur MCP (HTTP, SSE ou connecteur claude.ai)'
    'logout:Effacer les identifiants OAuth stockés pour un serveur MCP'
    'help:Afficher l'\''aide'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'commandes mcp' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Activer le mode débogage]' \
            '--verbose[Remplacer le paramètre de mode détaillé du fichier de configuration]' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Portée de configuration (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Type de transport (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Définir une variable d'\''environnement (ex. -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Définir un en-tête WebSocket]:header:' \
            '--client-id[ID client OAuth pour les serveurs HTTP/SSE]:clientId:' \
            '--client-secret[Demander le secret client OAuth (ou définir la variable d'\''environnement MCP_CLIENT_SECRET)]' \
            '--callback-port[Port fixe pour le callback OAuth (pour les serveurs exigeant des URI de redirection préenregistrées)]:port:' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Portée de configuration (local, user, project) - supprimer de la portée existante si non spécifié]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Portée de configuration (local, user, project)]:scope:(local user project)' \
            '--client-secret[Demander le secret client OAuth (ou définir la variable d'\''environnement MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Portée de configuration (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]'
          ;;
        login)
          _arguments \
            '--no-browser[Afficher l'\''URL d'\''autorisation au lieu d'\''ouvrir un navigateur (pour les sessions SSH/sans interface)]' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Valider un plugin ou un manifeste de marketplace'
    'marketplace:Gérer les marketplaces Claude Code'
    'list:Lister les plugins installés'
    'details:Afficher l'\''inventaire des composants et le coût estimé en jetons pour un plugin'
    'install:Installer un plugin depuis les marketplaces disponibles'
    'i:Installer un plugin depuis les marketplaces disponibles (abréviation de install)'
    'init:Générer la structure d'\''un nouveau plugin (chargé automatiquement à la prochaine session)'
    'new:Générer la structure d'\''un nouveau plugin (alias de init)'
    'uninstall:Désinstaller un plugin installé'
    'remove:Désinstaller un plugin installé (alias de uninstall)'
    'enable:Activer un plugin désactivé'
    'disable:Désactiver un plugin activé'
    'update:Mettre à jour un plugin vers la dernière version'
    'eval:Exécuter des cas d'\''évaluation sur un plugin et rapporter les résultats notés'
    'prune:Supprimer les dépendances installées automatiquement qui ne sont plus nécessaires'
    'autoremove:Supprimer les dépendances installées automatiquement qui ne sont plus nécessaires (alias de prune)'
    'tag:Créer une balise git {name}--v{version} pour une version de plugin'
    'help:Afficher l'\''aide'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'commandes plugin' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Traiter les avertissements comme des erreurs (sortie 1)]' \
            '--json[Afficher le rapport de validation en JSON (mêmes codes de sortie)]' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Portée d'\''installation]:scope:(user project local)' \
            '*--config[Définir une option userConfig déclarée dans le manifeste du plugin (répétable)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Accepter la commande déclarée par la marketplace affichée sans demande de confirmation]' \
            '--json[Afficher une ligne de résultat lisible par machine au lieu du message pour humains]' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Portée d'\''installation]:scope:(user project local)' \
            '--keep-data[Conserver le répertoire de données persistantes du plugin]' \
            '--prune[Supprimer aussi les dépendances installées automatiquement qui ne sont plus nécessaires]' \
            '(-y --yes)'{-y,--yes}'[Sauter la confirmation de --prune]' \
            '--json[Afficher une ligne de résultat lisible par machine au lieu du message pour humains (pas avec --prune)]' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Portée d'\''installation]:scope:(user project local)' \
            '--json[Afficher une ligne de résultat lisible par machine au lieu du message pour humains]' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Désactiver tous les plugins activés]' \
            '(-s --scope)'{-s,--scope}'[Portée d'\''installation]:scope:(user project local)' \
            '--json[Afficher une ligne de résultat lisible par machine au lieu du message pour humains]' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Portée d'\''installation]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Accepter la commande déclarée par la marketplace affichée sans demande de confirmation]' \
            '--json[Afficher une ligne de résultat lisible par machine au lieu du message pour humains]' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Sortie en JSON]' \
            '--available[Inclure les plugins disponibles dans les marketplaces (nécessite --json)]' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Portée dans laquelle nettoyer]:scope:(user project local)' \
            '--dry-run[Lister ce qui serait supprimé sans rien supprimer]' \
            '(-y --yes)'{-y,--yes}'[Sauter la demande de confirmation]' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Description du manifeste]:text:' \
            '--author[Nom de l'\''auteur (par défaut : git config user.name)]:name:' \
            '--author-email[E-mail de l'\''auteur (par défaut : git config user.email)]:email:' \
            '--with[Composants à générer également]:components:' \
            '(-f --force)'{-f,--force}'[Écraser un .claude-plugin/ existant à la destination]' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Filtrer les cas par glob de nom]:glob:' \
            '*--tag[Filtrer les cas par tag (répétable)]:tag:' \
            '--runs[Remplacer le nombre d'\''exécutions par cas (par défaut : case.runs, sinon 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Exécuter jusqu'\''à n agents en parallèle (1-8 ; 1 par défaut)]:n:' \
            '--model[Remplacer le modèle pour tous les cas]:model:_claude_model_names' \
            '--judge-model[Remplacer le modèle d'\''évaluation LLM (par défaut : haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Plafond de coût strict ; interrompre et rapporter les résultats partiels s'\''il est atteint (sortie 2)]:usd:' \
            '--output-dir[Répertoire pour aggregate-result.json]:dir:_directories' \
            '--eval-dir[Nom du répertoire (sous le plugin) contenant les cas d'\''évaluation]:dir:' \
            '--json[Afficher le résultat complet de l'\''exécution en JSON sur stdout, ou l'\''écrire dans ce fichier .json]::path:_files' \
            '--threshold[Sortir avec 1 si le score d'\''un cas est sous ce seuil (par défaut : 1.0)]:threshold:' \
            '*--allow-tools[Autorisation de l'\''opérateur pour les outils restreints (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Exécuter le scaffold_script de chaque cas (exécute du bash fourni par l'\''auteur avec votre utilisateur ; désactivé par défaut)]' \
            '(--scaffold)--no-scaffold[Ignorer explicitement scaffold_script]' \
            '--trust-plugin[Déclarer que vous faites confiance à ce plugin et à sa suite d'\''évaluation, en sautant la question de confiance au premier lancement (pour la CI)]' \
            '--ablation[Exécuter aussi une référence sans plugin et rapporter l'\''écart de score]:mode:(none with-without)' \
            '--mocks[Doublures simulées des serveurs MCP, depuis <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Avec --mocks record : démarrer aussi les vrais processus des serveurs MCP sans simulation]' \
            '--keep-temp[Conserver les répertoires de scaffold pour le débogage]' \
            '--verbose[Journaliser les événements de trace par message dans le journal de débogage]' \
            '--report[Écrire le rapport HTML autonome à ce chemin plutôt que dans le répertoire des résultats]:path:_files' \
            '(--no-publish)--publish-report[Exiger aussi la publication du rapport sur claude.ai]' \
            '(--publish-report)--no-publish[Garder le rapport HTML en local uniquement ; ne pas le publier sur claude.ai]' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Pousser le tag vers --remote après sa création]' \
            '--dry-run[Afficher ce qui serait tagué sans créer le tag]' \
            '(-f --force)'{-f,--force}'[Sauter les vérifications d'\''arbre de travail modifié et de tag déjà existant]' \
            '(-m --message)'{-m,--message}'[Message d'\''annotation du tag (utiliser %s pour la version)]:msg:' \
            '--remote[Dépôt distant vers lequel pousser avec --push]:name:' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
            '::path:_files'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Ajouter un marketplace depuis une URL, un chemin ou un dépôt GitHub'
    'list:Lister les marketplaces configurés'
    'remove:Supprimer un marketplace configuré'
    'rm:Supprimer un marketplace configuré (alias de remove)'
    'update:Mettre à jour le marketplace depuis la source - mettre à jour tous si aucun nom spécifié'
    'help:Afficher l'\''aide'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'commandes marketplace' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Limiter le checkout à certains répertoires via git sparse-checkout (pour les monorepos)]:paths:' \
            '--scope[Où déclarer la marketplace]:scope:(user project local)' \
            '--claudeai[Ajouter la marketplace de ce nom que claude.ai héberge pour vous]' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Sortie en JSON]' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Retirer la déclaration de la marketplace d'\''une portée de paramètres précise (omettre pour la retirer de toutes)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Forcer l'\''installation même si déjà installé]' \
    '(-h --help)'{-h,--help}'[Afficher l'\''aide]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Répertoire supplémentaire pour autoriser l'\''accès aux outils dans les sessions distribuées]:directory:_directories' \
    '--agent[Agent par défaut pour les sessions distribuées depuis la vue agent]:agent:_claude_agent_names' \
    '--all[Avec --json: inclure également les sessions en arrière-plan terminées]' \
    '--allow-dangerously-skip-permissions[Rendre le mode contournement des permissions disponible pour les sessions distribuées]' \
    '--cwd[Afficher uniquement les sessions en arrière-plan démarrées sous le chemin]:path:_directories' \
    '--dangerously-skip-permissions[Alias de --permission-mode bypassPermissions]' \
    '--effort[Niveau d'\''effort par défaut pour les sessions distribuées]:level:(low medium high xhigh max)' \
    '--json[Afficher les sessions actives sous forme de tableau JSON et quitter]' \
    '*--mcp-config[Configuration de serveur MCP à appliquer aux sessions distribuées]:config:' \
    '--model[Modèle par défaut pour les sessions distribuées depuis la vue agent]:model:_claude_model_names' \
    '--permission-mode[Mode de permissions par défaut pour les sessions distribuées]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Charger les plugins depuis le répertoire pour la vue agent et les sessions distribuées]:path:_directories' \
    '--setting-sources[Liste séparée par des virgules de sources de paramètres à charger (user, project, local)]:sources:' \
    '--settings[Fichier de paramètres ou chaîne JSON à appliquer]:file-or-json:_files' \
    '--strict-mcp-config[Utiliser uniquement les serveurs MCP de --mcp-config dans les sessions distribuées]' \
    '--restricted[Démarrer les sessions lancées en mode restreint]' \
    '(-h --help)'{-h,--help}'[Afficher l'\''aide de la commande]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Se connecter à votre compte Anthropic'
    'logout:Se déconnecter de votre compte Anthropic'
    'status:Afficher l'\''état de l'\''authentification'
    'help:Afficher l'\''aide'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Afficher l'\''aide de la commande]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'commandes auth' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Préremplir l'\''adresse e-mail sur la page de connexion]:email:' \
            '--sso[Forcer le flux de connexion SSO]' \
            '(--claudeai)--console[Utiliser Anthropic Console (facturation à l'\''usage de l'\''API) au lieu de l'\''abonnement Claude]' \
            '(--console)--claudeai[Utiliser l'\''abonnement Claude (par défaut)]' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide de la commande]'
          ;;
        status)
          _arguments \
            '(--text)--json[Sortie en JSON (par défaut)]' \
            '(--json)--text[Sortie en texte lisible]' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide de la commande]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide de la commande]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Afficher la configuration effective du mode automatique au format JSON'
    'critique:Obtenir un retour de l'\''IA sur vos règles de mode automatique personnalisées'
    'defaults:Afficher les règles par défaut du mode automatique au format JSON'
    'reset:Réinitialiser la configuration du mode automatique aux valeurs par défaut fournies'
    'help:Afficher l'\''aide'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Afficher l'\''aide de la commande]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'commandes auto-mode' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Remplacer le modèle utilisé]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide de la commande]'
          ;;
        defaults)
          _arguments \
            '--label[N'\''afficher que les règles dont le label commence par ce préfixe (insensible à la casse)]:prefix:' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide de la commande]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Sauter la demande de confirmation]' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide de la commande]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide de la commande]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Chemin vers le fichier de configuration YAML de la passerelle]:path:_files' \
    '(-h --help)'{-h,--help}'[Afficher l'\''aide de la commande]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Supprimer tout l'\''état Claude Code d'\''un projet (transcriptions, tâches, historique des fichiers, entrée de configuration)'
    'help:Afficher l'\''aide'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Afficher l'\''aide de la commande]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'commandes project' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Lister ce qui serait supprimé sans rien supprimer]' \
            '(-y --yes)'{-y,--yes}'[Sauter la demande de confirmation]' \
            '(-i --interactive)'{-i,--interactive}'[Demander confirmation pour chaque élément avant suppression]' \
            '(1)--all[Purger l'\''état de tous les projets (incompatible avec un chemin)]' \
            '(-h --help)'{-h,--help}'[Afficher l'\''aide de la commande]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Afficher la charge utile brute bugs.json au lieu des résultats formatés]' \
    '--timeout[Nombre maximum de minutes à attendre la fin de la revue (par défaut : 45)]:minutes:' \
    '(--no-post)--post[Publier les conclusions de la revue terminée sur la PR en votre nom (cibles PR uniquement ; un simple commentaire, pas une review)]' \
    '(--post)--no-post[Ne pas publier les conclusions sur la PR (par défaut)]' \
    '(-h --help)'{-h,--help}'[Afficher l'\''aide de la commande]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Redémarrer toutes les sessions en arrière-plan en cours]' \
    '(-h --help)'{-h,--help}'[Afficher l'\''aide de la commande]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Abandonner aussi les commits non poussés et les modifications non validées du worktree (passer le commit@worktree-id indiqué par un précédent claude rm)]:commit@worktree-id:' \
    '--force-remove-worktree[Supprimer le répertoire du worktree même si le hook WorktreeRemove ou git n'\''a pas pu le retirer (passer le worktree-id indiqué par un précédent claude rm)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Afficher l'\''aide de la commande]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Afficher ce qui serait importé sans rien écrire]' \
    '--yes[Sauter le sélecteur interactif (en environnement sans interface, passer --yes=<digest> tiré de l'\''aperçu /import)]' \
    '(-h --help)'{-h,--help}'[Afficher l'\''aide de la commande]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
