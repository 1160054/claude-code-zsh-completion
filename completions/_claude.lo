#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:ກຳນົດຄ່າແລະຈັດການເຊີບເວີ MCP'
    'plugin:ຈັດການໂປລແກຼມເສີມ Claude Code'
    'agents:ຈັດການຕົວແທນທີ່ເຮັດວຽກພື້ນຫຼັງ'
    'attach:ເປີດເຊສຊັນພື້ນຫຼັງໃນເທີມິນອລນີ້'
    'logs:ພິມຜົນໄດ້ຮັບເທີມິນອລຫຼ້າສຸດຂອງເຊສຊັນພື້ນຫຼັງ'
    'stop:ຢຸດເຊສຊັນພື້ນຫຼັງ (ການສົນທະນາຂອງມັນຍັງຖືກເກັບໄວ້)'
    'respawn:ເລີ່ມເຊສຊັນພື້ນຫຼັງໃໝ່ ເພື່ອໃຫ້ມັນແລ່ນດ້ວຍເວີຊັນ Claude Code ປັດຈຸບັນ'
    'rm:ລຶບເຊສຊັນພື້ນຫຼັງ ແລະ worktree ຂອງມັນເມື່ອປອດໄພ'
    'auth:ຈັດການການຢືນຢັນຕົວຕົນ'
    'auto-mode:ກວດສອບ ຫຼືຕັ້ງຄ່າໃໝ່ການຕັ້ງຄ່າຕົວຈັດປະເພດຂອງໂໝດອັດຕະໂນມັດ'
    'gateway:ແລ່ນເກດເວທ໌ການຢືນຢັນ/telemetry ສຳລັບອົງກອນ'
    'import:ນຳເຂົ້າການຕັ້ງຄ່າຈາກຕົວແທນຂຽນໂຄດ AI ອື່ນເຂົ້າໃນ Claude Code'
    'project:ຈັດການສະຖານະໂຄງການ Claude Code'
    'ultrareview:ແລ່ນການກວດສອບໂຄດແບບຫຼາຍຕົວແທນທີ່ໂຮສຢູ່ຄລາວ ແລະພິມຜົນການຄົ້ນພົບ'
    'setup-token:ຕັ້ງຄ່າໂທເຄນຢືນຢັນໄລຍະຍາວ (ຕ້ອງການການສະໝັກໃຊ້ Claude)'
    'doctor:ກວດສຸຂະພາບໂປລແກຼມອັບເດດອັດຕະໂນມັດ Claude Code'
    'update:ກວດສອບແລະຕິດຕັ້ງການອັບເດດ'
    'install:ຕິດຕັ້ງ Claude Code ເວີຊັນພື້ນເມືອງ'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[ເປີດໃຊ້ໂໝດດີບັກ ດ້ວຍການກັ່ນຕອງປະເພດທີ່ເລືອກໄດ້ (ຕົວຢ່າງ "api,hooks" ຫຼື "!statsig,!file")]:filter:'
    '--verbose[ຂຽນທັບການຕັ້ງຄ່າໂໝດລາຍລະອຽດຈາກໄຟລ໌ການຕັ້ງຄ່າ]'
    '(-p --print)'{-p,--print}'[ພິມຄຳຕອບແລະອອກ (ສຳລັບໃຊ້ກັບ pipe)។ ໝາຍເຫດ: ໃຊ້ພຽງແຕ່ໃນໂຟນເດີທີ່ເຊື່ອຖືໄດ້]'
    '--output-format[ຮູບແບບຜົນໄດ້ຮັບ (ກັບ --print): "text" (ຄ່າເລີ່ມຕົ້ນ), "json" (ຜົນໄດ້ຮັບດຽວ) ຫຼື "stream-json" (ການສະຕຣີມເວລາຕົວຈິງ)]:format:(text json stream-json)'
    '--json-schema[JSON schema ສຳລັບການກວດສອບຜົນໄດ້ຮັບທີ່ມີໂຄງສ້າງ]:schema:'
    '--include-partial-messages[ລວມສ່ວນຂໍ້ຄວາມບາງສ່ວນ (ກັບ --print ແລະ --output-format=stream-json)]'
    '--input-format[ຮູບແບບການປ້ອນຂໍ້ມູນ (ກັບ --print): "text" (ຄ່າເລີ່ມຕົ້ນ) ຫຼື "stream-json" (ການສະຕຣີມປ້ອນເວລາຕົວຈິງ)]:format:(text stream-json)'
    '--mcp-debug[\[ຖືກຍົກເລີກແລ້ວ. ໃຊ້ --debug ແທນ\] ເປີດໃຊ້ໂໝດດີບັກ MCP (ສະແດງຂໍ້ຜິດພາດເຊີບເວີ MCP)]'
    '--dangerously-skip-permissions[ຂ້າມການກວດສອບການອະນຸຍາດທັງໝົດ. ແນະນຳພຽງແຕ່ສຳລັບ sandbox ທີ່ບໍ່ມີການເຂົ້າເຖິງອິນເຕີເນັດ]'
    '--allow-dangerously-skip-permissions[ເປີດໃຊ້ຕົວເລືອກການຂ້າມການກວດສອບການອະນຸຍາດ ແຕ່ບໍ່ເປີດໃຊ້ຕາມຄ່າເລີ່ມຕົ້ນ]'
    '--restricted[ໂໝດຈຳກັດ: ເອົາເຄື່ອງມືທີ່ແລ່ນຄຳສັ່ງ ຫຼືໂຄດ ແລະ WebFetch ອອກ, ບໍ່ສົນໃຈການຕັ້ງຄ່າ user/project/local ແລະຈຳກັດເຄື່ອງມືໄຟລ໌ໄວ້ໃນໂຟນເດີເຮັດວຽກ]'
    '--max-budget-usd[ຈຳນວນເງິນໂດລາສູງສຸດທີ່ຈະໃຊ້ຈ່າຍໃນການເອີ້ນ API (ພຽງແຕ່ --print)]:amount:'
    '--replay-user-messages[ສົ່ງຂໍ້ຄວາມຜູ້ໃຊ້ຈາກ stdin ໃນ stdout ອີກຄັ້ງເພື່ອຢືນຢັນ]'
    '--allowed-tools[ລາຍຊື່ຊື່ເຄື່ອງມືທີ່ອະນຸຍາດ (ແຍກດ້ວຍເຄື່ອງໝາຍຈຸດຄໍາຫຼືເວັ້ນວ່າງ ຕົວຢ່າງ "Bash(git:*) Edit")]:tools:'
    '--allowedTools[ລາຍຊື່ຊື່ເຄື່ອງມືທີ່ອະນຸຍາດ (ຮູບແບບ camelCase)]:tools:'
    '--tools[ລະບຸລາຍຊື່ເຄື່ອງມືທີ່ມີຈາກຊຸດພື້ນຖານ. ພຽງແຕ່ໂໝດພິມ]:tools:'
    '--disallowed-tools[ລາຍຊື່ຊື່ເຄື່ອງມືທີ່ບໍ່ອະນຸຍາດ (ແຍກດ້ວຍເຄື່ອງໝາຍຈຸດຄໍາຫຼືເວັ້ນວ່າງ ຕົວຢ່າງ "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[ລາຍຊື່ຊື່ເຄື່ອງມືທີ່ບໍ່ອະນຸຍາດ (ຮູບແບບ camelCase)]:tools:'
    '--mcp-config[ໂຫລດເຊີບເວີ MCP ຈາກໄຟລ໌ JSON ຫຼືສະຕຣິງ (ແຍກດ້ວຍເວັ້ນວ່າງ)]:configs:'
    '--system-prompt[ການກະຕຸ້ນລະບົບສຳລັບເຊສຊັນ]:prompt:'
    '--system-prompt-file[ອ່ານການກະຕຸ້ນລະບົບຈາກໄຟລ໌]:file:_files'
    '--append-system-prompt[ຕື່ມການກະຕຸ້ນລະບົບໃສ່ການກະຕຸ້ນລະບົບເລີ່ມຕົ້ນ]:prompt:'
    '--append-system-prompt-file[ອ່ານການກະຕຸ້ນລະບົບຈາກໄຟລ໌ ແລະຕື່ມໃສ່ການກະຕຸ້ນລະບົບເລີ່ມຕົ້ນ]:file:_files'
    '--system-prompt-snapshot[ບັນທຶກການກະຕຸ້ນລະບົບຄັ້ງດຽວຕໍ່ການສົນທະນາ ແລະໃຊ້ຄືນແບບຄຳຕໍ່ຄຳໃນທຸກຄຳຂໍ ແລະການສືບຕໍ່ (on, ຄ່າເລີ່ມຕົ້ນ) ຫຼືສ້າງໃໝ່ທຸກຄຳຂໍ (off)]:mode:(on off)'
    '--permission-mode[ໂໝດການອະນຸຍາດສຳລັບເຊສຊັນ]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[ຜູ້ທີ່ຕອບການຖາມການອະນຸຍາດກັບ --print: "host" (ໂຮສ SDK ຫຼື --permission-prompt-tool) ຫຼື "none" (ສິ່ງໃດທີ່ຈະຖາມຈະຖືກປະຕິເສດ)]:target:(host none)'
    '--permission-prompt-tool[ເຄື່ອງມື MCP ທີ່ໃຊ້ສຳລັບການຖາມການອະນຸຍາດ (ພຽງແຕ່ --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[ສືບຕໍ່ການສົນທະນາຫຼ້າສຸດ]'
    '(-r --resume)'{-r,--resume}'[ສືບຕໍ່ການສົນທະນາ - ລະບຸ ID ເຊສຊັນ ຫຼືເລືອກແບບໂຕ້ຕອບ]:sessionId:_claude_sessions'
    '--fork-session[ສ້າງ ID ເຊສຊັນໃໝ່ແທນການໃຊ້ຄືນ ID ເຊສຊັນດັ້ງເດີມ ເມື່ອສືບຕໍ່ (ກັບ --resume ຫຼື --continue)]'
    '--no-session-persistence[ປິດການບັນທຶກເຊສຊັນ - ເຊສຊັນຈະບໍ່ຖືກບັນທຶກ (ພຽງແຕ່ --print)]'
    '--model[ຮູບແບບສຳລັບເຊສຊັນປັດຈຸບັນ. ລະບຸນາມແຝງສຳລັບຮູບແບບຫຼ້າສຸດ (ຕົວຢ່າງ '\''sonnet'\'' ຫຼື '\''opus'\'')]:model:_claude_model_names'
    '--agent[ຕົວແທນສຳລັບເຊສຊັນປັດຈຸບັນ. ຂຽນທັບການຕັ້ງຄ່າ '\''agent'\'']:agent:_claude_agent_names'
    '--betas[ຫົວ Beta ທີ່ຈະລວມໃນຄຳຂໍ API (ພຽງແຕ່ຜູ້ໃຊ້ API key)]:betas:'
    '--fallback-model[ເປີດໃຊ້ການສຳຮອງອັດຕະໂນມັດໄປຫາຮູບແບບທີ່ລະບຸ ເມື່ອຮູບແບບເລີ່ມຕົ້ນໂຫລດເກີນ (ພຽງແຕ່ --print)]:model:_claude_model_names'
    '--settings[ເສັ້ນທາງໄຟລ໌ JSON ຂອງການຕັ້ງຄ່າ ຫຼືສະຕຣິງ JSON ເພື່ອໂຫລດການຕັ້ງຄ່າເພີ່ມເຕີມ]:file-or-json:_files'
    '--add-dir[ໂຟນເດີເພີ່ມເຕີມເພື່ອອະນຸຍາດການເຂົ້າເຖິງເຄື່ອງມື]:directories:_directories'
    '--ide[ເຊື່ອມຕໍ່ກັບ IDE ອັດຕະໂນມັດເມື່ອເລີ່ມຕົ້ນ ຖ້າມີ IDE ທີ່ຖືກຕ້ອງພຽງອັນດຽວ]'
    '--desktop[ເປີດໃນແອັບ Claude Desktop ແທນເທີມິນອລ (ກັບ --continue ຫຼື --resume <id> ເພື່ອເລືອກເຊສຊັນ)]'
    '--strict-mcp-config[ໃຊ້ພຽງແຕ່ເຊີບເວີ MCP ຈາກ --mcp-config ແລະປະຕິເສດການຕັ້ງຄ່າ MCP ອື່ນໆທັງໝົດ]'
    '--session-id[ID ເຊສຊັນສະເພາະສຳລັບການສົນທະນາ (ຕ້ອງເປັນ UUID ທີ່ຖືກຕ້ອງ)]:uuid:'
    '--agents[ອອບເຈັກ JSON ກຳນົດຕົວແທນທີ່ກຳນົດເອງ]:json:'
    '--setting-sources[ລາຍຊື່ແຫຼ່ງການຕັ້ງຄ່າທີ່ຈະໂຫລດ (ແຍກດ້ວຍເຄື່ອງໝາຍຈຸດຄໍາ: user, project, local)]:sources:'
    '--plugin-dir[ໂຟນເດີເພື່ອໂຫລດໂປລແກຼມເສີມສຳລັບເຊສຊັນນີ້ເທົ່ານັ້ນ (ສາມາດຊ້ຳໄດ້)]:paths:_directories'
    '--disable-slash-commands[ປິດຄຳສັ່ງ slash ທັງໝົດ]'
    '(--bg --background)'{--bg,--background}'[ເລີ່ມເຊສຊັນເປັນຕົວແທນພື້ນຫຼັງ ແລະກັບຄືນທັນທີ]'
    '(-w --worktree)'{-w,--worktree}'[ສ້າງ git worktree ໃໝ່ສຳລັບເຊສຊັນນີ້ (ລະບຸຊື່ໄດ້ຕາມທາງເລືອກ)]::name:'
    '--tmux=-[ສ້າງເຊສຊັນ tmux ສຳລັບ worktree (ຕ້ອງການ --worktree). ໃຊ້ pane ໃນຕົວຂອງ iTerm2 ເມື່ອມີ; --tmux=classic ສຳລັບ tmux ແບບດັ້ງເດີມ]::mode:(classic)'
    '(-n --name)'{-n,--name}'[ຕັ້ງຊື່ສະແດງສຳລັບເຊສຊັນນີ້]:name:'
    '--effort[ລະດັບຄວາມພະຍາຍາມສຳລັບເຊສຊັນປັດຈຸບັນ]:level:(low medium high xhigh max)'
    '--autocompact[ຂະໜາດໜ້າຕ່າງການບີບອັດອັດຕະໂນມັດ (auto ຫຼື 100k-1M ໂທເຄນ)]:size:(auto)'
    '--debug-file[ຂຽນບັນທຶກດີບັກໄປຫາເສັ້ນທາງໄຟລ໌ສະເພາະ (ເປີດໃຊ້ໂໝດດີບັກໂດຍປະລິຍາຍ)]:path:_files'
    '--from-pr[ສືບຕໍ່ເຊສຊັນທີ່ເຊື່ອມກັບ PR ດ້ວຍໝາຍເລກ/URL ຫຼືເປີດຕົວເລືອກແບບໂຕ້ຕອບ]::value:'
    '--teleport[ສືບຕໍ່ເຊສຊັນ teleport, ລະບຸ ID ເຊສຊັນໄດ້ຕາມທາງເລືອກ]::session:'
    '--cloud[ສ້າງເຊສຊັນຄລາວດ້ວຍຄຳອະທິບາຍທີ່ລະບຸ ຫຼືເຊື່ອມຕໍ່ກັບເຊສຊັນທີ່ມີຢູ່ດ້ວຍ ID ເຊສຊັນ ຫຼື URL claude.ai/code]::description-or-session:'
    '--environment[ສ້າງເຊສຊັນຄລາວໃໝ່ທີ່ແລ່ນໃນສະພາບແວດລ້ອມທີ່ໂຮສເອງທີ່ລະບຸ (ccpool_...)]:environment_id:'
    '--remote-control[ເລີ່ມເຊສຊັນແບບໂຕ້ຕອບໂດຍເປີດໃຊ້ Remote Control (ຕັ້ງຊື່ໄດ້ຕາມທາງເລືອກ)]::name:'
    '--remote-control-session-name-prefix[ຄຳນຳໜ້າສຳລັບຊື່ເຊສຊັນ Remote Control ທີ່ສ້າງອັດຕະໂນມັດ]:prefix:'
    '--chrome[ເປີດໃຊ້ການເຊື່ອມໂຍງ Claude ໃນ Chrome]'
    '--no-chrome[ປິດການເຊື່ອມໂຍງ Claude ໃນ Chrome]'
    '--plugin-url[ດຶງໄຟລ໌ .zip ຂອງໂປລແກຼມເສີມຈາກ URL ສຳລັບເຊສຊັນນີ້ເທົ່ານັ້ນ (ສາມາດຊ້ຳໄດ້)]:url:'
    '--file[ຊັບພະຍາກອນໄຟລ໌ທີ່ຈະດາວໂຫລດເມື່ອເລີ່ມຕົ້ນ (ຮູບແບບ: file_id:relative_path)]:specs:'
    '--prompt-suggestions[ເປີດໃຊ້ຄຳແນະນຳການກະຕຸ້ນ (ສົ່ງການກະຕຸ້ນຖັດໄປທີ່ຄາດການໃນໂໝດ print/SDK)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[ສົ່ງຕໍ່ຂໍ້ຄວາມ subagent ແລະບລັອກການຄິດເປັນຂໍ້ຄວາມ (ກັບ --print ແລະ stream-json)]'
    '--include-hook-events[ລວມເຫດການວົງຈອນຊີວິດ hook ທັງໝົດໃນສະຕຣີມຜົນໄດ້ຮັບ (ກັບ stream-json)]'
    '--exclude-dynamic-system-prompt-sections[ຍ້າຍສ່ວນຕໍ່ເຄື່ອງໄປໃສ່ຂໍ້ຄວາມຜູ້ໃຊ້ທຳອິດເພື່ອປັບປຸງການໃຊ້ຄືນ prompt-cache]'
    '--brief[ເປີດໃຊ້ເຄື່ອງມື SendUserMessage ສຳລັບການສື່ສານຈາກຕົວແທນຫາຜູ້ໃຊ້]'
    '--safe-mode[ເລີ່ມຕົ້ນໂດຍປິດການປັບແຕ່ງທັງໝົດ (ເປັນປະໂຫຍດສຳລັບການແກ້ໄຂການຕັ້ງຄ່າທີ່ເສຍຫາຍ)]'
    '--bare[ໂໝດຕໍ່າສຸດ: ຂ້າມ hooks, LSP, ການຊິງໂປລແກຼມເສີມ, ການລະບຸແຫຼ່ງ, auto-memory ແລະການຄົ້ນພົບ CLAUDE.md ອັດຕະໂນມັດ]'
    '--ax-screen-reader[ສະແດງຜົນໄດ້ຮັບທີ່ເປັນມິດກັບໂປລແກຼມອ່ານໜ້າຈໍ (ຂໍ້ຄວາມແບນ ບໍ່ມີຂອບຕົກແຕ່ງ ຫຼືພາບເຄື່ອນໄຫວ)]'
    '(-v --version)'{-v,--version}'[ອອກເລກເວີຊັນ]'
    '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳຄຳສັ່ງ]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude commands' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳຄຳສັ່ງ]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "no arguments"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:ເລີ່ມຕົ້ນເຊີບເວີ MCP ຂອງ Claude Code'
    'add:ເພີ່ມເຊີບເວີ MCP ໃສ່ Claude Code'
    'remove:ລຶບເຊີບເວີ MCP'
    'list:ສະແດງລາຍຊື່ເຊີບເວີ MCP ທີ່ກຳນົດຄ່າແລ້ວ'
    'get:ຮັບລາຍລະອຽດເຊີບເວີ MCP'
    'add-json:ເພີ່ມເຊີບເວີ MCP ດ້ວຍສະຕຣິງ JSON (stdio ຫຼື SSE)'
    'add-from-claude-desktop:ນຳເຂົ້າເຊີບເວີ MCP ຈາກ Claude Desktop (ພຽງແຕ່ Mac ແລະ WSL)'
    'reset-project-choices:ຕັ້ງຄ່າເຊີບເວີທີ່ມີຂອບເຂດໂຄງການ (.mcp.json) ທັງໝົດທີ່ອະນຸມັດ/ປະຕິເສດໃນໂຄງການນີ້ໃໝ່'
    'login:ຢືນຢັນຕົວຕົນກັບເຊີບເວີ MCP (HTTP, SSE ຫຼືຕົວເຊື່ອມ claude.ai)'
    'logout:ລ້າງຂໍ້ມູນຮັບຮອງ OAuth ທີ່ບັນທຶກໄວ້ສຳລັບເຊີບເວີ MCP'
    'help:ສະແດງຄຳແນະນຳ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp commands' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[ເປີດໃຊ້ໂໝດດີບັກ]' \
            '--verbose[ຂຽນທັບການຕັ້ງຄ່າໂໝດລາຍລະອຽດຈາກໄຟລ໌ການຕັ້ງຄ່າ]' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ຂອບເຂດການຕັ້ງຄ່າ (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[ປະເພດການຂົນສົ່ງ (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[ກຳນົດຕົວແປສະພາບແວດລ້ອມ (ຕົວຢ່າງ -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[ກຳນົດຫົວ WebSocket]:header:' \
            '--client-id[ID ໄຄລເອັນ OAuth ສຳລັບເຊີບເວີ HTTP/SSE]:clientId:' \
            '--client-secret[ຖາມຫາຄວາມລັບໄຄລເອັນ OAuth (ຫຼືຕັ້ງຕົວແປສະພາບແວດລ້ອມ MCP_CLIENT_SECRET)]' \
            '--callback-port[ພອດຄົງທີ່ສຳລັບ callback OAuth (ສຳລັບເຊີບເວີທີ່ຕ້ອງການ redirect URI ທີ່ລົງທະບຽນໄວ້ລ່ວງໜ້າ)]:port:' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ຂອບເຂດການຕັ້ງຄ່າ (local, user, project) - ລຶບຈາກຂອບເຂດທີ່ມີຢູ່ ຖ້າບໍ່ໄດ້ລະບຸ]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ຂອບເຂດການຕັ້ງຄ່າ (local, user, project)]:scope:(local user project)' \
            '--client-secret[ຖາມຫາຄວາມລັບໄຄລເອັນ OAuth (ຫຼືຕັ້ງຕົວແປສະພາບແວດລ້ອມ MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ຂອບເຂດການຕັ້ງຄ່າ (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]'
          ;;
        login)
          _arguments \
            '--no-browser[ພິມ URL ການອະນຸຍາດແທນການເປີດບຣາວເຊີ (ສຳລັບເຊສຊັນ SSH/headless)]' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:ກວດສອບໂປລແກຼມເສີມ ຫຼືລາຍການຂໍ້ມູນຕະຫຼາດ'
    'marketplace:ຈັດການຕະຫຼາດ Claude Code'
    'list:ສະແດງລາຍຊື່ໂປລແກຼມເສີມທີ່ຕິດຕັ້ງແລ້ວ'
    'details:ສະແດງລາຍການອົງປະກອບ ແລະຄ່າໃຊ້ຈ່າຍໂທເຄນທີ່ຄາດຄະເນສຳລັບໂປລແກຼມເສີມ'
    'configure:ສະແດງຕົວເລືອກຂອງໂປລແກຼມເສີມ ແລະອັນໃດທີ່ຍັງບໍ່ໄດ້ຕັ້ງ ຫຼືບັນທຶກຄ່າຈາກ stdin'
    'install:ຕິດຕັ້ງໂປລແກຼມເສີມຈາກຕະຫຼາດທີ່ມີ'
    'i:ຕິດຕັ້ງໂປລແກຼມເສີມຈາກຕະຫຼາດທີ່ມີ (ຮູບແບບສັ້ນຂອງ install)'
    'init:ສ້າງໂຄງໂປລແກຼມເສີມໃໝ່ (ໂຫລດອັດຕະໂນມັດໃນເຊສຊັນຖັດໄປ)'
    'new:ສ້າງໂຄງໂປລແກຼມເສີມໃໝ່ (ຊື່ອື່ນຂອງ init)'
    'uninstall:ຖອນການຕິດຕັ້ງໂປລແກຼມເສີມທີ່ຕິດຕັ້ງແລ້ວ'
    'remove:ຖອນການຕິດຕັ້ງໂປລແກຼມເສີມທີ່ຕິດຕັ້ງແລ້ວ (ຊື່ອື່ນຂອງ uninstall)'
    'enable:ເປີດໃຊ້ໂປລແກຼມເສີມທີ່ປິດໄວ້'
    'disable:ປິດໂປລແກຼມເສີມທີ່ເປີດໃຊ້ຢູ່'
    'update:ອັບເດດໂປລແກຼມເສີມໄປຫາເວີຊັນຫຼ້າສຸດ'
    'eval:ແລ່ນກໍລະນີປະເມີນຕໍ່ໂປລແກຼມເສີມ ແລະລາຍງານຜົນທີ່ໃຫ້ຄະແນນ'
    'prune:ລຶບ dependency ທີ່ຕິດຕັ້ງອັດຕະໂນມັດທີ່ບໍ່ຕ້ອງການອີກຕໍ່ໄປ'
    'autoremove:ລຶບ dependency ທີ່ຕິດຕັ້ງອັດຕະໂນມັດທີ່ບໍ່ຕ້ອງການອີກຕໍ່ໄປ (ຊື່ອື່ນຂອງ prune)'
    'tag:ສ້າງ git tag {name}--v{version} ສຳລັບການປ່ອຍໂປລແກຼມເສີມ'
    'test:ແລ່ນການທົດສອບຂອງ mod'
    'help:ສະແດງຄຳແນະນຳ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin commands' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[ຖືຄຳເຕືອນເປັນຂໍ້ຜິດພາດ (ລະຫັດອອກ 1)]' \
            '--json[ສະແດງລາຍງານການກວດສອບເປັນ JSON (ລະຫັດອອກຄືເກົ່າ)]' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ຂອບເຂດການຕິດຕັ້ງ]:scope:(user project local)' \
            '*--config[ຕັ້ງຕົວເລືອກ userConfig ທີ່ປະກາດໄວ້ໃນ manifest ຂອງໂປລແກຼມເສີມ (ສາມາດຊ້ຳໄດ້)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[ຍອມຮັບຄຳສັ່ງທີ່ຕະຫຼາດປະກາດໄວ້ທີ່ສະແດງຢູ່ ໂດຍບໍ່ມີການຖາມຢືນຢັນ]' \
            '--json[ພິມຜົນໄດ້ຮັບໜຶ່ງແຖວທີ່ເຄື່ອງອ່ານໄດ້ ແທນຂໍ້ຄວາມສຳລັບຄົນອ່ານ]' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ຂອບເຂດການຕິດຕັ້ງ]:scope:(user project local)' \
            '--keep-data[ຮັກສາໂຟນເດີຂໍ້ມູນຖາວອນຂອງໂປລແກຼມເສີມໄວ້]' \
            '--prune[ລຶບ dependency ທີ່ຕິດຕັ້ງອັດຕະໂນມັດທີ່ບໍ່ຕ້ອງການອີກຕໍ່ໄປນຳ]' \
            '(-y --yes)'{-y,--yes}'[ຂ້າມການຖາມຢືນຢັນຂອງ --prune]' \
            '--json[ພິມຜົນໄດ້ຮັບໜຶ່ງແຖວທີ່ເຄື່ອງອ່ານໄດ້ ແທນຂໍ້ຄວາມສຳລັບຄົນອ່ານ (ບໍ່ໃຊ້ກັບ --prune)]' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ຂອບເຂດການຕິດຕັ້ງ]:scope:(user project local)' \
            '--json[ພິມຜົນໄດ້ຮັບໜຶ່ງແຖວທີ່ເຄື່ອງອ່ານໄດ້ ແທນຂໍ້ຄວາມສຳລັບຄົນອ່ານ]' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[ປິດໂປລແກຼມເສີມທີ່ເປີດໃຊ້ຢູ່ທັງໝົດ]' \
            '(-s --scope)'{-s,--scope}'[ຂອບເຂດການຕິດຕັ້ງ]:scope:(user project local)' \
            '--json[ພິມຜົນໄດ້ຮັບໜຶ່ງແຖວທີ່ເຄື່ອງອ່ານໄດ້ ແທນຂໍ້ຄວາມສຳລັບຄົນອ່ານ]' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ຂອບເຂດການຕິດຕັ້ງ]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[ຍອມຮັບຄຳສັ່ງທີ່ຕະຫຼາດປະກາດໄວ້ທີ່ສະແດງຢູ່ ໂດຍບໍ່ມີການຖາມຢືນຢັນ]' \
            '--json[ພິມຜົນໄດ້ຮັບໜຶ່ງແຖວທີ່ເຄື່ອງອ່ານໄດ້ ແທນຂໍ້ຄວາມສຳລັບຄົນອ່ານ]' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[ສະແດງຜົນເປັນ JSON]' \
            '--available[ລວມໂປລແກຼມເສີມທີ່ມີຈາກຕະຫຼາດ (ຕ້ອງການ --json)]' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ລຶບສິ່ງທີ່ບໍ່ຕ້ອງການໃນຂອບເຂດ]:scope:(user project local)' \
            '--dry-run[ສະແດງລາຍການສິ່ງທີ່ຈະຖືກລຶບ ໂດຍບໍ່ລຶບ]' \
            '(-y --yes)'{-y,--yes}'[ຂ້າມການຖາມຢືນຢັນ]' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]'
          ;;
        configure)
          _arguments \
            '--json[ສະແດງຜົນເປັນ JSON]' \
            '--values-stdin[ອ່ານຄ່າຕົວເລືອກຈາກ stdin ເປັນອອບເຈັກ JSON ຂອງສະຕຣິງແຖວດຽວ; ຕົວເລືອກທີ່ບໍ່ໄດ້ລະບຸຈະຮັກສາຄ່າເດີມໄວ້]' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[ຄຳອະທິບາຍໃນ manifest]:text:' \
            '--author[ຊື່ຜູ້ຂຽນ (ຄ່າເລີ່ມຕົ້ນ: git config user.name)]:name:' \
            '--author-email[ອີເມວຜູ້ຂຽນ (ຄ່າເລີ່ມຕົ້ນ: git config user.email)]:email:' \
            '--with[ອົງປະກອບທີ່ຈະສ້າງໂຄງນຳ]:components:' \
            '(-f --force)'{-f,--force}'[ຂຽນທັບ .claude-plugin/ ທີ່ມີຢູ່ແລ້ວໃນເປົ້າໝາຍ]' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[ກັ່ນຕອງກໍລະນີດ້ວຍ glob ຂອງຊື່]:glob:' \
            '*--tag[ກັ່ນຕອງກໍລະນີດ້ວຍແທັກ (ສາມາດຊ້ຳໄດ້)]:tag:' \
            '--runs[ຂຽນທັບຈຳນວນການແລ່ນຕໍ່ກໍລະນີ (ຄ່າເລີ່ມຕົ້ນ: case.runs, ຖ້າບໍ່ມີແມ່ນ 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[ແລ່ນການແລ່ນຕົວແທນພ້ອມກັນໄດ້ສູງສຸດ n ຄັ້ງ (1-8; ຄ່າເລີ່ມຕົ້ນ 1)]:n:' \
            '--model[ຂຽນທັບຮູບແບບສຳລັບທຸກກໍລະນີ]:model:_claude_model_names' \
            '--judge-model[ຂຽນທັບຮູບແບບຂອງຕົວໃຫ້ຄະແນນ LLM (ຄ່າເລີ່ມຕົ້ນ: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[ເພດານຄ່າໃຊ້ຈ່າຍແບບເຂັ້ມງວດ; ຖ້າເຖິງຈະຍົກເລີກ ແລະລາຍງານຜົນບາງສ່ວນ (ລະຫັດອອກ 2)]:usd:' \
            '--output-dir[ໂຟນເດີສຳລັບ aggregate-result.json]:dir:_directories' \
            '--eval-dir[ຊື່ໂຟນເດີ (ພາຍໃຕ້ໂປລແກຼມເສີມ) ທີ່ເກັບກໍລະນີປະເມີນ]:dir:' \
            '--json[ພິມຜົນການແລ່ນທັງໝົດເປັນ JSON ໄປຫາ stdout ຫຼືຂຽນໃສ່ໄຟລ໌ .json ນີ້]::path:_files' \
            '--threshold[ອອກດ້ວຍລະຫັດອອກ 1 ຖ້າຄະແນນຂອງກໍລະນີໃດຕໍ່າກວ່າເກນນີ້ (ຄ່າເລີ່ມຕົ້ນ: 1.0)]:threshold:' \
            '*--allow-tools[ການອະນຸຍາດຈາກຜູ້ດຳເນີນການສຳລັບເຄື່ອງມືທີ່ຖືກຄວບຄຸມ (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[ແລ່ນ scaffold_script ຂອງແຕ່ລະກໍລະນີ (ແລ່ນ bash ທີ່ຜູ້ຂຽນສະໜອງໃນນາມຂອງທ່ານ; ປິດຕາມຄ່າເລີ່ມຕົ້ນ)]' \
            '(--scaffold)--no-scaffold[ຂ້າມ scaffold_script ຢ່າງຊັດເຈນ]' \
            '--trust-plugin[ຢືນຢັນວ່າທ່ານເຊື່ອຖືໂປລແກຼມເສີມນີ້ ແລະຊຸດການປະເມີນຂອງມັນ ໂດຍຂ້າມການຖາມຄວາມເຊື່ອຖືໃນການແລ່ນຄັ້ງທຳອິດ (ສຳລັບ CI)]' \
            '--ablation[ແລ່ນກຸ່ມປຽບທຽບພື້ນຖານທີ່ບໍ່ມີໂປລແກຼມເສີມ ແລະລາຍງານຄວາມແຕກຕ່າງຂອງຄະແນນ]:mode:(none with-without)' \
            '--mocks[ຕົວຈຳລອງແທນເຊີບເວີ MCP ຈາກ <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[ກັບ --mocks record: ເລີ່ມໂປຣເຊສເຊີບເວີ MCP ຕົວຈິງທີ່ບໍ່ມີຕົວຈຳລອງນຳ]' \
            '--keep-temp[ຮັກສາໂຟນເດີ scaffold ໄວ້ສຳລັບການດີບັກ]' \
            '--verbose[ບັນທຶກເຫດການ trace ຕໍ່ຂໍ້ຄວາມລົງໃນບັນທຶກດີບັກ]' \
            '--report[ຂຽນລາຍງານ HTML ແບບຄົບໃນຕົວໄປຫາເສັ້ນທາງນີ້ ແທນໂຟນເດີຜົນໄດ້ຮັບ]:path:_files' \
            '(--no-publish)--publish-report[ກຳນົດໃຫ້ເຜີຍແຜ່ລາຍງານໄປຫາ claude.ai ນຳ]' \
            '(--publish-report)--no-publish[ເກັບລາຍງານ HTML ໄວ້ໃນເຄື່ອງເທົ່ານັ້ນ; ຂ້າມການເຜີຍແຜ່ໄປຫາ claude.ai]' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[push tag ໄປຫາ --remote ຫຼັງຈາກສ້າງແລ້ວ]' \
            '--dry-run[ພິມສິ່ງທີ່ຈະຖືກໃສ່ tag ໂດຍບໍ່ສ້າງມັນ]' \
            '(-f --force)'{-f,--force}'[ຂ້າມການກວດສອບ working tree ທີ່ມີການປ່ຽນແປງ ແລະ tag ທີ່ມີຢູ່ແລ້ວ]' \
            '(-m --message)'{-m,--message}'[ຂໍ້ຄວາມໝາຍເຫດຂອງ tag (ໃຊ້ %s ສຳລັບເວີຊັນ)]:msg:' \
            '--remote[remote ທີ່ຈະ push ໄປກັບ --push]:name:' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:ເພີ່ມຕະຫຼາດຈາກ URL, ເສັ້ນທາງ ຫຼື repository GitHub'
    'list:ສະແດງລາຍຊື່ຕະຫຼາດທີ່ກຳນົດຄ່າແລ້ວ'
    'remove:ລຶບຕະຫຼາດທີ່ກຳນົດຄ່າແລ້ວ'
    'rm:ລຶບຕະຫຼາດທີ່ກຳນົດຄ່າແລ້ວ (ຊື່ອື່ນຂອງ remove)'
    'update:ອັບເດດຕະຫຼາດຈາກແຫຼ່ງ - ອັບເດດທັງໝົດຖ້າບໍ່ໄດ້ລະບຸຊື່'
    'help:ສະແດງຄຳແນະນຳ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace commands' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[ຈຳກັດການ checkout ໄວ້ສະເພາະໂຟນເດີທີ່ລະບຸຜ່ານ git sparse-checkout (ສຳລັບ monorepo)]:paths:' \
            '--scope[ບ່ອນທີ່ຈະປະກາດຕະຫຼາດ]:scope:(user project local)' \
            '--claudeai[ເພີ່ມຕະຫຼາດຊື່ນີ້ທີ່ claude.ai ໂຮສໃຫ້ທ່ານ]' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[ສະແດງຜົນເປັນ JSON]' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]'
          ;;
        remove|rm)
          _arguments \
            '--scope[ລຶບການປະກາດຕະຫຼາດອອກຈາກຂອບເຂດການຕັ້ງຄ່າສະເພາະ (ຖ້າບໍ່ລະບຸ ຈະລຶບອອກຈາກທຸກຂອບເຂດ)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[ບັງຄັບຕິດຕັ້ງເຖິງວ່າຈະຕິດຕັ້ງແລ້ວກໍຕາມ]' \
    '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳ]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[ໂຟນເດີເພີ່ມເຕີມເພື່ອອະນຸຍາດການເຂົ້າເຖິງເຄື່ອງມືໃນເຊສຊັນທີ່ຖືກສົ່ງໄປ]:directory:_directories' \
    '--agent[ຕົວແທນເລີ່ມຕົ້ນສຳລັບເຊສຊັນທີ່ຖືກສົ່ງຈາກມຸມມອງຕົວແທນ]:agent:_claude_agent_names' \
    '--all[ກັບ --json: ລວມເຊສຊັນພື້ນຫຼັງທີ່ສຳເລັດແລ້ວນຳ]' \
    '--allow-dangerously-skip-permissions[ເຮັດໃຫ້ໂໝດຂ້າມການອະນຸຍາດໃຊ້ໄດ້ກັບເຊສຊັນທີ່ຖືກສົ່ງໄປ]' \
    '--cwd[ສະແດງພຽງແຕ່ເຊສຊັນພື້ນຫຼັງທີ່ເລີ່ມພາຍໃຕ້ເສັ້ນທາງ]:path:_directories' \
    '--dangerously-skip-permissions[ຊື່ອື່ນສຳລັບ --permission-mode bypassPermissions]' \
    '--effort[ລະດັບຄວາມພະຍາຍາມເລີ່ມຕົ້ນສຳລັບເຊສຊັນທີ່ຖືກສົ່ງໄປ]:level:(low medium high xhigh max)' \
    '--json[ພິມເຊສຊັນທີ່ໃຊ້ງານຢູ່ເປັນ JSON array ແລະອອກ]' \
    '*--mcp-config[ການຕັ້ງຄ່າເຊີບເວີ MCP ທີ່ຈະນຳໃຊ້ກັບເຊສຊັນທີ່ຖືກສົ່ງໄປ]:config:' \
    '--model[ຮູບແບບເລີ່ມຕົ້ນສຳລັບເຊສຊັນທີ່ຖືກສົ່ງຈາກມຸມມອງຕົວແທນ]:model:_claude_model_names' \
    '--permission-mode[ໂໝດການອະນຸຍາດເລີ່ມຕົ້ນສຳລັບເຊສຊັນທີ່ຖືກສົ່ງໄປ]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[ໂຫລດໂປລແກຼມເສີມຈາກໂຟນເດີສຳລັບມຸມມອງຕົວແທນ ແລະເຊສຊັນທີ່ຖືກສົ່ງໄປ]:path:_directories' \
    '--setting-sources[ລາຍຊື່ແຫຼ່ງການຕັ້ງຄ່າທີ່ຈະໂຫລດ (ແຍກດ້ວຍເຄື່ອງໝາຍຈຸດຄໍາ: user, project, local)]:sources:' \
    '--settings[ໄຟລ໌ການຕັ້ງຄ່າ ຫຼືສະຕຣິງ JSON ທີ່ຈະນຳໃຊ້]:file-or-json:_files' \
    '--strict-mcp-config[ໃຊ້ພຽງແຕ່ເຊີບເວີ MCP ຈາກ --mcp-config ໃນເຊສຊັນທີ່ຖືກສົ່ງໄປ]' \
    '--restricted[ເລີ່ມເຊສຊັນທີ່ຖືກສົ່ງໄປໃນໂໝດຈຳກັດ]' \
    '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳຄຳສັ່ງ]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:ເຂົ້າສູ່ລະບົບບັນຊີ Anthropic ຂອງທ່ານ'
    'logout:ອອກຈາກລະບົບບັນຊີ Anthropic ຂອງທ່ານ'
    'status:ສະແດງສະຖານະການຢືນຢັນຕົວຕົນ'
    'help:ສະແດງຄຳແນະນຳ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳຄຳສັ່ງ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth commands' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[ຕື່ມທີ່ຢູ່ອີເມວລ່ວງໜ້າໃນໜ້າເຂົ້າສູ່ລະບົບ]:email:' \
            '--sso[ບັງຄັບໃຊ້ຂັ້ນຕອນການເຂົ້າສູ່ລະບົບ SSO]' \
            '(--claudeai)--console[ໃຊ້ Anthropic Console (ຄິດໄລ່ເງິນຕາມການໃຊ້ API) ແທນການສະໝັກໃຊ້ Claude]' \
            '(--console)--claudeai[ໃຊ້ການສະໝັກໃຊ້ Claude (ຄ່າເລີ່ມຕົ້ນ)]' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳຄຳສັ່ງ]'
          ;;
        status)
          _arguments \
            '(--text)--json[ສະແດງຜົນເປັນ JSON (ຄ່າເລີ່ມຕົ້ນ)]' \
            '(--json)--text[ສະແດງຜົນເປັນຂໍ້ຄວາມທີ່ຄົນອ່ານໄດ້]' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳຄຳສັ່ງ]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳຄຳສັ່ງ]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:ພິມການຕັ້ງຄ່າໂໝດອັດຕະໂນມັດທີ່ມີຜົນເປັນ JSON'
    'critique:ຮັບຄຳຕິຊົມຈາກ AI ກ່ຽວກັບກົດໂໝດອັດຕະໂນມັດທີ່ກຳນົດເອງຂອງທ່ານ'
    'defaults:ພິມກົດໂໝດອັດຕະໂນມັດເລີ່ມຕົ້ນເປັນ JSON'
    'reset:ຕັ້ງຄ່າໂໝດອັດຕະໂນມັດໃໝ່ໄປຫາຄ່າເລີ່ມຕົ້ນທີ່ມາກັບໂປລແກຼມ'
    'help:ສະແດງຄຳແນະນຳ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳຄຳສັ່ງ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode commands' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[ຂຽນທັບຮູບແບບທີ່ຈະໃຊ້]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳຄຳສັ່ງ]'
          ;;
        defaults)
          _arguments \
            '--label[ສະແດງພຽງແຕ່ກົດທີ່ປ້າຍກຳກັບເລີ່ມຕົ້ນດ້ວຍຄຳນຳໜ້ານີ້ (ບໍ່ແຍກຕົວພິມໃຫຍ່-ນ້ອຍ)]:prefix:' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳຄຳສັ່ງ]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[ຂ້າມການຖາມຢືນຢັນ]' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳຄຳສັ່ງ]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳຄຳສັ່ງ]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[ເສັ້ນທາງໄປຫາການຕັ້ງຄ່າ YAML ຂອງເກດເວທ໌]:path:_files' \
    '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳຄຳສັ່ງ]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:ລຶບສະຖານະ Claude Code ທັງໝົດສຳລັບໂຄງການ (ບົດບັນທຶກ, ໜ້າວຽກ, ປະຫວັດໄຟລ໌, ລາຍການຕັ້ງຄ່າ)'
    'help:ສະແດງຄຳແນະນຳ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳຄຳສັ່ງ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project commands' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[ສະແດງລາຍການສິ່ງທີ່ຈະຖືກລຶບ ໂດຍບໍ່ລຶບຫຍັງເລີຍ]' \
            '(-y --yes)'{-y,--yes}'[ຂ້າມການຖາມຢືນຢັນ]' \
            '(-i --interactive)'{-i,--interactive}'[ຖາມຢືນຢັນແຕ່ລະລາຍການກ່ອນລຶບ]' \
            '(1)--all[ລຶບສະຖານະຂອງທຸກໂຄງການ (ໃຊ້ຮ່ວມກັບເສັ້ນທາງບໍ່ໄດ້)]' \
            '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳຄຳສັ່ງ]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[ພິມ payload bugs.json ດິບ ແທນທີ່ຈະເປັນຜົນການຄົ້ນພົບທີ່ຈັດຮູບແບບແລ້ວ]' \
    '--timeout[ນາທີສູງສຸດທີ່ຈະລໍຖ້າໃຫ້ການກວດສອບສຳເລັດ (ຄ່າເລີ່ມຕົ້ນ: 45)]:minutes:' \
    '(--no-post)--post[ໂພສຜົນການຄົ້ນພົບຂອງການກວດສອບທີ່ສຳເລັດແລ້ວໄປຫາ PR ໃນນາມຂອງທ່ານ (ສະເພາະເປົ້າໝາຍ PR; ເປັນຄຳເຫັນທຳມະດາອັນດຽວ ບໍ່ແມ່ນ review)]' \
    '(--post)--no-post[ບໍ່ໂພສຜົນການຄົ້ນພົບໄປຫາ PR (ຄ່າເລີ່ມຕົ້ນ)]' \
    '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳຄຳສັ່ງ]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[ເລີ່ມເຊສຊັນພື້ນຫຼັງທີ່ກຳລັງແລ່ນຢູ່ທັງໝົດໃໝ່]' \
    '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳຄຳສັ່ງ]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[ຖິ້ມ commit ທີ່ຍັງບໍ່ໄດ້ push ແລະການປ່ຽນແປງທີ່ຍັງບໍ່ໄດ້ commit ຂອງ worktree ນຳ (ສົ່ງ commit@worktree-id ທີ່ claude rm ຄັ້ງກ່ອນລາຍງານ)]:commit@worktree-id:' \
    '--force-remove-worktree[ລຶບໂຟນເດີ worktree ເຖິງວ່າ hook WorktreeRemove ຫຼື git ລຶບມັນບໍ່ໄດ້ກໍຕາມ (ສົ່ງ worktree-id ທີ່ claude rm ຄັ້ງກ່ອນລາຍງານ)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳຄຳສັ່ງ]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[ສະແດງສິ່ງທີ່ຈະຖືກນຳເຂົ້າ ໂດຍບໍ່ຂຽນຫຍັງເລີຍ]' \
    '--yes[ຂ້າມຕົວເລືອກແບບໂຕ້ຕອບ (ໃນສະພາບແວດລ້ອມ headless ໃຫ້ສົ່ງ --yes=<digest> ຈາກການເບິ່ງຕົວຢ່າງ /import)]' \
    '(-h --help)'{-h,--help}'[ສະແດງຄຳແນະນຳຄຳສັ່ງ]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
