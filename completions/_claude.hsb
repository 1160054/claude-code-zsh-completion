#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Konfiguruj a rjaduj MCP-serwery'
    'plugin:Rjaduj tykački Claude Code'
    'agents:Rjaduj pozadkowe agenty'
    'attach:Wotewri pozadkowe posedźenje w tutym terminalu'
    'logs:Wudaj najnowše terminalowe wudaće pozadkoweho posedźenja'
    'stop:Zastaj pozadkowe posedźenje (jeho rozmołwa wostanje)'
    'respawn:Startuj pozadkowe posedźenje znowa, zo by aktualnu wersiju Claude Code wužiwało'
    'rm:Zhaš pozadkowe posedźenje a jeho worktree, hdyž je to wěste'
    'auth:Rjaduj awtentifikaciju'
    'auto-mode:Přepruwuj abo wróć konfiguraciju klasifikatora awtomatiskeho modusa'
    'gateway:Startuj předewzaćowu bránu za awtentifikaciju/telemetriju'
    'import:Importuj konfiguraciju z druheho AI-programowanskeho agenta do Claude Code'
    'project:Rjaduj staw projekta Claude Code'
    'ultrareview:Přewjedź w cloudźe hostowanu multi-agentowu kontrolu koda a wudaj wuslědki'
    'setup-token:Nastaj dołhodobny awtentifikaciski token (trjeba abonement Claude)'
    'doctor:Přepruwowanje strowoty za awto-aktualizator Claude Code'
    'update:Přepytaj a instaluj aktualizacije'
    'install:Instaluj natiwnu wersiju Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Zmóžni debug-modus z opcionalnym filtrowanjom kategorijow (na př. "api,hooks" abo "!statsig,!file")]:filter:'
    '--verbose[Přepiš nastajenje wobšěrneho modusa z konfiguraciskeje dataje]'
    '(-p --print)'{-p,--print}'[Wudaj wotmołwu a skónč (za wužiwanje z pipes). Kedźbu: wužij jenož w dowěryhódnych zapiskach]'
    '--output-format[Format wudaća (z --print): "text" (standard), "json" (jednotliwy wuslědk) abo "stream-json" (streaming w realnym času)]:format:(text json stream-json)'
    '--json-schema[JSON-šema za walidaciju strukturowaneho wudaća]:schema:'
    '--include-partial-messages[Zapřijmi dźělne kruchi zdźělenkow, hdyž dochadźeja (z --print a --output-format=stream-json)]'
    '--input-format[Format zapodaća (z --print): "text" (standard) abo "stream-json" (streaming-zapodaće w realnym času)]:format:(text stream-json)'
    '--mcp-debug[\[Zastarjene. Wužij město toho --debug\] Zmóžni MCP-debug-modus (pokazuje zmylki MCP-serwera)]'
    '--dangerously-skip-permissions[Wobydź wšě přepruwowanja dowolnosćow. Poručene jenož za sandboxy bjez přistupa k internetej]'
    '--allow-dangerously-skip-permissions[Zmóžni opciju za wobeńdźenje přepruwowanjow dowolnosćow, bjez toho zo by so standardnje zmóžniło]'
    '--restricted[Wobmjezowany modus: wotstroń nastroje, kotrež přikazy abo kod wuwjedu, a WebFetch, ignoruj nastajenja user/project/local a wobmjezuj datajowe nastroje na dźěłowe zapiski]'
    '--max-budget-usd[Maksimalna suma dolarow za wudaće za API-naprašowanja (jenož --print)]:amount:'
    '--replay-user-messages[Znowa pósćel wužiwarske zdźělenki ze stdin na stdout za wobkrućenje]'
    '--allowed-tools[Z komu abo mjezotu dźělena lisćina dowolenych mjenow nastrojow (na př. "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Z komu abo mjezotu dźělena lisćina dowolenych mjenow nastrojow (format camelCase)]:tools:'
    '--tools[Podaj lisćinu k dispoziciji stejacych nastrojow ze zatwarjeneje sadźby. Jenož ćišćerski modus]:tools:'
    '--disallowed-tools[Z komu abo mjezotu dźělena lisćina njedowolenych mjenow nastrojow (na př. "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Z komu abo mjezotu dźělena lisćina njedowolenych mjenow nastrojow (format camelCase)]:tools:'
    '--mcp-config[Začitaj MCP-serwery z JSON-dataje abo znamješkoweho rjećazka (z mjezotu dźělene)]:configs:'
    '--system-prompt[Systemowy prompt za wužiwanje w posedźenju]:prompt:'
    '--system-prompt-file[Čitaj systemowy prompt z dataje]:file:_files'
    '--append-system-prompt[Připowěsni systemowy prompt k standardnemu systemowemu promptej]:prompt:'
    '--append-system-prompt-file[Čitaj systemowy prompt z dataje a připowěsni jón k standardnemu systemowemu promptej]:file:_files'
    '--system-prompt-snapshot[Zapisaj systemowy prompt jónu na rozmołwu a wužij jón doslownje při kóždym naprašowanju a pokročowanju (on, standard) abo rendruj jón při kóždym naprašowanju znowa (off)]:mode:(on off)'
    '--permission-mode[Modus dowolnosćow za wužiwanje w posedźenju]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Štó wotmołwja na naprašowanja dowolnosćow z --print: "host" (SDK-host abo --permission-prompt-tool) abo "none" (wšitko, štož by so naprašowało, so wotpokaza)]:target:(host none)'
    '--permission-prompt-tool[MCP-nastroj za naprašowanja dowolnosćow (jenož --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Pokročuj z najnowšej rozmołwu]'
    '(-r --resume)'{-r,--resume}'[Pokročuj z rozmołwu - podaj ID posedźenja abo wubjer interaktiwnje]:sessionId:_claude_sessions'
    '--fork-session[Wutwori nowe ID posedźenja město znowawužiwanja originalneho ID posedźenja při pokročowanju (z --resume abo --continue)]'
    '--no-session-persistence[Znjemóžni persistencu posedźenja - posedźenja so njeskładuja (jenož --print)]'
    '--model[Model za aktualne posedźenje. Podaj alias za najnowši model (na př. '\''sonnet'\'' abo '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agent za aktualne posedźenje. Přepisuje nastajenje '\''agent'\'']:agent:_claude_agent_names'
    '--betas[Beta-hłowki za zapřijeće do API-naprašowanjow (jenož wužiwarjo API-kluča)]:betas:'
    '--fallback-model[Zmóžni awtomatiske přeńdźenje na podaty model, hdyž je standardny model přećeženy (jenož --print)]:model:_claude_model_names'
    '--settings[Šćežka k JSON-dataji nastajenjow abo JSON-znamješkowemu rjećazkej za začitanje přidatnych nastajenjow]:file-or-json:_files'
    '--add-dir[Přidatne zapiski, kotrymž so přistup nastrojow dowoli]:directories:_directories'
    '--ide[Awtomatiske zwjazanje z IDE při startowanju, jeli je runje jedne płaćiwe IDE k dispoziciji]'
    '--desktop[Wotewri w aplikaciji Claude Desktop město w terminalu (z --continue abo --resume <id> za wuběranje posedźenja)]'
    '--strict-mcp-config[Wužij jenož MCP-serwery z --mcp-config a ignoruj wšě druhe MCP-nastajenja]'
    '--session-id[Specifiske ID posedźenja za wužiwanje w rozmołwje (dyrbi płaćiwy UUID być)]:uuid:'
    '--agents[JSON-objekt, kotryž definuje swójske agenty]:json:'
    '--setting-sources[Z komu dźělena lisćina žórłow nastajenjow za začitanje (user, project, local)]:sources:'
    '--plugin-dir[Zapis, z kotrehož so tykački jenož za tute posedźenje začitaja (wospjetujomny)]:paths:_directories'
    '--disable-slash-commands[Znjemóžni wšě slash-přikazy]'
    '(--bg --background)'{--bg,--background}'[Startuj posedźenje jako pozadkowy agent a wróć so hnydom]'
    '(-w --worktree)'{-w,--worktree}'[Wutwori nowy git-worktree za tute posedźenje (opcionalnje podaj mjeno)]::name:'
    '--tmux=-[Wutwori tmux-posedźenje za worktree (trjeba --worktree). Wužiwa natiwne dźělne wokna iTerm2, hdyž su k dispoziciji; --tmux=classic za tradicionelny tmux]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Nastaj pokazowanske mjeno za tute posedźenje]:name:'
    '--effort[Runina prócowanja za aktualne posedźenje]:level:(low medium high xhigh max)'
    '--autocompact[Wulkosć wokna za awtomatiske zhusćenje (auto abo 100k-1M tokenow)]:size:(auto)'
    '--debug-file[Pisaj debug-protokole do specifiskeje šćežki dataje (zmóžnja implicitnje debug-modus)]:path:_files'
    '--from-pr[Pokročuj z posedźenjom zwjazanym z PR přez čisło/URL, abo wotewri interaktiwny wuběrak]::value:'
    '--teleport[Pokročuj z teleport-posedźenjom, opcionalnje podaj ID posedźenja]::session:'
    '--cloud[Wutwori posedźenje w cloudźe z podatym wopisanjom abo zwjaž so z eksistowacym přez ID posedźenja abo URL claude.ai/code]::description-or-session:'
    '--environment[Wutwori nowe posedźenje w cloudźe, kotrež běži w podatej samohostowanej wokolinje (ccpool_...)]:environment_id:'
    '--remote-control[Startuj interaktiwne posedźenje ze zmóžnjenym Remote Control (opcionalnje z mjenom)]::name:'
    '--remote-control-session-name-prefix[Prefiks za awtomatisce generowane mjena posedźenjow Remote Control]:prefix:'
    '--chrome[Zmóžni integraciju Claude w Chrome]'
    '--no-chrome[Znjemóžni integraciju Claude w Chrome]'
    '--plugin-url[Wobstaraj tykačk .zip z URL jenož za tute posedźenje (wospjetujomny)]:url:'
    '--file[Datajowe resursy za sćehnjenje při startowanju (format: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Zmóžni namjety promptow (wudawa předpowědany přichodny prompt w modusu print/SDK)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Sposrědkuj tekst a myslenske bloki podagenta jako zdźělenki (z --print a stream-json)]'
    '--include-hook-events[Zapřijmi wšě podawki žiwjenskeho cyklusa hooks do wudawanskeho streama (z stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Přesuń mašinsce specifiske wotrězki do prěnjeje wužiwarskeje zdźělenki, zo by so znowawužiwanje prompt-cache polěpšiło]'
    '--brief[Zmóžni nastroj SendUserMessage za komunikaciju wot agenta k wužiwarjej]'
    '--safe-mode[Startuj ze wšěmi přiměrjenjemi znjemóžnjenymi (wužitne za rozrisowanje problemow z pokazanej konfiguraciju)]'
    '--bare[Minimalny modus: přeskoč hooks, LSP, synchronizaciju tykačkow, attribuciju, awto-pomjatk a awtomatiske wotkryće CLAUDE.md]'
    '--ax-screen-reader[Pokaž wudaće přijomne za čitak wobrazowki (płony tekst, bjez dekoratiwnych ramikow abo animacijow)]'
    '(-v --version)'{-v,--version}'[Wudaj čisło wersije]'
    '(-h --help)'{-h,--help}'[Pokazaj pomoc za přikaz]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude přikazy' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc za přikaz]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "žane argumenty"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Startuj MCP-serwer Claude Code'
    'add:Přidaj MCP-serwer k Claude Code'
    'remove:Wotstroń MCP-serwer'
    'list:Nalistuj konfigurowane MCP-serwery'
    'get:Wobstaraj podrobnosće MCP-serwera'
    'add-json:Přidaj MCP-serwer (stdio abo SSE) z JSON-znamješkowym rjećazkom'
    'add-from-claude-desktop:Importuj MCP-serwery z Claude Desktop (jenož Mac a WSL)'
    'reset-project-choices:Wróć wšě schwalene/wotpokazane serwery na runinje projekta (.mcp.json) w tutym projekće'
    'login:Awtentifikuj so z MCP-serwerom (HTTP, SSE abo konektor claude.ai)'
    'logout:Zhaš składowane OAuth-přizjewjenske daty za MCP-serwer'
    'help:Pokazaj pomoc'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp přikazy' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Zmóžni debug-modus]' \
            '--verbose[Přepiš nastajenje wobšěrneho modusa z konfiguraciskeje dataje]' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfiguraciski wobłuk (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Typ transporta (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Nastaj wokolinowu wariablu (na př. -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Nastaj WebSocket-hłowku]:header:' \
            '--client-id[ID OAuth-klienta za HTTP/SSE-serwery]:clientId:' \
            '--client-secret[Prašej so za potajnstwom OAuth-klienta (abo nastaj wokolinowu wariablu MCP_CLIENT_SECRET)]' \
            '--callback-port[Kruty port za OAuth-callback (za serwery, kotrež trjebaja dopředka registrowane redirect-URI)]:port:' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfiguraciski wobłuk (local, user, project) - wotstroń z eksistowaceho wobłuka, jeli njepodaty]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfiguraciski wobłuk (local, user, project)]:scope:(local user project)' \
            '--client-secret[Prašej so za potajnstwom OAuth-klienta (abo nastaj wokolinowu wariablu MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfiguraciski wobłuk (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]'
          ;;
        login)
          _arguments \
            '--no-browser[Wudaj awtorizaciski URL město wočinjenja wobhladowaka (za SSH/headless-posedźenja)]' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Waliduj manifest tykačka abo torhošća'
    'marketplace:Rjaduj torhošća Claude Code'
    'list:Nalistuj instalowane tykački'
    'details:Pokaž inwentar komponentow a projektowane kóšty tokenow za tykačk'
    'configure:Pokaž opcije tykačka a kotre njejsu nastajene, abo składuj hódnoty ze stdin'
    'install:Instaluj tykačk z k dispoziciji stejacych torhošćow'
    'i:Instaluj tykačk z k dispoziciji stejacych torhošćow (skrótšenka za install)'
    'init:Nastaj kostrik noweho tykačka (začituje so awtomatisce w přichodnym posedźenju)'
    'new:Nastaj kostrik noweho tykačka (alias za init)'
    'uninstall:Deinstaluj instalowany tykačk'
    'remove:Deinstaluj instalowany tykačk (alias za uninstall)'
    'enable:Zmóžni znjemóžnjeny tykačk'
    'disable:Znjemóžni zmóžnjeny tykačk'
    'update:Aktualizuj tykačk na najnowšu wersiju'
    'eval:Přewjedź ewaluaciske pady přećiwo tykačkej a rozprawjaj hódnoćene wuslědki'
    'prune:Wotstroń awtomatisce instalowane zawisnosće, kotrež hižo trěbne njejsu'
    'autoremove:Wotstroń awtomatisce instalowane zawisnosće, kotrež hižo trěbne njejsu (alias za prune)'
    'tag:Wutwori git-tag {name}--v{version} za wozjewjenje tykačka'
    'test:Přewjedź testy moda'
    'help:Pokazaj pomoc'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'tykačk přikazy' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Wobchadźej z warnowanjemi kaž ze zmylkami (wustupny kod 1)]' \
            '--json[Wudaj walidacisku rozprawu jako JSON (samsne wustupne kody)]' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Wobłuk instalacije]:scope:(user project local)' \
            '*--config[Nastaj opciju userConfig deklarowanu w manifesće tykačka (wospjetujomny)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Akceptuj pokazany přikaz deklarowany wot torhošća bjez wobkrućenskeho naprašowanja]' \
            '--json[Wudaj jednu mašinsce čitajomnu wuslědkowu linku město zdźělenki za ludźi]' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Wobłuk instalacije]:scope:(user project local)' \
            '--keep-data[Wobchowaj zapis trajnych datow tykačka]' \
            '--prune[Wotstroń tež awtomatisce instalowane zawisnosće, kotrež hižo trěbne njejsu]' \
            '(-y --yes)'{-y,--yes}'[Přeskoč wobkrućenske naprašowanje za --prune]' \
            '--json[Wudaj jednu mašinsce čitajomnu wuslědkowu linku město zdźělenki za ludźi (nic z --prune)]' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Wobłuk instalacije]:scope:(user project local)' \
            '--json[Wudaj jednu mašinsce čitajomnu wuslědkowu linku město zdźělenki za ludźi]' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Znjemóžni wšě zmóžnjene tykački]' \
            '(-s --scope)'{-s,--scope}'[Wobłuk instalacije]:scope:(user project local)' \
            '--json[Wudaj jednu mašinsce čitajomnu wuslědkowu linku město zdźělenki za ludźi]' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Wobłuk instalacije]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Akceptuj pokazany přikaz deklarowany wot torhošća bjez wobkrućenskeho naprašowanja]' \
            '--json[Wudaj jednu mašinsce čitajomnu wuslědkowu linku město zdźělenki za ludźi]' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Wudaj jako JSON]' \
            '--available[Zapřijmi k dispoziciji stejace tykački z torhošćow (trjeba --json)]' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Wotstroń we wobłuku]:scope:(user project local)' \
            '--dry-run[Nalistuj, štož by so wotstroniło, bjez wotstronjenja]' \
            '(-y --yes)'{-y,--yes}'[Přeskoč wobkrućenske naprašowanje]' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]'
          ;;
        configure)
          _arguments \
            '--json[Wudaj jako JSON]' \
            '--values-stdin[Čitaj hódnoty opcijow ze stdin jako JSON-objekt z jednolinkowymi znamješkowymi rjećazkami; wuwostajene opcije wobchowaja swoje hódnoty]' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Wopisanje manifesta]:text:' \
            '--author[Mjeno awtora (standard: git config user.name)]:name:' \
            '--author-email[E-mail awtora (standard: git config user.email)]:email:' \
            '--with[Komponenty, za kotrež so ma tež kostrik nastajić]:components:' \
            '(-f --force)'{-f,--force}'[Přepisaj eksistowacy .claude-plugin/ w cilu]' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Filtruj pady po glob-mustrje mjena]:glob:' \
            '*--tag[Filtruj pady po tagu (wospjetujomny)]:tag:' \
            '--runs[Přepiš ličbu běhow na pad (standard: case.runs, hewak 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Přewjedź hač do n běhow agenta naraz (1-8; standard 1)]:n:' \
            '--model[Přepiš model za wšě pady]:model:_claude_model_names' \
            '--judge-model[Přepiš model LLM-hódnoćerja (standard: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Kruta hranica kóštow; přetorhń a rozprawjaj dźělne wuslědki, hdyž so docpěje (wustupny kod 2)]:usd:' \
            '--output-dir[Zapis za aggregate-result.json]:dir:_directories' \
            '--eval-dir[Mjeno zapisa (pod tykačkom), kotryž ewaluaciske pady wobsahuje]:dir:' \
            '--json[Wudaj dospołny wuslědk běha jako JSON na stdout abo pisaj jón do tuteje .json-dataje]::path:_files' \
            '--threshold[Skónč z wustupnym kodom 1, jeli ma někajki pad hódnoćenje pod tutej hranicu (standard: 1.0)]:threshold:' \
            '*--allow-tools[Dowolnosć operatora za wobmjezowane nastroje (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Přewjedź scaffold_script kóždeho pada (wuwjedźe wot awtora dodaty bash pod twojim mjenom; standardnje znjemóžnjene)]' \
            '(--scaffold)--no-scaffold[Přeskoč scaffold_script explicitnje]' \
            '--trust-plugin[Wobkruć, zo tutomu tykačkej a jeho ewaluaciskej sadźbje dowěriš, a přeskoč dowěrowe naprašowanje při prěnim startowanju (za CI)]' \
            '--ablation[Přewjedź přirunowansku kontrolnu skupinu bjez tykačka a rozprawjaj rozdźěl hódnoćenja]:mode:(none with-without)' \
            '--mocks[Mock-zastupnicy za MCP-serwery, z <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Z --mocks record: startuj tež procesy woprawdźitych MCP-serwerow, kotrež žadyn mock nimaja]' \
            '--keep-temp[Wobchowaj scaffold-zapiski za pytanje zmylkow]' \
            '--verbose[Protokoluj podawki slědowanja za kóždu zdźělenku do debug-protokola]' \
            '--report[Pisaj samostatnu HTML-rozprawu na tutu šćežku město do zapisa wuslědkow]:path:_files' \
            '(--no-publish)--publish-report[Žadaj tež wozjewjenje rozprawy na claude.ai]' \
            '(--publish-report)--no-publish[Wobchowaj HTML-rozprawu jenož lokalnje; přeskoč jeje wozjewjenje na claude.ai]' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Pósćel tag na --remote po jeho wutworjenju]' \
            '--dry-run[Wudaj, štož by so tagowało, bjez wutworjenja taga]' \
            '(-f --force)'{-f,--force}'[Přeskoč kontrole njerjaneho dźěłoweho štoma a hižo eksistowaceho taga]' \
            '(-m --message)'{-m,--message}'[Zdźělenka anotacije taga (wužij %s za wersiju)]:msg:' \
            '--remote[Remote za pósłanje z --push]:name:' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Přidaj torhošćo z URL, šćežki abo repozitorija GitHub'
    'list:Nalistuj konfigurowane torhošća'
    'remove:Wotstroń konfigurowane torhošćo'
    'rm:Wotstroń konfigurowane torhošćo (alias za remove)'
    'update:Aktualizuj torhošćo ze žórła - aktualizuj wšě, jeli žane mjeno podate'
    'help:Pokazaj pomoc'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'wiki přikazy' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Wobmjezuj checkout na wěste zapiski přez git sparse-checkout (za monorepozitorije)]:paths:' \
            '--scope[Hdźe so ma torhošćo deklarować]:scope:(user project local)' \
            '--claudeai[Přidaj torhošćo z tutym mjenom, kotrež claude.ai za tebje hostuje]' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Wudaj jako JSON]' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Wotstroń deklaraciju torhošća z wěsteho wobłuka nastajenjow (wuwostaj, zo by so z kóždeho wobłuka wotstroniła)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Wunuć instalaciju, samo hdyž je hižo instalowane]' \
    '(-h --help)'{-h,--help}'[Pokazaj pomoc]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Přidatny zapis, kotremuž so přistup nastrojow w wotpósłanych posedźenjach dowoli]:directory:_directories' \
    '--agent[Standardny agent za posedźenja wotpósłane z napohlada agentow]:agent:_claude_agent_names' \
    '--all[Z --json: zapřijmi tež dokónčene pozadkowe posedźenja]' \
    '--allow-dangerously-skip-permissions[Sčiń modus wobeńdźenja dowolnosćow k dispoziciji za wotpósłane posedźenja]' \
    '--cwd[Pokaž jenož pozadkowe posedźenja startowane pod šćežku]:path:_directories' \
    '--dangerously-skip-permissions[Alias za --permission-mode bypassPermissions]' \
    '--effort[Standardna runina prócowanja za wotpósłane posedźenja]:level:(low medium high xhigh max)' \
    '--json[Wudaj aktiwne posedźenja jako JSON-pólo a skónč]' \
    '*--mcp-config[Konfiguracija MCP-serwera za nałoženje na wotpósłane posedźenja]:config:' \
    '--model[Standardny model za posedźenja wotpósłane z napohlada agentow]:model:_claude_model_names' \
    '--permission-mode[Standardny modus dowolnosćow za wotpósłane posedźenja]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Začitaj tykački ze zapisa za napohlad agentow a wotpósłane posedźenja]:path:_directories' \
    '--setting-sources[Z komu dźělena lisćina žórłow nastajenjow za začitanje (user, project, local)]:sources:' \
    '--settings[Dataja nastajenjow abo JSON-znamješkowy rjećazk za nałoženje]:file-or-json:_files' \
    '--strict-mcp-config[Wužij jenož MCP-serwery z --mcp-config we wotpósłanych posedźenjach]' \
    '--restricted[Startuj wotpósłane posedźenja we wobmjezowanym modusu]' \
    '(-h --help)'{-h,--help}'[Pokazaj pomoc za přikaz]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Přizjew so pola swojeho konta Anthropic'
    'logout:Wotzjew so ze swojeho konta Anthropic'
    'status:Pokaž staw awtentifikacije'
    'help:Pokazaj pomoc'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Pokazaj pomoc za přikaz]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth přikazy' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Wupjelń e-mailowu adresu dopředka na přizjewjenskej stronje]:email:' \
            '--sso[Wunuć přizjewjenski tok SSO]' \
            '(--claudeai)--console[Wužij Anthropic Console (wotličenje po wužiwanju API) město abonementa Claude]' \
            '(--console)--claudeai[Wužij abonement Claude (standard)]' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc za přikaz]'
          ;;
        status)
          _arguments \
            '(--text)--json[Wudaj jako JSON (standard)]' \
            '(--json)--text[Wudaj jako tekst čitajomny za ludźi]' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc za přikaz]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc za přikaz]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Wudaj efektiwnu konfiguraciju awtomatiskeho modusa jako JSON'
    'critique:Wobstaraj AI-přispomnjenja k swojim swójskim prawidłam awtomatiskeho modusa'
    'defaults:Wudaj standardne prawidła awtomatiskeho modusa jako JSON'
    'reset:Wróć konfiguraciju awtomatiskeho modusa na dodate standardy'
    'help:Pokazaj pomoc'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Pokazaj pomoc za přikaz]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode přikazy' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Přepiš, kotry model so wužiwa]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc za přikaz]'
          ;;
        defaults)
          _arguments \
            '--label[Pokaž jenož prawidła, kotrychž etiketa so z tutym prefiksom započina (njedźiwajo na wulke a małe pismiki)]:prefix:' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc za přikaz]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Přeskoč wobkrućenske naprašowanje]' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc za přikaz]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc za přikaz]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Šćežka k YAML-konfiguraciji brány]:path:_files' \
    '(-h --help)'{-h,--help}'[Pokazaj pomoc za přikaz]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Zhaš wšón staw Claude Code za projekt (transkripty, nadawki, historiju datajow, konfiguraciski zapisk)'
    'help:Pokazaj pomoc'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Pokazaj pomoc za přikaz]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project přikazy' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Nalistuj, štož by so zhašało, bjez toho zo by so něšto zhašało]' \
            '(-y --yes)'{-y,--yes}'[Přeskoč wobkrućenske naprašowanje]' \
            '(-i --interactive)'{-i,--interactive}'[Prašej so před zhašenjom kóždeho elementa]' \
            '(1)--all[Zhaš staw za kóždy projekt (njeda so ze šćežku kombinować)]' \
            '(-h --help)'{-h,--help}'[Pokazaj pomoc za přikaz]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Wudaj hruby payload bugs.json město formatowanych wuslědkow]' \
    '--timeout[Maksimalne minuty za čakanje na skónčenje kontrole (standard: 45)]:minutes:' \
    '(--no-post)--post[Pósćel zwěsćenja dokónčeneje kontrole pod twojim mjenom k PR (jenož za PR-cile; jedyn jednory komentar, nic kontrola)]' \
    '(--post)--no-post[Njepósćel zwěsćenja k PR (standard)]' \
    '(-h --help)'{-h,--help}'[Pokazaj pomoc za přikaz]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Startuj kóžde běžace pozadkowe posedźenje znowa]' \
    '(-h --help)'{-h,--help}'[Pokazaj pomoc za přikaz]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Zaćisń tež njepósłane commity a njekomitowane změny worktree (podaj commit@worktree-id, kotryž je předchadny claude rm rozprawił)]:commit@worktree-id:' \
    '--force-remove-worktree[Zhaš zapis worktree, samo hdyž jón hook WorktreeRemove abo git njeje móhł wotstronić (podaj worktree-id, kotryž je předchadny claude rm rozprawił)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Pokazaj pomoc za přikaz]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Pokaž, štož by so importowało, bjez pisanja]' \
    '--yes[Přeskoč interaktiwny wuběrak (na headless-powjerchach podaj --yes=<digest> z přehlada /import)]' \
    '(-h --help)'{-h,--help}'[Pokazaj pomoc za přikaz]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
