#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:កំណត់រចនាសម្ព័ន្ធនិងគ្រប់គ្រងម៉ាស៊ីនមេ MCP'
    'plugin:គ្រប់គ្រងកម្មវិធីជំនួយ Claude Code'
    'agents:គ្រប់គ្រងភ្នាក់ងារផ្ទៃខាងក្រោយ'
    'attach:បើកវគ្គផ្ទៃខាងក្រោយនៅក្នុងស្ថានីយនេះ'
    'logs:បោះពុម្ពលទ្ធផលស្ថានីយថ្មីៗនៃវគ្គផ្ទៃខាងក្រោយ'
    'stop:បញ្ឈប់វគ្គផ្ទៃខាងក្រោយ (ការសន្ទនារបស់វានៅតែត្រូវបានរក្សាទុក)'
    'respawn:ចាប់ផ្តើមវគ្គផ្ទៃខាងក្រោយឡើងវិញ ដើម្បីឱ្យវាដំណើរការកំណែ Claude Code បច្ចុប្បន្ន'
    'rm:លុបវគ្គផ្ទៃខាងក្រោយ និង worktree របស់វា នៅពេលដែលការធ្វើដូច្នោះមានសុវត្ថិភាព'
    'auth:គ្រប់គ្រងការផ្ទៀងផ្ទាត់'
    'auto-mode:ពិនិត្យ ឬកំណត់ឡើងវិញនូវការកំណត់រចនាសម្ព័ន្ធកម្មវិធីចាត់ថ្នាក់របៀបស្វ័យប្រវត្តិ'
    'gateway:ដំណើរការ gateway ផ្ទៀងផ្ទាត់/telemetry សហគ្រាស'
    'import:នាំចូលការកំណត់រចនាសម្ព័ន្ធពីភ្នាក់ងារសរសេរកូដ AI ផ្សេងទៀតចូលទៅក្នុង Claude Code'
    'project:គ្រប់គ្រងស្ថានភាពគម្រោង Claude Code'
    'ultrareview:ដំណើរការការត្រួតពិនិត្យកូដពហុភ្នាក់ងារដែលបង្ហោះលើ cloud ហើយបោះពុម្ពការរកឃើញ'
    'setup-token:កំណត់ថូខឹនផ្ទៀងផ្ទាត់រយៈពេលវែង (ត្រូវការការជាវ Claude)'
    'doctor:ពិនិត្យសុខភាពកម្មវិធីធ្វើបច្ចុប្បន្នភាពស្វ័យប្រវត្តិ Claude Code'
    'update:ពិនិត្យនិងដំឡើងបច្ចុប្បន្នភាព'
    'install:ដំឡើង Claude Code សំណង់ដើម'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[បើកដំណើរការរបៀបបំបាត់កំហុស ជាមួយការត្រងប្រភេទស្រេចចិត្ត (ឧ. "api,hooks" ឬ "!statsig,!file")]:filter:'
    '--verbose[បដិសេធការកំណត់របៀបលម្អិតពីឯកសារកំណត់រចនាសម្ព័ន្ធ]'
    '(-p --print)'{-p,--print}'[បោះពុម្ពការឆ្លើយតបហើយចេញ (សម្រាប់ប្រើជាមួយបំពង់)។ សំគាល់៖ ប្រើតែក្នុងថតដែលទុកចិត្តប៉ុណ្ណោះ]'
    '--output-format[ទម្រង់លទ្ធផល (ជាមួយ --print)៖ "text" (លំនាំដើម), "json" (លទ្ធផលតែមួយ) ឬ "stream-json" (ស្ទ្រីមពេលវេលាជាក់ស្តែង)]:format:(text json stream-json)'
    '--json-schema[ស្គីម JSON សម្រាប់ការផ្ទៀងផ្ទាត់លទ្ធផលដែលមានរចនាសម្ព័ន្ធ]:schema:'
    '--include-partial-messages[រួមបញ្ចូលផ្នែកសាររងៗ (ជាមួយ --print និង --output-format=stream-json)]'
    '--input-format[ទម្រង់បញ្ចូល (ជាមួយ --print)៖ "text" (លំនាំដើម) ឬ "stream-json" (ស្ទ្រីមបញ្ចូលពេលវេលាជាក់ស្តែង)]:format:(text stream-json)'
    '--mcp-debug[【ត្រូវបានបោះបង់ចោល។ សូមប្រើ --debug ជំនួសវិញ】 បើកដំណើរការរបៀបបំបាត់កំហុស MCP (បង្ហាញកំហុសម៉ាស៊ីនមេ MCP)]'
    '--dangerously-skip-permissions[រំលងការពិនិត្យសិទ្ធិទាំងអស់។ ផ្តល់អនុសាសន៍តែសម្រាប់ sandbox ដែលគ្មានការចូលប្រើអ៊ីនធឺណិតប៉ុណ្ណោះ]'
    '--allow-dangerously-skip-permissions[បើកជម្រើសរំលងការពិនិត្យសិទ្ធិ ប៉ុន្តែមិនបើកដំណើរការជាលំនាំដើមទេ]'
    '--restricted[របៀបដាក់កម្រិត៖ ដកចេញឧបករណ៍ដែលដំណើរការពាក្យបញ្ជា ឬកូដ និង WebFetch មិនអើពើនឹងការកំណត់ user/project/local ហើយកំណត់ឧបករណ៍ឯកសារឱ្យនៅតែក្នុងថតការងារប៉ុណ្ណោះ]'
    '--max-budget-usd[ចំនួនប្រាក់ដុល្លារអតិបរមាដែលត្រូវចំណាយលើការហៅ API (តែ --print ប៉ុណ្ណោះ)]:amount:'
    '--replay-user-messages[ផ្ញើសារអ្នកប្រើប្រាស់ម្តងទៀតពី stdin នៅលើ stdout សម្រាប់ការបញ្ជាក់]'
    '--allowed-tools[បញ្ជីឈ្មោះឧបករណ៍ដែលអនុញ្ញាត (ផ្តាច់ដោយសញ្ញាក្បៀស ឬដកឃ្លា ឧ. "Bash(git:*) Edit")]:tools:'
    '--allowedTools[បញ្ជីឈ្មោះឧបករណ៍ដែលអនុញ្ញាត (ទម្រង់ camelCase)]:tools:'
    '--tools[បញ្ជាក់បញ្ជីឧបករណ៍ដែលមានពីសំណុំដែលបង្កប់មក។ តែរបៀបបោះពុម្ពប៉ុណ្ណោះ]:tools:'
    '--disallowed-tools[បញ្ជីឈ្មោះឧបករណ៍ដែលមិនអនុញ្ញាត (ផ្តាច់ដោយសញ្ញាក្បៀស ឬដកឃ្លា ឧ. "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[បញ្ជីឈ្មោះឧបករណ៍ដែលមិនអនុញ្ញាត (ទម្រង់ camelCase)]:tools:'
    '--mcp-config[ផ្ទុកម៉ាស៊ីនមេ MCP ពីឯកសារ JSON ឬខ្សែអក្សរ (ផ្តាច់ដោយដកឃ្លា)]:configs:'
    '--system-prompt[ការជំរុញប្រព័ន្ធសម្រាប់វគ្គ]:prompt:'
    '--system-prompt-file[អានការជំរុញប្រព័ន្ធពីឯកសារ]:file:_files'
    '--append-system-prompt[បន្ថែមការជំរុញប្រព័ន្ធទៅការជំរុញប្រព័ន្ធលំនាំដើម]:prompt:'
    '--append-system-prompt-file[អានការជំរុញប្រព័ន្ធពីឯកសារ ហើយបន្ថែមទៅការជំរុញប្រព័ន្ធលំនាំដើម]:file:_files'
    '--system-prompt-snapshot[កត់ត្រាការជំរុញប្រព័ន្ធម្តងក្នុងមួយការសន្ទនា ហើយប្រើវាឡើងវិញដដែលៗពាក្យដោយពាក្យលើគ្រប់សំណើ និងការបន្ត (on ជាលំនាំដើម) ឬបង្កើតវាថ្មីរាល់សំណើ (off)]:mode:(on off)'
    '--permission-mode[របៀបសិទ្ធិសម្រាប់វគ្គ]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[អ្នកណាឆ្លើយការជំរុញសុំសិទ្ធិជាមួយ --print៖ "host" (ម៉ាស៊ីន SDK host ឬ --permission-prompt-tool) ឬ "none" (អ្វីៗដែលនឹងត្រូវសួរ ត្រូវបានបដិសេធ)]:target:(host none)'
    '--permission-prompt-tool[ឧបករណ៍ MCP ដែលត្រូវប្រើសម្រាប់ការជំរុញសុំសិទ្ធិ (តែ --print ប៉ុណ្ណោះ)]:tool:'
    '(-c --continue)'{-c,--continue}'[បន្តការសន្ទនាថ្មីបំផុត]'
    '(-r --resume)'{-r,--resume}'[បន្តការសន្ទនា - បញ្ជាក់លេខសម្គាល់វគ្គ ឬជ្រើសរើសតាមអន្តរកម្ម]:sessionId:_claude_sessions'
    '--fork-session[បង្កើតលេខសម្គាល់វគ្គថ្មីជំនួសឱ្យការប្រើលេខសម្គាល់វគ្គដើមឡើងវិញ នៅពេលបន្ត (ជាមួយ --resume ឬ --continue)]'
    '--no-session-persistence[បិទការរក្សាទុកវគ្គ - វគ្គនឹងមិនត្រូវបានរក្សាទុកទេ (តែ --print ប៉ុណ្ណោះ)]'
    '--model[គំរូសម្រាប់វគ្គបច្ចុប្បន្ន។ បញ្ជាក់ឈ្មោះក្លែងក្លាយសម្រាប់គំរូថ្មីបំផុត (ឧ. '\''sonnet'\'' ឬ '\''opus'\'')]:model:_claude_model_names'
    '--agent[ភ្នាក់ងារសម្រាប់វគ្គបច្ចុប្បន្ន។ បដិសេធការកំណត់ '\''agent'\'']:agent:_claude_agent_names'
    '--betas[បឋមកថា beta ដែលត្រូវរួមបញ្ចូលក្នុងសំណើ API (សម្រាប់តែអ្នកប្រើសោ API ប៉ុណ្ណោះ)]:betas:'
    '--fallback-model[បើកដំណើរការការថយក្រោយស្វ័យប្រវត្តិទៅគំរូដែលបានបញ្ជាក់ នៅពេលគំរូលំនាំដើមមានបន្ទុកលើស (តែ --print ប៉ុណ្ណោះ)]:model:_claude_model_names'
    '--settings[ផ្លូវឯកសារ JSON នៃការកំណត់ ឬខ្សែអក្សរ JSON ដើម្បីផ្ទុកការកំណត់បន្ថែម]:file-or-json:_files'
    '--add-dir[ថតបន្ថែមដើម្បីអនុញ្ញាតឱ្យឧបករណ៍ចូលប្រើ]:directories:_directories'
    '--ide[ភ្ជាប់ទៅ IDE ស្វ័យប្រវត្តិនៅពេលចាប់ផ្តើម ប្រសិនបើមាន IDE ត្រឹមត្រូវតែមួយ]'
    '--desktop[បើកក្នុងកម្មវិធី Claude Desktop ជំនួសឱ្យស្ថានីយ (ជាមួយ --continue ឬ --resume <id> ដើម្បីជ្រើសរើសវគ្គ)]'
    '--strict-mcp-config[ប្រើតែម៉ាស៊ីនមេ MCP ពី --mcp-config និងមិនអើពើនឹងការកំណត់ MCP ផ្សេងទៀតទាំងអស់]'
    '--session-id[លេខសម្គាល់វគ្គជាក់លាក់សម្រាប់ការសន្ទនា (ត្រូវតែជា UUID ត្រឹមត្រូវ)]:uuid:'
    '--agents[វត្ថុ JSON កំណត់ភ្នាក់ងារផ្ទាល់ខ្លួន]:json:'
    '--setting-sources[បញ្ជីប្រភពការកំណត់ដើម្បីផ្ទុក (ផ្តាច់ដោយសញ្ញាក្បៀស៖ user, project, local)]:sources:'
    '--plugin-dir[ថតដើម្បីផ្ទុកកម្មវិធីជំនួយសម្រាប់វគ្គនេះតែប៉ុណ្ណោះ (អាចធ្វើម្តងទៀត)]:paths:_directories'
    '--disable-slash-commands[បិទពាក្យបញ្ជា slash ទាំងអស់]'
    '(--bg --background)'{--bg,--background}'[ចាប់ផ្តើមវគ្គជាភ្នាក់ងារផ្ទៃខាងក្រោយ ហើយត្រឡប់មកវិញភ្លាមៗ]'
    '(-w --worktree)'{-w,--worktree}'[បង្កើត git worktree ថ្មីសម្រាប់វគ្គនេះ (អាចបញ្ជាក់ឈ្មោះស្រេចចិត្ត)]::name:'
    '--tmux=-[បង្កើតវគ្គ tmux សម្រាប់ worktree (ត្រូវការ --worktree)។ ប្រើផ្ទាំងដើមរបស់ iTerm2 នៅពេលមាន; --tmux=classic សម្រាប់ tmux បែបប្រពៃណី]::mode:(classic)'
    '(-n --name)'{-n,--name}'[កំណត់ឈ្មោះបង្ហាញសម្រាប់វគ្គនេះ]:name:'
    '--effort[កម្រិតការខិតខំសម្រាប់វគ្គបច្ចុប្បន្ន]:level:(low medium high xhigh max)'
    '--autocompact[ទំហំបង្អួចបង្រួមស្វ័យប្រវត្តិ (auto ឬ 100k-1M ថូខឹន)]:size:(auto)'
    '--debug-file[សរសេរកំណត់ហេតុបំបាត់កំហុសទៅផ្លូវឯកសារជាក់លាក់ (បើកដំណើរការរបៀបបំបាត់កំហុសដោយស្វ័យប្រវត្តិ)]:path:_files'
    '--from-pr[បន្តវគ្គដែលភ្ជាប់ទៅ PR តាមលេខ/URL ឬបើកកម្មវិធីជ្រើសរើសអន្តរកម្ម]::value:'
    '--teleport[បន្តវគ្គ teleport ដោយអាចបញ្ជាក់លេខសម្គាល់វគ្គជាជម្រើស]::session:'
    '--cloud[បង្កើតវគ្គ cloud ជាមួយការពិពណ៌នាដែលបានផ្តល់ ឬភ្ជាប់ទៅវគ្គដែលមានស្រាប់តាមលេខសម្គាល់វគ្គ ឬ URL claude.ai/code]::description-or-session:'
    '--environment[បង្កើតវគ្គ cloud ថ្មីដែលដំណើរការលើបរិស្ថានបង្ហោះដោយខ្លួនឯងដែលបានផ្តល់ (ccpool_...)]:environment_id:'
    '--remote-control[ចាប់ផ្តើមវគ្គអន្តរកម្មដោយបើកដំណើរការ Remote Control (អាចដាក់ឈ្មោះស្រេចចិត្ត)]::name:'
    '--remote-control-session-name-prefix[បុព្វបទសម្រាប់ឈ្មោះវគ្គ Remote Control ដែលបង្កើតដោយស្វ័យប្រវត្តិ]:prefix:'
    '--chrome[បើកដំណើរការការរួមបញ្ចូល Claude ក្នុង Chrome]'
    '--no-chrome[បិទការរួមបញ្ចូល Claude ក្នុង Chrome]'
    '--plugin-url[ទាញយក .zip កម្មវិធីជំនួយពី URL សម្រាប់វគ្គនេះតែប៉ុណ្ណោះ (អាចធ្វើម្តងទៀត)]:url:'
    '--file[ធនធានឯកសារដែលត្រូវទាញយកនៅពេលចាប់ផ្តើម (ទម្រង់៖ file_id:relative_path)]:specs:'
    '--prompt-suggestions[បើកដំណើរការការណែនាំការជំរុញ (បញ្ចេញការជំរុញបន្ទាប់ដែលបានទស្សន៍ទាយក្នុងរបៀប print/SDK)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[បញ្ជូនអត្ថបទ subagent និងប្លុកគំនិតជាសារ (ជាមួយ --print និង stream-json)]'
    '--include-hook-events[រួមបញ្ចូលព្រឹត្តិការណ៍វដ្តជីវិត hook ទាំងអស់ក្នុងស្ទ្រីមលទ្ធផល (ជាមួយ stream-json)]'
    '--exclude-dynamic-system-prompt-sections[ផ្លាស់ទីផ្នែកតាមម៉ាស៊ីនទៅសារអ្នកប្រើដំបូង ដើម្បីកែលម្អការប្រើឡើងវិញនៃ prompt-cache]'
    '--brief[បើកដំណើរការឧបករណ៍ SendUserMessage សម្រាប់ការទំនាក់ទំនងភ្នាក់ងារទៅអ្នកប្រើ]'
    '--safe-mode[ចាប់ផ្តើមដោយបិទការប្តូរតាមបំណងទាំងអស់ (មានប្រយោជន៍សម្រាប់ការដោះស្រាយបញ្ហាការកំណត់រចនាសម្ព័ន្ធដែលខូច)]'
    '--bare[របៀបអប្បបរមា៖ រំលង hooks, LSP, ការធ្វើសមកាលកម្មកម្មវិធីជំនួយ, attribution, auto-memory និងការរកឃើញ CLAUDE.md ស្វ័យប្រវត្តិ]'
    '--ax-screen-reader[បង្ហាញលទ្ធផលដែលងាយស្រួលសម្រាប់កម្មវិធីអានអេក្រង់ (អត្ថបទរាបស្មើ គ្មានស៊ុមតុបតែង ឬចលនា)]'
    '(-v --version)'{-v,--version}'[បញ្ចេញលេខកំណែ]'
    '(-h --help)'{-h,--help}'[បង្ហាញជំនួយពាក្យបញ្ជា]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude commands' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយពាក្យបញ្ជា]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "គ្មានអាគុយម៉ង់"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:ចាប់ផ្តើមម៉ាស៊ីនមេ MCP របស់ Claude Code'
    'add:បន្ថែមម៉ាស៊ីនមេ MCP ទៅ Claude Code'
    'remove:លុបម៉ាស៊ីនមេ MCP'
    'list:រាយបញ្ជីម៉ាស៊ីនមេ MCP ដែលបានកំណត់រចនាសម្ព័ន្ធ'
    'get:ទទួលបានព័ត៌មានលម្អិតម៉ាស៊ីនមេ MCP'
    'add-json:បន្ថែមម៉ាស៊ីនមេ MCP ជាមួយខ្សែអក្សរ JSON (stdio ឬ SSE)'
    'add-from-claude-desktop:នាំចូលម៉ាស៊ីនមេ MCP ពី Claude Desktop (តែ Mac និង WSL ប៉ុណ្ណោះ)'
    'reset-project-choices:កំណត់ឡើងវិញនូវម៉ាស៊ីនមេដែលមានវិសាលភាពគម្រោង (.mcp.json) ដែលបានអនុម័ត/បដិសេធទាំងអស់ក្នុងគម្រោងនេះ'
    'login:ផ្ទៀងផ្ទាត់ជាមួយម៉ាស៊ីនមេ MCP (HTTP, SSE ឬឧបករណ៍ភ្ជាប់ claude.ai)'
    'logout:សម្អាតព័ត៌មានសម្គាល់ OAuth ដែលបានរក្សាទុកសម្រាប់ម៉ាស៊ីនមេ MCP'
    'help:បង្ហាញជំនួយ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp commands' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[បើកដំណើរការរបៀបបំបាត់កំហុស]' \
            '--verbose[បដិសេធការកំណត់របៀបលម្អិតពីឯកសារកំណត់រចនាសម្ព័ន្ធ]' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[វិសាលភាពការកំណត់រចនាសម្ព័ន្ធ (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[ប្រភេទការដឹកជញ្ជូន (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[កំណត់អថេរបរិស្ថាន (ឧ. -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[កំណត់បឋមកថា WebSocket]:header:' \
            '--client-id[លេខសម្គាល់អតិថិជន OAuth សម្រាប់ម៉ាស៊ីនមេ HTTP/SSE]:clientId:' \
            '--client-secret[សួររកសម្ងាត់អតិថិជន OAuth (ឬកំណត់អថេរបរិស្ថាន MCP_CLIENT_SECRET)]' \
            '--callback-port[ច្រកថេរសម្រាប់ OAuth callback (សម្រាប់ម៉ាស៊ីនមេដែលតម្រូវឱ្យមាន redirect URI ដែលបានចុះឈ្មោះជាមុន)]:port:' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[វិសាលភាពការកំណត់រចនាសម្ព័ន្ធ (local, user, project) - លុបពីវិសាលភាពដែលមានស្រាប់ ប្រសិនបើមិនបានបញ្ជាក់]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[វិសាលភាពការកំណត់រចនាសម្ព័ន្ធ (local, user, project)]:scope:(local user project)' \
            '--client-secret[សួររកសម្ងាត់អតិថិជន OAuth (ឬកំណត់អថេរបរិស្ថាន MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[វិសាលភាពការកំណត់រចនាសម្ព័ន្ធ (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]'
          ;;
        login)
          _arguments \
            '--no-browser[បោះពុម្ព URL អនុញ្ញាតជំនួសឱ្យការបើកកម្មវិធីរុករក (សម្រាប់វគ្គ SSH/គ្មានអេក្រង់)]' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:ផ្ទៀងផ្ទាត់កម្មវិធីជំនួយ ឬបញ្ជីសេចក្តីលម្អិតទីផ្សារ'
    'marketplace:គ្រប់គ្រងទីផ្សារ Claude Code'
    'list:រាយបញ្ជីកម្មវិធីជំនួយដែលបានដំឡើង'
    'details:បង្ហាញបញ្ជីសមាសភាគ និងតម្លៃថូខឹនប៉ាន់ស្មានសម្រាប់កម្មវិធីជំនួយ'
    'configure:បង្ហាញជម្រើសរបស់កម្មវិធីជំនួយ និងជម្រើសណាដែលមិនទាន់កំណត់ ឬរក្សាទុកតម្លៃពី stdin'
    'install:ដំឡើងកម្មវិធីជំនួយពីទីផ្សារដែលមាន'
    'i:ដំឡើងកម្មវិធីជំនួយពីទីផ្សារដែលមាន (ទម្រង់ខ្លីនៃ install)'
    'init:បង្កើតគ្រោងកម្មវិធីជំនួយថ្មី (ផ្ទុកស្វ័យប្រវត្តិវគ្គបន្ទាប់)'
    'new:បង្កើតគ្រោងកម្មវិធីជំនួយថ្មី (ឈ្មោះផ្សេងនៃ init)'
    'uninstall:លុបការដំឡើងកម្មវិធីជំនួយដែលបានដំឡើង'
    'remove:លុបការដំឡើងកម្មវិធីជំនួយដែលបានដំឡើង (ឈ្មោះផ្សេងនៃ uninstall)'
    'enable:បើកដំណើរការកម្មវិធីជំនួយដែលបានបិទ'
    'disable:បិទកម្មវិធីជំនួយដែលបានបើក'
    'update:ធ្វើបច្ចុប្បន្នភាពកម្មវិធីជំនួយទៅកំណែថ្មីបំផុត'
    'eval:ដំណើរការករណី eval ប្រឆាំងនឹងកម្មវិធីជំនួយ ហើយរាយការណ៍លទ្ធផលដែលបានដាក់ពិន្ទុ'
    'prune:លុបភាពអាស្រ័យដែលបានដំឡើងស្វ័យប្រវត្តិដែលលែងត្រូវការ'
    'autoremove:លុបភាពអាស្រ័យដែលបានដំឡើងស្វ័យប្រវត្តិដែលលែងត្រូវការ (ឈ្មោះផ្សេងនៃ prune)'
    'tag:បង្កើត git tag {name}--v{version} សម្រាប់ការចេញផ្សាយកម្មវិធីជំនួយ'
    'test:ដំណើរការការធ្វើតេស្តរបស់ mod'
    'help:បង្ហាញជំនួយ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin commands' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[ចាត់ទុកការព្រមានជាកំហុស (កូដចេញ 1)]' \
            '--json[បញ្ចេញរបាយការណ៍ផ្ទៀងផ្ទាត់ជា JSON (កូដចេញដូចគ្នា)]' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[វិសាលភាពការដំឡើង]:scope:(user project local)' \
            '*--config[កំណត់ជម្រើស userConfig ដែលបានប្រកាសក្នុងបញ្ជីសេចក្តីលម្អិតកម្មវិធីជំនួយ (អាចធ្វើម្តងទៀត)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[ទទួលយកពាក្យបញ្ជាដែលបានប្រកាសដោយទីផ្សារដែលកំពុងបង្ហាញ ដោយគ្មានការជំរុញបញ្ជាក់]' \
            '--json[បោះពុម្ពបន្ទាត់លទ្ធផលតែមួយដែលម៉ាស៊ីនអានបាន ជំនួសឱ្យសារសម្រាប់មនុស្ស]' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[វិសាលភាពការដំឡើង]:scope:(user project local)' \
            '--keep-data[រក្សាទុកថតទិន្នន័យអចិន្ត្រៃយ៍របស់កម្មវិធីជំនួយ]' \
            '--prune[លុបផងដែរនូវភាពអាស្រ័យដែលបានដំឡើងស្វ័យប្រវត្តិដែលលែងត្រូវការ]' \
            '(-y --yes)'{-y,--yes}'[រំលងការជំរុញបញ្ជាក់របស់ --prune]' \
            '--json[បោះពុម្ពបន្ទាត់លទ្ធផលតែមួយដែលម៉ាស៊ីនអានបាន ជំនួសឱ្យសារសម្រាប់មនុស្ស (មិនប្រើជាមួយ --prune)]' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[វិសាលភាពការដំឡើង]:scope:(user project local)' \
            '--json[បោះពុម្ពបន្ទាត់លទ្ធផលតែមួយដែលម៉ាស៊ីនអានបាន ជំនួសឱ្យសារសម្រាប់មនុស្ស]' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[បិទកម្មវិធីជំនួយដែលបានបើកទាំងអស់]' \
            '(-s --scope)'{-s,--scope}'[វិសាលភាពការដំឡើង]:scope:(user project local)' \
            '--json[បោះពុម្ពបន្ទាត់លទ្ធផលតែមួយដែលម៉ាស៊ីនអានបាន ជំនួសឱ្យសារសម្រាប់មនុស្ស]' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[វិសាលភាពការដំឡើង]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[ទទួលយកពាក្យបញ្ជាដែលបានប្រកាសដោយទីផ្សារដែលកំពុងបង្ហាញ ដោយគ្មានការជំរុញបញ្ជាក់]' \
            '--json[បោះពុម្ពបន្ទាត់លទ្ធផលតែមួយដែលម៉ាស៊ីនអានបាន ជំនួសឱ្យសារសម្រាប់មនុស្ស]' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[បញ្ចេញជា JSON]' \
            '--available[រួមបញ្ចូលកម្មវិធីជំនួយដែលមានពីទីផ្សារ (ត្រូវការ --json)]' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[លុបភាពអាស្រ័យដែលលែងត្រូវការនៅវិសាលភាពដែលបានបញ្ជាក់]:scope:(user project local)' \
            '--dry-run[រាយបញ្ជីអ្វីដែលនឹងត្រូវលុប ដោយមិនលុបពិតប្រាកដ]' \
            '(-y --yes)'{-y,--yes}'[រំលងការជំរុញបញ្ជាក់]' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]'
          ;;
        configure)
          _arguments \
            '--json[បញ្ចេញជា JSON]' \
            '--values-stdin[អានតម្លៃជម្រើសពី stdin ជាវត្ថុ JSON នៃខ្សែអក្សរបន្ទាត់តែមួយ; ជម្រើសដែលមិនបានរួមបញ្ចូលនៅតែរក្សាតម្លៃរបស់វា]' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[ការពិពណ៌នាក្នុងបញ្ជីសេចក្តីលម្អិត]:text:' \
            '--author[ឈ្មោះអ្នកនិពន្ធ (លំនាំដើម៖ git config user.name)]:name:' \
            '--author-email[អ៊ីមែលអ្នកនិពន្ធ (លំនាំដើម៖ git config user.email)]:email:' \
            '--with[សមាសភាគដែលត្រូវបង្កើតគ្រោងផងដែរ]:components:' \
            '(-f --force)'{-f,--force}'[សរសេរជាន់លើ .claude-plugin/ ដែលមានស្រាប់នៅគោលដៅ]' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[ត្រងករណីតាម glob ឈ្មោះ]:glob:' \
            '*--tag[ត្រងករណីតាមស្លាក (អាចធ្វើម្តងទៀត)]:tag:' \
            '--runs[បដិសេធចំនួនដំណើរការក្នុងមួយករណី (លំនាំដើម៖ case.runs បើមិនដូច្នោះទេ 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[ដំណើរការការរត់ភ្នាក់ងាររហូតដល់ n លើកក្នុងពេលដំណាលគ្នា (1-8; លំនាំដើម 1)]:n:' \
            '--model[បដិសេធគំរូសម្រាប់ករណីទាំងអស់]:model:_claude_model_names' \
            '--judge-model[បដិសេធគំរូអ្នកដាក់ពិន្ទុ LLM (លំនាំដើម៖ haiku)]:model:_claude_model_names' \
            '--max-cost-usd[ពិដានចំណាយដាច់ខាត; បោះបង់ ហើយរាយការណ៍លទ្ធផលមួយផ្នែក ប្រសិនបើឈានដល់ (កូដចេញ 2)]:usd:' \
            '--output-dir[ថតសម្រាប់ aggregate-result.json]:dir:_directories' \
            '--eval-dir[ឈ្មោះថត (នៅក្រោមកម្មវិធីជំនួយ) ដែលផ្ទុកករណី eval]:dir:' \
            '--json[បោះពុម្ពលទ្ធផលដំណើរការពេញលេញជា JSON ទៅ stdout ឬសរសេរវាទៅឯកសារ .json នេះ]::path:_files' \
            '--threshold[ចេញដោយកូដចេញ 1 ប្រសិនបើពិន្ទុករណីណាមួយទាបជាងកម្រិតនេះ (លំនាំដើម៖ 1.0)]:threshold:' \
            '*--allow-tools[ការផ្តល់សិទ្ធិដោយប្រតិបត្តិករសម្រាប់ឧបករណ៍ដែលមានការរឹតបន្តឹង (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[ដំណើរការ scaffold_script របស់ករណីនីមួយៗ (ដំណើរការ bash ដែលផ្តល់ដោយអ្នកនិពន្ធក្នុងនាមអ្នក; បិទជាលំនាំដើម)]' \
            '(--scaffold)--no-scaffold[រំលង scaffold_script យ៉ាងច្បាស់លាស់]' \
            '--trust-plugin[បញ្ជាក់ថាអ្នកទុកចិត្តកម្មវិធីជំនួយនេះ និងឈុត eval របស់វា ដោយរំលងការជំរុញសុំការទុកចិត្តនៅដំណើរការលើកដំបូង (សម្រាប់ CI)]' \
            '--ablation[ដំណើរការក្រុមប្រៀបធៀបមូលដ្ឋាន (baseline arm) ដែលគ្មានកម្មវិធីជំនួយ ហើយរាយការណ៍ភាពខុសគ្នានៃពិន្ទុ]:mode:(none with-without)' \
            '--mocks[ការជំនួសក្លែងក្លាយ (mock) សម្រាប់ម៉ាស៊ីនមេ MCP ពី <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[ជាមួយ --mocks record៖ ចាប់ផ្តើមផងដែរនូវដំណើរការម៉ាស៊ីនមេ MCP ពិតប្រាកដដែលគ្មាន mock]' \
            '--keep-temp[រក្សាទុកថតគ្រោងសម្រាប់ការបំបាត់កំហុស]' \
            '--verbose[កត់ត្រាព្រឹត្តិការណ៍តាមដានសម្រាប់សារនីមួយៗទៅកំណត់ហេតុបំបាត់កំហុស]' \
            '--report[សរសេររបាយការណ៍ HTML ដែលពេញលេញក្នុងខ្លួនទៅផ្លូវនេះ ជំនួសឱ្យថតលទ្ធផល]:path:_files' \
            '(--no-publish)--publish-report[តម្រូវឱ្យបោះផ្សាយរបាយការណ៍ទៅ claude.ai ផងដែរ]' \
            '(--publish-report)--no-publish[រក្សារបាយការណ៍ HTML នៅក្នុងម៉ាស៊ីនមូលដ្ឋានតែប៉ុណ្ណោះ; រំលងការបោះផ្សាយវាទៅ claude.ai]' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[រុញ tag ទៅ --remote បន្ទាប់ពីបង្កើតវា]' \
            '--dry-run[បោះពុម្ពអ្វីដែលនឹងត្រូវដាក់ tag ដោយមិនបង្កើតវា]' \
            '(-f --force)'{-f,--force}'[រំលងការពិនិត្យ working tree ដែលមានការផ្លាស់ប្តូរមិនទាន់ commit និង tag ដែលមានរួចហើយ]' \
            '(-m --message)'{-m,--message}'[សារចំណារពន្យល់ tag (ប្រើ %s សម្រាប់កំណែ)]:msg:' \
            '--remote[remote ដែលត្រូវរុញទៅជាមួយ --push]:name:' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:បន្ថែមទីផ្សារពី URL, ផ្លូវ ឬឃ្លាំង GitHub'
    'list:រាយបញ្ជីទីផ្សារដែលបានកំណត់រចនាសម្ព័ន្ធ'
    'remove:លុបទីផ្សារដែលបានកំណត់រចនាសម្ព័ន្ធ'
    'rm:លុបទីផ្សារដែលបានកំណត់រចនាសម្ព័ន្ធ (ឈ្មោះផ្សេងនៃ remove)'
    'update:ធ្វើបច្ចុប្បន្នភាពទីផ្សារពីប្រភព - ធ្វើបច្ចុប្បន្នភាពទាំងអស់ ប្រសិនបើមិនបានបញ្ជាក់ឈ្មោះ'
    'help:បង្ហាញជំនួយ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace commands' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[កំណត់ការ checkout ត្រឹមថតជាក់លាក់តាមរយៈ git sparse-checkout (សម្រាប់ monorepo)]:paths:' \
            '--scope[កន្លែងដែលត្រូវប្រកាសទីផ្សារ]:scope:(user project local)' \
            '--claudeai[បន្ថែមទីផ្សារដែលមានឈ្មោះនេះ ដែល claude.ai បង្ហោះសម្រាប់អ្នក]' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[បញ្ចេញជា JSON]' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]'
          ;;
        remove|rm)
          _arguments \
            '--scope[លុបការប្រកាសទីផ្សារចេញពីវិសាលភាពការកំណត់ជាក់លាក់ (មិនបញ្ជាក់ ដើម្បីលុបវាចេញពីគ្រប់វិសាលភាព)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[បង្ខំឱ្យដំឡើង ទោះបីជាបានដំឡើងរួចហើយក៏ដោយ]' \
    '(-h --help)'{-h,--help}'[បង្ហាញជំនួយ]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[ថតបន្ថែមដើម្បីអនុញ្ញាតឱ្យឧបករណ៍ចូលប្រើក្នុងវគ្គដែលបានបញ្ជូន]:directory:_directories' \
    '--agent[ភ្នាក់ងារលំនាំដើមសម្រាប់វគ្គដែលបានបញ្ជូនពីទិដ្ឋភាពភ្នាក់ងារ]:agent:_claude_agent_names' \
    '--all[ជាមួយ --json៖ រួមបញ្ចូលផងដែរនូវវគ្គផ្ទៃខាងក្រោយដែលបានបញ្ចប់]' \
    '--allow-dangerously-skip-permissions[ធ្វើឱ្យរបៀបរំលងសិទ្ធិអាចប្រើបានសម្រាប់វគ្គដែលបានបញ្ជូន]' \
    '--cwd[បង្ហាញតែវគ្គផ្ទៃខាងក្រោយដែលចាប់ផ្តើមក្រោមផ្លូវ]:path:_directories' \
    '--dangerously-skip-permissions[ឈ្មោះផ្សេងសម្រាប់ --permission-mode bypassPermissions]' \
    '--effort[កម្រិតការខិតខំលំនាំដើមសម្រាប់វគ្គដែលបានបញ្ជូន]:level:(low medium high xhigh max)' \
    '--json[បោះពុម្ពវគ្គសកម្មជា JSON array ហើយចេញ]' \
    '*--mcp-config[ការកំណត់រចនាសម្ព័ន្ធម៉ាស៊ីនមេ MCP ដើម្បីអនុវត្តចំពោះវគ្គដែលបានបញ្ជូន]:config:' \
    '--model[គំរូលំនាំដើមសម្រាប់វគ្គដែលបានបញ្ជូនពីទិដ្ឋភាពភ្នាក់ងារ]:model:_claude_model_names' \
    '--permission-mode[របៀបសិទ្ធិលំនាំដើមសម្រាប់វគ្គដែលបានបញ្ជូន]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[ផ្ទុកកម្មវិធីជំនួយពីថតសម្រាប់ទិដ្ឋភាពភ្នាក់ងារ និងវគ្គដែលបានបញ្ជូន]:path:_directories' \
    '--setting-sources[បញ្ជីប្រភពការកំណត់ដើម្បីផ្ទុក (ផ្តាច់ដោយសញ្ញាក្បៀស៖ user, project, local)]:sources:' \
    '--settings[ឯកសារការកំណត់ ឬខ្សែអក្សរ JSON ដើម្បីអនុវត្ត]:file-or-json:_files' \
    '--strict-mcp-config[ប្រើតែម៉ាស៊ីនមេ MCP ពី --mcp-config ក្នុងវគ្គដែលបានបញ្ជូន]' \
    '--restricted[ចាប់ផ្តើមវគ្គដែលបានបញ្ជូនក្នុងរបៀបដាក់កម្រិត]' \
    '(-h --help)'{-h,--help}'[បង្ហាញជំនួយពាក្យបញ្ជា]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:ចូលទៅគណនី Anthropic របស់អ្នក'
    'logout:ចេញពីគណនី Anthropic របស់អ្នក'
    'status:បង្ហាញស្ថានភាពការផ្ទៀងផ្ទាត់'
    'help:បង្ហាញជំនួយ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[បង្ហាញជំនួយពាក្យបញ្ជា]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth commands' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[បំពេញអាសយដ្ឋានអ៊ីមែលជាមុននៅលើទំព័រចូល]:email:' \
            '--sso[បង្ខំឱ្យប្រើលំហូរចូល SSO]' \
            '(--claudeai)--console[ប្រើ Anthropic Console (ការចេញវិក្កយបត្រតាមការប្រើប្រាស់ API) ជំនួសឱ្យការជាវ Claude]' \
            '(--console)--claudeai[ប្រើការជាវ Claude (លំនាំដើម)]' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយពាក្យបញ្ជា]'
          ;;
        status)
          _arguments \
            '(--text)--json[បញ្ចេញជា JSON (លំនាំដើម)]' \
            '(--json)--text[បញ្ចេញជាអត្ថបទដែលមនុស្សអានបាន]' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយពាក្យបញ្ជា]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយពាក្យបញ្ជា]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:បោះពុម្ពការកំណត់រចនាសម្ព័ន្ធរបៀបស្វ័យប្រវត្តិដែលមានប្រសិទ្ធភាពជា JSON'
    'critique:ទទួលបានមតិកែលម្អ AI លើច្បាប់របៀបស្វ័យប្រវត្តិផ្ទាល់ខ្លួនរបស់អ្នក'
    'defaults:បោះពុម្ពច្បាប់របៀបស្វ័យប្រវត្តិលំនាំដើមជា JSON'
    'reset:កំណត់ការកំណត់រចនាសម្ព័ន្ធរបៀបស្វ័យប្រវត្តិឡើងវិញទៅលំនាំដើមដែលបានផ្តល់មក'
    'help:បង្ហាញជំនួយ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[បង្ហាញជំនួយពាក្យបញ្ជា]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode commands' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[បដិសេធគំរូដែលត្រូវប្រើ]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយពាក្យបញ្ជា]'
          ;;
        defaults)
          _arguments \
            '--label[បង្ហាញតែច្បាប់ដែលស្លាករបស់វាចាប់ផ្តើមដោយបុព្វបទនេះ (មិនប្រកាន់អក្សរធំតូច)]:prefix:' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយពាក្យបញ្ជា]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[រំលងការជំរុញបញ្ជាក់]' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយពាក្យបញ្ជា]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយពាក្យបញ្ជា]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[ផ្លូវទៅការកំណត់រចនាសម្ព័ន្ធ YAML gateway]:path:_files' \
    '(-h --help)'{-h,--help}'[បង្ហាញជំនួយពាក្យបញ្ជា]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:លុបស្ថានភាព Claude Code ទាំងអស់សម្រាប់គម្រោង (ប្រតិចារិក, កិច្ចការ, ប្រវត្តិឯកសារ, ធាតុកំណត់រចនាសម្ព័ន្ធ)'
    'help:បង្ហាញជំនួយ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[បង្ហាញជំនួយពាក្យបញ្ជា]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project commands' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[រាយបញ្ជីអ្វីដែលនឹងត្រូវលុប ដោយមិនលុបអ្វីទាំងអស់]' \
            '(-y --yes)'{-y,--yes}'[រំលងការជំរុញបញ្ជាក់]' \
            '(-i --interactive)'{-i,--interactive}'[សួរសម្រាប់ធាតុនីមួយៗមុនពេលលុប]' \
            '(1)--all[លុបស្ថានភាពសម្រាប់គ្រប់គម្រោង (មិនអាចប្រើរួមជាមួយផ្លូវបានទេ)]' \
            '(-h --help)'{-h,--help}'[បង្ហាញជំនួយពាក្យបញ្ជា]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[បោះពុម្ព payload bugs.json ដើមជំនួសឱ្យការរកឃើញដែលបានធ្វើទ្រង់ទ្រាយ]' \
    '--timeout[នាទីអតិបរមាដើម្បីរង់ចាំការត្រួតពិនិត្យបញ្ចប់ (លំនាំដើម៖ 45)]:minutes:' \
    '(--no-post)--post[បង្ហោះការរកឃើញនៃការត្រួតពិនិត្យដែលបានបញ្ចប់ទៅ PR ក្នុងនាមអ្នក (សម្រាប់គោលដៅ PR តែប៉ុណ្ណោះ; មតិយោបល់ធម្មតាមួយ មិនមែនជាការត្រួតពិនិត្យទេ)]' \
    '(--post)--no-post[កុំបង្ហោះការរកឃើញទៅ PR (លំនាំដើម)]' \
    '(-h --help)'{-h,--help}'[បង្ហាញជំនួយពាក្យបញ្ជា]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[ចាប់ផ្តើមវគ្គផ្ទៃខាងក្រោយដែលកំពុងដំណើរការទាំងអស់ឡើងវិញ]' \
    '(-h --help)'{-h,--help}'[បង្ហាញជំនួយពាក្យបញ្ជា]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[បោះបង់ផងដែរនូវ commit ដែលមិនទាន់រុញ និងការផ្លាស់ប្តូរដែលមិនទាន់ commit របស់ worktree (ផ្តល់ commit@worktree-id ដែល claude rm មុននេះបានរាយការណ៍)]:commit@worktree-id:' \
    '--force-remove-worktree[លុបថត worktree ទោះបីជា hook WorktreeRemove ឬ git មិនអាចលុបវាបានក៏ដោយ (ផ្តល់ worktree-id ដែល claude rm មុននេះបានរាយការណ៍)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[បង្ហាញជំនួយពាក្យបញ្ជា]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[បង្ហាញអ្វីដែលនឹងត្រូវនាំចូល ដោយមិនសរសេរអ្វីទាំងអស់]' \
    '--yes[រំលងកម្មវិធីជ្រើសរើសអន្តរកម្ម (នៅលើផ្ទៃគ្មានអេក្រង់ ផ្តល់ --yes=<digest> ពីការមើលជាមុន /import)]' \
    '(-h --help)'{-h,--help}'[បង្ហាញជំនួយពាក្យបញ្ជា]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
