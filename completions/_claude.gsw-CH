#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:MCP-Server konfiguriere u verwalte'
    'plugin:Claude Code-Erwitterige verwalte'
    'agents:Hintergrund-Agente verwalte'
    'attach:Hintergrundsitzig i däm Terminal öffne'
    'logs:Aktuelli Terminalusgab vo ere Hintergrundsitzig usgäh'
    'stop:Hintergrundsitzig stoppe (d Konversation blibt erhalte)'
    'respawn:Hintergrundsitzig nöi starte, damit si mit de aktuelle Claude Code-Version lauft'
    'rm:Hintergrundsitzig lösche, u ire Worktree, wänn das gfahrlos gaht'
    'remote-control:Lokali Sitzige vo claude.ai/code oder de Claude-Handy-App us stüüre'
    'daemon:De Supervisor für Hintergrundsitzige verwalte'
    'auth:Authentifizierig verwalte'
    'auto-mode:Auto-Modus-Klassifizierer-Konfiguration prüefe oder zrucksetze'
    'gateway:Enterprise-Authentifizierigs-/Telemetrie-Gateway usfüehre'
    'self-hosted-runner:Claude Code-Cloud-Sitzige uf dere Maschine oder däm Container hoste'
    'import:Konfiguration vo eme andere KI-Coding-Agent i Claude Code importiere'
    'project:Claude Code-Projäktstatus verwalte'
    'purge:Alli Claude Code-Status für e Projäkt lösche (Transkript, Ufgabe, Dateiverlauf, Konfigurationsiitrag)'
    'ultrareview:Cloud-ghosteti Multi-Agent-Code-Überprüefig usfüehre u d Ergebnis usgäh'
    'setup-token:Langziit-Authentifizierigs-Token iirichte (bruucht Claude-Abonnemänt)'
    'doctor:Gsundheitsprüefig für Claude Code Auto-Updater'
    'update:Nach Updates sueche u installiere'
    'install:Claude Code native Build installiere'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Debug-Modus mit optionaler Kategoriefilterig aktiviere (z.B. "api,hooks" oder "!statsig,!file")]:filter:'
    '--verbose[Verbose-Modus us Konfigurationsdatei überschriibe]'
    '(-p --print)'{-p,--print}'[Antwort usgäh u beände (für Verwendig mit Pipes). Hiiwis: nur i vertrauenswürdige Verzeichnis verwände]'
    '--output-format[Usgabformat (mit --print): "text" (Standard), "json" (einzels Ergebnis) oder "stream-json" (Echtzit-Streaming)]:format:(text json stream-json)'
    '--json-schema[JSON-Schema für strukturierti Usgab-Validierig]:schema:'
    '--include-partial-messages[Teilwisi Nachrichtestück bi Akunft iischliesse (mit --print u --output-format=stream-json)]'
    '--input-format[Iigabformat (mit --print): "text" (Standard) oder "stream-json" (Echtzit-Streaming-Iigab)]:format:(text stream-json)'
    '--dangerously-skip-permissions[Alli Berechtigigsprüefige umgah. Nur für Sandboxe ohni Internetzuegang empfohle]'
    '--allow-dangerously-skip-permissions[Option zum Umgah vo Berechtigigsprüefige aktiviere, ohni standardmässig z aktiviere]'
    '--restricted[Iigschränkte Modus: Wärkzüg, wo Befehl oder Code usfüehre, u WebFetch entferne, user/project/local-Iischtellige ignoriere u Datei-Wärkzüg uf d Arbetsverzeichnis beschränke]'
    '--max-budget-usd[Maximale Dollarbetrag zum Uusgäh für API-Ufruef (nur --print)]:amount:'
    '--max-turns[Aazahl vo agentische Zügg begränze (nur --print)]:turns:'
    '--replay-user-messages[Benutzernachrichtet vo stdin uf stdout zur Bestätigig nöimol sände]'
    '--allowed-tools[Komma- oder leerzeichegtrennte Liste erlaubte Wärkzügnäme (z.B. "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Komma- oder leerzeichegtrennte Liste erlaubte Wärkzügnäme (camelCase-Format)]:tools:'
    '--tools[Liste verfüegbare Wärkzüg us iigbautem Set aagäh. Nur Druckmodus]:tools:'
    '--disallowed-tools[Komma- oder leerzeichegtrennte Liste nöd erlaubte Wärkzügnäme (z.B. "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Komma- oder leerzeichegtrennte Liste nöd erlaubte Wärkzügnäme (camelCase-Format)]:tools:'
    '--mcp-config[MCP-Server us JSON-Datei oder String lade (leerzeichegtrennt)]:configs:'
    '--system-prompt[System-Prompt für Sitzig verwände]:prompt:'
    '--system-prompt-file[System-Prompt us ere Datei lese]:file:_files'
    '--append-system-prompt[System-Prompt a Standard-System-Prompt aahänge]:prompt:'
    '--append-system-prompt-file[System-Prompt us ere Datei lese u a Standard-System-Prompt aahänge]:file:_files'
    '(--append-subagent-system-prompt-file)--append-subagent-system-prompt[Text a de System-Prompt vo jedem Subagent aahänge (nur --print)]:prompt:'
    '(--append-subagent-system-prompt)--append-subagent-system-prompt-file[Text us ere Datei lese u a d System-Prompts vo de Subagente aahänge (nur --print)]:file:_files'
    '--system-prompt-snapshot[System-Prompt eimal pro Konversation ufzeichne u bi jeder Aafrag u jedem Fortsetzä unveränderet wiiderverwände (on, Standard) oder bi jeder Aafrag nöi erzüüge (off)]:mode:(on off)'
    '--permission-mode[Berechtigigs-Modus für Sitzig verwände]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Wer Berechtigigsabfrage mit --print beantwortet: "host" (de SDK-Host oder --permission-prompt-tool) oder "none" (alles, wo nachfrage würd, wird abglehnt)]:target:(host none)'
    '--permission-prompt-tool[MCP-Tool für Berechtigigsabfrage (nur --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Di letst Konversation fortsetzä]'
    '(-r --resume)'{-r,--resume}'[Konversation fortsetzä - Sitzig-ID aagäh oder interaktiv uuswähle]:sessionId:_claude_sessions'
    '--fork-session[Nöii Sitzig-ID erstelle statt ursprünglichi Sitzig-ID bim Fortsetzä wiiderverwände (mit --resume oder --continue)]'
    '--no-session-persistence[Sitzigspersistänz deaktiviere - Sitzige wärde nöd gspeicheret (nur --print)]'
    '--model[Modell für aktuelli Sitzig. Alias für nöischts Modell aagäh (z.B. '\''sonnet'\'' oder '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agent für di aktuelli Sitzig. Überschribt d '\''agent'\''-Iischtellig]:agent:_claude_agent_names'
    '--betas[Beta-Header i API-Aafrage iischliesse (nur API-Schlüssel-Benutzer)]:betas:'
    '--fallback-model[Automatischs Zruckfalle uf aagähs Modell aktiviere, wänn Standardmodell überlastet isch (nur --print)]:model:_claude_model_names'
    '--settings[Pfad zu Iischtellige-JSON-Datei oder JSON-String zum Lade vo zuesätzliche Iischtellige]:file-or-json:_files'
    '--add-dir[Zuesätzlichi Verzeichnis für Wärkzügzuegang erlaube]:directories:_directories'
    '--ide[Automatisch mit IDE bim Start verbinde, wänn genau eis gültigs IDE verfüegbar isch]'
    '--desktop[I de Claude Desktop-App statt im Terminal öffne (mit --continue oder --resume <id> d Sitzig uuswähle)]'
    '--strict-mcp-config[Nur MCP-Server us --mcp-config verwände u alli andere MCP-Iischtellige ignoriere]'
    '--session-id[Spezifischi Sitzig-ID für Konversation verwände (muess gültigi UUID sii)]:uuid:'
    '--agents[JSON-Objekt zur Definition vo benutzerdefinierte Agente]:json:'
    '--advisor[Serversitigs Advisor-Wärkzüg für die Sitzig mit eme Modell-Alias oder ere vollständige Modell-ID aktiviere]:model:_claude_model_names'
    '--teammate-mode[Wie Teammitglieder vom Agente-Team aazeigt wärde]:mode:(in-process auto tmux iterm2)'
    '--setting-sources[Kommatrennte Liste vo Iischtelligsquälle zum Lade (user, project, local)]:sources:'
    '--plugin-dir[Verzeichnis zum Lade vo Erwitterige nur für die Sitzig (wiiderholbar)]:paths:_directories'
    '--disable-slash-commands[Alli Slash-Befehl deaktiviere]'
    '(--bg --background)'{--bg,--background}'[Sitzig als Hintergrund-Agent starte u sofort zrucchäre]'
    '(-w --worktree)'{-w,--worktree}'[Nöie Git-Worktree für die Sitzig erstelle (optional en Name aagäh)]::name:'
    '--tmux=-[tmux-Sitzig für de Worktree erstelle (bruucht --worktree). Verwändet nativi iTerm2-Panes, wänn verfüegbar; --tmux=classic für klassischs tmux]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Aazeigename für die Sitzig festlege]:name:'
    '--effort[Ufwandsstufe für di aktuelli Sitzig]:level:(low medium high xhigh max)'
    '--autocompact[Fänstergrössi fürs automatische Kompaktiere (auto oder 100k-1M Tokens)]:size:(auto)'
    '--debug-file[Debug-Protokoll i en bestimmte Dateipfad schriibe (aktiviert implizit de Debug-Modus)]:path:_files'
    '--from-pr[Mit eme PR verchnüpfti Sitzig nach Nummere/URL fortsetzä oder interaktivi Uuswahl öffne]::value:'
    '--teleport[Teleport-Sitzig fortsetzä, optional Sitzig-ID aagäh]::session:'
    '(--remote)--cloud[Cloud-Sitzig mit de aagäbne Beschriibig erstelle oder per Sitzig-ID bzw. claude.ai/code-URL a e beschtähendi aahänge]::description-or-session:'
    '(--cloud)--remote[Veraltete Alias für --cloud]::description-or-session:'
    '--environment[Nöii Cloud-Sitzig erstelle, wo i de aagäbne sälber ghostete Umgäbig (ccpool_...) lauft]:environment_id:'
    '--ref[Mit --environment: Checkout vo de nöie Sitzig uf e benännti Ref statt uf de lokale HEAD stütze]:branch:'
    '(--remote-control --rc)'{--remote-control,--rc}'[Interaktivi Sitzig mit aktivierter Fernsteuerig starte (optional benännt)]::name:'
    '--remote-control-session-name-prefix[Präfix für automatisch generierti Fernsteuerigs-Sitzigsnäme]:prefix:'
    '--chrome[Claude i Chrome-Integration aktiviere]'
    '--no-chrome[Claude i Chrome-Integration deaktiviere]'
    '--plugin-url[Plugin-.zip vo ere URL nur für die Sitzig abrüefe (wiiderholbar)]:url:'
    '--file[Dateiressource, wo bim Start abeglade wärde (Format: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Prompt-Vorschläg aktiviere (git en vorhergsäite nächst Prompt im Print-/SDK-Modus us)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Subagent-Text u Dänkblöck als Nachrichte wiiterleite (mit --print u stream-json)]'
    '--include-hook-events[Alli Hook-Läbenszyklus-Eräignis im Usgabstream iischliesse (mit stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Maschinespezifischi Abschnitt i di erst Benutzernachricht verschiebe, zum d Prompt-Cache-Wiiderverwendig verbessere]'
    '--brief[SendUserMessage-Tool für Agent-zu-Benutzer-Kommunikation aktiviere]'
    '*--channels[(Forschigsvorschau) MCP-Server, uf dere ihri Kanalbenachrichtigunge glost wird (plugin\:<name>@<marketplace>)]:entries:'
    '*--dangerously-load-development-channels[Kanäl, wo nöd uf de gnehmigte Allowlist sind, für lokali Entwicklig aktiviere (plugin\:<name>@<marketplace> oder server\:<name>)]:entries:'
    '--init[Setup-Hooks mit em init-Matcher vor de Sitzig uusfüehre (nur --print)]'
    '--init-only[Setup- u SessionStart-Hooks uusfüehre, dänn beände, ohni es Gspräch z starte]'
    '--maintenance[Setup-Hooks mit em maintenance-Matcher vor de Sitzig uusfüehre (nur --print)]'
    '--safe-mode[Mit alle deaktivierte Aapassige starte (nützlich zum Fählerbehebig vo ere kaputte Konfiguration)]'
    '--bare[Minimalmodus: Hooks, LSP, Plugin-Synchronisierig, Attribution, Auto-Memory u CLAUDE.md-Auto-Erkennig überspringe]'
    '--ax-screen-reader[Bildschirmläser-fründlichi Usgab rendere (flache Text, käi dekorativi Rahme oder Animatione)]'
    '(-v --version)'{-v,--version}'[Versionsnummere usgäh]'
    '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]'
  )

  # Stop at the first non-option word, so that the options after a command reach
  # that command's own specs instead of being consumed here
  _arguments -C -A '-*' \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude-Befehle' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin|plugins)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        remote-control|rc|remote|sync|bridge)
          _claude_remote_control
          ;;
        daemon)
          _claude_daemon
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        self-hosted-runner)
          _claude_self_hosted_runner
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        purge)
          _claude_purge
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update|upgrade)
          _arguments \
            '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]'
          ;;
        *)
          # Not a command but the prompt: options may still follow it
          _arguments \
            $main_options \
            '*: :'
          ;;
      esac
      ;;
  esac
  local ret=$?

  # The last step, such as listing commands for --r, can fail although options
  # were added before it. Report success then: on failure zsh moves on to the
  # next completers, and _correct or _approximate pile on corrections
  (( compstate[nmatches] > 0 )) || return $ret
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Claude Code MCP-Server starte'
    'add:MCP-Server zu Claude Code hinzuefüege'
    'remove:MCP-Server entferne'
    'list:Konfigurierti MCP-Server uflistä'
    'get:MCP-Serverdetails abruefe'
    'add-json:MCP-Server (stdio oder SSE) mit JSON-String hinzuefüege'
    'add-from-claude-desktop:MCP-Server vo Claude Desktop importiere (nur Mac u WSL)'
    'reset-project-choices:Alli gnehmigete/abglehnte projektbezogene (.mcp.json) Server i däm Projekt zrucksetze'
    'login:Bi eme MCP-Server authentifiziere (HTTP, SSE oder claude.ai-Connector)'
    'logout:Gspeicherti OAuth-Aameldedate für en MCP-Server lösche'
    'help:Hilf aazeige'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Hilf aazeige]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp-Befehle' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Debug-Modus aktiviere]' \
            '--verbose[Verbose-Modus us Konfigurationsdatei überschriibe]' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurationsbereich (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Transporttyp (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Umgäbigsvariable festlege (z.B. -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[WebSocket-Header festlege]:header:' \
            '--client-id[OAuth-Client-ID für HTTP/SSE-Server]:clientId:' \
            '--client-secret[OAuth-Client-Secret abfrage (oder Umgäbigsvariable MCP_CLIENT_SECRET setze)]' \
            '--callback-port[Feste Port für de OAuth-Callback (für Server, wo vorregistrierti Redirect-URIs verlanged)]:port:' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurationsbereich (local, user, project) - us beschtähendem Bereich entferne, falls nöd aagäh]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Hilf aazeige]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurationsbereich (local, user, project)]:scope:(local user project)' \
            '--client-secret[OAuth-Client-Secret abfrage (oder Umgäbigsvariable MCP_CLIENT_SECRET setze)]' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurationsbereich (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Hilf aazeige]'
          ;;
        login)
          _arguments \
            '--no-browser[Autorisierigs-URL usgäh statt en Browser z öffne (für SSH-/Headless-Sitzige)]' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Erwitterig oder Marketplace-Manifest validiere'
    'marketplace:Claude Code-Marktplätz verwalte'
    'list:Installierti Erwitterige uflistä'
    'details:Komponente-Inventar u vorussichtlichi Token-Choste für e Erwitterig aazeige'
    'configure:Optione vo ere Erwitterig aazeige u weli devo nöd gsetzt sind, oder Wärt us stdin speichere'
    'install:Erwitterig vo verfüegbare Marktplätz installiere'
    'i:Erwitterig vo verfüegbare Marktplätz installiere (Kurzform für install)'
    'init:Nöii Erwitterig grüste (wird i nächster Sitzig automatisch glade)'
    'new:Grüst für e nöii Erwitterig aalege (Alias für init)'
    'uninstall:Installierti Erwitterig deinstalliere'
    'remove:Installierti Erwitterig deinstalliere (Alias für uninstall)'
    'enable:Deaktiviärti Erwitterig aktiviere'
    'disable:Aktivierti Erwitterig deaktiviere'
    'update:Erwitterig uf di nöischti Version aktualisiere'
    'eval:Eval-Fäll gäge e Erwitterig usfüehre u bewerteti Ergebnis mälde'
    'prune:Automatisch installierti Abhängigkeite entferne, wo nüme brucht wärde'
    'autoremove:Automatisch installierti Abhängigkeite entferne, wo nüme brucht wärde (Alias für prune)'
    'tag:En {name}--v{version} Git-Tag für e Erwitterigs-Veröffentlichig erstelle'
    'test:Tests vo eme Mod usfüehre'
    'help:Hilf aazeige'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Hilf aazeige]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin-Befehle' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Warnige als Fähler behandle (Exit-Code 1)]' \
            '--profile[Au mit exit 1 beände, wänn de benännti Katalog e Iireichig vo de Erwitterig bi ere Prüefig ablehne würd, wo dä Befehl uusfüehrt]:name:(directory)' \
            '--json[Validierigsbricht als JSON usgäh (glichi Exit-Codes)]' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Installationsbereich]:scope:(user project local)' \
            '--accept-command[De vom Marktplatz deklarierti Befehl akzeptiere, dä sini sha256 en früenere --json-Lauf als shownCommand.sha256 gmäldet hät]:sha256:' \
            '*--config[E im Erwitterigs-Manifest deklarierti userConfig-Option setze (wiiderholbar)]:key=value:' \
            '--marketplace[D Erwitterig mit ihrem blosse Name vom Marktplatz a dere Quälle installiere (owner/repo, git- oder https-URL, oder Pfad) u ihn bi Bedarf zersch hinzuefüege]:source:' \
            '--registry[Für e package@npm-Installation: vo däm npm-Registry uflöse u abelade]:url:' \
            '(-y --yes)'{-y,--yes}'[De aazeigti, vom Marktplatz deklarierte Befehl ohni Bestätigigsabfrag akzeptiere]' \
            '--json[Ei maschinelesbari Ergebniszeile statt de Mäldig für Mänsche usgäh]' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Installationsbereich]:scope:(user project local)' \
            '--keep-data[Persistänts Dateverzeichnis vo de Erwitterig bhalte]' \
            '--prune[Au automatisch installierti Abhängigkeite entferne, wo nüme brucht wärde]' \
            '(-y --yes)'{-y,--yes}'[Bestätigigsabfrag für --prune überspringe]' \
            '--json[Ei maschinelesbari Ergebniszeile statt de Mäldig für Mänsche usgäh (nöd mit --prune)]' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Installationsbereich]:scope:(user project local)' \
            '--json[Ei maschinelesbari Ergebniszeile statt de Mäldig für Mänsche usgäh]' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Alli aktivierte Erwitterige deaktiviere]' \
            '(-s --scope)'{-s,--scope}'[Installationsbereich]:scope:(user project local)' \
            '--json[Ei maschinelesbari Ergebniszeile statt de Mäldig für Mänsche usgäh]' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '--accept-command[De vom Marktplatz deklarierti Befehl akzeptiere, dä sini sha256 en früenere --json-Lauf als shownCommand.sha256 gmäldet hät]:sha256:' \
            '(-s --scope)'{-s,--scope}'[Installationsbereich]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[De aazeigti, vom Marktplatz deklarierte Befehl ohni Bestätigigsabfrag akzeptiere]' \
            '--json[Ei maschinelesbari Ergebniszeile statt de Mäldig für Mänsche usgäh]' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Als JSON usgäh]' \
            '--available[Verfüegbari Erwitterige us Marktplätz iischliesse (bruucht --json)]' \
            '--data-size[S gspeicherte Dateverzeichnis vo jeder installierte Erwitterig mässe, oder nur vo de benännte Erwitterig (bruucht --json)]::plugin:_claude_installed_plugins' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Bereich, wo bereinigt wird]:scope:(user project local)' \
            '--dry-run[Uflistä, was entfernt würd, ohni öppis z entferne]' \
            '(-y --yes)'{-y,--yes}'[Bestätigigsabfrag überspringe]' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]'
          ;;
        configure)
          _arguments \
            '--json[Als JSON usgäh]' \
            '--values-stdin[Optionswärt us stdin als JSON-Objekt vo einzeilige Strings lese; nöd aagäbni Optione bhalted ire Wärt]' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Beschriibig im Manifest]:text:' \
            '--author[Name vom Autor (Standard: git config user.name)]:name:' \
            '--author-email[E-Mail vom Autor (Standard: git config user.email)]:email:' \
            '--with[Zuesätzlich aazlegendi Komponente]:components:' \
            '(-f --force)'{-f,--force}'[Vorhandnigs .claude-plugin/ am Ziel überschriibe]' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '1:name:'
          ;;
        eval)
          if [[ $words[2] == init ]]; then
            _arguments \
              '--bare[E leeri Vorlag schriibe statt s Interview dureziehe]' \
              '--eval-dir[Verzeichnis unterhalb vom aktuelle Verzeichnis, wo d Cases drii gschribe wärde]:dir:_directories' \
              '(-i --interactive)'{-i,--interactive}'[S Erstelligs-Interview dureziehe (bruucht es interaktivs Terminal)]' \
              '(-h --help)'{-h,--help}'[Hilf aazeige]' \
              '::name:'
            return
          fi
          _arguments \
            '--case[Fäll nach Name-Glob filtere]:glob:' \
            '*--tag[Fäll nach Tag filtere (wiiderholbar)]:tag:' \
            '--runs[Durchläuf pro Fall überschriibe (Standard: case.runs, suscht 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Bis zu n Agente-Durchläuf glichzitig usfüehre (1-8; Standard 1)]:n:' \
            '--model[Modell für alli Fäll überschriibe]:model:_claude_model_names' \
            '--judge-model[Modell vom LLM-Bewärter überschriibe (Standard: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Harti Choste-Obergränze; bim Erreiche abbräche u Teilergebnis mälde (Exit-Code 2)]:usd:' \
            '--output-dir[Verzeichnis für aggregate-result.json]:dir:_directories' \
            '--eval-dir[Verzeichnisname (unterhalb vo de Erwitterig) mit de Eval-Fäll]:dir:' \
            '--json[Vollständigs Laufergebnis als JSON uf stdout usgäh oder i die .json-Datei schriibe]::path:_files' \
            '--threshold[Mit Exit-Code 1 beände, wänn de Score vo eme Fall under däm Schwällewärt liit (Standard: 1.0)]:threshold:' \
            '*--allow-tools[Freigab vom Bediener für iigschränkti Wärkzüg (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '*--disallow-tools[Iibauti Wärkzüg, wo Claude i jedem Fall vorenthalte wärde, au wänn si erlaubt sind]:tools:' \
            '(--no-scaffold)--scaffold[scaffold_script vo jedem Fall usfüehre (füehrt vom Autor glieferts Bash under dim Benutzer us; standardmässig us)]' \
            '(--scaffold)--no-scaffold[scaffold_script usdrücklich überspringe]' \
            '--trust-plugin[Bestätige, dass du dere Erwitterig u ire Eval-Suite vertrausch, u d Vertrauensabfrag bim erste Lauf überspringe (für CI)]' \
            '--ablation[Zuesätzlich e Vergliichsgruppe (Baseline) ohni Erwitterig usfüehre u d Score-Differänz mälde]:mode:(none with-without)' \
            '--mocks[Mock-Stellvertreter für MCP-Server us <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Mit --mocks record: au di echte MCP-Serverprozäss ohni Mock starte]' \
            '--keep-temp[Scaffold-Verzeichnis zum Debugge bhalte]' \
            '--verbose[Trace-Eräignis pro Nachricht is Debug-Log schriibe]' \
            '--report[Eigeständige HTML-Bricht a dä Pfad statt is Ergebnisverzeichnis schriibe]:path:_files' \
            '(--no-publish)--publish-report[Zuesätzlich d Veröffentlichig vom Bricht uf claude.ai verlange]' \
            '(--publish-report)--no-publish[HTML-Bricht nur lokal bhalte; nöd uf claude.ai veröffentliche]' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '::target: _alternative "commands\:eval command\:(init)" "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Tag nach em Erstelle uf --remote pushe]' \
            '--dry-run[Usgäh, was taggt würd, ohni de Tag z erstelle]' \
            '(-f --force)'{-f,--force}'[Prüefige uf nöd committeti Änderige u scho vorhandene Tag überspringe]' \
            '(-m --message)'{-m,--message}'[Aamerkig vom Tag (%s staht für d Version)]:msg:' \
            '--remote[Remote, wo mit --push dethi pusht wird]:name:' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Marktplatz vo URL, Pfad oder GitHub-Repository hinzuefüege'
    'list:Konfigurierti Marktplätz uflistä'
    'remove:Konfigurierte Marktplatz entferne'
    'rm:Konfigurierte Marktplatz entferne (Alias für remove)'
    'update:Marktplatz vo Quälle aktualisiere - alli aktualisiere, wänn käi Name aagäh'
    'help:Hilf aazeige'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Hilf aazeige]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace-Befehle' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Checkout per git sparse-checkout uf bestimmti Verzeichnis beschränke (für Monorepos)]:paths:' \
            '--scope[Wo de Marktplatz deklariert wird]:scope:(user project local)' \
            '--json[Ei maschinelesbari Ergebniszeile als letschti Zeile uf stdout usgäh]' \
            '--claudeai[De Marktplatz mit däm Name hinzuefüege, wo claude.ai für dich hostet]' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Als JSON usgäh]' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Marktplatz-Deklaration us eme bestimmte Iischtelligsbereich entferne (wäglah, zum si us allne Bereich z entferne)]:scope:(user project local)' \
            '--json[Ei maschinelesbari Ergebniszeile als letschti Zeile uf stdout usgäh]' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '--json[Mit eme Marktplatz-Name: ei maschinelesbari Ergebniszeile als letschti Zeile uf stdout usgäh]' \
            '(-h --help)'{-h,--help}'[Hilf aazeige]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Installation erzwinge, au wänns scho installiert isch]' \
    '(-h --help)'{-h,--help}'[Hilf aazeige]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Zuesätzlichs Verzeichnis für Wärkzügzuegang i versändte Sitzige erlaube]:directory:_directories' \
    '--agent[Standard-Agent für us de Agente-Aasicht versändti Sitzige]:agent:_claude_agent_names' \
    '--all[Mit --json: au abgschlosseni Hintergrundsitzige iischliesse]' \
    '--allow-dangerously-skip-permissions[Bypass-Berechtigigsmodus für versändti Sitzige verfüegbar mache]' \
    '--cwd[Nur under em Pfad gstartete Hintergrundsitzige aazeige]:path:_directories' \
    '--dangerously-skip-permissions[Alias für --permission-mode bypassPermissions]' \
    '--effort[Standard-Ufwandsstufe für versändti Sitzige]:level:(low medium high xhigh max)' \
    '--json[Aktivi Sitzige als JSON-Array usgäh u beände]' \
    '*--mcp-config[MCP-Server-Konfiguration für versändti Sitzige aawände]:config:' \
    '--model[Standardmodell für us de Agente-Aasicht versändti Sitzige]:model:_claude_model_names' \
    '--permission-mode[Standard-Berechtigigsmodus für versändti Sitzige]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Erwitterige us em Verzeichnis für d Agente-Aasicht u versändti Sitzige lade]:path:_directories' \
    '--setting-sources[Kommatrennte Liste vo Iischtelligsquälle zum Lade (user, project, local)]:sources:' \
    '--settings[Iischtelligsdatei oder JSON-String zum Aawände]:file-or-json:_files' \
    '--strict-mcp-config[Nur MCP-Server us --mcp-config i versändte Sitzige verwände]' \
    '--restricted[Versändti Sitzige im iigschränkte Modus starte]' \
    '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Bi dim Anthropic-Konto aamälde'
    'logout:Vo dim Anthropic-Konto abmälde'
    'status:Authentifizierigsstatus aazeige'
    'help:Hilf aazeige'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth-Befehle' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[E-Mail-Adrässe uf de Aamäldesite vorusfülle]:email:' \
            '--sso[SSO-Aamäldig erzwinge]' \
            '(--claudeai)--console[Anthropic Console (Abrächnig nach API-Nutzig) statt Claude-Abonnemänt verwände]' \
            '(--console)--claudeai[Claude-Abonnemänt verwände (Standard)]' \
            '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]'
          ;;
        status)
          _arguments \
            '(--text)--json[Als JSON usgäh (Standard)]' \
            '(--json)--text[Als läsbare Text usgäh]' \
            '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Di effektivi Auto-Modus-Konfiguration als JSON usgäh'
    'critique:KI-Feedback zu dine benutzerdefinierte Auto-Modus-Regle übercho'
    'defaults:Di Standard-Auto-Modus-Regle als JSON usgäh'
    'reset:Auto-Modus-Konfiguration uf di uusglieferte Standardwärt zrucksetze'
    'help:Hilf aazeige'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode-Befehle' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Verwändets Modell überschriibe]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]'
          ;;
        defaults)
          _arguments \
            '--label[Nur Regle aazeige, wo ires Label mit däm Präfix aafangt (Gross-/Chliischriibig egal)]:prefix:' \
            '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Bestätigigsabfrag überspringe]' \
            '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Pfad zur Gateway-YAML-Konfiguration]:path:_files' \
    '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Alli Claude Code-Status für e Projäkt lösche (Transkript, Ufgabe, Dateiverlauf, Konfigurationsiitrag)'
    'help:Hilf aazeige'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project-Befehle' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Uflistä, was glöscht würd, ohni öppis z lösche]' \
            '(-y --yes)'{-y,--yes}'[Bestätigigsabfrag überspringe]' \
            '(-i --interactive)'{-i,--interactive}'[Vor em Lösche bi jedem Iitrag nachfrage]' \
            '(1)--all[Status vo allne Projäkt lösche (schliesst en Pfad us)]' \
            '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_purge() {
  _arguments \
    '--dry-run[Uflistä, was glöscht würd, ohni öppis z lösche]' \
    '(-y --yes)'{-y,--yes}'[Bestätigigsabfrag überspringe]' \
    '(-i --interactive)'{-i,--interactive}'[Vor em Lösche bi jedem Iitrag nachfrage]' \
    '(1)--all[Status vo allne Projäkt lösche (schliesst en Pfad us)]' \
    '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]' \
    '(--all)::path:_directories'
}

_claude_ultrareview() {
  _arguments \
    '--json[Rohi bugs.json-Nutzlast statt formatierti Ergebnis usgäh]' \
    '--timeout[Maximali Minute, wo uf de Abschluss vo de Überprüefig gwartet wird (Standard: 45)]:minutes:' \
    '(--no-post)--post[Ergebnis vo de fertige Überprüefig i dim Name im PR poste (nur PR-Ziel; en einzige eifache Kommentar, käis Review)]' \
    '(--post)--no-post[Ergebnis nöd im PR poste (Standard)]' \
    '--trust-workspace[Em aktuelle Ordner nur für dä Lauf vertroue, ohni z frööge (für Skripts u CI)]' \
    '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Alli laufende Hintergrundsitzige nöi starte]' \
    '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Au di nöd pushte Commits u nöd committete Änderige vom Worktree verwärfe (d vo eme früenere claude rm gmäldeti commit@worktree-id übergäh)]:commit@worktree-id:' \
    '--force-remove-worktree[Worktree-Verzeichnis lösche, obwohl de WorktreeRemove-Hook oder git es nöd hät chöne entferne (d vo eme früenere claude rm gmäldeti worktree-id übergäh)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]' \
    '1:session:_claude_background_sessions'
}

_claude_self_hosted_runner() {
  _arguments \
    '--api-url[API-Basis-URL (Standard: https://api.anthropic.com)]:url:' \
    '--environment-secret-file[Pfad zur Gheimnisdatei vo de Umgäbig]:path:_files' \
    '--lock-to-account[Runner bi de Registrierig a es einzigs Konto binde]:id:' \
    '--client-label[Observability-Label, wo bi de Registrierig gschickt wird (Standard: hostname)]:label:' \
    '(--proxy-authorization-file --agent-proxy-url)--proxy-authorization-command[Befehl, dä sini stdout de Proxy-Authorization-Header für Egress-Proxys isch]:shell command:' \
    '(--proxy-authorization-command --agent-proxy-url)--proxy-authorization-file[Datei mit em Proxy-Authorization-Header für Egress-Proxys]:path:_files' \
    '(--proxy-authorization-command --proxy-authorization-file)--agent-proxy-url[Jedi Sitzig über de Agent-Proxy a dere URL leite (nur https)]:url:' \
    '--capacity[Maximali Aazahl glichzittigi Sitzige (Standard: 1)]:n:' \
    '--base-dir[Basisverzeichnis für Repo-Checkouts (Standard: /workspace)]:path:_directories' \
    '--exec-path[Binary, wo für Chind-Sitzige gstartet wird (Standard: die Binary)]:path:_files' \
    '--hooks-dir[Verzeichnis vo Lifecycle-Hook-Skripts (checkout, command, post-session)]:path:_directories' \
    '--session-stop-grace-sec[Wie lang nach em Änd vo ere Sitzig uf es suubers Beände gwartet wird (Standard: 5)]:n:' \
    '--post-session-hook-timeout-sec[SIGTERM-Budget für de post-session-Hook (Standard: 60)]:n:' \
    '--checkout-hook-timeout-min[Echtzit-Budget für jede Lauf vom checkout-Hook (Standard: 30; 0 deaktiviert)]:n:' \
    '--drain-wait-sec[Bi SIGTERM/SIGINT bis zu N Sekunde uf laufendi Arbet warte (Standard: 0)]:n:' \
    '--drain-marker-file[Markierigsdatei, mit dere de Host es geordnets Usleere aakündigt]:path:_files' \
    '*--git-ssh-rewrite[Quäll-URLs https://<host>/... uf git@<host>:... umschriibe (wiiderholbar)]:host:' \
    '*--git-host-rewrite[Quäll-URLs https://<f>/... uf https://<t>/... umschriibe (wiiderholbar)]:from=to:' \
    '--use-anthropic-git-proxy[Vo Anthropic verwaltets git verwände. WARNIG: löscht u ersetzt d git-Konfiguration uf HOME-Ebeni, nur under eme eigete Konto verwände]' \
    '--configure-git[Globali git-Identität setze u Commit-Signierig über de Anthropic-Signierdienst aktiviere. Schriibt ~/.gitconfig]' \
    '--push-outcome-on-release[Verfolgti Ergebnis-Branches pushe, wänn de Runner e Sitzig unvollständig beändet]' \
    '--trust-workspace[Persistents Vertroue für d Repo-Pfäd vo jeder Sitzig vorbelegge (Standard: true)]::bool:(true false)' \
    '--remove-session-state[Zuestand pro Sitzig entferne, wänn e Sitzig ändet (Standard: false)]::bool:(true false)' \
    '--diff-finds-nested-repository[Es Repository, wo in en Underordner klont isch, im Changes-Bereich aazeige; bruucht --capacity 1 (Standard: false)]::bool:(true false)' \
    '--confine-repo-settings[Modus vom Schutz, wo im Repo committeti Iischtellige iischränkt (Standard: warn)]:mode:(warn enforce off)' \
    '--server-auto-mode-lists[Weli auto-mode-Klassifizierer-Liste vom Server e Sitzig dörf übercho (Standard: no-allow)]:mode:(all no-allow none)' \
    '--host-config-snapshot[Wo de Startschnappschuss vo de Host-Konfiguration ghalte wird (Standard: disk)]:mode:(disk memory)' \
    '--health-port[Port für de /healthz-HTTP-Listener (Standard: 8080; 0 deaktiviert)]:port:' \
    '--log-level[Log-Level (Standard: info)]:level:(info debug)' \
    '--log-file[Runner-Logs zuesätzlich im Aahängmodus in e Datei schriibe]:path:_files' \
    '--exit-if-unused-min[Runner beände, wänn er N Minute lang nie Arbet zuegwise überchunnt]:n:' \
    '--drain-grace-sec[Sekunde, wo nach em Änd vo aktive Sitzige no wiiter nach Arbet abgfrögt wird (Standard: 0)]:n:' \
    '--retire-at[Runner zu dere absolute Unix-Zit, in Sekunde, usser Betrieb neh]:epoch-seconds:' \
    '--defer-shutdown-max-min[Bim erste SIGTERM/SIGINT kei Arbet meh aaneh u s Abeschalte M Minute spöter abschliesse (Standard: 0)]:m:' \
    '--release-idle-session-min[Sitzigsplatz nach N Minute ohni Benutzeriigab freigäh]:n:' \
    '--startup-timeout-min[Sitzigsplatz freigäh, wänn de Chindprozess nach N Minute no nöd fertig gstartet isch (Standard: 15; 0 deaktiviert)]:n:' \
    '--kill-session-after-min[Echtzit-Läbesduur vo eme Sitzigs-Chindprozess uf N Minute begränze]:n:' \
    '--debug-token-dir[NUR ZUM DEBUGGE: schriibt aktivi Tokens uf d Disk. Nöd in de Produktion verwände]:path:_directories' \
    '(-h --help)'{-h,--help}'[Die Hilfmäldig aazeige]'
}

_claude_remote_control() {
  _arguments \
    '--name[Name für d Sitzig (aazeigt in claude.ai/code)]:name:' \
    '--remote-control-session-name-prefix[Präfix für automatisch generierti Sitzigsnäme (Standard: hostname)]:prefix:' \
    '(-c --continue --session-id)'{-c,--continue}'[Wieder mit de Sitzig verbinde, wo zletscht für das Verzeichnis oder eine vo sine Git-Worktrees ufzeichnet worde isch]' \
    '(-c --continue --session-id)--session-id[Wieder mit ere bestimmte Sitzig per ID verbinde]:id:' \
    '--permission-mode[Berechtigigs-Modus für gstarteti Sitzige]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)' \
    '(--no-chrome)--chrome[Claude in Chrome für gstarteti Sitzige aktiviere]' \
    '(--chrome)--no-chrome[Claude in Chrome für gstarteti Sitzige deaktiviere]' \
    '(-d --debug)'{-d,--debug}'[Debug-Modus mit optionaler Kategoriefilterig aktiviere]::filter:' \
    '--debug-file[Debug-Logs in e Datei schriibe]:path:_files' \
    '(-v --verbose)'{-v,--verbose}'[Usführlichi Usgab aktiviere]' \
    '--spawn[Startmodus (Standard: same-dir)]:mode:(same-dir worktree session)' \
    '--capacity[Maximali Aazahl glichzittigi Sitzige im worktree- oder same-dir-Modus (Standard: 32)]:n:' \
    '(--no-create-session-in-dir)--create-session-in-dir[Im aktuelle Verzeichnis vorab e Sitzig erstelle (Standard)]' \
    '(--create-session-in-dir)--no-create-session-in-dir[Im aktuelle Verzeichnis kei Sitzig vorab erstelle]' \
    '(-h --help)'{-h,--help}'[Die Hilf aazeige]'
}

_claude_daemon() {
  local -a daemon_commands common_options
  daemon_commands=(
    'run:De Supervisor im Vordergrund uusfüehre'
    'status:Daemon-PID, Version u Laufzit aazeige'
    'logs:Daemon-Log verfolge (Ctrl-C zum Stoppe)'
    'uninstall:De Hintergrunddienst entferne (launchctl/systemd)'
    'stop:De Supervisor abeschalte u Hintergrundsitzige beände'
  )
  common_options=(
    '--json-path[Konfigurationsdatei (Standard: ~/.claude/daemon.json)]:path:_files'
    '--log-file[Log-Datei (Standard: ~/.claude/daemon.log)]:path:_files'
    '(-h --help)'{-h,--help}'[Die Hilf aazeige]'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    $common_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'daemon-Befehle' daemon_commands
      ;;
    args)
      case $words[1] in
        run)
          _arguments \
            $common_options \
            '::json-path:_files'
          ;;
        stop)
          _arguments \
            $common_options \
            '--any[Au en vorüebergehende Daemon (kei Dienst) stoppe]' \
            '--keep-workers[Abtrännti Sitzige wiiterlaufe lah]'
          ;;
        status|logs|uninstall)
          _arguments \
            $common_options
          ;;
      esac
      ;;
  esac
}

_claude_import() {
  _arguments \
    '--dry-run[Aazeige, was importiert würd, ohni öppis z schriibe]' \
    '--yes[Interaktivi Uuswahl überspringe (i Headless-Umgäbige --yes=<digest> us de /import-Vorschau übergäh)]' \
    '(-h --help)'{-h,--help}'[Hilf für Befehl aazeige]' \
    '::source:(codex gemini cursor)'
}

# compinit autoloads this file, and that first call only defines the functions
# above: complete right away so the first TAB already works. Sourced directly,
# there is nothing to complete yet, only the registration.
if [[ $funcstack[1] == _claude ]]; then
  _claude "$@"
else
  (( $+_comps[claude] )) || compdef _claude claude
fi
