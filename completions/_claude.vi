_claude_self_hosted_runner() {
  _arguments \
    '--api-url[URL cơ sở của API (mặc định: https://api.anthropic.com)]:url:' \
    '--environment-secret-file[Đường dẫn tới file bí mật của môi trường]:path:_files' \
    '--lock-to-account[Khóa runner vào một tài khoản duy nhất khi đăng ký]:id:' \
    '--client-label[Nhãn quan sát gửi khi đăng ký (mặc định: hostname)]:label:' \
    '(--proxy-authorization-file --agent-proxy-url)--proxy-authorization-command[Lệnh có stdout là header Proxy-Authorization cho các proxy đi ra]:shell command:' \
    '(--proxy-authorization-command --agent-proxy-url)--proxy-authorization-file[File chứa header Proxy-Authorization cho các proxy đi ra]:path:_files' \
    '(--proxy-authorization-command --proxy-authorization-file)--agent-proxy-url[Định tuyến mọi phiên qua agent proxy tại URL này (chỉ https)]:url:' \
    '--capacity[Số phiên đồng thời tối đa (mặc định: 1)]:n:' \
    '--base-dir[Thư mục cơ sở cho các bản checkout repo (mặc định: /workspace)]:path:_directories' \
    '--exec-path[File thực thi để khởi chạy các phiên con (mặc định: file thực thi này)]:path:_files' \
    '--hooks-dir[Thư mục chứa các script hook vòng đời (checkout, command, post-session)]:path:_directories' \
    '--session-stop-grace-sec[Thời gian chờ thoát sạch sau khi một phiên kết thúc (mặc định: 5)]:n:' \
    '--post-session-hook-timeout-sec[Thời gian cho phép sau SIGTERM đối với hook post-session (mặc định: 60)]:n:' \
    '--checkout-hook-timeout-min[Giới hạn thời gian thực cho mỗi lần chạy hook checkout (mặc định: 30; 0 để tắt)]:n:' \
    '--drain-wait-sec[Khi nhận SIGTERM/SIGINT, chờ tối đa N giây cho công việc đang chạy (mặc định: 0)]:n:' \
    '--drain-marker-file[File đánh dấu mà máy chủ dùng để thông báo dừng nhận việc êm ái]:path:_files' \
    '*--git-ssh-rewrite[Viết lại URL nguồn https://<host>/... thành git@<host>:... (có thể lặp lại)]:host:' \
    '*--git-host-rewrite[Viết lại URL nguồn https://<f>/... thành https://<t>/... (có thể lặp lại)]:from=to:' \
    '--use-anthropic-git-proxy[Dùng git do Anthropic quản lý. CẢNH BÁO: xóa và thay thế cấu hình git cấp HOME, chỉ dùng dưới một tài khoản riêng]' \
    '--configure-git[Đặt danh tính git toàn cục và bật ký commit qua dịch vụ ký của Anthropic. Ghi vào ~/.gitconfig]' \
    '--push-outcome-on-release[Đẩy các nhánh kết quả được theo dõi khi runner chủ động kết thúc một phiên chưa hoàn tất]' \
    '--trust-workspace[Khởi tạo sẵn trạng thái tin cậy lâu dài cho các đường dẫn repo của từng phiên (mặc định: true)]::bool:(true false)' \
    '--remove-session-state[Xóa trạng thái riêng của phiên khi phiên kết thúc (mặc định: false)]::bool:(true false)' \
    '--diff-finds-nested-repository[Hiển thị repository được clone vào thư mục con trong khung Changes; yêu cầu --capacity 1 (mặc định: false)]::bool:(true false)' \
    '--confine-repo-settings[Chế độ bảo vệ giới hạn các cài đặt được commit trong repo (mặc định: warn)]:mode:(warn enforce off)' \
    '--server-auto-mode-lists[Các danh sách bộ phân loại chế độ tự động từ máy chủ mà một phiên có thể nhận (mặc định: no-allow)]:mode:(all no-allow none)' \
    '--host-config-snapshot[Nơi lưu ảnh chụp cấu hình máy chủ lúc khởi động (mặc định: disk)]:mode:(disk memory)' \
    '--health-port[Cổng cho listener HTTP /healthz (mặc định: 8080; 0 để tắt)]:port:' \
    '--log-level[Mức nhật ký (mặc định: info)]:level:(info debug)' \
    '--log-file[Đồng thời ghi nhật ký runner vào một file ở chế độ nối thêm]:path:_files' \
    '--exit-if-unused-min[Thoát runner nếu không được giao việc nào trong N phút]:n:' \
    '--drain-grace-sec[Số giây tiếp tục thăm dò việc mới sau khi các phiên đang hoạt động kết thúc (mặc định: 0)]:n:' \
    '--retire-at[Cho runner nghỉ hưu tại thời điểm Unix tuyệt đối này, tính bằng giây]:epoch-seconds:' \
    '--defer-shutdown-max-min[Khi nhận SIGTERM/SIGINT lần đầu, ngừng nhận việc và hoàn tất tắt sau M phút (mặc định: 0)]:m:' \
    '--release-idle-session-min[Giải phóng một slot phiên sau N phút không có đầu vào của người dùng]:n:' \
    '--startup-timeout-min[Giải phóng một slot phiên nếu tiến trình con chưa khởi động xong sau N phút (mặc định: 15; 0 để tắt)]:n:' \
    '--kill-session-after-min[Giới hạn thời gian sống thực của một phiên con ở N phút]:n:' \
    '--debug-token-dir[CHỈ ĐỂ GỠ LỖI: ghi token đang dùng ra đĩa. Không dùng trong môi trường production]:path:_directories' \
    '(-h --help)'{-h,--help}'[Hiển thị thông báo trợ giúp này]'
}

_claude_remote_control() {
  _arguments \
    '--name[Tên cho phiên (hiển thị trong claude.ai/code)]:name:' \
    '--remote-control-session-name-prefix[Tiền tố cho tên phiên được tạo tự động (mặc định: hostname)]:prefix:' \
    '(-c --continue --session-id)'{-c,--continue}'[Gắn lại vào phiên được ghi gần nhất cho thư mục này hoặc một trong các git worktree của nó]' \
    '(-c --continue --session-id)--session-id[Gắn lại vào một phiên cụ thể theo ID]:id:' \
    '--permission-mode[Chế độ quyền cho các phiên được khởi chạy]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)' \
    '(--no-chrome)--chrome[Bật Claude in Chrome cho các phiên được khởi chạy]' \
    '(--chrome)--no-chrome[Tắt Claude in Chrome cho các phiên được khởi chạy]' \
    '(-d --debug)'{-d,--debug}'[Bật chế độ gỡ lỗi với tùy chọn lọc theo danh mục]::filter:' \
    '--debug-file[Ghi nhật ký gỡ lỗi vào file]:path:_files' \
    '(-v --verbose)'{-v,--verbose}'[Bật đầu ra chi tiết]' \
    '--spawn[Chế độ khởi chạy (mặc định: same-dir)]:mode:(same-dir worktree session)' \
    '--capacity[Số phiên đồng thời tối đa ở chế độ worktree hoặc same-dir (mặc định: 32)]:n:' \
    '(--no-create-session-in-dir)--create-session-in-dir[Tạo sẵn một phiên trong thư mục hiện tại (mặc định)]' \
    '(--create-session-in-dir)--no-create-session-in-dir[Không tạo sẵn phiên trong thư mục hiện tại]' \
    '(-h --help)'{-h,--help}'[Hiển thị trợ giúp này]'
}

_claude_daemon() {
  local -a daemon_commands common_options
  daemon_commands=(
    'run:Chạy trình giám sát ở tiền cảnh'
    'status:Hiển thị pid, phiên bản, thời gian chạy của daemon'
    'logs:Theo dõi nhật ký daemon (Ctrl-C để dừng)'
    'uninstall:Gỡ bỏ dịch vụ nền (launchctl/systemd)'
    'stop:Tắt trình giám sát và kết thúc các phiên nền'
  )
  common_options=(
    '--json-path[File cấu hình (mặc định: ~/.claude/daemon.json)]:path:_files'
    '--log-file[File nhật ký (mặc định: ~/.claude/daemon.log)]:path:_files'
    '(-h --help)'{-h,--help}'[Hiển thị trợ giúp này]'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    $common_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'daemon commands' daemon_commands
      ;;
    args)
      case $words[1] in
        run)
          _arguments \
            $common_options \
            '::json-path:_files'
          ;;
        stop)
          _arguments \
            $common_options \
            '--any[Cũng dừng daemon tạm thời (không phải dịch vụ)]' \
            '--keep-workers[Để các phiên đã tách tiếp tục chạy]'
          ;;
        status|logs|uninstall)
          _arguments \
            $common_options
          ;;
      esac
      ;;
  esac
}

_claude_import() {
  _arguments \
    '--dry-run[Hiển thị những gì sẽ được nhập mà không ghi gì cả]' \
    '--yes[Bỏ qua bộ chọn tương tác (trên môi trường headless, truyền --yes=<digest> từ bản xem trước /import)]' \
    '(-h --help)'{-h,--help}'[Hiển thị trợ giúp cho lệnh]' \
    '::source:(codex gemini cursor)'
}

# compinit autoloads this file, and that first call only defines the functions
# above: complete right away so the first TAB already works. Sourced directly,
# there is nothing to complete yet, only the registration.
if [[ $funcstack[1] == _claude ]]; then
  _claude "$@"
else
  (( $+_comps[claude] )) || compdef _claude claude
fi
