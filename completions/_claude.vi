#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Cấu hình và quản lý các MCP server'
    'plugin:Quản lý các plugin của Claude Code'
    'agents:Quản lý các agent nền'
    'attach:Mở một phiên nền trong terminal này'
    'logs:In đầu ra terminal gần đây của một phiên nền'
    'stop:Dừng một phiên nền (cuộc trò chuyện của phiên được giữ lại)'
    'respawn:Khởi động lại một phiên nền để phiên chạy phiên bản Claude Code hiện tại'
    'rm:Xóa một phiên nền, và cả worktree của phiên khi việc đó an toàn'
    'auth:Quản lý xác thực'
    'auto-mode:Kiểm tra hoặc đặt lại cấu hình bộ phân loại chế độ tự động'
    'gateway:Chạy gateway xác thực/telemetry cho doanh nghiệp'
    'import:Nhập cấu hình từ một agent lập trình AI khác vào Claude Code'
    'project:Quản lý trạng thái dự án của Claude Code'
    'ultrareview:Chạy đánh giá mã đa agent lưu trữ trên đám mây và in ra các phát hiện'
    'setup-token:Thiết lập token xác thực dài hạn (yêu cầu đăng ký Claude)'
    'doctor:Kiểm tra sức khỏe cho công cụ tự động cập nhật của Claude Code'
    'update:Kiểm tra và cài đặt các bản cập nhật'
    'install:Cài đặt bản build gốc của Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Bật chế độ gỡ lỗi với tùy chọn lọc theo danh mục (ví dụ: "api,hooks" hoặc "!statsig,!file")]:filter:'
    '--verbose[Ghi đè cài đặt chế độ verbose từ file cấu hình]'
    '(-p --print)'{-p,--print}'[In phản hồi và thoát (để sử dụng với pipes). Lưu ý: chỉ sử dụng trong các thư mục đáng tin cậy]'
    '--output-format[Định dạng đầu ra (với --print): "text" (mặc định), "json" (kết quả đơn), hoặc "stream-json" (streaming theo thời gian thực)]:format:(text json stream-json)'
    '--json-schema[JSON schema để xác thực đầu ra có cấu trúc]:schema:'
    '--include-partial-messages[Bao gồm các phần tin nhắn khi chúng đến (với --print và --output-format=stream-json)]'
    '--input-format[Định dạng đầu vào (với --print): "text" (mặc định) hoặc "stream-json" (streaming đầu vào theo thời gian thực)]:format:(text stream-json)'
    '--mcp-debug[\[Không được khuyến nghị. Sử dụng --debug thay thế\] Bật chế độ gỡ lỗi MCP (hiển thị lỗi MCP server)]'
    '--dangerously-skip-permissions[Bỏ qua tất cả các kiểm tra quyền. Chỉ khuyến nghị cho sandbox không có truy cập internet]'
    '--allow-dangerously-skip-permissions[Bật tùy chọn bỏ qua kiểm tra quyền mà không bật theo mặc định]'
    '--restricted[Chế độ hạn chế: loại bỏ các công cụ chạy lệnh hoặc mã và WebFetch, bỏ qua các cài đặt user/project/local, và giới hạn các công cụ file trong các thư mục làm việc]'
    '--max-budget-usd[Số tiền tối đa (đô la) để chi cho các lệnh gọi API (chỉ --print)]:amount:'
    '--replay-user-messages[Gửi lại tin nhắn người dùng từ stdin trên stdout để xác nhận]'
    '--allowed-tools[Danh sách tên công cụ được phép, phân tách bằng dấu phẩy hoặc khoảng trắng (ví dụ: "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Danh sách tên công cụ được phép (định dạng camelCase)]:tools:'
    '--tools[Chỉ định danh sách các công cụ có sẵn từ bộ tích hợp. Chỉ dành cho chế độ print]:tools:'
    '--disallowed-tools[Danh sách tên công cụ không được phép, phân tách bằng dấu phẩy hoặc khoảng trắng (ví dụ: "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Danh sách tên công cụ không được phép (định dạng camelCase)]:tools:'
    '--mcp-config[Tải MCP server từ file JSON hoặc chuỗi (phân tách bằng khoảng trắng)]:configs:'
    '--system-prompt[System prompt sử dụng cho phiên làm việc]:prompt:'
    '--system-prompt-file[Đọc system prompt từ một file]:file:_files'
    '--append-system-prompt[Thêm system prompt vào system prompt mặc định]:prompt:'
    '--append-system-prompt-file[Đọc system prompt từ một file và thêm vào system prompt mặc định]:file:_files'
    '--system-prompt-snapshot[Ghi lại system prompt một lần cho mỗi cuộc trò chuyện và tái sử dụng nguyên văn ở mọi yêu cầu và khi tiếp tục (on, mặc định), hoặc tạo mới ở mỗi yêu cầu (off)]:mode:(on off)'
    '--permission-mode[Chế độ quyền sử dụng cho phiên làm việc]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Ai trả lời các lời nhắc cấp quyền khi dùng --print: "host" (SDK host hoặc --permission-prompt-tool) hoặc "none" (mọi thứ cần hỏi đều bị từ chối)]:target:(host none)'
    '--permission-prompt-tool[Công cụ MCP dùng cho các lời nhắc cấp quyền (chỉ --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Tiếp tục cuộc trò chuyện gần nhất]'
    '(-r --resume)'{-r,--resume}'[Tiếp tục một cuộc trò chuyện - chỉ định ID phiên hoặc chọn tương tác]:sessionId:_claude_sessions'
    '--fork-session[Tạo ID phiên mới thay vì sử dụng lại ID phiên gốc khi tiếp tục (với --resume hoặc --continue)]'
    '--no-session-persistence[Tắt lưu phiên - các phiên sẽ không được lưu (chỉ --print)]'
    '--model[Mô hình cho phiên hiện tại. Chỉ định alias cho mô hình mới nhất (ví dụ: '\''sonnet'\'' hoặc '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agent cho phiên hiện tại. Ghi đè cài đặt '\''agent'\'']:agent:_claude_agent_names'
    '--betas[Các header beta để bao gồm trong yêu cầu API (chỉ dành cho người dùng API key)]:betas:'
    '--fallback-model[Bật tự động chuyển sang mô hình được chỉ định khi mô hình mặc định bị quá tải (chỉ --print)]:model:_claude_model_names'
    '--settings[Đường dẫn đến file JSON cài đặt hoặc chuỗi JSON để tải các cài đặt bổ sung]:file-or-json:_files'
    '--add-dir[Các thư mục bổ sung để cho phép truy cập công cụ]:directories:_directories'
    '--ide[Tự động kết nối với IDE khi khởi động nếu có đúng một IDE hợp lệ]'
    '--desktop[Mở trong ứng dụng Claude Desktop thay vì terminal (với --continue hoặc --resume <id> để chọn phiên)]'
    '--strict-mcp-config[Chỉ sử dụng MCP server từ --mcp-config và bỏ qua tất cả các cài đặt MCP khác]'
    '--session-id[ID phiên cụ thể để sử dụng cho cuộc trò chuyện (phải là UUID hợp lệ)]:uuid:'
    '--agents[Đối tượng JSON định nghĩa các agent tùy chỉnh]:json:'
    '--setting-sources[Danh sách các nguồn cài đặt phân tách bằng dấu phẩy để tải (user, project, local)]:sources:'
    '--plugin-dir[Thư mục để tải plugin chỉ cho phiên này (có thể lặp lại)]:paths:_directories'
    '--disable-slash-commands[Tắt tất cả các lệnh slash]'
    '(--bg --background)'{--bg,--background}'[Khởi động phiên như một agent nền và trả về ngay lập tức]'
    '(-w --worktree)'{-w,--worktree}'[Tạo một git worktree mới cho phiên này (tùy chọn chỉ định tên)]::name:'
    '--tmux=-[Tạo một phiên tmux cho worktree (yêu cầu --worktree). Sử dụng các pane gốc của iTerm2 khi có sẵn; --tmux=classic cho tmux truyền thống]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Đặt tên hiển thị cho phiên này]:name:'
    '--effort[Mức độ nỗ lực cho phiên hiện tại]:level:(low medium high xhigh max)'
    '--autocompact[Kích thước cửa sổ tự động nén (auto, hoặc 100k-1M token)]:size:(auto)'
    '--debug-file[Ghi nhật ký gỡ lỗi vào một đường dẫn file cụ thể (ngầm bật chế độ gỡ lỗi)]:path:_files'
    '--from-pr[Tiếp tục một phiên được liên kết với PR theo số/URL, hoặc mở bộ chọn tương tác]::value:'
    '--teleport[Tiếp tục một phiên teleport, tùy chọn chỉ định ID phiên]::session:'
    '--cloud[Tạo một phiên đám mây với mô tả đã cho, hoặc gắn vào một phiên hiện có theo ID phiên hoặc URL claude.ai/code]::description-or-session:'
    '--environment[Tạo một phiên đám mây mới chạy trên môi trường tự lưu trữ đã chỉ định (ccpool_...)]:environment_id:'
    '--remote-control[Khởi động một phiên tương tác với Remote Control được bật (tùy chọn đặt tên)]::name:'
    '--remote-control-session-name-prefix[Tiền tố cho tên phiên Remote Control được tạo tự động]:prefix:'
    '--chrome[Bật tích hợp Claude trong Chrome]'
    '--no-chrome[Tắt tích hợp Claude trong Chrome]'
    '--plugin-url[Tải một plugin .zip từ một URL chỉ cho phiên này (có thể lặp lại)]:url:'
    '--file[Các tài nguyên file để tải xuống khi khởi động (định dạng: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Bật gợi ý prompt (phát ra một prompt tiếp theo được dự đoán trong chế độ print/SDK)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Chuyển tiếp văn bản subagent và các khối suy nghĩ dưới dạng tin nhắn (với --print và stream-json)]'
    '--include-hook-events[Bao gồm tất cả các sự kiện vòng đời hook trong luồng đầu ra (với stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Chuyển các phần theo từng máy vào tin nhắn người dùng đầu tiên để cải thiện việc tái sử dụng cache prompt]'
    '--brief[Bật công cụ SendUserMessage để giao tiếp giữa agent và người dùng]'
    '--safe-mode[Khởi động với tất cả các tùy chỉnh bị tắt (hữu ích để khắc phục sự cố cấu hình bị hỏng)]'
    '--bare[Chế độ tối thiểu: bỏ qua hooks, LSP, đồng bộ plugin, ghi công, auto-memory, và tự động khám phá CLAUDE.md]'
    '--ax-screen-reader[Kết xuất đầu ra thân thiện với trình đọc màn hình (văn bản phẳng, không có đường viền hoặc hoạt ảnh trang trí)]'
    '(-v --version)'{-v,--version}'[Hiển thị số phiên bản]'
    '(-h --help)'{-h,--help}'[Hiển thị trợ giúp cho lệnh]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude commands' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp cho lệnh]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "no arguments"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Khởi động một Claude Code MCP server'
    'add:Thêm một MCP server vào Claude Code'
    'remove:Xóa một MCP server'
    'list:Liệt kê các MCP server đã cấu hình'
    'get:Lấy thông tin chi tiết MCP server'
    'add-json:Thêm một MCP server (stdio hoặc SSE) bằng chuỗi JSON'
    'add-from-claude-desktop:Nhập MCP server từ Claude Desktop (chỉ dành cho Mac và WSL)'
    'reset-project-choices:Đặt lại tất cả các server phạm vi dự án (.mcp.json) đã được chấp thuận/từ chối trong dự án này'
    'login:Xác thực với một MCP server (HTTP, SSE, hoặc connector claude.ai)'
    'logout:Xóa thông tin đăng nhập OAuth đã lưu cho một MCP server'
    'help:Hiển thị trợ giúp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp commands' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Bật chế độ gỡ lỗi]' \
            '--verbose[Ghi đè cài đặt chế độ verbose từ file cấu hình]' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Phạm vi cấu hình (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Loại transport (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Đặt biến môi trường (ví dụ: -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Đặt WebSocket header]:header:' \
            '--client-id[OAuth client ID cho các server HTTP/SSE]:clientId:' \
            '--client-secret[Hỏi nhập OAuth client secret (hoặc đặt biến môi trường MCP_CLIENT_SECRET)]' \
            '--callback-port[Cổng cố định cho OAuth callback (cho các server yêu cầu redirect URI đăng ký trước)]:port:' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Phạm vi cấu hình (local, user, project) - xóa khỏi phạm vi hiện có nếu không chỉ định]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Phạm vi cấu hình (local, user, project)]:scope:(local user project)' \
            '--client-secret[Hỏi nhập OAuth client secret (hoặc đặt biến môi trường MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Phạm vi cấu hình (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]'
          ;;
        login)
          _arguments \
            '--no-browser[In URL ủy quyền thay vì mở trình duyệt (cho các phiên SSH/headless)]' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Xác thực một plugin hoặc marketplace manifest'
    'marketplace:Quản lý các marketplace của Claude Code'
    'list:Liệt kê các plugin đã cài'
    'details:Hiển thị kho thành phần và chi phí token dự kiến cho một plugin'
    'configure:Hiển thị các tùy chọn của một plugin và những tùy chọn chưa được đặt, hoặc lưu giá trị từ stdin'
    'install:Cài đặt một plugin từ các marketplace có sẵn'
    'i:Cài đặt một plugin từ các marketplace có sẵn (viết tắt của install)'
    'init:Tạo khung một plugin mới (tự động tải phiên tiếp theo)'
    'new:Tạo khung một plugin mới (bí danh của init)'
    'uninstall:Gỡ cài đặt một plugin đã cài'
    'remove:Gỡ cài đặt một plugin đã cài (bí danh của uninstall)'
    'enable:Bật một plugin đã tắt'
    'disable:Tắt một plugin đang bật'
    'update:Cập nhật một plugin lên phiên bản mới nhất'
    'eval:Chạy các trường hợp eval đối với một plugin và báo cáo kết quả được chấm điểm'
    'prune:Xóa các phụ thuộc được cài tự động không còn cần thiết'
    'autoremove:Xóa các phụ thuộc được cài tự động không còn cần thiết (bí danh của prune)'
    'tag:Tạo một git tag {name}--v{version} cho một bản phát hành plugin'
    'test:Chạy các bài kiểm thử của một mod'
    'help:Hiển thị trợ giúp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin commands' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Coi cảnh báo là lỗi (mã thoát 1)]' \
            '--json[Xuất báo cáo xác thực dưới dạng JSON (cùng các mã thoát)]' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Phạm vi cài đặt]:scope:(user project local)' \
            '*--config[Đặt một tùy chọn userConfig được khai báo trong manifest của plugin (có thể lặp lại)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Chấp nhận lệnh do marketplace khai báo đang hiển thị mà không cần lời nhắc xác nhận]' \
            '--json[In một dòng kết quả máy đọc được thay vì thông báo cho người đọc]' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Phạm vi cài đặt]:scope:(user project local)' \
            '--keep-data[Giữ lại thư mục dữ liệu lâu dài của plugin]' \
            '--prune[Đồng thời xóa các phụ thuộc được cài tự động không còn cần thiết]' \
            '(-y --yes)'{-y,--yes}'[Bỏ qua lời nhắc xác nhận của --prune]' \
            '--json[In một dòng kết quả máy đọc được thay vì thông báo cho người đọc (không dùng với --prune)]' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Phạm vi cài đặt]:scope:(user project local)' \
            '--json[In một dòng kết quả máy đọc được thay vì thông báo cho người đọc]' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Tắt tất cả các plugin đang bật]' \
            '(-s --scope)'{-s,--scope}'[Phạm vi cài đặt]:scope:(user project local)' \
            '--json[In một dòng kết quả máy đọc được thay vì thông báo cho người đọc]' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Phạm vi cài đặt]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Chấp nhận lệnh do marketplace khai báo đang hiển thị mà không cần lời nhắc xác nhận]' \
            '--json[In một dòng kết quả máy đọc được thay vì thông báo cho người đọc]' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Xuất dưới dạng JSON]' \
            '--available[Bao gồm các plugin có sẵn từ các marketplace (yêu cầu --json)]' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Dọn dẹp ở phạm vi]:scope:(user project local)' \
            '--dry-run[Liệt kê những gì sẽ bị xóa mà không xóa]' \
            '(-y --yes)'{-y,--yes}'[Bỏ qua lời nhắc xác nhận]' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]'
          ;;
        configure)
          _arguments \
            '--json[Xuất dưới dạng JSON]' \
            '--values-stdin[Đọc giá trị tùy chọn từ stdin dưới dạng đối tượng JSON gồm các chuỗi một dòng; các tùy chọn không được cung cấp giữ nguyên giá trị]' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Mô tả trong manifest]:text:' \
            '--author[Tên tác giả (mặc định: git config user.name)]:name:' \
            '--author-email[Email tác giả (mặc định: git config user.email)]:email:' \
            '--with[Các thành phần cũng cần tạo khung]:components:' \
            '(-f --force)'{-f,--force}'[Ghi đè .claude-plugin/ hiện có tại đích]' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Lọc các trường hợp theo glob tên]:glob:' \
            '*--tag[Lọc các trường hợp theo tag (có thể lặp lại)]:tag:' \
            '--runs[Ghi đè số lần chạy mỗi trường hợp (mặc định: case.runs, nếu không thì 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Thực hiện tối đa n lượt chạy agent cùng lúc (1-8; mặc định 1)]:n:' \
            '--model[Ghi đè mô hình cho tất cả các trường hợp]:model:_claude_model_names' \
            '--judge-model[Ghi đè mô hình chấm điểm LLM (mặc định: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Mức trần chi phí cứng; hủy và báo cáo kết quả một phần nếu chạm mức (mã thoát 2)]:usd:' \
            '--output-dir[Thư mục cho aggregate-result.json]:dir:_directories' \
            '--eval-dir[Tên thư mục (bên dưới plugin) chứa các trường hợp eval]:dir:' \
            '--json[In toàn bộ kết quả chạy dưới dạng JSON ra stdout, hoặc ghi vào file .json này]::path:_files' \
            '--threshold[Thoát với mã thoát 1 nếu điểm của bất kỳ trường hợp nào thấp hơn ngưỡng này (mặc định: 1.0)]:threshold:' \
            '*--allow-tools[Cấp quyền của người vận hành cho các công cụ bị kiểm soát (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Chạy scaffold_script của từng trường hợp (chạy bash do tác giả cung cấp dưới tài khoản của bạn; tắt theo mặc định)]' \
            '(--scaffold)--no-scaffold[Bỏ qua scaffold_script một cách tường minh]' \
            '--trust-plugin[Khẳng định rằng bạn tin tưởng plugin này và bộ eval của nó, bỏ qua lời nhắc tin cậy ở lần chạy đầu (cho CI)]' \
            '--ablation[Chạy một nhóm đối chứng cơ sở không có plugin và báo cáo chênh lệch điểm]:mode:(none with-without)' \
            '--mocks[Các bản thay thế giả lập cho MCP server, từ <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Với --mocks record: đồng thời khởi động các tiến trình MCP server thật chưa có bản giả lập]' \
            '--keep-temp[Giữ lại các thư mục scaffold để gỡ lỗi]' \
            '--verbose[Ghi các sự kiện trace theo từng tin nhắn vào nhật ký gỡ lỗi]' \
            '--report[Ghi báo cáo HTML độc lập vào đường dẫn này thay vì thư mục kết quả]:path:_files' \
            '(--no-publish)--publish-report[Đồng thời yêu cầu xuất bản báo cáo lên claude.ai]' \
            '(--publish-report)--no-publish[Chỉ giữ báo cáo HTML cục bộ; bỏ qua việc xuất bản lên claude.ai]' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Đẩy tag lên --remote sau khi tạo]' \
            '--dry-run[In những gì sẽ được gắn tag mà không tạo tag]' \
            '(-f --force)'{-f,--force}'[Bỏ qua các kiểm tra working tree có thay đổi chưa commit và tag đã tồn tại]' \
            '(-m --message)'{-m,--message}'[Thông điệp chú thích của tag (dùng %s cho phiên bản)]:msg:' \
            '--remote[Remote để đẩy lên khi dùng --push]:name:' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Thêm một marketplace từ URL, đường dẫn, hoặc GitHub repository'
    'list:Liệt kê các marketplace đã cấu hình'
    'remove:Xóa một marketplace đã cấu hình'
    'rm:Xóa một marketplace đã cấu hình (bí danh của remove)'
    'update:Cập nhật marketplace từ nguồn - cập nhật tất cả nếu không chỉ định tên'
    'help:Hiển thị trợ giúp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace commands' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Giới hạn checkout vào các thư mục cụ thể qua git sparse-checkout (cho monorepo)]:paths:' \
            '--scope[Nơi khai báo marketplace]:scope:(user project local)' \
            '--claudeai[Thêm marketplace có tên này mà claude.ai lưu trữ cho bạn]' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Xuất dưới dạng JSON]' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Xóa khai báo marketplace khỏi một phạm vi cài đặt cụ thể (bỏ trống để xóa khỏi mọi phạm vi)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Ép buộc cài đặt ngay cả khi đã được cài đặt]' \
    '(-h --help)'{-h,--help}'[Hiển thị trợ giúp]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Thư mục bổ sung để cho phép truy cập công cụ trong các phiên được điều phối]:directory:_directories' \
    '--agent[Agent mặc định cho các phiên được điều phối từ chế độ xem agent]:agent:_claude_agent_names' \
    '--all[Với --json: cũng bao gồm các phiên nền đã hoàn thành]' \
    '--allow-dangerously-skip-permissions[Cung cấp chế độ bypass-permissions cho các phiên được điều phối]' \
    '--cwd[Chỉ hiển thị các phiên nền được khởi động dưới đường dẫn]:path:_directories' \
    '--dangerously-skip-permissions[Bí danh cho --permission-mode bypassPermissions]' \
    '--effort[Mức độ nỗ lực mặc định cho các phiên được điều phối]:level:(low medium high xhigh max)' \
    '--json[In các phiên đang hoạt động dưới dạng mảng JSON và thoát]' \
    '*--mcp-config[Cấu hình MCP server để áp dụng cho các phiên được điều phối]:config:' \
    '--model[Mô hình mặc định cho các phiên được điều phối từ chế độ xem agent]:model:_claude_model_names' \
    '--permission-mode[Chế độ quyền mặc định cho các phiên được điều phối]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Tải plugin từ thư mục cho chế độ xem agent và các phiên được điều phối]:path:_directories' \
    '--setting-sources[Danh sách các nguồn cài đặt phân tách bằng dấu phẩy để tải (user, project, local)]:sources:' \
    '--settings[File cài đặt hoặc chuỗi JSON để áp dụng]:file-or-json:_files' \
    '--strict-mcp-config[Chỉ sử dụng MCP server từ --mcp-config trong các phiên được điều phối]' \
    '--restricted[Khởi động các phiên được điều phối ở chế độ hạn chế]' \
    '(-h --help)'{-h,--help}'[Hiển thị trợ giúp cho lệnh]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Đăng nhập vào tài khoản Anthropic của bạn'
    'logout:Đăng xuất khỏi tài khoản Anthropic của bạn'
    'status:Hiển thị trạng thái xác thực'
    'help:Hiển thị trợ giúp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Hiển thị trợ giúp cho lệnh]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth commands' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Điền sẵn địa chỉ email trên trang đăng nhập]:email:' \
            '--sso[Bắt buộc luồng đăng nhập SSO]' \
            '(--claudeai)--console[Sử dụng Anthropic Console (tính phí theo mức sử dụng API) thay vì đăng ký Claude]' \
            '(--console)--claudeai[Sử dụng đăng ký Claude (mặc định)]' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp cho lệnh]'
          ;;
        status)
          _arguments \
            '(--text)--json[Xuất dưới dạng JSON (mặc định)]' \
            '(--json)--text[Xuất dưới dạng văn bản dễ đọc cho người]' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp cho lệnh]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp cho lệnh]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:In cấu hình chế độ tự động hiệu lực dưới dạng JSON'
    'critique:Nhận phản hồi AI về các quy tắc chế độ tự động tùy chỉnh của bạn'
    'defaults:In các quy tắc chế độ tự động mặc định dưới dạng JSON'
    'reset:Đặt lại cấu hình chế độ tự động về mặc định được cung cấp'
    'help:Hiển thị trợ giúp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Hiển thị trợ giúp cho lệnh]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode commands' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Ghi đè mô hình được sử dụng]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp cho lệnh]'
          ;;
        defaults)
          _arguments \
            '--label[Chỉ hiển thị các quy tắc có nhãn bắt đầu bằng tiền tố này (không phân biệt hoa thường)]:prefix:' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp cho lệnh]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Bỏ qua lời nhắc xác nhận]' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp cho lệnh]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp cho lệnh]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Đường dẫn đến file cấu hình YAML của gateway]:path:_files' \
    '(-h --help)'{-h,--help}'[Hiển thị trợ giúp cho lệnh]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Xóa tất cả trạng thái Claude Code cho một dự án (bản ghi, tác vụ, lịch sử file, mục cấu hình)'
    'help:Hiển thị trợ giúp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Hiển thị trợ giúp cho lệnh]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project commands' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Liệt kê những gì sẽ bị xóa mà không xóa gì cả]' \
            '(-y --yes)'{-y,--yes}'[Bỏ qua lời nhắc xác nhận]' \
            '(-i --interactive)'{-i,--interactive}'[Hỏi xác nhận từng mục trước khi xóa]' \
            '(1)--all[Xóa trạng thái cho mọi dự án (không dùng chung với một đường dẫn)]' \
            '(-h --help)'{-h,--help}'[Hiển thị trợ giúp cho lệnh]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[In dữ liệu bugs.json thô thay vì các phát hiện được định dạng]' \
    '--timeout[Số phút tối đa để chờ đánh giá hoàn thành (mặc định: 45)]:minutes:' \
    '(--no-post)--post[Đăng các phát hiện của đánh giá đã hoàn thành lên PR dưới tài khoản của bạn (chỉ với mục tiêu là PR; một bình luận thông thường, không phải review)]' \
    '(--post)--no-post[Không đăng các phát hiện lên PR (mặc định)]' \
    '(-h --help)'{-h,--help}'[Hiển thị trợ giúp cho lệnh]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Khởi động lại mọi phiên nền đang chạy]' \
    '(-h --help)'{-h,--help}'[Hiển thị trợ giúp cho lệnh]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Đồng thời loại bỏ các commit chưa push và thay đổi chưa commit của worktree (truyền commit@worktree-id mà lần claude rm trước đã báo)]:commit@worktree-id:' \
    '--force-remove-worktree[Xóa thư mục worktree ngay cả khi hook WorktreeRemove hoặc git không thể xóa nó (truyền worktree-id mà lần claude rm trước đã báo)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Hiển thị trợ giúp cho lệnh]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Hiển thị những gì sẽ được nhập mà không ghi gì cả]' \
    '--yes[Bỏ qua bộ chọn tương tác (trên môi trường headless, truyền --yes=<digest> từ bản xem trước /import)]' \
    '(-h --help)'{-h,--help}'[Hiển thị trợ giúp cho lệnh]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
