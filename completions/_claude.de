#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:MCP-Server konfigurieren und verwalten'
    'plugin:Claude Code-Plugins verwalten'
    'agents:Hintergrund-Agenten verwalten'
    'attach:Hintergrund-Sitzung in diesem Terminal öffnen'
    'logs:Aktuelle Terminalausgabe einer Hintergrund-Sitzung ausgeben'
    'stop:Hintergrund-Sitzung stoppen (die Unterhaltung bleibt erhalten)'
    'respawn:Hintergrund-Sitzung neu starten, damit sie mit der aktuellen Claude Code-Version läuft'
    'rm:Hintergrund-Sitzung löschen, und ihren Worktree, wenn das gefahrlos möglich ist'
    'auth:Authentifizierung verwalten'
    'auto-mode:Auto-Modus-Klassifizierer-Konfiguration prüfen oder zurücksetzen'
    'gateway:Enterprise-Authentifizierungs-/Telemetrie-Gateway ausführen'
    'import:Konfiguration eines anderen KI-Coding-Agenten in Claude Code importieren'
    'project:Claude Code-Projektstatus verwalten'
    'ultrareview:Cloud-gehostete Multi-Agent-Code-Überprüfung ausführen und Ergebnisse ausgeben'
    'setup-token:Langfristiges Authentifizierungstoken einrichten (erfordert Claude-Abonnement)'
    'doctor:Integritätsprüfung für Claude Code Auto-Updater'
    'update:Nach Updates suchen und installieren'
    'install:Claude Code Native-Build installieren'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Debug-Modus mit optionaler Kategoriefilterung aktivieren (z.B. "api,hooks" oder "!statsig,!file")]:filter:'
    '--verbose[Verbose-Modus-Einstellung aus Konfigurationsdatei überschreiben]'
    '(-p --print)'{-p,--print}'[Antwort ausgeben und beenden (für Verwendung mit Pipes). Hinweis: nur in vertrauenswürdigen Verzeichnissen verwenden]'
    '--output-format[Ausgabeformat (mit --print): "text" (Standard), "json" (einzelnes Ergebnis) oder "stream-json" (Echtzeit-Streaming)]:format:(text json stream-json)'
    '--json-schema[JSON-Schema für strukturierte Ausgabevalidierung]:schema:'
    '--include-partial-messages[Partielle Nachrichtenfragmente bei Ankunft einschließen (mit --print und --output-format=stream-json)]'
    '--input-format[Eingabeformat (mit --print): "text" (Standard) oder "stream-json" (Echtzeit-Streaming-Eingabe)]:format:(text stream-json)'
    '--mcp-debug[\[Veraltet. Verwenden Sie stattdessen --debug\] MCP-Debug-Modus aktivieren (zeigt MCP-Server-Fehler an)]'
    '--dangerously-skip-permissions[Alle Berechtigungsprüfungen umgehen. Nur für Sandboxen ohne Internetzugang empfohlen]'
    '--allow-dangerously-skip-permissions[Option zum Umgehen von Berechtigungsprüfungen aktivieren, ohne sie standardmäßig zu aktivieren]'
    '--restricted[Eingeschränkter Modus: entfernt die Tools, die Befehle oder Code ausführen, sowie WebFetch, ignoriert user/project/local-Einstellungen und beschränkt Datei-Tools auf die Arbeitsverzeichnisse]'
    '--max-budget-usd[Maximaler Dollarbetrag für API-Aufrufe (nur --print)]:amount:'
    '--replay-user-messages[Benutzernachrichten von stdin auf stdout zur Bestätigung erneut senden]'
    '--allowed-tools[Komma- oder leerzeichengetrennte Liste erlaubter Tool-Namen (z.B. "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Komma- oder leerzeichengetrennte Liste erlaubter Tool-Namen (camelCase-Format)]:tools:'
    '--tools[Liste verfügbarer Tools aus integriertem Set angeben. Nur Print-Modus]:tools:'
    '--disallowed-tools[Komma- oder leerzeichengetrennte Liste nicht erlaubter Tool-Namen (z.B. "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Komma- oder leerzeichengetrennte Liste nicht erlaubter Tool-Namen (camelCase-Format)]:tools:'
    '--mcp-config[MCP-Server aus JSON-Datei oder -String laden (leerzeichengetrennt)]:configs:'
    '--system-prompt[System-Prompt für Sitzung verwenden]:prompt:'
    '--system-prompt-file[System-Prompt aus einer Datei lesen]:file:_files'
    '--append-system-prompt[System-Prompt an Standard-System-Prompt anhängen]:prompt:'
    '--append-system-prompt-file[System-Prompt aus einer Datei lesen und an den Standard-System-Prompt anhängen]:file:_files'
    '--system-prompt-snapshot[System-Prompt einmal pro Unterhaltung aufzeichnen und bei jeder Anfrage und Fortsetzung unverändert wiederverwenden (on, Standard) oder bei jeder Anfrage neu erzeugen (off)]:mode:(on off)'
    '--permission-mode[Berechtigungsmodus für Sitzung verwenden]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Wer Berechtigungsabfragen mit --print beantwortet: "host" (der SDK-Host oder --permission-prompt-tool) oder "none" (alles, was nachfragen würde, wird abgelehnt)]:target:(host none)'
    '--permission-prompt-tool[MCP-Tool für Berechtigungsabfragen (nur --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Letzte Konversation fortsetzen]'
    '(-r --resume)'{-r,--resume}'[Konversation fortsetzen - Sitzungs-ID angeben oder interaktiv auswählen]:sessionId:_claude_sessions'
    '--fork-session[Neue Sitzungs-ID erstellen statt ursprüngliche Sitzungs-ID beim Fortsetzen wiederzuverwenden (mit --resume oder --continue)]'
    '--no-session-persistence[Sitzungspersistenz deaktivieren - Sitzungen werden nicht gespeichert (nur --print)]'
    '--model[Modell für aktuelle Sitzung. Alias für neuestes Modell angeben (z.B. '\''sonnet'\'' oder '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agent für die aktuelle Sitzung. Überschreibt die '\''agent'\''-Einstellung]:agent:_claude_agent_names'
    '--betas[Beta-Header für API-Anfragen einschließen (nur API-Schlüssel-Benutzer)]:betas:'
    '--fallback-model[Automatisches Fallback auf angegebenes Modell aktivieren, wenn Standardmodell überlastet ist (nur --print)]:model:_claude_model_names'
    '--settings[Pfad zur Einstellungs-JSON-Datei oder JSON-String zum Laden zusätzlicher Einstellungen]:file-or-json:_files'
    '--add-dir[Zusätzliche Verzeichnisse für Tool-Zugriff zulassen]:directories:_directories'
    '--ide[Beim Start automatisch mit IDE verbinden, wenn genau eine gültige IDE verfügbar ist]'
    '--strict-mcp-config[Nur MCP-Server von --mcp-config verwenden und alle anderen MCP-Einstellungen ignorieren]'
    '--session-id[Spezifische Sitzungs-ID für Konversation verwenden (muss gültige UUID sein)]:uuid:'
    '--agents[JSON-Objekt zur Definition benutzerdefinierter Agenten]:json:'
    '--setting-sources[Kommagetrennte Liste der zu ladenden Einstellungsquellen (user, project, local)]:sources:'
    '--plugin-dir[Verzeichnis, aus dem Plugins nur für diese Sitzung geladen werden (wiederholbar)]:paths:_directories'
    '--disable-slash-commands[Alle Slash-Befehle deaktivieren]'
    '(--bg --background)'{--bg,--background}'[Sitzung als Hintergrund-Agent starten und sofort zurückkehren]'
    '(-w --worktree)'{-w,--worktree}'[Neuen Git-Worktree für diese Sitzung erstellen (optional Namen angeben)]::name:'
    '--tmux=-[tmux-Sitzung für den Worktree erstellen (erfordert --worktree). Verwendet native iTerm2-Panes, wenn verfügbar; --tmux=classic für klassisches tmux]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Anzeigenamen für diese Sitzung festlegen]:name:'
    '--effort[Aufwandsstufe für die aktuelle Sitzung]:level:(low medium high xhigh max)'
    '--autocompact[Fenstergröße für automatisches Kompaktieren (auto oder 100k-1M Tokens)]:size:(auto)'
    '--debug-file[Debug-Protokolle in einen bestimmten Dateipfad schreiben (aktiviert implizit den Debug-Modus)]:path:_files'
    '--from-pr[Mit einem PR verknüpfte Sitzung nach Nummer/URL fortsetzen oder interaktive Auswahl öffnen]::value:'
    '--teleport[Teleport-Sitzung fortsetzen, optional Sitzungs-ID angeben]::session:'
    '--cloud[Cloud-Sitzung mit der angegebenen Beschreibung erstellen oder per Sitzungs-ID bzw. claude.ai/code-URL an eine bestehende anhängen]::description-or-session:'
    '--environment[Neue Cloud-Sitzung erstellen, die in der angegebenen selbst gehosteten Umgebung (ccpool_...) läuft]:environment_id:'
    '--remote-control[Interaktive Sitzung mit aktivierter Fernsteuerung starten (optional benannt)]::name:'
    '--remote-control-session-name-prefix[Präfix für automatisch generierte Fernsteuerungs-Sitzungsnamen]:prefix:'
    '--chrome[Claude in Chrome-Integration aktivieren]'
    '--no-chrome[Claude in Chrome-Integration deaktivieren]'
    '--plugin-url[Plugin-.zip von einer URL nur für diese Sitzung abrufen (wiederholbar)]:url:'
    '--file[Dateiressourcen, die beim Start heruntergeladen werden (Format: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Prompt-Vorschläge aktivieren (gibt einen vorhergesagten nächsten Prompt im Print-/SDK-Modus aus)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Subagent-Text und Denkblöcke als Nachrichten weiterleiten (mit --print und stream-json)]'
    '--include-hook-events[Alle Hook-Lebenszyklusereignisse in den Ausgabestream einschließen (mit stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Maschinenspezifische Abschnitte in die erste Benutzernachricht verschieben, um die Prompt-Cache-Wiederverwendung zu verbessern]'
    '--brief[SendUserMessage-Tool für Agent-zu-Benutzer-Kommunikation aktivieren]'
    '--safe-mode[Mit allen deaktivierten Anpassungen starten (nützlich zur Fehlerbehebung einer defekten Konfiguration)]'
    '--bare[Minimalmodus: Hooks, LSP, Plugin-Synchronisierung, Attribution, Auto-Memory und CLAUDE.md-Auto-Erkennung überspringen]'
    '--ax-screen-reader[Bildschirmleser-freundliche Ausgabe rendern (flacher Text, keine dekorativen Rahmen oder Animationen)]'
    '(-v --version)'{-v,--version}'[Versionsnummer ausgeben]'
    '(-h --help)'{-h,--help}'[Hilfe für Befehl anzeigen]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude-Befehle' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Hilfe für Befehl anzeigen]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "keine Argumente"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Claude Code MCP-Server starten'
    'add:MCP-Server zu Claude Code hinzufügen'
    'remove:MCP-Server entfernen'
    'list:Konfigurierte MCP-Server auflisten'
    'get:MCP-Server-Details abrufen'
    'add-json:MCP-Server (stdio oder SSE) mit JSON-String hinzufügen'
    'add-from-claude-desktop:MCP-Server von Claude Desktop importieren (nur Mac und WSL)'
    'reset-project-choices:Alle genehmigten/abgelehnten projektbezogenen (.mcp.json) Server in diesem Projekt zurücksetzen'
    'login:Bei einem MCP-Server authentifizieren (HTTP, SSE oder claude.ai-Connector)'
    'logout:Gespeicherte OAuth-Anmeldedaten für einen MCP-Server löschen'
    'help:Hilfe anzeigen'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp-Befehle' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Debug-Modus aktivieren]' \
            '--verbose[Verbose-Modus-Einstellung aus Konfigurationsdatei überschreiben]' \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurationsbereich (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Transporttyp (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Umgebungsvariable setzen (z.B. -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[WebSocket-Header setzen]:header:' \
            '--client-id[OAuth-Client-ID für HTTP/SSE-Server]:clientId:' \
            '--client-secret[OAuth-Client-Secret abfragen (oder Umgebungsvariable MCP_CLIENT_SECRET setzen)]' \
            '--callback-port[Fester Port für den OAuth-Callback (für Server, die vorregistrierte Redirect-URIs verlangen)]:port:' \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurationsbereich (local, user, project) - aus bestehendem Bereich entfernen, falls nicht angegeben]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurationsbereich (local, user, project)]:scope:(local user project)' \
            '--client-secret[OAuth-Client-Secret abfragen (oder Umgebungsvariable MCP_CLIENT_SECRET setzen)]' \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurationsbereich (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]'
          ;;
        login)
          _arguments \
            '--no-browser[Autorisierungs-URL ausgeben statt einen Browser zu öffnen (für SSH-/Headless-Sitzungen)]' \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Plugin oder Marketplace-Manifest validieren'
    'marketplace:Claude Code-Marketplaces verwalten'
    'list:Installierte Plugins auflisten'
    'details:Komponenteninventar und voraussichtliche Token-Kosten für ein Plugin anzeigen'
    'install:Plugin aus verfügbaren Marketplaces installieren'
    'i:Plugin aus verfügbaren Marketplaces installieren (Kurzform für install)'
    'init:Neues Plugin gerüsten (wird in nächster Sitzung automatisch geladen)'
    'new:Gerüst für ein neues Plugin anlegen (Alias für init)'
    'uninstall:Installiertes Plugin deinstallieren'
    'remove:Installiertes Plugin deinstallieren (Alias für uninstall)'
    'enable:Deaktiviertes Plugin aktivieren'
    'disable:Aktiviertes Plugin deaktivieren'
    'update:Plugin auf die neueste Version aktualisieren'
    'eval:Eval-Fälle gegen ein Plugin ausführen und bewertete Ergebnisse melden'
    'prune:Automatisch installierte Abhängigkeiten entfernen, die nicht mehr benötigt werden'
    'autoremove:Automatisch installierte Abhängigkeiten entfernen, die nicht mehr benötigt werden (Alias für prune)'
    'tag:Einen {name}--v{version} Git-Tag für eine Plugin-Veröffentlichung erstellen'
    'help:Hilfe anzeigen'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin-Befehle' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Warnungen als Fehler behandeln (Exit 1)]' \
            '--json[Validierungsbericht als JSON ausgeben (gleiche Exit-Codes)]' \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Installationsbereich]:scope:(user project local)' \
            '*--config[Eine im Plugin-Manifest deklarierte userConfig-Option setzen (wiederholbar)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Den angezeigten, vom Marketplace deklarierten Befehl ohne Bestätigungsabfrage akzeptieren]' \
            '--json[Eine maschinenlesbare Ergebniszeile statt der Meldung für Menschen ausgeben]' \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Installationsbereich]:scope:(user project local)' \
            '--keep-data[Persistentes Datenverzeichnis des Plugins behalten]' \
            '--prune[Auch automatisch installierte Abhängigkeiten entfernen, die nicht mehr benötigt werden]' \
            '(-y --yes)'{-y,--yes}'[Bestätigungsabfrage für --prune überspringen]' \
            '--json[Eine maschinenlesbare Ergebniszeile statt der Meldung für Menschen ausgeben (nicht mit --prune)]' \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Installationsbereich]:scope:(user project local)' \
            '--json[Eine maschinenlesbare Ergebniszeile statt der Meldung für Menschen ausgeben]' \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Alle aktivierten Plugins deaktivieren]' \
            '(-s --scope)'{-s,--scope}'[Installationsbereich]:scope:(user project local)' \
            '--json[Eine maschinenlesbare Ergebniszeile statt der Meldung für Menschen ausgeben]' \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Installationsbereich]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Den angezeigten, vom Marketplace deklarierten Befehl ohne Bestätigungsabfrage akzeptieren]' \
            '--json[Eine maschinenlesbare Ergebniszeile statt der Meldung für Menschen ausgeben]' \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Als JSON ausgeben]' \
            '--available[Verfügbare Plugins aus Marketplaces einschließen (erfordert --json)]' \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Bereich, in dem bereinigt wird]:scope:(user project local)' \
            '--dry-run[Auflisten, was entfernt würde, ohne etwas zu entfernen]' \
            '(-y --yes)'{-y,--yes}'[Bestätigungsabfrage überspringen]' \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Beschreibung im Manifest]:text:' \
            '--author[Name des Autors (Standard: git config user.name)]:name:' \
            '--author-email[E-Mail des Autors (Standard: git config user.email)]:email:' \
            '--with[Zusätzlich anzulegende Komponenten]:components:' \
            '(-f --force)'{-f,--force}'[Vorhandenes .claude-plugin/ am Ziel überschreiben]' \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Fälle nach Namens-Glob filtern]:glob:' \
            '*--tag[Fälle nach Tag filtern (wiederholbar)]:tag:' \
            '--runs[Durchläufe pro Fall überschreiben (Standard: case.runs, sonst 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Bis zu n Agenten-Durchläufe gleichzeitig ausführen (1-8; Standard 1)]:n:' \
            '--model[Modell für alle Fälle überschreiben]:model:_claude_model_names' \
            '--judge-model[Modell des LLM-Bewerters überschreiben (Standard: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Harte Kostenobergrenze; bei Erreichen abbrechen und Teilergebnisse melden (Exit 2)]:usd:' \
            '--output-dir[Verzeichnis für aggregate-result.json]:dir:_directories' \
            '--eval-dir[Verzeichnisname (unterhalb des Plugins) mit den Eval-Fällen]:dir:' \
            '--json[Vollständiges Laufergebnis als JSON auf stdout ausgeben oder in diese .json-Datei schreiben]::path:_files' \
            '--threshold[Mit Exit 1 beenden, wenn der Score eines Falls unter diesem Schwellenwert liegt (Standard: 1.0)]:threshold:' \
            '*--allow-tools[Freigabe des Bedieners für eingeschränkte Tools (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[scaffold_script jedes Falls ausführen (führt vom Autor geliefertes Bash unter Ihrem Benutzer aus; standardmäßig aus)]' \
            '(--scaffold)--no-scaffold[scaffold_script ausdrücklich überspringen]' \
            '--trust-plugin[Bestätigen, dass Sie diesem Plugin und seiner Eval-Suite vertrauen, und die Vertrauensabfrage beim ersten Lauf überspringen (für CI)]' \
            '--ablation[Zusätzlich eine Baseline ohne Plugin ausführen und die Score-Differenz melden]:mode:(none with-without)' \
            '--mocks[Mock-Stellvertreter für MCP-Server aus <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Mit --mocks record: auch die echten Prozesse der MCP-Server ohne Mock starten]' \
            '--keep-temp[Scaffold-Verzeichnisse zum Debuggen behalten]' \
            '--verbose[Trace-Ereignisse pro Nachricht ins Debug-Log schreiben]' \
            '--report[Eigenständigen HTML-Bericht an diesen Pfad statt ins Ergebnisverzeichnis schreiben]:path:_files' \
            '(--no-publish)--publish-report[Zusätzlich die Veröffentlichung des Berichts auf claude.ai verlangen]' \
            '(--publish-report)--no-publish[HTML-Bericht nur lokal behalten; nicht auf claude.ai veröffentlichen]' \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Tag nach dem Erstellen nach --remote pushen]' \
            '--dry-run[Ausgeben, was getaggt würde, ohne den Tag zu erstellen]' \
            '(-f --force)'{-f,--force}'[Prüfungen auf ungespeicherte Änderungen und bereits vorhandenen Tag überspringen]' \
            '(-m --message)'{-m,--message}'[Anmerkung des Tags (%s steht für die Version)]:msg:' \
            '--remote[Remote, zu dem mit --push gepusht wird]:name:' \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
            '::path:_files'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Marketplace von URL, Pfad oder GitHub-Repository hinzufügen'
    'list:Konfigurierte Marketplaces auflisten'
    'remove:Konfigurierten Marketplace entfernen'
    'rm:Konfigurierten Marketplace entfernen (Alias für remove)'
    'update:Marketplace von Quelle aktualisieren - alle aktualisieren, falls kein Name angegeben'
    'help:Hilfe anzeigen'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace-Befehle' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Checkout per git sparse-checkout auf bestimmte Verzeichnisse beschränken (für Monorepos)]:paths:' \
            '--scope[Wo der Marketplace deklariert wird]:scope:(user project local)' \
            '--claudeai[Den Marketplace dieses Namens hinzufügen, den claude.ai für Sie hostet]' \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Als JSON ausgeben]' \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Marketplace-Deklaration aus einem bestimmten Einstellungsbereich entfernen (weglassen, um sie aus allen zu entfernen)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Installation erzwingen, auch wenn bereits installiert]' \
    '(-h --help)'{-h,--help}'[Hilfe anzeigen]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Zusätzliches Verzeichnis für Tool-Zugriff in versendeten Sitzungen zulassen]:directory:_directories' \
    '--agent[Standard-Agent für aus der Agentenansicht versendete Sitzungen]:agent:_claude_agent_names' \
    '--all[Mit --json: auch abgeschlossene Hintergrundsitzungen einschließen]' \
    '--allow-dangerously-skip-permissions[Bypass-Berechtigungsmodus für versendete Sitzungen verfügbar machen]' \
    '--cwd[Nur unter Pfad gestartete Hintergrundsitzungen anzeigen]:path:_directories' \
    '--dangerously-skip-permissions[Alias für --permission-mode bypassPermissions]' \
    '--effort[Standard-Aufwandsstufe für versendete Sitzungen]:level:(low medium high xhigh max)' \
    '--json[Aktive Sitzungen als JSON-Array ausgeben und beenden]' \
    '*--mcp-config[MCP-Server-Konfiguration für versendete Sitzungen anwenden]:config:' \
    '--model[Standardmodell für aus der Agentenansicht versendete Sitzungen]:model:_claude_model_names' \
    '--permission-mode[Standard-Berechtigungsmodus für versendete Sitzungen]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Plugins aus Verzeichnis für die Agentenansicht und versendete Sitzungen laden]:path:_directories' \
    '--setting-sources[Kommagetrennte Liste der zu ladenden Einstellungsquellen (user, project, local)]:sources:' \
    '--settings[Einstellungsdatei oder JSON-String zum Anwenden]:file-or-json:_files' \
    '--strict-mcp-config[Nur MCP-Server von --mcp-config in versendeten Sitzungen verwenden]' \
    '--restricted[Gestartete Sitzungen im eingeschränkten Modus ausführen]' \
    '(-h --help)'{-h,--help}'[Hilfe für Befehl anzeigen]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Bei Ihrem Anthropic-Konto anmelden'
    'logout:Von Ihrem Anthropic-Konto abmelden'
    'status:Authentifizierungsstatus anzeigen'
    'help:Hilfe anzeigen'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Hilfe für Befehl anzeigen]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth-Befehle' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[E-Mail-Adresse auf der Anmeldeseite vorausfüllen]:email:' \
            '--sso[SSO-Anmeldung erzwingen]' \
            '(--claudeai)--console[Anthropic Console (Abrechnung nach API-Nutzung) statt Claude-Abonnement verwenden]' \
            '(--console)--claudeai[Claude-Abonnement verwenden (Standard)]' \
            '(-h --help)'{-h,--help}'[Hilfe für Befehl anzeigen]'
          ;;
        status)
          _arguments \
            '(--text)--json[Als JSON ausgeben (Standard)]' \
            '(--json)--text[Als lesbaren Text ausgeben]' \
            '(-h --help)'{-h,--help}'[Hilfe für Befehl anzeigen]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Hilfe für Befehl anzeigen]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Die effektive Auto-Modus-Konfiguration als JSON ausgeben'
    'critique:KI-Feedback zu Ihren benutzerdefinierten Auto-Modus-Regeln erhalten'
    'defaults:Die Standard-Auto-Modus-Regeln als JSON ausgeben'
    'reset:Auto-Modus-Konfiguration auf die ausgelieferten Standardwerte zurücksetzen'
    'help:Hilfe anzeigen'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Hilfe für Befehl anzeigen]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode-Befehle' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Verwendetes Modell überschreiben]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Hilfe für Befehl anzeigen]'
          ;;
        defaults)
          _arguments \
            '--label[Nur Regeln anzeigen, deren Label mit diesem Präfix beginnt (Groß-/Kleinschreibung egal)]:prefix:' \
            '(-h --help)'{-h,--help}'[Hilfe für Befehl anzeigen]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Bestätigungsabfrage überspringen]' \
            '(-h --help)'{-h,--help}'[Hilfe für Befehl anzeigen]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Hilfe für Befehl anzeigen]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Pfad zur Gateway-YAML-Konfiguration]:path:_files' \
    '(-h --help)'{-h,--help}'[Hilfe für Befehl anzeigen]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Alle Claude Code-Status für ein Projekt löschen (Transkripte, Aufgaben, Dateiverlauf, Konfigurationseintrag)'
    'help:Hilfe anzeigen'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Hilfe für Befehl anzeigen]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project-Befehle' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Auflisten, was gelöscht würde, ohne etwas zu löschen]' \
            '(-y --yes)'{-y,--yes}'[Bestätigungsabfrage überspringen]' \
            '(-i --interactive)'{-i,--interactive}'[Vor dem Löschen bei jedem Eintrag nachfragen]' \
            '(1)--all[Zustand aller Projekte löschen (schließt einen Pfad aus)]' \
            '(-h --help)'{-h,--help}'[Hilfe für Befehl anzeigen]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Rohe bugs.json-Nutzlast statt formatierter Ergebnisse ausgeben]' \
    '--timeout[Maximale Minuten, die auf den Abschluss der Überprüfung gewartet wird (Standard: 45)]:minutes:' \
    '(--no-post)--post[Ergebnisse der fertigen Überprüfung in Ihrem Namen im PR posten (nur PR-Ziele; ein einfacher Kommentar, kein Review)]' \
    '(--post)--no-post[Ergebnisse nicht im PR posten (Standard)]' \
    '(-h --help)'{-h,--help}'[Hilfe für Befehl anzeigen]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Alle laufenden Hintergrund-Sitzungen neu starten]' \
    '(-h --help)'{-h,--help}'[Hilfe für Befehl anzeigen]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Auch die nicht gepushten Commits und nicht committeten Änderungen des Worktrees verwerfen (die von einem früheren claude rm gemeldete commit@worktree-id übergeben)]:commit@worktree-id:' \
    '--force-remove-worktree[Worktree-Verzeichnis löschen, obwohl der WorktreeRemove-Hook oder git es nicht entfernen konnte (die von einem früheren claude rm gemeldete worktree-id übergeben)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Hilfe für Befehl anzeigen]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Anzeigen, was importiert würde, ohne etwas zu schreiben]' \
    '--yes[Interaktive Auswahl überspringen (in Headless-Umgebungen --yes=<digest> aus der /import-Vorschau übergeben)]' \
    '(-h --help)'{-h,--help}'[Hilfe für Befehl anzeigen]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
