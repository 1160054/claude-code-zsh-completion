#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Konfigurasi dan kelola server MCP'
    'plugin:Kelola plugin Claude Code'
    'agents:Kelola agen latar belakang'
    'attach:Buka sesi latar belakang di terminal ini'
    'logs:Cetak output terminal terbaru dari sesi latar belakang'
    'stop:Hentikan sesi latar belakang (percakapannya tetap disimpan)'
    'respawn:Mulai ulang sesi latar belakang agar menjalankan versi Claude Code saat ini'
    'rm:Hapus sesi latar belakang, beserta worktree-nya jika aman'
    'auth:Kelola autentikasi'
    'auto-mode:Periksa atau reset konfigurasi klasifikator mode otomatis'
    'gateway:Jalankan gateway auth/telemetri enterprise'
    'import:Impor konfigurasi dari agen coding AI lain ke Claude Code'
    'project:Kelola status proyek Claude Code'
    'ultrareview:Jalankan tinjauan kode multi-agen berbasis cloud dan cetak temuannya'
    'setup-token:Atur token autentikasi jangka panjang (memerlukan langganan Claude)'
    'doctor:Pemeriksaan kesehatan untuk auto-updater Claude Code'
    'update:Periksa dan instal pembaruan'
    'install:Instal build native Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Aktifkan mode debug dengan filter kategori opsional (mis., "api,hooks" atau "!statsig,!file")]:filter:'
    '--verbose[Timpa pengaturan mode verbose dari file konfigurasi]'
    '(-p --print)'{-p,--print}'[Cetak respons dan keluar (untuk digunakan dengan pipe). Catatan: gunakan hanya di direktori tepercaya]'
    '--output-format[Format output (dengan --print): "text" (default), "json" (hasil tunggal), atau "stream-json" (streaming real-time)]:format:(text json stream-json)'
    '--json-schema[Skema JSON untuk validasi output terstruktur]:schema:'
    '--include-partial-messages[Sertakan potongan pesan parsial saat tiba (dengan --print dan --output-format=stream-json)]'
    '--input-format[Format input (dengan --print): "text" (default) atau "stream-json" (input streaming real-time)]:format:(text stream-json)'
    '--mcp-debug[\[Usang. Gunakan --debug sebagai gantinya\] Aktifkan mode debug MCP (menampilkan error server MCP)]'
    '--dangerously-skip-permissions[Lewati semua pemeriksaan izin. Disarankan hanya untuk sandbox tanpa akses internet]'
    '--allow-dangerously-skip-permissions[Aktifkan opsi untuk melewati pemeriksaan izin tanpa mengaktifkan secara default]'
    '--restricted[Mode terbatas: hapus tool yang menjalankan perintah atau kode serta WebFetch, abaikan pengaturan user/project/local, dan batasi tool file ke direktori kerja]'
    '--max-budget-usd[Jumlah dolar maksimum untuk dibelanjakan pada panggilan API (hanya --print)]:amount:'
    '--replay-user-messages[Kirim ulang pesan pengguna dari stdin ke stdout untuk konfirmasi]'
    '--allowed-tools[Daftar nama tool yang diizinkan, dipisahkan koma atau spasi (mis., "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Daftar nama tool yang diizinkan, dipisahkan koma atau spasi (format camelCase)]:tools:'
    '--tools[Tentukan daftar tool yang tersedia dari set bawaan. Hanya mode print]:tools:'
    '--disallowed-tools[Daftar nama tool yang tidak diizinkan, dipisahkan koma atau spasi (mis., "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Daftar nama tool yang tidak diizinkan, dipisahkan koma atau spasi (format camelCase)]:tools:'
    '--mcp-config[Muat server MCP dari file atau string JSON (dipisahkan spasi)]:configs:'
    '--system-prompt[Prompt sistem untuk digunakan dalam sesi]:prompt:'
    '--system-prompt-file[Baca prompt sistem dari file]:file:_files'
    '--append-system-prompt[Tambahkan prompt sistem ke prompt sistem default]:prompt:'
    '--append-system-prompt-file[Baca prompt sistem dari file dan tambahkan ke prompt sistem default]:file:_files'
    '--system-prompt-snapshot[Rekam prompt sistem sekali per percakapan dan gunakan ulang apa adanya pada setiap permintaan dan saat melanjutkan (on, default) atau render ulang pada setiap permintaan (off)]:mode:(on off)'
    '--permission-mode[Mode izin untuk digunakan dalam sesi]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Siapa yang menjawab prompt izin dengan --print: "host" (host SDK atau --permission-prompt-tool) atau "none" (apa pun yang akan memunculkan prompt ditolak)]:target:(host none)'
    '--permission-prompt-tool[Tool MCP yang digunakan untuk prompt izin (hanya --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Lanjutkan percakapan terbaru]'
    '(-r --resume)'{-r,--resume}'[Lanjutkan percakapan - tentukan ID sesi atau pilih secara interaktif]:sessionId:_claude_sessions'
    '--fork-session[Buat ID sesi baru alih-alih menggunakan kembali ID sesi asli saat melanjutkan (dengan --resume atau --continue)]'
    '--no-session-persistence[Nonaktifkan persistensi sesi - sesi tidak akan disimpan (hanya --print)]'
    '--model[Model untuk sesi saat ini. Tentukan alias untuk model terbaru (mis., '\''sonnet'\'' atau '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agen untuk sesi saat ini. Menimpa pengaturan '\''agent'\'']:agent:_claude_agent_names'
    '--betas[Header beta untuk disertakan dalam permintaan API (hanya pengguna kunci API)]:betas:'
    '--fallback-model[Aktifkan fallback otomatis ke model yang ditentukan saat model default kelebihan beban (hanya --print)]:model:_claude_model_names'
    '--settings[Jalur ke file JSON pengaturan atau string JSON untuk memuat pengaturan tambahan]:file-or-json:_files'
    '--add-dir[Direktori tambahan untuk mengizinkan akses tool]:directories:_directories'
    '--ide[Sambungkan otomatis ke IDE saat startup jika tepat satu IDE valid tersedia]'
    '--desktop[Buka di aplikasi Claude Desktop alih-alih terminal (dengan --continue atau --resume <id> untuk memilih sesi)]'
    '--strict-mcp-config[Gunakan hanya server MCP dari --mcp-config dan abaikan semua pengaturan MCP lainnya]'
    '--session-id[ID sesi spesifik untuk digunakan dalam percakapan (harus UUID valid)]:uuid:'
    '--agents[Objek JSON yang mendefinisikan agen kustom]:json:'
    '--setting-sources[Daftar sumber pengaturan yang akan dimuat, dipisahkan koma (user, project, local)]:sources:'
    '--plugin-dir[Direktori untuk memuat plugin hanya untuk sesi ini (dapat diulang)]:paths:_directories'
    '--disable-slash-commands[Nonaktifkan semua perintah slash]'
    '(--bg --background)'{--bg,--background}'[Mulai sesi sebagai agen latar belakang dan langsung kembali]'
    '(-w --worktree)'{-w,--worktree}'[Buat git worktree baru untuk sesi ini (opsional tentukan nama)]::name:'
    '--tmux=-[Buat sesi tmux untuk worktree (memerlukan --worktree). Menggunakan panel native iTerm2 jika tersedia; --tmux=classic untuk tmux tradisional]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Atur nama tampilan untuk sesi ini]:name:'
    '--effort[Tingkat upaya untuk sesi saat ini]:level:(low medium high xhigh max)'
    '--autocompact[Ukuran jendela auto-compact (auto, atau 100k-1M token)]:size:(auto)'
    '--debug-file[Tulis log debug ke jalur file tertentu (secara implisit mengaktifkan mode debug)]:path:_files'
    '--from-pr[Lanjutkan sesi yang tertaut ke PR berdasarkan nomor/URL, atau buka pemilih interaktif]::value:'
    '--teleport[Lanjutkan sesi teleport, opsional tentukan ID sesi]::session:'
    '--cloud[Buat sesi cloud dengan deskripsi yang diberikan, atau sambungkan ke sesi yang ada berdasarkan ID sesi atau URL claude.ai/code]::description-or-session:'
    '--environment[Buat sesi cloud baru yang berjalan di environment self-hosted yang diberikan (ccpool_...)]:environment_id:'
    '--remote-control[Mulai sesi interaktif dengan Remote Control diaktifkan (opsional diberi nama)]::name:'
    '--remote-control-session-name-prefix[Prefiks untuk nama sesi Remote Control yang dibuat otomatis]:prefix:'
    '--chrome[Aktifkan integrasi Claude in Chrome]'
    '--no-chrome[Nonaktifkan integrasi Claude in Chrome]'
    '--plugin-url[Ambil .zip plugin dari URL hanya untuk sesi ini (dapat diulang)]:url:'
    '--file[Sumber daya file untuk diunduh saat startup (format: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Aktifkan saran prompt (memancarkan prediksi prompt berikutnya dalam mode print/SDK)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Teruskan teks subagen dan blok berpikir sebagai pesan (dengan --print dan stream-json)]'
    '--include-hook-events[Sertakan semua peristiwa siklus hidup hook dalam aliran output (dengan stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Pindahkan bagian per-mesin ke pesan pengguna pertama untuk meningkatkan penggunaan ulang cache prompt]'
    '--brief[Aktifkan tool SendUserMessage untuk komunikasi agen-ke-pengguna]'
    '--safe-mode[Mulai dengan semua kustomisasi dinonaktifkan (berguna untuk memecahkan masalah konfigurasi yang rusak)]'
    '--bare[Mode minimal: lewati hooks, LSP, sinkronisasi plugin, atribusi, auto-memory, dan penemuan otomatis CLAUDE.md]'
    '--ax-screen-reader[Render output ramah pembaca layar (teks datar, tanpa batas dekoratif atau animasi)]'
    '(-v --version)'{-v,--version}'[Tampilkan nomor versi]'
    '(-h --help)'{-h,--help}'[Tampilkan bantuan untuk perintah]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'perintah claude' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan untuk perintah]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "tanpa argumen"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Jalankan server MCP Claude Code'
    'add:Tambahkan server MCP ke Claude Code'
    'remove:Hapus server MCP'
    'list:Tampilkan daftar server MCP yang dikonfigurasi'
    'get:Dapatkan detail server MCP'
    'add-json:Tambahkan server MCP (stdio atau SSE) dengan string JSON'
    'add-from-claude-desktop:Impor server MCP dari Claude Desktop (hanya Mac dan WSL)'
    'reset-project-choices:Reset semua server project-scoped (.mcp.json) yang disetujui/ditolak dalam proyek ini'
    'login:Autentikasi dengan server MCP (HTTP, SSE, atau konektor claude.ai)'
    'logout:Hapus kredensial OAuth tersimpan untuk server MCP'
    'help:Tampilkan bantuan'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'perintah mcp' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Aktifkan mode debug]' \
            '--verbose[Timpa pengaturan mode verbose dari file konfigurasi]' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Cakupan konfigurasi (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Tipe transport (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Atur variabel environment (mis., -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Atur header WebSocket]:header:' \
            '--client-id[ID klien OAuth untuk server HTTP/SSE]:clientId:' \
            '--client-secret[Minta secret klien OAuth (atau atur variabel environment MCP_CLIENT_SECRET)]' \
            '--callback-port[Port tetap untuk callback OAuth (untuk server yang memerlukan URI pengalihan yang telah didaftarkan sebelumnya)]:port:' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Cakupan konfigurasi (local, user, project) - hapus dari cakupan yang ada jika tidak ditentukan]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Cakupan konfigurasi (local, user, project)]:scope:(local user project)' \
            '--client-secret[Minta secret klien OAuth (atau atur variabel environment MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Cakupan konfigurasi (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]'
          ;;
        login)
          _arguments \
            '--no-browser[Cetak URL otorisasi alih-alih membuka browser (untuk sesi SSH/headless)]' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Validasi manifest plugin atau marketplace'
    'marketplace:Kelola marketplace Claude Code'
    'list:Tampilkan daftar plugin yang terinstal'
    'details:Tampilkan inventaris komponen dan perkiraan biaya token untuk plugin'
    'configure:Tampilkan opsi plugin dan mana yang belum diatur, atau simpan nilai dari stdin'
    'install:Instal plugin dari marketplace yang tersedia'
    'i:Instal plugin dari marketplace yang tersedia (singkatan dari install)'
    'init:Buat kerangka plugin baru (dimuat otomatis pada sesi berikutnya)'
    'new:Buat kerangka plugin baru (alias untuk init)'
    'uninstall:Hapus instalasi plugin yang terinstal'
    'remove:Hapus instalasi plugin yang terinstal (alias untuk uninstall)'
    'enable:Aktifkan plugin yang dinonaktifkan'
    'disable:Nonaktifkan plugin yang aktif'
    'update:Perbarui plugin ke versi terbaru'
    'eval:Jalankan kasus eval terhadap plugin dan laporkan hasil yang dinilai'
    'prune:Hapus dependensi yang terinstal otomatis yang tidak lagi diperlukan'
    'autoremove:Hapus dependensi yang terinstal otomatis yang tidak lagi diperlukan (alias untuk prune)'
    'tag:Buat git tag {name}--v{version} untuk rilis plugin'
    'test:Jalankan pengujian mod'
    'help:Tampilkan bantuan'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'perintah plugin' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Perlakukan peringatan sebagai error (kode keluar 1)]' \
            '--json[Keluarkan laporan validasi sebagai JSON (kode keluar sama)]' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Cakupan instalasi]:scope:(user project local)' \
            '*--config[Atur opsi userConfig yang dideklarasikan di manifest plugin (dapat diulang)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Terima perintah yang dideklarasikan marketplace yang ditampilkan tanpa prompt konfirmasi]' \
            '--json[Cetak satu baris hasil yang dapat dibaca mesin alih-alih pesan untuk manusia]' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Cakupan instalasi]:scope:(user project local)' \
            '--keep-data[Pertahankan direktori data persisten plugin]' \
            '--prune[Juga hapus dependensi yang terinstal otomatis yang tidak lagi diperlukan]' \
            '(-y --yes)'{-y,--yes}'[Lewati prompt konfirmasi --prune]' \
            '--json[Cetak satu baris hasil yang dapat dibaca mesin alih-alih pesan untuk manusia (tidak dengan --prune)]' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Cakupan instalasi]:scope:(user project local)' \
            '--json[Cetak satu baris hasil yang dapat dibaca mesin alih-alih pesan untuk manusia]' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Nonaktifkan semua plugin yang aktif]' \
            '(-s --scope)'{-s,--scope}'[Cakupan instalasi]:scope:(user project local)' \
            '--json[Cetak satu baris hasil yang dapat dibaca mesin alih-alih pesan untuk manusia]' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Cakupan instalasi]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Terima perintah yang dideklarasikan marketplace yang ditampilkan tanpa prompt konfirmasi]' \
            '--json[Cetak satu baris hasil yang dapat dibaca mesin alih-alih pesan untuk manusia]' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Keluarkan sebagai JSON]' \
            '--available[Sertakan plugin yang tersedia dari marketplace (memerlukan --json)]' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Pangkas pada cakupan]:scope:(user project local)' \
            '--dry-run[Tampilkan daftar yang akan dihapus tanpa menghapus]' \
            '(-y --yes)'{-y,--yes}'[Lewati prompt konfirmasi]' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]'
          ;;
        configure)
          _arguments \
            '--json[Keluarkan sebagai JSON]' \
            '--values-stdin[Baca nilai opsi dari stdin sebagai objek JSON berisi string satu baris; opsi yang tidak disertakan mempertahankan nilainya]' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Deskripsi manifest]:text:' \
            '--author[Nama penulis (default: git config user.name)]:name:' \
            '--author-email[Email penulis (default: git config user.email)]:email:' \
            '--with[Komponen yang juga dibuatkan kerangkanya]:components:' \
            '(-f --force)'{-f,--force}'[Timpa .claude-plugin/ yang sudah ada di target]' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Filter kasus berdasarkan glob nama]:glob:' \
            '*--tag[Filter kasus berdasarkan tag (dapat diulang)]:tag:' \
            '--runs[Timpa jumlah run per kasus (default: case.runs, jika tidak ada 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Jalankan hingga n run agen sekaligus (1-8; default 1)]:n:' \
            '--model[Timpa model untuk semua kasus]:model:_claude_model_names' \
            '--judge-model[Timpa model penilai LLM (default: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Batas biaya mutlak; batalkan dan laporkan hasil parsial jika tercapai (kode keluar 2)]:usd:' \
            '--output-dir[Direktori untuk aggregate-result.json]:dir:_directories' \
            '--eval-dir[Nama direktori (di bawah plugin) yang berisi kasus eval]:dir:' \
            '--json[Cetak hasil run lengkap sebagai JSON ke stdout, atau tulis ke file .json ini]::path:_files' \
            '--threshold[Keluar dengan kode keluar 1 jika skor kasus mana pun di bawah ambang ini (default: 1.0)]:threshold:' \
            '*--allow-tools[Izin operator untuk tool yang dibatasi (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Jalankan scaffold_script setiap kasus (menjalankan bash dari penulis atas nama Anda; nonaktif secara default)]' \
            '(--scaffold)--no-scaffold[Lewati scaffold_script secara eksplisit]' \
            '--trust-plugin[Nyatakan bahwa Anda memercayai plugin ini dan suite eval-nya, melewati prompt kepercayaan saat pertama kali dijalankan (untuk CI)]' \
            '--ablation[Jalankan kelompok pembanding baseline tanpa plugin dan laporkan selisih skornya]:mode:(none with-without)' \
            '--mocks[Pengganti tiruan (mock) untuk server MCP, dari <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Dengan --mocks record: juga jalankan proses server MCP asli yang tidak memiliki mock]' \
            '--keep-temp[Pertahankan direktori scaffold untuk debugging]' \
            '--verbose[Catat peristiwa trace per pesan ke log debug]' \
            '--report[Tulis laporan HTML mandiri ke path ini alih-alih direktori hasil]:path:_files' \
            '(--no-publish)--publish-report[Juga wajibkan publikasi laporan ke claude.ai]' \
            '(--publish-report)--no-publish[Simpan laporan HTML hanya secara lokal; lewati publikasi ke claude.ai]' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Push tag ke --remote setelah dibuat]' \
            '--dry-run[Cetak apa yang akan di-tag tanpa membuatnya]' \
            '(-f --force)'{-f,--force}'[Lewati pemeriksaan working tree kotor dan tag yang sudah ada]' \
            '(-m --message)'{-m,--message}'[Pesan anotasi tag (gunakan %s untuk versi)]:msg:' \
            '--remote[Remote tujuan push dengan --push]:name:' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Tambahkan marketplace dari URL, path, atau repositori GitHub'
    'list:Tampilkan daftar marketplace yang dikonfigurasi'
    'remove:Hapus marketplace yang dikonfigurasi'
    'rm:Hapus marketplace yang dikonfigurasi (alias untuk remove)'
    'update:Perbarui marketplace dari sumber - perbarui semua jika nama tidak ditentukan'
    'help:Tampilkan bantuan'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'perintah marketplace' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Batasi checkout ke direktori tertentu melalui git sparse-checkout (untuk monorepo)]:paths:' \
            '--scope[Tempat mendeklarasikan marketplace]:scope:(user project local)' \
            '--claudeai[Tambahkan marketplace dengan nama ini yang di-host claude.ai untuk Anda]' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Keluarkan sebagai JSON]' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Hapus deklarasi marketplace dari cakupan pengaturan tertentu (jika tidak ditentukan, hapus dari semua cakupan)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Paksa instalasi meskipun sudah terinstal]' \
    '(-h --help)'{-h,--help}'[Tampilkan bantuan]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Direktori tambahan untuk mengizinkan akses tool dalam sesi yang dikirim]:directory:_directories' \
    '--agent[Agen default untuk sesi yang dikirim dari tampilan agen]:agent:_claude_agent_names' \
    '--all[Dengan --json: juga sertakan sesi latar belakang yang selesai]' \
    '--allow-dangerously-skip-permissions[Buat mode bypass-permissions tersedia untuk sesi yang dikirim]' \
    '--cwd[Tampilkan hanya sesi latar belakang yang dimulai di bawah path]:path:_directories' \
    '--dangerously-skip-permissions[Alias untuk --permission-mode bypassPermissions]' \
    '--effort[Tingkat upaya default untuk sesi yang dikirim]:level:(low medium high xhigh max)' \
    '--json[Cetak sesi aktif sebagai array JSON dan keluar]' \
    '*--mcp-config[Konfigurasi server MCP untuk diterapkan pada sesi yang dikirim]:config:' \
    '--model[Model default untuk sesi yang dikirim dari tampilan agen]:model:_claude_model_names' \
    '--permission-mode[Mode izin default untuk sesi yang dikirim]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Muat plugin dari direktori untuk tampilan agen dan sesi yang dikirim]:path:_directories' \
    '--setting-sources[Daftar sumber pengaturan yang akan dimuat, dipisahkan koma (user, project, local)]:sources:' \
    '--settings[File pengaturan atau string JSON untuk diterapkan]:file-or-json:_files' \
    '--strict-mcp-config[Hanya gunakan server MCP dari --mcp-config dalam sesi yang dikirim]' \
    '--restricted[Mulai sesi yang dikirim dalam mode terbatas]' \
    '(-h --help)'{-h,--help}'[Tampilkan bantuan untuk perintah]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Masuk ke akun Anthropic Anda'
    'logout:Keluar dari akun Anthropic Anda'
    'status:Tampilkan status autentikasi'
    'help:Tampilkan bantuan'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Tampilkan bantuan untuk perintah]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'perintah auth' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Isi otomatis alamat email di halaman login]:email:' \
            '--sso[Paksa alur login SSO]' \
            '(--claudeai)--console[Gunakan Anthropic Console (penagihan berdasarkan penggunaan API) alih-alih langganan Claude]' \
            '(--console)--claudeai[Gunakan langganan Claude (default)]' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan untuk perintah]'
          ;;
        status)
          _arguments \
            '(--text)--json[Keluarkan sebagai JSON (default)]' \
            '(--json)--text[Keluarkan sebagai teks yang dapat dibaca manusia]' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan untuk perintah]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan untuk perintah]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Cetak konfigurasi mode otomatis efektif sebagai JSON'
    'critique:Dapatkan umpan balik AI tentang aturan mode otomatis kustom Anda'
    'defaults:Cetak aturan mode otomatis default sebagai JSON'
    'reset:Reset konfigurasi mode otomatis ke default bawaan'
    'help:Tampilkan bantuan'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Tampilkan bantuan untuk perintah]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'perintah auto-mode' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Timpa model yang digunakan]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan untuk perintah]'
          ;;
        defaults)
          _arguments \
            '--label[Tampilkan hanya aturan yang labelnya diawali prefiks ini (tidak peka huruf besar/kecil)]:prefix:' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan untuk perintah]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Lewati prompt konfirmasi]' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan untuk perintah]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan untuk perintah]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Jalur ke konfigurasi YAML gateway]:path:_files' \
    '(-h --help)'{-h,--help}'[Tampilkan bantuan untuk perintah]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Hapus semua status Claude Code untuk proyek (transkrip, tugas, riwayat file, entri konfigurasi)'
    'help:Tampilkan bantuan'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Tampilkan bantuan untuk perintah]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'perintah project' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Tampilkan daftar yang akan dihapus tanpa menghapus apa pun]' \
            '(-y --yes)'{-y,--yes}'[Lewati prompt konfirmasi]' \
            '(-i --interactive)'{-i,--interactive}'[Minta konfirmasi untuk setiap item sebelum menghapus]' \
            '(1)--all[Hapus status untuk setiap proyek (tidak dapat digabung dengan path)]' \
            '(-h --help)'{-h,--help}'[Tampilkan bantuan untuk perintah]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Cetak payload bugs.json mentah alih-alih temuan yang diformat]' \
    '--timeout[Menit maksimum untuk menunggu tinjauan selesai (default: 45)]:minutes:' \
    '(--no-post)--post[Posting temuan tinjauan yang selesai ke PR atas nama Anda (hanya target PR; satu komentar biasa, bukan review)]' \
    '(--post)--no-post[Jangan posting temuan ke PR (default)]' \
    '(-h --help)'{-h,--help}'[Tampilkan bantuan untuk perintah]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Mulai ulang setiap sesi latar belakang yang sedang berjalan]' \
    '(-h --help)'{-h,--help}'[Tampilkan bantuan untuk perintah]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Juga buang commit yang belum di-push dan perubahan yang belum di-commit dari worktree (berikan commit@worktree-id yang dilaporkan claude rm sebelumnya)]:commit@worktree-id:' \
    '--force-remove-worktree[Hapus direktori worktree meskipun hook WorktreeRemove atau git tidak dapat menghapusnya (berikan worktree-id yang dilaporkan claude rm sebelumnya)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Tampilkan bantuan untuk perintah]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Tampilkan apa yang akan diimpor tanpa menulis apa pun]' \
    '--yes[Lewati pemilih interaktif (pada antarmuka headless, berikan --yes=<digest> dari pratinjau /import)]' \
    '(-h --help)'{-h,--help}'[Tampilkan bantuan untuk perintah]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
