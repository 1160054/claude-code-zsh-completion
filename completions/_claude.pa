#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:MCP ਸਰਵਰਾਂ ਨੂੰ ਸੰਰਚਿਤ ਅਤੇ ਪ੍ਰਬੰਧਿਤ ਕਰੋ'
    'plugin:Claude Code ਪਲੱਗਇਨਾਂ ਦਾ ਪ੍ਰਬੰਧਨ ਕਰੋ'
    'agents:ਬੈਕਗ੍ਰਾਊਂਡ ਏਜੰਟਾਂ ਦਾ ਪ੍ਰਬੰਧਨ ਕਰੋ'
    'attach:ਇਸ ਟਰਮੀਨਲ ਵਿੱਚ ਇੱਕ ਬੈਕਗ੍ਰਾਊਂਡ ਸੈਸ਼ਨ ਖੋਲ੍ਹੋ'
    'logs:ਇੱਕ ਬੈਕਗ੍ਰਾਊਂਡ ਸੈਸ਼ਨ ਦਾ ਹਾਲੀਆ ਟਰਮੀਨਲ ਆਉਟਪੁੱਟ ਪ੍ਰਿੰਟ ਕਰੋ'
    'stop:ਇੱਕ ਬੈਕਗ੍ਰਾਊਂਡ ਸੈਸ਼ਨ ਰੋਕੋ (ਇਸਦੀ ਗੱਲਬਾਤ ਰੱਖੀ ਜਾਂਦੀ ਹੈ)'
    'respawn:ਇੱਕ ਬੈਕਗ੍ਰਾਊਂਡ ਸੈਸ਼ਨ ਨੂੰ ਮੁੜ ਸ਼ੁਰੂ ਕਰੋ ਤਾਂ ਜੋ ਇਹ ਮੌਜੂਦਾ Claude Code ਸੰਸਕਰਣ ਤੇ ਚੱਲੇ'
    'rm:ਇੱਕ ਬੈਕਗ੍ਰਾਊਂਡ ਸੈਸ਼ਨ ਮਿਟਾਓ, ਅਤੇ ਜਦੋਂ ਸੁਰੱਖਿਅਤ ਹੋਵੇ ਤਾਂ ਇਸਦਾ worktree ਵੀ'
    'auth:ਪ੍ਰਮਾਣਿਕਤਾ ਦਾ ਪ੍ਰਬੰਧਨ ਕਰੋ'
    'auto-mode:ਆਟੋ ਮੋਡ ਵਰਗੀਕਰਤਾ ਸੰਰਚਨਾ ਦਾ ਨਿਰੀਖਣ ਜਾਂ ਰੀਸੈੱਟ ਕਰੋ'
    'gateway:ਐਂਟਰਪ੍ਰਾਈਜ਼ ਪ੍ਰਮਾਣਿਕਤਾ/ਟੈਲੀਮੈਟਰੀ ਗੇਟਵੇ ਚਲਾਓ'
    'import:ਕਿਸੇ ਹੋਰ AI ਕੋਡਿੰਗ ਏਜੰਟ ਤੋਂ Claude Code ਵਿੱਚ ਸੰਰਚਨਾ ਆਯਾਤ ਕਰੋ'
    'project:Claude Code ਪ੍ਰੋਜੈਕਟ ਸਥਿਤੀ ਦਾ ਪ੍ਰਬੰਧਨ ਕਰੋ'
    'ultrareview:ਕਲਾਊਡ-ਹੋਸਟ ਕੀਤੀ ਮਲਟੀ-ਏਜੰਟ ਕੋਡ ਸਮੀਖਿਆ ਚਲਾਓ ਅਤੇ ਨਤੀਜੇ ਪ੍ਰਿੰਟ ਕਰੋ'
    'setup-token:ਲੰਬੇ ਸਮੇਂ ਲਈ ਪ੍ਰਮਾਣਿਕਤਾ ਟੋਕਨ ਸੈੱਟ ਕਰੋ (Claude ਸਬਸਕ੍ਰਿਪਸ਼ਨ ਲੋੜੀਂਦੀ ਹੈ)'
    'doctor:Claude Code ਆਟੋ-ਅੱਪਡੇਟਰ ਲਈ ਸਿਹਤ ਜਾਂਚ'
    'update:ਅੱਪਡੇਟਾਂ ਦੀ ਜਾਂਚ ਕਰੋ ਅਤੇ ਇੰਸਟਾਲ ਕਰੋ'
    'install:Claude Code ਨੇਟਿਵ ਬਿਲਡ ਇੰਸਟਾਲ ਕਰੋ'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[ਵਿਕਲਪਿਕ ਸ਼੍ਰੇਣੀ ਫਿਲਟਰਿੰਗ ਨਾਲ ਡੀਬੱਗ ਮੋਡ ਸਮਰੱਥ ਕਰੋ (ਜਿਵੇਂ, "api,hooks" ਜਾਂ "!statsig,!file")]:filter:'
    '--verbose[ਕੌਂਫਿਗ ਫਾਈਲ ਤੋਂ ਵਰਬੋਜ਼ ਮੋਡ ਸੈਟਿੰਗ ਨੂੰ ਓਵਰਰਾਈਡ ਕਰੋ]'
    '(-p --print)'{-p,--print}'[ਜਵਾਬ ਪ੍ਰਿੰਟ ਕਰੋ ਅਤੇ ਬਾਹਰ ਨਿਕਲੋ (ਪਾਈਪਾਂ ਨਾਲ ਵਰਤੋਂ ਲਈ)। ਨੋਟ: ਸਿਰਫ਼ ਭਰੋਸੇਯੋਗ ਡਾਇਰੈਕਟਰੀਆਂ ਵਿੱਚ ਵਰਤੋਂ ਕਰੋ]'
    '--output-format[ਆਉਟਪੁੱਟ ਫਾਰਮੈਟ (--print ਨਾਲ): "text" (ਡਿਫਾਲਟ), "json" (ਸਿੰਗਲ ਨਤੀਜਾ), ਜਾਂ "stream-json" (ਰੀਅਲ-ਟਾਈਮ ਸਟ੍ਰੀਮਿੰਗ)]:format:(text json stream-json)'
    '--json-schema[ਸੰਰਚਿਤ ਆਉਟਪੁੱਟ ਪ੍ਰਮਾਣਿਕਤਾ ਲਈ JSON ਸਕੀਮਾ]:schema:'
    '--include-partial-messages[ਅੰਸ਼ਕ ਸੰਦੇਸ਼ ਟੁਕੜਿਆਂ ਨੂੰ ਸ਼ਾਮਲ ਕਰੋ ਜਿਵੇਂ ਉਹ ਆਉਂਦੇ ਹਨ (--print ਅਤੇ --output-format=stream-json ਨਾਲ)]'
    '--input-format[ਇਨਪੁੱਟ ਫਾਰਮੈਟ (--print ਨਾਲ): "text" (ਡਿਫਾਲਟ) ਜਾਂ "stream-json" (ਰੀਅਲ-ਟਾਈਮ ਸਟ੍ਰੀਮਿੰਗ ਇਨਪੁੱਟ)]:format:(text stream-json)'
    '--mcp-debug[\[ਪੁਰਾਣਾ। ਇਸ ਦੀ ਬਜਾਏ --debug ਵਰਤੋਂ ਕਰੋ\] MCP ਡੀਬੱਗ ਮੋਡ ਸਮਰੱਥ ਕਰੋ (MCP ਸਰਵਰ ਗਲਤੀਆਂ ਦਿਖਾਉਂਦਾ ਹੈ)]'
    '--dangerously-skip-permissions[ਸਾਰੀਆਂ ਇਜਾਜ਼ਤ ਜਾਂਚਾਂ ਨੂੰ ਬਾਈਪਾਸ ਕਰੋ। ਇੰਟਰਨੈੱਟ ਐਕਸੈਸ ਤੋਂ ਬਿਨਾਂ ਸੈਂਡਬਾਕਸਾਂ ਲਈ ਸਿਫਾਰਿਸ਼ ਕੀਤੀ ਜਾਂਦੀ ਹੈ]'
    '--allow-dangerously-skip-permissions[ਡਿਫਾਲਟ ਰੂਪ ਵਿੱਚ ਸਮਰੱਥ ਕੀਤੇ ਬਿਨਾਂ ਇਜਾਜ਼ਤ ਜਾਂਚਾਂ ਨੂੰ ਬਾਈਪਾਸ ਕਰਨ ਦੇ ਵਿਕਲਪ ਨੂੰ ਸਮਰੱਥ ਕਰੋ]'
    '--restricted[ਪਾਬੰਦੀਸ਼ੁਦਾ ਮੋਡ: ਕਮਾਂਡਾਂ ਜਾਂ ਕੋਡ ਚਲਾਉਣ ਵਾਲੇ ਟੂਲ ਅਤੇ WebFetch ਹਟਾਓ, user/project/local ਸੈਟਿੰਗਜ਼ ਨੂੰ ਅਣਡਿੱਠ ਕਰੋ, ਅਤੇ ਫਾਈਲ ਟੂਲਾਂ ਨੂੰ ਕਾਰਜਕਾਰੀ ਡਾਇਰੈਕਟਰੀਆਂ ਤੱਕ ਸੀਮਤ ਕਰੋ]'
    '--max-budget-usd[API ਕਾਲਾਂ ਤੇ ਖਰਚ ਕਰਨ ਲਈ ਵੱਧ ਤੋਂ ਵੱਧ ਡਾਲਰ ਰਕਮ (ਸਿਰਫ਼ --print)]:amount:'
    '--replay-user-messages[ਪੁਸ਼ਟੀ ਲਈ stdin ਤੋਂ stdout ਤੇ ਉਪਭੋਗਤਾ ਸੰਦੇਸ਼ਾਂ ਨੂੰ ਦੁਬਾਰਾ ਭੇਜੋ]'
    '--allowed-tools[ਇਜਾਜ਼ਤ ਦਿੱਤੇ ਟੂਲ ਨਾਵਾਂ ਦੀ ਕੰਮਾ ਜਾਂ ਸਪੇਸ-ਵਿਭਾਜਿਤ ਸੂਚੀ (ਜਿਵੇਂ, "Bash(git:*) Edit")]:tools:'
    '--allowedTools[ਇਜਾਜ਼ਤ ਦਿੱਤੇ ਟੂਲ ਨਾਵਾਂ ਦੀ ਕੰਮਾ ਜਾਂ ਸਪੇਸ-ਵਿਭਾਜਿਤ ਸੂਚੀ (camelCase ਫਾਰਮੈਟ)]:tools:'
    '--tools[ਬਿਲਟ-ਇਨ ਸੈੱਟ ਤੋਂ ਉਪਲਬਧ ਟੂਲਸ ਦੀ ਸੂਚੀ ਦਰਸਾਓ। ਸਿਰਫ਼ ਪ੍ਰਿੰਟ ਮੋਡ]:tools:'
    '--disallowed-tools[ਅਇਜਾਜ਼ਤ ਟੂਲ ਨਾਵਾਂ ਦੀ ਕੰਮਾ ਜਾਂ ਸਪੇਸ-ਵਿਭਾਜਿਤ ਸੂਚੀ (ਜਿਵੇਂ, "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[ਅਇਜਾਜ਼ਤ ਟੂਲ ਨਾਵਾਂ ਦੀ ਕੰਮਾ ਜਾਂ ਸਪੇਸ-ਵਿਭਾਜਿਤ ਸੂਚੀ (camelCase ਫਾਰਮੈਟ)]:tools:'
    '--mcp-config[JSON ਫਾਈਲ ਜਾਂ ਸਤਰ ਤੋਂ MCP ਸਰਵਰ ਲੋਡ ਕਰੋ (ਸਪੇਸ-ਵਿਭਾਜਿਤ)]:configs:'
    '--system-prompt[ਸੈਸ਼ਨ ਲਈ ਵਰਤਣ ਲਈ ਸਿਸਟਮ ਪ੍ਰੌਂਪਟ]:prompt:'
    '--system-prompt-file[ਇੱਕ ਫਾਈਲ ਤੋਂ ਸਿਸਟਮ ਪ੍ਰੌਂਪਟ ਪੜ੍ਹੋ]:file:_files'
    '--append-system-prompt[ਡਿਫਾਲਟ ਸਿਸਟਮ ਪ੍ਰੌਂਪਟ ਵਿੱਚ ਸਿਸਟਮ ਪ੍ਰੌਂਪਟ ਜੋੜੋ]:prompt:'
    '--append-system-prompt-file[ਇੱਕ ਫਾਈਲ ਤੋਂ ਸਿਸਟਮ ਪ੍ਰੌਂਪਟ ਪੜ੍ਹੋ ਅਤੇ ਡਿਫਾਲਟ ਸਿਸਟਮ ਪ੍ਰੌਂਪਟ ਵਿੱਚ ਜੋੜੋ]:file:_files'
    '--system-prompt-snapshot[ਸਿਸਟਮ ਪ੍ਰੌਂਪਟ ਨੂੰ ਪ੍ਰਤੀ ਗੱਲਬਾਤ ਇੱਕ ਵਾਰ ਰਿਕਾਰਡ ਕਰੋ ਅਤੇ ਹਰ ਬੇਨਤੀ ਅਤੇ ਮੁੜ ਸ਼ੁਰੂ ਕਰਨ ਤੇ ਇਸਨੂੰ ਹੂ-ਬ-ਹੂ ਮੁੜ ਵਰਤੋ (on, ਡਿਫਾਲਟ) ਜਾਂ ਹਰ ਬੇਨਤੀ ਤੇ ਇਸਨੂੰ ਨਵੇਂ ਸਿਰੇ ਤੋਂ ਬਣਾਓ (off)]:mode:(on off)'
    '--permission-mode[ਸੈਸ਼ਨ ਲਈ ਵਰਤਣ ਲਈ ਇਜਾਜ਼ਤ ਮੋਡ]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[--print ਨਾਲ ਇਜਾਜ਼ਤ ਪ੍ਰੌਂਪਟਾਂ ਦਾ ਜਵਾਬ ਕੌਣ ਦਿੰਦਾ ਹੈ: "host" (SDK ਹੋਸਟ ਜਾਂ --permission-prompt-tool) ਜਾਂ "none" (ਜੋ ਵੀ ਪ੍ਰੌਂਪਟ ਕਰੇਗਾ ਉਸਨੂੰ ਇਨਕਾਰ ਕੀਤਾ ਜਾਂਦਾ ਹੈ)]:target:(host none)'
    '--permission-prompt-tool[ਇਜਾਜ਼ਤ ਪ੍ਰੌਂਪਟਾਂ ਲਈ ਵਰਤਣ ਲਈ MCP ਟੂਲ (ਸਿਰਫ਼ --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[ਸਭ ਤੋਂ ਤਾਜ਼ਾ ਗੱਲਬਾਤ ਜਾਰੀ ਰੱਖੋ]'
    '(-r --resume)'{-r,--resume}'[ਇੱਕ ਗੱਲਬਾਤ ਮੁੜ ਸ਼ੁਰੂ ਕਰੋ - ਸੈਸ਼ਨ ID ਦਰਸਾਓ ਜਾਂ ਇੰਟਰਐਕਟਿਵ ਤੌਰ ਤੇ ਚੁਣੋ]:sessionId:_claude_sessions'
    '--fork-session[ਮੁੜ ਸ਼ੁਰੂ ਕਰਨ ਸਮੇਂ ਮੂਲ ਸੈਸ਼ਨ ID ਦੀ ਮੁੜ ਵਰਤੋਂ ਕਰਨ ਦੀ ਬਜਾਏ ਨਵਾਂ ਸੈਸ਼ਨ ID ਬਣਾਓ (--resume ਜਾਂ --continue ਨਾਲ)]'
    '--no-session-persistence[ਸੈਸ਼ਨ ਸਥਿਰਤਾ ਅਸਮਰੱਥ ਕਰੋ - ਸੈਸ਼ਨ ਸੰਭਾਲੇ ਨਹੀਂ ਜਾਣਗੇ (ਸਿਰਫ਼ --print)]'
    '--model[ਮੌਜੂਦਾ ਸੈਸ਼ਨ ਲਈ ਮਾਡਲ। ਨਵੀਨਤਮ ਮਾਡਲ ਲਈ ਉਪਨਾਮ ਦਰਸਾਓ (ਜਿਵੇਂ, '\''sonnet'\'' ਜਾਂ '\''opus'\'')]:model:_claude_model_names'
    '--agent[ਮੌਜੂਦਾ ਸੈਸ਼ਨ ਲਈ ਏਜੰਟ। '\''agent'\'' ਸੈਟਿੰਗ ਨੂੰ ਓਵਰਰਾਈਡ ਕਰਦਾ ਹੈ]:agent:_claude_agent_names'
    '--betas[API ਬੇਨਤੀਆਂ ਵਿੱਚ ਸ਼ਾਮਲ ਕਰਨ ਲਈ ਬੀਟਾ ਹੈਡਰ (ਸਿਰਫ਼ API ਕੁੰਜੀ ਉਪਭੋਗਤਾ)]:betas:'
    '--fallback-model[ਜਦੋਂ ਡਿਫਾਲਟ ਮਾਡਲ ਓਵਰਲੋਡ ਹੋਵੇ ਤਾਂ ਦਰਸਾਏ ਮਾਡਲ ਵਿੱਚ ਸਵੈਚਲਿਤ ਫਾਲਬੈਕ ਸਮਰੱਥ ਕਰੋ (ਸਿਰਫ਼ --print)]:model:_claude_model_names'
    '--settings[ਸੈਟਿੰਗਜ਼ JSON ਫਾਈਲ ਜਾਂ ਵਾਧੂ ਸੈਟਿੰਗਜ਼ ਲੋਡ ਕਰਨ ਲਈ JSON ਸਤਰ ਦਾ ਮਾਰਗ]:file-or-json:_files'
    '--add-dir[ਟੂਲ ਐਕਸੈਸ ਦੀ ਇਜਾਜ਼ਤ ਦੇਣ ਲਈ ਵਾਧੂ ਡਾਇਰੈਕਟਰੀਆਂ]:directories:_directories'
    '--ide[ਜੇਕਰ ਬਿਲਕੁਲ ਇੱਕ ਵੈਧ IDE ਉਪਲਬਧ ਹੈ ਤਾਂ ਸਟਾਰਟਅੱਪ ਤੇ IDE ਨਾਲ ਆਟੋ-ਕਨੈਕਟ ਕਰੋ]'
    '--desktop[ਟਰਮੀਨਲ ਦੀ ਬਜਾਏ Claude Desktop ਐਪ ਵਿੱਚ ਖੋਲ੍ਹੋ (ਸੈਸ਼ਨ ਚੁਣਨ ਲਈ --continue ਜਾਂ --resume <id> ਨਾਲ)]'
    '--strict-mcp-config[ਸਿਰਫ਼ --mcp-config ਤੋਂ MCP ਸਰਵਰ ਵਰਤੋਂ ਕਰੋ ਅਤੇ ਹੋਰ ਸਾਰੀਆਂ MCP ਸੈਟਿੰਗਜ਼ ਨੂੰ ਅਣਡਿੱਠ ਕਰੋ]'
    '--session-id[ਗੱਲਬਾਤ ਲਈ ਵਰਤਣ ਲਈ ਖਾਸ ਸੈਸ਼ਨ ID (ਵੈਧ UUID ਹੋਣਾ ਚਾਹੀਦਾ ਹੈ)]:uuid:'
    '--agents[ਕਸਟਮ ਏਜੰਟਾਂ ਨੂੰ ਪਰਿਭਾਸ਼ਿਤ ਕਰਨ ਵਾਲਾ JSON ਆਬਜੈਕਟ]:json:'
    '--setting-sources[ਲੋਡ ਕਰਨ ਲਈ ਸੈਟਿੰਗ ਸਰੋਤਾਂ ਦੀ ਕੰਮਾ-ਵਿਭਾਜਿਤ ਸੂਚੀ (user, project, local)]:sources:'
    '--plugin-dir[ਸਿਰਫ਼ ਇਸ ਸੈਸ਼ਨ ਲਈ ਪਲੱਗਇਨਾਂ ਲੋਡ ਕਰਨ ਲਈ ਡਾਇਰੈਕਟਰੀ (ਦੁਹਰਾਉਣਯੋਗ)]:paths:_directories'
    '--disable-slash-commands[ਸਾਰੀਆਂ ਸਲੈਸ਼ ਕਮਾਂਡਾਂ ਅਸਮਰੱਥ ਕਰੋ]'
    '(--bg --background)'{--bg,--background}'[ਸੈਸ਼ਨ ਨੂੰ ਬੈਕਗ੍ਰਾਊਂਡ ਏਜੰਟ ਵਜੋਂ ਸ਼ੁਰੂ ਕਰੋ ਅਤੇ ਤੁਰੰਤ ਵਾਪਸ ਆਓ]'
    '(-w --worktree)'{-w,--worktree}'[ਇਸ ਸੈਸ਼ਨ ਲਈ ਇੱਕ ਨਵਾਂ git worktree ਬਣਾਓ (ਵਿਕਲਪਿਕ ਤੌਰ ਤੇ ਇੱਕ ਨਾਮ ਦਰਸਾਓ)]::name:'
    '--tmux=-[worktree ਲਈ ਇੱਕ tmux ਸੈਸ਼ਨ ਬਣਾਓ (--worktree ਲੋੜੀਂਦਾ ਹੈ)। ਉਪਲਬਧ ਹੋਣ ਤੇ iTerm2 ਨੇਟਿਵ ਪੇਨ ਵਰਤਦਾ ਹੈ; ਰਵਾਇਤੀ tmux ਲਈ --tmux=classic]::mode:(classic)'
    '(-n --name)'{-n,--name}'[ਇਸ ਸੈਸ਼ਨ ਲਈ ਇੱਕ ਡਿਸਪਲੇ ਨਾਮ ਸੈੱਟ ਕਰੋ]:name:'
    '--effort[ਮੌਜੂਦਾ ਸੈਸ਼ਨ ਲਈ ਯਤਨ ਪੱਧਰ]:level:(low medium high xhigh max)'
    '--autocompact[ਆਟੋ-ਕੰਪੈਕਟ ਵਿੰਡੋ ਆਕਾਰ (auto, ਜਾਂ 100k-1M ਟੋਕਨ)]:size:(auto)'
    '--debug-file[ਖਾਸ ਫਾਈਲ ਮਾਰਗ ਤੇ ਡੀਬੱਗ ਲੌਗ ਲਿਖੋ (ਸੰਕੇਤਕ ਤੌਰ ਤੇ ਡੀਬੱਗ ਮੋਡ ਸਮਰੱਥ ਕਰਦਾ ਹੈ)]:path:_files'
    '--from-pr[ਨੰਬਰ/URL ਦੁਆਰਾ ਇੱਕ PR ਨਾਲ ਜੁੜੇ ਸੈਸ਼ਨ ਨੂੰ ਮੁੜ ਸ਼ੁਰੂ ਕਰੋ, ਜਾਂ ਇੰਟਰਐਕਟਿਵ ਚੋਣਕਾਰ ਖੋਲ੍ਹੋ]::value:'
    '--teleport[ਇੱਕ ਟੈਲੀਪੋਰਟ ਸੈਸ਼ਨ ਮੁੜ ਸ਼ੁਰੂ ਕਰੋ, ਵਿਕਲਪਿਕ ਤੌਰ ਤੇ ਸੈਸ਼ਨ ID ਦਰਸਾਓ]::session:'
    '--cloud[ਦਿੱਤੇ ਵੇਰਵੇ ਨਾਲ ਇੱਕ ਕਲਾਊਡ ਸੈਸ਼ਨ ਬਣਾਓ, ਜਾਂ ਸੈਸ਼ਨ ID ਜਾਂ claude.ai/code URL ਦੁਆਰਾ ਇੱਕ ਮੌਜੂਦਾ ਸੈਸ਼ਨ ਨਾਲ ਜੁੜੋ]::description-or-session:'
    '--environment[ਇੱਕ ਨਵਾਂ ਕਲਾਊਡ ਸੈਸ਼ਨ ਬਣਾਓ ਜੋ ਦਿੱਤੇ ਸਵੈ-ਹੋਸਟ ਕੀਤੇ ਵਾਤਾਵਰਣ (ccpool_...) ਤੇ ਚੱਲਦਾ ਹੈ]:environment_id:'
    '--remote-control[ਰਿਮੋਟ ਕੰਟਰੋਲ ਸਮਰੱਥ ਨਾਲ ਇੱਕ ਇੰਟਰਐਕਟਿਵ ਸੈਸ਼ਨ ਸ਼ੁਰੂ ਕਰੋ (ਵਿਕਲਪਿਕ ਤੌਰ ਤੇ ਨਾਮ ਦਿੱਤਾ)]::name:'
    '--remote-control-session-name-prefix[ਸਵੈ-ਉਤਪੰਨ ਰਿਮੋਟ ਕੰਟਰੋਲ ਸੈਸ਼ਨ ਨਾਵਾਂ ਲਈ ਅਗੇਤਰ]:prefix:'
    '--chrome[Chrome ਏਕੀਕਰਨ ਵਿੱਚ Claude ਸਮਰੱਥ ਕਰੋ]'
    '--no-chrome[Chrome ਏਕੀਕਰਨ ਵਿੱਚ Claude ਅਸਮਰੱਥ ਕਰੋ]'
    '--plugin-url[ਸਿਰਫ਼ ਇਸ ਸੈਸ਼ਨ ਲਈ ਇੱਕ URL ਤੋਂ ਇੱਕ ਪਲੱਗਇਨ .zip ਪ੍ਰਾਪਤ ਕਰੋ (ਦੁਹਰਾਉਣਯੋਗ)]:url:'
    '--file[ਸਟਾਰਟਅੱਪ ਤੇ ਡਾਊਨਲੋਡ ਕਰਨ ਲਈ ਫਾਈਲ ਸਰੋਤ (ਫਾਰਮੈਟ: file_id:relative_path)]:specs:'
    '--prompt-suggestions[ਪ੍ਰੌਂਪਟ ਸੁਝਾਅ ਸਮਰੱਥ ਕਰੋ (print/SDK ਮੋਡ ਵਿੱਚ ਇੱਕ ਭਵਿੱਖਬਾਣੀ ਕੀਤਾ ਅਗਲਾ ਪ੍ਰੌਂਪਟ ਨਿਕਾਸ ਕਰਦਾ ਹੈ)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[ਸਬਏਜੰਟ ਟੈਕਸਟ ਅਤੇ ਸੋਚ ਬਲਾਕਾਂ ਨੂੰ ਸੰਦੇਸ਼ਾਂ ਵਜੋਂ ਅੱਗੇ ਭੇਜੋ (--print ਅਤੇ stream-json ਨਾਲ)]'
    '--include-hook-events[ਆਉਟਪੁੱਟ ਸਟ੍ਰੀਮ ਵਿੱਚ ਸਾਰੇ ਹੁੱਕ ਜੀਵਨ-ਚੱਕਰ ਘਟਨਾਵਾਂ ਸ਼ਾਮਲ ਕਰੋ (stream-json ਨਾਲ)]'
    '--exclude-dynamic-system-prompt-sections[ਪ੍ਰੌਂਪਟ-ਕੈਸ਼ ਮੁੜ ਵਰਤੋਂ ਸੁਧਾਰਨ ਲਈ ਪ੍ਰਤੀ-ਮਸ਼ੀਨ ਭਾਗਾਂ ਨੂੰ ਪਹਿਲੇ ਉਪਭੋਗਤਾ ਸੰਦੇਸ਼ ਵਿੱਚ ਭੇਜੋ]'
    '--brief[ਏਜੰਟ-ਤੋਂ-ਉਪਭੋਗਤਾ ਸੰਚਾਰ ਲਈ SendUserMessage ਟੂਲ ਸਮਰੱਥ ਕਰੋ]'
    '--safe-mode[ਸਾਰੇ ਕਸਟਮਾਈਜ਼ੇਸ਼ਨ ਅਸਮਰੱਥ ਨਾਲ ਸ਼ੁਰੂ ਕਰੋ (ਟੁੱਟੀ ਸੰਰਚਨਾ ਦੇ ਨਿਪਟਾਰੇ ਲਈ ਲਾਭਦਾਇਕ)]'
    '--bare[ਨਿਊਨਤਮ ਮੋਡ: ਹੁੱਕ, LSP, ਪਲੱਗਇਨ ਸਿੰਕ, ਵਿਸ਼ੇਸ਼ਤਾ, ਆਟੋ-ਮੈਮੋਰੀ, ਅਤੇ CLAUDE.md ਆਟੋ-ਖੋਜ ਛੱਡੋ]'
    '--ax-screen-reader[ਸਕ੍ਰੀਨ-ਰੀਡਰ ਅਨੁਕੂਲ ਆਉਟਪੁੱਟ ਪੇਸ਼ ਕਰੋ (ਸਮਤਲ ਟੈਕਸਟ, ਕੋਈ ਸਜਾਵਟੀ ਬਾਰਡਰ ਜਾਂ ਐਨੀਮੇਸ਼ਨ ਨਹੀਂ)]'
    '(-v --version)'{-v,--version}'[ਸੰਸਕਰਣ ਨੰਬਰ ਆਉਟਪੁੱਟ ਕਰੋ]'
    '(-h --help)'{-h,--help}'[ਕਮਾਂਡ ਲਈ ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude commands' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[ਕਮਾਂਡ ਲਈ ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "ਕੋਈ ਆਰਗੂਮੈਂਟ ਨਹੀਂ"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:ਇੱਕ Claude Code MCP ਸਰਵਰ ਸ਼ੁਰੂ ਕਰੋ'
    'add:Claude Code ਵਿੱਚ ਇੱਕ MCP ਸਰਵਰ ਜੋੜੋ'
    'remove:ਇੱਕ MCP ਸਰਵਰ ਹਟਾਓ'
    'list:ਸੰਰਚਿਤ MCP ਸਰਵਰਾਂ ਦੀ ਸੂਚੀ ਬਣਾਓ'
    'get:MCP ਸਰਵਰ ਵੇਰਵੇ ਪ੍ਰਾਪਤ ਕਰੋ'
    'add-json:JSON ਸਤਰ ਨਾਲ ਇੱਕ MCP ਸਰਵਰ (stdio ਜਾਂ SSE) ਜੋੜੋ'
    'add-from-claude-desktop:Claude Desktop ਤੋਂ MCP ਸਰਵਰ ਆਯਾਤ ਕਰੋ (ਸਿਰਫ਼ Mac ਅਤੇ WSL)'
    'reset-project-choices:ਇਸ ਪ੍ਰੋਜੈਕਟ ਵਿੱਚ ਸਾਰੇ ਮਨਜ਼ੂਰ/ਅਸਵੀਕਾਰ ਪ੍ਰੋਜੈਕਟ-ਸਕੋਪਡ (.mcp.json) ਸਰਵਰਾਂ ਨੂੰ ਰੀਸੈੱਟ ਕਰੋ'
    'login:ਇੱਕ MCP ਸਰਵਰ ਨਾਲ ਪ੍ਰਮਾਣਿਤ ਕਰੋ (HTTP, SSE, ਜਾਂ claude.ai ਕਨੈਕਟਰ)'
    'logout:ਇੱਕ MCP ਸਰਵਰ ਲਈ ਸਟੋਰ ਕੀਤੇ OAuth ਪ੍ਰਮਾਣ ਪੱਤਰ ਸਾਫ਼ ਕਰੋ'
    'help:ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp commands' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[ਡੀਬੱਗ ਮੋਡ ਸਮਰੱਥ ਕਰੋ]' \
            '--verbose[ਕੌਂਫਿਗ ਫਾਈਲ ਤੋਂ ਵਰਬੋਜ਼ ਮੋਡ ਸੈਟਿੰਗ ਨੂੰ ਓਵਰਰਾਈਡ ਕਰੋ]' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ਕੌਂਫਿਗ ਸਕੋਪ (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[ਟ੍ਰਾਂਸਪੋਰਟ ਕਿਸਮ (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[ਵਾਤਾਵਰਣ ਚਰ ਸੈੱਟ ਕਰੋ (ਜਿਵੇਂ, -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[WebSocket ਹੈਡਰ ਸੈੱਟ ਕਰੋ]:header:' \
            '--client-id[HTTP/SSE ਸਰਵਰਾਂ ਲਈ OAuth ਕਲਾਇੰਟ ID]:clientId:' \
            '--client-secret[OAuth ਕਲਾਇੰਟ ਸੀਕ੍ਰੇਟ ਲਈ ਪ੍ਰੌਂਪਟ ਕਰੋ (ਜਾਂ MCP_CLIENT_SECRET ਵਾਤਾਵਰਣ ਚਰ ਸੈੱਟ ਕਰੋ)]' \
            '--callback-port[OAuth ਕਾਲਬੈਕ ਲਈ ਸਥਿਰ ਪੋਰਟ (ਪਹਿਲਾਂ ਤੋਂ ਰਜਿਸਟਰ ਕੀਤੇ ਰੀਡਾਇਰੈਕਟ URI ਲੋੜੀਂਦੇ ਸਰਵਰਾਂ ਲਈ)]:port:' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ਕੌਂਫਿਗ ਸਕੋਪ (local, user, project) - ਜੇਕਰ ਅਨਿਰਦੇਸ਼ਿਤ ਹੋਵੇ ਤਾਂ ਮੌਜੂਦਾ ਸਕੋਪ ਤੋਂ ਹਟਾਓ]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ਕੌਂਫਿਗ ਸਕੋਪ (local, user, project)]:scope:(local user project)' \
            '--client-secret[OAuth ਕਲਾਇੰਟ ਸੀਕ੍ਰੇਟ ਲਈ ਪ੍ਰੌਂਪਟ ਕਰੋ (ਜਾਂ MCP_CLIENT_SECRET ਵਾਤਾਵਰਣ ਚਰ ਸੈੱਟ ਕਰੋ)]' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ਕੌਂਫਿਗ ਸਕੋਪ (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]'
          ;;
        login)
          _arguments \
            '--no-browser[ਬ੍ਰਾਊਜ਼ਰ ਖੋਲ੍ਹਣ ਦੀ ਬਜਾਏ ਅਧਿਕਾਰ URL ਪ੍ਰਿੰਟ ਕਰੋ (SSH/ਹੈੱਡਲੈੱਸ ਸੈਸ਼ਨਾਂ ਲਈ)]' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:ਇੱਕ ਪਲੱਗਇਨ ਜਾਂ ਮਾਰਕੀਟਪਲੇਸ ਮੈਨੀਫੈਸਟ ਨੂੰ ਪ੍ਰਮਾਣਿਤ ਕਰੋ'
    'marketplace:Claude Code ਮਾਰਕੀਟਪਲੇਸਾਂ ਦਾ ਪ੍ਰਬੰਧਨ ਕਰੋ'
    'list:ਇੰਸਟਾਲ ਕੀਤੀਆਂ ਪਲੱਗਇਨਾਂ ਦੀ ਸੂਚੀ ਬਣਾਓ'
    'details:ਇੱਕ ਪਲੱਗਇਨ ਲਈ ਕੰਪੋਨੈਂਟ ਸੂਚੀ ਅਤੇ ਅਨੁਮਾਨਿਤ ਟੋਕਨ ਲਾਗਤ ਦਿਖਾਓ'
    'configure:ਇੱਕ ਪਲੱਗਇਨ ਦੇ ਵਿਕਲਪ ਅਤੇ ਕਿਹੜੇ ਅਣਸੈੱਟ ਹਨ ਦਿਖਾਓ, ਜਾਂ stdin ਤੋਂ ਮੁੱਲ ਸੰਭਾਲੋ'
    'install:ਉਪਲਬਧ ਮਾਰਕੀਟਪਲੇਸਾਂ ਤੋਂ ਇੱਕ ਪਲੱਗਇਨ ਇੰਸਟਾਲ ਕਰੋ'
    'i:ਉਪਲਬਧ ਮਾਰਕੀਟਪਲੇਸਾਂ ਤੋਂ ਇੱਕ ਪਲੱਗਇਨ ਇੰਸਟਾਲ ਕਰੋ (install ਲਈ ਛੋਟਾ)'
    'init:ਇੱਕ ਨਵੀਂ ਪਲੱਗਇਨ ਸਕੈਫੋਲਡ ਕਰੋ (ਅਗਲੇ ਸੈਸ਼ਨ ਵਿੱਚ ਆਟੋ-ਲੋਡ ਹੁੰਦੀ ਹੈ)'
    'new:ਇੱਕ ਨਵੀਂ ਪਲੱਗਇਨ ਸਕੈਫੋਲਡ ਕਰੋ (init ਲਈ ਉਪਨਾਮ)'
    'uninstall:ਇੱਕ ਇੰਸਟਾਲ ਕੀਤੀ ਪਲੱਗਇਨ ਅਨਇੰਸਟਾਲ ਕਰੋ'
    'remove:ਇੱਕ ਇੰਸਟਾਲ ਕੀਤੀ ਪਲੱਗਇਨ ਅਨਇੰਸਟਾਲ ਕਰੋ (uninstall ਲਈ ਉਪਨਾਮ)'
    'enable:ਇੱਕ ਅਸਮਰੱਥ ਪਲੱਗਇਨ ਸਮਰੱਥ ਕਰੋ'
    'disable:ਇੱਕ ਸਮਰੱਥ ਪਲੱਗਇਨ ਅਸਮਰੱਥ ਕਰੋ'
    'update:ਇੱਕ ਪਲੱਗਇਨ ਨੂੰ ਨਵੀਨਤਮ ਸੰਸਕਰਣ ਵਿੱਚ ਅੱਪਡੇਟ ਕਰੋ'
    'eval:ਇੱਕ ਪਲੱਗਇਨ ਦੇ ਵਿਰੁੱਧ eval ਕੇਸ ਚਲਾਓ ਅਤੇ ਸਕੋਰ ਕੀਤੇ ਨਤੀਜੇ ਰਿਪੋਰਟ ਕਰੋ'
    'prune:ਸਵੈ-ਇੰਸਟਾਲ ਕੀਤੀਆਂ ਨਿਰਭਰਤਾਵਾਂ ਹਟਾਓ ਜਿਨ੍ਹਾਂ ਦੀ ਹੁਣ ਲੋੜ ਨਹੀਂ'
    'autoremove:ਸਵੈ-ਇੰਸਟਾਲ ਕੀਤੀਆਂ ਨਿਰਭਰਤਾਵਾਂ ਹਟਾਓ ਜਿਨ੍ਹਾਂ ਦੀ ਹੁਣ ਲੋੜ ਨਹੀਂ (prune ਲਈ ਉਪਨਾਮ)'
    'tag:ਇੱਕ ਪਲੱਗਇਨ ਰਿਲੀਜ਼ ਲਈ ਇੱਕ {name}--v{version} git ਟੈਗ ਬਣਾਓ'
    'test:ਇੱਕ mod ਦੇ ਟੈਸਟ ਚਲਾਓ'
    'help:ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin commands' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[ਚੇਤਾਵਨੀਆਂ ਨੂੰ ਗਲਤੀਆਂ ਵਜੋਂ ਮੰਨੋ (ਐਗਜ਼ਿਟ ਕੋਡ 1)]' \
            '--json[ਪ੍ਰਮਾਣਿਕਤਾ ਰਿਪੋਰਟ ਨੂੰ JSON ਵਜੋਂ ਆਉਟਪੁੱਟ ਕਰੋ (ਉਹੀ ਐਗਜ਼ਿਟ ਕੋਡ)]' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ਇੰਸਟਾਲੇਸ਼ਨ ਸਕੋਪ]:scope:(user project local)' \
            '*--config[ਪਲੱਗਇਨ ਮੈਨੀਫੈਸਟ ਵਿੱਚ ਘੋਸ਼ਿਤ ਇੱਕ userConfig ਵਿਕਲਪ ਸੈੱਟ ਕਰੋ (ਦੁਹਰਾਉਣਯੋਗ)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[ਮਾਰਕੀਟਪਲੇਸ ਦੁਆਰਾ ਘੋਸ਼ਿਤ ਪ੍ਰਦਰਸ਼ਿਤ ਕਮਾਂਡ ਨੂੰ ਪੁਸ਼ਟੀ ਪ੍ਰੌਂਪਟ ਤੋਂ ਬਿਨਾਂ ਸਵੀਕਾਰ ਕਰੋ]' \
            '--json[ਮਨੁੱਖੀ ਸੰਦੇਸ਼ ਦੀ ਬਜਾਏ ਇੱਕ ਮਸ਼ੀਨ-ਪੜ੍ਹਨਯੋਗ ਨਤੀਜਾ ਲਾਈਨ ਪ੍ਰਿੰਟ ਕਰੋ]' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ਇੰਸਟਾਲੇਸ਼ਨ ਸਕੋਪ]:scope:(user project local)' \
            '--keep-data[ਪਲੱਗਇਨ ਦੀ ਸਥਾਈ ਡਾਟਾ ਡਾਇਰੈਕਟਰੀ ਸੁਰੱਖਿਅਤ ਰੱਖੋ]' \
            '--prune[ਸਵੈ-ਇੰਸਟਾਲ ਕੀਤੀਆਂ ਨਿਰਭਰਤਾਵਾਂ ਵੀ ਹਟਾਓ ਜਿਨ੍ਹਾਂ ਦੀ ਹੁਣ ਲੋੜ ਨਹੀਂ]' \
            '(-y --yes)'{-y,--yes}'[--prune ਪੁਸ਼ਟੀ ਪ੍ਰੌਂਪਟ ਛੱਡੋ]' \
            '--json[ਮਨੁੱਖੀ ਸੰਦੇਸ਼ ਦੀ ਬਜਾਏ ਇੱਕ ਮਸ਼ੀਨ-ਪੜ੍ਹਨਯੋਗ ਨਤੀਜਾ ਲਾਈਨ ਪ੍ਰਿੰਟ ਕਰੋ (--prune ਨਾਲ ਨਹੀਂ)]' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ਇੰਸਟਾਲੇਸ਼ਨ ਸਕੋਪ]:scope:(user project local)' \
            '--json[ਮਨੁੱਖੀ ਸੰਦੇਸ਼ ਦੀ ਬਜਾਏ ਇੱਕ ਮਸ਼ੀਨ-ਪੜ੍ਹਨਯੋਗ ਨਤੀਜਾ ਲਾਈਨ ਪ੍ਰਿੰਟ ਕਰੋ]' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[ਸਾਰੀਆਂ ਸਮਰੱਥ ਪਲੱਗਇਨਾਂ ਅਸਮਰੱਥ ਕਰੋ]' \
            '(-s --scope)'{-s,--scope}'[ਇੰਸਟਾਲੇਸ਼ਨ ਸਕੋਪ]:scope:(user project local)' \
            '--json[ਮਨੁੱਖੀ ਸੰਦੇਸ਼ ਦੀ ਬਜਾਏ ਇੱਕ ਮਸ਼ੀਨ-ਪੜ੍ਹਨਯੋਗ ਨਤੀਜਾ ਲਾਈਨ ਪ੍ਰਿੰਟ ਕਰੋ]' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ਇੰਸਟਾਲੇਸ਼ਨ ਸਕੋਪ]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[ਮਾਰਕੀਟਪਲੇਸ ਦੁਆਰਾ ਘੋਸ਼ਿਤ ਪ੍ਰਦਰਸ਼ਿਤ ਕਮਾਂਡ ਨੂੰ ਪੁਸ਼ਟੀ ਪ੍ਰੌਂਪਟ ਤੋਂ ਬਿਨਾਂ ਸਵੀਕਾਰ ਕਰੋ]' \
            '--json[ਮਨੁੱਖੀ ਸੰਦੇਸ਼ ਦੀ ਬਜਾਏ ਇੱਕ ਮਸ਼ੀਨ-ਪੜ੍ਹਨਯੋਗ ਨਤੀਜਾ ਲਾਈਨ ਪ੍ਰਿੰਟ ਕਰੋ]' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[JSON ਵਜੋਂ ਆਉਟਪੁੱਟ ਕਰੋ]' \
            '--available[ਮਾਰਕੀਟਪਲੇਸਾਂ ਤੋਂ ਉਪਲਬਧ ਪਲੱਗਇਨਾਂ ਸ਼ਾਮਲ ਕਰੋ (--json ਲੋੜੀਂਦਾ ਹੈ)]' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ਸਕੋਪ ਤੇ prune ਕਰੋ]:scope:(user project local)' \
            '--dry-run[ਹਟਾਏ ਬਿਨਾਂ ਸੂਚੀ ਦਿਖਾਓ ਕਿ ਕੀ ਹਟਾਇਆ ਜਾਵੇਗਾ]' \
            '(-y --yes)'{-y,--yes}'[ਪੁਸ਼ਟੀ ਪ੍ਰੌਂਪਟ ਛੱਡੋ]' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]'
          ;;
        configure)
          _arguments \
            '--json[JSON ਵਜੋਂ ਆਉਟਪੁੱਟ ਕਰੋ]' \
            '--values-stdin[stdin ਤੋਂ ਵਿਕਲਪ ਮੁੱਲਾਂ ਨੂੰ ਸਿੰਗਲ-ਲਾਈਨ ਸਤਰਾਂ ਦੇ JSON ਆਬਜੈਕਟ ਵਜੋਂ ਪੜ੍ਹੋ; ਛੱਡੇ ਗਏ ਵਿਕਲਪ ਆਪਣੇ ਮੁੱਲ ਰੱਖਦੇ ਹਨ]' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[ਮੈਨੀਫੈਸਟ ਵੇਰਵਾ]:text:' \
            '--author[ਲੇਖਕ ਦਾ ਨਾਮ (ਡਿਫਾਲਟ: git config user.name)]:name:' \
            '--author-email[ਲੇਖਕ ਦੀ ਈਮੇਲ (ਡਿਫਾਲਟ: git config user.email)]:email:' \
            '--with[ਨਾਲ ਹੀ ਸਕੈਫੋਲਡ ਕਰਨ ਲਈ ਕੰਪੋਨੈਂਟ]:components:' \
            '(-f --force)'{-f,--force}'[ਟੀਚੇ ਤੇ ਮੌਜੂਦਾ .claude-plugin/ ਨੂੰ ਓਵਰਰਾਈਟ ਕਰੋ]' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[ਨਾਮ glob ਦੁਆਰਾ ਕੇਸ ਫਿਲਟਰ ਕਰੋ]:glob:' \
            '*--tag[ਟੈਗ ਦੁਆਰਾ ਕੇਸ ਫਿਲਟਰ ਕਰੋ (ਦੁਹਰਾਉਣਯੋਗ)]:tag:' \
            '--runs[ਪ੍ਰਤੀ-ਕੇਸ ਰਨਾਂ ਨੂੰ ਓਵਰਰਾਈਡ ਕਰੋ (ਡਿਫਾਲਟ: case.runs, ਨਹੀਂ ਤਾਂ 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[ਇੱਕੋ ਸਮੇਂ n ਤੱਕ ਏਜੰਟ ਰਨ ਚਲਾਓ (1-8; ਡਿਫਾਲਟ 1)]:n:' \
            '--model[ਸਾਰੇ ਕੇਸਾਂ ਲਈ ਮਾਡਲ ਓਵਰਰਾਈਡ ਕਰੋ]:model:_claude_model_names' \
            '--judge-model[LLM-ਗ੍ਰੇਡਰ ਮਾਡਲ ਓਵਰਰਾਈਡ ਕਰੋ (ਡਿਫਾਲਟ: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[ਸਖ਼ਤ ਲਾਗਤ ਸੀਮਾ; ਪਹੁੰਚਣ ਤੇ ਰੱਦ ਕਰੋ ਅਤੇ ਅੰਸ਼ਕ ਨਤੀਜੇ ਰਿਪੋਰਟ ਕਰੋ (ਐਗਜ਼ਿਟ ਕੋਡ 2)]:usd:' \
            '--output-dir[aggregate-result.json ਲਈ ਡਾਇਰੈਕਟਰੀ]:dir:_directories' \
            '--eval-dir[ਡਾਇਰੈਕਟਰੀ ਨਾਮ (ਪਲੱਗਇਨ ਦੇ ਹੇਠਾਂ) ਜਿਸ ਵਿੱਚ eval ਕੇਸ ਹਨ]:dir:' \
            '--json[ਪੂਰਾ ਰਨ ਨਤੀਜਾ JSON ਵਜੋਂ stdout ਤੇ ਪ੍ਰਿੰਟ ਕਰੋ, ਜਾਂ ਇਸਨੂੰ ਇਸ .json ਫਾਈਲ ਵਿੱਚ ਲਿਖੋ]::path:_files' \
            '--threshold[ਜੇਕਰ ਕਿਸੇ ਕੇਸ ਦਾ ਸਕੋਰ ਇਸ ਸੀਮਾ ਤੋਂ ਘੱਟ ਹੈ ਤਾਂ ਐਗਜ਼ਿਟ ਕੋਡ 1 ਨਾਲ ਬਾਹਰ ਨਿਕਲੋ (ਡਿਫਾਲਟ: 1.0)]:threshold:' \
            '*--allow-tools[ਗੇਟ ਕੀਤੇ ਟੂਲਾਂ ਲਈ ਓਪਰੇਟਰ ਇਜਾਜ਼ਤ (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[ਹਰੇਕ ਕੇਸ ਦੀ scaffold_script ਚਲਾਓ (ਲੇਖਕ ਦੁਆਰਾ ਦਿੱਤੀ bash ਤੁਹਾਡੇ ਖਾਤੇ ਹੇਠ ਚਲਾਉਂਦਾ ਹੈ; ਡਿਫਾਲਟ ਰੂਪ ਵਿੱਚ ਬੰਦ)]' \
            '(--scaffold)--no-scaffold[scaffold_script ਨੂੰ ਸਪੱਸ਼ਟ ਤੌਰ ਤੇ ਛੱਡੋ]' \
            '--trust-plugin[ਪੁਸ਼ਟੀ ਕਰੋ ਕਿ ਤੁਸੀਂ ਇਸ ਪਲੱਗਇਨ ਅਤੇ ਇਸਦੇ eval ਸੂਟ ਤੇ ਭਰੋਸਾ ਕਰਦੇ ਹੋ, ਪਹਿਲੀ-ਰਨ ਭਰੋਸਾ ਪ੍ਰੌਂਪਟ ਛੱਡਦੇ ਹੋਏ (CI ਲਈ)]' \
            '--ablation[ਪਲੱਗਇਨ ਤੋਂ ਬਿਨਾਂ ਇੱਕ ਬੇਸਲਾਈਨ ਤੁਲਨਾ ਸਮੂਹ ਚਲਾਓ ਅਤੇ ਸਕੋਰ ਅੰਤਰ ਰਿਪੋਰਟ ਕਰੋ]:mode:(none with-without)' \
            '--mocks[MCP ਸਰਵਰਾਂ ਲਈ ਨਕਲੀ ਬਦਲ, <eval dir>/mocks/ ਤੋਂ]:mode:(record off)' \
            '--allow-real-servers[--mocks record ਨਾਲ: ਉਹ ਅਸਲ MCP ਸਰਵਰ ਪ੍ਰਕਿਰਿਆਵਾਂ ਵੀ ਸ਼ੁਰੂ ਕਰੋ ਜਿਨ੍ਹਾਂ ਦਾ ਕੋਈ mock ਨਹੀਂ ਹੈ]' \
            '--keep-temp[ਡੀਬੱਗਿੰਗ ਲਈ ਸਕੈਫੋਲਡ ਡਾਇਰੈਕਟਰੀਆਂ ਸੁਰੱਖਿਅਤ ਰੱਖੋ]' \
            '--verbose[ਪ੍ਰਤੀ-ਸੰਦੇਸ਼ ਟ੍ਰੇਸ ਘਟਨਾਵਾਂ ਨੂੰ ਡੀਬੱਗ ਲੌਗ ਵਿੱਚ ਲੌਗ ਕਰੋ]' \
            '--report[ਸਵੈ-ਨਿਰਭਰ HTML ਰਿਪੋਰਟ ਨਤੀਜਾ ਡਾਇਰੈਕਟਰੀ ਦੀ ਬਜਾਏ ਇਸ ਮਾਰਗ ਤੇ ਲਿਖੋ]:path:_files' \
            '(--no-publish)--publish-report[ਰਿਪੋਰਟ ਨੂੰ claude.ai ਤੇ ਪ੍ਰਕਾਸ਼ਿਤ ਕਰਨਾ ਵੀ ਲਾਜ਼ਮੀ ਕਰੋ]' \
            '(--publish-report)--no-publish[HTML ਰਿਪੋਰਟ ਨੂੰ ਸਿਰਫ਼ ਸਥਾਨਕ ਰੱਖੋ; ਇਸਨੂੰ claude.ai ਤੇ ਪ੍ਰਕਾਸ਼ਿਤ ਕਰਨਾ ਛੱਡੋ]' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[ਟੈਗ ਬਣਾਉਣ ਤੋਂ ਬਾਅਦ ਇਸਨੂੰ --remote ਤੇ ਪੁਸ਼ ਕਰੋ]' \
            '--dry-run[ਬਣਾਏ ਬਿਨਾਂ ਪ੍ਰਿੰਟ ਕਰੋ ਕਿ ਕੀ ਟੈਗ ਕੀਤਾ ਜਾਵੇਗਾ]' \
            '(-f --force)'{-f,--force}'[ਅਣ-ਕਮਿਟ ਤਬਦੀਲੀਆਂ ਵਾਲੀ ਕਾਰਜਕਾਰੀ ਟ੍ਰੀ ਅਤੇ ਟੈਗ ਪਹਿਲਾਂ ਤੋਂ ਮੌਜੂਦ ਹੋਣ ਦੀਆਂ ਜਾਂਚਾਂ ਛੱਡੋ]' \
            '(-m --message)'{-m,--message}'[ਟੈਗ ਐਨੋਟੇਸ਼ਨ ਸੰਦੇਸ਼ (ਸੰਸਕਰਣ ਲਈ %s ਵਰਤੋ)]:msg:' \
            '--remote[--push ਨਾਲ ਪੁਸ਼ ਕਰਨ ਲਈ ਰਿਮੋਟ]:name:' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:URL, ਮਾਰਗ, ਜਾਂ GitHub ਰਿਪੋਜ਼ਿਟਰੀ ਤੋਂ ਇੱਕ ਮਾਰਕੀਟਪਲੇਸ ਜੋੜੋ'
    'list:ਸੰਰਚਿਤ ਮਾਰਕੀਟਪਲੇਸਾਂ ਦੀ ਸੂਚੀ ਬਣਾਓ'
    'remove:ਇੱਕ ਸੰਰਚਿਤ ਮਾਰਕੀਟਪਲੇਸ ਹਟਾਓ'
    'rm:ਇੱਕ ਸੰਰਚਿਤ ਮਾਰਕੀਟਪਲੇਸ ਹਟਾਓ (remove ਲਈ ਉਪਨਾਮ)'
    'update:ਸਰੋਤ ਤੋਂ ਮਾਰਕੀਟਪਲੇਸ ਅੱਪਡੇਟ ਕਰੋ - ਜੇਕਰ ਕੋਈ ਨਾਮ ਦਰਸਾਇਆ ਨਹੀਂ ਗਿਆ ਤਾਂ ਸਾਰੇ ਅੱਪਡੇਟ ਕਰੋ'
    'help:ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace commands' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[git sparse-checkout ਰਾਹੀਂ ਚੈੱਕਆਉਟ ਨੂੰ ਖਾਸ ਡਾਇਰੈਕਟਰੀਆਂ ਤੱਕ ਸੀਮਤ ਕਰੋ (ਮੋਨੋਰੇਪੋ ਲਈ)]:paths:' \
            '--scope[ਮਾਰਕੀਟਪਲੇਸ ਨੂੰ ਕਿੱਥੇ ਘੋਸ਼ਿਤ ਕਰਨਾ ਹੈ]:scope:(user project local)' \
            '--claudeai[ਇਸ ਨਾਮ ਦਾ ਮਾਰਕੀਟਪਲੇਸ ਜੋੜੋ ਜੋ claude.ai ਤੁਹਾਡੇ ਲਈ ਹੋਸਟ ਕਰਦਾ ਹੈ]' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[JSON ਵਜੋਂ ਆਉਟਪੁੱਟ ਕਰੋ]' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]'
          ;;
        remove|rm)
          _arguments \
            '--scope[ਇੱਕ ਖਾਸ ਸੈਟਿੰਗਜ਼ ਸਕੋਪ ਤੋਂ ਮਾਰਕੀਟਪਲੇਸ ਘੋਸ਼ਣਾ ਹਟਾਓ (ਹਰ ਸਕੋਪ ਤੋਂ ਹਟਾਉਣ ਲਈ ਛੱਡ ਦਿਓ)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[ਪਹਿਲਾਂ ਤੋਂ ਇੰਸਟਾਲ ਹੋਣ ਦੀ ਸੂਰਤ ਵਿੱਚ ਵੀ ਫੋਰਸ ਇੰਸਟਾਲ ਕਰੋ]' \
    '(-h --help)'{-h,--help}'[ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[ਭੇਜੇ ਗਏ ਸੈਸ਼ਨਾਂ ਵਿੱਚ ਟੂਲ ਐਕਸੈਸ ਦੀ ਇਜਾਜ਼ਤ ਦੇਣ ਲਈ ਵਾਧੂ ਡਾਇਰੈਕਟਰੀ]:directory:_directories' \
    '--agent[ਏਜੰਟ ਦ੍ਰਿਸ਼ ਤੋਂ ਭੇਜੇ ਗਏ ਸੈਸ਼ਨਾਂ ਲਈ ਡਿਫਾਲਟ ਏਜੰਟ]:agent:_claude_agent_names' \
    '--all[--json ਨਾਲ: ਪੂਰੇ ਹੋਏ ਬੈਕਗ੍ਰਾਊਂਡ ਸੈਸ਼ਨ ਵੀ ਸ਼ਾਮਲ ਕਰੋ]' \
    '--allow-dangerously-skip-permissions[ਭੇਜੇ ਗਏ ਸੈਸ਼ਨਾਂ ਲਈ bypass-permissions ਮੋਡ ਉਪਲਬਧ ਕਰਾਓ]' \
    '--cwd[ਸਿਰਫ਼ ਮਾਰਗ ਦੇ ਅਧੀਨ ਸ਼ੁਰੂ ਕੀਤੇ ਬੈਕਗ੍ਰਾਊਂਡ ਸੈਸ਼ਨ ਦਿਖਾਓ]:path:_directories' \
    '--dangerously-skip-permissions[--permission-mode bypassPermissions ਲਈ ਉਪਨਾਮ]' \
    '--effort[ਭੇਜੇ ਗਏ ਸੈਸ਼ਨਾਂ ਲਈ ਡਿਫਾਲਟ ਯਤਨ ਪੱਧਰ]:level:(low medium high xhigh max)' \
    '--json[ਸਰਗਰਮ ਸੈਸ਼ਨਾਂ ਨੂੰ JSON ਐਰੇ ਵਜੋਂ ਪ੍ਰਿੰਟ ਕਰੋ ਅਤੇ ਬਾਹਰ ਨਿਕਲੋ]' \
    '*--mcp-config[ਭੇਜੇ ਗਏ ਸੈਸ਼ਨਾਂ ਤੇ ਲਾਗੂ ਕਰਨ ਲਈ MCP ਸਰਵਰ ਸੰਰਚਨਾ]:config:' \
    '--model[ਏਜੰਟ ਦ੍ਰਿਸ਼ ਤੋਂ ਭੇਜੇ ਗਏ ਸੈਸ਼ਨਾਂ ਲਈ ਡਿਫਾਲਟ ਮਾਡਲ]:model:_claude_model_names' \
    '--permission-mode[ਭੇਜੇ ਗਏ ਸੈਸ਼ਨਾਂ ਲਈ ਡਿਫਾਲਟ ਇਜਾਜ਼ਤ ਮੋਡ]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[ਏਜੰਟ ਦ੍ਰਿਸ਼ ਅਤੇ ਭੇਜੇ ਗਏ ਸੈਸ਼ਨਾਂ ਲਈ ਡਾਇਰੈਕਟਰੀ ਤੋਂ ਪਲੱਗਇਨ ਲੋਡ ਕਰੋ]:path:_directories' \
    '--setting-sources[ਲੋਡ ਕਰਨ ਲਈ ਸੈਟਿੰਗ ਸਰੋਤਾਂ ਦੀ ਕੰਮਾ-ਵਿਭਾਜਿਤ ਸੂਚੀ (user, project, local)]:sources:' \
    '--settings[ਲਾਗੂ ਕਰਨ ਲਈ ਸੈਟਿੰਗਜ਼ ਫਾਈਲ ਜਾਂ JSON ਸਤਰ]:file-or-json:_files' \
    '--strict-mcp-config[ਭੇਜੇ ਗਏ ਸੈਸ਼ਨਾਂ ਵਿੱਚ ਸਿਰਫ਼ --mcp-config ਤੋਂ MCP ਸਰਵਰ ਵਰਤੋਂ ਕਰੋ]' \
    '--restricted[ਭੇਜੇ ਗਏ ਸੈਸ਼ਨਾਂ ਨੂੰ ਪਾਬੰਦੀਸ਼ੁਦਾ ਮੋਡ ਵਿੱਚ ਸ਼ੁਰੂ ਕਰੋ]' \
    '(-h --help)'{-h,--help}'[ਕਮਾਂਡ ਲਈ ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:ਆਪਣੇ Anthropic ਖਾਤੇ ਵਿੱਚ ਸਾਈਨ ਇਨ ਕਰੋ'
    'logout:ਆਪਣੇ Anthropic ਖਾਤੇ ਤੋਂ ਲੌਗ ਆਊਟ ਕਰੋ'
    'status:ਪ੍ਰਮਾਣਿਕਤਾ ਸਥਿਤੀ ਦਿਖਾਓ'
    'help:ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ਕਮਾਂਡ ਲਈ ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth commands' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[ਲੌਗਇਨ ਪੰਨੇ ਤੇ ਈਮੇਲ ਪਤਾ ਪਹਿਲਾਂ ਤੋਂ ਭਰੋ]:email:' \
            '--sso[SSO ਲੌਗਇਨ ਪ੍ਰਵਾਹ ਲਾਜ਼ਮੀ ਕਰੋ]' \
            '(--claudeai)--console[Claude ਸਬਸਕ੍ਰਿਪਸ਼ਨ ਦੀ ਬਜਾਏ Anthropic Console (API ਵਰਤੋਂ ਬਿਲਿੰਗ) ਵਰਤੋ]' \
            '(--console)--claudeai[Claude ਸਬਸਕ੍ਰਿਪਸ਼ਨ ਵਰਤੋ (ਡਿਫਾਲਟ)]' \
            '(-h --help)'{-h,--help}'[ਕਮਾਂਡ ਲਈ ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]'
          ;;
        status)
          _arguments \
            '(--text)--json[JSON ਵਜੋਂ ਆਉਟਪੁੱਟ ਕਰੋ (ਡਿਫਾਲਟ)]' \
            '(--json)--text[ਮਨੁੱਖੀ-ਪੜ੍ਹਨਯੋਗ ਟੈਕਸਟ ਵਜੋਂ ਆਉਟਪੁੱਟ ਕਰੋ]' \
            '(-h --help)'{-h,--help}'[ਕਮਾਂਡ ਲਈ ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[ਕਮਾਂਡ ਲਈ ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:ਪ੍ਰਭਾਵੀ ਆਟੋ ਮੋਡ ਸੰਰਚਨਾ ਨੂੰ JSON ਵਜੋਂ ਪ੍ਰਿੰਟ ਕਰੋ'
    'critique:ਆਪਣੇ ਕਸਟਮ ਆਟੋ ਮੋਡ ਨਿਯਮਾਂ ਤੇ AI ਫੀਡਬੈਕ ਪ੍ਰਾਪਤ ਕਰੋ'
    'defaults:ਡਿਫਾਲਟ ਆਟੋ ਮੋਡ ਨਿਯਮਾਂ ਨੂੰ JSON ਵਜੋਂ ਪ੍ਰਿੰਟ ਕਰੋ'
    'reset:ਆਟੋ ਮੋਡ ਸੰਰਚਨਾ ਨੂੰ ਭੇਜੇ ਗਏ ਡਿਫਾਲਟਾਂ ਵਿੱਚ ਰੀਸੈੱਟ ਕਰੋ'
    'help:ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ਕਮਾਂਡ ਲਈ ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode commands' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[ਕਿਹੜਾ ਮਾਡਲ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ ਇਸਨੂੰ ਓਵਰਰਾਈਡ ਕਰੋ]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[ਕਮਾਂਡ ਲਈ ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]'
          ;;
        defaults)
          _arguments \
            '--label[ਸਿਰਫ਼ ਉਹ ਨਿਯਮ ਦਿਖਾਓ ਜਿਨ੍ਹਾਂ ਦਾ ਲੇਬਲ ਇਸ ਅਗੇਤਰ ਨਾਲ ਸ਼ੁਰੂ ਹੁੰਦਾ ਹੈ (ਵੱਡੇ-ਛੋਟੇ ਅੱਖਰਾਂ ਤੋਂ ਨਿਰਪੱਖ)]:prefix:' \
            '(-h --help)'{-h,--help}'[ਕਮਾਂਡ ਲਈ ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[ਪੁਸ਼ਟੀ ਪ੍ਰੌਂਪਟ ਛੱਡੋ]' \
            '(-h --help)'{-h,--help}'[ਕਮਾਂਡ ਲਈ ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[ਕਮਾਂਡ ਲਈ ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[ਗੇਟਵੇ YAML ਸੰਰਚਨਾ ਦਾ ਮਾਰਗ]:path:_files' \
    '(-h --help)'{-h,--help}'[ਕਮਾਂਡ ਲਈ ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:ਇੱਕ ਪ੍ਰੋਜੈਕਟ ਲਈ ਸਾਰੀ Claude Code ਸਥਿਤੀ ਮਿਟਾਓ (ਟ੍ਰਾਂਸਕ੍ਰਿਪਟ, ਟਾਸਕ, ਫਾਈਲ ਇਤਿਹਾਸ, ਸੰਰਚਨਾ ਇੰਦਰਾਜ)'
    'help:ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ਕਮਾਂਡ ਲਈ ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project commands' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[ਕੁਝ ਵੀ ਮਿਟਾਏ ਬਿਨਾਂ ਸੂਚੀ ਦਿਖਾਓ ਕਿ ਕੀ ਮਿਟਾਇਆ ਜਾਵੇਗਾ]' \
            '(-y --yes)'{-y,--yes}'[ਪੁਸ਼ਟੀ ਪ੍ਰੌਂਪਟ ਛੱਡੋ]' \
            '(-i --interactive)'{-i,--interactive}'[ਮਿਟਾਉਣ ਤੋਂ ਪਹਿਲਾਂ ਹਰੇਕ ਆਈਟਮ ਲਈ ਪ੍ਰੌਂਪਟ ਕਰੋ]' \
            '(1)--all[ਹਰ ਪ੍ਰੋਜੈਕਟ ਲਈ ਸਥਿਤੀ ਸਾਫ਼ ਕਰੋ (ਮਾਰਗ ਨਾਲ ਪਰਸਪਰ ਨਿਵੇਕਲਾ)]' \
            '(-h --help)'{-h,--help}'[ਕਮਾਂਡ ਲਈ ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[ਫਾਰਮੈਟ ਕੀਤੇ ਨਤੀਜਿਆਂ ਦੀ ਬਜਾਏ ਕੱਚਾ bugs.json ਪੇਲੋਡ ਪ੍ਰਿੰਟ ਕਰੋ]' \
    '--timeout[ਸਮੀਖਿਆ ਪੂਰੀ ਹੋਣ ਦੀ ਉਡੀਕ ਲਈ ਵੱਧ ਤੋਂ ਵੱਧ ਮਿੰਟ (ਡਿਫਾਲਟ: 45)]:minutes:' \
    '(--no-post)--post[ਪੂਰੀ ਹੋਈ ਸਮੀਖਿਆ ਦੀਆਂ ਖੋਜਾਂ ਨੂੰ ਤੁਹਾਡੇ ਨਾਮ ਹੇਠ PR ਤੇ ਪੋਸਟ ਕਰੋ (ਸਿਰਫ਼ PR ਟੀਚੇ; ਇੱਕ ਸਾਦੀ ਟਿੱਪਣੀ, ਸਮੀਖਿਆ ਨਹੀਂ)]' \
    '(--post)--no-post[ਖੋਜਾਂ ਨੂੰ PR ਤੇ ਪੋਸਟ ਨਾ ਕਰੋ (ਡਿਫਾਲਟ)]' \
    '(-h --help)'{-h,--help}'[ਕਮਾਂਡ ਲਈ ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[ਹਰ ਚੱਲ ਰਹੇ ਬੈਕਗ੍ਰਾਊਂਡ ਸੈਸ਼ਨ ਨੂੰ ਮੁੜ ਸ਼ੁਰੂ ਕਰੋ]' \
    '(-h --help)'{-h,--help}'[ਕਮਾਂਡ ਲਈ ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[worktree ਦੀਆਂ ਅਣ-ਪੁਸ਼ ਕੀਤੀਆਂ ਕਮਿਟਾਂ ਅਤੇ ਅਣ-ਕਮਿਟ ਕੀਤੀਆਂ ਤਬਦੀਲੀਆਂ ਨੂੰ ਵੀ ਰੱਦ ਕਰੋ (ਪਿਛਲੇ claude rm ਦੁਆਰਾ ਰਿਪੋਰਟ ਕੀਤਾ commit@worktree-id ਦਿਓ)]:commit@worktree-id:' \
    '--force-remove-worktree[worktree ਡਾਇਰੈਕਟਰੀ ਮਿਟਾਓ ਭਾਵੇਂ WorktreeRemove ਹੁੱਕ ਜਾਂ git ਇਸਨੂੰ ਹਟਾ ਨਹੀਂ ਸਕੇ (ਪਿਛਲੇ claude rm ਦੁਆਰਾ ਰਿਪੋਰਟ ਕੀਤਾ worktree-id ਦਿਓ)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[ਕਮਾਂਡ ਲਈ ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[ਕੁਝ ਵੀ ਲਿਖੇ ਬਿਨਾਂ ਦਿਖਾਓ ਕਿ ਕੀ ਆਯਾਤ ਕੀਤਾ ਜਾਵੇਗਾ]' \
    '--yes[ਇੰਟਰਐਕਟਿਵ ਚੋਣਕਾਰ ਛੱਡੋ (ਹੈੱਡਲੈੱਸ ਸਤਹਾਂ ਤੇ, /import ਪੂਰਵਦਰਸ਼ਨ ਤੋਂ --yes=<digest> ਦਿਓ)]' \
    '(-h --help)'{-h,--help}'[ਕਮਾਂਡ ਲਈ ਮਦਦ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
