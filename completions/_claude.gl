#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Configurar e xestionar servidores MCP'
    'plugin:Xestionar complementos de Claude Code'
    'agents:Xestionar axentes en segundo plano'
    'attach:Abrir unha sesión en segundo plano neste terminal'
    'logs:Imprimir a saída recente do terminal dunha sesión en segundo plano'
    'stop:Deter unha sesión en segundo plano (consérvase a súa conversa)'
    'respawn:Reiniciar unha sesión en segundo plano para que execute a versión actual de Claude Code'
    'rm:Eliminar unha sesión en segundo plano, e a súa árbore de traballo cando sexa seguro'
    'remote-control:Controlar sesións locais desde claude.ai/code ou a app móbil de Claude'
    'daemon:Xestionar o supervisor de sesións en segundo plano'
    'auth:Xestionar autenticación'
    'auto-mode:Inspeccionar ou restablecer a configuración do clasificador do modo automático'
    'gateway:Executar a pasarela empresarial de autenticación/telemetría'
    'self-hosted-runner:Aloxar sesións na nube de Claude Code nesta máquina ou contedor'
    'import:Importar a configuración doutro axente de programación con IA a Claude Code'
    'project:Xestionar o estado do proxecto de Claude Code'
    'purge:Eliminar todo o estado de Claude Code dun proxecto (transcricións, tarefas, historial de ficheiros, entrada de configuración)'
    'ultrareview:Executar unha revisión de código multiaxente aloxada na nube e imprimir os resultados'
    'setup-token:Configurar token de autenticación a longo prazo (require subscrición Claude)'
    'doctor:Comprobación de estado para o actualizador automático de Claude Code'
    'update:Comprobar e instalar actualizacións'
    'install:Instalar compilación nativa de Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Activar modo de depuración con filtraxe opcional por categoría (ex: "api,hooks" ou "!statsig,!file")]:filter:'
    '--verbose[Substituír configuración de modo detallado do ficheiro de configuración]'
    '(-p --print)'{-p,--print}'[Imprimir resposta e saír (para uso con canles). Nota: usar só en directorios de confianza]'
    '--output-format[Formato de saída (con --print): "text" (predeterminado), "json" (resultado único), ou "stream-json" (transmisión en tempo real)]:format:(text json stream-json)'
    '--json-schema[Esquema JSON para validación de saída estruturada]:schema:'
    '--include-partial-messages[Incluír fragmentos de mensaxes parciais a medida que chegan (con --print e --output-format=stream-json)]'
    '--input-format[Formato de entrada (con --print): "text" (predeterminado) ou "stream-json" (entrada de transmisión en tempo real)]:format:(text stream-json)'
    '--dangerously-skip-permissions[Omitir todas as comprobacións de permisos. Recomendado só para sandboxes sen acceso a Internet]'
    '--allow-dangerously-skip-permissions[Activar opción para omitir comprobacións de permisos sen activala por defecto]'
    '--restricted[Modo restrinxido: retirar as ferramentas que executan comandos ou código e WebFetch, ignorar a configuración user/project/local e limitar as ferramentas de ficheiros aos directorios de traballo]'
    '--max-budget-usd[Cantidade máxima en dólares a gastar en chamadas á API (só --print)]:amount:'
    '--max-turns[Limitar o número de quendas axénticas (só --print)]:turns:'
    '--replay-user-messages[Reenviar mensaxes de usuario desde stdin a stdout para confirmación]'
    '--allowed-tools[Lista separada por comas ou espazos de nomes de ferramentas permitidas (ex: "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Lista separada por comas ou espazos de nomes de ferramentas permitidas (formato camelCase)]:tools:'
    '--tools[Especificar lista de ferramentas dispoñibles do conxunto integrado. Só modo impresión]:tools:'
    '--disallowed-tools[Lista separada por comas ou espazos de nomes de ferramentas non permitidas (ex: "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Lista separada por comas ou espazos de nomes de ferramentas non permitidas (formato camelCase)]:tools:'
    '--mcp-config[Cargar servidores MCP desde ficheiro JSON ou cadea (separados por espazos)]:configs:'
    '--system-prompt[Indicación do sistema a usar para a sesión]:prompt:'
    '--system-prompt-file[Ler a indicación do sistema desde un ficheiro]:file:_files'
    '--append-system-prompt[Engadir indicación do sistema á indicación do sistema predeterminada]:prompt:'
    '--append-system-prompt-file[Ler a indicación do sistema desde un ficheiro e engadila á indicación do sistema predeterminada]:file:_files'
    '(--append-subagent-system-prompt-file)--append-subagent-system-prompt[Engadir texto á indicación do sistema de cada subaxente (só --print)]:prompt:'
    '(--append-subagent-system-prompt)--append-subagent-system-prompt-file[Ler texto dun ficheiro e engadilo ás indicacións do sistema dos subaxentes (só --print)]:file:_files'
    '--system-prompt-snapshot[Rexistrar a indicación do sistema unha vez por conversa e reutilizala literalmente en cada solicitude e ao retomar (on, o predeterminado) ou xerala de novo en cada solicitude (off)]:mode:(on off)'
    '--permission-mode[Modo de permisos a usar para a sesión]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Quen responde ás solicitudes de permiso con --print: "host" (o host do SDK ou --permission-prompt-tool) ou "none" (denégase todo o que pediría confirmación)]:target:(host none)'
    '--permission-prompt-tool[Ferramenta MCP a usar para as solicitudes de permiso (só --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Continuar a conversa mais recente]'
    '(-r --resume)'{-r,--resume}'[Retomar unha conversa - especificar ID de sesión ou seleccionar interactivamente]:sessionId:_claude_sessions'
    '--fork-session[Crear novo ID de sesión no lugar de reutilizar o ID de sesión orixinal ao retomar (con --resume ou --continue)]'
    '--no-session-persistence[Desactivar a persistencia da sesión - as sesións non se gardarán (só --print)]'
    '--model[Modelo para a sesión actual. Especificar alias para o modelo mais recente (ex: '\''sonnet'\'' ou '\''opus'\'')]:model:_claude_model_names'
    '--agent[Axente para a sesión actual. Substitúe a configuración '\''agent'\'']:agent:_claude_agent_names'
    '--betas[Cabeceiras beta a incluír nas solicitudes á API (só usuarios con clave de API)]:betas:'
    '--fallback-model[Activar cambio automático ao modelo especificado cando o modelo predeterminado está sobrecargado (só --print)]:model:_claude_model_names'
    '--settings[Ruta a ficheiro JSON de configuración ou cadea JSON para cargar configuración adicional]:file-or-json:_files'
    '--add-dir[Directorios adicionais para permitir acceso ás ferramentas]:directories:_directories'
    '--ide[Conexión automática ao IDE no inicio se exactamente un IDE válido está dispoñible]'
    '--desktop[Abrir na aplicación Claude Desktop no lugar do terminal (con --continue ou --resume <id> para escoller a sesión)]'
    '--strict-mcp-config[Usar só servidores MCP de --mcp-config e ignorar toda a outra configuración MCP]'
    '--session-id[ID de sesión específico a usar para a conversa (debe ser UUID válido)]:uuid:'
    '--agents[Obxecto JSON que define axentes personalizados]:json:'
    '--advisor[Activar a ferramenta asesora do lado do servidor para esta sesión cun alias de modelo ou un ID de modelo completo]:model:_claude_model_names'
    '--teammate-mode[Como se mostran os compañeiros dun equipo de axentes]:mode:(in-process auto tmux iterm2)'
    '--setting-sources[Lista separada por comas de fontes de configuración a cargar (user, project, local)]:sources:'
    '--plugin-dir[Directorio para cargar complementos só para esta sesión (repetible)]:paths:_directories'
    '--disable-slash-commands[Desactivar todos os comandos de barra]'
    '(--bg --background)'{--bg,--background}'[Iniciar a sesión como axente en segundo plano e retornar inmediatamente]'
    '(-w --worktree)'{-w,--worktree}'[Crear unha nova árbore de traballo git para esta sesión (opcionalmente especificar un nome)]::name:'
    '--tmux=-[Crear unha sesión tmux para a árbore de traballo (require --worktree). Usa os paneis nativos de iTerm2 cando están dispoñibles; --tmux=classic para tmux tradicional]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Definir un nome para mostrar desta sesión]:name:'
    '--effort[Nivel de esforzo para a sesión actual]:level:(low medium high xhigh max)'
    '--autocompact[Tamaño da xanela de compactación automática (auto, ou 100k-1M tokens)]:size:(auto)'
    '--debug-file[Escribir rexistros de depuración nunha ruta de ficheiro específica (activa implicitamente o modo de depuración)]:path:_files'
    '--from-pr[Retomar unha sesión vinculada a un PR por número/URL, ou abrir o selector interactivo]::value:'
    '--teleport[Retomar unha sesión de teleport, opcionalmente especificar o ID de sesión]::session:'
    '(--remote)--cloud[Crear unha sesión na nube coa descrición indicada, ou conectarse a unha existente polo ID de sesión ou a URL de claude.ai/code]::description-or-session:'
    '(--cloud)--remote[Alias obsoleto de --cloud]::description-or-session:'
    '--environment[Crear unha nova sesión na nube que se executa no contorno autoaloxado indicado (ccpool_...)]:environment_id:'
    '--ref[Con --environment: basear o checkout da nova sesión nunha ref con nome no lugar do HEAD local]:branch:'
    '(--remote-control --rc)'{--remote-control,--rc}'[Iniciar unha sesión interactiva co Control Remoto activado (opcionalmente con nome)]::name:'
    '--remote-control-session-name-prefix[Prefixo para os nomes de sesión de Control Remoto xerados automaticamente]:prefix:'
    '--chrome[Activar a integración de Claude en Chrome]'
    '--no-chrome[Desactivar a integración de Claude en Chrome]'
    '--plugin-url[Obter un .zip de complemento desde unha URL só para esta sesión (repetible)]:url:'
    '--file[Recursos de ficheiro a descargar no inicio (formato: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Activar suxestións de indicación (emite unha indicación seguinte prevista en modo impresión/SDK)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Reenviar o texto do subaxente e os bloques de pensamento como mensaxes (con --print e stream-json)]'
    '--include-hook-events[Incluír todos os eventos do ciclo de vida dos hooks no fluxo de saída (con stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Mover as seccións por máquina á primeira mensaxe de usuario para mellorar a reutilización da caché de indicacións]'
    '--brief[Activar a ferramenta SendUserMessage para a comunicación de axente a usuario]'
    '*--channels[(Vista previa de investigación) Servidores MCP cuxas notificacións de canle escoitar (plugin\:<name>@<marketplace>)]:entries:'
    '*--dangerously-load-development-channels[Activar canles que non están na lista de permitidos aprobada, para desenvolvemento local (plugin\:<name>@<marketplace> ou server\:<name>)]:entries:'
    '--init[Executar os hooks Setup co matcher init antes da sesión (só --print)]'
    '--init-only[Executar os hooks Setup e SessionStart e despois saír sen iniciar unha conversa]'
    '--maintenance[Executar os hooks Setup co matcher maintenance antes da sesión (só --print)]'
    '--safe-mode[Iniciar con todas as personalizacións desactivadas (útil para resolver unha configuración danada)]'
    '--bare[Modo mínimo: omitir hooks, LSP, sincronización de complementos, atribución, memoria automática e descubrimento automático de CLAUDE.md]'
    '--ax-screen-reader[Mostrar unha saída compatible con lectores de pantalla (texto plano, sen bordos decorativos nin animacións)]'
    '(-v --version)'{-v,--version}'[Mostrar número de versión]'
    '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]'
  )

  # Stop at the first non-option word, so that the options after a command reach
  # that command's own specs instead of being consumed here
  _arguments -C -A '-*' \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandos claude' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin|plugins)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        remote-control|rc|remote|sync|bridge)
          _claude_remote_control
          ;;
        daemon)
          _claude_daemon
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        self-hosted-runner)
          _claude_self_hosted_runner
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        purge)
          _claude_purge
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update|upgrade)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]'
          ;;
        *)
          # Not a command but the prompt: options may still follow it
          _arguments \
            $main_options \
            '*: :'
          ;;
      esac
      ;;
  esac
  local ret=$?

  # The last step, such as listing commands for --r, can fail although options
  # were added before it. Report success then: on failure zsh moves on to the
  # next completers, and _correct or _approximate pile on corrections
  (( compstate[nmatches] > 0 )) || return $ret
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Iniciar un servidor MCP de Claude Code'
    'add:Engadir un servidor MCP a Claude Code'
    'remove:Eliminar un servidor MCP'
    'list:Listar servidores MCP configurados'
    'get:Obter detalles do servidor MCP'
    'add-json:Engadir un servidor MCP (stdio ou SSE) con cadea JSON'
    'add-from-claude-desktop:Importar servidores MCP desde Claude Desktop (só Mac e WSL)'
    'reset-project-choices:Restablecer todos os servidores de ámbito de proxecto (.mcp.json) aprobados/rexeitados neste proxecto'
    'login:Autenticarse cun servidor MCP (HTTP, SSE, ou conector de claude.ai)'
    'logout:Borrar as credenciais OAuth almacenadas dun servidor MCP'
    'help:Mostrar axuda'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostrar axuda]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandos mcp' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Activar modo de depuración]' \
            '--verbose[Substituír configuración de modo detallado do ficheiro de configuración]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ámbito de configuración (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Tipo de transporte (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Definir variable de contorno (ex: -e CHAVE=valor)]:env:' \
            '(-H --header)'{-H,--header}'[Definir cabeceira WebSocket]:header:' \
            '--client-id[ID de cliente OAuth para servidores HTTP/SSE]:clientId:' \
            '--client-secret[Pedir o segredo de cliente OAuth (ou definir a variable de contorno MCP_CLIENT_SECRET)]' \
            '--callback-port[Porto fixo para a devolución de chamada OAuth (para servidores que requiren URI de redirección rexistrados previamente)]:port:' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ámbito de configuración (local, user, project) - eliminar do ámbito existente se non se especifica]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrar axuda]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ámbito de configuración (local, user, project)]:scope:(local user project)' \
            '--client-secret[Pedir o segredo de cliente OAuth (ou definir a variable de contorno MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ámbito de configuración (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrar axuda]'
          ;;
        login)
          _arguments \
            '--no-browser[Imprimir a URL de autorización no lugar de abrir un navegador (para sesións SSH/sen interface gráfica)]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Validar un complemento ou manifesto de mercado'
    'marketplace:Xestionar mercados de Claude Code'
    'list:Listar complementos instalados'
    'details:Mostrar o inventario de compoñentes e o custo de tokens previsto dun complemento'
    'configure:Mostrar as opcións dun complemento e cales non están definidas, ou gardar valores desde stdin'
    'install:Instalar un complemento dos mercados dispoñibles'
    'i:Instalar un complemento dos mercados dispoñibles (forma curta de install)'
    'init:Xerar a estrutura dun novo complemento (cárgase automaticamente na seguinte sesión)'
    'new:Xerar a estrutura dun novo complemento (alias para init)'
    'uninstall:Desinstalar un complemento instalado'
    'remove:Desinstalar un complemento instalado (alias para uninstall)'
    'enable:Activar un complemento desactivado'
    'disable:Desactivar un complemento activado'
    'update:Actualizar un complemento á versión mais recente'
    'eval:Executar casos de avaliación contra un complemento e informar dos resultados puntuados'
    'prune:Eliminar dependencias instaladas automaticamente que xa non se necesitan'
    'autoremove:Eliminar dependencias instaladas automaticamente que xa non se necesitan (alias para prune)'
    'tag:Crear unha etiqueta git {name}--v{version} para unha publicación de complemento'
    'test:Executar as probas dun mod'
    'help:Mostrar axuda'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostrar axuda]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandos de complemento' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Tratar os avisos como erros (código de saída 1)]' \
            '--profile[Saír tamén con exit 1 cando o catálogo indicado rexeitaría un envío do complemento nunha comprobación que executa este comando]:name:(directory)' \
            '--json[Mostrar o informe de validación como JSON (mesmos códigos de saída)]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ámbito de instalación]:scope:(user project local)' \
            '--accept-command[Aceptar o comando declarado polo mercado cuxo sha256 informou unha execución --json anterior como shownCommand.sha256]:sha256:' \
            '*--config[Definir unha opción userConfig declarada no manifesto do complemento (repetible)]:key=value:' \
            '--marketplace[Instalar o complemento polo seu nome simple desde o mercado desta orixe (owner/repo, URL git ou https, ou ruta), engadíndoo primeiro se fai falta]:source:' \
            '--registry[Para unha instalación package@npm: resolver e descargar desde este rexistro npm]:url:' \
            '(-y --yes)'{-y,--yes}'[Aceptar o comando mostrado declarado polo mercado sen a solicitude de confirmación]' \
            '--json[Imprimir unha liña de resultado lexible por máquina no lugar da mensaxe para persoas]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ámbito de instalación]:scope:(user project local)' \
            '--keep-data[Conservar o directorio de datos persistentes do complemento]' \
            '--prune[Eliminar tamén as dependencias instaladas automaticamente que xa non se necesitan]' \
            '(-y --yes)'{-y,--yes}'[Omitir a solicitude de confirmación de --prune]' \
            '--json[Imprimir unha liña de resultado lexible por máquina no lugar da mensaxe para persoas (non con --prune)]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ámbito de instalación]:scope:(user project local)' \
            '--json[Imprimir unha liña de resultado lexible por máquina no lugar da mensaxe para persoas]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Desactivar todos os complementos activados]' \
            '(-s --scope)'{-s,--scope}'[Ámbito de instalación]:scope:(user project local)' \
            '--json[Imprimir unha liña de resultado lexible por máquina no lugar da mensaxe para persoas]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '--accept-command[Aceptar o comando declarado polo mercado cuxo sha256 informou unha execución --json anterior como shownCommand.sha256]:sha256:' \
            '(-s --scope)'{-s,--scope}'[Ámbito de instalación]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Aceptar o comando mostrado declarado polo mercado sen a solicitude de confirmación]' \
            '--json[Imprimir unha liña de resultado lexible por máquina no lugar da mensaxe para persoas]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Saída como JSON]' \
            '--available[Incluír os complementos dispoñibles dos mercados (require --json)]' \
            '--data-size[Medir o directorio de datos gardados de cada complemento instalado, ou só do complemento indicado (require --json)]::plugin:_claude_installed_plugins' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Depurar no ámbito]:scope:(user project local)' \
            '--dry-run[Listar o que se eliminaría sen eliminar nada]' \
            '(-y --yes)'{-y,--yes}'[Omitir a solicitude de confirmación]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]'
          ;;
        configure)
          _arguments \
            '--json[Saída como JSON]' \
            '--values-stdin[Ler os valores das opcións desde stdin como un obxecto JSON de cadeas dunha soa liña; as opcións omitidas conservan os seus valores]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Descrición do manifesto]:text:' \
            '--author[Nome do autor (predeterminado: git config user.name)]:name:' \
            '--author-email[Correo electrónico do autor (predeterminado: git config user.email)]:email:' \
            '--with[Compoñentes dos que xerar tamén a estrutura]:components:' \
            '(-f --force)'{-f,--force}'[Sobrescribir un .claude-plugin/ existente no destino]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '1:name:'
          ;;
        eval)
          if [[ $words[2] == init ]]; then
            _arguments \
              '--bare[Escribir un modelo en branco no lugar de realizar a entrevista]' \
              '--eval-dir[Directorio debaixo do directorio actual no que escribir os casos]:dir:_directories' \
              '(-i --interactive)'{-i,--interactive}'[Realizar a entrevista de autoría (require un terminal interactivo)]' \
              '(-h --help)'{-h,--help}'[Mostrar axuda]' \
              '::name:'
            return
          fi
          _arguments \
            '--case[Filtrar os casos por patrón glob de nome]:glob:' \
            '*--tag[Filtrar os casos por etiqueta (repetible)]:tag:' \
            '--runs[Substituír o número de execucións por caso (predeterminado: case.runs, se non 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Realizar ata n execucións de axente á vez (1-8; predeterminado 1)]:n:' \
            '--model[Substituír o modelo para todos os casos]:model:_claude_model_names' \
            '--judge-model[Substituír o modelo do avaliador LLM (predeterminado: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Límite estrito de custo; se se alcanza, abortar e informar dos resultados parciais (código de saída 2)]:usd:' \
            '--output-dir[Directorio para aggregate-result.json]:dir:_directories' \
            '--eval-dir[Nome do directorio (dentro do complemento) que contén os casos de avaliación]:dir:' \
            '--json[Imprimir o resultado completo da execución como JSON en stdout, ou escribilo neste ficheiro .json]::path:_files' \
            '--threshold[Saír co código de saída 1 se a puntuación dalgún caso está por debaixo deste limiar (predeterminado: 1.0)]:threshold:' \
            '*--allow-tools[Autorización do operador para ferramentas restrinxidas (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '*--disallow-tools[Ferramentas integradas que se lle negan a Claude en todos os casos, aínda que estean concedidas]:tools:' \
            '(--no-scaffold)--scaffold[Executar o scaffold_script de cada caso (executa bash proporcionado polo autor no teu nome; desactivado por defecto)]' \
            '(--scaffold)--no-scaffold[Omitir explicitamente scaffold_script]' \
            '--trust-plugin[Declarar que confías neste complemento e no seu conxunto de avaliación, omitindo a solicitude de confianza da primeira execución (para CI)]' \
            '--ablation[Executar un grupo de referencia sen complemento e informar da diferenza de puntuación]:mode:(none with-without)' \
            '--mocks[Substitutos simulados para servidores MCP, desde <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Con --mocks record: iniciar tamén os procesos reais dos servidores MCP que non teñen simulación]' \
            '--keep-temp[Conservar os directorios de estrutura para depuración]' \
            '--verbose[Rexistrar eventos de rastrexo por mensaxe no rexistro de depuración]' \
            '--report[Escribir o informe HTML autónomo nesta ruta no lugar do directorio de resultados]:path:_files' \
            '(--no-publish)--publish-report[Requirir tamén a publicación do informe en claude.ai]' \
            '(--publish-report)--no-publish[Manter o informe HTML só en local; omitir a súa publicación en claude.ai]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '::target: _alternative "commands\:eval command\:(init)" "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Enviar a etiqueta a --remote despois de creala]' \
            '--dry-run[Imprimir o que se etiquetaría sen crear a etiqueta]' \
            '(-f --force)'{-f,--force}'[Omitir as comprobacións de árbore de traballo con cambios e de etiqueta xa existente]' \
            '(-m --message)'{-m,--message}'[Mensaxe de anotación da etiqueta (usar %s para a versión)]:msg:' \
            '--remote[Remoto ao que enviar con --push]:name:' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Engadir un mercado desde unha URL, ruta ou repositorio GitHub'
    'list:Listar mercados configurados'
    'remove:Eliminar un mercado configurado'
    'rm:Eliminar un mercado configurado (alias para remove)'
    'update:Actualizar mercado desde a fonte - actualizar todos se non se especifica ningún nome'
    'help:Mostrar axuda'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostrar axuda]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandos de mercado' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Limitar o checkout a directorios específicos mediante git sparse-checkout (para monorepos)]:paths:' \
            '--scope[Onde declarar o mercado]:scope:(user project local)' \
            '--json[Imprimir unha liña de resultado lexible por máquina como última liña en stdout]' \
            '--claudeai[Engadir o mercado con este nome que claude.ai aloxa para ti]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Saída como JSON]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Eliminar a declaración do mercado dun ámbito de configuración específico (omitir para eliminala de todos os ámbitos)]:scope:(user project local)' \
            '--json[Imprimir unha liña de resultado lexible por máquina como última liña en stdout]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '--json[Cun nome de mercado: imprimir unha liña de resultado lexible por máquina como última liña en stdout]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Forzar instalación aínda que xa estea instalado]' \
    '(-h --help)'{-h,--help}'[Mostrar axuda]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Directorio adicional para permitir acceso ás ferramentas nas sesións despachadas]:directory:_directories' \
    '--agent[Axente predeterminado para as sesións despachadas desde a vista de axentes]:agent:_claude_agent_names' \
    '--all[Con --json: incluír tamén as sesións en segundo plano completadas]' \
    '--allow-dangerously-skip-permissions[Facer dispoñible o modo de omisión de permisos para as sesións despachadas]' \
    '--cwd[Mostrar só as sesións en segundo plano iniciadas baixo a ruta]:path:_directories' \
    '--dangerously-skip-permissions[Alias para --permission-mode bypassPermissions]' \
    '--effort[Nivel de esforzo predeterminado para as sesións despachadas]:level:(low medium high xhigh max)' \
    '--json[Imprimir as sesións activas como un array JSON e saír]' \
    '*--mcp-config[Configuración do servidor MCP a aplicar ás sesións despachadas]:config:' \
    '--model[Modelo predeterminado para as sesións despachadas desde a vista de axentes]:model:_claude_model_names' \
    '--permission-mode[Modo de permisos predeterminado para as sesións despachadas]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Cargar complementos desde o directorio para a vista de axentes e as sesións despachadas]:path:_directories' \
    '--setting-sources[Lista separada por comas de fontes de configuración a cargar (user, project, local)]:sources:' \
    '--settings[Ficheiro de configuración ou cadea JSON a aplicar]:file-or-json:_files' \
    '--strict-mcp-config[Usar só os servidores MCP de --mcp-config nas sesións despachadas]' \
    '--restricted[Iniciar as sesións despachadas en modo restrinxido]' \
    '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Iniciar sesión na túa conta de Anthropic'
    'logout:Pechar sesión da túa conta de Anthropic'
    'status:Mostrar o estado da autenticación'
    'help:Mostrar axuda'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandos auth' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Encher previamente o enderezo de correo electrónico na páxina de inicio de sesión]:email:' \
            '--sso[Forzar o fluxo de inicio de sesión SSO]' \
            '(--claudeai)--console[Usar Anthropic Console (facturación por uso da API) no lugar da subscrición Claude]' \
            '(--console)--claudeai[Usar a subscrición Claude (predeterminado)]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]'
          ;;
        status)
          _arguments \
            '(--text)--json[Saída como JSON (predeterminado)]' \
            '(--json)--text[Saída como texto lexible por persoas]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Imprimir a configuración efectiva do modo automático como JSON'
    'critique:Obter comentarios da IA sobre as túas regras personalizadas do modo automático'
    'defaults:Imprimir as regras predeterminadas do modo automático como JSON'
    'reset:Restablecer a configuración do modo automático aos valores predeterminados de fábrica'
    'help:Mostrar axuda'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandos auto-mode' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Substituír o modelo que se usa]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]'
          ;;
        defaults)
          _arguments \
            '--label[Mostrar só as regras cuxa etiqueta comeza por este prefixo (sen distinguir maiúsculas e minúsculas)]:prefix:' \
            '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Omitir a solicitude de confirmación]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Ruta ao ficheiro de configuración YAML da pasarela]:path:_files' \
    '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Eliminar todo o estado de Claude Code dun proxecto (transcricións, tarefas, historial de ficheiros, entrada de configuración)'
    'help:Mostrar axuda'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandos project' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Listar o que se eliminaría sen eliminar nada]' \
            '(-y --yes)'{-y,--yes}'[Omitir a solicitude de confirmación]' \
            '(-i --interactive)'{-i,--interactive}'[Pedir confirmación para cada elemento antes de eliminalo]' \
            '(1)--all[Eliminar o estado de todos os proxectos (mutuamente exclusivo cunha ruta)]' \
            '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_purge() {
  _arguments \
    '--dry-run[Listar o que se eliminaría sen eliminar nada]' \
    '(-y --yes)'{-y,--yes}'[Omitir a solicitude de confirmación]' \
    '(-i --interactive)'{-i,--interactive}'[Pedir confirmación para cada elemento antes de eliminalo]' \
    '(1)--all[Eliminar o estado de todos os proxectos (mutuamente exclusivo cunha ruta)]' \
    '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]' \
    '(--all)::path:_directories'
}

_claude_ultrareview() {
  _arguments \
    '--json[Imprimir a carga bruta bugs.json no lugar dos resultados formatados]' \
    '--timeout[Minutos máximos a esperar a que remate a revisión (predeterminado: 45)]:minutes:' \
    '(--no-post)--post[Publicar os achados da revisión rematada no PR no teu nome (só para destinos PR; un comentario simple, non unha revisión)]' \
    '(--post)--no-post[Non publicar os achados no PR (o predeterminado)]' \
    '--trust-workspace[Confiar no cartafol actual só para esta execución, sen preguntar (para scripts e CI)]' \
    '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Reiniciar todas as sesións en segundo plano en execución]' \
    '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Descartar tamén os commits sen enviar e os cambios sen confirmar da árbore de traballo (pasar o commit@worktree-id que informou un claude rm anterior)]:commit@worktree-id:' \
    '--force-remove-worktree[Eliminar o directorio da árbore de traballo aínda que o hook WorktreeRemove ou git non puidesen eliminalo (pasar o worktree-id que informou un claude rm anterior)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]' \
    '1:session:_claude_background_sessions'
}

_claude_self_hosted_runner() {
  _arguments \
    '--api-url[URL base da API (predeterminado: https://api.anthropic.com)]:url:' \
    '--environment-secret-file[Ruta ao ficheiro de segredos do contorno]:path:_files' \
    '--lock-to-account[Vincular o runner a unha soa conta no rexistro]:id:' \
    '--client-label[Etiqueta de observabilidade enviada no rexistro (predeterminado: hostname)]:label:' \
    '(--proxy-authorization-file --agent-proxy-url)--proxy-authorization-command[Comando cuxa stdout é a cabeceira Proxy-Authorization para proxies de saída]:shell command:' \
    '(--proxy-authorization-command --agent-proxy-url)--proxy-authorization-file[Ficheiro que contén a cabeceira Proxy-Authorization para proxies de saída]:path:_files' \
    '(--proxy-authorization-command --proxy-authorization-file)--agent-proxy-url[Encamiñar cada sesión a través do proxy de axente neste URL (só https)]:url:' \
    '--capacity[Máximo de sesións simultáneas (predeterminado: 1)]:n:' \
    '--base-dir[Directorio base para os checkouts de repositorios (predeterminado: /workspace)]:path:_directories' \
    '--exec-path[Binario que lanzar para as sesións fillas (predeterminado: este binario)]:path:_files' \
    '--hooks-dir[Directorio de scripts de hooks do ciclo de vida (checkout, command, post-session)]:path:_directories' \
    '--session-stop-grace-sec[Canto esperar por unha saída limpa despois de rematar unha sesión (predeterminado: 5)]:n:' \
    '--post-session-hook-timeout-sec[Orzamento de SIGTERM para o hook post-session (predeterminado: 60)]:n:' \
    '--checkout-hook-timeout-min[Orzamento de tempo real para cada execución do hook checkout (predeterminado: 30; 0 desactiva)]:n:' \
    '--drain-wait-sec[Ante SIGTERM/SIGINT, esperar ata N segundos polo traballo en curso (predeterminado: 0)]:n:' \
    '--drain-marker-file[Ficheiro marcador co que o host anuncia un baleirado ordenado]:path:_files' \
    '*--git-ssh-rewrite[Reescribir URL de orixe https://<host>/... como git@<host>:... (repetible)]:host:' \
    '*--git-host-rewrite[Reescribir URL de orixe https://<f>/... como https://<t>/... (repetible)]:from=to:' \
    '--use-anthropic-git-proxy[Usar git xestionado por Anthropic. AVISO: elimina e substitúe a configuración de git a nivel de HOME; usar só nunha conta dedicada]' \
    '--configure-git[Definir a identidade global de git e activar a sinatura de commits a través do servizo de sinatura de Anthropic. Escribe ~/.gitconfig]' \
    '--push-outcome-on-release[Enviar as ramas de resultado seguidas cando o runner remata unha sesión sen completar]' \
    '--trust-workspace[Sementar confianza persistente para as rutas de repositorio de cada sesión (predeterminado: true)]::bool:(true false)' \
    '--remove-session-state[Eliminar o estado de cada sesión cando remata unha sesión (predeterminado: false)]::bool:(true false)' \
    '--diff-finds-nested-repository[Mostrar no panel Changes un repositorio clonado nun subcartafol; require --capacity 1 (predeterminado: false)]::bool:(true false)' \
    '--confine-repo-settings[Modo da garda que restrinxe a configuración confirmada no repositorio (predeterminado: warn)]:mode:(warn enforce off)' \
    '--server-auto-mode-lists[Que listas do clasificador do modo automático pode recibir unha sesión desde o servidor (predeterminado: no-allow)]:mode:(all no-allow none)' \
    '--host-config-snapshot[Onde se garda a instantánea de inicio da configuración do host (predeterminado: disk)]:mode:(disk memory)' \
    '--health-port[Porto para o escoitador HTTP /healthz (predeterminado: 8080; 0 desactiva)]:port:' \
    '--log-level[Nivel de rexistro (predeterminado: info)]:level:(info debug)' \
    '--log-file[Copiar tamén os rexistros do runner a un ficheiro en modo de anexado]:path:_files' \
    '--exit-if-unused-min[Saír do runner se nunca se lle asigna traballo durante N minutos]:n:' \
    '--drain-grace-sec[Segundos durante os que seguir consultando se hai traballo despois de rematar as sesións activas (predeterminado: 0)]:n:' \
    '--retire-at[Retirar o runner neste instante Unix absoluto, en segundos]:epoch-seconds:' \
    '--defer-shutdown-max-min[Ao primeiro SIGTERM/SIGINT, deixar de aceptar traballo e completar o apagado M minutos despois (predeterminado: 0)]:m:' \
    '--release-idle-session-min[Liberar unha praza de sesión tras N minutos sen entrada do usuario]:n:' \
    '--startup-timeout-min[Liberar unha praza de sesión se o proceso fillo non rematou de iniciarse tras N minutos (predeterminado: 15; 0 desactiva)]:n:' \
    '--kill-session-after-min[Limitar a duración en tempo real dun proceso fillo de sesión a N minutos]:n:' \
    '--debug-token-dir[SÓ PARA DEPURACIÓN: escribe tokens activos no disco. Non usar en produción]:path:_directories' \
    '(-h --help)'{-h,--help}'[Mostrar esta mensaxe de axuda]'
}

_claude_remote_control() {
  _arguments \
    '--name[Nome da sesión (amosado en claude.ai/code)]:name:' \
    '--remote-control-session-name-prefix[Prefixo para os nomes de sesión xerados automaticamente (predeterminado: hostname)]:prefix:' \
    '(-c --continue --session-id)'{-c,--continue}'[Volver conectar á última sesión rexistrada para este directorio ou unha das súas árbores de traballo de git]' \
    '(-c --continue --session-id)--session-id[Volver conectar a unha sesión específica polo ID]:id:' \
    '--permission-mode[Modo de permisos para as sesións lanzadas]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)' \
    '(--no-chrome)--chrome[Activar Claude in Chrome para as sesións lanzadas]' \
    '(--chrome)--no-chrome[Desactivar Claude in Chrome para as sesións lanzadas]' \
    '(-d --debug)'{-d,--debug}'[Activar modo de depuración con filtraxe opcional por categoría]::filter:' \
    '--debug-file[Escribir os rexistros de depuración nun ficheiro]:path:_files' \
    '(-v --verbose)'{-v,--verbose}'[Activar saída detallada]' \
    '--spawn[Modo de lanzamento (predeterminado: same-dir)]:mode:(same-dir worktree session)' \
    '--capacity[Máximo de sesións simultáneas no modo worktree ou same-dir (predeterminado: 32)]:n:' \
    '(--no-create-session-in-dir)--create-session-in-dir[Crear previamente unha sesión no directorio actual (predeterminado)]' \
    '(--create-session-in-dir)--no-create-session-in-dir[Non crear previamente unha sesión no directorio actual]' \
    '(-h --help)'{-h,--help}'[Mostrar esta axuda]'
}

_claude_daemon() {
  local -a daemon_commands common_options
  daemon_commands=(
    'run:Executar o supervisor en primeiro plano'
    'status:Mostrar o pid, a versión e o tempo activo do daemon'
    'logs:Seguir o rexistro do daemon (Ctrl-C para parar)'
    'uninstall:Eliminar o servizo en segundo plano (launchctl/systemd)'
    'stop:Apagar o supervisor e terminar as sesións en segundo plano'
  )
  common_options=(
    '--json-path[Ficheiro de configuración (predeterminado: ~/.claude/daemon.json)]:path:_files'
    '--log-file[Ficheiro de rexistro (predeterminado: ~/.claude/daemon.log)]:path:_files'
    '(-h --help)'{-h,--help}'[Mostrar esta axuda]'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    $common_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandos daemon' daemon_commands
      ;;
    args)
      case $words[1] in
        run)
          _arguments \
            $common_options \
            '::json-path:_files'
          ;;
        stop)
          _arguments \
            $common_options \
            '--any[Parar tamén un daemon transitorio (non servizo)]' \
            '--keep-workers[Deixar en execución as sesións desacopladas]'
          ;;
        status|logs|uninstall)
          _arguments \
            $common_options
          ;;
      esac
      ;;
  esac
}

_claude_import() {
  _arguments \
    '--dry-run[Mostrar o que se importaría sen escribir nada]' \
    '--yes[Omitir o selector interactivo (en contornos sen interface gráfica, pasar --yes=<digest> da vista previa de /import)]' \
    '(-h --help)'{-h,--help}'[Mostrar axuda para o comando]' \
    '::source:(codex gemini cursor)'
}

# compinit autoloads this file, and that first call only defines the functions
# above: complete right away so the first TAB already works. Sourced directly,
# there is nothing to complete yet, only the registration.
if [[ $funcstack[1] == _claude ]]; then
  _claude "$@"
else
  (( $+_comps[claude] )) || compdef _claude claude
fi
