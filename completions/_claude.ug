#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:MCP مۇلازىمېتىرلىرىنى سەپلەش ۋە باشقۇرۇش'
    'plugin:Claude Code قىستۇرمىلىرىنى باشقۇرۇش'
    'agents:ئارقا سۇپا ۋاكالەتچىلىرىنى باشقۇرۇش'
    'attach:ئارقا سۇپا يىغىنىنى بۇ تېرمىنالدا ئېچىش'
    'logs:ئارقا سۇپا يىغىنىنىڭ يېقىنقى تېرمىنال چىقىرىشىنى بېسىپ چىقىرىش'
    'stop:ئارقا سۇپا يىغىنىنى توختىتىش (سۆھبىتى ساقلىنىدۇ)'
    'respawn:ئارقا سۇپا يىغىنىنى ھازىرقى Claude Code نۇسخىسىدا ئىجرا بولۇشى ئۈچۈن قايتا قوزغىتىش'
    'rm:ئارقا سۇپا يىغىنىنى ئۆچۈرۈش، بىخەتەر بولغاندا ئۇنىڭ worktree سىنىمۇ ئۆچۈرۈش'
    'remote-control:يەرلىك يىغىنلارنى claude.ai/code ياكى Claude يانفون ئەپىدىن كونترول قىلىش'
    'daemon:ئارقا سۇپا يىغىنلىرىنىڭ نازارەتچىسىنى باشقۇرۇش'
    'auth:دەلىللەشنى باشقۇرۇش'
    'auto-mode:ئاپتوماتىك ھالەت تۈرگە ئايرىغۇچ سەپلىمىسىنى تەكشۈرۈش ياكى ئەسلىگە قايتۇرۇش'
    'gateway:كارخانا دەلىللەش/تېلېمېترىيە ئۆتكىلىنى ئىجرا قىلىش'
    'self-hosted-runner:Claude Code بۇلۇت يىغىنلىرىنى بۇ ماشىنا ياكى قاچىدا ساھىبخانلىق قىلىش'
    'import:باشقا AI كودلاش ۋاكالەتچىسىدىن سەپلىمىنى Claude Code غا ئەكىرىش'
    'project:Claude Code تۈر ھالىتىنى باشقۇرۇش'
    'purge:تۈر ئۈچۈن بارلىق Claude Code ھالىتىنى ئۆچۈرۈش (سۆزلەشمىلەر، ۋەزىپىلەر، ھۆججەت تارىخى، سەپلىمە تۈرى)'
    'ultrareview:بۇلۇتتا جايلاشقان كۆپ ۋاكالەتچىلىك كود تەكشۈرۈشىنى ئىجرا قىلىش ۋە بايقاشلارنى بېسىپ چىقىرىش'
    'setup-token:ئۇزۇن مۇددەتلىك دەلىللەش بەلگىسىنى تەڭشەش (Claude تەلەپنامىسى زۆرۈر)'
    'doctor:Claude Code ئاپتوماتىك يېڭىلانمىسى ئۈچۈن ساغلاملىق تەكشۈرۈش'
    'update:يېڭىلانمىلارنى تەكشۈرۈش ۋە ئورنىتىش'
    'install:Claude Code يەرلىك قۇرۇلمىسىنى ئورنىتىش'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[تۈر سۈزگۈچى بىلەن سازلاش ھالىتىنى قوزغىتىش (مەسىلەن، "api,hooks" ياكى "!statsig,!file")]:filter:'
    '--verbose[سەپلىمە ھۆججىتىدىكى تەپسىلىي ھالەت تەڭشىكىنى بىكار قىلىش]'
    '(-p --print)'{-p,--print}'[جاۋابنى بېسىپ چىقىرىش ۋە چېكىنىش (تۇرۇبا بىلەن ئىشلىتىش ئۈچۈن). ئەسكەرتىش: پەقەت ئىشەنچلىك مۇندەرىجىلەردە ئىشلىتىڭ]'
    '--output-format[چىقىرىش فورماتى (--print بىلەن): "text" (سۈكۈتتىكى), "json" (يەككە نەتىجە), ياكى "stream-json" (ھەقىقىي ۋاقىت ئېقىمى)]:format:(text json stream-json)'
    '--json-schema[قۇرۇلمىلىق چىقىرىشنى دەلىللەش ئۈچۈن JSON لايىھىسى]:schema:'
    '--include-partial-messages[كەلگەندە قىسمەن ئۇچۇر پارچىلىرىنى قوشۇش (--print ۋە --output-format=stream-json بىلەن)]'
    '--input-format[كىرگۈزۈش فورماتى (--print بىلەن): "text" (سۈكۈتتىكى) ياكى "stream-json" (ھەقىقىي ۋاقىت ئېقىمى كىرگۈزۈشى)]:format:(text stream-json)'
    '--dangerously-skip-permissions[بارلىق ئىجازەت تەكشۈرۈشلىرىنى ئاتلاش. پەقەت تورغا كىرىش ھوقۇقى يوق ساندۇق مۇھىتى ئۈچۈن تەۋسىيە قىلىنىدۇ]'
    '--allow-dangerously-skip-permissions[سۈكۈتتە قوزغاتماي ئىجازەت تەكشۈرۈشنى ئاتلاش تاللانمىسىنى قوزغىتىش]'
    '--restricted[چەكلىك ھالەت: بۇيرۇق ياكى كود ئىجرا قىلىدىغان قوراللار ۋە WebFetch نى چىقىرىۋېتىش، user/project/local تەڭشەكلىرىنى پەرۋا قىلماسلىق، ھۆججەت قوراللىرىنى خىزمەت مۇندەرىجىلىرى بىلەن چەكلەش]'
    '--max-budget-usd[API چاقىرىقلىرىغا سەرپ قىلىدىغان ئەڭ يۇقىرى دوللار مىقدارى (پەقەت --print)]:amount:'
    '--max-turns[ۋاكالەتچى نۆۋەتلىرىنىڭ سانىنى چەكلەش (پەقەت --print)]:turns:'
    '--replay-user-messages[تەستىقلاش ئۈچۈن stdin دىن stdout غا ئىشلەتكۈچى ئۇچۇرلىرىنى قايتا يوللاش]'
    '--allowed-tools[پەش ياكى بوشلۇق بىلەن ئايرىلغان ئىجازەت بېرىلگەن قورال ئىسىملىرىنىڭ تىزىملىكى (مەسىلەن، "Bash(git:*) Edit")]:tools:'
    '--allowedTools[پەش ياكى بوشلۇق بىلەن ئايرىلغان ئىجازەت بېرىلگەن قورال ئىسىملىرىنىڭ تىزىملىكى (camelCase فورماتى)]:tools:'
    '--tools[ئىچكى يىغىندىدىن بار قوراللار تىزىملىكىنى بەلگىلەش. پەقەت بېسىپ چىقىرىش ھالىتى]:tools:'
    '--disallowed-tools[پەش ياكى بوشلۇق بىلەن ئايرىلغان چەكلەنگەن قورال ئىسىملىرىنىڭ تىزىملىكى (مەسىلەن، "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[پەش ياكى بوشلۇق بىلەن ئايرىلغان چەكلەنگەن قورال ئىسىملىرىنىڭ تىزىملىكى (camelCase فورماتى)]:tools:'
    '--mcp-config[JSON ھۆججىتى ياكى تىزمىدىن MCP مۇلازىمېتىرلىرىنى يۈكلەش (بوشلۇق بىلەن ئايرىلغان)]:configs:'
    '--system-prompt[يىغىن ئۈچۈن سىستېما چاقىرىقى]:prompt:'
    '--system-prompt-file[سىستېما چاقىرىقىنى ھۆججەتتىن ئوقۇش]:file:_files'
    '--append-system-prompt[سۈكۈتتىكى سىستېما چاقىرىقىغا سىستېما چاقىرىقىنى قوشۇش]:prompt:'
    '--append-system-prompt-file[سىستېما چاقىرىقىنى ھۆججەتتىن ئوقۇپ سۈكۈتتىكى سىستېما چاقىرىقىغا قوشۇش]:file:_files'
    '(--append-subagent-system-prompt-file)--append-subagent-system-prompt[ھەر بىر تارماق ۋاكالەتچىنىڭ سىستېما چاقىرىقىغا تېكىست قوشۇش (پەقەت --print)]:prompt:'
    '(--append-subagent-system-prompt)--append-subagent-system-prompt-file[ھۆججەتتىن تېكىست ئوقۇپ تارماق ۋاكالەتچى سىستېما چاقىرىقلىرىغا قوشۇش (پەقەت --print)]:file:_files'
    '--system-prompt-snapshot[سىستېما چاقىرىقىنى ھەر سۆھبەتتە بىر قېتىم خاتىرىلەپ، ھەر بىر ئىلتىماس ۋە داۋاملاشتۇرۇشتا ئەينەن قايتا ئىشلىتىش (on، سۈكۈتتىكى) ياكى ھەر بىر ئىلتىماستا يېڭىدىن ھاسىل قىلىش (off)]:mode:(on off)'
    '--permission-mode[يىغىن ئۈچۈن ئىجازەت ھالىتى]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[--print بىلەن ئىجازەت سوراشلىرىغا كىم جاۋاب بېرىدۇ: "host" (SDK ساھىبخانىسى ياكى --permission-prompt-tool) ياكى "none" (سوراش كېرەك بولغان ھەممە نەرسە رەت قىلىنىدۇ)]:target:(host none)'
    '--permission-prompt-tool[ئىجازەت سوراشلىرى ئۈچۈن ئىشلىتىدىغان MCP قورالى (پەقەت --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[ئەڭ يېڭى سۆھبەتنى داۋاملاشتۇرۇش]'
    '(-r --resume)'{-r,--resume}'[سۆھبەتنى داۋاملاشتۇرۇش - يىغىن كىملىكىنى بەلگىلەڭ ياكى ئۆز-ئارا تاللاڭ]:sessionId:_claude_sessions'
    '--fork-session[داۋاملاشتۇرغاندا ئەسلى يىغىن كىملىكىنى قايتا ئىشلىتىشنىڭ ئورنىغا يېڭى يىغىن كىملىكى ياساش (--resume ياكى --continue بىلەن)]'
    '--no-session-persistence[يىغىن ساقلاشنى چەكلەش - يىغىنلار ساقلانمايدۇ (پەقەت --print)]'
    '--model[ھازىرقى يىغىن ئۈچۈن مودېل. ئەڭ يېڭى مودېل ئۈچۈن لەقەب بەلگىلەڭ (مەسىلەن، '\''sonnet'\'' ياكى '\''opus'\'')]:model:_claude_model_names'
    '--agent[ھازىرقى يىغىن ئۈچۈن ۋاكالەتچى. '\''agent'\'' تەڭشىكىنى بىكار قىلىدۇ]:agent:_claude_agent_names'
    '--betas[API ئىلتىماسلىرىغا قوشۇلىدىغان Beta باشلىرى (پەقەت API ئاچقۇچ ئىشلەتكۈچىلىرى)]:betas:'
    '--fallback-model[سۈكۈتتىكى مودېل ئارتۇق يۈكلەنگەندە بەلگىلەنگەن مودېلغا ئاپتوماتىك قايتىشنى قوزغىتىش (پەقەت --print)]:model:_claude_model_names'
    '--settings[قوشۇمچە تەڭشەكلەرنى يۈكلەش ئۈچۈن تەڭشەك JSON ھۆججىتى ياكى JSON تىزما يولى]:file-or-json:_files'
    '--add-dir[قورال كىرىشىگە ئىجازەت بېرىش ئۈچۈن قوشۇمچە مۇندەرىجىلەر]:directories:_directories'
    '--ide[قوزغىتىلغاندا ئەنە بىر ئىناۋەتلىك IDE بار بولسا، ئاپتوماتىك IDE غا ئۇلىنىش]'
    '--desktop[تېرمىنالنىڭ ئورنىغا Claude Desktop ئەپىدە ئېچىش (يىغىننى تاللاش ئۈچۈن --continue ياكى --resume <id> بىلەن)]'
    '--strict-mcp-config[پەقەت --mcp-config دىن MCP مۇلازىمېتىرلىرىنى ئىشلىتىش ۋە باشقا بارلىق MCP تەڭشەكلىرىنى پەرۋا قىلماسلىق]'
    '--session-id[سۆھبەت ئۈچۈن مەخسۇس يىغىن كىملىكى (ئىناۋەتلىك UUID بولۇشى كېرەك)]:uuid:'
    '--agents[خاسلاشتۇرۇلغان ۋاكالەتچىلەرنى بەلگىلەيدىغان JSON ئوبيېكتى]:json:'
    '--advisor[بۇ يىغىن ئۈچۈن مۇلازىمېتىر تەرەپتىكى advisor قورالىنى مودېل تەخەللۇسى ياكى تولۇق مودېل ID بىلەن قوزغىتىش]:model:_claude_model_names'
    '--teammate-mode[agent team ئەزالىرىنىڭ كۆرسىتىلىش ئۇسۇلى]:mode:(in-process auto tmux iterm2)'
    '--setting-sources[يۈكلەش ئۈچۈن پەش بىلەن ئايرىلغان تەڭشەك مەنبەلىرىنىڭ تىزىملىكى (user, project, local)]:sources:'
    '--plugin-dir[پەقەت بۇ يىغىن ئۈچۈن قىستۇرمىلارنى يۈكلەش ئۈچۈن مۇندەرىجە (تەكرارلىنىشچان)]:paths:_directories'
    '--disable-slash-commands[بارلىق يانتۇ سىزىق بۇيرۇقلىرىنى چەكلەش]'
    '(--bg --background)'{--bg,--background}'[يىغىننى ئارقا سۇپا ۋاكالەتچىسى سۈپىتىدە قوزغىتىش ۋە دەرھال قايتىش]'
    '(-w --worktree)'{-w,--worktree}'[بۇ يىغىن ئۈچۈن يېڭى git worktree قۇرۇش (ئىختىيارىي ھالدا ئىسىم بەلگىلەڭ)]::name:'
    '--tmux=-[worktree ئۈچۈن tmux يىغىنى قۇرۇش (--worktree زۆرۈر). بار بولسا iTerm2 نىڭ ئەسلى كۆزنەكچىلىرىنى ئىشلىتىدۇ؛ ئەنئەنىۋى tmux ئۈچۈن --tmux=classic]::mode:(classic)'
    '(-n --name)'{-n,--name}'[بۇ يىغىن ئۈچۈن كۆرسىتىش ئىسمى بەلگىلەش]:name:'
    '--effort[ھازىرقى يىغىن ئۈچۈن كۈچ سەرپ قىلىش دەرىجىسى]:level:(low medium high xhigh max)'
    '--autocompact[ئاپتوماتىك ئىخچاملاش كۆزنەك چوڭلۇقى (auto ياكى 100k-1M توكېن)]:size:(auto)'
    '--debug-file[سازلاش خاتىرىلىرىنى مەلۇم ھۆججەت يولىغا يېزىش (سازلاش ھالىتىنى ئۆز-ئۆزىدىن قوزغىتىدۇ)]:path:_files'
    '--from-pr[نومۇر/URL بويىچە PR غا باغلانغان يىغىننى داۋاملاشتۇرۇش، ياكى ئۆز-ئارا تاللىغۇچنى ئېچىش]::value:'
    '--teleport[teleport يىغىنىنى داۋاملاشتۇرۇش، ئىختىيارىي ھالدا يىغىن كىملىكىنى بەلگىلەڭ]::session:'
    '(--remote)--cloud[بېرىلگەن چۈشەندۈرۈش بىلەن بۇلۇت يىغىنى قۇرۇش، ياكى يىغىن كىملىكى ياكى claude.ai/code URL ئارقىلىق مەۋجۇت يىغىنغا ئۇلىنىش]::description-or-session:'
    '(--cloud)--remote[--cloud نىڭ ئەمەلدىن قالغان تەخەللۇسى]::description-or-session:'
    '--environment[بېرىلگەن ئۆزى جايلاشتۇرغان مۇھىتتا ئىجرا بولىدىغان يېڭى بۇلۇت يىغىنى قۇرۇش (ccpool_...)]:environment_id:'
    '--ref[--environment بىلەن: يېڭى يىغىننىڭ checkout نى يەرلىك HEAD نىڭ ئورنىغا ئىسىملىك ref ئاساسىدا قۇرۇش]:branch:'
    '(--remote-control --rc)'{--remote-control,--rc}'[يىراقتىن كونترول قوزغىتىلغان ئۆز-ئارا يىغىننى باشلاش (ئىختىيارىي ھالدا ئىسىم بەلگىلەش)]::name:'
    '--remote-control-session-name-prefix[ئاپتوماتىك ھاسىل قىلىنغان يىراقتىن كونترول يىغىن ئىسىملىرى ئۈچۈن ئالدى قوشۇلغۇچى]:prefix:'
    '--chrome[Chrome دىكى Claude بىرلەشتۈرۈشىنى قوزغىتىش]'
    '--no-chrome[Chrome دىكى Claude بىرلەشتۈرۈشىنى چەكلەش]'
    '--plugin-url[پەقەت بۇ يىغىن ئۈچۈن URL دىن قىستۇرما .zip نى ئېلىش (تەكرارلىنىشچان)]:url:'
    '--file[قوزغىتىلغاندا چۈشۈرۈلىدىغان ھۆججەت مەنبەلىرى (فورمات: file_id:relative_path)]:specs:'
    '--prompt-suggestions[چاقىرىق تەۋسىيەلىرىنى قوزغىتىش (بېسىپ چىقىرىش/SDK ھالىتىدە مۆلچەرلەنگەن كېيىنكى چاقىرىقنى چىقىرىدۇ)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[تارماق ۋاكالەتچى تېكىستى ۋە ئويلىنىش بۆلەكلىرىنى ئۇچۇر سۈپىتىدە يۆتكەش (--print ۋە stream-json بىلەن)]'
    '--include-hook-events[بارلىق ھۇك ھايات دەۋرى ھادىسىلىرىنى چىقىرىش ئېقىمىغا قوشۇش (stream-json بىلەن)]'
    '--exclude-dynamic-system-prompt-sections[ھەر ماشىنىلىق بۆلەكلەرنى تۇنجى ئىشلەتكۈچى ئۇچۇرىغا يۆتكەپ چاقىرىق غەملەك قايتا ئىشلىتىشنى ياخشىلاش]'
    '--brief[ۋاكالەتچى-ئىشلەتكۈچى ئالاقىسى ئۈچۈن SendUserMessage قورالىنى قوزغىتىش]'
    '*--channels[(تەتقىقات ئالدىن كۆرۈش) قانال ئۇقتۇرۇشلىرى ئاڭلىنىدىغان MCP مۇلازىمېتىرلىرى (plugin\:<name>@<marketplace>)]:entries:'
    '*--dangerously-load-development-channels[تەستىقلانغان رۇخسەت تىزىملىكىدە يوق قاناللارنى يەرلىك ئېچىش ئۈچۈن قوزغىتىش (plugin\:<name>@<marketplace> ياكى server\:<name>)]:entries:'
    '--init[يىغىندىن بۇرۇن Setup ھۇكلىرىنى init matcher بىلەن ئىجرا قىلىش (پەقەت --print)]'
    '--init-only[Setup ۋە SessionStart ھۇكلىرىنى ئىجرا قىلىپ، سۆھبەت باشلىماي چېكىنىش]'
    '--maintenance[يىغىندىن بۇرۇن Setup ھۇكلىرىنى maintenance matcher بىلەن ئىجرا قىلىش (پەقەت --print)]'
    '--safe-mode[بارلىق خاسلاشتۇرۇشلار چەكلەنگەن ھالدا باشلاش (بۇزۇلغان سەپلىمىنى تەكشۈرۈشتە پايدىلىق)]'
    '--bare[ئەڭ ئاز ھالەت: ھۇكلار، LSP، قىستۇرما ماسلاشتۇرۇش، مەنسۇپلۇق، ئاپتو-ئەسلەك ۋە CLAUDE.md ئاپتوماتىك بايقاشنى ئاتلاش]'
    '--ax-screen-reader[ئېكران ئوقۇغۇچقا دوستانە چىقىرىش (تەكشى تېكىست، زىننەتلىك گىرۋەك ياكى ھەرىكەت يوق)]'
    '(-v --version)'{-v,--version}'[نۇسخا نومۇرىنى چىقىرىش]'
    '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]'
  )

  # Stop at the first non-option word, so that the options after a command reach
  # that command's own specs instead of being consumed here
  _arguments -C -A '-*' \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude commands' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin|plugins)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        remote-control|rc|remote|sync|bridge)
          _claude_remote_control
          ;;
        daemon)
          _claude_daemon
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        self-hosted-runner)
          _claude_self_hosted_runner
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        purge)
          _claude_purge
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update|upgrade)
          _arguments \
            '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]'
          ;;
        *)
          # Not a command but the prompt: options may still follow it
          _arguments \
            $main_options \
            '*: :'
          ;;
      esac
      ;;
  esac
  local ret=$?

  # The last step, such as listing commands for --r, can fail although options
  # were added before it. Report success then: on failure zsh moves on to the
  # next completers, and _correct or _approximate pile on corrections
  (( compstate[nmatches] > 0 )) || return $ret
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Claude Code MCP مۇلازىمېتىرىنى قوزغىتىش'
    'add:Claude Code غا MCP مۇلازىمېتىرى قوشۇش'
    'remove:MCP مۇلازىمېتىرىنى ئۆچۈرۈش'
    'list:سەپلەنگەن MCP مۇلازىمېتىرلىرىنىڭ تىزىملىكى'
    'get:MCP مۇلازىمېتىر تەپسىلاتلىرىنى ئېلىش'
    'add-json:JSON تىزمىسى بىلەن MCP مۇلازىمېتىرى قوشۇش (stdio ياكى SSE)'
    'add-from-claude-desktop:Claude Desktop دىن MCP مۇلازىمېتىرلىرىنى ئەكىرىش (پەقەت Mac ۋە WSL)'
    'reset-project-choices:بۇ تۈردىكى بارلىق تەستىقلانغان/رەت قىلىنغان تۈر دائىرىسىدىكى (.mcp.json) مۇلازىمېتىرلارنى ئەسلىگە قايتۇرۇش'
    'login:MCP مۇلازىمېتىرى بىلەن دەلىللىنىش (HTTP، SSE، ياكى claude.ai ئۇلىغۇچ)'
    'logout:MCP مۇلازىمېتىرى ئۈچۈن ساقلانغان OAuth دەلىلنامىلىرىنى تازىلاش'
    'help:ياردەم كۆرسىتىش'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp commands' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[سازلاش ھالىتىنى قوزغىتىش]' \
            '--verbose[سەپلىمە ھۆججىتىدىكى تەپسىلىي ھالەت تەڭشىكىنى بىكار قىلىش]' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[سەپلىمە دائىرىسى (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[يوللاش تىپى (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[مۇھىت ئۆزگەرگۈچىسىنى بەلگىلەش (مەسىلەن، -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[WebSocket بېشىنى بەلگىلەش]:header:' \
            '--client-id[HTTP/SSE مۇلازىمېتىرلىرى ئۈچۈن OAuth خېرىدار كىملىكى]:clientId:' \
            '--client-secret[OAuth خېرىدار مەخپىي ئاچقۇچىنى سوراش (ياكى MCP_CLIENT_SECRET مۇھىت ئۆزگەرگۈچىسىنى بەلگىلەڭ)]' \
            '--callback-port[OAuth قايتما چاقىرىقى ئۈچۈن مۇقىم ئېغىز (ئالدىن تىزىملىتىلغان قايتا يۆنىلىش URI لىرىنى تەلەپ قىلىدىغان مۇلازىمېتىرلار ئۈچۈن)]:port:' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[سەپلىمە دائىرىسى (local, user, project) - بەلگىلەنمىسە مەۋجۇت دائىرىدىن ئۆچۈرۈش]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[سەپلىمە دائىرىسى (local, user, project)]:scope:(local user project)' \
            '--client-secret[OAuth خېرىدار مەخپىي ئاچقۇچىنى سوراش (ياكى MCP_CLIENT_SECRET مۇھىت ئۆزگەرگۈچىسىنى بەلگىلەڭ)]' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[سەپلىمە دائىرىسى (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]'
          ;;
        login)
          _arguments \
            '--no-browser[توركۆرگۈچ ئېچىشنىڭ ئورنىغا ھوقۇق بېرىش URL نى بېسىپ چىقىرىش (SSH/ئېكرانسىز يىغىنلار ئۈچۈن)]' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:قىستۇرما ياكى بازار خاتىرىسىنى دەلىللەش'
    'marketplace:Claude Code بازارلىرىنى باشقۇرۇش'
    'list:ئورنىتىلغان قىستۇرمىلارنىڭ تىزىملىكى'
    'details:قىستۇرمىنىڭ بۆلەك تىزىملىكى ۋە مۆلچەرلەنگەن توكېن خامىتىنى كۆرسىتىش'
    'configure:قىستۇرمىنىڭ تاللانمىلىرىنى ۋە قايسىلىرىنىڭ بەلگىلەنمىگەنلىكىنى كۆرسىتىش، ياكى stdin دىن قىممەتلەرنى ساقلاش'
    'install:بار بازارلاردىن قىستۇرما ئورنىتىش'
    'i:بار بازارلاردىن قىستۇرما ئورنىتىش (install نىڭ قىسقارتىلمىسى)'
    'init:يېڭى قىستۇرما قۇرۇش (كېيىنكى يىغىندا ئاپتوماتىك يۈكلىنىدۇ)'
    'new:يېڭى قىستۇرما ئاساسىنى قۇرۇش (init نىڭ لەقىمى)'
    'uninstall:ئورنىتىلغان قىستۇرمىنى ئۆچۈرۈش'
    'remove:ئورنىتىلغان قىستۇرمىنى ئۆچۈرۈش (uninstall نىڭ لەقىمى)'
    'enable:تاقالغان قىستۇرمىنى قوزغىتىش'
    'disable:قوزغىتىلغان قىستۇرمىنى تاقاش'
    'update:قىستۇرمىنى ئەڭ يېڭى نۇسخىغا يېڭىلاش'
    'eval:قىستۇرمىغا قارىتا باھالاش ئەھۋاللىرىنى ئىجرا قىلىش ۋە نومۇرلانغان نەتىجىلەرنى مەلۇم قىلىش'
    'prune:ئېھتىياج قالمىغان ئاپتوماتىك ئورنىتىلغان بېقىنمىلارنى ئۆچۈرۈش'
    'autoremove:ئېھتىياج قالمىغان ئاپتوماتىك ئورنىتىلغان بېقىنمىلارنى ئۆچۈرۈش (prune نىڭ لەقىمى)'
    'tag:قىستۇرما تارقىتىش ئۈچۈن {name}--v{version} git بەلگىسى قۇرۇش'
    'test:mod نىڭ سىناقلىرىنى ئىجرا قىلىش'
    'help:ياردەم كۆرسىتىش'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin commands' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[ئاگاھلاندۇرۇشلارنى خاتالىق دەپ قاراش (چېكىنىش كودى 1)]' \
            '--profile[بەلگىلەنگەن كاتالوگ بۇ بۇيرۇق ئىجرا قىلىدىغان تەكشۈرۈشتە قىستۇرمىنىڭ يوللىنىشىنى رەت قىلىدىغان بولسا، چېكىنىش كودى 1 بىلەنمۇ چېكىنىش]:name:(directory)' \
            '--json[دەلىللەش دوكلاتىنى JSON سۈپىتىدە چىقىرىش (چېكىنىش كودلىرى ئوخشاش)]' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ئورنىتىش دائىرىسى]:scope:(user project local)' \
            '--accept-command[ئالدىنقى --json ئىجراسى shownCommand.sha256 دەپ مەلۇم قىلغان sha256 غا ئىگە، بازار ئېلان قىلغان بۇيرۇقنى قوبۇل قىلىش]:sha256:' \
            '*--config[قىستۇرما خاتىرىسىدە ئېلان قىلىنغان userConfig تاللانمىسىنى بەلگىلەش (تەكرارلىنىشچان)]:key=value:' \
            '--marketplace[قىستۇرمىنى ساپ ئىسمى بويىچە بۇ مەنبەدىكى بازاردىن ئورنىتىش (owner/repo، git ياكى https URL، ياكى يول)، زۆرۈر بولسا ئالدى بىلەن بازارنى قوشۇپ]:source:' \
            '--registry[package@npm ئورنىتىش ئۈچۈن: بۇ npm registry دىن ئېنىقلاش ۋە چۈشۈرۈش]:url:' \
            '(-y --yes)'{-y,--yes}'[بازار ئېلان قىلغان كۆرسىتىلگەن بۇيرۇقنى جەزملەشتۈرۈش سوئالىسىز قوبۇل قىلىش]' \
            '--json[ئادەم ئۈچۈن ئۇچۇرنىڭ ئورنىغا ماشىنا ئوقۇيالايدىغان بىر قۇر نەتىجىنى بېسىپ چىقىرىش]' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ئورنىتىش دائىرىسى]:scope:(user project local)' \
            '--keep-data[قىستۇرمىنىڭ مەڭگۈلۈك سانلىق مەلۇمات مۇندەرىجىسىنى ساقلاپ قېلىش]' \
            '--prune[ئېھتىياج قالمىغان ئاپتوماتىك ئورنىتىلغان بېقىنمىلارنىمۇ ئۆچۈرۈش]' \
            '(-y --yes)'{-y,--yes}'[--prune جەزملەشتۈرۈش سوئالىنى ئاتلاش]' \
            '--json[ئادەم ئۈچۈن ئۇچۇرنىڭ ئورنىغا ماشىنا ئوقۇيالايدىغان بىر قۇر نەتىجىنى بېسىپ چىقىرىش (--prune بىلەن ئەمەس)]' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ئورنىتىش دائىرىسى]:scope:(user project local)' \
            '--json[ئادەم ئۈچۈن ئۇچۇرنىڭ ئورنىغا ماشىنا ئوقۇيالايدىغان بىر قۇر نەتىجىنى بېسىپ چىقىرىش]' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[قوزغىتىلغان بارلىق قىستۇرمىلارنى تاقاش]' \
            '(-s --scope)'{-s,--scope}'[ئورنىتىش دائىرىسى]:scope:(user project local)' \
            '--json[ئادەم ئۈچۈن ئۇچۇرنىڭ ئورنىغا ماشىنا ئوقۇيالايدىغان بىر قۇر نەتىجىنى بېسىپ چىقىرىش]' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '--accept-command[ئالدىنقى --json ئىجراسى shownCommand.sha256 دەپ مەلۇم قىلغان sha256 غا ئىگە، بازار ئېلان قىلغان بۇيرۇقنى قوبۇل قىلىش]:sha256:' \
            '(-s --scope)'{-s,--scope}'[ئورنىتىش دائىرىسى]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[بازار ئېلان قىلغان كۆرسىتىلگەن بۇيرۇقنى جەزملەشتۈرۈش سوئالىسىز قوبۇل قىلىش]' \
            '--json[ئادەم ئۈچۈن ئۇچۇرنىڭ ئورنىغا ماشىنا ئوقۇيالايدىغان بىر قۇر نەتىجىنى بېسىپ چىقىرىش]' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[JSON سۈپىتىدە چىقىرىش]' \
            '--available[بازارلاردىكى بار قىستۇرمىلارنىمۇ ئۆز ئىچىگە ئېلىش (--json زۆرۈر)]' \
            '--data-size[ھەر بىر ئورنىتىلغان قىستۇرمىنىڭ ساقلانغان سانلىق مەلۇمات مۇندەرىجىسىنى، ياكى پەقەت بەلگىلەنگەن قىستۇرمىنىڭكىنى ئۆلچەش (--json زۆرۈر)]::plugin:_claude_installed_plugins' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[مۇشۇ دائىرىدە تازىلاش]:scope:(user project local)' \
            '--dry-run[ئۆچۈرمەي تۇرۇپ ئۆچۈرۈلىدىغانلارنىڭ تىزىملىكىنى كۆرسىتىش]' \
            '(-y --yes)'{-y,--yes}'[جەزملەشتۈرۈش سوئالىنى ئاتلاش]' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]'
          ;;
        configure)
          _arguments \
            '--json[JSON سۈپىتىدە چىقىرىش]' \
            '--values-stdin[تاللانما قىممەتلىرىنى stdin دىن يەككە قۇرلۇق تىزمىلاردىن تەركىب تاپقان JSON ئوبيېكتى سۈپىتىدە ئوقۇش؛ كۆرسىتىلمىگەن تاللانمىلار ئۆز قىممىتىنى ساقلايدۇ]' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[خاتىرە چۈشەندۈرۈشى]:text:' \
            '--author[ئاپتور ئىسمى (سۈكۈتتىكى: git config user.name)]:name:' \
            '--author-email[ئاپتور ئېلخېتى (سۈكۈتتىكى: git config user.email)]:email:' \
            '--with[بىللە ئاساسى قۇرۇلىدىغان بۆلەكلەر]:components:' \
            '(-f --force)'{-f,--force}'[نىشاندىكى مەۋجۇت .claude-plugin/ نى قاپلاش]' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '1:name:'
          ;;
        eval)
          if [[ $words[2] == init ]]; then
            _arguments \
              '--bare[سۆھبەتلىشىش ئورنىغا بوش قېلىپ يېزىش]' \
              '--eval-dir[ئەھۋاللار يېزىلىدىغان، نۆۋەتتىكى مۇندەرىجە ئاستىدىكى مۇندەرىجە]:dir:_directories' \
              '(-i --interactive)'{-i,--interactive}'[ئەھۋال يېزىش سۆھبىتىنى ئىجرا قىلىش (ئۆز-ئارا تېرمىنال زۆرۈر)]' \
              '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
              '::name:'
            return
          fi
          _arguments \
            '--case[ئەھۋاللارنى ئىسىم glob ئەندىزىسى بويىچە سۈزۈش]:glob:' \
            '*--tag[ئەھۋاللارنى بەلگە بويىچە سۈزۈش (تەكرارلىنىشچان)]:tag:' \
            '--runs[ھەر ئەھۋالنىڭ ئىجرا قېتىم سانىنى قاپلاش (سۈكۈتتىكى: case.runs، بولمىسا 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[بىر ۋاقىتتا ئەڭ كۆپ n ۋاكالەتچى ئىجراسىنى يۈرگۈزۈش (1-8؛ سۈكۈتتىكى 1)]:n:' \
            '--model[بارلىق ئەھۋاللار ئۈچۈن مودېلنى قاپلاش]:model:_claude_model_names' \
            '--judge-model[LLM باھالىغۇچ مودېلىنى قاپلاش (سۈكۈتتىكى: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[قاتتىق چىقىم چېكى؛ يەتسە توختىتىپ قىسمەن نەتىجىلەرنى مەلۇم قىلىش (چېكىنىش كودى 2)]:usd:' \
            '--output-dir[aggregate-result.json ئۈچۈن مۇندەرىجە]:dir:_directories' \
            '--eval-dir[باھالاش ئەھۋاللىرى ساقلىنىدىغان مۇندەرىجە ئىسمى (قىستۇرما ئاستىدا)]:dir:' \
            '--json[تولۇق ئىجرا نەتىجىسىنى JSON سۈپىتىدە stdout غا بېسىپ چىقىرىش ياكى بۇ .json ھۆججىتىگە يېزىش]::path:_files' \
            '--threshold[ھەرقانداق ئەھۋالنىڭ نومۇرى بۇ چەكتىن تۆۋەن بولسا چېكىنىش كودى 1 بىلەن چېكىنىش (سۈكۈتتىكى: 1.0)]:threshold:' \
            '*--allow-tools[چەكلەنگەن قوراللار ئۈچۈن مەشغۇلاتچى ئىجازىتى (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '*--disallow-tools[ئىجازەت بېرىلگەن بولسىمۇ، ھەرقانداق ئەھۋالدا Claude غا بېرىلمەيدىغان ئىچكى قوراللار]:tools:' \
            '(--no-scaffold)--scaffold[ھەر ئەھۋالنىڭ scaffold_script نى ئىجرا قىلىش (ئاپتور تەمىنلىگەن bash نى سىزنىڭ نامىڭىزدا ئىجرا قىلىدۇ؛ سۈكۈتتە تاقاق)]' \
            '(--scaffold)--no-scaffold[scaffold_script نى ئېنىق ئاتلاش]' \
            '--trust-plugin[بۇ قىستۇرما ۋە ئۇنىڭ باھالاش توپلىمىغا ئىشىنىدىغانلىقىڭىزنى جەزملەپ، تۇنجى ئىجرادىكى ئىشەنچ سوئالىنى ئاتلاش (CI ئۈچۈن)]' \
            '--ablation[قىستۇرمىسىز سېلىشتۇرما گۇرۇپپىسىنى ئىجرا قىلىپ نومۇر پەرقىنى مەلۇم قىلىش]:mode:(none with-without)' \
            '--mocks[MCP مۇلازىمېتىرلىرىنىڭ ئورنىدىكى تەقلىدىي ئورۇنباسارلار، <eval dir>/mocks/ دىن]:mode:(record off)' \
            '--allow-real-servers[--mocks record بىلەن: تەقلىدىي نۇسخىسى يوق ھەقىقىي MCP مۇلازىمېتىر جەريانلىرىنىمۇ قوزغىتىش]' \
            '--keep-temp[سازلاش ئۈچۈن ئاساس مۇندەرىجىلىرىنى ساقلاپ قېلىش]' \
            '--verbose[ھەر ئۇچۇرنىڭ ئىز قوغلاش ھادىسىلىرىنى سازلاش خاتىرىسىگە يېزىش]' \
            '--report[ئۆزى تولۇق HTML دوكلاتىنى نەتىجە مۇندەرىجىسىنىڭ ئورنىغا بۇ يولغا يېزىش]:path:_files' \
            '(--no-publish)--publish-report[دوكلاتنى claude.ai غا ئېلان قىلىشنىمۇ تەلەپ قىلىش]' \
            '(--publish-report)--no-publish[HTML دوكلاتىنى پەقەت يەرلىكتە ساقلاش؛ claude.ai غا ئېلان قىلىشنى ئاتلاش]' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '::target: _alternative "commands\:eval command\:(init)" "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[بەلگىنى قۇرغاندىن كېيىن --remote غا ئىتتىرىش]' \
            '--dry-run[بەلگە قۇرماي تۇرۇپ بەلگە قويۇلىدىغاننى بېسىپ چىقىرىش]' \
            '(-f --force)'{-f,--force}'[خىزمەت دەرىخىنىڭ پاكىز ئەمەسلىكى ۋە بەلگىنىڭ ئاللىبۇرۇن مەۋجۇتلۇقى تەكشۈرۈشلىرىنى ئاتلاش]' \
            '(-m --message)'{-m,--message}'[بەلگە ئىزاھات ئۇچۇرى (نۇسخا ئۈچۈن %s نى ئىشلىتىڭ)]:msg:' \
            '--remote[--push بىلەن ئىتتىرىدىغان يىراقتىكى ئامبار]:name:' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:URL، يول ياكى GitHub ئامبىرىدىن بازار قوشۇش'
    'list:سەپلەنگەن بازارلارنىڭ تىزىملىكى'
    'remove:سەپلەنگەن بازارنى ئۆچۈرۈش'
    'rm:سەپلەنگەن بازارنى ئۆچۈرۈش (remove نىڭ لەقىمى)'
    'update:مەنبەدىن بازارنى يېڭىلاش - ئىسمى بەلگىلەنمىسە ھەممىنى يېڭىلاش'
    'help:ياردەم كۆرسىتىش'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace commands' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[git sparse-checkout ئارقىلىق checkout نى مەلۇم مۇندەرىجىلەر بىلەن چەكلەش (monorepo لار ئۈچۈن)]:paths:' \
            '--scope[بازارنى قەيەردە ئېلان قىلىش]:scope:(user project local)' \
            '--json[stdout تىكى ئاخىرقى قۇر سۈپىتىدە ماشىنا ئوقۇيالايدىغان بىر قۇر نەتىجىنى بېسىپ چىقىرىش]' \
            '--claudeai[claude.ai سىز ئۈچۈن جايلاشتۇرغان بۇ ئىسىمدىكى بازارنى قوشۇش]' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[JSON سۈپىتىدە چىقىرىش]' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]'
          ;;
        remove|rm)
          _arguments \
            '--scope[بازار ئېلانىنى مەلۇم تەڭشەك دائىرىسىدىن ئۆچۈرۈش (بەلگىلەنمىسە بارلىق دائىرىلەردىن ئۆچۈرۈلىدۇ)]:scope:(user project local)' \
            '--json[stdout تىكى ئاخىرقى قۇر سۈپىتىدە ماشىنا ئوقۇيالايدىغان بىر قۇر نەتىجىنى بېسىپ چىقىرىش]' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '--json[بازار ئىسمى بىلەن: stdout تىكى ئاخىرقى قۇر سۈپىتىدە ماشىنا ئوقۇيالايدىغان بىر قۇر نەتىجىنى بېسىپ چىقىرىش]' \
            '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[ئاللىبۇرۇن ئورنىتىلغان بولسىمۇ مەجبۇرىي ئورنىتىش]' \
    '(-h --help)'{-h,--help}'[ياردەم كۆرسىتىش]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[ئەۋەتىلگەن يىغىنلاردا قورال كىرىشىگە ئىجازەت بېرىدىغان قوشۇمچە مۇندەرىجە]:directory:_directories' \
    '--agent[ۋاكالەتچى كۆرۈنۈشىدىن ئەۋەتىلگەن يىغىنلار ئۈچۈن سۈكۈتتىكى ۋاكالەتچى]:agent:_claude_agent_names' \
    '--all[--json بىلەن: تاماملانغان ئارقا سۇپا يىغىنلىرىنىمۇ ئۆز ئىچىگە ئالىدۇ]' \
    '--allow-dangerously-skip-permissions[ئىجازەت ئاتلاش ھالىتىنى ئەۋەتىلگەن يىغىنلارغا ئىشلىتىشچان قىلىش]' \
    '--cwd[پەقەت يول ئاستىدا باشلانغان ئارقا سۇپا يىغىنلىرىنى كۆرسىتىش]:path:_directories' \
    '--dangerously-skip-permissions[--permission-mode bypassPermissions نىڭ لەقىمى]' \
    '--effort[ئەۋەتىلگەن يىغىنلار ئۈچۈن سۈكۈتتىكى كۈچ سەرپ قىلىش دەرىجىسى]:level:(low medium high xhigh max)' \
    '--json[ئاكتىپ يىغىنلارنى JSON قاتارى سۈپىتىدە بېسىپ چىقىرىش ۋە چېكىنىش]' \
    '*--mcp-config[ئەۋەتىلگەن يىغىنلارغا قوللىنىدىغان MCP مۇلازىمېتىر سەپلىمىسى]:config:' \
    '--model[ۋاكالەتچى كۆرۈنۈشىدىن ئەۋەتىلگەن يىغىنلار ئۈچۈن سۈكۈتتىكى مودېل]:model:_claude_model_names' \
    '--permission-mode[ئەۋەتىلگەن يىغىنلار ئۈچۈن سۈكۈتتىكى ئىجازەت ھالىتى]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[ۋاكالەتچى كۆرۈنۈشى ۋە ئەۋەتىلگەن يىغىنلار ئۈچۈن مۇندەرىجىدىن قىستۇرمىلارنى يۈكلەش]:path:_directories' \
    '--setting-sources[يۈكلەش ئۈچۈن پەش بىلەن ئايرىلغان تەڭشەك مەنبەلىرىنىڭ تىزىملىكى (user, project, local)]:sources:' \
    '--settings[قوللىنىدىغان تەڭشەك ھۆججىتى ياكى JSON تىزمىسى]:file-or-json:_files' \
    '--strict-mcp-config[ئەۋەتىلگەن يىغىنلاردا پەقەت --mcp-config دىكى MCP مۇلازىمېتىرلىرىنى ئىشلىتىش]' \
    '--restricted[ئەۋەتىلگەن يىغىنلارنى چەكلىك ھالەتتە باشلاش]' \
    '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Anthropic ھېساباتىڭىزغا كىرىش'
    'logout:Anthropic ھېساباتىڭىزدىن چېكىنىش'
    'status:دەلىللەش ھالىتىنى كۆرسىتىش'
    'help:ياردەم كۆرسىتىش'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth commands' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[كىرىش بېتىدىكى ئېلخەت ئادرېسىنى ئالدىن تولدۇرۇش]:email:' \
            '--sso[SSO كىرىش جەريانىنى مەجبۇرىي ئىشلىتىش]' \
            '(--claudeai)--console[Claude مۇشتەرىلىكىنىڭ ئورنىغا Anthropic Console (API ئىشلىتىش ھەققى) نى ئىشلىتىش]' \
            '(--console)--claudeai[Claude مۇشتەرىلىكىنى ئىشلىتىش (سۈكۈتتىكى)]' \
            '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]'
          ;;
        status)
          _arguments \
            '(--text)--json[JSON سۈپىتىدە چىقىرىش (سۈكۈتتىكى)]' \
            '(--json)--text[ئادەم ئوقۇيالايدىغان تېكىست سۈپىتىدە چىقىرىش]' \
            '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:ئۈنۈملۈك ئاپتوماتىك ھالەت سەپلىمىسىنى JSON سۈپىتىدە بېسىپ چىقىرىش'
    'critique:خاسلاشتۇرۇلغان ئاپتوماتىك ھالەت قائىدىلىرىڭىزگە AI ئىنكاسى ئېلىش'
    'defaults:سۈكۈتتىكى ئاپتوماتىك ھالەت قائىدىلىرىنى JSON سۈپىتىدە بېسىپ چىقىرىش'
    'reset:ئاپتوماتىك ھالەت سەپلىمىسىنى تارقىتىلغان سۈكۈتتىكى ھالەتكە ئەسلىگە قايتۇرۇش'
    'help:ياردەم كۆرسىتىش'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode commands' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[ئىشلىتىلىدىغان مودېلنى قاپلاش]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]'
          ;;
        defaults)
          _arguments \
            '--label[پەقەت بەلگىسى بۇ ئالدى قوشۇلغۇچ بىلەن باشلىنىدىغان قائىدىلەرنى كۆرسىتىش (چوڭ-كىچىك ھەرپنى پەرقلەندۈرمەيدۇ)]:prefix:' \
            '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[جەزملەشتۈرۈش سوئالىنى ئاتلاش]' \
            '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[ئۆتكەل YAML سەپلىمىسىنىڭ يولى]:path:_files' \
    '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:تۈر ئۈچۈن بارلىق Claude Code ھالىتىنى ئۆچۈرۈش (سۆزلەشمىلەر، ۋەزىپىلەر، ھۆججەت تارىخى، سەپلىمە تۈرى)'
    'help:ياردەم كۆرسىتىش'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project commands' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[ھېچنېمىنى ئۆچۈرمەي تۇرۇپ ئۆچۈرۈلىدىغانلارنىڭ تىزىملىكىنى كۆرسىتىش]' \
            '(-y --yes)'{-y,--yes}'[جەزملەشتۈرۈش سوئالىنى ئاتلاش]' \
            '(-i --interactive)'{-i,--interactive}'[ئۆچۈرۈشتىن بۇرۇن ھەر بىر تۈر ئۈچۈن سوراش]' \
            '(1)--all[بارلىق تۈرلەرنىڭ ھالىتىنى تازىلاش (يول بىلەن بىللە ئىشلەتكىلى بولمايدۇ)]' \
            '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_purge() {
  _arguments \
    '--dry-run[ھېچنېمىنى ئۆچۈرمەي تۇرۇپ ئۆچۈرۈلىدىغانلارنىڭ تىزىملىكىنى كۆرسىتىش]' \
    '(-y --yes)'{-y,--yes}'[جەزملەشتۈرۈش سوئالىنى ئاتلاش]' \
    '(-i --interactive)'{-i,--interactive}'[ئۆچۈرۈشتىن بۇرۇن ھەر بىر تۈر ئۈچۈن سوراش]' \
    '(1)--all[بارلىق تۈرلەرنىڭ ھالىتىنى تازىلاش (يول بىلەن بىللە ئىشلەتكىلى بولمايدۇ)]' \
    '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]' \
    '(--all)::path:_directories'
}

_claude_ultrareview() {
  _arguments \
    '--json[فورماتلانغان بايقاشلارنىڭ ئورنىغا خام bugs.json يۈكىنى بېسىپ چىقىرىش]' \
    '--timeout[تەكشۈرۈشنىڭ تاماملىنىشىنى كۈتىدىغان ئەڭ كۆپ مىنۇت (سۈكۈتتىكى: 45)]:minutes:' \
    '(--no-post)--post[تاماملانغان تەكشۈرۈش بايقاشلىرىنى سىزنىڭ نامىڭىزدا PR غا يوللاش (پەقەت PR نىشانلىرى؛ تەكشۈرۈش ئەمەس، بىر ئاددىي ئىنكاس)]' \
    '(--post)--no-post[بايقاشلارنى PR غا يوللىماسلىق (سۈكۈتتىكى)]' \
    '--trust-workspace[نۆۋەتتىكى قىسقۇچقا پەقەت بۇ قېتىملىق ئىجرا ئۈچۈن سورىماي ئىشىنىش (قوليازما ۋە CI ئۈچۈن)]' \
    '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[ئىجرا بولۇۋاتقان بارلىق ئارقا سۇپا يىغىنلىرىنى قايتا قوزغىتىش]' \
    '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[worktree نىڭ ئىتتىرىلمىگەن commit لىرى ۋە commit قىلىنمىغان ئۆزگەرتىشلىرىنىمۇ تاشلىۋېتىش (ئالدىنقى claude rm مەلۇم قىلغان commit@worktree-id نى بېرىڭ)]:commit@worktree-id:' \
    '--force-remove-worktree[WorktreeRemove ھۇكى ياكى git ئۆچۈرەلمىگەن بولسىمۇ worktree مۇندەرىجىسىنى ئۆچۈرۈش (ئالدىنقى claude rm مەلۇم قىلغان worktree-id نى بېرىڭ)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]' \
    '1:session:_claude_background_sessions'
}

_claude_self_hosted_runner() {
  _arguments \
    '--api-url[API ئاساسىي URL (سۈكۈتتىكى: https://api.anthropic.com)]:url:' \
    '--environment-secret-file[مۇھىت مەخپىي ھۆججىتىنىڭ يولى]:path:_files' \
    '--lock-to-account[تىزىملىتىش ۋاقتىدا runner نى بىرلا ھېساباتقا باغلاش]:id:' \
    '--client-label[تىزىملىتىش ۋاقتىدا ئەۋەتىلىدىغان كۆزىتىش بەلگىسى (سۈكۈتتىكى: hostname)]:label:' \
    '(--proxy-authorization-file --agent-proxy-url)--proxy-authorization-command[stdout ى سىرتقا چىقىش ۋاكالەتچى مۇلازىمېتىرلىرى ئۈچۈن Proxy-Authorization بېشى بولىدىغان بۇيرۇق]:shell command:' \
    '(--proxy-authorization-command --agent-proxy-url)--proxy-authorization-file[سىرتقا چىقىش ۋاكالەتچى مۇلازىمېتىرلىرى ئۈچۈن Proxy-Authorization بېشىنى ساقلىغان ھۆججەت]:path:_files' \
    '(--proxy-authorization-command --proxy-authorization-file)--agent-proxy-url[ھەر بىر يىغىننى بۇ URL دىكى agent proxy ئارقىلىق يەتكۈزۈش (پەقەت https)]:url:' \
    '--capacity[بىرلا ۋاقىتتىكى يىغىنلارنىڭ ئەڭ كۆپ سانى (سۈكۈتتىكى: 1)]:n:' \
    '--base-dir[repo checkout لىرى ئۈچۈن ئاساسىي مۇندەرىجە (سۈكۈتتىكى: /workspace)]:path:_directories' \
    '--exec-path[بالا يىغىنلارنى قوزغىتىدىغان ئىككىلىك ھۆججەت (سۈكۈتتىكى: مۇشۇ ئىككىلىك ھۆججەت)]:path:_files' \
    '--hooks-dir[ھايات دەۋرى ھۇك قوليازمىلىرىنىڭ مۇندەرىجىسى (checkout، command، post-session)]:path:_directories' \
    '--session-stop-grace-sec[يىغىن ئاخىرلاشقاندىن كېيىن پاكىز چېكىنىشنى قانچىلىك كۈتۈش (سۈكۈتتىكى: 5)]:n:' \
    '--post-session-hook-timeout-sec[post-session ھۇكى ئۈچۈن SIGTERM ۋاقىت چېكى (سۈكۈتتىكى: 60)]:n:' \
    '--checkout-hook-timeout-min[checkout ھۇكىنىڭ ھەر قېتىملىق ئىجراسى ئۈچۈن ئەمەلىي ۋاقىت چېكى (سۈكۈتتىكى: 30؛ 0 چەكلەيدۇ)]:n:' \
    '--drain-wait-sec[SIGTERM/SIGINT كەلگەندە، ئېلىپ بېرىلىۋاتقان خىزمەت ئۈچۈن N سېكۇنتقىچە كۈتۈش (سۈكۈتتىكى: 0)]:n:' \
    '--drain-marker-file[ساھىبخان يۇمشاق توختىتىشنى ئېلان قىلىدىغان بەلگە ھۆججىتى]:path:_files' \
    '*--git-ssh-rewrite[https://<host>/... مەنبە URL لىرىنى git@<host>:... غا قايتا يېزىش (تەكرارلىنىشچان)]:host:' \
    '*--git-host-rewrite[https://<f>/... مەنبە URL لىرىنى https://<t>/... غا قايتا يېزىش (تەكرارلىنىشچان)]:from=to:' \
    '--use-anthropic-git-proxy[Anthropic باشقۇرىدىغان git نى ئىشلىتىش. ئاگاھلاندۇرۇش: HOME دەرىجىسىدىكى git سەپلىمىسىنى ئۆچۈرۈپ ئالماشتۇرىدۇ، پەقەت مەخسۇس ھېسابات ئاستىدا ئىشلىتىڭ]' \
    '--configure-git[ئومۇمىي git كىملىكىنى تەڭشەش ۋە Anthropic ئىمزا مۇلازىمىتى ئارقىلىق commit ئىمزالاشنى قوزغىتىش. ~/.gitconfig غا يازىدۇ]' \
    '--push-outcome-on-release[runner تاماملانمىغان يىغىننى ئۆزى ئاخىرلاشتۇرغاندا، ئىز قوغلانغان نەتىجە تارماقلىرىنى push قىلىش]' \
    '--trust-workspace[ھەر بىر يىغىننىڭ repo يوللىرى ئۈچۈن مەڭگۈلۈك ئىشەنچنى ئالدىن ئورنىتىش (سۈكۈتتىكى: true)]::bool:(true false)' \
    '--remove-session-state[يىغىن ئاخىرلاشقاندا يىغىننىڭ ھالىتىنى ئۆچۈرۈش (سۈكۈتتىكى: false)]::bool:(true false)' \
    '--diff-finds-nested-repository[تارماق قىسقۇچقا كلونلانغان ئامبارنى Changes كۆزنىكىدە كۆرسىتىش؛ --capacity 1 زۆرۈر (سۈكۈتتىكى: false)]::bool:(true false)' \
    '--confine-repo-settings[repo غا commit قىلىنغان تەڭشەكلەرنى چەكلەش قوغداش ھالىتى (سۈكۈتتىكى: warn)]:mode:(warn enforce off)' \
    '--server-auto-mode-lists[يىغىن مۇلازىمېتىردىن قايسى ئاپتوماتىك ھالەت تۈرگە ئايرىغۇچ تىزىملىكلىرىنى تاپشۇرۇۋالالايدۇ (سۈكۈتتىكى: no-allow)]:mode:(all no-allow none)' \
    '--host-config-snapshot[ساھىبخان سەپلىمىسىنىڭ قوزغىلىش ۋاقتىدىكى سۈرىتى ساقلىنىدىغان ئورۇن (سۈكۈتتىكى: disk)]:mode:(disk memory)' \
    '--health-port[/healthz HTTP ئاڭلىغۇچىسى ئۈچۈن ئېغىز (سۈكۈتتىكى: 8080؛ 0 چەكلەيدۇ)]:port:' \
    '--log-level[خاتىرە دەرىجىسى (سۈكۈتتىكى: info)]:level:(info debug)' \
    '--log-file[runner خاتىرىلىرىنى قوشۇش ھالىتىدە ھۆججەتكىمۇ يېزىش]:path:_files' \
    '--exit-if-unused-min[N مىنۇت ئىچىدە ھېچقانداق خىزمەت تەقسىم قىلىنمىسا runner دىن چېكىنىش]:n:' \
    '--drain-grace-sec[ئاكتىپ يىغىنلار ئاخىرلاشقاندىن كېيىن خىزمەت سوراشنى داۋاملاشتۇرىدىغان سېكۇنت (سۈكۈتتىكى: 0)]:n:' \
    '--retire-at[runner نى بۇ مۇتلەق Unix ۋاقتىدا (سېكۇنت بىلەن) پېنسىيەگە چىقىرىش]:epoch-seconds:' \
    '--defer-shutdown-max-min[بىرىنچى SIGTERM/SIGINT دا خىزمەت قوبۇل قىلىشنى توختىتىپ، M مىنۇتتىن كېيىن تاقاشنى تاماملاش (سۈكۈتتىكى: 0)]:m:' \
    '--release-idle-session-min[N مىنۇت ئىشلەتكۈچى كىرگۈزۈشى بولمىسا يىغىن ئورنىنى بوشىتىش]:n:' \
    '--startup-timeout-min[بالا جەريان N مىنۇتتىن كېيىنمۇ قوزغىلىپ بولالمىسا يىغىن ئورنىنى بوشىتىش (سۈكۈتتىكى: 15؛ 0 چەكلەيدۇ)]:n:' \
    '--kill-session-after-min[بالا يىغىننىڭ ئەمەلىي ياشاش ۋاقتىنى N مىنۇت بىلەن چەكلەش]:n:' \
    '--debug-token-dir[پەقەت سازلاش ئۈچۈن: ئاكتىپ token لارنى دىسكىغا يازىدۇ. production دا ئىشلەتمەڭ]:path:_directories' \
    '(-h --help)'{-h,--help}'[بۇ ياردەم ئۇچۇرىنى كۆرسىتىش]'
}

_claude_remote_control() {
  _arguments \
    '--name[يىغىننىڭ ئىسمى (claude.ai/code دا كۆرسىتىلىدۇ)]:name:' \
    '--remote-control-session-name-prefix[ئاپتوماتىك ھاسىل قىلىنغان يىغىن ئىسىملىرى ئۈچۈن ئالدى قوشۇلغۇچى (سۈكۈتتىكى: hostname)]:prefix:' \
    '(-c --continue --session-id)'{-c,--continue}'[بۇ مۇندەرىجە ياكى ئۇنىڭ git worktree لىرىنىڭ بىرى ئۈچۈن ئەڭ ئاخىرقى خاتىرىلەنگەن يىغىنغا قايتا ئۇلىنىش]' \
    '(-c --continue --session-id)--session-id[ID بويىچە مەلۇم يىغىنغا قايتا ئۇلىنىش]:id:' \
    '--permission-mode[قوزغىتىلغان يىغىنلار ئۈچۈن ئىجازەت ھالىتى]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)' \
    '(--no-chrome)--chrome[قوزغىتىلغان يىغىنلار ئۈچۈن Claude in Chrome نى قوزغىتىش]' \
    '(--chrome)--no-chrome[قوزغىتىلغان يىغىنلار ئۈچۈن Claude in Chrome نى چەكلەش]' \
    '(-d --debug)'{-d,--debug}'[تۈر سۈزگۈچى بىلەن سازلاش ھالىتىنى قوزغىتىش]::filter:' \
    '--debug-file[سازلاش خاتىرىلىرىنى ھۆججەتكە يېزىش]:path:_files' \
    '(-v --verbose)'{-v,--verbose}'[تەپسىلىي چىقىرىشنى قوزغىتىش]' \
    '--spawn[قوزغىتىش ھالىتى (سۈكۈتتىكى: same-dir)]:mode:(same-dir worktree session)' \
    '--capacity[worktree ياكى same-dir ھالىتىدە بىرلا ۋاقىتتىكى يىغىنلارنىڭ ئەڭ كۆپ سانى (سۈكۈتتىكى: 32)]:n:' \
    '(--no-create-session-in-dir)--create-session-in-dir[نۆۋەتتىكى مۇندەرىجىدە يىغىننى ئالدىن قۇرۇش (سۈكۈتتىكى)]' \
    '(--create-session-in-dir)--no-create-session-in-dir[نۆۋەتتىكى مۇندەرىجىدە يىغىننى ئالدىن قۇرماسلىق]' \
    '(-h --help)'{-h,--help}'[بۇ ياردەمنى كۆرسىتىش]'
}

_claude_daemon() {
  local -a daemon_commands common_options
  daemon_commands=(
    'run:نازارەتچىنى ئالدى سۇپىدا ئىجرا قىلىش'
    'status:daemon نىڭ pid، نەشرى، ئىجرا ۋاقتىنى كۆرسىتىش'
    'logs:daemon خاتىرىسىنى ئىز قوغلاش (توختىتىش ئۈچۈن Ctrl-C)'
    'uninstall:ئارقا سۇپا مۇلازىمىتىنى ئۆچۈرۈش (launchctl/systemd)'
    'stop:نازارەتچىنى تاقاش ۋە ئارقا سۇپا يىغىنلىرىنى ئاخىرلاشتۇرۇش'
  )
  common_options=(
    '--json-path[سەپلىمە ھۆججىتى (سۈكۈتتىكى: ~/.claude/daemon.json)]:path:_files'
    '--log-file[خاتىرە ھۆججىتى (سۈكۈتتىكى: ~/.claude/daemon.log)]:path:_files'
    '(-h --help)'{-h,--help}'[بۇ ياردەمنى كۆرسىتىش]'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    $common_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'daemon commands' daemon_commands
      ;;
    args)
      case $words[1] in
        run)
          _arguments \
            $common_options \
            '::json-path:_files'
          ;;
        stop)
          _arguments \
            $common_options \
            '--any[ۋاقىتلىق (مۇلازىمەت بولمىغان) daemon نىمۇ توختىتىش]' \
            '--keep-workers[ئايرىلغان يىغىنلارنى ئىجرا ھالىتىدە قالدۇرۇش]'
          ;;
        status|logs|uninstall)
          _arguments \
            $common_options
          ;;
      esac
      ;;
  esac
}

_claude_import() {
  _arguments \
    '--dry-run[ھېچنېمە يازماي تۇرۇپ ئەكىرىلىدىغانلارنى كۆرسىتىش]' \
    '--yes[ئۆز-ئارا تاللىغۇچنى ئاتلاش (ئېكرانسىز مۇھىتلاردا /import ئالدىن كۆرۈشىدىكى --yes=<digest> نى بېرىڭ)]' \
    '(-h --help)'{-h,--help}'[بۇيرۇق ئۈچۈن ياردەم كۆرسىتىش]' \
    '::source:(codex gemini cursor)'
}

# compinit autoloads this file, and that first call only defines the functions
# above: complete right away so the first TAB already works. Sourced directly,
# there is nothing to complete yet, only the registration.
if [[ $funcstack[1] == _claude ]]; then
  _claude "$@"
else
  (( $+_comps[claude] )) || compdef _claude claude
fi
