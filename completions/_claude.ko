    'help:도움말 표시'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[명령 도움말 표시]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project 명령' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[아무것도 삭제하지 않고 삭제될 항목 나열]' \
            '(-y --yes)'{-y,--yes}'[확인 프롬프트 건너뛰기]' \
            '(-i --interactive)'{-i,--interactive}'[삭제 전 각 항목마다 확인]' \
            '(1)--all[모든 프로젝트의 상태 삭제(경로와 함께 사용 불가)]' \
            '(-h --help)'{-h,--help}'[명령 도움말 표시]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_purge() {
  _arguments \
    '--dry-run[아무것도 삭제하지 않고 삭제될 항목 나열]' \
    '(-y --yes)'{-y,--yes}'[확인 프롬프트 건너뛰기]' \
    '(-i --interactive)'{-i,--interactive}'[삭제 전 각 항목마다 확인]' \
    '(1)--all[모든 프로젝트의 상태 삭제(경로와 함께 사용 불가)]' \
    '(-h --help)'{-h,--help}'[명령 도움말 표시]' \
    '(--all)::path:_directories'
}

_claude_ultrareview() {
  _arguments \
    '--json[형식화된 결과 대신 원시 bugs.json 페이로드 출력]' \
    '--timeout[검토 완료를 기다릴 최대 분(기본값: 45)]:minutes:' \
    '(--no-post)--post[완료된 검토 결과를 사용자 명의로 PR에 게시(PR 대상만, 리뷰가 아닌 일반 댓글 하나)]' \
    '(--post)--no-post[결과를 PR에 게시하지 않음(기본값)]' \
    '--trust-workspace[이번 실행에 한해 묻지 않고 현재 폴더 신뢰(스크립트 및 CI용)]' \
    '(-h --help)'{-h,--help}'[명령 도움말 표시]' \
    '1:target:'
}

_claude_respawn() {
