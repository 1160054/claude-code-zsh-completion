    '(1)--all[실행 중인 모든 백그라운드 세션 재시작]' \
    '(-h --help)'{-h,--help}'[명령 도움말 표시]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[worktree의 푸시되지 않은 커밋과 커밋되지 않은 변경 사항도 폐기(이전 claude rm이 보고한 commit@worktree-id 전달)]:commit@worktree-id:' \
    '--force-remove-worktree[WorktreeRemove 훅이나 git이 제거하지 못했더라도 worktree 디렉터리 삭제(이전 claude rm이 보고한 worktree-id 전달)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[명령 도움말 표시]' \
    '1:session:_claude_background_sessions'
}

_claude_self_hosted_runner() {
  _arguments \
    '--api-url[API 기본 URL(기본값: https://api.anthropic.com)]:url:' \
    '--environment-secret-file[환경 시크릿 파일 경로]:path:_files' \
    '--lock-to-account[등록 시 러너를 단일 계정에 고정]:id:' \
    '--client-label[등록 시 전송되는 관측용 레이블(기본값: hostname)]:label:' \
    '(--proxy-authorization-file --agent-proxy-url)--proxy-authorization-command[stdout이 egress 프록시용 Proxy-Authorization 헤더가 되는 명령]:shell command:' \
    '(--proxy-authorization-command --agent-proxy-url)--proxy-authorization-file[egress 프록시용 Proxy-Authorization 헤더가 담긴 파일]:path:_files' \
    '(--proxy-authorization-command --proxy-authorization-file)--agent-proxy-url[모든 세션을 이 URL의 에이전트 프록시를 통해 라우팅(https만)]:url:' \
    '--capacity[최대 동시 세션 수(기본값: 1)]:n:' \
    '--base-dir[저장소 체크아웃의 기본 디렉터리(기본값: /workspace)]:path:_directories' \
    '--exec-path[자식 세션으로 실행할 바이너리(기본값: 이 바이너리)]:path:_files' \
    '--hooks-dir[수명 주기 훅 스크립트 디렉터리(checkout, command, post-session)]:path:_directories' \
    '--session-stop-grace-sec[세션 종료 후 정상 종료를 기다리는 시간(기본값: 5)]:n:' \
    '--post-session-hook-timeout-sec[post-session 훅의 SIGTERM 유예 시간(기본값: 60)]:n:' \
    '--checkout-hook-timeout-min[checkout 훅 1회 실행당 실제 시간 한도(기본값: 30, 0이면 비활성화)]:n:' \
    '--drain-wait-sec[SIGTERM/SIGINT 수신 시 진행 중인 작업을 최대 N초 대기(기본값: 0)]:n:' \
    '--drain-marker-file[호스트가 정상 드레인을 알리는 마커 파일]:path:_files' \
    '*--git-ssh-rewrite[https://<host>/... 소스 URL을 git@<host>:...로 재작성(반복 가능)]:host:' \
    '*--git-host-rewrite[https://<f>/... 소스 URL을 https://<t>/...로 재작성(반복 가능)]:from=to:' \
    '--use-anthropic-git-proxy[Anthropic 관리 git 사용. 경고: HOME 수준 git 설정을 삭제하고 대체하므로 전용 계정에서만 사용]' \
    '--configure-git[전역 git ID를 설정하고 Anthropic 서명 서비스로 커밋 서명 활성화. ~/.gitconfig에 기록]' \
    '--push-outcome-on-release[러너가 시작한 세션이 완료되지 않고 끝나면 추적 중인 결과 브랜치 푸시]' \
    '--trust-workspace[각 세션의 저장소 경로에 대한 신뢰를 미리 저장(기본값: true)]::bool:(true false)' \
    '--remove-session-state[세션 종료 시 세션별 상태 제거(기본값: false)]::bool:(true false)' \
    '--diff-finds-nested-repository[하위 폴더에 복제된 저장소를 Changes 창에 표시. --capacity 1 필요(기본값: false)]::bool:(true false)' \
    '--confine-repo-settings[저장소에 커밋된 설정을 제한하는 가드 모드(기본값: warn)]:mode:(warn enforce off)' \
    '--server-auto-mode-lists[세션이 서버에서 받을 수 있는 자동 모드 분류기 목록(기본값: no-allow)]:mode:(all no-allow none)' \
    '--host-config-snapshot[호스트 설정의 시작 시 스냅샷 보관 위치(기본값: disk)]:mode:(disk memory)' \
    '--health-port[/healthz HTTP 리스너 포트(기본값: 8080, 0이면 비활성화)]:port:' \
    '--log-level[로그 수준(기본값: info)]:level:(info debug)' \
    '--log-file[러너 로그를 추가 모드로 파일에도 기록]:path:_files' \
    '--exit-if-unused-min[N분 동안 작업이 한 번도 할당되지 않으면 러너 종료]:n:' \
    '--drain-grace-sec[활성 세션이 끝난 후 작업을 계속 폴링할 시간(초)(기본값: 0)]:n:' \
    '--retire-at[이 절대 Unix 시간(초)에 러너 퇴역]:epoch-seconds:' \
    '--defer-shutdown-max-min[첫 SIGTERM/SIGINT에서 새 작업 수락을 멈추고 M분 후 종료 완료(기본값: 0)]:m:' \
    '--release-idle-session-min[N분 동안 사용자 입력이 없으면 세션 슬롯 해제]:n:' \
    '--startup-timeout-min[자식 프로세스가 N분이 지나도 시작을 마치지 못하면 세션 슬롯 해제(기본값: 15, 0이면 비활성화)]:n:' \
    '--kill-session-after-min[세션 자식 프로세스의 실제 수명을 N분으로 제한]:n:' \
    '--debug-token-dir[디버그 전용: 실제 토큰을 디스크에 기록. 프로덕션에서 사용 금지]:path:_directories' \
    '(-h --help)'{-h,--help}'[이 도움말 메시지 표시]'
}

_claude_remote_control() {
  _arguments \
    '--name[세션 이름(claude.ai/code에 표시)]:name:' \
    '--remote-control-session-name-prefix[자동 생성 세션 이름의 접두사(기본값: hostname)]:prefix:' \
    '(-c --continue --session-id)'{-c,--continue}'[이 디렉터리 또는 해당 git worktree에 마지막으로 기록된 세션에 다시 연결]' \
    '(-c --continue --session-id)--session-id[ID로 특정 세션에 다시 연결]:id:' \
    '--permission-mode[생성된 세션의 권한 모드]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)' \
    '(--no-chrome)--chrome[생성된 세션에서 Claude in Chrome 활성화]' \
    '(--chrome)--no-chrome[생성된 세션에서 Claude in Chrome 비활성화]' \
    '(-d --debug)'{-d,--debug}'[선택적 카테고리 필터링으로 디버그 모드 활성화]::filter:' \
    '--debug-file[디버그 로그를 파일에 기록]:path:_files' \
    '(-v --verbose)'{-v,--verbose}'[상세 출력 활성화]' \
    '--spawn[생성 모드(기본값: same-dir)]:mode:(same-dir worktree session)' \
    '--capacity[worktree 또는 same-dir 모드의 최대 동시 세션 수(기본값: 32)]:n:' \
    '(--no-create-session-in-dir)--create-session-in-dir[현재 디렉터리에 세션 미리 생성(기본값)]' \
    '(--create-session-in-dir)--no-create-session-in-dir[현재 디렉터리에 세션을 미리 생성하지 않음]' \
    '(-h --help)'{-h,--help}'[이 도움말 표시]'
}

_claude_daemon() {
  local -a daemon_commands common_options
  daemon_commands=(
    'run:슈퍼바이저를 포그라운드에서 실행'
    'status:daemon pid, 버전, 가동 시간 표시'
    'logs:daemon 로그 추적(Ctrl-C로 중지)'
    'uninstall:백그라운드 서비스 제거(launchctl/systemd)'
    'stop:슈퍼바이저를 중지하고 백그라운드 세션 종료'
  )
  common_options=(
    '--json-path[설정 파일(기본값: ~/.claude/daemon.json)]:path:_files'
    '--log-file[로그 파일(기본값: ~/.claude/daemon.log)]:path:_files'
    '(-h --help)'{-h,--help}'[이 도움말 표시]'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    $common_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'daemon 명령' daemon_commands
      ;;
    args)
      case $words[1] in
        run)
          _arguments \
            $common_options \
            '::json-path:_files'
          ;;
        stop)
          _arguments \
            $common_options \
            '--any[일시적인(서비스가 아닌) daemon도 중지]' \
            '--keep-workers[분리된 세션은 계속 실행]'
          ;;
        status|logs|uninstall)
          _arguments \
            $common_options
          ;;
      esac
      ;;
  esac
}

_claude_import() {
  _arguments \
    '--dry-run[아무것도 쓰지 않고 가져올 항목 표시]' \
    '--yes[대화형 선택기 건너뛰기(헤드리스 환경에서는 /import 미리보기의 --yes=<digest> 전달)]' \
    '(-h --help)'{-h,--help}'[명령 도움말 표시]' \
    '::source:(codex gemini cursor)'
}

# compinit autoloads this file, and that first call only defines the functions
# above: complete right away so the first TAB already works. Sourced directly,
# there is nothing to complete yet, only the registration.
if [[ $funcstack[1] == _claude ]]; then
  _claude "$@"
else
  (( $+_comps[claude] )) || compdef _claude claude
fi
