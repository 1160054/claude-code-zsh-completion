#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:MCP 서버 구성 및 관리'
    'plugin:Claude Code 플러그인 관리'
    'agents:백그라운드 에이전트 관리'
    'attach:백그라운드 세션을 이 터미널에서 열기'
    'logs:백그라운드 세션의 최근 터미널 출력 표시'
    'stop:백그라운드 세션 중지(대화는 유지됨)'
    'respawn:백그라운드 세션을 재시작하여 현재 Claude Code 버전으로 실행'
    'rm:백그라운드 세션 삭제(안전한 경우 worktree도 함께)'
    'remote-control:claude.ai/code 또는 Claude 모바일 앱에서 로컬 세션 제어'
    'daemon:백그라운드 세션 슈퍼바이저 관리'
    'auth:인증 관리'
    'auto-mode:자동 모드 분류기 구성 검사 또는 재설정'
    'gateway:엔터프라이즈 인증/텔레메트리 게이트웨이 실행'
    'self-hosted-runner:이 머신 또는 컨테이너에서 Claude Code 클라우드 세션 호스팅'
    'import:다른 AI 코딩 에이전트의 설정을 Claude Code로 가져오기'
    'project:Claude Code 프로젝트 상태 관리'
    'purge:프로젝트의 모든 Claude Code 상태 삭제(트랜스크립트, 작업, 파일 기록, 구성 항목)'
    'ultrareview:클라우드 호스팅 멀티 에이전트 코드 검토를 실행하고 결과 출력'
    'setup-token:장기 인증 토큰 설정(Claude 구독 필요)'
    'doctor:Claude Code 자동 업데이터 상태 점검'
    'update:업데이트 확인 및 설치'
    'install:Claude Code 네이티브 빌드 설치'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[선택적 카테고리 필터링으로 디버그 모드 활성화(예: "api,hooks" 또는 "!statsig,!file")]:filter:'
    '--verbose[설정 파일의 상세 모드 설정 재정의]'
    '(-p --print)'{-p,--print}'[응답 출력 후 종료(파이프와 함께 사용). 참고: 신뢰할 수 있는 디렉토리에서만 사용]'
    '--output-format[출력 형식(--print와 함께 사용): "text"(기본값), "json"(단일 결과) 또는 "stream-json"(실시간 스트리밍)]:format:(text json stream-json)'
    '--json-schema[구조화된 출력 검증을 위한 JSON 스키마]:schema:'
    '--include-partial-messages[도착하는 대로 부분 메시지 청크 포함(--print 및 --output-format=stream-json과 함께 사용)]'
    '--input-format[입력 형식(--print와 함께 사용): "text"(기본값) 또는 "stream-json"(실시간 스트리밍 입력)]:format:(text stream-json)'
    '--dangerously-skip-permissions[모든 권한 확인 우회. 인터넷 액세스가 없는 샌드박스에만 권장]'
    '--allow-dangerously-skip-permissions[기본적으로 활성화하지 않고 권한 확인 우회 옵션 활성화]'
    '--restricted[제한 모드: 명령이나 코드를 실행하는 도구와 WebFetch를 제거하고, user/project/local 설정을 무시하며, 파일 도구를 작업 디렉터리로 제한]'
    '--max-budget-usd[API 호출에 사용할 최대 달러 금액(--print만)]:amount:'
    '--max-turns[에이전트 턴 수 제한(--print만)]:turns:'
    '--replay-user-messages[확인을 위해 stdin의 사용자 메시지를 stdout으로 재전송]'
    '--allowed-tools[허용되는 도구 이름의 쉼표 또는 공백으로 구분된 목록(예: "Bash(git:*) Edit")]:tools:'
    '--allowedTools[허용되는 도구 이름의 쉼표 또는 공백으로 구분된 목록(camelCase 형식)]:tools:'
    '--tools[내장 세트에서 사용 가능한 도구 목록 지정. 인쇄 모드만]:tools:'
    '--disallowed-tools[허용되지 않는 도구 이름의 쉼표 또는 공백으로 구분된 목록(예: "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[허용되지 않는 도구 이름의 쉼표 또는 공백으로 구분된 목록(camelCase 형식)]:tools:'
    '--mcp-config[JSON 파일 또는 문자열에서 MCP 서버 로드(공백으로 구분)]:configs:'
    '--system-prompt[세션에 사용할 시스템 프롬프트]:prompt:'
    '--system-prompt-file[파일에서 시스템 프롬프트 읽기]:file:_files'
    '--append-system-prompt[기본 시스템 프롬프트에 시스템 프롬프트 추가]:prompt:'
    '--append-system-prompt-file[파일에서 시스템 프롬프트를 읽어 기본 시스템 프롬프트에 추가]:file:_files'
    '(--append-subagent-system-prompt-file)--append-subagent-system-prompt[모든 서브에이전트의 시스템 프롬프트에 텍스트 추가(--print만)]:prompt:'
    '(--append-subagent-system-prompt)--append-subagent-system-prompt-file[파일에서 텍스트를 읽어 서브에이전트 시스템 프롬프트에 추가(--print만)]:file:_files'
    '--system-prompt-snapshot[시스템 프롬프트를 대화당 한 번 기록하고 모든 요청과 재개에서 그대로 재사용(on, 기본값)하거나 매 요청마다 새로 생성(off)]:mode:(on off)'
    '--permission-mode[세션에 사용할 권한 모드]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[--print 사용 시 권한 프롬프트에 누가 응답할지: "host"(SDK 호스트 또는 --permission-prompt-tool) 또는 "none"(프롬프트가 필요한 것은 모두 거부)]:target:(host none)'
    '--permission-prompt-tool[권한 프롬프트에 사용할 MCP 도구(--print 전용)]:tool:'
    '(-c --continue)'{-c,--continue}'[가장 최근 대화 계속하기]'
    '(-r --resume)'{-r,--resume}'[대화 재개 - 세션 ID 지정 또는 대화식으로 선택]:sessionId:_claude_sessions'
    '--fork-session[재개 시 원래 세션 ID를 재사용하는 대신 새 세션 ID 생성(--resume 또는 --continue와 함께 사용)]'
    '--no-session-persistence[세션 지속성 비활성화 - 세션이 저장되지 않음(--print만)]'
    '--model[현재 세션의 모델. 최신 모델의 별칭 지정(예: '\''sonnet'\'' 또는 '\''opus'\'')]:model:_claude_model_names'
    '--agent[현재 세션의 에이전트. '\''agent'\'' 설정을 재정의함]:agent:_claude_agent_names'
    '--betas[API 요청에 포함할 베타 헤더(API 키 사용자만)]:betas:'
    '--fallback-model[기본 모델이 과부하 상태일 때 지정된 모델로 자동 폴백 활성화(--print만)]:model:_claude_model_names'
    '--settings[설정 JSON 파일 경로 또는 추가 설정을 로드할 JSON 문자열]:file-or-json:_files'
    '--add-dir[도구 액세스를 허용할 추가 디렉토리]:directories:_directories'
    '--ide[정확히 하나의 유효한 IDE를 사용할 수 있는 경우 시작 시 자동으로 IDE에 연결]'
    '--desktop[터미널 대신 Claude Desktop 앱에서 열기 (--continue 또는 --resume <id>로 세션 선택)]'
    '--strict-mcp-config[--mcp-config의 MCP 서버만 사용하고 다른 모든 MCP 설정 무시]'
    '--session-id[대화에 사용할 특정 세션 ID(유효한 UUID여야 함)]:uuid:'
    '--agents[사용자 정의 에이전트를 정의하는 JSON 객체]:json:'
    '--advisor[모델 별칭 또는 전체 모델 ID로 이 세션에 서버 측 어드바이저 도구 활성화]:model:_claude_model_names'
    '--teammate-mode[에이전트 팀 팀원의 표시 방식]:mode:(in-process auto tmux iterm2)'
    '--setting-sources[로드할 설정 소스의 쉼표로 구분된 목록(user, project, local)]:sources:'
    '--plugin-dir[이 세션에만 플러그인을 로드할 디렉토리(반복 가능)]:paths:_directories'
    '--disable-slash-commands[모든 슬래시 명령 비활성화]'
    '(--bg --background)'{--bg,--background}'[세션을 백그라운드 에이전트로 시작하고 즉시 반환]'
    '(-w --worktree)'{-w,--worktree}'[이 세션을 위한 새 git worktree 생성(선택적으로 이름 지정)]::name:'
    '--tmux=-[worktree를 위한 tmux 세션 생성(--worktree 필요). 가능하면 iTerm2 네이티브 창을 사용하며, 기존 tmux는 --tmux=classic]::mode:(classic)'
    '(-n --name)'{-n,--name}'[이 세션의 표시 이름 설정]:name:'
    '--effort[현재 세션의 노력 수준]:level:(low medium high xhigh max)'
    '--autocompact[자동 압축 창 크기(auto 또는 100k~1M 토큰)]:size:(auto)'
    '--debug-file[특정 파일 경로에 디버그 로그 작성(암시적으로 디버그 모드 활성화)]:path:_files'
    '--from-pr[번호/URL로 PR에 연결된 세션 재개 또는 대화식 선택기 열기]::value:'
    '--teleport[텔레포트 세션 재개(선택적으로 세션 ID 지정)]::session:'
    '(--remote)--cloud[지정한 설명으로 클라우드 세션을 생성하거나 세션 ID 또는 claude.ai/code URL로 기존 세션에 연결]::description-or-session:'
    '(--cloud)--remote[--cloud의 더 이상 사용되지 않는 별칭]::description-or-session:'
    '--environment[지정한 자체 호스팅 환경(ccpool_...)에서 실행되는 새 클라우드 세션 생성]:environment_id:'
    '--ref[--environment와 함께: 새 세션의 체크아웃을 로컬 HEAD 대신 지정한 ref 기준으로 생성]:branch:'
    '(--remote-control --rc)'{--remote-control,--rc}'[Remote Control이 활성화된 대화식 세션 시작(선택적으로 이름 지정)]::name:'
    '--remote-control-session-name-prefix[자동 생성된 Remote Control 세션 이름의 접두사]:prefix:'
    '--chrome[Claude in Chrome 통합 활성화]'
    '--no-chrome[Claude in Chrome 통합 비활성화]'
    '--plugin-url[이 세션에만 URL에서 플러그인 .zip 가져오기(반복 가능)]:url:'
    '--file[시작 시 다운로드할 파일 리소스(형식: file_id:relative_path)]:specs:'
    '--prompt-suggestions[프롬프트 제안 활성화(print/SDK 모드에서 예측된 다음 프롬프트 방출)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[서브에이전트 텍스트 및 사고 블록을 메시지로 전달(--print 및 stream-json과 함께 사용)]'
    '--include-hook-events[출력 스트림에 모든 훅 수명 주기 이벤트 포함(stream-json과 함께 사용)]'
    '--exclude-dynamic-system-prompt-sections[머신별 섹션을 첫 번째 사용자 메시지로 이동하여 프롬프트 캐시 재사용 개선]'
    '--brief[에이전트-사용자 통신을 위한 SendUserMessage 도구 활성화]'
    '*--channels[(리서치 프리뷰) 채널 알림을 수신할 MCP 서버(plugin\:<name>@<marketplace>)]:entries:'
    '*--dangerously-load-development-channels[승인된 허용 목록에 없는 채널을 로컬 개발용으로 활성화(plugin\:<name>@<marketplace> 또는 server\:<name>)]:entries:'
    '--init[세션 전에 init 매처로 Setup 훅 실행(--print만)]'
    '--init-only[Setup 및 SessionStart 훅을 실행한 후 대화를 시작하지 않고 종료]'
    '--maintenance[세션 전에 maintenance 매처로 Setup 훅 실행(--print만)]'
    '--safe-mode[모든 사용자 정의를 비활성화하고 시작(손상된 구성 문제 해결에 유용)]'
    '--bare[최소 모드: 훅, LSP, 플러그인 동기화, 속성, 자동 메모리 및 CLAUDE.md 자동 검색 건너뛰기]'
    '--ax-screen-reader[스크린 리더 친화적 출력 렌더링(장식용 테두리나 애니메이션 없는 평문 텍스트)]'
    '(-v --version)'{-v,--version}'[버전 번호 출력]'
    '(-h --help)'{-h,--help}'[명령 도움말 표시]'
  )

  # Stop at the first non-option word, so that the options after a command reach
  # that command's own specs instead of being consumed here
  _arguments -C -A '-*' \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude 명령' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin|plugins)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[명령 도움말 표시]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        remote-control|rc|remote|sync|bridge)
          _claude_remote_control
          ;;
        daemon)
          _claude_daemon
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        self-hosted-runner)
          _claude_self_hosted_runner
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        purge)
          _claude_purge
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update|upgrade)
          _arguments \
            '(-h --help)'{-h,--help}'[명령 도움말 표시]'
          ;;
        *)
          # Not a command but the prompt: options may still follow it
          _arguments \
            $main_options \
            '*: :'
          ;;
      esac
      ;;
  esac
  local ret=$?

  # The last step, such as listing commands for --r, can fail although options
  # were added before it. Report success then: on failure zsh moves on to the
  # next completers, and _correct or _approximate pile on corrections
  (( compstate[nmatches] > 0 )) || return $ret
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Claude Code MCP 서버 시작'
    'add:Claude Code에 MCP 서버 추가'
    'remove:MCP 서버 제거'
    'list:구성된 MCP 서버 나열'
    'get:MCP 서버 세부 정보 가져오기'
    'add-json:JSON 문자열로 MCP 서버(stdio 또는 SSE) 추가'
    'add-from-claude-desktop:Claude Desktop에서 MCP 서버 가져오기(Mac 및 WSL만)'
    'reset-project-choices:이 프로젝트의 모든 승인/거부된 프로젝트 범위(.mcp.json) 서버 재설정'
    'login:MCP 서버로 인증(HTTP, SSE 또는 claude.ai 커넥터)'
    'logout:MCP 서버의 저장된 OAuth 자격 증명 지우기'
    'help:도움말 표시'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[도움말 표시]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp 명령' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[디버그 모드 활성화]' \
            '--verbose[설정 파일의 상세 모드 설정 재정의]' \
            '(-h --help)'{-h,--help}'[도움말 표시]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[구성 범위(local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[전송 유형(stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[환경 변수 설정(예: -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[WebSocket 헤더 설정]:header:' \
            '--client-id[HTTP/SSE 서버용 OAuth 클라이언트 ID]:clientId:' \
            '--client-secret[OAuth 클라이언트 시크릿 입력 요청(또는 MCP_CLIENT_SECRET 환경 변수 설정)]' \
            '--callback-port[OAuth 콜백용 고정 포트(리디렉션 URI 사전 등록이 필요한 서버용)]:port:' \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[구성 범위(local, user, project) - 지정하지 않으면 기존 범위에서 제거]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[도움말 표시]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[구성 범위(local, user, project)]:scope:(local user project)' \
            '--client-secret[OAuth 클라이언트 시크릿 입력 요청(또는 MCP_CLIENT_SECRET 환경 변수 설정)]' \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[구성 범위(local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[도움말 표시]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[도움말 표시]'
          ;;
        login)
          _arguments \
            '--no-browser[브라우저를 열지 않고 인증 URL 출력(SSH/헤드리스 세션용)]' \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:플러그인 또는 마켓플레이스 매니페스트 검증'
    'marketplace:Claude Code 마켓플레이스 관리'
    'list:설치된 플러그인 나열'
    'details:플러그인의 구성 요소 인벤토리 및 예상 토큰 비용 표시'
    'configure:플러그인 옵션과 설정되지 않은 항목 표시, 또는 stdin에서 값 저장'
    'install:사용 가능한 마켓플레이스에서 플러그인 설치'
    'i:사용 가능한 마켓플레이스에서 플러그인 설치(install의 약어)'
    'init:새 플러그인 스캐폴딩(다음 세션에 자동 로드)'
    'new:새 플러그인 스캐폴딩(init의 별칭)'
    'uninstall:설치된 플러그인 제거'
    'remove:설치된 플러그인 제거(uninstall의 별칭)'
    'enable:비활성화된 플러그인 활성화'
    'disable:활성화된 플러그인 비활성화'
    'update:플러그인을 최신 버전으로 업데이트'
    'eval:플러그인에 대해 eval 케이스를 실행하고 채점된 결과 보고'
    'prune:더 이상 필요하지 않은 자동 설치된 종속성 제거'
    'autoremove:더 이상 필요하지 않은 자동 설치된 종속성 제거(prune의 별칭)'
    'tag:플러그인 릴리스를 위한 {name}--v{version} git 태그 생성'
    'test:mod의 테스트 실행'
    'help:도움말 표시'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[도움말 표시]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin 명령' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[경고를 오류로 처리(종료 코드 1)]' \
            '--profile[이 명령이 실행하는 검사에서 지정한 카탈로그가 플러그인 제출을 거부할 경우에도 exit 1로 종료]:name:(directory)' \
            '--json[검증 보고서를 JSON으로 출력(종료 코드는 동일)]' \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[설치 범위]:scope:(user project local)' \
            '--accept-command[이전 --json 실행이 shownCommand.sha256으로 보고한 sha256의 마켓플레이스 선언 명령을 수락]:sha256:' \
            '*--config[플러그인 매니페스트에 선언된 userConfig 옵션 설정(반복 가능)]:key=value:' \
            '--marketplace[이 소스(owner/repo, git 또는 https URL, 경로)의 마켓플레이스에서 플러그인을 이름만으로 설치(필요하면 마켓플레이스를 먼저 추가)]:source:' \
            '--registry[package@npm 설치용: 이 npm 레지스트리에서 해석하고 다운로드]:url:' \
            '(-y --yes)'{-y,--yes}'[표시된 마켓플레이스 선언 명령을 확인 프롬프트 없이 수락]' \
            '--json[사람용 메시지 대신 기계가 읽을 수 있는 결과 한 줄 출력]' \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[설치 범위]:scope:(user project local)' \
            '--keep-data[플러그인의 영구 데이터 디렉터리 보존]' \
            '--prune[더 이상 필요하지 않은 자동 설치된 종속성도 제거]' \
            '(-y --yes)'{-y,--yes}'[--prune 확인 프롬프트 건너뛰기]' \
            '--json[사람용 메시지 대신 기계가 읽을 수 있는 결과 한 줄 출력(--prune과 함께 사용 불가)]' \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[설치 범위]:scope:(user project local)' \
            '--json[사람용 메시지 대신 기계가 읽을 수 있는 결과 한 줄 출력]' \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[활성화된 모든 플러그인 비활성화]' \
            '(-s --scope)'{-s,--scope}'[설치 범위]:scope:(user project local)' \
            '--json[사람용 메시지 대신 기계가 읽을 수 있는 결과 한 줄 출력]' \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '--accept-command[이전 --json 실행이 shownCommand.sha256으로 보고한 sha256의 마켓플레이스 선언 명령을 수락]:sha256:' \
            '(-s --scope)'{-s,--scope}'[설치 범위]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[표시된 마켓플레이스 선언 명령을 확인 프롬프트 없이 수락]' \
            '--json[사람용 메시지 대신 기계가 읽을 수 있는 결과 한 줄 출력]' \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[JSON으로 출력]' \
            '--available[마켓플레이스에서 사용 가능한 플러그인 포함(--json 필요)]' \
            '--data-size[설치된 각 플러그인의 저장 데이터 디렉터리 또는 지정한 플러그인만 크기 측정 (--json 필요)]::plugin:_claude_installed_plugins' \
            '(-h --help)'{-h,--help}'[도움말 표시]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[정리할 범위]:scope:(user project local)' \
            '--dry-run[제거하지 않고 제거될 항목 나열]' \
            '(-y --yes)'{-y,--yes}'[확인 프롬프트 건너뛰기]' \
            '(-h --help)'{-h,--help}'[도움말 표시]'
          ;;
        configure)
          _arguments \
            '--json[JSON으로 출력]' \
            '--values-stdin[stdin에서 한 줄 문자열로 된 JSON 객체로 옵션 값 읽기 (생략한 옵션은 기존 값 유지)]' \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[매니페스트 설명]:text:' \
            '--author[작성자 이름(기본값: git config user.name)]:name:' \
            '--author-email[작성자 이메일(기본값: git config user.email)]:email:' \
            '--with[함께 스캐폴딩할 구성 요소]:components:' \
            '(-f --force)'{-f,--force}'[대상에 있는 기존 .claude-plugin/ 덮어쓰기]' \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '1:name:'
          ;;
        eval)
          if [[ $words[2] == init ]]; then
            _arguments \
              '--bare[인터뷰를 실행하지 않고 빈 템플릿 작성]' \
              '--eval-dir[케이스를 작성할 현재 디렉터리 아래의 디렉터리]:dir:_directories' \
              '(-i --interactive)'{-i,--interactive}'[작성 인터뷰 실행 (대화형 터미널 필요)]' \
              '(-h --help)'{-h,--help}'[도움말 표시]' \
              '::name:'
            return
          fi
          _arguments \
            '--case[이름 glob으로 케이스 필터링]:glob:' \
            '*--tag[태그로 케이스 필터링(반복 가능)]:tag:' \
            '--runs[케이스별 실행 횟수 재정의(기본값: case.runs, 없으면 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[최대 n개의 에이전트 실행을 동시에 수행(1~8, 기본값 1)]:n:' \
            '--model[모든 케이스의 모델 재정의]:model:_claude_model_names' \
            '--judge-model[LLM 채점 모델 재정의(기본값: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[비용 상한선. 도달하면 중단하고 부분 결과 보고(종료 코드 2)]:usd:' \
            '--output-dir[aggregate-result.json을 저장할 디렉터리]:dir:_directories' \
            '--eval-dir[평가 케이스가 있는 디렉터리 이름(플러그인 하위)]:dir:' \
            '--json[전체 실행 결과를 JSON으로 stdout에 출력하거나 이 .json 파일에 기록]::path:_files' \
            '--threshold[어떤 케이스라도 점수가 이 임계값 미만이면 종료 코드 1(기본값: 1.0)]:threshold:' \
            '*--allow-tools[제한된 도구(Bash, Write, Edit, WebFetch, mcp__*)에 대한 운영자 허용]:tools:' \
            '*--disallow-tools[허용되더라도 항상 Claude가 사용하지 못하게 할 기본 제공 도구]:tools:' \
            '(--no-scaffold)--scaffold[각 케이스의 scaffold_script 실행(작성자가 제공한 bash를 사용자 권한으로 실행, 기본값 꺼짐)]' \
            '(--scaffold)--no-scaffold[scaffold_script를 명시적으로 건너뛰기]' \
            '--trust-plugin[이 플러그인과 평가 스위트를 신뢰함을 선언하여 첫 실행 신뢰 프롬프트 건너뛰기(CI용)]' \
            '--ablation[플러그인 없는 기준선도 실행하여 점수 차이 보고]:mode:(none with-without)' \
            '--mocks[MCP 서버의 모의 대체(<eval dir>/mocks/에서)]:mode:(record off)' \
            '--allow-real-servers[--mocks record 사용 시 모의가 없는 실제 MCP 서버 프로세스도 시작]' \
            '--keep-temp[디버깅을 위해 scaffold 디렉터리 보존]' \
            '--verbose[메시지별 추적 이벤트를 디버그 로그에 기록]' \
            '--report[독립형 HTML 보고서를 결과 디렉터리 대신 이 경로에 기록]:path:_files' \
            '(--no-publish)--publish-report[보고서를 claude.ai에 게시하는 것도 필수로 지정]' \
            '(--publish-report)--no-publish[HTML 보고서를 로컬에만 보관하고 claude.ai에 게시하지 않음]' \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '::target: _alternative "commands\:eval command\:(init)" "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[태그 생성 후 --remote로 푸시]' \
            '--dry-run[태그를 생성하지 않고 대상 출력]' \
            '(-f --force)'{-f,--force}'[작업 트리 변경 사항 및 태그 중복 검사 건너뛰기]' \
            '(-m --message)'{-m,--message}'[태그 주석 메시지(%s는 버전으로 대체)]:msg:' \
            '--remote[--push로 푸시할 원격 저장소]:name:' \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:URL, 경로 또는 GitHub 저장소에서 마켓플레이스 추가'
    'list:구성된 마켓플레이스 나열'
    'remove:구성된 마켓플레이스 제거'
    'rm:구성된 마켓플레이스 제거(remove의 별칭)'
    'update:소스에서 마켓플레이스 업데이트 - 이름을 지정하지 않으면 모두 업데이트'
    'help:도움말 표시'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[도움말 표시]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace 명령' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[git sparse-checkout으로 특정 디렉터리만 체크아웃(모노레포용)]:paths:' \
            '--scope[마켓플레이스를 선언할 위치]:scope:(user project local)' \
            '--json[기계가 읽을 수 있는 결과를 표준 출력의 마지막 줄로 한 줄 출력]' \
            '--claudeai[claude.ai가 호스팅하는 이 이름의 마켓플레이스 추가]' \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[JSON으로 출력]' \
            '(-h --help)'{-h,--help}'[도움말 표시]'
          ;;
        remove|rm)
          _arguments \
            '--scope[특정 설정 범위에서 마켓플레이스 선언 제거(생략하면 모든 범위에서 제거)]:scope:(user project local)' \
            '--json[기계가 읽을 수 있는 결과를 표준 출력의 마지막 줄로 한 줄 출력]' \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '--json[마켓플레이스 이름 지정 시: 기계가 읽을 수 있는 결과를 표준 출력의 마지막 줄로 한 줄 출력]' \
            '(-h --help)'{-h,--help}'[도움말 표시]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[이미 설치된 경우에도 강제 설치]' \
    '(-h --help)'{-h,--help}'[도움말 표시]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[디스패치된 세션에서 도구 액세스를 허용할 추가 디렉토리]:directory:_directories' \
    '--agent[에이전트 뷰에서 디스패치된 세션의 기본 에이전트]:agent:_claude_agent_names' \
    '--all[--json과 함께: 완료된 백그라운드 세션도 포함]' \
    '--allow-dangerously-skip-permissions[디스패치된 세션에서 권한 우회 모드 사용 가능하게 함]' \
    '--cwd[경로 아래에서 시작된 백그라운드 세션만 표시]:path:_directories' \
    '--dangerously-skip-permissions[--permission-mode bypassPermissions의 별칭]' \
    '--effort[디스패치된 세션의 기본 노력 수준]:level:(low medium high xhigh max)' \
    '--json[활성 세션을 JSON 배열로 출력하고 종료]' \
    '*--mcp-config[디스패치된 세션에 적용할 MCP 서버 구성]:config:' \
    '--model[에이전트 뷰에서 디스패치된 세션의 기본 모델]:model:_claude_model_names' \
    '--permission-mode[디스패치된 세션의 기본 권한 모드]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[에이전트 뷰 및 디스패치된 세션을 위해 디렉토리에서 플러그인 로드]:path:_directories' \
    '--setting-sources[로드할 설정 소스의 쉼표로 구분된 목록(user, project, local)]:sources:' \
    '--settings[적용할 설정 파일 또는 JSON 문자열]:file-or-json:_files' \
    '--strict-mcp-config[디스패치된 세션에서 --mcp-config의 MCP 서버만 사용]' \
    '--restricted[디스패치된 세션을 제한 모드로 시작]' \
    '(-h --help)'{-h,--help}'[명령 도움말 표시]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Anthropic 계정에 로그인'
    'logout:Anthropic 계정에서 로그아웃'
    'status:인증 상태 표시'
    'help:도움말 표시'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[명령 도움말 표시]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth 명령' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[로그인 페이지에 이메일 주소 미리 채우기]:email:' \
            '--sso[SSO 로그인 흐름 강제]' \
            '(--claudeai)--console[Claude 구독 대신 Anthropic Console(API 사용량 과금) 사용]' \
            '(--console)--claudeai[Claude 구독 사용(기본값)]' \
            '(-h --help)'{-h,--help}'[명령 도움말 표시]'
          ;;
        status)
          _arguments \
            '(--text)--json[JSON으로 출력(기본값)]' \
            '(--json)--text[사람이 읽을 수 있는 텍스트로 출력]' \
            '(-h --help)'{-h,--help}'[명령 도움말 표시]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[명령 도움말 표시]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:유효한 자동 모드 구성을 JSON으로 출력'
    'critique:사용자 정의 자동 모드 규칙에 대한 AI 피드백 받기'
    'defaults:기본 자동 모드 규칙을 JSON으로 출력'
    'reset:자동 모드 구성을 기본 제공 기본값으로 재설정'
    'help:도움말 표시'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[명령 도움말 표시]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode 명령' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[사용할 모델 재정의]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[명령 도움말 표시]'
          ;;
        defaults)
          _arguments \
            '--label[레이블이 이 접두사로 시작하는 규칙만 표시(대소문자 구분 없음)]:prefix:' \
            '(-h --help)'{-h,--help}'[명령 도움말 표시]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[확인 프롬프트 건너뛰기]' \
            '(-h --help)'{-h,--help}'[명령 도움말 표시]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[명령 도움말 표시]'
          ;;
      esac
      ;;
  esac
}

