#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Agordi kaj administri MCP-servilojn'
    'plugin:Administri Claude Code kromaĵojn'
    'agents:Administri fonajn agentojn'
    'attach:Malfermi fonan seancon en ĉi tiu terminalo'
    'logs:Presi la freŝan terminalan eligon de fona seanco'
    'stop:Haltigi fonan seancon (ĝia konversacio estas konservata)'
    'respawn:Restartigi fonan seancon por ke ĝi rulu la nunan version de Claude Code'
    'rm:Forigi fonan seancon, kaj ĝian laborarbon kiam tio estas sekura'
    'remote-control:Regi lokajn seancojn el claude.ai/code aŭ la poŝtelefona aplikaĵo Claude'
    'daemon:Administri la kontrolanton de fonaj seancoj'
    'auth:Administri aŭtentikigon'
    'auto-mode:Inspekti aŭ reagordi la agordon de la aŭtomatreĝima klasigilo'
    'gateway:Ruli la enterprezan aŭtentikigan/telemetrian kluzon'
    'self-hosted-runner:Gastigi Claude Code-nubajn seancojn sur ĉi tiu maŝino aŭ ujo'
    'import:Importi agordon el alia AI-kodada agento en Claude Code'
    'project:Administri Claude Code projekt-staton'
    'purge:Forigi ĉian Claude Code staton por projekto (transskriboj, taskoj, dosier-historio, agord-enigo)'
    'ultrareview:Ruli nube-gastigitan pluragentan kod-revizion kaj presi la trovojn'
    'setup-token:Agordi longdaŭran aŭtentikigan ĵetonon (bezonas Claude-abonon)'
    'doctor:Sankontrolo por Claude Code aŭtomata ĝisdatigilo'
    'update:Kontroli kaj instali ĝisdatigojn'
    'install:Instali Claude Code denaskan kompilitan version'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Ŝalti erarserĉan reĝimon kun opcia kategoria filtrado (ekz., "api,hooks" aŭ "!statsig,!file")]:filter:'
    '--verbose[Anstataŭigi detaleman reĝimon de agorda dosiero]'
    '(-p --print)'{-p,--print}'[Presi respondon kaj eliri (por uzo kun tuboj). Noto: uzu nur en fidindaj dosierujoj]'
    '--output-format[Elir-formato (kun --print): "text" (defaŭlto), "json" (unu rezulto), aŭ "stream-json" (realtempa fluado)]:format:(text json stream-json)'
    '--json-schema[JSON-skemo por struktura elir-validigo]:schema:'
    '--include-partial-messages[Inkluzivi partajn mesaĝ-fragmentojn kiam ili alvenas (kun --print kaj --output-format=stream-json)]'
    '--input-format[Enig-formato (kun --print): "text" (defaŭlto) aŭ "stream-json" (realtempa fluada enigo)]:format:(text stream-json)'
    '--dangerously-skip-permissions[Preterpasi ĉiujn permesajn kontrolojn. Rekomendata nur por sablujeloj sen interreta aliro]'
    '--allow-dangerously-skip-permissions[Ebligi opcion por preterpasi permesajn kontrolojn sen ebligi defaŭlte]'
    '--restricted[Limigita reĝimo: forigi la ilojn kiuj rulas komandojn aŭ kodon kaj WebFetch, ignori user/project/local agordojn, kaj limigi dosier-ilojn al la labor-dosierujoj]'
    '--max-budget-usd[Maksimuma dolar-sumo por elspezi je API-vokoj (--print nur)]:amount:'
    '--max-turns[Limigi la nombron de agentaj vicoj (--print nur)]:turns:'
    '--replay-user-messages[Resendi uzant-mesaĝojn de stdin al stdout por konfirmo]'
    '--allowed-tools[Komo- aŭ spac-apartigita listo de permesitaj ilnomoj (ekz., "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Komo- aŭ spac-apartigita listo de permesitaj ilnomoj (camelCase-formato)]:tools:'
    '--tools[Specifi liston de disponeblaj iloj el enkonstruita aro. Nur presa reĝimo]:tools:'
    '--disallowed-tools[Komo- aŭ spac-apartigita listo de malpermesitaj ilnomoj (ekz., "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Komo- aŭ spac-apartigita listo de malpermesitaj ilnomoj (camelCase-formato)]:tools:'
    '--mcp-config[Ŝargi MCP-servilojn el JSON-dosiero aŭ ĉeno (spac-apartigita)]:configs:'
    '--system-prompt[Sistema invito por uzi en seanco]:prompt:'
    '--system-prompt-file[Legi sisteman inviton el dosiero]:file:_files'
    '--append-system-prompt[Aldoni sisteman inviton al defaŭlta sistema invito]:prompt:'
    '--append-system-prompt-file[Legi sisteman inviton el dosiero kaj aldoni ĝin al la defaŭlta sistema invito]:file:_files'
    '(--append-subagent-system-prompt-file)--append-subagent-system-prompt[Aldoni tekston al la sistema invito de ĉiu subagento (--print nur)]:prompt:'
    '(--append-subagent-system-prompt)--append-subagent-system-prompt-file[Legi tekston el dosiero kaj aldoni ĝin al la sistemaj invitoj de subagentoj (--print nur)]:file:_files'
    '--system-prompt-snapshot[Registri la sisteman inviton unufoje po konversacio kaj reuzi ĝin laŭvorte ĉe ĉiu peto kaj rekomenco (on, la defaŭlto) aŭ generi ĝin freŝe ĉe ĉiu peto (off)]:mode:(on off)'
    '--permission-mode[Permesa reĝimo por uzi en seanco]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Kiu respondas permesajn demandojn kun --print: "host" (la SDK-gastiganto aŭ --permission-prompt-tool) aŭ "none" (ĉio, kio postulus demandon, estas rifuzata)]:target:(host none)'
    '--permission-prompt-tool[MCP-ilo por uzi por permesaj demandoj (--print nur)]:tool:'
    '(-c --continue)'{-c,--continue}'[Daŭrigi la plej freŝan konversacion]'
    '(-r --resume)'{-r,--resume}'[Rekomenci konversacion - specifi seanc-identigilon aŭ elekti interaktive]:sessionId:_claude_sessions'
    '--fork-session[Krei novan seanc-identigilon anstataŭ reuzi originalan seanc-identigilon dum rekomencado (kun --resume aŭ --continue)]'
    '--no-session-persistence[Malŝalti seanc-persiston - seancoj ne estos konservitaj (--print nur)]'
    '--model[Modelo por nuna seanco. Specifi kromnomon por plej freŝa modelo (ekz., '\''sonnet'\'' aŭ '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agento por la nuna seanco. Anstataŭigas la '\''agent'\'' agordon]:agent:_claude_agent_names'
    '--betas[Beta-kapoj por inkluzivi en API-petoj (nur uzantoj de API-ŝlosilo)]:betas:'
    '--fallback-model[Ebligi aŭtomatan retropaŝon al specifita modelo kiam defaŭlta modelo estas tro ŝarĝita (--print nur)]:model:_claude_model_names'
    '--settings[Vojo al agorda JSON-dosiero aŭ JSON-ĉeno por ŝargi pliajn agordojn]:file-or-json:_files'
    '--add-dir[Pliaj dosierujoj por permesi ilan aliron]:directories:_directories'
    '--ide[Aŭtomate konekti al IDE dum startigado se precize unu valida IDE estas disponebla]'
    '--desktop[Malfermi en la Claude Desktop aplikaĵo anstataŭ en la terminalo (kun --continue aŭ --resume <id> por elekti la seancon)]'
    '--strict-mcp-config[Uzi nur MCP-servilojn el --mcp-config kaj ignori ĉiujn aliajn MCP-agordojn]'
    '--session-id[Specifa seanc-identigilo por uzi en konversacio (devas esti valida UUID)]:uuid:'
    '--agents[JSON-objekto difinanta proprajn agentojn]:json:'
    '--advisor[Ŝalti la servil-flankan konsilan ilon (advisor) por ĉi tiu seanco per modela kromnomo aŭ plena modela ID]:model:_claude_model_names'
    '--teammate-mode[Kiel montriĝas la samteamanoj de agenta teamo]:mode:(in-process auto tmux iterm2)'
    '--setting-sources[Komo-apartigita listo de agord-fontoj por ŝargi (user, project, local)]:sources:'
    '--plugin-dir[Dosierujo por ŝargi kromaĵojn nur por ĉi tiu seanco (ripetebla)]:paths:_directories'
    '--disable-slash-commands[Malŝalti ĉiujn oblikvostrekajn komandojn]'
    '(--bg --background)'{--bg,--background}'[Startigi la seancon kiel fonan agenton kaj tuj reveni]'
    '(-w --worktree)'{-w,--worktree}'[Krei novan git-laborarbon por ĉi tiu seanco (opcie specifi nomon)]::name:'
    '--tmux=-[Krei tmux-seancon por la laborarbo (bezonas --worktree). Uzas denaskajn iTerm2-panelojn kiam disponeblaj; --tmux=classic por tradicia tmux]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Agordi montran nomon por ĉi tiu seanco]:name:'
    '--effort[Klopod-nivelo por la nuna seanco]:level:(low medium high xhigh max)'
    '--autocompact[Fenestra grandeco por aŭtomata kompaktigo (auto, aŭ 100k-1M ĵetonoj)]:size:(auto)'
    '--debug-file[Skribi erarserĉajn protokolojn al specifa dosiervojo (implicite ŝaltas erarserĉan reĝimon)]:path:_files'
    '--from-pr[Rekomenci seancon ligitan al PR laŭ numero/URL, aŭ malfermi interaktivan elektilon]::value:'
    '--teleport[Rekomenci teleport-seancon, opcie specifi seanc-identigilon]::session:'
    '(--remote)--cloud[Krei nuban seancon kun la donita priskribo, aŭ aliĝi al ekzistanta per seanc-identigilo aŭ claude.ai/code URL]::description-or-session:'
    '(--cloud)--remote[Malrekomendita kromnomo por --cloud]::description-or-session:'
    '--environment[Krei novan nuban seancon kiu ruliĝas en la donita mem-gastigita medio (ccpool_...)]:environment_id:'
    '--ref[Kun --environment: bazi la elprenon (checkout) de la nova seanco sur nomita ref anstataŭ loka HEAD]:branch:'
    '(--remote-control --rc)'{--remote-control,--rc}'[Startigi interaktivan seancon kun Fora Regado ŝaltita (opcie nomita)]::name:'
    '--remote-control-session-name-prefix[Prefikso por aŭtomate generitaj Fora Regado seanc-nomoj]:prefix:'
    '--chrome[Ŝalti Claude en Chrome integriĝon]'
    '--no-chrome[Malŝalti Claude en Chrome integriĝon]'
    '--plugin-url[Havigi kromaĵan .zip el URL nur por ĉi tiu seanco (ripetebla)]:url:'
    '--file[Dosier-rimedoj por elŝuti dum startigo (formato: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Ŝalti invit-sugestojn (eligas antaŭdiritan sekvan inviton en presa/SDK-reĝimo)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Plusendi subagentan tekston kaj pens-blokojn kiel mesaĝojn (kun --print kaj stream-json)]'
    '--include-hook-events[Inkluzivi ĉiujn hok-vivociklajn eventojn en la elir-fluo (kun stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Movi po-maŝinajn sekciojn en la unuan uzant-mesaĝon por plibonigi invit-kaŝmemoran reuzon]'
    '--brief[Ŝalti SendUserMessage ilon por agent-al-uzanto komunikado]'
    '*--channels[(Esplora antaŭvido) MCP-serviloj kies kanalajn sciigojn aŭskulti (plugin\:<name>@<marketplace>)]:entries:'
    '*--dangerously-load-development-channels[Ŝalti kanalojn ne en la aprobita permeslisto, por loka evoluigo (plugin\:<name>@<marketplace> aŭ server\:<name>)]:entries:'
    '--init[Ruli Setup-hokojn kun la init-kongruigilo antaŭ la seanco (--print nur)]'
    '--init-only[Ruli Setup- kaj SessionStart-hokojn, poste eliri sen komenci konversacion]'
    '--maintenance[Ruli Setup-hokojn kun la maintenance-kongruigilo antaŭ la seanco (--print nur)]'
    '--safe-mode[Startigi kun ĉiuj personigoj malŝaltitaj (utila por problemsolvado de rompita agordo)]'
    '--bare[Minimuma reĝimo: preterlasi hokojn, LSP, kromaĵ-sinkronigon, atribuon, aŭtomatan memoron, kaj CLAUDE.md aŭtomatan malkovron]'
    '--ax-screen-reader[Prezenti ekranleg-amikeman eligon (plata teksto, sen ornamaj randoj aŭ animacioj)]'
    '(-v --version)'{-v,--version}'[Eligi version-numeron]'
    '(-h --help)'{-h,--help}'[Montri helpon por komando]'
  )

  # Stop at the first non-option word, so that the options after a command reach
  # that command's own specs instead of being consumed here
  _arguments -C -A '-*' \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude-komandoj' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin|plugins)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Montri helpon por komando]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        remote-control|rc|remote|sync|bridge)
          _claude_remote_control
          ;;
        daemon)
          _claude_daemon
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        self-hosted-runner)
          _claude_self_hosted_runner
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        purge)
          _claude_purge
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update|upgrade)
          _arguments \
            '(-h --help)'{-h,--help}'[Montri helpon por komando]'
          ;;
        *)
          # Not a command but the prompt: options may still follow it
          _arguments \
            $main_options \
            '*: :'
          ;;
      esac
      ;;
  esac
  local ret=$?

  # The last step, such as listing commands for --r, can fail although options
  # were added before it. Report success then: on failure zsh moves on to the
  # next completers, and _correct or _approximate pile on corrections
  (( compstate[nmatches] > 0 )) || return $ret
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Startigi Claude Code MCP-servilon'
    'add:Aldoni MCP-servilon al Claude Code'
    'remove:Forigi MCP-servilon'
    'list:Listigi agordinitajn MCP-servilojn'
    'get:Akiri MCP-servil-detalojn'
    'add-json:Aldoni MCP-servilon (stdio aŭ SSE) kun JSON-ĉeno'
    'add-from-claude-desktop:Importi MCP-servilojn el Claude Desktop (nur Mac kaj WSL)'
    'reset-project-choices:Reagordi ĉiujn aprobitan/malakceptitan projekt-ampleksan (.mcp.json) servilojn en ĉi tiu projekto'
    'login:Aŭtentikigi kun MCP-servilo (HTTP, SSE, aŭ claude.ai konektilo)'
    'logout:Forviŝi konservitajn OAuth-akreditaĵojn por MCP-servilo'
    'help:Montri helpon'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Montri helpon]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp-komandoj' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Ŝalti erarserĉan reĝimon]' \
            '--verbose[Anstataŭigi detaleman reĝimon de agorda dosiero]' \
            '(-h --help)'{-h,--help}'[Montri helpon]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Agord-amplekso (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Transport-tipo (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Agordi medivariablon (ekz., -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Agordi WebSocket-kapon]:header:' \
            '--client-id[OAuth-klienta identigilo por HTTP/SSE-serviloj]:clientId:' \
            '--client-secret[Demandi pri OAuth-klienta sekreto (aŭ agordi la medivariablon MCP_CLIENT_SECRET)]' \
            '--callback-port[Fiksa pordo por OAuth-revoko (por serviloj kiuj postulas antaŭregistritajn alidirektajn URI-ojn)]:port:' \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Agord-amplekso (local, user, project) - forigi el ekzistanta amplekso se nespecifita]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '1:nomo:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Montri helpon]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '1:nomo:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Agord-amplekso (local, user, project)]:scope:(local user project)' \
            '--client-secret[Demandi pri OAuth-klienta sekreto (aŭ agordi la medivariablon MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Agord-amplekso (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Montri helpon]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Montri helpon]'
          ;;
        login)
          _arguments \
            '--no-browser[Presi la rajtigan URL anstataŭ malfermi retumilon (por SSH/senekranaj seancoj)]' \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '1:nomo:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Validigi kromaĵon aŭ merkat-manifeston'
    'marketplace:Administri Claude Code merkatojn'
    'list:Listigi instalitajn kromaĵojn'
    'details:Montri komponant-inventaron kaj projekciitan ĵeton-koston por kromaĵo'
    'configure:Montri la opciojn de kromaĵo kaj kiuj estas neagorditaj, aŭ konservi valorojn el stdin'
    'install:Instali kromaĵon el disponeblaj merkatoj'
    'i:Instali kromaĵon el disponeblaj merkatoj (mallongigo por install)'
    'init:Skafaldi novan kromaĵon (aŭtomate ŝargiĝas en sekva seanco)'
    'new:Skafaldi novan kromaĵon (kromnomo por init)'
    'uninstall:Malinstali instalitan kromaĵon'
    'remove:Malinstali instalitan kromaĵon (kromnomo por uninstall)'
    'enable:Ŝalti malŝaltitan kromaĵon'
    'disable:Malŝalti ŝaltitan kromaĵon'
    'update:Ĝisdatigi kromaĵon al la plej freŝa versio'
    'eval:Ruli taks-kazojn kontraŭ kromaĵo kaj raporti poentitajn rezultojn'
    'prune:Forigi aŭtomate instalitajn dependecojn kiuj ne plu bezonatas'
    'autoremove:Forigi aŭtomate instalitajn dependecojn kiuj ne plu bezonatas (kromnomo por prune)'
    'tag:Krei {name}--v{version} git-etikedon por kromaĵ-eldono'
    'test:Ruli la testojn de modifaĵo'
    'help:Montri helpon'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Montri helpon]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin-komandoj' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Trakti avertojn kiel erarojn (elir-kodo 1)]' \
            '--profile[Ankaŭ eliri kun elir-kodo 1 kiam la nomita katalogo rifuzus sendon de la kromaĵo pro kontrolo, kiun ĉi tiu komando rulas]:name:(directory)' \
            '--json[Eligi la validigan raporton kiel JSON (samaj elir-kodoj)]' \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '1:vojo:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Instal-amplekso]:scope:(user project local)' \
            '--accept-command[Akcepti la merkat-deklaritan komandon, kies sha256 antaŭa --json-rulo raportis kiel shownCommand.sha256]:sha256:' \
            '*--config[Agordi userConfig-opcion deklaritan en la kromaĵa manifesto (ripetebla)]:key=value:' \
            '--marketplace[Instali la kromaĵon per ĝia nuda nomo el la merkato ĉe ĉi tiu fonto (owner/repo, git- aŭ https-URL, aŭ vojo), aldonante la merkaton unue se necese]:source:' \
            '--registry[Por package@npm-instalo: solvi kaj elŝuti el ĉi tiu npm-registro]:url:' \
            '(-y --yes)'{-y,--yes}'[Akcepti la montritan merkat-deklaritan komandon sen la konfirma demando]' \
            '--json[Presi unu maŝinlegeblan rezult-linion anstataŭ la homa mesaĝo]' \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '1:kromaĵo:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Instal-amplekso]:scope:(user project local)' \
            '--keep-data[Konservi la persistan datum-dosierujon de la kromaĵo]' \
            '--prune[Ankaŭ forigi aŭtomate instalitajn dependecojn kiuj ne plu bezonatas]' \
            '(-y --yes)'{-y,--yes}'[Preterlasi la konfirman demandon de --prune]' \
            '--json[Presi unu maŝinlegeblan rezult-linion anstataŭ la homa mesaĝo (ne kun --prune)]' \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '1:kromaĵo:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Instal-amplekso]:scope:(user project local)' \
            '--json[Presi unu maŝinlegeblan rezult-linion anstataŭ la homa mesaĝo]' \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '1:kromaĵo:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Malŝalti ĉiujn ŝaltitajn kromaĵojn]' \
            '(-s --scope)'{-s,--scope}'[Instal-amplekso]:scope:(user project local)' \
            '--json[Presi unu maŝinlegeblan rezult-linion anstataŭ la homa mesaĝo]' \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '--accept-command[Akcepti la merkat-deklaritan komandon, kies sha256 antaŭa --json-rulo raportis kiel shownCommand.sha256]:sha256:' \
            '(-s --scope)'{-s,--scope}'[Instal-amplekso]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Akcepti la montritan merkat-deklaritan komandon sen la konfirma demando]' \
            '--json[Presi unu maŝinlegeblan rezult-linion anstataŭ la homa mesaĝo]' \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '1:kromaĵo:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Eligi kiel JSON]' \
            '--available[Inkluzivi disponeblajn kromaĵojn el merkatoj (bezonas --json)]' \
            '--data-size[Mezuri la konservitan datumdosierujon de ĉiu instalita kromaĵo, aŭ nur de la nomita kromaĵo (bezonas --json)]::plugin:_claude_installed_plugins' \
            '(-h --help)'{-h,--help}'[Montri helpon]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Purigi en amplekso]:scope:(user project local)' \
            '--dry-run[Listigi kio estus forigita sen forigi]' \
            '(-y --yes)'{-y,--yes}'[Preterlasi la konfirman demandon]' \
            '(-h --help)'{-h,--help}'[Montri helpon]'
          ;;
        configure)
          _arguments \
            '--json[Eligi kiel JSON]' \
            '--values-stdin[Legi opci-valorojn el stdin kiel JSON-objekton de unuliniaj ĉenoj; preterlasitaj opcioj konservas siajn valorojn]' \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '1:kromaĵo:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Manifesta priskribo]:text:' \
            '--author[Aŭtora nomo (defaŭlto: git config user.name)]:name:' \
            '--author-email[Aŭtora retpoŝtadreso (defaŭlto: git config user.email)]:email:' \
            '--with[Komponantoj por skafaldi ankaŭ]:components:' \
            '(-f --force)'{-f,--force}'[Anstataŭigi ekzistantan .claude-plugin/ ĉe la celo]' \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '1:nomo:'
          ;;
        eval)
          if [[ $words[2] == init ]]; then
            _arguments \
              '--bare[Skribi malplenan ŝablonon anstataŭ ruli la intervjuon]' \
              '--eval-dir[Dosierujo sub la nuna dosierujo, en kiun skribi kazojn]:dir:_directories' \
              '(-i --interactive)'{-i,--interactive}'[Ruli la aŭtoran intervjuon (bezonas interagan terminalon)]' \
              '(-h --help)'{-h,--help}'[Montri helpon]' \
              '::name:'
            return
          fi
          _arguments \
            '--case[Filtri kazojn laŭ nom-globŝablono]:glob:' \
            '*--tag[Filtri kazojn laŭ etikedo (ripetebla)]:tag:' \
            '--runs[Anstataŭigi la nombron de rulaĵoj po kazo (defaŭlto: case.runs, alie 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Ruli ĝis n agent-rulaĵojn samtempe (1-8; defaŭlto 1)]:n:' \
            '--model[Anstataŭigi modelon por ĉiuj kazoj]:model:_claude_model_names' \
            '--judge-model[Anstataŭigi la modelon de la LLM-taksanto (defaŭlto: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Strikta kosto-plafono; ĉesigi kaj raporti partajn rezultojn se atingita (elir-kodo 2)]:usd:' \
            '--output-dir[Dosierujo por aggregate-result.json]:dir:_directories' \
            '--eval-dir[Dosierujo-nomo (sub la kromaĵo) kiu enhavas la taks-kazojn]:dir:' \
            '--json[Presi la plenan rulrezulton kiel JSON al stdout, aŭ skribi ĝin al ĉi tiu .json-dosiero]::path:_files' \
            '--threshold[Eliri kun elir-kodo 1 se iu kaz-poentaro estas sub ĉi tiu sojlo (defaŭlto: 1.0)]:threshold:' \
            '*--allow-tools[Operatora permeso por baritaj iloj (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '*--disallow-tools[Enkonstruitaj iloj, kiujn Claude neniam ricevu, eĉ se permesitaj]:tools:' \
            '(--no-scaffold)--scaffold[Ruli la scaffold_script de ĉiu kazo (rulas aŭtor-liveritan bash en via nomo; defaŭlte malŝaltita)]' \
            '(--scaffold)--no-scaffold[Eksplicite preterlasi scaffold_script]' \
            '--trust-plugin[Aserti ke vi fidas ĉi tiun kromaĵon kaj ĝian taks-aron, preterlasante la unuarulan fido-demandon (por CI)]' \
            '--ablation[Ruli senkromaĵan bazlinian kontrolgrupon kaj raporti la poentar-diferencon]:mode:(none with-without)' \
            '--mocks[Imitaĵaj anstataŭantoj por MCP-serviloj, el <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Kun --mocks record: ankaŭ startigi la verajn MCP-servilajn procezojn kiuj ne havas imitaĵon]' \
            '--keep-temp[Konservi skafald-dosierujojn por erarserĉado]' \
            '--verbose[Protokoli po-mesaĝajn spur-eventojn en la erarserĉan protokolon]' \
            '--report[Skribi la memstaran HTML-raporton al ĉi tiu vojo anstataŭ al la rezult-dosierujo]:path:_files' \
            '(--no-publish)--publish-report[Ankaŭ postuli publikigon de la raporto al claude.ai]' \
            '(--publish-report)--no-publish[Teni la HTML-raporton nur loke; preterlasi ĝian publikigon al claude.ai]' \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '::target: _alternative "commands\:eval command\:(init)" "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Puŝi la etikedon al --remote post ĝia kreado]' \
            '--dry-run[Presi kio estus etikedita sen krei ĝin]' \
            '(-f --force)'{-f,--force}'[Preterlasi la kontrolojn pri malpura labor-arbo kaj jam ekzistanta etikedo]' \
            '(-m --message)'{-m,--message}'[Etiked-komenta mesaĝo (uzu %s por la versio)]:msg:' \
            '--remote[Fora deponejo al kiu puŝi kun --push]:name:' \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Aldoni merkaton el URL, vojo, aŭ GitHub-deponejo'
    'list:Listigi agordinitajn merkatojn'
    'remove:Forigi agordinitan merkaton'
    'rm:Forigi agordinitan merkaton (kromnomo por remove)'
    'update:Ĝisdatigi merkaton el fonto - ĝisdatigi ĉion se neniu nomo specifita'
    'help:Montri helpon'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Montri helpon]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace-komandoj' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Limigi elprenon al specifaj dosierujoj per git sparse-checkout (por monodeponejoj)]:paths:' \
            '--scope[Kie deklari la merkaton]:scope:(user project local)' \
            '--json[Presi unu maŝinlegeblan rezultlinion kiel la lastan linion en stdout]' \
            '--claudeai[Aldoni la merkaton kun ĉi tiu nomo, kiun claude.ai gastigas por vi]' \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '1:fonto:'
          ;;
        list)
          _arguments \
            '--json[Eligi kiel JSON]' \
            '(-h --help)'{-h,--help}'[Montri helpon]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Forigi la merkat-deklaron el specifa agord-amplekso (preterlasi por forigi ĝin el ĉiu amplekso)]:scope:(user project local)' \
            '--json[Presi unu maŝinlegeblan rezultlinion kiel la lastan linion en stdout]' \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '1:nomo:'
          ;;
        update)
          _arguments \
            '--json[Kun merkatnomo: presi unu maŝinlegeblan rezultlinion kiel la lastan linion en stdout]' \
            '(-h --help)'{-h,--help}'[Montri helpon]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Devigi instalon eĉ se jam instalita]' \
    '(-h --help)'{-h,--help}'[Montri helpon]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Aldona dosierujo por permesi ilan aliron en senditaj seancoj]:directory:_directories' \
    '--agent[Defaŭlta agento por seancoj senditaj el agent-vido]:agent:_claude_agent_names' \
    '--all[Kun --json: ankaŭ inkluzivi finitajn fonajn seancojn]' \
    '--allow-dangerously-skip-permissions[Disponebligi preterpas-permesan reĝimon al senditaj seancoj]' \
    '--cwd[Montri nur fonajn seancojn startigitajn sub vojo]:path:_directories' \
    '--dangerously-skip-permissions[Kromnomo por --permission-mode bypassPermissions]' \
    '--effort[Defaŭlta klopod-nivelo por senditaj seancoj]:level:(low medium high xhigh max)' \
    '--json[Presi aktivajn seancojn kiel JSON-tabelon kaj eliri]' \
    '*--mcp-config[MCP-servila agordo por apliki al senditaj seancoj]:config:' \
    '--model[Defaŭlta modelo por seancoj senditaj el agent-vido]:model:_claude_model_names' \
    '--permission-mode[Defaŭlta permesa reĝimo por senditaj seancoj]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Ŝargi kromaĵojn el dosierujo por la agent-vido kaj senditaj seancoj]:path:_directories' \
    '--setting-sources[Komo-apartigita listo de agord-fontoj por ŝargi (user, project, local)]:sources:' \
    '--settings[Agorda dosiero aŭ JSON-ĉeno por apliki]:file-or-json:_files' \
    '--strict-mcp-config[Uzi nur MCP-servilojn el --mcp-config en senditaj seancoj]' \
    '--restricted[Startigi senditajn seancojn en limigita reĝimo]' \
    '(-h --help)'{-h,--help}'[Montri helpon por komando]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Ensaluti al via Anthropic-konto'
    'logout:Elsaluti el via Anthropic-konto'
    'status:Montri aŭtentikig-staton'
    'help:Montri helpon'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Montri helpon por komando]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth-komandoj' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Antaŭplenigi retpoŝtadreson sur la ensaluta paĝo]:email:' \
            '--sso[Devigi SSO-ensalutan fluon]' \
            '(--claudeai)--console[Uzi Anthropic Console (fakturado laŭ API-uzo) anstataŭ Claude-abono]' \
            '(--console)--claudeai[Uzi Claude-abonon (defaŭlto)]' \
            '(-h --help)'{-h,--help}'[Montri helpon por komando]'
          ;;
        status)
          _arguments \
            '(--text)--json[Eligi kiel JSON (defaŭlto)]' \
            '(--json)--text[Eligi kiel homlegeblan tekston]' \
            '(-h --help)'{-h,--help}'[Montri helpon por komando]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Montri helpon por komando]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Presi la efektivan aŭtomatreĝiman agordon kiel JSON'
    'critique:Akiri AI-reagon pri viaj propraj aŭtomatreĝimaj reguloj'
    'defaults:Presi la defaŭltajn aŭtomatreĝimajn regulojn kiel JSON'
    'reset:Reagordi aŭtomatreĝiman agordon al la liveritaj defaŭltoj'
    'help:Montri helpon'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Montri helpon por komando]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode-komandoj' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Anstataŭigi kiu modelo estas uzata]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Montri helpon por komando]'
          ;;
        defaults)
          _arguments \
            '--label[Montri nur regulojn kies etikedo komenciĝas per ĉi tiu prefikso (usklecoblinde)]:prefix:' \
            '(-h --help)'{-h,--help}'[Montri helpon por komando]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Preterlasi la konfirman demandon]' \
            '(-h --help)'{-h,--help}'[Montri helpon por komando]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Montri helpon por komando]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Vojo al kluza YAML-agordo]:path:_files' \
    '(-h --help)'{-h,--help}'[Montri helpon por komando]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Forigi ĉian Claude Code staton por projekto (transskriboj, taskoj, dosier-historio, agord-enigo)'
    'help:Montri helpon'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Montri helpon por komando]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project-komandoj' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Listigi kio estus forigita sen forigi ion ajn]' \
            '(-y --yes)'{-y,--yes}'[Preterlasi la konfirman demandon]' \
            '(-i --interactive)'{-i,--interactive}'[Demandi pri ĉiu ero antaŭ forigo]' \
            '(1)--all[Forviŝi staton por ĉiu projekto (reciproke ekskluziva kun vojo)]' \
            '(-h --help)'{-h,--help}'[Montri helpon por komando]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_purge() {
  _arguments \
    '--dry-run[Listigi kio estus forigita sen forigi ion ajn]' \
    '(-y --yes)'{-y,--yes}'[Preterlasi la konfirman demandon]' \
    '(-i --interactive)'{-i,--interactive}'[Demandi pri ĉiu ero antaŭ forigo]' \
    '(1)--all[Forviŝi staton por ĉiu projekto (reciproke ekskluziva kun vojo)]' \
    '(-h --help)'{-h,--help}'[Montri helpon por komando]' \
    '(--all)::path:_directories'
}

_claude_ultrareview() {
  _arguments \
    '--json[Presi la krudan bugs.json ŝarĝon anstataŭ formatitaj trovoj]' \
    '--timeout[Maksimumaj minutoj por atendi ke la revizio finiĝu (defaŭlto: 45)]:minutes:' \
    '(--no-post)--post[Afiŝi la trovojn de la finita revizio al la PR en via nomo (nur PR-celoj; unu simpla komento, ne revizio)]' \
    '(--post)--no-post[Ne afiŝi la trovojn al la PR (la defaŭlto)]' \
    '--trust-workspace[Fidi la nunan dosierujon nur por ĉi tiu rulo, sen demandi (por skriptoj kaj CI)]' \
    '(-h --help)'{-h,--help}'[Montri helpon por komando]' \
    '1:celo:'
}

