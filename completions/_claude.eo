_claude_self_hosted_runner() {
  _arguments \
    '--api-url[API-baza URL (defaŭlto: https://api.anthropic.com)]:url:' \
    '--environment-secret-file[Vojo al la sekreta dosiero de la medio]:path:_files' \
    '--lock-to-account[Ligi la rulilon (runner) al unu sola konto ĉe registriĝo]:id:' \
    '--client-label[Observebleca etikedo sendata ĉe registriĝo (defaŭlto: hostname)]:label:' \
    '(--proxy-authorization-file --agent-proxy-url)--proxy-authorization-command[Komando kies stdout estas la Proxy-Authorization-kapo por elirantaj prokuriloj]:shell command:' \
    '(--proxy-authorization-command --agent-proxy-url)--proxy-authorization-file[Dosiero kun la Proxy-Authorization-kapo por elirantaj prokuriloj]:path:_files' \
    '(--proxy-authorization-command --proxy-authorization-file)--agent-proxy-url[Direkti ĉiun seancon tra la agenta prokurilo ĉe ĉi tiu URL (nur https)]:url:' \
    '--capacity[Maksimumaj samtempaj seancoj (defaŭlto: 1)]:n:' \
    '--base-dir[Baza dosierujo por deponejaj elprenoj (defaŭlto: /workspace)]:path:_directories' \
    '--exec-path[Duuma dosiero lanĉota por idaj seancoj (defaŭlto: ĉi tiu duuma dosiero)]:path:_files' \
    '--hooks-dir[Dosierujo de vivociklaj hok-skriptoj (checkout, command, post-session)]:path:_directories' \
    '--session-stop-grace-sec[Kiom longe atendi puran eliron post kiam seanco finiĝas (defaŭlto: 5)]:n:' \
    '--post-session-hook-timeout-sec[SIGTERM-tempobuĝeto por la post-session-hoko (defaŭlto: 60)]:n:' \
    '--checkout-hook-timeout-min[Realtempa buĝeto por ĉiu rulo de la checkout-hoko (defaŭlto: 30; 0 malŝaltas)]:n:' \
    '--drain-wait-sec[Ĉe SIGTERM/SIGINT, atendi ĝis N sekundojn por laboro en progreso (defaŭlto: 0)]:n:' \
    '--drain-marker-file[Marka dosiero per kiu la gastiganto anoncas glatan malplenigon]:path:_files' \
    '*--git-ssh-rewrite[Reskribi fontajn URL-ojn https://<host>/... al git@<host>:... (ripetebla)]:host:' \
    '*--git-host-rewrite[Reskribi fontajn URL-ojn https://<f>/... al https://<t>/... (ripetebla)]:from=to:' \
    '--use-anthropic-git-proxy[Uzi git administratan de Anthropic. AVERTO: forigas kaj anstataŭigas la HOME-nivelan git-agordon, uzu nur sub dediĉita konto]' \
    '--configure-git[Agordi la ĉiean git-identecon kaj ŝalti commit-subskribadon per la subskriba servo de Anthropic. Skribas ~/.gitconfig]' \
    '--push-outcome-on-release[Puŝi spuratajn rezult-branĉojn kiam seanco finiĝas nekompleta pro iniciato de la rulilo]' \
    '--trust-workspace[Antaŭplenigi konservitan fidon por la deponejaj vojoj de ĉiu seanco (defaŭlto: true)]::bool:(true false)' \
    '--remove-session-state[Forigi po-seancan staton kiam seanco finiĝas (defaŭlto: false)]::bool:(true false)' \
    '--diff-finds-nested-repository[Montri deponejon klonitan en subdosierujon en la Changes-panelo; bezonas --capacity 1 (defaŭlto: false)]::bool:(true false)' \
    '--confine-repo-settings[Reĝimo de la limiga gardisto por agordoj enmetitaj en la deponejon (defaŭlto: warn)]:mode:(warn enforce off)' \
    '--server-auto-mode-lists[Kiujn listojn de la aŭtomatreĝima klasigilo el la servilo seanco rajtas ricevi (defaŭlto: no-allow)]:mode:(all no-allow none)' \
    '--host-config-snapshot[Kie la startiga momentfoto de la gastiganta agordo estas tenata (defaŭlto: disk)]:mode:(disk memory)' \
    '--health-port[Pordo por la /healthz-HTTP-aŭskultilo (defaŭlto: 8080; 0 malŝaltas)]:port:' \
    '--log-level[Protokola nivelo (defaŭlto: info)]:level:(info debug)' \
    '--log-file[Ankaŭ skribi la protokolojn de la rulilo al dosiero en aldona reĝimo (kiel tee)]:path:_files' \
    '--exit-if-unused-min[Ĉesigi la rulilon se ĝi ricevas neniun laboron dum N minutoj]:n:' \
    '--drain-grace-sec[Sekundoj por plu demandi pri laboro post kiam aktivaj seancoj finiĝas (defaŭlto: 0)]:n:' \
    '--retire-at[Emeritigi la rulilon je ĉi tiu absoluta Unix-tempo, en sekundoj]:epoch-seconds:' \
    '--defer-shutdown-max-min[Ĉe la unua SIGTERM/SIGINT, ĉesi preni laboron kaj fini la malŝalton M minutojn poste (defaŭlto: 0)]:m:' \
    '--release-idle-session-min[Liberigi seancan lokon post N minutoj sen uzanta enigo]:n:' \
    '--startup-timeout-min[Liberigi seancan lokon se la ida procezo ne finis startiĝi post N minutoj (defaŭlto: 15; 0 malŝaltas)]:n:' \
    '--kill-session-after-min[Limigi la realtempan vivdaŭron de seanca ida procezo al N minutoj]:n:' \
    '--debug-token-dir[NUR POR ERARSERĈADO: skribas vivajn ĵetonojn al disko. Ne uzu en produktado]:path:_directories' \
    '(-h --help)'{-h,--help}'[Montri ĉi tiun helpmesaĝon]'
}

_claude_remote_control() {
  _arguments \
    '--name[Nomo por la seanco (montrata en claude.ai/code)]:name:' \
    '--remote-control-session-name-prefix[Prefikso por aŭtomate generitaj seanc-nomoj (defaŭlto: hostname)]:prefix:' \
    '(-c --continue --session-id)'{-c,--continue}'[Rekonekti al la seanco laste registrita por ĉi tiu dosierujo aŭ unu el ĝiaj git-laborarboj]' \
    '(-c --continue --session-id)--session-id[Rekonekti al specifa seanco per ID]:id:' \
    '--permission-mode[Permesa reĝimo por lanĉitaj seancoj]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)' \
    '(--no-chrome)--chrome[Ŝalti Claude in Chrome por lanĉitaj seancoj]' \
    '(--chrome)--no-chrome[Malŝalti Claude in Chrome por lanĉitaj seancoj]' \
    '(-d --debug)'{-d,--debug}'[Ŝalti erarserĉan reĝimon kun nedeviga kategori-filtrado]::filter:' \
    '--debug-file[Skribi erarserĉajn protokolojn al dosiero]:path:_files' \
    '(-v --verbose)'{-v,--verbose}'[Ŝalti detaleman eligon]' \
    '--spawn[Lanĉa reĝimo (defaŭlto: same-dir)]:mode:(same-dir worktree session)' \
    '--capacity[Maksimumaj samtempaj seancoj en worktree- aŭ same-dir-reĝimo (defaŭlto: 32)]:n:' \
    '(--no-create-session-in-dir)--create-session-in-dir[Antaŭkrei seancon en la nuna dosierujo (defaŭlto)]' \
    '(--create-session-in-dir)--no-create-session-in-dir[Ne antaŭkrei seancon en la nuna dosierujo]' \
    '(-h --help)'{-h,--help}'[Montri ĉi tiun helpon]'
}

_claude_daemon() {
  local -a daemon_commands common_options
  daemon_commands=(
    'run:Ruli la kontrolanton en la malfono'
    'status:Montri pid, version kaj funkcidaŭron de la demono'
    'logs:Sekvi la protokolon de la demono (Ctrl-C por ĉesi)'
    'uninstall:Forigi la fonan servon (launchctl/systemd)'
    'stop:Malŝalti la kontrolanton kaj fini fonajn seancojn'
  )
  common_options=(
    '--json-path[Agorda dosiero (defaŭlto: ~/.claude/daemon.json)]:path:_files'
    '--log-file[Protokola dosiero (defaŭlto: ~/.claude/daemon.log)]:path:_files'
    '(-h --help)'{-h,--help}'[Montri ĉi tiun helpon]'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    $common_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'daemon-komandoj' daemon_commands
      ;;
    args)
      case $words[1] in
        run)
          _arguments \
            $common_options \
            '::json-path:_files'
          ;;
        stop)
          _arguments \
            $common_options \
            '--any[Ankaŭ haltigi provizoran demonon (ne servon)]' \
            '--keep-workers[Lasi malkonektitajn seancojn funkcii]'
          ;;
        status|logs|uninstall)
          _arguments \
            $common_options
          ;;
      esac
      ;;
  esac
}

_claude_import() {
  _arguments \
    '--dry-run[Montri kio estus importita sen skribi ion ajn]' \
    '--yes[Preterlasi la interaktivan elektilon (ĉe senekranaj medioj, transdoni --yes=<digest> el la /import antaŭrigardo)]' \
    '(-h --help)'{-h,--help}'[Montri helpon por komando]' \
    '::source:(codex gemini cursor)'
}

# compinit autoloads this file, and that first call only defines the functions
# above: complete right away so the first TAB already works. Sourced directly,
# there is nothing to complete yet, only the registration.
if [[ $funcstack[1] == _claude ]]; then
  _claude "$@"
else
  (( $+_comps[claude] )) || compdef _claude claude
fi
