    '--force-remove-worktree[Forigi la laborarban dosierujon eĉ se la WorktreeRemove-hoko aŭ git ne povis forigi ĝin (transdoni la worktree-id, kiun antaŭa claude rm raportis)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Montri helpon por komando]' \
