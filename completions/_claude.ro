#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Configurare și gestionare servere MCP'
    'plugin:Gestionare plugin-uri Claude Code'
    'agents:Gestionare agenți în fundal'
    'attach:Deschidere sesiune în fundal în acest terminal'
    'logs:Afișare ieșire recentă din terminal a unei sesiuni în fundal'
    'stop:Oprire sesiune în fundal (conversația sa este păstrată)'
    'respawn:Repornire sesiune în fundal pentru a rula versiunea curentă Claude Code'
    'rm:Ștergere sesiune în fundal și a worktree-ului său când acest lucru este sigur'
    'auth:Gestionare autentificare'
    'auto-mode:Inspectare sau resetare configurație clasificator mod automat'
    'gateway:Rulare gateway enterprise de autentificare/telemetrie'
    'import:Importare configurație din alt agent AI de programare în Claude Code'
    'project:Gestionare stare proiect Claude Code'
    'ultrareview:Rulare revizuire de cod multi-agent găzduită în cloud și afișare rezultate'
    'setup-token:Configurare token de autentificare pe termen lung (necesită abonament Claude)'
    'doctor:Verificare stare pentru actualizatorul automat Claude Code'
    'update:Verificare și instalare actualizări'
    'install:Instalare build nativ Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Activare mod depanare cu filtrare opțională pe categorie (ex: "api,hooks" sau "!statsig,!file")]:filter:'
    '--verbose[Suprascrie setarea modului detaliat din fișierul de configurare]'
    '(-p --print)'{-p,--print}'[Afișare răspuns și ieșire (pentru utilizare cu pipe-uri). Notă: utilizați doar în directoare de încredere]'
    '--output-format[Format ieșire (cu --print): "text" (implicit), "json" (rezultat unic), sau "stream-json" (streaming în timp real)]:format:(text json stream-json)'
    '--json-schema[Schemă JSON pentru validare ieșire structurată]:schema:'
    '--include-partial-messages[Include fragmente de mesaje parțiale pe măsură ce sosesc (cu --print și --output-format=stream-json)]'
    '--input-format[Format intrare (cu --print): "text" (implicit) sau "stream-json" (intrare streaming în timp real)]:format:(text stream-json)'
    '--mcp-debug[\[Depreciat. Folosiți --debug în schimb\] Activare mod depanare MCP (afișează erori server MCP)]'
    '--dangerously-skip-permissions[Ocolire toate verificările de permisiuni. Recomandat doar pentru sandbox-uri fără acces la internet]'
    '--allow-dangerously-skip-permissions[Activare opțiune de ocolire a verificărilor de permisiuni fără activare implicită]'
    '--restricted[Mod restricționat: eliminare unelte care rulează comenzi sau cod și WebFetch, ignorare setări user/project/local și limitare unelte de fișiere la directoarele de lucru]'
    '--max-budget-usd[Suma maximă în dolari de cheltuit pe apeluri API (doar --print)]:amount:'
    '--replay-user-messages[Retrimiteri mesaje utilizator de la stdin pe stdout pentru confirmare]'
    '--allowed-tools[Listă separată prin virgule sau spații de nume de unelte permise (ex: "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Listă separată prin virgule sau spații de nume de unelte permise (format camelCase)]:tools:'
    '--tools[Specificare listă de unelte disponibile din setul integrat. Doar mod afișare]:tools:'
    '--disallowed-tools[Listă separată prin virgule sau spații de nume de unelte interzise (ex: "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Listă separată prin virgule sau spații de nume de unelte interzise (format camelCase)]:tools:'
    '--mcp-config[Încărcare servere MCP din fișier JSON sau șir (separate prin spații)]:configs:'
    '--system-prompt[Prompt sistem de utilizat pentru sesiune]:prompt:'
    '--system-prompt-file[Citire prompt sistem dintr-un fișier]:file:_files'
    '--append-system-prompt[Adăugare prompt sistem la promptul sistem implicit]:prompt:'
    '--append-system-prompt-file[Citire prompt sistem dintr-un fișier și adăugare la promptul sistem implicit]:file:_files'
    '--system-prompt-snapshot[Înregistrare prompt sistem o singură dată per conversație și reutilizare identică la fiecare cerere și reluare (on, implicit) sau randare nouă la fiecare cerere (off)]:mode:(on off)'
    '--permission-mode[Mod permisiuni de utilizat pentru sesiune]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Cine răspunde la solicitările de permisiune cu --print: "host" (gazda SDK sau --permission-prompt-tool) sau "none" (orice ar necesita o solicitare este refuzat)]:target:(host none)'
    '--permission-prompt-tool[Unealtă MCP de utilizat pentru solicitările de permisiune (doar --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Continuare conversația cea mai recentă]'
    '(-r --resume)'{-r,--resume}'[Reluare conversație - specificați ID sesiune sau selectați interactiv]:sessionId:_claude_sessions'
    '--fork-session[Creare ID sesiune nou în loc de reutilizare ID sesiune original la reluare (cu --resume sau --continue)]'
    '--no-session-persistence[Dezactivare persistență sesiune - sesiunile nu vor fi salvate (doar --print)]'
    '--model[Model pentru sesiunea curentă. Specificați alias pentru modelul cel mai recent (ex: '\''sonnet'\'' sau '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agent pentru sesiunea curentă. Suprascrie setarea '\''agent'\'']:agent:_claude_agent_names'
    '--betas[Antete beta de inclus în cererile API (doar utilizatori cu cheie API)]:betas:'
    '--fallback-model[Activare fallback automat la modelul specificat când modelul implicit este supraîncărcat (doar --print)]:model:_claude_model_names'
    '--settings[Cale către fișier JSON de setări sau șir JSON pentru încărcare setări adiționale]:file-or-json:_files'
    '--add-dir[Directoare adiționale pentru permiteți accesul uneltelor]:directories:_directories'
    '--ide[Conectare automată la IDE la pornire dacă exact un IDE valid este disponibil]'
    '--desktop[Deschidere în aplicația Claude Desktop în loc de terminal (cu --continue sau --resume <id> pentru alegerea sesiunii)]'
    '--strict-mcp-config[Utilizare doar servere MCP din --mcp-config și ignorare toate celelalte setări MCP]'
    '--session-id[ID sesiune specific de utilizat pentru conversație (trebuie să fie UUID valid)]:uuid:'
    '--agents[Obiect JSON definind agenți personalizați]:json:'
    '--setting-sources[Listă separată prin virgule de surse de setări de încărcat (user, project, local)]:sources:'
    '--plugin-dir[Director pentru încărcare plugin-uri doar pentru această sesiune (repetabil)]:paths:_directories'
    '--disable-slash-commands[Dezactivare toate comenzile slash]'
    '(--bg --background)'{--bg,--background}'[Pornire sesiune ca agent în fundal și revenire imediată]'
    '(-w --worktree)'{-w,--worktree}'[Creare worktree git nou pentru această sesiune (opțional specificați un nume)]::name:'
    '--tmux=-[Creare sesiune tmux pentru worktree (necesită --worktree). Utilizează panouri native iTerm2 când sunt disponibile; --tmux=classic pentru tmux tradițional]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Setare nume afișat pentru această sesiune]:name:'
    '--effort[Nivel de efort pentru sesiunea curentă]:level:(low medium high xhigh max)'
    '--autocompact[Dimensiune fereastră auto-compactare (auto, sau 100k-1M token-uri)]:size:(auto)'
    '--debug-file[Scriere jurnale de depanare într-o cale de fișier specifică (activează implicit modul depanare)]:path:_files'
    '--from-pr[Reluare sesiune legată de un PR după număr/URL, sau deschidere selector interactiv]::value:'
    '--teleport[Reluare sesiune teleport, opțional specificați ID sesiune]::session:'
    '--cloud[Creare sesiune cloud cu descrierea dată sau atașare la una existentă după ID sesiune sau URL claude.ai/code]::description-or-session:'
    '--environment[Creare sesiune cloud nouă care rulează în mediul auto-găzduit specificat (ccpool_...)]:environment_id:'
    '--remote-control[Pornire sesiune interactivă cu Remote Control activat (opțional denumită)]::name:'
    '--remote-control-session-name-prefix[Prefix pentru numele de sesiune Remote Control generate automat]:prefix:'
    '--chrome[Activare integrare Claude în Chrome]'
    '--no-chrome[Dezactivare integrare Claude în Chrome]'
    '--plugin-url[Preluare .zip de plugin dintr-un URL doar pentru această sesiune (repetabil)]:url:'
    '--file[Resurse fișier de descărcat la pornire (format: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Activare sugestii de prompt (emite un prompt următor prezis în modul print/SDK)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Redirecționare text subagent și blocuri de gândire ca mesaje (cu --print și stream-json)]'
    '--include-hook-events[Includere toate evenimentele din ciclul de viață al hook-urilor în fluxul de ieșire (cu stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Mutare secțiuni per-mașină în primul mesaj utilizator pentru a îmbunătăți reutilizarea cache-ului de prompt]'
    '--brief[Activare unealtă SendUserMessage pentru comunicare agent-către-utilizator]'
    '--safe-mode[Pornire cu toate personalizările dezactivate (util pentru depanarea unei configurații defecte)]'
    '--bare[Mod minimal: omite hook-uri, LSP, sincronizare plugin-uri, atribuire, auto-memorie și descoperirea automată CLAUDE.md]'
    '--ax-screen-reader[Randare ieșire prietenoasă cu cititoarele de ecran (text plat, fără borduri decorative sau animații)]'
    '(-v --version)'{-v,--version}'[Afișare număr versiune]'
    '(-h --help)'{-h,--help}'[Afișare ajutor pentru comandă]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comenzi claude' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Afișare ajutor pentru comandă]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "fără argumente"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Pornire server MCP Claude Code'
    'add:Adăugare server MCP la Claude Code'
    'remove:Eliminare server MCP'
    'list:Listare servere MCP configurate'
    'get:Obținere detalii server MCP'
    'add-json:Adăugare server MCP (stdio sau SSE) cu șir JSON'
    'add-from-claude-desktop:Importare servere MCP din Claude Desktop (doar Mac și WSL)'
    'reset-project-choices:Resetare toate serverele cu domeniu de proiect (.mcp.json) aprobate/respinse în acest proiect'
    'login:Autentificare cu un server MCP (HTTP, SSE sau conector claude.ai)'
    'logout:Ștergere credențiale OAuth stocate pentru un server MCP'
    'help:Afișare ajutor'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Afișare ajutor]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comenzi mcp' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Activare mod depanare]' \
            '--verbose[Suprascrie setarea modului detaliat din fișierul de configurare]' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Domeniu configurare (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Tip transport (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Setare variabilă de mediu (ex: -e CHEIE=valoare)]:env:' \
            '(-H --header)'{-H,--header}'[Setare antet WebSocket]:header:' \
            '--client-id[ID client OAuth pentru servere HTTP/SSE]:clientId:' \
            '--client-secret[Solicitare secret client OAuth (sau setați variabila de mediu MCP_CLIENT_SECRET)]' \
            '--callback-port[Port fix pentru callback OAuth (pentru servere care necesită URI-uri de redirecționare preînregistrate)]:port:' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Domeniu configurare (local, user, project) - eliminare din domeniu existent dacă nespecificat]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Afișare ajutor]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Domeniu configurare (local, user, project)]:scope:(local user project)' \
            '--client-secret[Solicitare secret client OAuth (sau setați variabila de mediu MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Domeniu configurare (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Afișare ajutor]'
          ;;
        login)
          _arguments \
            '--no-browser[Afișare URL de autorizare în loc de deschiderea unui browser (pentru sesiuni SSH/fără interfață grafică)]' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Validare plugin sau manifest marketplace'
    'marketplace:Gestionare marketplace-uri Claude Code'
    'list:Listare plugin-uri instalate'
    'details:Afișare inventar componente și cost estimat de token-uri pentru un plugin'
    'configure:Afișare opțiuni ale unui plugin și care sunt nesetate, sau salvare valori din stdin'
    'install:Instalare plugin din marketplace-urile disponibile'
    'i:Instalare plugin din marketplace-urile disponibile (formă scurtă pentru install)'
    'init:Schelet plugin nou (se încarcă automat în sesiunea următoare)'
    'new:Schelet plugin nou (alias pentru init)'
    'uninstall:Dezinstalare plugin instalat'
    'remove:Dezinstalare plugin instalat (alias pentru uninstall)'
    'enable:Activare plugin dezactivat'
    'disable:Dezactivare plugin activat'
    'update:Actualizare plugin la cea mai recentă versiune'
    'eval:Rulare cazuri de evaluare pe un plugin și raportare rezultate punctate'
    'prune:Eliminare dependențe instalate automat care nu mai sunt necesare'
    'autoremove:Eliminare dependențe instalate automat care nu mai sunt necesare (alias pentru prune)'
    'tag:Creare etichetă git {name}--v{version} pentru o lansare de plugin'
    'test:Rulare teste ale unui mod (extensie)'
    'help:Afișare ajutor'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Afișare ajutor]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comenzi plugin' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Tratare avertismente ca erori (cod de ieșire 1)]' \
            '--json[Afișare raport de validare ca JSON (aceleași coduri de ieșire)]' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Domeniu instalare]:scope:(user project local)' \
            '*--config[Setare opțiune userConfig declarată în manifestul plugin-ului (repetabil)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Acceptare comandă afișată declarată de marketplace fără solicitarea de confirmare]' \
            '--json[Afișare o singură linie de rezultat lizibilă de mașină în loc de mesajul pentru oameni]' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Domeniu instalare]:scope:(user project local)' \
            '--keep-data[Păstrare director de date persistente al plugin-ului]' \
            '--prune[Eliminare și a dependențelor instalate automat care nu mai sunt necesare]' \
            '(-y --yes)'{-y,--yes}'[Omitere solicitare de confirmare --prune]' \
            '--json[Afișare o singură linie de rezultat lizibilă de mașină în loc de mesajul pentru oameni (nu cu --prune)]' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Domeniu instalare]:scope:(user project local)' \
            '--json[Afișare o singură linie de rezultat lizibilă de mașină în loc de mesajul pentru oameni]' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Dezactivare toate plugin-urile activate]' \
            '(-s --scope)'{-s,--scope}'[Domeniu instalare]:scope:(user project local)' \
            '--json[Afișare o singură linie de rezultat lizibilă de mașină în loc de mesajul pentru oameni]' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Domeniu instalare]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Acceptare comandă afișată declarată de marketplace fără solicitarea de confirmare]' \
            '--json[Afișare o singură linie de rezultat lizibilă de mașină în loc de mesajul pentru oameni]' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Afișare ca JSON]' \
            '--available[Includere plugin-uri disponibile din marketplace-uri (necesită --json)]' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Domeniu pentru curățare]:scope:(user project local)' \
            '--dry-run[Listare ce ar fi eliminat fără a elimina]' \
            '(-y --yes)'{-y,--yes}'[Omitere solicitare de confirmare]' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]'
          ;;
        configure)
          _arguments \
            '--json[Afișare ca JSON]' \
            '--values-stdin[Citire valori opțiuni din stdin ca obiect JSON de șiruri pe o singură linie; opțiunile omise își păstrează valorile]' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Descriere manifest]:text:' \
            '--author[Nume autor (implicit: git config user.name)]:name:' \
            '--author-email[Email autor (implicit: git config user.email)]:email:' \
            '--with[Componente suplimentare de generat ca schelet]:components:' \
            '(-f --force)'{-f,--force}'[Suprascriere .claude-plugin/ existent la țintă]' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Filtrare cazuri după glob de nume]:glob:' \
            '*--tag[Filtrare cazuri după etichetă (repetabil)]:tag:' \
            '--runs[Suprascriere număr de rulări per caz (implicit: case.runs, altfel 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Executare simultană a până la n rulări de agent (1-8; implicit 1)]:n:' \
            '--model[Suprascriere model pentru toate cazurile]:model:_claude_model_names' \
            '--judge-model[Suprascriere model evaluator LLM (implicit: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Plafon strict de cost; abandonare și raportare rezultate parțiale dacă este atins (cod de ieșire 2)]:usd:' \
            '--output-dir[Director pentru aggregate-result.json]:dir:_directories' \
            '--eval-dir[Nume director (sub plugin) care conține cazurile de evaluare]:dir:' \
            '--json[Afișare rezultat complet al rulării ca JSON pe stdout, sau scriere în acest fișier .json]::path:_files' \
            '--threshold[Ieșire cu codul de ieșire 1 dacă scorul vreunui caz este sub acest prag (implicit: 1.0)]:threshold:' \
            '*--allow-tools[Permisiune de operator pentru unelte restricționate (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Rulare scaffold_script al fiecărui caz (rulează bash furnizat de autor în numele dumneavoastră; dezactivat implicit)]' \
            '(--scaffold)--no-scaffold[Omitere explicită scaffold_script]' \
            '--trust-plugin[Confirmare că aveți încredere în acest plugin și în suita sa de evaluare, omițând solicitarea de încredere la prima rulare (pentru CI)]' \
            '--ablation[Rulare grup de referință fără plugin și raportare diferență de scor]:mode:(none with-without)' \
            '--mocks[Înlocuitori simulați pentru serverele MCP, din <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Cu --mocks record: pornire și a proceselor reale de server MCP care nu au simulare]' \
            '--keep-temp[Păstrare directoare schelet pentru depanare]' \
            '--verbose[Înregistrare evenimente de urmărire per mesaj în jurnalul de depanare]' \
            '--report[Scriere raport HTML autonom la această cale în loc de directorul de rezultate]:path:_files' \
            '(--no-publish)--publish-report[Publicarea raportului pe claude.ai devine și ea obligatorie]' \
            '(--publish-report)--no-publish[Păstrare raport HTML doar local; omitere publicare pe claude.ai]' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Trimitere etichetă la --remote după creare]' \
            '--dry-run[Afișare ce ar fi etichetat fără a crea eticheta]' \
            '(-f --force)'{-f,--force}'[Omitere verificări pentru arbore de lucru modificat și etichetă deja existentă]' \
            '(-m --message)'{-m,--message}'[Mesaj de adnotare etichetă (utilizați %s pentru versiune)]:msg:' \
            '--remote[Remote către care se trimite cu --push]:name:' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Adăugare marketplace din URL, cale sau depozit GitHub'
    'list:Listare marketplace-uri configurate'
    'remove:Eliminare marketplace configurat'
    'rm:Eliminare marketplace configurat (alias pentru remove)'
    'update:Actualizare marketplace din sursă - actualizare toate dacă niciun nume specificat'
    'help:Afișare ajutor'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Afișare ajutor]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comenzi marketplace' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Limitare checkout la directoare specifice prin git sparse-checkout (pentru monorepo-uri)]:paths:' \
            '--scope[Unde se declară marketplace-ul]:scope:(user project local)' \
            '--claudeai[Adăugare marketplace cu acest nume găzduit de claude.ai pentru dumneavoastră]' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Afișare ca JSON]' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Eliminare declarație marketplace dintr-un domeniu de setări specific (omiteți pentru eliminare din toate domeniile)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Afișare ajutor]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Forțare instalare chiar dacă este deja instalat]' \
    '(-h --help)'{-h,--help}'[Afișare ajutor]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Director adițional pentru a permite accesul uneltelor în sesiunile lansate]:directory:_directories' \
    '--agent[Agent implicit pentru sesiunile lansate din vizualizarea agent]:agent:_claude_agent_names' \
    '--all[Cu --json: include și sesiunile în fundal finalizate]' \
    '--allow-dangerously-skip-permissions[Face disponibil modul de ocolire a permisiunilor pentru sesiunile lansate]' \
    '--cwd[Afișare doar sesiunile în fundal pornite sub cale]:path:_directories' \
    '--dangerously-skip-permissions[Alias pentru --permission-mode bypassPermissions]' \
    '--effort[Nivel de efort implicit pentru sesiunile lansate]:level:(low medium high xhigh max)' \
    '--json[Afișare sesiuni active ca tablou JSON și ieșire]' \
    '*--mcp-config[Configurație server MCP de aplicat sesiunilor lansate]:config:' \
    '--model[Model implicit pentru sesiunile lansate din vizualizarea agent]:model:_claude_model_names' \
    '--permission-mode[Mod permisiuni implicit pentru sesiunile lansate]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Încărcare plugin-uri din director pentru vizualizarea agent și sesiunile lansate]:path:_directories' \
    '--setting-sources[Listă separată prin virgule de surse de setări de încărcat (user, project, local)]:sources:' \
    '--settings[Fișier de setări sau șir JSON de aplicat]:file-or-json:_files' \
    '--strict-mcp-config[Utilizare doar servere MCP din --mcp-config în sesiunile lansate]' \
    '--restricted[Pornire sesiuni lansate în mod restricționat]' \
    '(-h --help)'{-h,--help}'[Afișare ajutor pentru comandă]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Conectare la contul dumneavoastră Anthropic'
    'logout:Deconectare din contul dumneavoastră Anthropic'
    'status:Afișare stare autentificare'
    'help:Afișare ajutor'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Afișare ajutor pentru comandă]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comenzi auth' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Precompletare adresă email pe pagina de autentificare]:email:' \
            '--sso[Forțare flux de autentificare SSO]' \
            '(--claudeai)--console[Utilizare Anthropic Console (facturare utilizare API) în loc de abonament Claude]' \
            '(--console)--claudeai[Utilizare abonament Claude (implicit)]' \
            '(-h --help)'{-h,--help}'[Afișare ajutor pentru comandă]'
          ;;
        status)
          _arguments \
            '(--text)--json[Afișare ca JSON (implicit)]' \
            '(--json)--text[Afișare ca text lizibil pentru oameni]' \
            '(-h --help)'{-h,--help}'[Afișare ajutor pentru comandă]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Afișare ajutor pentru comandă]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Afișare configurație efectivă mod automat ca JSON'
    'critique:Obținere feedback AI asupra regulilor personalizate de mod automat'
    'defaults:Afișare reguli implicite mod automat ca JSON'
    'reset:Resetare configurație mod automat la valorile implicite livrate'
    'help:Afișare ajutor'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Afișare ajutor pentru comandă]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comenzi auto-mode' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Suprascriere model utilizat]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Afișare ajutor pentru comandă]'
          ;;
        defaults)
          _arguments \
            '--label[Afișare doar reguli a căror etichetă începe cu acest prefix (fără distincție majuscule/minuscule)]:prefix:' \
            '(-h --help)'{-h,--help}'[Afișare ajutor pentru comandă]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Omitere solicitare de confirmare]' \
            '(-h --help)'{-h,--help}'[Afișare ajutor pentru comandă]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Afișare ajutor pentru comandă]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Cale către configurația YAML a gateway-ului]:path:_files' \
    '(-h --help)'{-h,--help}'[Afișare ajutor pentru comandă]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Ștergere toată starea Claude Code pentru un proiect (transcrieri, sarcini, istoric fișiere, intrare configurație)'
    'help:Afișare ajutor'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Afișare ajutor pentru comandă]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comenzi project' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Listare ce ar fi șters fără a șterge nimic]' \
            '(-y --yes)'{-y,--yes}'[Omitere solicitare de confirmare]' \
            '(-i --interactive)'{-i,--interactive}'[Solicitare confirmare pentru fiecare element înainte de ștergere]' \
            '(1)--all[Ștergere stare pentru toate proiectele (exclusiv reciproc cu o cale)]' \
            '(-h --help)'{-h,--help}'[Afișare ajutor pentru comandă]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Afișare payload brut bugs.json în loc de rezultate formatate]' \
    '--timeout[Numărul maxim de minute de așteptare pentru finalizarea revizuirii (implicit: 45)]:minutes:' \
    '(--no-post)--post[Publicare constatări ale revizuirii finalizate pe PR în numele dumneavoastră (doar pentru ținte PR; un singur comentariu simplu, nu o revizuire)]' \
    '(--post)--no-post[Fără publicarea constatărilor pe PR (implicit)]' \
    '(-h --help)'{-h,--help}'[Afișare ajutor pentru comandă]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Repornire toate sesiunile în fundal care rulează]' \
    '(-h --help)'{-h,--help}'[Afișare ajutor pentru comandă]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Renunțare și la commit-urile netrimise și modificările necomise ale worktree-ului (transmiteți commit@worktree-id raportat de un claude rm anterior)]:commit@worktree-id:' \
    '--force-remove-worktree[Ștergere director worktree chiar dacă hook-ul WorktreeRemove sau git nu l-au putut elimina (transmiteți worktree-id raportat de un claude rm anterior)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Afișare ajutor pentru comandă]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Afișare ce ar fi importat fără a scrie nimic]' \
    '--yes[Omitere selector interactiv (pe suprafețe fără interfață grafică, transmiteți --yes=<digest> din previzualizarea /import)]' \
    '(-h --help)'{-h,--help}'[Afișare ajutor pentru comandă]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
