#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:配置和管理MCP服务器'
    'plugin:管理Claude Code插件'
    'agents:管理后台代理'
    'attach:在此终端中打开后台会话'
    'logs:打印后台会话最近的终端输出'
    'stop:停止后台会话（对话会被保留）'
    'respawn:重启后台会话，使其运行当前的Claude Code版本'
    'rm:删除后台会话，并在安全时一并删除其工作树'
    'remote-control:从claude.ai/code或Claude移动应用控制本地会话'
    'daemon:管理后台会话监管进程'
    'auth:管理身份验证'
    'auto-mode:检查或重置自动模式分类器配置'
    'gateway:运行企业身份验证/遥测网关'
    'self-hosted-runner:在此机器或容器上托管Claude Code云会话'
    'import:将其他AI编码代理的配置导入Claude Code'
    'project:管理Claude Code项目状态'
    'purge:删除项目的所有Claude Code状态（记录、任务、文件历史、配置条目）'
    'ultrareview:运行云托管的多代理代码审查并打印结果'
    'setup-token:设置长期身份验证令牌（需要Claude订阅）'
    'doctor:Claude Code自动更新器健康检查'
    'update:检查并安装更新'
    'install:安装Claude Code原生构建'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[启用调试模式，可选类别过滤（例如："api,hooks"或"!statsig,!file"）]:filter:'
    '--verbose[覆盖配置文件中的详细模式设置]'
    '(-p --print)'{-p,--print}'[打印响应并退出（用于管道）。注意：仅在受信任的目录中使用]'
    '--output-format[输出格式（与--print一起使用）："text"（默认）、"json"（单个结果）或"stream-json"（实时流式传输）]:format:(text json stream-json)'
    '--json-schema[用于结构化输出验证的JSON模式]:schema:'
    '--include-partial-messages[在消息到达时包含部分消息块（与--print和--output-format=stream-json一起使用）]'
    '--input-format[输入格式（与--print一起使用）："text"（默认）或"stream-json"（实时流式输入）]:format:(text stream-json)'
    '--dangerously-skip-permissions[绕过所有权限检查。仅建议在没有互联网访问的沙箱中使用]'
    '--allow-dangerously-skip-permissions[启用绕过权限检查的选项，但默认不启用]'
    '--restricted[受限模式：移除运行命令或代码的工具和WebFetch，忽略user/project/local设置，并将文件工具限制在工作目录内]'
    '--max-budget-usd[API调用花费的最大美元金额（仅--print）]:amount:'
    '--max-turns[限制代理轮次数（仅--print）]:turns:'
    '--replay-user-messages[在stdout上重新发送来自stdin的用户消息以进行确认]'
    '--allowed-tools[允许的工具名称的逗号或空格分隔列表（例如："Bash(git:*) Edit"）]:tools:'
    '--allowedTools[允许的工具名称的逗号或空格分隔列表（驼峰命名格式）]:tools:'
    '--tools[从内置集中指定可用工具列表。仅打印模式]:tools:'
    '--disallowed-tools[禁止的工具名称的逗号或空格分隔列表（例如："Bash(git:*) Edit"）]:tools:'
    '--disallowedTools[禁止的工具名称的逗号或空格分隔列表（驼峰命名格式）]:tools:'
    '--mcp-config[从JSON文件或字符串加载MCP服务器（空格分隔）]:configs:'
    '--system-prompt[会话使用的系统提示]:prompt:'
    '--system-prompt-file[从文件读取系统提示]:file:_files'
    '--append-system-prompt[将系统提示附加到默认系统提示]:prompt:'
    '--append-system-prompt-file[从文件读取系统提示并追加到默认系统提示]:file:_files'
    '(--append-subagent-system-prompt-file)--append-subagent-system-prompt[向每个子代理的系统提示追加文本（仅--print）]:prompt:'
    '(--append-subagent-system-prompt)--append-subagent-system-prompt-file[从文件读取文本并追加到子代理系统提示（仅--print）]:file:_files'
    '--system-prompt-snapshot[每个对话记录一次系统提示，并在之后的每次请求和恢复中原样复用（on，默认），或每次请求重新生成（off）]:mode:(on off)'
    '--permission-mode[会话使用的权限模式]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[使用--print时由谁回答权限提示："host"（SDK宿主或--permission-prompt-tool）或"none"（任何需要提示的操作都被拒绝）]:target:(host none)'
    '--permission-prompt-tool[用于权限提示的MCP工具（仅限--print）]:tool:'
    '(-c --continue)'{-c,--continue}'[继续最近的对话]'
    '(-r --resume)'{-r,--resume}'[恢复对话 - 指定会话ID或交互式选择]:sessionId:_claude_sessions'
    '--fork-session[恢复时创建新的会话ID而不是重用原始会话ID（与--resume或--continue一起使用）]'
    '--no-session-persistence[禁用会话持久化 - 会话将不会被保存（仅--print）]'
    '--model[当前会话的模型。指定最新模型的别名（例如，'\''sonnet'\''或'\''opus'\''）]:model:_claude_model_names'
    '--agent[当前会话的代理。覆盖'\''agent'\''设置]:agent:_claude_agent_names'
    '--betas[要包含在API请求中的Beta标头（仅限API密钥用户）]:betas:'
    '--fallback-model[当默认模型过载时启用自动回退到指定模型（仅--print）]:model:_claude_model_names'
    '--settings[设置JSON文件的路径或用于加载其他设置的JSON字符串]:file-or-json:_files'
    '--add-dir[允许工具访问的其他目录]:directories:_directories'
    '--ide[如果恰好有一个有效的IDE可用，则在启动时自动连接到IDE]'
    '--desktop[在 Claude Desktop 应用中打开，而不是终端（配合 --continue 或 --resume <id> 选择会话）]'
    '--strict-mcp-config[仅使用--mcp-config中的MCP服务器并忽略所有其他MCP设置]'
    '--session-id[用于对话的特定会话ID（必须是有效的UUID）]:uuid:'
    '--agents[定义自定义代理的JSON对象]:json:'
    '--advisor[使用模型别名或完整模型ID为此会话启用服务端顾问工具]:model:_claude_model_names'
    '--teammate-mode[代理团队成员的显示方式]:mode:(in-process auto tmux iterm2)'
    '--setting-sources[要加载的设置源的逗号分隔列表（user, project, local）]:sources:'
    '--plugin-dir[仅为此会话加载插件的目录（可重复）]:paths:_directories'
    '--disable-slash-commands[禁用所有斜杠命令]'
    '(--bg --background)'{--bg,--background}'[将会话作为后台代理启动并立即返回]'
    '(-w --worktree)'{-w,--worktree}'[为此会话创建新的git工作树（可选指定名称）]::name:'
    '--tmux=-[为工作树创建tmux会话（需要--worktree）。可用时使用iTerm2原生窗格；传统tmux请用--tmux=classic]::mode:(classic)'
    '(-n --name)'{-n,--name}'[为此会话设置显示名称]:name:'
    '--effort[当前会话的努力程度]:level:(low medium high xhigh max)'
    '--autocompact[自动压缩窗口大小（auto，或100k到1M个token）]:size:(auto)'
    '--debug-file[将调试日志写入特定文件路径（隐式启用调试模式）]:path:_files'
    '--from-pr[恢复通过编号/URL链接到PR的会话，或打开交互式选择器]::value:'
    '--teleport[恢复传送会话，可选指定会话ID]::session:'
    '(--remote)--cloud[使用给定描述创建云会话，或通过会话ID或claude.ai/code URL附加到现有会话]::description-or-session:'
    '(--cloud)--remote[--cloud的已弃用别名]::description-or-session:'
    '--environment[创建在指定自托管环境（ccpool_...）上运行的新云会话]:environment_id:'
    '--ref[与--environment一起使用：新会话的检出基于指定的ref而非本地HEAD]:branch:'
    '(--remote-control --rc)'{--remote-control,--rc}'[启动启用远程控制的交互式会话（可选命名）]::name:'
    '--remote-control-session-name-prefix[自动生成的远程控制会话名称的前缀]:prefix:'
    '--chrome[启用Chrome中的Claude集成]'
    '--no-chrome[禁用Chrome中的Claude集成]'
    '--plugin-url[仅为此会话从URL获取插件.zip（可重复）]:url:'
    '--file[启动时下载的文件资源（格式：file_id:relative_path）]:specs:'
    '--prompt-suggestions[启用提示建议（在打印/SDK模式下发出预测的下一个提示）]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[将子代理文本和思考块作为消息转发（与--print和stream-json一起使用）]'
    '--include-hook-events[在输出流中包含所有钩子生命周期事件（与stream-json一起使用）]'
    '--exclude-dynamic-system-prompt-sections[将每台机器的部分移到第一条用户消息中以提高提示缓存重用率]'
    '--brief[启用SendUserMessage工具用于代理到用户的通信]'
    '*--channels[（研究预览）要监听其频道通知的MCP服务器（plugin\:<name>@<marketplace>）]:entries:'
    '*--dangerously-load-development-channels[为本地开发启用不在已批准允许列表中的频道（plugin\:<name>@<marketplace>或server\:<name>）]:entries:'
    '--init[在会话前使用init匹配器运行Setup钩子（仅--print）]'
    '--init-only[运行Setup和SessionStart钩子，然后不开始对话直接退出]'
    '--maintenance[在会话前使用maintenance匹配器运行Setup钩子（仅--print）]'
    '--safe-mode[在禁用所有自定义设置的情况下启动（用于排查损坏的配置）]'
    '--bare[最小模式：跳过钩子、LSP、插件同步、归因、自动记忆和CLAUDE.md自动发现]'
    '--ax-screen-reader[渲染屏幕阅读器友好的输出（纯文本，无装饰边框或动画）]'
    '(-v --version)'{-v,--version}'[输出版本号]'
    '(-h --help)'{-h,--help}'[显示命令帮助]'
  )

  # Stop at the first non-option word, so that the options after a command reach
  # that command's own specs instead of being consumed here
  _arguments -C -A '-*' \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude命令' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin|plugins)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[显示命令帮助]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        remote-control|rc|remote|sync|bridge)
          _claude_remote_control
          ;;
        daemon)
          _claude_daemon
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        self-hosted-runner)
          _claude_self_hosted_runner
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        purge)
          _claude_purge
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update|upgrade)
          _arguments \
            '(-h --help)'{-h,--help}'[显示命令帮助]'
          ;;
        *)
          # Not a command but the prompt: options may still follow it
          _arguments \
            $main_options \
            '*: :'
          ;;
      esac
      ;;
  esac
  local ret=$?

  # The last step, such as listing commands for --r, can fail although options
  # were added before it. Report success then: on failure zsh moves on to the
  # next completers, and _correct or _approximate pile on corrections
  (( compstate[nmatches] > 0 )) || return $ret
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:启动Claude Code MCP服务器'
    'add:向Claude Code添加MCP服务器'
    'remove:删除MCP服务器'
    'list:列出已配置的MCP服务器'
    'get:获取MCP服务器详细信息'
    'add-json:使用JSON字符串添加MCP服务器（stdio或SSE）'
    'add-from-claude-desktop:从Claude Desktop导入MCP服务器（仅限Mac和WSL）'
    'reset-project-choices:重置此项目中所有已批准/拒绝的项目范围（.mcp.json）服务器'
    'login:向MCP服务器进行身份验证（HTTP、SSE或claude.ai连接器）'
    'logout:清除MCP服务器存储的OAuth凭据'
    'help:显示帮助'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[显示帮助]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp命令' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[启用调试模式]' \
            '--verbose[覆盖配置文件中的详细模式设置]' \
            '(-h --help)'{-h,--help}'[显示帮助]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[配置范围（local, user, project）]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[传输类型（stdio, sse, http）]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[设置环境变量（例如，-e KEY=value）]:env:' \
            '(-H --header)'{-H,--header}'[设置WebSocket标头]:header:' \
            '--client-id[HTTP/SSE服务器的OAuth客户端ID]:clientId:' \
            '--client-secret[提示输入OAuth客户端密钥（或设置MCP_CLIENT_SECRET环境变量）]' \
            '--callback-port[OAuth回调的固定端口（用于需要预注册重定向URI的服务器）]:port:' \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[配置范围（local, user, project） - 如果未指定则从现有范围中删除]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[显示帮助]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[配置范围（local, user, project）]:scope:(local user project)' \
            '--client-secret[提示输入OAuth客户端密钥（或设置MCP_CLIENT_SECRET环境变量）]' \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[配置范围（local, user, project）]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[显示帮助]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[显示帮助]'
          ;;
        login)
          _arguments \
            '--no-browser[打印授权URL而不打开浏览器（用于SSH/无头会话）]' \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:验证插件或市场清单'
    'marketplace:管理Claude Code市场'
    'list:列出已安装的插件'
    'details:显示插件的组件清单和预计令牌成本'
    'configure:显示插件的选项及未设置的项，或从 stdin 保存值'
    'install:从可用市场安装插件'
    'i:从可用市场安装插件（install的简写）'
    'init:搭建新插件（下次会话自动加载）'
    'new:搭建新插件（init的别名）'
    'uninstall:卸载已安装的插件'
    'remove:卸载已安装的插件（uninstall的别名）'
    'enable:启用已禁用的插件'
    'disable:禁用已启用的插件'
    'update:将插件更新到最新版本'
    'eval:针对插件运行评估用例并报告评分结果'
    'prune:删除不再需要的自动安装依赖项'
    'autoremove:删除不再需要的自动安装依赖项（prune的别名）'
    'tag:为插件发布创建{name}--v{version} git标签'
    'test:运行 mod 的测试'
    'help:显示帮助'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[显示帮助]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin命令' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[将警告视为错误（退出码1）]' \
            '--profile[当指定的目录（catalog）会因本命令运行的某项检查拒绝提交该插件时，也以exit 1退出]:name:(directory)' \
            '--json[以JSON输出验证报告（退出码相同）]' \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[安装范围]:scope:(user project local)' \
            '--accept-command[接受市场声明的命令，其 sha256 为上一次 --json 运行以 shownCommand.sha256 报告的值]:sha256:' \
            '*--config[设置插件清单中声明的userConfig选项（可重复）]:key=value:' \
            '--marketplace[按插件名从此来源（owner/repo、git或https URL、或路径）的市场安装插件，必要时先添加该市场]:source:' \
            '--registry[用于 package@npm 安装：从此 npm 注册表解析并下载]:url:' \
            '(-y --yes)'{-y,--yes}'[无需确认提示即接受显示的市场声明命令]' \
            '--json[打印一行机器可读的结果而非人类可读的消息]' \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[安装范围]:scope:(user project local)' \
            '--keep-data[保留插件的持久数据目录]' \
            '--prune[同时删除不再需要的自动安装依赖项]' \
            '(-y --yes)'{-y,--yes}'[跳过--prune的确认提示]' \
            '--json[打印一行机器可读的结果而非人类可读的消息（不能与--prune同用）]' \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[安装范围]:scope:(user project local)' \
            '--json[打印一行机器可读的结果而非人类可读的消息]' \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[禁用所有已启用的插件]' \
            '(-s --scope)'{-s,--scope}'[安装范围]:scope:(user project local)' \
            '--json[打印一行机器可读的结果而非人类可读的消息]' \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '--accept-command[接受市场声明的命令，其 sha256 为上一次 --json 运行以 shownCommand.sha256 报告的值]:sha256:' \
            '(-s --scope)'{-s,--scope}'[安装范围]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[无需确认提示即接受显示的市场声明命令]' \
            '--json[打印一行机器可读的结果而非人类可读的消息]' \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[以JSON输出]' \
            '--available[包含市场中可用的插件（需要--json）]' \
            '--data-size[测量每个已安装插件的已保存数据目录大小，或仅测量指定插件（需要 --json）]::plugin:_claude_installed_plugins' \
            '(-h --help)'{-h,--help}'[显示帮助]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[在此范围内清理]:scope:(user project local)' \
            '--dry-run[列出将被删除的内容但不实际删除]' \
            '(-y --yes)'{-y,--yes}'[跳过确认提示]' \
            '(-h --help)'{-h,--help}'[显示帮助]'
          ;;
        configure)
          _arguments \
            '--json[以JSON输出]' \
            '--values-stdin[从 stdin 读取选项值，格式为单行字符串组成的 JSON 对象（未提供的选项保留原值）]' \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[清单描述]:text:' \
            '--author[作者姓名（默认：git config user.name）]:name:' \
            '--author-email[作者邮箱（默认：git config user.email）]:email:' \
            '--with[一并搭建的组件]:components:' \
            '(-f --force)'{-f,--force}'[覆盖目标位置已有的.claude-plugin/]' \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '1:name:'
          ;;
        eval)
          if [[ $words[2] == init ]]; then
            _arguments \
              '--bare[写入空白模板，而不是运行访谈]' \
              '--eval-dir[写入用例的目录（位于当前目录下）]:dir:_directories' \
              '(-i --interactive)'{-i,--interactive}'[运行编写访谈（需要交互式终端）]' \
              '(-h --help)'{-h,--help}'[显示帮助]' \
              '::name:'
            return
          fi
          _arguments \
            '--case[按名称glob过滤用例]:glob:' \
            '*--tag[按标签过滤用例（可重复）]:tag:' \
            '--runs[覆盖每个用例的运行次数（默认：case.runs，否则为3）]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[同时运行最多n个代理（1到8，默认1）]:n:' \
            '--model[覆盖所有用例的模型]:model:_claude_model_names' \
            '--judge-model[覆盖LLM评分模型（默认：haiku）]:model:_claude_model_names' \
            '--max-cost-usd[硬性成本上限；达到时中止并报告部分结果（退出码2）]:usd:' \
            '--output-dir[存放aggregate-result.json的目录]:dir:_directories' \
            '--eval-dir[存放评估用例的目录名（位于插件下）]:dir:' \
            '--json[将完整运行结果以JSON打印到标准输出，或写入此.json文件]::path:_files' \
            '--threshold[任一用例得分低于此阈值时以退出码1退出（默认：1.0）]:threshold:' \
            '*--allow-tools[操作者对受限工具（Bash、Write、Edit、WebFetch、mcp__*）的授权]:tools:' \
            '*--disallow-tools[无论如何都不让Claude使用的内置工具，即使已授权]:tools:' \
            '(--no-scaffold)--scaffold[运行每个用例的scaffold_script（以你的身份运行作者提供的bash；默认关闭）]' \
            '(--scaffold)--no-scaffold[明确跳过scaffold_script]' \
            '--trust-plugin[声明你信任此插件及其评估套件，跳过首次运行的信任提示（用于CI）]' \
            '--ablation[运行无插件基线并报告得分差异]:mode:(none with-without)' \
            '--mocks[MCP服务器的模拟替身（来自<eval dir>/mocks/）]:mode:(record off)' \
            '--allow-real-servers[使用--mocks record时，同时启动没有模拟的真实MCP服务器进程]' \
            '--keep-temp[保留scaffold目录以便调试]' \
            '--verbose[将每条消息的跟踪事件记录到调试日志]' \
            '--report[将独立的HTML报告写入此路径而非结果目录]:path:_files' \
            '(--no-publish)--publish-report[同时要求将报告发布到claude.ai]' \
            '(--publish-report)--no-publish[仅在本地保留HTML报告，不发布到claude.ai]' \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '::target: _alternative "commands\:eval command\:(init)" "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[创建标签后推送到--remote]' \
            '--dry-run[打印将要打的标签但不实际创建]' \
            '(-f --force)'{-f,--force}'[跳过工作树未提交更改和标签已存在的检查]' \
            '(-m --message)'{-m,--message}'[标签注释消息（%s表示版本）]:msg:' \
            '--remote[使用--push时推送到的远程仓库]:name:' \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:从URL、路径或GitHub存储库添加市场'
    'list:列出已配置的市场'
    'remove:删除已配置的市场'
    'rm:删除已配置的市场（remove的别名）'
    'update:从源更新市场 - 如果未指定名称则更新所有'
    'help:显示帮助'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[显示帮助]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace命令' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[通过git sparse-checkout仅检出特定目录（用于单体仓库）]:paths:' \
            '--scope[在何处声明市场]:scope:(user project local)' \
            '--json[将一行机器可读的结果作为最后一行输出到标准输出]' \
            '--claudeai[添加claude.ai为你托管的此名称的市场]' \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[以JSON输出]' \
            '(-h --help)'{-h,--help}'[显示帮助]'
          ;;
        remove|rm)
          _arguments \
            '--scope[从特定设置范围移除市场声明（省略则从所有范围移除）]:scope:(user project local)' \
            '--json[将一行机器可读的结果作为最后一行输出到标准输出]' \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '--json[指定市场名称时：将一行机器可读的结果作为最后一行输出到标准输出]' \
            '(-h --help)'{-h,--help}'[显示帮助]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[即使已安装也强制安装]' \
    '(-h --help)'{-h,--help}'[显示帮助]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[允许派发会话中工具访问的其他目录]:directory:_directories' \
    '--agent[从代理视图派发的会话的默认代理]:agent:_claude_agent_names' \
    '--all[与--json一起使用：同时包含已完成的后台会话]' \
    '--allow-dangerously-skip-permissions[使派发的会话可以使用绕过权限模式]' \
    '--cwd[仅显示在指定路径下启动的后台会话]:path:_directories' \
    '--dangerously-skip-permissions[--permission-mode bypassPermissions的别名]' \
    '--effort[派发会话的默认努力程度]:level:(low medium high xhigh max)' \
    '--json[将活动会话打印为JSON数组并退出]' \
    '*--mcp-config[应用于派发会话的MCP服务器配置]:config:' \
    '--model[从代理视图派发的会话的默认模型]:model:_claude_model_names' \
    '--permission-mode[派发会话的默认权限模式]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[为代理视图和派发会话从目录加载插件]:path:_directories' \
    '--setting-sources[要加载的设置源的逗号分隔列表（user, project, local）]:sources:' \
    '--settings[要应用的设置文件或JSON字符串]:file-or-json:_files' \
    '--strict-mcp-config[在派发会话中仅使用--mcp-config中的MCP服务器]' \
    '--restricted[以受限模式启动派发的会话]' \
    '(-h --help)'{-h,--help}'[显示命令帮助]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:登录到您的Anthropic账户'
    'logout:从您的Anthropic账户注销'
    'status:显示身份验证状态'
    'help:显示帮助'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[显示命令帮助]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth命令' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[在登录页面预填邮箱地址]:email:' \
            '--sso[强制使用SSO登录流程]' \
            '(--claudeai)--console[使用Anthropic Console（按API用量计费）而非Claude订阅]' \
            '(--console)--claudeai[使用Claude订阅（默认）]' \
            '(-h --help)'{-h,--help}'[显示命令帮助]'
          ;;
        status)
          _arguments \
            '(--text)--json[以JSON输出（默认）]' \
            '(--json)--text[以人类可读的文本输出]' \
            '(-h --help)'{-h,--help}'[显示命令帮助]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[显示命令帮助]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:将有效的自动模式配置打印为JSON'
    'critique:获取有关您自定义自动模式规则的AI反馈'
    'defaults:将默认的自动模式规则打印为JSON'
    'reset:将自动模式配置重置为出厂默认值'
    'help:显示帮助'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[显示命令帮助]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode命令' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[覆盖所使用的模型]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[显示命令帮助]'
          ;;
        defaults)
          _arguments \
            '--label[仅显示标签以此前缀开头的规则（不区分大小写）]:prefix:' \
            '(-h --help)'{-h,--help}'[显示命令帮助]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[跳过确认提示]' \
            '(-h --help)'{-h,--help}'[显示命令帮助]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[显示命令帮助]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[网关YAML配置的路径]:path:_files' \
    '(-h --help)'{-h,--help}'[显示命令帮助]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:删除项目的所有Claude Code状态（记录、任务、文件历史、配置条目）'
    'help:显示帮助'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[显示命令帮助]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project命令' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[列出将被删除的内容但不实际删除]' \
            '(-y --yes)'{-y,--yes}'[跳过确认提示]' \
            '(-i --interactive)'{-i,--interactive}'[删除前逐项确认]' \
            '(1)--all[清除所有项目的状态（不能与路径同用）]' \
            '(-h --help)'{-h,--help}'[显示命令帮助]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_purge() {
  _arguments \
    '--dry-run[列出将被删除的内容但不实际删除]' \
    '(-y --yes)'{-y,--yes}'[跳过确认提示]' \
    '(-i --interactive)'{-i,--interactive}'[删除前逐项确认]' \
    '(1)--all[清除所有项目的状态（不能与路径同用）]' \
    '(-h --help)'{-h,--help}'[显示命令帮助]' \
    '(--all)::path:_directories'
}

_claude_ultrareview() {
  _arguments \
    '--json[打印原始bugs.json负载而不是格式化的结果]' \
    '--timeout[等待审查完成的最长分钟数（默认：45）]:minutes:' \
    '(--no-post)--post[以你的身份将完成的审查结果发布到PR（仅限PR目标；一条普通评论，而非review）]' \
    '(--post)--no-post[不将结果发布到PR（默认）]' \
    '--trust-workspace[仅在本次运行中信任当前文件夹，不询问（用于脚本和CI）]' \
    '(-h --help)'{-h,--help}'[显示命令帮助]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[重启所有正在运行的后台会话]' \
    '(-h --help)'{-h,--help}'[显示命令帮助]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[同时丢弃工作树中未推送的提交和未提交的更改（传入之前claude rm报告的commit@worktree-id）]:commit@worktree-id:' \
    '--force-remove-worktree[即使WorktreeRemove钩子或git无法移除，也删除工作树目录（传入之前claude rm报告的worktree-id）]:worktree-id:' \
    '(-h --help)'{-h,--help}'[显示命令帮助]' \
    '1:session:_claude_background_sessions'
}

_claude_self_hosted_runner() {
  _arguments \
    '--api-url[API基础URL（默认：https://api.anthropic.com）]:url:' \
    '--environment-secret-file[环境密钥文件的路径]:path:_files' \
    '--lock-to-account[注册时将运行器锁定到单个账户]:id:' \
    '--client-label[注册时发送的可观测性标签（默认：hostname）]:label:' \
    '(--proxy-authorization-file --agent-proxy-url)--proxy-authorization-command[其stdout作为出站代理Proxy-Authorization标头的命令]:shell command:' \
    '(--proxy-authorization-command --agent-proxy-url)--proxy-authorization-file[保存出站代理Proxy-Authorization标头的文件]:path:_files' \
    '(--proxy-authorization-command --proxy-authorization-file)--agent-proxy-url[让所有会话经由此URL的代理专用代理服务器（仅https）]:url:' \
    '--capacity[最大并发会话数（默认：1）]:n:' \
    '--base-dir[仓库检出的基础目录（默认：/workspace）]:path:_directories' \
    '--exec-path[用于启动子会话的二进制文件（默认：此二进制文件）]:path:_files' \
    '--hooks-dir[生命周期钩子脚本目录（checkout、command、post-session）]:path:_directories' \
    '--session-stop-grace-sec[会话结束后等待干净退出的时间（默认：5）]:n:' \
    '--post-session-hook-timeout-sec[post-session钩子的SIGTERM时限（默认：60）]:n:' \
    '--checkout-hook-timeout-min[checkout钩子每次运行的挂钟时间上限（默认：30；0表示禁用）]:n:' \
    '--drain-wait-sec[收到SIGTERM/SIGINT时，最多等待N秒完成进行中的工作（默认：0）]:n:' \
    '--drain-marker-file[主机用于通告优雅排空的标记文件]:path:_files' \
    '*--git-ssh-rewrite[将https://<host>/...来源URL重写为git@<host>:...（可重复）]:host:' \
    '*--git-host-rewrite[将https://<f>/...来源URL重写为https://<t>/...（可重复）]:from=to:' \
    '--use-anthropic-git-proxy[使用Anthropic托管的git。警告：会删除并替换HOME级别的git配置，仅在专用账户下使用]' \
    '--configure-git[设置全局git身份并通过Anthropic签名服务启用提交签名。会写入~/.gitconfig]' \
    '--push-outcome-on-release[运行器发起的会话未完成即结束时，推送跟踪的成果分支]' \
    '--trust-workspace[为每个会话的仓库路径预置持久信任（默认：true）]::bool:(true false)' \
    '--remove-session-state[会话结束时移除该会话的状态（默认：false）]::bool:(true false)' \
    '--diff-finds-nested-repository[在Changes窗格中显示克隆到子文件夹中的仓库；需要--capacity 1（默认：false）]::bool:(true false)' \
    '--confine-repo-settings[限制仓库内已提交设置的守卫模式（默认：warn）]:mode:(warn enforce off)' \
    '--server-auto-mode-lists[会话可从服务器接收哪些自动模式分类器列表（默认：no-allow）]:mode:(all no-allow none)' \
    '--host-config-snapshot[主机配置启动快照的保存位置（默认：disk）]:mode:(disk memory)' \
    '--health-port[/healthz HTTP监听器的端口（默认：8080；0表示禁用）]:port:' \
    '--log-level[日志级别（默认：info）]:level:(info debug)' \
    '--log-file[以追加模式将运行器日志同时写入文件]:path:_files' \
    '--exit-if-unused-min[如果N分钟内从未分配工作则退出运行器]:n:' \
    '--drain-grace-sec[活动会话结束后继续轮询工作的秒数（默认：0）]:n:' \
    '--retire-at[在此绝对Unix时间（秒）停用运行器]:epoch-seconds:' \
    '--defer-shutdown-max-min[首次收到SIGTERM/SIGINT时停止接收工作，并在M分钟后完成关闭（默认：0）]:m:' \
    '--release-idle-session-min[N分钟无用户输入后释放会话槽位]:n:' \
    '--startup-timeout-min[子进程N分钟后仍未完成启动则释放会话槽位（默认：15；0表示禁用）]:n:' \
    '--kill-session-after-min[将会话子进程的挂钟寿命限制为N分钟]:n:' \
    '--debug-token-dir[仅限调试：将有效令牌写入磁盘。请勿在生产环境中使用]:path:_directories' \
    '(-h --help)'{-h,--help}'[显示此帮助信息]'
}

_claude_remote_control() {
  _arguments \
    '--name[会话名称（显示在claude.ai/code中）]:name:' \
    '--remote-control-session-name-prefix[自动生成的会话名称的前缀（默认：hostname）]:prefix:' \
    '(-c --continue --session-id)'{-c,--continue}'[重新连接到此目录或其某个git工作树最后记录的会话]' \
    '(-c --continue --session-id)--session-id[按ID重新连接到指定会话]:id:' \
    '--permission-mode[所启动会话的权限模式]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)' \
    '(--no-chrome)--chrome[为所启动的会话启用Claude in Chrome]' \
    '(--chrome)--no-chrome[为所启动的会话禁用Claude in Chrome]' \
    '(-d --debug)'{-d,--debug}'[启用调试模式，可选类别过滤]::filter:' \
    '--debug-file[将调试日志写入文件]:path:_files' \
    '(-v --verbose)'{-v,--verbose}'[启用详细输出]' \
    '--spawn[启动模式（默认：same-dir）]:mode:(same-dir worktree session)' \
    '--capacity[worktree或same-dir模式下的最大并发会话数（默认：32）]:n:' \
    '(--no-create-session-in-dir)--create-session-in-dir[在当前目录中预先创建会话（默认）]' \
    '(--create-session-in-dir)--no-create-session-in-dir[不在当前目录中预先创建会话]' \
    '(-h --help)'{-h,--help}'[显示此帮助]'
}

_claude_daemon() {
  local -a daemon_commands common_options
  daemon_commands=(
    'run:在前台运行监管进程'
    'status:显示daemon的pid、版本、运行时长'
    'logs:跟踪daemon日志（Ctrl-C停止）'
    'uninstall:移除后台服务（launchctl/systemd）'
    'stop:关闭监管进程并终止后台会话'
  )
  common_options=(
    '--json-path[配置文件（默认：~/.claude/daemon.json）]:path:_files'
    '--log-file[日志文件（默认：~/.claude/daemon.log）]:path:_files'
    '(-h --help)'{-h,--help}'[显示此帮助]'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    $common_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'daemon命令' daemon_commands
      ;;
    args)
      case $words[1] in
        run)
          _arguments \
            $common_options \
            '::json-path:_files'
          ;;
        stop)
          _arguments \
            $common_options \
            '--any[同时停止临时（非服务）daemon]' \
            '--keep-workers[让已分离的会话继续运行]'
          ;;
        status|logs|uninstall)
          _arguments \
            $common_options
          ;;
      esac
      ;;
  esac
}

_claude_import() {
  _arguments \
    '--dry-run[显示将导入的内容但不写入任何内容]' \
    '--yes[跳过交互式选择器（在无头环境中，传入/import预览中的--yes=<digest>）]' \
    '(-h --help)'{-h,--help}'[显示命令帮助]' \
    '::source:(codex gemini cursor)'
}

# compinit autoloads this file, and that first call only defines the functions
# above: complete right away so the first TAB already works. Sourced directly,
# there is nothing to complete yet, only the registration.
if [[ $funcstack[1] == _claude ]]; then
  _claude "$@"
else
  (( $+_comps[claude] )) || compdef _claude claude
fi
