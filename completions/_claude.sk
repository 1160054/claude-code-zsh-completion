#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Konfigurácia a správa MCP serverov'
    'plugin:Správa pluginov Claude Code'
    'agents:Správa agentov na pozadí'
    'attach:Otvoriť reláciu na pozadí v tomto termináli'
    'logs:Vypísať nedávny výstup terminálu relácie na pozadí'
    'stop:Zastaviť reláciu na pozadí (jej konverzácia sa zachová)'
    'respawn:Reštartovať reláciu na pozadí, aby bežala na aktuálnej verzii Claude Code'
    'rm:Odstrániť reláciu na pozadí a jej worktree, ak je to bezpečné'
    'auth:Správa autentizácie'
    'auto-mode:Zobraziť alebo resetovať konfiguráciu klasifikátora automatického režimu'
    'gateway:Spustiť podnikovú bránu autentizácie/telemetrie'
    'import:Importovať konfiguráciu z iného AI agenta na programovanie do Claude Code'
    'project:Správa stavu projektu Claude Code'
    'ultrareview:Spustiť cloudovú multi-agentovú kontrolu kódu a vypísať zistenia'
    'setup-token:Nastavenie tokenu pre dlhodobú autentizáciu (vyžaduje predplatné Claude)'
    'doctor:Kontrola zdravia systému automatických aktualizácií Claude Code'
    'update:Kontrola a inštalácia aktualizácií'
    'install:Inštalácia natívnej verzie Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Zapnúť režim ladenia s voliteľným filtrovaním kategórií (napr. "api,hooks" alebo "!statsig,!file")]:filter:'
    '--verbose[Prepísať nastavenie podrobného režimu z konfiguračného súboru]'
    '(-p --print)'{-p,--print}'[Vypísať odpoveď a ukončiť (pre použitie s pipe). Poznámka: používajte len v dôveryhodných adresároch]'
    '--output-format[Formát výstupu (s --print): "text" (predvolené), "json" (jeden výsledok), alebo "stream-json" (streamovanie v reálnom čase)]:format:(text json stream-json)'
    '--json-schema[JSON schéma pre validáciu štruktúrovaného výstupu]:schema:'
    '--include-partial-messages[Zahrnúť čiastočné fragmenty správ pri ich príchode (s --print a --output-format=stream-json)]'
    '--input-format[Formát vstupu (s --print): "text" (predvolené) alebo "stream-json" (streamovaný vstup v reálnom čase)]:format:(text stream-json)'
    '--mcp-debug[\[Zastarané. Použite --debug namiesto toho\] Zapnúť režim ladenia MCP (zobrazuje chyby MCP servera)]'
    '--dangerously-skip-permissions[Obísť všetky kontroly oprávnení. Odporúčané len pre sandboxové prostredia bez prístupu k internetu]'
    '--allow-dangerously-skip-permissions[Povoliť možnosť obídenia kontrol oprávnení bez povolenia v predvolenom nastavení]'
    '--restricted[Obmedzený režim: odstrániť nástroje, ktoré spúšťajú príkazy alebo kód, a WebFetch, ignorovať nastavenia user/project/local a obmedziť súborové nástroje na pracovné adresáre]'
    '--max-budget-usd[Maximálna suma v dolároch na míňanie na API volania (len --print)]:amount:'
    '--replay-user-messages[Znovu odoslať používateľské správy zo stdin na stdout pre potvrdenie]'
    '--allowed-tools[Zoznam povolených názvov nástrojov oddelených čiarkou alebo medzerou (napr. "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Zoznam povolených názvov nástrojov oddelených čiarkou alebo medzerou (formát camelCase)]:tools:'
    '--tools[Určiť zoznam dostupných nástrojov z vstavanej sady. Len v režime print]:tools:'
    '--disallowed-tools[Zoznam zakázaných názvov nástrojov oddelených čiarkou alebo medzerou (napr. "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Zoznam zakázaných názvov nástrojov oddelených čiarkou alebo medzerou (formát camelCase)]:tools:'
    '--mcp-config[Načítať MCP servery z JSON súboru alebo reťazca (oddelené medzerami)]:configs:'
    '--system-prompt[Systémový prompt pre použitie v relácii]:prompt:'
    '--system-prompt-file[Načítať systémový prompt zo súboru]:file:_files'
    '--append-system-prompt[Pripojiť systémový prompt k štandardnému systémovému promptu]:prompt:'
    '--append-system-prompt-file[Načítať systémový prompt zo súboru a pripojiť ho k predvolenému systémovému promptu]:file:_files'
    '--system-prompt-snapshot[Zaznamenať systémový prompt raz za konverzáciu a doslovne ho opätovne použiť pri každej požiadavke a obnove (on, predvolené), alebo ho vygenerovať nanovo pri každej požiadavke (off)]:mode:(on off)'
    '--permission-mode[Režim oprávnení pre použitie v relácii]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Kto odpovedá na výzvy na oprávnenia s --print: "host" (hostiteľ SDK alebo --permission-prompt-tool) alebo "none" (všetko, čo by vyžadovalo výzvu, sa zamietne)]:target:(host none)'
    '--permission-prompt-tool[MCP nástroj pre výzvy na oprávnenia (len --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Pokračovať v poslednej konverzácii]'
    '(-r --resume)'{-r,--resume}'[Obnoviť konverzáciu - zadajte identifikátor relácie alebo vyberte interaktívne]:sessionId:_claude_sessions'
    '--fork-session[Vytvoriť nový identifikátor relácie namiesto opätovného použitia pôvodného pri obnove (s --resume alebo --continue)]'
    '--no-session-persistence[Vypnúť perzistenciu relácií - relácie sa neuložia (len --print)]'
    '--model[Model pre aktuálnu reláciu. Zadajte alias pre najnovší model (napr. '\''sonnet'\'' alebo '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agent pre aktuálnu reláciu. Prepíše nastavenie '\''agent'\'']:agent:_claude_agent_names'
    '--betas[Beta hlavičky pre zahrnutie do API požiadaviek (len pre používateľov API kľúča)]:betas:'
    '--fallback-model[Povoliť automatické prepnutie na zadaný model keď je predvolený model preťažený (len --print)]:model:_claude_model_names'
    '--settings[Cesta k JSON súboru s nastavením alebo JSON reťazec pre načítanie dodatočných nastavení]:file-or-json:_files'
    '--add-dir[Ďalšie adresáre pre poskytnutie prístupu nástrojom]:directories:_directories'
    '--ide[Automaticky sa pripojiť k IDE pri spustení ak je dostupné práve jedno platné IDE]'
    '--desktop[Otvoriť v aplikácii Claude Desktop namiesto terminálu (s --continue alebo --resume <id> na výber relácie)]'
    '--strict-mcp-config[Použiť len MCP servery z --mcp-config a ignorovať všetky ostatné MCP nastavenia]'
    '--session-id[Konkrétny identifikátor relácie pre použitie v konverzácii (musí byť platné UUID)]:uuid:'
    '--agents[JSON objekt definujúci vlastné agenty]:json:'
    '--setting-sources[Zoznam zdrojov nastavení oddelených čiarkou pre načítanie (user, project, local)]:sources:'
    '--plugin-dir[Adresár pre načítanie pluginov len pre túto reláciu (možno opakovať)]:paths:_directories'
    '--disable-slash-commands[Vypnúť všetky lomkové príkazy]'
    '(--bg --background)'{--bg,--background}'[Spustiť reláciu ako agenta na pozadí a okamžite sa vrátiť]'
    '(-w --worktree)'{-w,--worktree}'[Vytvoriť nový git worktree pre túto reláciu (voliteľne zadajte názov)]::name:'
    '--tmux=-[Vytvoriť tmux reláciu pre worktree (vyžaduje --worktree). Ak sú dostupné, použije natívne panely iTerm2; --tmux=classic pre tradičný tmux]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Nastaviť zobrazovaný názov pre túto reláciu]:name:'
    '--effort[Úroveň úsilia pre aktuálnu reláciu]:level:(low medium high xhigh max)'
    '--autocompact[Veľkosť okna automatického zhutnenia (auto, alebo 100k-1M tokenov)]:size:(auto)'
    '--debug-file[Zapisovať ladiace záznamy do konkrétnej cesty súboru (implicitne zapne režim ladenia)]:path:_files'
    '--from-pr[Obnoviť reláciu prepojenú s PR podľa čísla/URL, alebo otvoriť interaktívny výber]::value:'
    '--teleport[Obnoviť teleport reláciu, voliteľne zadajte identifikátor relácie]::session:'
    '--cloud[Vytvoriť cloudovú reláciu so zadaným popisom, alebo sa pripojiť k existujúcej podľa identifikátora relácie alebo URL claude.ai/code]::description-or-session:'
    '--environment[Vytvoriť novú cloudovú reláciu, ktorá beží v zadanom vlastnom hostovanom prostredí (ccpool_...)]:environment_id:'
    '--remote-control[Spustiť interaktívnu reláciu so zapnutým vzdialeným ovládaním (voliteľne pomenovanú)]::name:'
    '--remote-control-session-name-prefix[Predpona pre automaticky generované názvy relácií vzdialeného ovládania]:prefix:'
    '--chrome[Zapnúť integráciu Claude v Chrome]'
    '--no-chrome[Vypnúť integráciu Claude v Chrome]'
    '--plugin-url[Načítať plugin .zip z URL len pre túto reláciu (možno opakovať)]:url:'
    '--file[Súborové zdroje na stiahnutie pri spustení (formát: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Zapnúť návrhy promptov (vygeneruje predpokladaný ďalší prompt v režime print/SDK)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Preposielať text a bloky uvažovania podagenta ako správy (s --print a stream-json)]'
    '--include-hook-events[Zahrnúť všetky udalosti životného cyklu hookov do výstupného streamu (s stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Presunúť sekcie špecifické pre stroj do prvej používateľskej správy pre zlepšenie opätovného využitia cache promptov]'
    '--brief[Zapnúť nástroj SendUserMessage pre komunikáciu agenta s používateľom]'
    '--safe-mode[Spustiť s vypnutými všetkými prispôsobeniami (užitočné pri riešení problémov s poškodenou konfiguráciou)]'
    '--bare[Minimálny režim: preskočiť hooky, LSP, synchronizáciu pluginov, atribúciu, automatickú pamäť a automatické zisťovanie CLAUDE.md]'
    '--ax-screen-reader[Vykresliť výstup vhodný pre čítačky obrazovky (plochý text, bez dekoratívnych okrajov alebo animácií)]'
    '(-v --version)'{-v,--version}'[Vypísať číslo verzie]'
    '(-h --help)'{-h,--help}'[Zobraziť pomoc pre príkaz]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'príkazy claude' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc pre príkaz]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "bez argumentov"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Spustiť MCP server Claude Code'
    'add:Pridať MCP server do Claude Code'
    'remove:Odstrániť MCP server'
    'list:Zobraziť zoznam nakonfigurovaných MCP serverov'
    'get:Získať detaily MCP servera'
    'add-json:Pridať MCP server (stdio alebo SSE) s JSON reťazcom'
    'add-from-claude-desktop:Importovať MCP servery z Claude Desktop (len Mac a WSL)'
    'reset-project-choices:Resetovať všetky schválené/odmietnuté servery s rozsahom projektu (.mcp.json) v tomto projekte'
    'login:Autentizovať sa s MCP serverom (HTTP, SSE alebo claude.ai konektor)'
    'logout:Vymazať uložené OAuth prihlasovacie údaje pre MCP server'
    'help:Zobraziť pomoc'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'príkazy mcp' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Zapnúť režim ladenia]' \
            '--verbose[Prepísať nastavenie podrobného režimu z konfiguračného súboru]' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Rozsah konfigurácie (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Typ transportu (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Nastaviť premennú prostredia (napr. -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Nastaviť WebSocket hlavičku]:header:' \
            '--client-id[OAuth client ID pre HTTP/SSE servery]:clientId:' \
            '--client-secret[Vyžiadať OAuth client secret (alebo nastavte premennú prostredia MCP_CLIENT_SECRET)]' \
            '--callback-port[Pevný port pre OAuth callback (pre servery vyžadujúce vopred registrované presmerovacie URI)]:port:' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Rozsah konfigurácie (local, user, project) - odstrániť z existujúceho rozsahu ak nie je zadané]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Rozsah konfigurácie (local, user, project)]:scope:(local user project)' \
            '--client-secret[Vyžiadať OAuth client secret (alebo nastavte premennú prostredia MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Rozsah konfigurácie (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]'
          ;;
        login)
          _arguments \
            '--no-browser[Vypísať autorizačnú URL namiesto otvorenia prehliadača (pre SSH/headless relácie)]' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Validovať plugin alebo manifest marketplace'
    'marketplace:Správa marketplace Claude Code'
    'list:Zobraziť zoznam nainštalovaných pluginov'
    'details:Zobraziť inventár komponentov a odhadovanú cenu v tokenoch pre plugin'
    'configure:Zobraziť možnosti pluginu a to, ktoré z nich nie sú nastavené, alebo uložiť hodnoty zo stdin'
    'install:Nainštalovať plugin z dostupných marketplace'
    'i:Nainštalovať plugin z dostupných marketplace (skratka pre install)'
    'init:Vytvoriť kostru nového pluginu (automaticky sa načíta v ďalšej relácii)'
    'new:Vytvoriť kostru nového pluginu (alias pre init)'
    'uninstall:Odinštalovať nainštalovaný plugin'
    'remove:Odinštalovať nainštalovaný plugin (alias pre uninstall)'
    'enable:Povoliť zakázaný plugin'
    'disable:Zakázať povolený plugin'
    'update:Aktualizovať plugin na najnovšiu verziu'
    'eval:Spustiť evaluačné prípady proti pluginu a nahlásiť ohodnotené výsledky'
    'prune:Odstrániť automaticky nainštalované závislosti, ktoré už nie sú potrebné'
    'autoremove:Odstrániť automaticky nainštalované závislosti, ktoré už nie sú potrebné (alias pre prune)'
    'tag:Vytvoriť git tag {name}--v{version} pre vydanie pluginu'
    'test:Spustiť testy modu'
    'help:Zobraziť pomoc'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'príkazy plugin' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Považovať varovania za chyby (návratový kód 1)]' \
            '--json[Vypísať správu o validácii ako JSON (rovnaké návratové kódy)]' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Rozsah inštalácie]:scope:(user project local)' \
            '*--config[Nastaviť možnosť userConfig deklarovanú v manifeste pluginu (možno opakovať)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Prijať zobrazený príkaz deklarovaný marketplace bez výzvy na potvrdenie]' \
            '--json[Vypísať jeden strojovo čitateľný riadok výsledku namiesto správy pre človeka]' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Rozsah inštalácie]:scope:(user project local)' \
            '--keep-data[Zachovať adresár perzistentných dát pluginu]' \
            '--prune[Odstrániť aj automaticky nainštalované závislosti, ktoré už nie sú potrebné]' \
            '(-y --yes)'{-y,--yes}'[Preskočiť výzvu na potvrdenie --prune]' \
            '--json[Vypísať jeden strojovo čitateľný riadok výsledku namiesto správy pre človeka (nie s --prune)]' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Rozsah inštalácie]:scope:(user project local)' \
            '--json[Vypísať jeden strojovo čitateľný riadok výsledku namiesto správy pre človeka]' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Zakázať všetky povolené pluginy]' \
            '(-s --scope)'{-s,--scope}'[Rozsah inštalácie]:scope:(user project local)' \
            '--json[Vypísať jeden strojovo čitateľný riadok výsledku namiesto správy pre človeka]' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Rozsah inštalácie]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Prijať zobrazený príkaz deklarovaný marketplace bez výzvy na potvrdenie]' \
            '--json[Vypísať jeden strojovo čitateľný riadok výsledku namiesto správy pre človeka]' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Výstup ako JSON]' \
            '--available[Zahrnúť dostupné pluginy z marketplace (vyžaduje --json)]' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Prečistiť v rozsahu]:scope:(user project local)' \
            '--dry-run[Vypísať, čo by sa odstránilo, bez odstránenia]' \
            '(-y --yes)'{-y,--yes}'[Preskočiť výzvu na potvrdenie]' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]'
          ;;
        configure)
          _arguments \
            '--json[Výstup ako JSON]' \
            '--values-stdin[Načítať hodnoty možností zo stdin ako JSON objekt jednoriadkových reťazcov; vynechané možnosti si ponechajú svoje hodnoty]' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Popis v manifeste]:text:' \
            '--author[Meno autora (predvolené: git config user.name)]:name:' \
            '--author-email[E-mail autora (predvolené: git config user.email)]:email:' \
            '--with[Komponenty, pre ktoré sa má tiež vytvoriť kostra]:components:' \
            '(-f --force)'{-f,--force}'[Prepísať existujúci .claude-plugin/ v cieli]' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Filtrovať prípady podľa glob vzoru názvu]:glob:' \
            '*--tag[Filtrovať prípady podľa značky (možno opakovať)]:tag:' \
            '--runs[Prepísať počet behov na prípad (predvolené: case.runs, inak 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Spustiť naraz až n behov agenta (1-8; predvolené 1)]:n:' \
            '--model[Prepísať model pre všetky prípady]:model:_claude_model_names' \
            '--judge-model[Prepísať model LLM hodnotiteľa (predvolené: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Pevný strop nákladov; pri jeho dosiahnutí prerušiť a nahlásiť čiastočné výsledky (návratový kód 2)]:usd:' \
            '--output-dir[Adresár pre aggregate-result.json]:dir:_directories' \
            '--eval-dir[Názov adresára (pod pluginom), ktorý obsahuje evaluačné prípady]:dir:' \
            '--json[Vypísať úplný výsledok behu ako JSON na stdout, alebo ho zapísať do tohto .json súboru]::path:_files' \
            '--threshold[Ukončiť s návratovým kódom 1, ak je skóre niektorého prípadu pod týmto prahom (predvolené: 1.0)]:threshold:' \
            '*--allow-tools[Povolenie operátora pre chránené nástroje (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Spustiť scaffold_script každého prípadu (spúšťa bash dodaný autorom pod vaším účtom; predvolene vypnuté)]' \
            '(--scaffold)--no-scaffold[Výslovne preskočiť scaffold_script]' \
            '--trust-plugin[Potvrdiť, že dôverujete tomuto pluginu a jeho evaluačnej sade, a preskočiť výzvu na dôveru pri prvom spustení (pre CI)]' \
            '--ablation[Spustiť kontrolnú skupinu bez pluginu a nahlásiť rozdiel skóre]:mode:(none with-without)' \
            '--mocks[Mock náhrady za MCP servery z <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[S --mocks record: spustiť aj skutočné procesy MCP serverov, ktoré nemajú mock]' \
            '--keep-temp[Zachovať adresáre kostry pre ladenie]' \
            '--verbose[Zapisovať trasovacie udalosti pre každú správu do ladiaceho záznamu]' \
            '--report[Zapísať samostatnú HTML správu do tejto cesty namiesto adresára výsledkov]:path:_files' \
            '(--no-publish)--publish-report[Vyžadovať aj zverejnenie správy na claude.ai]' \
            '(--publish-report)--no-publish[Ponechať HTML správu len lokálne; preskočiť jej zverejnenie na claude.ai]' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Po vytvorení odoslať tag do --remote]' \
            '--dry-run[Vypísať, čo by sa otagovalo, bez vytvorenia tagu]' \
            '(-f --force)'{-f,--force}'[Preskočiť kontroly nečistého pracovného stromu a už existujúceho tagu]' \
            '(-m --message)'{-m,--message}'[Správa anotácie tagu (použite %s pre verziu)]:msg:' \
            '--remote[Remote, do ktorého sa odošle s --push]:name:' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Pridať marketplace z URL, cesty alebo GitHub repozitára'
    'list:Zobraziť zoznam nakonfigurovaných marketplace'
    'remove:Odstrániť nakonfigurovaný marketplace'
    'rm:Odstrániť nakonfigurovaný marketplace (alias pre remove)'
    'update:Aktualizovať marketplace zo zdroja - aktualizovať všetky ak nie je zadaný názov'
    'help:Zobraziť pomoc'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'príkazy marketplace' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Obmedziť checkout na konkrétne adresáre pomocou git sparse-checkout (pre monorepozitáre)]:paths:' \
            '--scope[Kde deklarovať marketplace]:scope:(user project local)' \
            '--claudeai[Pridať marketplace s týmto názvom, ktorý pre vás hostuje claude.ai]' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Výstup ako JSON]' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Odstrániť deklaráciu marketplace z konkrétneho rozsahu nastavení (vynechajte na odstránenie zo všetkých rozsahov)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Vynútiť inštaláciu aj keď je už nainštalované]' \
    '(-h --help)'{-h,--help}'[Zobraziť pomoc]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Ďalší adresár pre poskytnutie prístupu nástrojom v odoslaných reláciách]:directory:_directories' \
    '--agent[Predvolený agent pre relácie odoslané z pohľadu agentov]:agent:_claude_agent_names' \
    '--all[S --json: zahrnúť aj dokončené relácie na pozadí]' \
    '--allow-dangerously-skip-permissions[Sprístupniť režim obídenia oprávnení pre odoslané relácie]' \
    '--cwd[Zobraziť len relácie na pozadí spustené pod cestou]:path:_directories' \
    '--dangerously-skip-permissions[Alias pre --permission-mode bypassPermissions]' \
    '--effort[Predvolená úroveň úsilia pre odoslané relácie]:level:(low medium high xhigh max)' \
    '--json[Vypísať aktívne relácie ako JSON pole a ukončiť]' \
    '*--mcp-config[Konfigurácia MCP servera pre aplikovanie na odoslané relácie]:config:' \
    '--model[Predvolený model pre relácie odoslané z pohľadu agentov]:model:_claude_model_names' \
    '--permission-mode[Predvolený režim oprávnení pre odoslané relácie]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Načítať pluginy z adresára pre pohľad agentov a odoslané relácie]:path:_directories' \
    '--setting-sources[Zoznam zdrojov nastavení oddelených čiarkou pre načítanie (user, project, local)]:sources:' \
    '--settings[Súbor nastavení alebo JSON reťazec na aplikovanie]:file-or-json:_files' \
    '--strict-mcp-config[Použiť len MCP servery z --mcp-config v odoslaných reláciách]' \
    '--restricted[Spúšťať odoslané relácie v obmedzenom režime]' \
    '(-h --help)'{-h,--help}'[Zobraziť pomoc pre príkaz]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Prihlásiť sa do vášho Anthropic účtu'
    'logout:Odhlásiť sa z vášho Anthropic účtu'
    'status:Zobraziť stav autentizácie'
    'help:Zobraziť pomoc'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Zobraziť pomoc pre príkaz]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'príkazy auth' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Vopred vyplniť e-mailovú adresu na prihlasovacej stránke]:email:' \
            '--sso[Vynútiť prihlásenie cez SSO]' \
            '(--claudeai)--console[Použiť Anthropic Console (účtovanie podľa využitia API) namiesto predplatného Claude]' \
            '(--console)--claudeai[Použiť predplatné Claude (predvolené)]' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc pre príkaz]'
          ;;
        status)
          _arguments \
            '(--text)--json[Výstup ako JSON (predvolené)]' \
            '(--json)--text[Výstup ako text čitateľný pre človeka]' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc pre príkaz]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc pre príkaz]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Vypísať efektívnu konfiguráciu automatického režimu ako JSON'
    'critique:Získať AI spätnú väzbu na vaše vlastné pravidlá automatického režimu'
    'defaults:Vypísať predvolené pravidlá automatického režimu ako JSON'
    'reset:Resetovať konfiguráciu automatického režimu na dodané predvolené hodnoty'
    'help:Zobraziť pomoc'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Zobraziť pomoc pre príkaz]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'príkazy auto-mode' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Prepísať, ktorý model sa použije]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc pre príkaz]'
          ;;
        defaults)
          _arguments \
            '--label[Zobraziť len pravidlá, ktorých označenie začína touto predponou (bez ohľadu na veľkosť písmen)]:prefix:' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc pre príkaz]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Preskočiť výzvu na potvrdenie]' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc pre príkaz]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc pre príkaz]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Cesta ku konfiguračnému YAML súboru brány]:path:_files' \
    '(-h --help)'{-h,--help}'[Zobraziť pomoc pre príkaz]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Odstrániť všetok stav Claude Code pre projekt (prepisy, úlohy, história súborov, konfiguračný záznam)'
    'help:Zobraziť pomoc'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Zobraziť pomoc pre príkaz]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'príkazy project' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Vypísať, čo by sa odstránilo, bez odstránenia čohokoľvek]' \
            '(-y --yes)'{-y,--yes}'[Preskočiť výzvu na potvrdenie]' \
            '(-i --interactive)'{-i,--interactive}'[Pred odstránením sa pýtať na každú položku]' \
            '(1)--all[Odstrániť stav pre všetky projekty (vzájomne sa vylučuje s cestou)]' \
            '(-h --help)'{-h,--help}'[Zobraziť pomoc pre príkaz]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Vypísať surové bugs.json dáta namiesto naformátovaných zistení]' \
    '--timeout[Maximálny počet minút na čakanie na dokončenie kontroly (predvolené: 45)]:minutes:' \
    '(--no-post)--post[Zverejniť zistenia dokončenej kontroly v PR vo vašom mene (len pre ciele PR; jeden obyčajný komentár, nie review)]' \
    '(--post)--no-post[Nezverejňovať zistenia v PR (predvolené)]' \
    '(-h --help)'{-h,--help}'[Zobraziť pomoc pre príkaz]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Reštartovať všetky bežiace relácie na pozadí]' \
    '(-h --help)'{-h,--help}'[Zobraziť pomoc pre príkaz]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Zahodiť aj neodoslané commity a necommitnuté zmeny worktree (zadajte commit@worktree-id, ktorý nahlásil predchádzajúci claude rm)]:commit@worktree-id:' \
    '--force-remove-worktree[Odstrániť adresár worktree, aj keď ho hook WorktreeRemove alebo git nedokázal odstrániť (zadajte worktree-id, ktorý nahlásil predchádzajúci claude rm)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Zobraziť pomoc pre príkaz]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Zobraziť, čo by sa importovalo, bez zápisu čohokoľvek]' \
    '--yes[Preskočiť interaktívny výber (na headless prostrediach zadajte --yes=<digest> z náhľadu /import)]' \
    '(-h --help)'{-h,--help}'[Zobraziť pomoc pre príkaz]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
