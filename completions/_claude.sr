#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Конфигурисање и управљање MCP серверима'
    'plugin:Управљање додацима Claude Code'
    'agents:Управљање позадинским агентима'
    'attach:Отвори позадинску сесију у овом терминалу'
    'logs:Испиши недавни терминалски излаз позадинске сесије'
    'stop:Заустави позадинску сесију (њен разговор се чува)'
    'respawn:Поново покрени позадинску сесију да би користила тренутну верзију Claude Code'
    'rm:Обриши позадинску сесију, и њен worktree када је то безбедно'
    'auth:Управљање аутентификацијом'
    'auto-mode:Преглед или ресетовање конфигурације класификатора аутоматског режима'
    'gateway:Покрени enterprise gateway за аутентификацију/телеметрију'
    'import:Увези конфигурацију из другог AI агента за кодирање у Claude Code'
    'project:Управљање стањем пројекта Claude Code'
    'ultrareview:Покрени преглед кода са више агената у облаку и испиши налазе'
    'setup-token:Подешавање токена за дугорочну аутентификацију (захтева Claude претплату)'
    'doctor:Провера здравља система аутоматских ажурирања Claude Code'
    'update:Провера и инсталација ажурирања'
    'install:Инсталација изворне верзије Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Укључи режим отклањања грешака са опционим филтрирањем категорија (нпр. "api,hooks" или "!statsig,!file")]:filter:'
    '--verbose[Препиши подешавање детаљног режима из конфигурационе датотеке]'
    '(-p --print)'{-p,--print}'[Испиши одговор и излаз (за коришћење са pipe). Напомена: користите само у поузданим директоријумима]'
    '--output-format[Формат излаза (са --print): "text" (подразумевано), "json" (један резултат), или "stream-json" (стримовање у реалном времену)]:format:(text json stream-json)'
    '--json-schema[JSON шема за валидацију структурираног излаза]:schema:'
    '--include-partial-messages[Укључи делимичне фрагменте порука приликом њиховог доласка (са --print и --output-format=stream-json)]'
    '--input-format[Формат улаза (са --print): "text" (подразумевано) или "stream-json" (стримовани унос у реалном времену)]:format:(text stream-json)'
    '--mcp-debug[\[Застарело. Користите --debug уместо тога\] Укључи режим отклањања грешака MCP (приказује грешке MCP сервера)]'
    '--dangerously-skip-permissions[Заобиђи све провере дозвола. Препоручено само за sandbox окружења без приступа интернету]'
    '--allow-dangerously-skip-permissions[Омогући опцију заобилажења провера дозвола без омогућавања по подразумеваном]'
    '--restricted[Ограничени режим: уклони алате који покрећу команде или код и WebFetch, занемари user/project/local подешавања и ограничи алате за датотеке на радне директоријуме]'
    '--max-budget-usd[Максимални износ у доларима за трошење на API позиве (само --print)]:amount:'
    '--replay-user-messages[Поново пошаљи корисничке поруке из stdin на stdout за потврду]'
    '--allowed-tools[Листа дозвољених имена алата одвојених зарезом или размаком (нпр. "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Листа дозвољених имена алата одвојених зарезом или размаком (формат camelCase)]:tools:'
    '--tools[Наведи листу доступних алата из уграђеног скупа. Само у режиму print]:tools:'
    '--disallowed-tools[Листа забрањених имена алата одвојених зарезом или размаком (нпр. "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Листа забрањених имена алата одвојених зарезом или размаком (формат camelCase)]:tools:'
    '--mcp-config[Учитај MCP сервере из JSON датотеке или низа (одвојени размацима)]:configs:'
    '--system-prompt[Системски промпт за коришћење у сесији]:prompt:'
    '--system-prompt-file[Учитај системски промпт из датотеке]:file:_files'
    '--append-system-prompt[Додај системски промпт подразумеваном системском промпту]:prompt:'
    '--append-system-prompt-file[Учитај системски промпт из датотеке и додај га подразумеваном системском промпту]:file:_files'
    '--system-prompt-snapshot[Забележи системски промпт једном по разговору и користи га дословно при сваком захтеву и наставку (on, подразумевано) или га генериши изнова при сваком захтеву (off)]:mode:(on off)'
    '--permission-mode[Режим дозвола за коришћење у сесији]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Ко одговара на упите за дозволе са --print: "host" (SDK домаћин или --permission-prompt-tool) или "none" (све што би тражило потврду се одбија)]:target:(host none)'
    '--permission-prompt-tool[MCP алат за упите за дозволе (само --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Настави последњи разговор]'
    '(-r --resume)'{-r,--resume}'[Настави разговор - наведите идентификатор сесије или изаберите интерактивно]:sessionId:_claude_sessions'
    '--fork-session[Креирај нови идентификатор сесије уместо поновне употребе оригиналног приликом наставка (са --resume или --continue)]'
    '--no-session-persistence[Онемогући трајност сесије - сесије неће бити сачуване (само --print)]'
    '--model[Модел за тренутну сесију. Наведите надимак за најновији модел (нпр. '\''sonnet'\'' или '\''opus'\'')]:model:_claude_model_names'
    '--agent[Агент за тренутну сесију. Замењује подешавање '\''agent'\'']:agent:_claude_agent_names'
    '--betas[Beta заглавља која се укључују у API захтеве (само корисници API кључа)]:betas:'
    '--fallback-model[Омогући автоматско пребацивање на наведени модел када је подразумевани модел преоптерећен (само --print)]:model:_claude_model_names'
    '--settings[Путања до JSON датотеке са подешавањима или JSON низ за учитавање додатних подешавања]:file-or-json:_files'
    '--add-dir[Додатни директоријуми за пружање приступа алатима]:directories:_directories'
    '--ide[Аутоматски се повежи са IDE приликом покретања ако је доступан тачно један валидан IDE]'
    '--desktop[Отвори у апликацији Claude Desktop уместо у терминалу (са --continue или --resume <id> за избор сесије)]'
    '--strict-mcp-config[Користи само MCP сервере из --mcp-config и занемари сва друга MCP подешавања]'
    '--session-id[Одређени идентификатор сесије за коришћење у разговору (мора бити валидан UUID)]:uuid:'
    '--agents[JSON објекат који дефинише прилагођене агенте]:json:'
    '--setting-sources[Листа извора подешавања одвојених зарезом за учитавање (user, project, local)]:sources:'
    '--plugin-dir[Директоријум за учитавање додатака само за ову сесију (може се понављати)]:paths:_directories'
    '--disable-slash-commands[Онемогући све slash команде]'
    '(--bg --background)'{--bg,--background}'[Покрени сесију као позадински агент и одмах се врати]'
    '(-w --worktree)'{-w,--worktree}'[Креирај нови git worktree за ову сесију (опционо наведите име)]::name:'
    '--tmux=-[Креирај tmux сесију за worktree (захтева --worktree). Користи изворне iTerm2 панеле када су доступни; --tmux=classic за традиционални tmux]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Постави приказно име за ову сесију]:name:'
    '--effort[Ниво напора за тренутну сесију]:level:(low medium high xhigh max)'
    '--autocompact[Величина прозора за аутоматско сажимање (auto, или 100k-1M токена)]:size:(auto)'
    '--debug-file[Уписуј логове отклањања грешака у одређену путању датотеке (имплицитно омогућава режим отклањања грешака)]:path:_files'
    '--from-pr[Настави сесију повезану са PR-ом по броју/URL-у, или отвори интерактивни бирач]::value:'
    '--teleport[Настави teleport сесију, опционо наведите идентификатор сесије]::session:'
    '--cloud[Креирај сесију у облаку са датим описом, или се повежи са постојећом по идентификатору сесије или claude.ai/code URL-у]::description-or-session:'
    '--environment[Креирај нову сесију у облаку која ради у датом самостално хостованом окружењу (ccpool_...)]:environment_id:'
    '--remote-control[Покрени интерактивну сесију са омогућеном даљинском контролом (опционо именована)]::name:'
    '--remote-control-session-name-prefix[Префикс за аутоматски генерисана имена сесија даљинске контроле]:prefix:'
    '--chrome[Омогући интеграцију Claude у Chrome]'
    '--no-chrome[Онемогући интеграцију Claude у Chrome]'
    '--plugin-url[Преузми .zip додатка са URL-а само за ову сесију (може се понављати)]:url:'
    '--file[Ресурси датотека за преузимање при покретању (формат: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Омогући предлоге промптова (емитује предвиђени следећи промпт у print/SDK режиму)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Прослеђуј текст подагента и блокове размишљања као поруке (са --print и stream-json)]'
    '--include-hook-events[Укључи све hook догађаје животног циклуса у излазни ток (са stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Премести секције специфичне за машину у прву корисничку поруку ради бољег поновног коришћења кеша промпта]'
    '--brief[Омогући алат SendUserMessage за комуникацију од агента ка кориснику]'
    '--safe-mode[Покрени са свим прилагођавањима онемогућеним (корисно за решавање проблема са неисправном конфигурацијом)]'
    '--bare[Минимални режим: прескочи hook-ове, LSP, синхронизацију додатака, атрибуцију, аутоматску меморију и аутоматско откривање CLAUDE.md]'
    '--ax-screen-reader[Прикажи излаз прилагођен читачима екрана (равни текст, без декоративних оквира или анимација)]'
    '(-v --version)'{-v,--version}'[Испиши број верзије]'
    '(-h --help)'{-h,--help}'[Прикажи помоћ за команду]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'команде claude' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Прикажи помоћ за команду]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "без аргумената"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Покрени MCP сервер Claude Code'
    'add:Додај MCP сервер у Claude Code'
    'remove:Уклони MCP сервер'
    'list:Прикажи листу конфигурисаних MCP сервера'
    'get:Преузми детаље MCP сервера'
    'add-json:Додај MCP сервер (stdio или SSE) са JSON низом'
    'add-from-claude-desktop:Увези MCP сервере из Claude Desktop (само Mac и WSL)'
    'reset-project-choices:Ресетуј све одобрене/одбијене сервере са опсегом пројекта (.mcp.json) у овом пројекту'
    'login:Аутентификуј се са MCP сервером (HTTP, SSE или claude.ai конектор)'
    'logout:Обриши сачуване OAuth акредитиве за MCP сервер'
    'help:Прикажи помоћ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'команде mcp' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Укључи режим отклањања грешака]' \
            '--verbose[Препиши подешавање детаљног режима из конфигурационе датотеке]' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Опсег конфигурације (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Тип преноса (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Постави променљиву окружења (нпр. -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Постави WebSocket заглавље]:header:' \
            '--client-id[OAuth ID клијента за HTTP/SSE сервере]:clientId:' \
            '--client-secret[Затражи OAuth тајну клијента (или поставите променљиву окружења MCP_CLIENT_SECRET)]' \
            '--callback-port[Фиксни порт за OAuth повратни позив (за сервере који захтевају унапред регистроване URI-је за преусмеравање)]:port:' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Опсег конфигурације (local, user, project) - уклони из постојећег опсега ако није наведено]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Опсег конфигурације (local, user, project)]:scope:(local user project)' \
            '--client-secret[Затражи OAuth тајну клијента (или поставите променљиву окружења MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Опсег конфигурације (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]'
          ;;
        login)
          _arguments \
            '--no-browser[Испиши URL за ауторизацију уместо отварања прегледача (за SSH/headless сесије)]' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Валидирај додатак или манифест тржишта'
    'marketplace:Управљање тржиштима Claude Code'
    'list:Прикажи листу инсталираних додатака'
    'details:Прикажи инвентар компоненти и пројектовану цену токена за додатак'
    'configure:Прикажи опције додатка и које нису постављене, или сачувај вредности из stdin'
    'install:Инсталирај додатак из доступних тржишта'
    'i:Инсталирај додатак из доступних тржишта (кратица за install)'
    'init:Направи скелет новог додатка (аутоматски се учитава у следећој сесији)'
    'new:Направи скелет новог додатка (надимак за init)'
    'uninstall:Деинсталирај инсталирани додатак'
    'remove:Деинсталирај инсталирани додатак (надимак за uninstall)'
    'enable:Омогући онемогућени додатак'
    'disable:Онемогући омогућени додатак'
    'update:Ажурирај додатак на најновију верзију'
    'eval:Покрени eval случајеве над додатком и пријави оцењене резултате'
    'prune:Уклони аутоматски инсталиране зависности које више нису потребне'
    'autoremove:Уклони аутоматски инсталиране зависности које више нису потребне (надимак за prune)'
    'tag:Креирај git таг {name}--v{version} за издање додатка'
    'test:Покрени тестове мода'
    'help:Прикажи помоћ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'команде plugin' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Третирај упозорења као грешке (излазни код 1)]' \
            '--json[Испиши извештај о валидацији као JSON (исти излазни кодови)]' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Опсег инсталације]:scope:(user project local)' \
            '*--config[Постави userConfig опцију декларисану у манифесту додатка (може се понављати)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Прихвати приказану команду коју декларише тржиште без упита за потврду]' \
            '--json[Испиши један машински читљив ред резултата уместо поруке за људе]' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Опсег инсталације]:scope:(user project local)' \
            '--keep-data[Задржи директоријум трајних података додатка]' \
            '--prune[Уклони и аутоматски инсталиране зависности које више нису потребне]' \
            '(-y --yes)'{-y,--yes}'[Прескочи упит за потврду за --prune]' \
            '--json[Испиши један машински читљив ред резултата уместо поруке за људе (не са --prune)]' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Опсег инсталације]:scope:(user project local)' \
            '--json[Испиши један машински читљив ред резултата уместо поруке за људе]' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Онемогући све омогућене додатке]' \
            '(-s --scope)'{-s,--scope}'[Опсег инсталације]:scope:(user project local)' \
            '--json[Испиши један машински читљив ред резултата уместо поруке за људе]' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Опсег инсталације]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Прихвати приказану команду коју декларише тржиште без упита за потврду]' \
            '--json[Испиши један машински читљив ред резултата уместо поруке за људе]' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Испиши као JSON]' \
            '--available[Укључи доступне додатке из тржишта (захтева --json)]' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Очисти у опсегу]:scope:(user project local)' \
            '--dry-run[Прикажи шта би било уклоњено без уклањања]' \
            '(-y --yes)'{-y,--yes}'[Прескочи упит за потврду]' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]'
          ;;
        configure)
          _arguments \
            '--json[Испиши као JSON]' \
            '--values-stdin[Учитај вредности опција из stdin као JSON објекат једноредних стрингова; изостављене опције задржавају своје вредности]' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Опис манифеста]:text:' \
            '--author[Име аутора (подразумевано: git config user.name)]:name:' \
            '--author-email[Имејл аутора (подразумевано: git config user.email)]:email:' \
            '--with[Компоненте за које се такође прави скелет]:components:' \
            '(-f --force)'{-f,--force}'[Препиши постојећи .claude-plugin/ на циљној локацији]' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Филтрирај случајеве по glob шаблону имена]:glob:' \
            '*--tag[Филтрирај случајеве по ознаци (може се понављати)]:tag:' \
            '--runs[Замени број покретања по случају (подразумевано: case.runs, иначе 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Изврши до n покретања агента истовремено (1-8; подразумевано 1)]:n:' \
            '--model[Замени модел за све случајеве]:model:_claude_model_names' \
            '--judge-model[Замени модел LLM оцењивача (подразумевано: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Чврста горња граница трошкова; ако се достигне, прекини и пријави делимичне резултате (излазни код 2)]:usd:' \
            '--output-dir[Директоријум за aggregate-result.json]:dir:_directories' \
            '--eval-dir[Име директоријума (унутар додатка) који садржи eval случајеве]:dir:' \
            '--json[Испиши цео резултат покретања као JSON на stdout, или га упиши у ову .json датотеку]::path:_files' \
            '--threshold[Изађи са излазним кодом 1 ако је оцена неког случаја испод овог прага (подразумевано: 1.0)]:threshold:' \
            '*--allow-tools[Дозвола оператора за ограничене алате (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Покрени scaffold_script сваког случаја (покреће bash који је доставио аутор под вашим налогом; подразумевано искључено)]' \
            '(--scaffold)--no-scaffold[Експлицитно прескочи scaffold_script]' \
            '--trust-plugin[Потврди да верујете овом додатку и његовом eval скупу, прескачући упит о поверењу при првом покретању (за CI)]' \
            '--ablation[Покрени контролну групу без додатка и пријави разлику у оцени]:mode:(none with-without)' \
            '--mocks[Лажне замене (mock) за MCP сервере, из <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Са --mocks record: покрени и стварне процесе MCP сервера који немају mock]' \
            '--keep-temp[Задржи директоријуме скелета ради отклањања грешака]' \
            '--verbose[Бележи догађаје праћења по поруци у лог отклањања грешака]' \
            '--report[Упиши самостални HTML извештај у ову путању уместо у директоријум резултата]:path:_files' \
            '(--no-publish)--publish-report[Захтевај и објављивање извештаја на claude.ai]' \
            '(--publish-report)--no-publish[Задржи HTML извештај само локално; прескочи објављивање на claude.ai]' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Пошаљи таг на --remote након креирања]' \
            '--dry-run[Испиши шта би било означено тагом без креирања]' \
            '(-f --force)'{-f,--force}'[Прескочи провере измењеног радног стабла и већ постојећег тага]' \
            '(-m --message)'{-m,--message}'[Порука анотације тага (користите %s за верзију)]:msg:' \
            '--remote[Remote на који се шаље са --push]:name:' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Додај тржиште из URL, путање или GitHub репозиторијума'
    'list:Прикажи листу конфигурисаних тржишта'
    'remove:Уклони конфигурисано тржиште'
    'rm:Уклони конфигурисано тржиште (надимак за remove)'
    'update:Ажурирај тржиште из извора - ажурирај све ако име није наведено'
    'help:Прикажи помоћ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'команде marketplace' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Ограничи checkout на одређене директоријуме преко git sparse-checkout (за monorepo-е)]:paths:' \
            '--scope[Где декларисати тржиште]:scope:(user project local)' \
            '--claudeai[Додај тржиште са овим именом које claude.ai хостује за вас]' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Испиши као JSON]' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Уклони декларацију тржишта из одређеног опсега подешавања (изоставите да бисте је уклонили из свих опсега)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Присилна инсталација чак и ако је већ инсталирано]' \
    '(-h --help)'{-h,--help}'[Прикажи помоћ]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Додатни директоријум за пружање приступа алатима у отпремљеним сесијама]:directory:_directories' \
    '--agent[Подразумевани агент за сесије отпремљене из приказа агената]:agent:_claude_agent_names' \
    '--all[Са --json: укључи и завршене позадинске сесије]' \
    '--allow-dangerously-skip-permissions[Учини режим заобилажења дозвола доступним отпремљеним сесијама]' \
    '--cwd[Прикажи само позадинске сесије покренуте под путањом]:path:_directories' \
    '--dangerously-skip-permissions[Надимак за --permission-mode bypassPermissions]' \
    '--effort[Подразумевани ниво напора за отпремљене сесије]:level:(low medium high xhigh max)' \
    '--json[Испиши активне сесије као JSON низ и изађи]' \
    '*--mcp-config[Конфигурација MCP сервера за примену на отпремљене сесије]:config:' \
    '--model[Подразумевани модел за сесије отпремљене из приказа агената]:model:_claude_model_names' \
    '--permission-mode[Подразумевани режим дозвола за отпремљене сесије]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Учитај додатке из директоријума за приказ агената и отпремљене сесије]:path:_directories' \
    '--setting-sources[Листа извора подешавања одвојених зарезом за учитавање (user, project, local)]:sources:' \
    '--settings[Датотека подешавања или JSON низ за примену]:file-or-json:_files' \
    '--strict-mcp-config[Користи само MCP сервере из --mcp-config у отпремљеним сесијама]' \
    '--restricted[Покрени отпремљене сесије у ограниченом режиму]' \
    '(-h --help)'{-h,--help}'[Прикажи помоћ за команду]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Пријави се на свој Anthropic налог'
    'logout:Одјави се са свог Anthropic налога'
    'status:Прикажи статус аутентификације'
    'help:Прикажи помоћ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Прикажи помоћ за команду]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'команде auth' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Унапред попуни имејл адресу на страници за пријаву]:email:' \
            '--sso[Принудно користи SSO ток пријаве]' \
            '(--claudeai)--console[Користи Anthropic Console (наплата према коришћењу API-ја) уместо Claude претплате]' \
            '(--console)--claudeai[Користи Claude претплату (подразумевано)]' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ за команду]'
          ;;
        status)
          _arguments \
            '(--text)--json[Испиши као JSON (подразумевано)]' \
            '(--json)--text[Испиши као текст читљив за људе]' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ за команду]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Прикажи помоћ за команду]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Испиши ефективну конфигурацију аутоматског режима као JSON'
    'critique:Добиј AI повратне информације о својим прилагођеним правилима аутоматског режима'
    'defaults:Испиши подразумевана правила аутоматског режима као JSON'
    'reset:Ресетуј конфигурацију аутоматског режима на испоручене подразумеване вредности'
    'help:Прикажи помоћ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Прикажи помоћ за команду]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'команде auto-mode' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Замени модел који се користи]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ за команду]'
          ;;
        defaults)
          _arguments \
            '--label[Прикажи само правила чија ознака почиње овим префиксом (без разлике великих и малих слова)]:prefix:' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ за команду]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Прескочи упит за потврду]' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ за команду]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Прикажи помоћ за команду]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Путања до YAML конфигурације gateway-а]:path:_files' \
    '(-h --help)'{-h,--help}'[Прикажи помоћ за команду]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Обриши сво стање Claude Code за пројекат (транскрипте, задатке, историју датотека, конфигурациони унос)'
    'help:Прикажи помоћ'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Прикажи помоћ за команду]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'команде project' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Прикажи шта би било обрисано без брисања било чега]' \
            '(-y --yes)'{-y,--yes}'[Прескочи упит за потврду]' \
            '(-i --interactive)'{-i,--interactive}'[Затражи потврду за сваку ставку пре брисања]' \
            '(1)--all[Обриши стање за сваки пројекат (међусобно искључиво са путањом)]' \
            '(-h --help)'{-h,--help}'[Прикажи помоћ за команду]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Испиши сирови bugs.json садржај уместо форматираних налаза]' \
    '--timeout[Максималан број минута за чекање да се преглед заврши (подразумевано: 45)]:minutes:' \
    '(--no-post)--post[Објави налазе завршеног прегледа на PR под вашим налогом (само за PR циљеве; један обичан коментар, не преглед)]' \
    '(--post)--no-post[Не објављуј налазе на PR (подразумевано)]' \
    '(-h --help)'{-h,--help}'[Прикажи помоћ за команду]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Поново покрени сваку активну позадинску сесију]' \
    '(-h --help)'{-h,--help}'[Прикажи помоћ за команду]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Одбаци и непослате commit-ове и некомитоване измене worktree-а (проследите commit@worktree-id који је пријавио претходни claude rm)]:commit@worktree-id:' \
    '--force-remove-worktree[Обриши директоријум worktree-а иако WorktreeRemove hook или git нису успели да га уклоне (проследите worktree-id који је пријавио претходни claude rm)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Прикажи помоћ за команду]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Прикажи шта би било увезено без уписивања било чега]' \
    '--yes[Прескочи интерактивни бирач (на headless окружењима проследите --yes=<digest> из /import прегледа)]' \
    '(-h --help)'{-h,--help}'[Прикажи помоћ за команду]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
