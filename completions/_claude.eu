#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:MCP zerbitzariak konfiguratu eta kudeatu'
    'plugin:Claude Code pluginak kudeatu'
    'agents:Atzeko planoko agenteak kudeatu'
    'attach:Atzeko planoko saio bat terminal honetan ireki'
    'logs:Atzeko planoko saio baten azken terminal irteera inprimatu'
    'stop:Atzeko planoko saio bat gelditu (bere elkarrizketa gordetzen da)'
    'respawn:Atzeko planoko saio bat berrabiarazi Claude Code-ren uneko bertsioa exekuta dezan'
    'rm:Atzeko planoko saio bat ezabatu, baita bere worktree-a ere segurua denean'
    'auth:Autentifikazioa kudeatu'
    'auto-mode:Modu automatikoaren sailkatzailearen konfigurazioa ikuskatu edo berrezarri'
    'gateway:Enpresako autentifikazio/telemetria atebidea exekutatu'
    'import:Beste AA kodetze agente baten konfigurazioa Claude Code-ra inportatu'
    'project:Claude Code proiektuaren egoera kudeatu'
    'ultrareview:Hodian ostatatutako agente anitzeko kode berrikuspena exekutatu eta aurkikuntzak inprimatu'
    'setup-token:Epe luzerako autentifikazio tokena konfiguratu (Claude harpidetza behar du)'
    'doctor:Claude Code eguneratzaile automatikoaren osasun egiaztapena'
    'update:Eguneraketak egiaztatu eta instalatu'
    'install:Claude Code jatorrizko eraikina instalatu'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Arazketaren modua aktibatu kategoria iragazki aukerakoarekin (adib: "api,hooks" edo "!statsig,!file")]:filter:'
    '--verbose[Konfigurazio fitxategiko xehetasun moduaren ezarpena gainidatzi]'
    '(-p --print)'{-p,--print}'[Erantzuna inprimatu eta irten (hodietan erabiltzeko). Oharra: fidagarriak diren direktorioak soilik erabili]'
    '--output-format[Irteera formatua (--print-ekin): "text" (lehenetsia), "json" (emaitza bakarra), edo "stream-json" (denbora errealeko streaming-a)]:format:(text json stream-json)'
    '--json-schema[JSON eskema irteera egituratuaren balioztapenerako]:schema:'
    '--include-partial-messages[Mezu zatikako zatiak gehitu iristen diren heinean (--print eta --output-format=stream-json-ekin)]'
    '--input-format[Sarrera formatua (--print-ekin): "text" (lehenetsia) edo "stream-json" (denbora errealeko streaming sarrera)]:format:(text stream-json)'
    '--mcp-debug[\[Zaharkitua. --debug erabili honen ordez\] MCP arazketaren modua aktibatu (MCP zerbitzariaren erroreak erakusten ditu)]'
    '--dangerously-skip-permissions[Baimen egiaztapen guztiak saltatu. Interneterako sarbiderik ez duten sandbox-etarako soilik gomendatua]'
    '--allow-dangerously-skip-permissions[Baimen egiaztapenak saltatzeko aukera gaitu lehenetsi gabe]'
    '--restricted[Modu murriztua: komandoak edo kodea exekutatzen dituzten tresnak eta WebFetch kendu, user/project/local ezarpenak ezikusi, eta fitxategi tresnak lan direktorioetara mugatu]'
    '--max-budget-usd[API deietan gastatzeko gehienezko dolar kopurua (--print soilik)]:amount:'
    '--replay-user-messages[Erabiltzailearen mezuak stdin-etik stdout-era berriz bidali baieztapenerako]'
    '--allowed-tools[Komaz edo zuriunez bereizitako baimendutako tresna izenen zerrenda (adib: "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Komaz edo zuriunez bereizitako baimendutako tresna izenen zerrenda (camelCase formatua)]:tools:'
    '--tools[Eraikitako multzo-tik erabilgarri dauden tresnen zerrenda zehaztu. Inprimatze modua soilik]:tools:'
    '--disallowed-tools[Komaz edo zuriunez bereizitako debekatutako tresna izenen zerrenda (adib: "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Komaz edo zuriunez bereizitako debekatutako tresna izenen zerrenda (camelCase formatua)]:tools:'
    '--mcp-config[MCP zerbitzariak JSON fitxategitik edo katetik kargatu (zuriunez bereizita)]:configs:'
    '--system-prompt[Saioan erabili beharreko sistemaren gonbita]:prompt:'
    '--system-prompt-file[Sistemaren gonbita fitxategi batetik irakurri]:file:_files'
    '--append-system-prompt[Sistemaren gonbita lehenetsiari sistemaren gonbita gehitu]:prompt:'
    '--append-system-prompt-file[Sistemaren gonbita fitxategi batetik irakurri eta sistemaren gonbita lehenetsiari gehitu]:file:_files'
    '--system-prompt-snapshot[Sistemaren gonbita elkarrizketa bakoitzeko behin grabatu eta hitzez hitz berrerabili eskaera eta berrekite guztietan (on, lehenetsia) edo eskaera bakoitzean berriro errendatu (off)]:mode:(on off)'
    '--permission-mode[Saioan erabili beharreko baimen modua]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Nork erantzuten dien baimen galderei --print-ekin: "host" (SDK ostalaria edo --permission-prompt-tool) edo "none" (galdera eragingo lukeen guztia ukatzen da)]:target:(host none)'
    '--permission-prompt-tool[Baimen galderetarako erabili beharreko MCP tresna (--print soilik)]:tool:'
    '(-c --continue)'{-c,--continue}'[Azken elkarrizketa jarraitu]'
    '(-r --resume)'{-r,--resume}'[Elkarrizketa berrekin - saio IDa zehaztu edo interaktiboki hautatu]:sessionId:_claude_sessions'
    '--fork-session[Saio ID berria sortu jatorrizko saio IDa berrerabili beharrean berriro hasieratzerakoan (--resume edo --continue-ekin)]'
    '--no-session-persistence[Saioaren iraunkortasuna desgaitu - saioak ez dira gordeko (--print soilik)]'
    '--model[Uneko saiorako modeloa. Azken modeloaren aliasa zehaztu (adib: '\''sonnet'\'' edo '\''opus'\'')]:model:_claude_model_names'
    '--agent[Uneko saiorako agentea. '\''agent'\'' ezarpena gainidazten du]:agent:_claude_agent_names'
    '--betas[API eskaeretan sartu beharreko beta goiburuak (API gako erabiltzaileak soilik)]:betas:'
    '--fallback-model[Modelo lehenetsia gainkargatuta dagoenean zehaztutako modelora aldaketa automatikoa gaitu (--print soilik)]:model:_claude_model_names'
    '--settings[Konfigurazio JSON fitxategirako bidea edo JSON katea konfigurazio gehigarria kargatzeko]:file-or-json:_files'
    '--add-dir[Tresnetarako sarbidea baimendu beharreko direktorio gehigarriak]:directories:_directories'
    '--ide[Hasieran IDEra automatikoki konektatu IDE baliozkoa bat soilik erabilgarri badago]'
    '--desktop[Claude Desktop aplikazioan ireki terminalaren ordez (--continue edo --resume <id>-rekin saioa hautatzeko)]'
    '--strict-mcp-config[--mcp-config-ko MCP zerbitzariak soilik erabili eta beste MCP ezarpen guztiak ezikusi]'
    '--session-id[Elkarrizketarako erabili beharreko saio ID zehatza (UUID baliozkoa izan behar du)]:uuid:'
    '--agents[Agente pertsonalizatuak definitzen dituen JSON objektua]:json:'
    '--setting-sources[Kargatu beharreko konfigurazio iturrien komaz bereizitako zerrenda (user, project, local)]:sources:'
    '--plugin-dir[Saio honetarako soilik pluginak kargatzeko direktorioa (errepikagarria)]:paths:_directories'
    '--disable-slash-commands[Barra komando guztiak desgaitu]'
    '(--bg --background)'{--bg,--background}'[Saioa atzeko planoko agente gisa abiarazi eta berehala itzuli]'
    '(-w --worktree)'{-w,--worktree}'[Saio honetarako git worktree berri bat sortu (aukeran izena zehaztu)]::name:'
    '--tmux=-[worktree-rako tmux saio bat sortu (--worktree behar du). iTerm2-ren panel natiboak erabiltzen ditu erabilgarri daudenean; --tmux=classic tmux tradizionalerako]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Saio honetarako bistaratze izena ezarri]:name:'
    '--effort[Uneko saiorako esfortzu maila]:level:(low medium high xhigh max)'
    '--autocompact[Trinkotze automatikoaren leiho tamaina (auto, edo 100k-1M token)]:size:(auto)'
    '--debug-file[Arazketa erregistroak fitxategi bide zehatz batean idatzi (arazketa modua inplizituki gaitzen du)]:path:_files'
    '--from-pr[PR bati zenbaki/URL bidez lotutako saio bat berrekin, edo hautatzaile interaktiboa ireki]::value:'
    '--teleport[Teleport saio bat berrekin, aukeran saio IDa zehaztu]::session:'
    '--cloud[Emandako deskribapenarekin hodeiko saio bat sortu, edo lehendik dagoen batera lotu saio IDaren edo claude.ai/code URLaren bidez]::description-or-session:'
    '--environment[Emandako norberak ostatatutako ingurunean exekutatzen den hodeiko saio berri bat sortu (ccpool_...)]:environment_id:'
    '--remote-control[Urruneko Kontrola gaituta duen saio interaktibo bat abiarazi (aukeran izenduna)]::name:'
    '--remote-control-session-name-prefix[Automatikoki sortutako Urruneko Kontrol saio izenetarako aurrizkia]:prefix:'
    '--chrome[Chrome-n Claude integrazioa gaitu]'
    '--no-chrome[Chrome-n Claude integrazioa desgaitu]'
    '--plugin-url[Saio honetarako soilik plugin .zip bat URL batetik eskuratu (errepikagarria)]:url:'
    '--file[Hasieran deskargatu beharreko fitxategi baliabideak (formatua: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Gonbita iradokizunak gaitu (hurrengo gonbita iragarritako bat igortzen du print/SDK moduan)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Azpiagente testua eta pentsamendu blokeak mezu gisa birbidali (--print eta stream-json-ekin)]'
    '--include-hook-events[Hook-en bizitza zikloko gertaera guztiak irteera korrontean sartu (stream-json-ekin)]'
    '--exclude-dynamic-system-prompt-sections[Makinako atalak lehen erabiltzaile mezura eraman gonbita-cachearen berrerabilpena hobetzeko]'
    '--brief[SendUserMessage tresna gaitu agentetik erabiltzailerako komunikaziorako]'
    '--safe-mode[Pertsonalizazio guztiak desgaituta abiarazi (konfigurazio hautsi bat konpontzeko erabilgarria)]'
    '--bare[Modu minimoa: hook-ak, LSP, plugin sinkronizazioa, egiletza, auto-memoria eta CLAUDE.md auto-aurkikuntza saltatu]'
    '--ax-screen-reader[Pantaila irakurgailurako irteera egokia errendatu (testu laua, apaindurazko ertzik edo animaziorik gabe)]'
    '(-v --version)'{-v,--version}'[Bertsio zenbakia erakutsi]'
    '(-h --help)'{-h,--help}'[Komandoaren laguntza erakutsi]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude komandoak' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Komandoaren laguntza erakutsi]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "argumenturik ez"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Claude Code MCP zerbitzaria abiarazi'
    'add:MCP zerbitzaria Claude Code-ri gehitu'
    'remove:MCP zerbitzaria kendu'
    'list:Konfiguratutako MCP zerbitzariak zerrendatu'
    'get:MCP zerbitzariaren xehetasunak lortu'
    'add-json:MCP zerbitzaria (stdio edo SSE) JSON katearekin gehitu'
    'add-from-claude-desktop:MCP zerbitzariak Claude Desktop-etik inportatu (Mac eta WSL soilik)'
    'reset-project-choices:Proiektu honetako proiektu esparru (.mcp.json) onartutako/ukatutako zerbitzari guztiak berrezarri'
    'login:MCP zerbitzari batekin autentifikatu (HTTP, SSE edo claude.ai konektorea)'
    'logout:MCP zerbitzari baten gordetako OAuth kredentzialak garbitu'
    'help:Laguntza erakutsi'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp komandoak' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Arazketaren modua aktibatu]' \
            '--verbose[Konfigurazio fitxategiko xehetasun moduaren ezarpena gainidatzi]' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurazio esparrua (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Garraio mota (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Ingurune aldagaia ezarri (adib: -e GAKOA=balioa)]:env:' \
            '(-H --header)'{-H,--header}'[WebSocket goiburua ezarri]:header:' \
            '--client-id[HTTP/SSE zerbitzarietarako OAuth bezero IDa]:clientId:' \
            '--client-secret[OAuth bezero sekretua eskatu (edo MCP_CLIENT_SECRET ingurune aldagaia ezarri)]' \
            '--callback-port[OAuth callback-erako ataka finkoa (aurrez erregistratutako birbideratze URIak behar dituzten zerbitzarietarako)]:port:' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurazio esparrua (local, user, project) - zehaztu ez bada dagoen esparrutik kendu]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurazio esparrua (local, user, project)]:scope:(local user project)' \
            '--client-secret[OAuth bezero sekretua eskatu (edo MCP_CLIENT_SECRET ingurune aldagaia ezarri)]' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurazio esparrua (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]'
          ;;
        login)
          _arguments \
            '--no-browser[Baimen URLa inprimatu nabigatzaile bat ireki beharrean (SSH/pantailarik gabeko saioetarako)]' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Plugin edo merkatu manifestua balioztatu'
    'marketplace:Claude Code merkatuak kudeatu'
    'list:Instalatutako pluginak zerrendatu'
    'details:Plugin baten osagai inbentarioa eta aurreikusitako token kostua erakutsi'
    'configure:Plugin baten aukerak eta ezarri gabe daudenak erakutsi, edo balioak stdin-etik gorde'
    'install:Plugina erabilgarri dauden merkatu-etatik instalatu'
    'i:Plugina erabilgarri dauden merkatu-etatik instalatu (install-en forma laburra)'
    'init:Plugin berri bat sortu (hurrengo saioan automatikoki kargatzen da)'
    'new:Plugin berri baten egitura sortu (init-en aliasa)'
    'uninstall:Instalatutako plugina desinstalatu'
    'remove:Instalatutako plugina desinstalatu (uninstall-en aliasa)'
    'enable:Desgaitutako plugina gaitu'
    'disable:Gaitutako plugina desgaitu'
    'update:Plugina azken bertsiora eguneratu'
    'eval:Ebaluazio kasuak plugin baten aurka exekutatu eta puntuatutako emaitzak jakinarazi'
    'prune:Jada behar ez diren automatikoki instalatutako mendekotasunak kendu'
    'autoremove:Jada behar ez diren automatikoki instalatutako mendekotasunak kendu (prune-ren aliasa)'
    'tag:Plugin argitalpen baterako {name}--v{version} git etiketa sortu'
    'test:Mod baten probak exekutatu'
    'help:Laguntza erakutsi'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin komandoak' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Abisuak errore gisa tratatu (1 irteera kodea)]' \
            '--json[Balioztapen txostena JSON gisa atera (irteera kode berdinak)]' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Instalazio esparrua]:scope:(user project local)' \
            '*--config[Plugin manifestuan deklaratutako userConfig aukera bat ezarri (errepikagarria)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Merkatuak deklaratutako eta erakutsitako komandoa onartu berrespen galderarik gabe]' \
            '--json[Makinak irakur dezakeen emaitza lerro bakarra inprimatu gizakientzako mezuaren ordez]' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Instalazio esparrua]:scope:(user project local)' \
            '--keep-data[Pluginaren datu iraunkorren direktorioa gorde]' \
            '--prune[Jada behar ez diren automatikoki instalatutako mendekotasunak ere kendu]' \
            '(-y --yes)'{-y,--yes}'[--prune berrespen galdera saltatu]' \
            '--json[Makinak irakur dezakeen emaitza lerro bakarra inprimatu gizakientzako mezuaren ordez (ez --prune-ekin)]' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Instalazio esparrua]:scope:(user project local)' \
            '--json[Makinak irakur dezakeen emaitza lerro bakarra inprimatu gizakientzako mezuaren ordez]' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Gaitutako plugin guztiak desgaitu]' \
            '(-s --scope)'{-s,--scope}'[Instalazio esparrua]:scope:(user project local)' \
            '--json[Makinak irakur dezakeen emaitza lerro bakarra inprimatu gizakientzako mezuaren ordez]' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Instalazio esparrua]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Merkatuak deklaratutako eta erakutsitako komandoa onartu berrespen galderarik gabe]' \
            '--json[Makinak irakur dezakeen emaitza lerro bakarra inprimatu gizakientzako mezuaren ordez]' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[JSON gisa atera]' \
            '--available[Merkatuetako plugin erabilgarriak sartu (--json behar du)]' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Esparru honetan garbitu]:scope:(user project local)' \
            '--dry-run[Kenduko litzatekeena zerrendatu ezer kendu gabe]' \
            '(-y --yes)'{-y,--yes}'[Berrespen galdera saltatu]' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]'
          ;;
        configure)
          _arguments \
            '--json[JSON gisa atera]' \
            '--values-stdin[Aukeren balioak stdin-etik irakurri lerro bakarreko kateen JSON objektu gisa; kanpoan utzitako aukerek beren balioak mantentzen dituzte]' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Manifestuaren deskribapena]:text:' \
            '--author[Egilearen izena (lehenetsia: git config user.name)]:name:' \
            '--author-email[Egilearen posta elektronikoa (lehenetsia: git config user.email)]:email:' \
            '--with[Egitura ere sortu beharreko osagaiak]:components:' \
            '(-f --force)'{-f,--force}'[Helburuan lehendik dagoen .claude-plugin/ gainidatzi]' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Kasuak izen glob bidez iragazi]:glob:' \
            '*--tag[Kasuak etiketa bidez iragazi (errepikagarria)]:tag:' \
            '--runs[Kasu bakoitzeko exekuzio kopurua gainidatzi (lehenetsia: case.runs, bestela 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Gehienez n agente exekuzio aldi berean egin (1-8; lehenetsia 1)]:n:' \
            '--model[Kasu guztietarako modeloa gainidatzi]:model:_claude_model_names' \
            '--judge-model[LLM ebaluatzailearen modeloa gainidatzi (lehenetsia: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Kostu muga zorrotza; iristen bada, eten eta emaitza partzialak jakinarazi (2 irteera kodea)]:usd:' \
            '--output-dir[aggregate-result.json-erako direktorioa]:dir:_directories' \
            '--eval-dir[Ebaluazio kasuak dituen direktorioaren izena (pluginaren azpian)]:dir:' \
            '--json[Exekuzioaren emaitza osoa JSON gisa stdout-era inprimatu, edo .json fitxategi honetan idatzi]::path:_files' \
            '--threshold[1 irteera kodearekin irten kasuren baten puntuazioa atalase honen azpitik badago (lehenetsia: 1.0)]:threshold:' \
            '*--allow-tools[Operadorearen baimena babestutako tresnetarako (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Kasu bakoitzaren scaffold_script exekutatu (egileak emandako bash zure izenean exekutatzen du; lehenetsiz desgaituta)]' \
            '(--scaffold)--no-scaffold[scaffold_script esplizituki saltatu]' \
            '--trust-plugin[Plugin honetaz eta bere ebaluazio multzoaz fidatzen zarela baieztatu, lehen exekuzioko konfiantza galdera saltatuz (CIrako)]' \
            '--ablation[Pluginik gabeko oinarri-lerroko kontrol taldea exekutatu eta puntuazio aldea jakinarazi]:mode:(none with-without)' \
            '--mocks[MCP zerbitzarien ordezko simulazioak, <eval dir>/mocks/-etik]:mode:(record off)' \
            '--allow-real-servers[--mocks record-ekin: simulaziorik ez duten MCP zerbitzari prozesu errealak ere abiarazi]' \
            '--keep-temp[Egitura direktorioak gorde arazketarako]' \
            '--verbose[Mezu bakoitzeko arrasto gertaerak arazketa erregistroan idatzi]' \
            '--report[HTML txosten autonomoa bide honetan idatzi emaitzen direktorioaren ordez]:path:_files' \
            '(--no-publish)--publish-report[Txostena claude.ai-n argitaratzea ere eskatu]' \
            '(--publish-report)--no-publish[HTML txostena lokalean soilik mantendu; claude.ai-n argitaratzea saltatu]' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Etiketa --remote-ra bidali sortu ondoren]' \
            '--dry-run[Etiketatuko litzatekeena inprimatu etiketa sortu gabe]' \
            '(-f --force)'{-f,--force}'[Lan zuhaitz zikinaren eta etiketa dagoeneko existitzearen egiaztapenak saltatu]' \
            '(-m --message)'{-m,--message}'[Etiketaren oharpen mezua (erabili %s bertsiorako)]:msg:' \
            '--remote[--push-ekin bidaltzeko urruneko biltegia]:name:' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Merkatua URL, bide edo GitHub biltegitik gehitu'
    'list:Konfiguratutako merkatuak zerrendatu'
    'remove:Konfiguratutako merkatua kendu'
    'rm:Konfiguratutako merkatua kendu (remove-ren aliasa)'
    'update:Merkatua iturburu-tik eguneratu - guztiak eguneratu izenik zehaztu ez bada'
    'help:Laguntza erakutsi'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'merkatu komandoak' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Checkout-a direktorio zehatzetara mugatu git sparse-checkout bidez (monorepoetarako)]:paths:' \
            '--scope[Merkatua non deklaratu]:scope:(user project local)' \
            '--claudeai[claude.ai-k zuretzat ostatatzen duen izen honetako merkatua gehitu]' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[JSON gisa atera]' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Merkatuaren deklarazioa ezarpen esparru zehatz batetik kendu (ez zehaztu esparru guztietatik kentzeko)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Instalatu derrigortua jadanik instalatuta egon arren]' \
    '(-h --help)'{-h,--help}'[Laguntza erakutsi]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Bidalitako saioetan tresna sarbidea baimentzeko direktorio gehigarria]:directory:_directories' \
    '--agent[Agente ikuspegitik bidalitako saioetarako agente lehenetsia]:agent:_claude_agent_names' \
    '--all[--json-ekin: atzeko planoko amaitutako saioak ere sartu]' \
    '--allow-dangerously-skip-permissions[Baimen saltatze modua bidalitako saioetarako erabilgarri egin]' \
    '--cwd[Bide baten pean abiarazitako atzeko planoko saioak soilik erakutsi]:path:_directories' \
    '--dangerously-skip-permissions[--permission-mode bypassPermissions-en aliasa]' \
    '--effort[Bidalitako saioetarako esfortzu maila lehenetsia]:level:(low medium high xhigh max)' \
    '--json[Saio aktiboak JSON array gisa inprimatu eta irten]' \
    '*--mcp-config[Bidalitako saioei aplikatzeko MCP zerbitzari konfigurazioa]:config:' \
    '--model[Agente ikuspegitik bidalitako saioetarako modelo lehenetsia]:model:_claude_model_names' \
    '--permission-mode[Bidalitako saioetarako baimen modu lehenetsia]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Agente ikuspegirako eta bidalitako saioetarako direktorio-tik pluginak kargatu]:path:_directories' \
    '--setting-sources[Kargatu beharreko konfigurazio iturrien komaz bereizitako zerrenda (user, project, local)]:sources:' \
    '--settings[Aplikatzeko konfigurazio fitxategia edo JSON katea]:file-or-json:_files' \
    '--strict-mcp-config[Bidalitako saioetan --mcp-config-ko MCP zerbitzariak soilik erabili]' \
    '--restricted[Bidalitako saioak modu murriztuan abiarazi]' \
    '(-h --help)'{-h,--help}'[Komandoaren laguntza erakutsi]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Zure Anthropic kontuan saioa hasi'
    'logout:Zure Anthropic kontutik saioa itxi'
    'status:Autentifikazio egoera erakutsi'
    'help:Laguntza erakutsi'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Komandoaren laguntza erakutsi]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth komandoak' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Saio hasierako orrian posta elektronikoko helbidea aurrez bete]:email:' \
            '--sso[SSO saio hasiera fluxua derrigortu]' \
            '(--claudeai)--console[Anthropic Console erabili (API erabileraren fakturazioa) Claude harpidetzaren ordez]' \
            '(--console)--claudeai[Claude harpidetza erabili (lehenetsia)]' \
            '(-h --help)'{-h,--help}'[Komandoaren laguntza erakutsi]'
          ;;
        status)
          _arguments \
            '(--text)--json[JSON gisa atera (lehenetsia)]' \
            '(--json)--text[Gizakiek irakur dezaketen testu gisa atera]' \
            '(-h --help)'{-h,--help}'[Komandoaren laguntza erakutsi]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Komandoaren laguntza erakutsi]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Modu automatikoaren konfigurazio eraginkorra JSON gisa inprimatu'
    'critique:Zure modu automatikoko arau pertsonalizatuei buruzko AA feedbacka lortu'
    'defaults:Modu automatikoaren arau lehenetsiak JSON gisa inprimatu'
    'reset:Modu automatikoaren konfigurazioa bidalitako lehenetsietara berrezarri'
    'help:Laguntza erakutsi'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Komandoaren laguntza erakutsi]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode komandoak' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Erabiltzen den modeloa gainidatzi]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Komandoaren laguntza erakutsi]'
          ;;
        defaults)
          _arguments \
            '--label[Aurrizki honekin hasten den etiketa duten arauak soilik erakutsi (maiuskulak eta minuskulak bereizi gabe)]:prefix:' \
            '(-h --help)'{-h,--help}'[Komandoaren laguntza erakutsi]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Berrespen galdera saltatu]' \
            '(-h --help)'{-h,--help}'[Komandoaren laguntza erakutsi]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Komandoaren laguntza erakutsi]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Atebideko YAML konfiguraziorako bidea]:path:_files' \
    '(-h --help)'{-h,--help}'[Komandoaren laguntza erakutsi]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Proiektu baten Claude Code egoera guztia ezabatu (transkripzioak, atazak, fitxategi historia, konfigurazio sarrera)'
    'help:Laguntza erakutsi'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Komandoaren laguntza erakutsi]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project komandoak' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Ezabatuko litzatekeena zerrendatu ezer ezabatu gabe]' \
            '(-y --yes)'{-y,--yes}'[Berrespen galdera saltatu]' \
            '(-i --interactive)'{-i,--interactive}'[Elementu bakoitzeko galdetu ezabatu aurretik]' \
            '(1)--all[Proiektu guztien egoera ezabatu (bide batekin elkarren baztertzailea)]' \
            '(-h --help)'{-h,--help}'[Komandoaren laguntza erakutsi]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Formateatutako aurkikuntzen ordez bugs.json karga gordina inprimatu]' \
    '--timeout[Berrikuspena amaitzeko itxaroteko gehienezko minutuak (lehenetsia: 45)]:minutes:' \
    '(--no-post)--post[Amaitutako berrikuspenaren aurkikuntzak PRan argitaratu zure izenean (PR helburuetarako soilik; iruzkin arrunt bakarra, ez berrikuspen bat)]' \
    '(--post)--no-post[Aurkikuntzak ez argitaratu PRan (lehenetsia)]' \
    '(-h --help)'{-h,--help}'[Komandoaren laguntza erakutsi]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Exekutatzen ari diren atzeko planoko saio guztiak berrabiarazi]' \
    '(-h --help)'{-h,--help}'[Komandoaren laguntza erakutsi]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[worktree-aren bidali gabeko commit-ak eta commit gabeko aldaketak ere baztertu (aurreko claude rm batek jakinarazitako commit@worktree-id eman)]:commit@worktree-id:' \
    '--force-remove-worktree[worktree direktorioa ezabatu WorktreeRemove hook-ak edo git-ek kendu ezin izan badute ere (aurreko claude rm batek jakinarazitako worktree-id eman)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Komandoaren laguntza erakutsi]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Inportatuko litzatekeena erakutsi ezer idatzi gabe]' \
    '--yes[Hautatzaile interaktiboa saltatu (pantailarik gabeko inguruneetan, /import aurrebistako --yes=<digest> eman)]' \
    '(-h --help)'{-h,--help}'[Komandoaren laguntza erakutsi]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
