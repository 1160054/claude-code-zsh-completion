_claude_self_hosted_runner() {
  _arguments \
    '--api-url[Osnovni URL API-ja (podrazumijevano: https://api.anthropic.com)]:url:' \
    '--environment-secret-file[Putanja do datoteke s tajnom okruženja]:path:_files' \
    '--lock-to-account[Zaključaj runner na jedan račun pri registraciji]:id:' \
    '--client-label[Oznaka za praćenje poslana pri registraciji (podrazumijevano: hostname)]:label:' \
    '(--proxy-authorization-file --agent-proxy-url)--proxy-authorization-command[Naredba čiji je stdout zaglavlje Proxy-Authorization za izlazne proxyje]:shell command:' \
    '(--proxy-authorization-command --agent-proxy-url)--proxy-authorization-file[Datoteka sa zaglavljem Proxy-Authorization za izlazne proxyje]:path:_files' \
    '(--proxy-authorization-command --proxy-authorization-file)--agent-proxy-url[Usmjeri svaku sesiju kroz agent proxy na ovom URL-u (samo https)]:url:' \
    '--capacity[Maksimalan broj istovremenih sesija (podrazumijevano: 1)]:n:' \
    '--base-dir[Osnovni direktorij za checkout repozitorija (podrazumijevano: /workspace)]:path:_directories' \
    '--exec-path[Binarna datoteka koja se pokreće za podređene sesije (podrazumijevano: ova binarna datoteka)]:path:_files' \
    '--hooks-dir[Direktorij skripti hookova životnog ciklusa (checkout, command, post-session)]:path:_directories' \
    '--session-stop-grace-sec[Koliko dugo čekati čist izlaz nakon završetka sesije (podrazumijevano: 5)]:n:' \
    '--post-session-hook-timeout-sec[SIGTERM vremenski budžet za post-session hook (podrazumijevano: 60)]:n:' \
    '--checkout-hook-timeout-min[Budžet stvarnog vremena za svako pokretanje checkout hooka (podrazumijevano: 30; 0 isključuje)]:n:' \
    '--drain-wait-sec[Na SIGTERM/SIGINT čekaj do N sekundi za posao u toku (podrazumijevano: 0)]:n:' \
    '--drain-marker-file[Datoteka-marker kojom host najavljuje uredno pražnjenje]:path:_files' \
    '*--git-ssh-rewrite[Prepiši izvorne URL-ove https://<host>/... u git@<host>:... (može se ponavljati)]:host:' \
    '*--git-host-rewrite[Prepiši izvorne URL-ove https://<f>/... u https://<t>/... (može se ponavljati)]:from=to:' \
    '--use-anthropic-git-proxy[Koristi git kojim upravlja Anthropic. UPOZORENJE: briše i zamjenjuje git konfiguraciju na nivou HOME, koristite samo pod namjenskim računom]' \
    '--configure-git[Postavi globalni git identitet i omogući potpisivanje commitova putem Anthropic servisa za potpisivanje. Upisuje ~/.gitconfig]' \
    '--push-outcome-on-release[Pushaj praćene grane ishoda pri nedovršenom završetku sesije koji je pokrenuo runner]' \
    '--trust-workspace[Unaprijed postavi trajno povjerenje za putanje repozitorija svake sesije (podrazumijevano: true)]::bool:(true false)' \
    '--remove-session-state[Ukloni stanje sesije kada se sesija završi (podrazumijevano: false)]::bool:(true false)' \
    '--diff-finds-nested-repository[Prikaži repozitorij kloniran u podfolder u panelu Changes; zahtijeva --capacity 1 (podrazumijevano: false)]::bool:(true false)' \
    '--confine-repo-settings[Režim zaštite ograničenja za postavke commitane u repozitorij (podrazumijevano: warn)]:mode:(warn enforce off)' \
    '--server-auto-mode-lists[Koje liste klasifikatora auto režima sa servera sesija smije primiti (podrazumijevano: no-allow)]:mode:(all no-allow none)' \
    '--host-config-snapshot[Gdje se čuva snimak konfiguracije hosta pri pokretanju (podrazumijevano: disk)]:mode:(disk memory)' \
    '--health-port[Port za /healthz HTTP slušač (podrazumijevano: 8080; 0 isključuje)]:port:' \
    '--log-level[Nivo logovanja (podrazumijevano: info)]:level:(info debug)' \
    '--log-file[Kopiraj logove runnera i u datoteku u režimu dodavanja (kao tee)]:path:_files' \
    '--exit-if-unused-min[Ugasi runner ako mu N minuta nije dodijeljen nikakav posao]:n:' \
    '--drain-grace-sec[Sekunde nastavka provjeravanja posla nakon završetka aktivnih sesija (podrazumijevano: 0)]:n:' \
    '--retire-at[Povuci runner iz upotrebe u ovo apsolutno Unix vrijeme, u sekundama]:epoch-seconds:' \
    '--defer-shutdown-max-min[Na prvi SIGTERM/SIGINT prestani primati posao i završi gašenje M minuta kasnije (podrazumijevano: 0)]:m:' \
    '--release-idle-session-min[Oslobodi mjesto za sesiju nakon N minuta bez korisničkog unosa]:n:' \
    '--startup-timeout-min[Oslobodi mjesto za sesiju ako podređeni proces nije završio pokretanje nakon N minuta (podrazumijevano: 15; 0 isključuje)]:n:' \
    '--kill-session-after-min[Ograniči stvarno trajanje podređenog procesa sesije na N minuta]:n:' \
    '--debug-token-dir[SAMO ZA DEBUG: upisuje žive tokene na disk. Ne koristite u produkciji]:path:_directories' \
    '(-h --help)'{-h,--help}'[Prikaži ovu poruku pomoći]'
}

_claude_remote_control() {
  _arguments \
    '--name[Ime sesije (prikazuje se u claude.ai/code)]:name:' \
    '--remote-control-session-name-prefix[Prefiks za automatski generirana imena sesija (podrazumijevano: hostname)]:prefix:' \
    '(-c --continue --session-id)'{-c,--continue}'[Ponovo se poveži na sesiju posljednju zabilježenu za ovaj direktorij ili jedan od njegovih git worktree-ova]' \
    '(-c --continue --session-id)--session-id[Ponovo se poveži na određenu sesiju po ID-u]:id:' \
    '--permission-mode[Režim dozvola za pokrenute sesije]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)' \
    '(--no-chrome)--chrome[Omogući Claude in Chrome za pokrenute sesije]' \
    '(--chrome)--no-chrome[Onemogući Claude in Chrome za pokrenute sesije]' \
    '(-d --debug)'{-d,--debug}'[Uključi režim otklanjanja grešaka sa opcionalnim filtriranjem kategorija]::filter:' \
    '--debug-file[Upisuj logove otklanjanja grešaka u datoteku]:path:_files' \
    '(-v --verbose)'{-v,--verbose}'[Uključi detaljan izlaz]' \
    '--spawn[Režim pokretanja (podrazumijevano: same-dir)]:mode:(same-dir worktree session)' \
    '--capacity[Maksimalan broj istovremenih sesija u režimu worktree ili same-dir (podrazumijevano: 32)]:n:' \
    '(--no-create-session-in-dir)--create-session-in-dir[Unaprijed kreiraj sesiju u trenutnom direktoriju (podrazumijevano)]' \
    '(--create-session-in-dir)--no-create-session-in-dir[Ne kreiraj unaprijed sesiju u trenutnom direktoriju]' \
    '(-h --help)'{-h,--help}'[Prikaži ovu pomoć]'
}

_claude_daemon() {
  local -a daemon_commands common_options
  daemon_commands=(
    'run:Pokreni nadzornika u prvom planu'
    'status:Prikaži pid, verziju i vrijeme rada daemona'
    'logs:Prati log daemona (Ctrl-C za zaustavljanje)'
    'uninstall:Ukloni pozadinski servis (launchctl/systemd)'
    'stop:Ugasi nadzornika i prekini pozadinske sesije'
  )
  common_options=(
    '--json-path[Konfiguraciona datoteka (podrazumijevano: ~/.claude/daemon.json)]:path:_files'
    '--log-file[Log datoteka (podrazumijevano: ~/.claude/daemon.log)]:path:_files'
    '(-h --help)'{-h,--help}'[Prikaži ovu pomoć]'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    $common_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'naredbe daemon' daemon_commands
      ;;
    args)
      case $words[1] in
        run)
          _arguments \
            $common_options \
            '::json-path:_files'
          ;;
        stop)
          _arguments \
            $common_options \
            '--any[Zaustavi i privremeni (ne-servisni) daemon]' \
            '--keep-workers[Ostavi odvojene sesije da rade]'
          ;;
        status|logs|uninstall)
          _arguments \
            $common_options
          ;;
      esac
      ;;
  esac
}

_claude_import() {
  _arguments \
    '--dry-run[Prikaži šta bi bilo uvezeno bez zapisivanja bilo čega]' \
    '--yes[Preskoči interaktivni birač (na headless površinama proslijedite --yes=<digest> iz /import pregleda)]' \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
    '::source:(codex gemini cursor)'
}

# compinit autoloads this file, and that first call only defines the functions
# above: complete right away so the first TAB already works. Sourced directly,
# there is nothing to complete yet, only the registration.
if [[ $funcstack[1] == _claude ]]; then
  _claude "$@"
else
  (( $+_comps[claude] )) || compdef _claude claude
fi
