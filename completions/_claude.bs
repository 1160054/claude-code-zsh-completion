#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Konfiguriranje i upravljanje MCP serverima'
    'plugin:Upravljanje dodacima Claude Code'
    'agents:Upravljanje pozadinskim agentima'
    'attach:Otvori pozadinsku sesiju u ovom terminalu'
    'logs:Ispiši nedavni izlaz terminala pozadinske sesije'
    'stop:Zaustavi pozadinsku sesiju (njen razgovor se čuva)'
    'respawn:Ponovo pokreni pozadinsku sesiju da radi na trenutnoj verziji Claude Code'
    'rm:Obriši pozadinsku sesiju i njen worktree kada je to sigurno'
    'auth:Upravljanje autentifikacijom'
    'auto-mode:Pregledaj ili resetuj konfiguraciju klasifikatora automatskog režima'
    'gateway:Pokreni enterprise gateway za autentifikaciju/telemetriju'
    'import:Uvezi konfiguraciju iz drugog AI agenta za kodiranje u Claude Code'
    'project:Upravljanje stanjem projekta Claude Code'
    'ultrareview:Pokreni multi-agentski pregled koda hostovan u oblaku i ispiši nalaze'
    'setup-token:Postavljanje tokena za dugotrajnu autentifikaciju (zahtijeva Claude pretplatu)'
    'doctor:Provjera zdravlja sistema automatskih ažuriranja Claude Code'
    'update:Provjera i instalacija ažuriranja'
    'install:Instalacija izvorne verzije Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Uključi režim otklanjanja grešaka sa opcionalnim filtriranjem kategorija (npr. "api,hooks" ili "!statsig,!file")]:filter:'
    '--verbose[Prepiši postavku detaljnog režima iz konfiguracione datoteke]'
    '(-p --print)'{-p,--print}'[Ispiši odgovor i izlaz (za korištenje sa pipe). Napomena: koristite samo u pouzdanim direktorijima]'
    '--output-format[Format izlaza (sa --print): "text" (podrazumijevano), "json" (jedan rezultat), ili "stream-json" (streamanje u realnom vremenu)]:format:(text json stream-json)'
    '--json-schema[JSON shema za validaciju strukturiranog izlaza]:schema:'
    '--include-partial-messages[Uključi djelomične fragmente poruka prilikom njihovog dolaska (sa --print i --output-format=stream-json)]'
    '--input-format[Format unosa (sa --print): "text" (podrazumijevano) ili "stream-json" (streamani unos u realnom vremenu)]:format:(text stream-json)'
    '--mcp-debug[\[Zastarjelo. Koristite --debug umjesto toga\] Uključi režim otklanjanja grešaka MCP (prikazuje greške MCP servera)]'
    '--dangerously-skip-permissions[Zaobiđi sve provjere dozvola. Preporučeno samo za sandbox okruženja bez pristupa internetu]'
    '--allow-dangerously-skip-permissions[Omogući opciju zaobilaženja provjera dozvola bez omogućavanja po podrazumijevanom]'
    '--restricted[Ograničeni režim: ukloni alate koji pokreću naredbe ili kod i WebFetch, zanemari user/project/local postavke i ograniči datotečne alate na radne direktorije]'
    '--max-budget-usd[Maksimalni iznos u dolarima za potrošnju na API pozive (samo --print)]:amount:'
    '--replay-user-messages[Ponovno pošalji korisničke poruke iz stdin na stdout za potvrdu]'
    '--allowed-tools[Lista dozvoljenih imena alata odvojenih zarezom ili razmakom (npr. "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Lista dozvoljenih imena alata odvojenih zarezom ili razmakom (format camelCase)]:tools:'
    '--tools[Navedi listu dostupnih alata iz ugrađenog skupa. Samo u režimu print]:tools:'
    '--disallowed-tools[Lista zabranjenih imena alata odvojenih zarezom ili razmakom (npr. "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Lista zabranjenih imena alata odvojenih zarezom ili razmakom (format camelCase)]:tools:'
    '--mcp-config[Učitaj MCP servere iz JSON datoteke ili niza (odvojeni razmacima)]:configs:'
    '--system-prompt[Sistemski prompt za korištenje u sesiji]:prompt:'
    '--system-prompt-file[Učitaj sistemski prompt iz datoteke]:file:_files'
    '--append-system-prompt[Dodaj sistemski prompt podrazumijevanom sistemskom promptu]:prompt:'
    '--append-system-prompt-file[Učitaj sistemski prompt iz datoteke i dodaj ga podrazumijevanom sistemskom promptu]:file:_files'
    '--system-prompt-snapshot[Zabilježi sistemski prompt jednom po razgovoru i ponovo ga koristi doslovno pri svakom zahtjevu i nastavku (on, podrazumijevano) ili ga generiši iznova pri svakom zahtjevu (off)]:mode:(on off)'
    '--permission-mode[Režim dozvola za korištenje u sesiji]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Ko odgovara na upite za dozvolu sa --print: "host" (SDK host ili --permission-prompt-tool) ili "none" (sve što bi zahtijevalo upit se odbija)]:target:(host none)'
    '--permission-prompt-tool[MCP alat za upite za dozvolu (samo --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Nastavi posljednji razgovor]'
    '(-r --resume)'{-r,--resume}'[Nastavi razgovor - navedite identifikator sesije ili odaberite interaktivno]:sessionId:_claude_sessions'
    '--fork-session[Kreiraj novi identifikator sesije umjesto ponovne upotrebe originalnog prilikom nastavka (sa --resume ili --continue)]'
    '--no-session-persistence[Onemogući postojanost sesije - sesije neće biti sačuvane (samo --print)]'
    '--model[Model za trenutnu sesiju. Navedite nadimak za najnoviji model (npr. '\''sonnet'\'' ili '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agent za trenutnu sesiju. Prepisuje postavku '\''agent'\'']:agent:_claude_agent_names'
    '--betas[Beta zaglavlja za uključivanje u API zahtjeve (samo za korisnike API ključa)]:betas:'
    '--fallback-model[Omogući automatsko prebacivanje na navedeni model kada je podrazumijevani model preopterećen (samo --print)]:model:_claude_model_names'
    '--settings[Putanja do JSON datoteke sa postavkama ili JSON niz za učitavanje dodatnih postavki]:file-or-json:_files'
    '--add-dir[Dodatni direktoriji za pružanje pristupa alatima]:directories:_directories'
    '--ide[Automatski se poveži sa IDE prilikom pokretanja ako je dostupan tačno jedan validan IDE]'
    '--desktop[Otvori u aplikaciji Claude Desktop umjesto u terminalu (sa --continue ili --resume <id> za odabir sesije)]'
    '--strict-mcp-config[Koristi samo MCP servere iz --mcp-config i zanemari sva druga MCP podešavanja]'
    '--session-id[Određeni identifikator sesije za korištenje u razgovoru (mora biti validan UUID)]:uuid:'
    '--agents[JSON objekt koji definiše prilagođene agente]:json:'
    '--setting-sources[Lista izvora postavki odvojenih zarezom za učitavanje (user, project, local)]:sources:'
    '--plugin-dir[Direktorij za učitavanje dodataka samo za ovu sesiju (može se ponavljati)]:paths:_directories'
    '--disable-slash-commands[Onemogući sve slash naredbe]'
    '(--bg --background)'{--bg,--background}'[Pokreni sesiju kao pozadinski agent i odmah se vrati]'
    '(-w --worktree)'{-w,--worktree}'[Kreiraj novi git worktree za ovu sesiju (opcionalno navedite ime)]::name:'
    '--tmux=-[Kreiraj tmux sesiju za worktree (zahtijeva --worktree). Koristi izvorne iTerm2 panele kada su dostupni; --tmux=classic za tradicionalni tmux]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Postavi prikazno ime za ovu sesiju]:name:'
    '--effort[Nivo napora za trenutnu sesiju]:level:(low medium high xhigh max)'
    '--autocompact[Veličina prozora za automatsko sažimanje (auto, ili 100k-1M tokena)]:size:(auto)'
    '--debug-file[Zapiši debug logove u određenu putanju datoteke (implicitno omogućava debug režim)]:path:_files'
    '--from-pr[Nastavi sesiju povezanu sa PR-om po broju/URL-u, ili otvori interaktivni izbornik]::value:'
    '--teleport[Nastavi teleport sesiju, opcionalno navedite identifikator sesije]::session:'
    '--cloud[Kreiraj sesiju u oblaku sa datim opisom ili se poveži na postojeću po identifikatoru sesije ili claude.ai/code URL-u]::description-or-session:'
    '--environment[Kreiraj novu sesiju u oblaku koja radi na datom self-hosted okruženju (ccpool_...)]:environment_id:'
    '--remote-control[Pokreni interaktivnu sesiju sa omogućenim Remote Control-om (opcionalno imenovanu)]::name:'
    '--remote-control-session-name-prefix[Prefiks za automatski generirana imena Remote Control sesija]:prefix:'
    '--chrome[Omogući integraciju Claude u Chrome]'
    '--no-chrome[Onemogući integraciju Claude u Chrome]'
    '--plugin-url[Preuzmi .zip dodatka sa URL-a samo za ovu sesiju (može se ponavljati)]:url:'
    '--file[Datotečni resursi za preuzimanje pri pokretanju (format: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Omogući prijedloge prompta (emituje predviđeni sljedeći prompt u print/SDK režimu)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Proslijedi tekst podagenta i blokove razmišljanja kao poruke (sa --print i stream-json)]'
    '--include-hook-events[Uključi sve hook događaje životnog ciklusa u izlazni stream (sa stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Premjesti sekcije specifične za mašinu u prvu korisničku poruku radi bolje ponovne upotrebe prompt-keša]'
    '--brief[Omogući alat SendUserMessage za komunikaciju agent-korisnik]'
    '--safe-mode[Pokreni sa svim prilagodbama onemogućenim (korisno za rješavanje problema sa neispravnom konfiguracijom)]'
    '--bare[Minimalni režim: preskoči hookove, LSP, sinhronizaciju dodataka, atribuciju, auto-memoriju i automatsko otkrivanje CLAUDE.md]'
    '--ax-screen-reader[Prikaži izlaz prilagođen čitaču ekrana (ravan tekst, bez dekorativnih okvira ili animacija)]'
    '(-v --version)'{-v,--version}'[Ispiši broj verzije]'
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'naredbe claude' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "bez argumenata"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Pokreni MCP server Claude Code'
    'add:Dodaj MCP server u Claude Code'
    'remove:Ukloni MCP server'
    'list:Prikaži listu konfiguriranih MCP servera'
    'get:Preuzmi detalje MCP servera'
    'add-json:Dodaj MCP server (stdio ili SSE) sa JSON nizom'
    'add-from-claude-desktop:Uvezi MCP servere iz Claude Desktop (samo Mac i WSL)'
    'reset-project-choices:Resetuj sve odobrene/odbijene servere sa opsegom projekta (.mcp.json) u ovom projektu'
    'login:Autentifikuj se sa MCP serverom (HTTP, SSE ili claude.ai konektor)'
    'logout:Obriši sačuvane OAuth vjerodajnice za MCP server'
    'help:Prikaži pomoć'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'naredbe mcp' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Uključi režim otklanjanja grešaka]' \
            '--verbose[Prepiši postavku detaljnog režima iz konfiguracione datoteke]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Opseg konfiguracije (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Tip prijenosa (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Postavi varijablu okoline (npr. -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Postavi WebSocket zaglavlje]:header:' \
            '--client-id[OAuth identifikator klijenta za HTTP/SSE servere]:clientId:' \
            '--client-secret[Zatraži unos OAuth tajne klijenta (ili postavite varijablu okoline MCP_CLIENT_SECRET)]' \
            '--callback-port[Fiksni port za OAuth povratni poziv (za servere koji zahtijevaju unaprijed registrovane URI-je za preusmjeravanje)]:port:' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Opseg konfiguracije (local, user, project) - ukloni iz postojećeg opsega ako nije navedeno]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Opseg konfiguracije (local, user, project)]:scope:(local user project)' \
            '--client-secret[Zatraži unos OAuth tajne klijenta (ili postavite varijablu okoline MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Opseg konfiguracije (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]'
          ;;
        login)
          _arguments \
            '--no-browser[Ispiši URL za autorizaciju umjesto otvaranja preglednika (za SSH/headless sesije)]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Validiraj dodatak ili manifest tržišta'
    'marketplace:Upravljanje tržištima Claude Code'
    'list:Prikaži listu instaliranih dodataka'
    'details:Prikaži inventar komponenti i projektovani trošak tokena za dodatak'
    'configure:Prikaži opcije dodatka i koje nisu postavljene, ili sačuvaj vrijednosti iz stdin'
    'install:Instaliraj dodatak iz dostupnih tržišta'
    'i:Instaliraj dodatak iz dostupnih tržišta (kratica za install)'
    'init:Skeletiraj novi dodatak (automatski se učitava u sljedećoj sesiji)'
    'new:Skeletiraj novi dodatak (nadimak za init)'
    'uninstall:Deinstaliraj instalirani dodatak'
    'remove:Deinstaliraj instalirani dodatak (nadimak za uninstall)'
    'enable:Omogući onemogućeni dodatak'
    'disable:Onemogući omogućeni dodatak'
    'update:Ažuriraj dodatak na najnoviju verziju'
    'eval:Pokreni eval slučajeve nad dodatkom i izvijesti o ocijenjenim rezultatima'
    'prune:Ukloni automatski instalirane zavisnosti koje više nisu potrebne'
    'autoremove:Ukloni automatski instalirane zavisnosti koje više nisu potrebne (nadimak za prune)'
    'tag:Kreiraj git tag {name}--v{version} za izdanje dodatka'
    'test:Pokreni testove moda'
    'help:Prikaži pomoć'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'naredbe plugin' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Tretiraj upozorenja kao greške (izlazni kod 1)]' \
            '--json[Ispiši izvještaj o validaciji kao JSON (isti izlazni kodovi)]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Opseg instalacije]:scope:(user project local)' \
            '*--config[Postavi userConfig opciju deklarisanu u manifestu dodatka (može se ponavljati)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Prihvati prikazanu naredbu koju deklariše tržište bez upita za potvrdu]' \
            '--json[Ispiši jednu mašinski čitljivu liniju rezultata umjesto poruke za ljude]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Opseg instalacije]:scope:(user project local)' \
            '--keep-data[Sačuvaj direktorij trajnih podataka dodatka]' \
            '--prune[Ukloni i automatski instalirane zavisnosti koje više nisu potrebne]' \
            '(-y --yes)'{-y,--yes}'[Preskoči upit za potvrdu za --prune]' \
            '--json[Ispiši jednu mašinski čitljivu liniju rezultata umjesto poruke za ljude (ne sa --prune)]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Opseg instalacije]:scope:(user project local)' \
            '--json[Ispiši jednu mašinski čitljivu liniju rezultata umjesto poruke za ljude]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Onemogući sve omogućene dodatke]' \
            '(-s --scope)'{-s,--scope}'[Opseg instalacije]:scope:(user project local)' \
            '--json[Ispiši jednu mašinski čitljivu liniju rezultata umjesto poruke za ljude]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Opseg instalacije]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Prihvati prikazanu naredbu koju deklariše tržište bez upita za potvrdu]' \
            '--json[Ispiši jednu mašinski čitljivu liniju rezultata umjesto poruke za ljude]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Ispiši kao JSON]' \
            '--available[Uključi dostupne dodatke iz tržišta (zahtijeva --json)]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Očisti u opsegu]:scope:(user project local)' \
            '--dry-run[Prikaži šta bi bilo uklonjeno bez uklanjanja]' \
            '(-y --yes)'{-y,--yes}'[Preskoči upit za potvrdu]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]'
          ;;
        configure)
          _arguments \
            '--json[Ispiši kao JSON]' \
            '--values-stdin[Učitaj vrijednosti opcija iz stdin kao JSON objekt jednolinijskih stringova; izostavljene opcije zadržavaju svoje vrijednosti]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Opis u manifestu]:text:' \
            '--author[Ime autora (podrazumijevano: git config user.name)]:name:' \
            '--author-email[Email autora (podrazumijevano: git config user.email)]:email:' \
            '--with[Komponente koje također treba skeletirati]:components:' \
            '(-f --force)'{-f,--force}'[Prepiši postojeći .claude-plugin/ na odredištu]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Filtriraj slučajeve po glob uzorku imena]:glob:' \
            '*--tag[Filtriraj slučajeve po oznaci (može se ponavljati)]:tag:' \
            '--runs[Prepiši broj pokretanja po slučaju (podrazumijevano: case.runs, inače 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Izvrši do n pokretanja agenta istovremeno (1-8; podrazumijevano 1)]:n:' \
            '--model[Prepiši model za sve slučajeve]:model:_claude_model_names' \
            '--judge-model[Prepiši model LLM ocjenjivača (podrazumijevano: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Čvrsta gornja granica troška; prekini i izvijesti o djelimičnim rezultatima ako se dostigne (izlazni kod 2)]:usd:' \
            '--output-dir[Direktorij za aggregate-result.json]:dir:_directories' \
            '--eval-dir[Ime direktorija (ispod dodatka) koji sadrži eval slučajeve]:dir:' \
            '--json[Ispiši puni rezultat pokretanja kao JSON na stdout ili ga zapiši u ovu .json datoteku]::path:_files' \
            '--threshold[Izađi sa izlaznim kodom 1 ako je ocjena bilo kojeg slučaja ispod ovog praga (podrazumijevano: 1.0)]:threshold:' \
            '*--allow-tools[Odobrenje operatera za ograničene alate (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Pokreni scaffold_script svakog slučaja (izvršava bash skriptu autora pod vašim nalogom; podrazumijevano isključeno)]' \
            '(--scaffold)--no-scaffold[Izričito preskoči scaffold_script]' \
            '--trust-plugin[Potvrdi da vjerujete ovom dodatku i njegovom eval skupu, preskačući upit za povjerenje pri prvom pokretanju (za CI)]' \
            '--ablation[Pokreni kontrolnu grupu bez dodatka i izvijesti o razlici u ocjeni]:mode:(none with-without)' \
            '--mocks[Lažne zamjene za MCP servere, iz <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Sa --mocks record: pokreni i stvarne procese MCP servera koji nemaju mock]' \
            '--keep-temp[Sačuvaj scaffold direktorije za otklanjanje grešaka]' \
            '--verbose[Bilježi trace događaje po poruci u debug log]' \
            '--report[Zapiši samostalni HTML izvještaj na ovu putanju umjesto u direktorij rezultata]:path:_files' \
            '(--no-publish)--publish-report[Zahtijevaj i objavljivanje izvještaja na claude.ai]' \
            '(--publish-report)--no-publish[Zadrži HTML izvještaj samo lokalno; preskoči njegovo objavljivanje na claude.ai]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Pošalji tag na --remote nakon kreiranja]' \
            '--dry-run[Prikaži šta bi bilo označeno tagom bez kreiranja]' \
            '(-f --force)'{-f,--force}'[Preskoči provjere radnog stabla sa necommitovanim promjenama i već postojećeg taga]' \
            '(-m --message)'{-m,--message}'[Poruka anotacije taga (koristite %s za verziju)]:msg:' \
            '--remote[Remote na koji se šalje sa --push]:name:' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Dodaj tržište iz URL, putanje ili GitHub repozitorija'
    'list:Prikaži listu konfiguriranih tržišta'
    'remove:Ukloni konfigurirano tržište'
    'rm:Ukloni konfigurirano tržište (nadimak za remove)'
    'update:Ažuriraj tržište iz izvora - ažuriraj sve ako ime nije navedeno'
    'help:Prikaži pomoć'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'naredbe marketplace' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Ograniči checkout na određene direktorije putem git sparse-checkout (za monorepozitorije)]:paths:' \
            '--scope[Gdje deklarisati tržište]:scope:(user project local)' \
            '--claudeai[Dodaj tržište ovog imena koje claude.ai hostuje za vas]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Ispiši kao JSON]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Ukloni deklaraciju tržišta iz određenog opsega postavki (izostavite za uklanjanje iz svih opsega)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Prisilna instalacija čak i ako je već instalirano]' \
    '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Dodatni direktorij za pružanje pristupa alatima u dispečovanim sesijama]:directory:_directories' \
    '--agent[Podrazumijevani agent za sesije dispečovane iz prikaza agenata]:agent:_claude_agent_names' \
    '--all[Sa --json: uključi i završene pozadinske sesije]' \
    '--allow-dangerously-skip-permissions[Učini režim zaobilaženja dozvola dostupnim dispečovanim sesijama]' \
    '--cwd[Prikaži samo pozadinske sesije pokrenute pod putanjom]:path:_directories' \
    '--dangerously-skip-permissions[Nadimak za --permission-mode bypassPermissions]' \
    '--effort[Podrazumijevani nivo napora za dispečovane sesije]:level:(low medium high xhigh max)' \
    '--json[Ispiši aktivne sesije kao JSON niz i izađi]' \
    '*--mcp-config[Konfiguracija MCP servera za primjenu na dispečovane sesije]:config:' \
    '--model[Podrazumijevani model za sesije dispečovane iz prikaza agenata]:model:_claude_model_names' \
    '--permission-mode[Podrazumijevani režim dozvola za dispečovane sesije]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Učitaj dodatke iz direktorija za prikaz agenata i dispečovane sesije]:path:_directories' \
    '--setting-sources[Lista izvora postavki odvojenih zarezom za učitavanje (user, project, local)]:sources:' \
    '--settings[Datoteka postavki ili JSON niz za primjenu]:file-or-json:_files' \
    '--strict-mcp-config[Koristi samo MCP servere iz --mcp-config u dispečovanim sesijama]' \
    '--restricted[Pokreni dispečovane sesije u ograničenom režimu]' \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Prijavi se na svoj Anthropic račun'
    'logout:Odjavi se sa svog Anthropic računa'
    'status:Prikaži status autentifikacije'
    'help:Prikaži pomoć'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'naredbe auth' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Unaprijed popuni email adresu na stranici za prijavu]:email:' \
            '--sso[Prisili SSO tok prijave]' \
            '(--claudeai)--console[Koristi Anthropic Console (naplata po korištenju API-ja) umjesto Claude pretplate]' \
            '(--console)--claudeai[Koristi Claude pretplatu (podrazumijevano)]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
          ;;
        status)
          _arguments \
            '(--text)--json[Ispiši kao JSON (podrazumijevano)]' \
            '(--json)--text[Ispiši kao čitljiv tekst]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Ispiši efektivnu konfiguraciju automatskog režima kao JSON'
    'critique:Dobij AI povratne informacije o vašim prilagođenim pravilima automatskog režima'
    'defaults:Ispiši podrazumijevana pravila automatskog režima kao JSON'
    'reset:Resetuj konfiguraciju automatskog režima na isporučene podrazumijevane vrijednosti'
    'help:Prikaži pomoć'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'naredbe auto-mode' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Prepiši koji se model koristi]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
          ;;
        defaults)
          _arguments \
            '--label[Prikaži samo pravila čija oznaka počinje ovim prefiksom (bez razlikovanja velikih i malih slova)]:prefix:' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Preskoči upit za potvrdu]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Putanja do YAML konfiguracije gateway-a]:path:_files' \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Obriši sve stanje Claude Code za projekat (transkripti, zadaci, historija datoteka, unos konfiguracije)'
    'help:Prikaži pomoć'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'naredbe project' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Prikaži šta bi bilo obrisano bez brisanja bilo čega]' \
            '(-y --yes)'{-y,--yes}'[Preskoči upit za potvrdu]' \
            '(-i --interactive)'{-i,--interactive}'[Zatraži potvrdu za svaku stavku prije brisanja]' \
            '(1)--all[Očisti stanje za svaki projekat (međusobno isključivo sa putanjom)]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Ispiši sirovi bugs.json payload umjesto formatiranih nalaza]' \
    '--timeout[Maksimalni broj minuta za čekanje da se pregled završi (podrazumijevano: 45)]:minutes:' \
    '(--no-post)--post[Objavi nalaze završenog pregleda na PR pod vašim nalogom (samo za PR ciljeve; jedan običan komentar, ne pregled)]' \
    '(--post)--no-post[Ne objavljuj nalaze na PR (podrazumijevano)]' \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Ponovo pokreni svaku aktivnu pozadinsku sesiju]' \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Odbaci i nepushane commitove i necommitovane promjene worktree-a (proslijedite commit@worktree-id koji je prijavio prethodni claude rm)]:commit@worktree-id:' \
    '--force-remove-worktree[Obriši direktorij worktree-a čak i ako ga WorktreeRemove hook ili git nisu mogli ukloniti (proslijedite worktree-id koji je prijavio prethodni claude rm)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Prikaži šta bi bilo uvezeno bez zapisivanja bilo čega]' \
    '--yes[Preskoči interaktivni birač (na headless površinama proslijedite --yes=<digest> iz /import pregleda)]' \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
