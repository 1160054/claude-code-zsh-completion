#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Configurar i gestionar servidors MCP'
    'plugin:Gestionar connectors de Claude Code'
    'agents:Gestionar agents en segon pla'
    'attach:Obrir una sessió en segon pla en aquest terminal'
    'logs:Imprimir la sortida recent del terminal d'\''una sessió en segon pla'
    'stop:Aturar una sessió en segon pla (la seva conversa es conserva)'
    'respawn:Reiniciar una sessió en segon pla perquè executi la versió actual de Claude Code'
    'rm:Eliminar una sessió en segon pla, i el seu worktree quan sigui segur'
    'remote-control:Controlar sessions locals des de claude.ai/code o l’app mòbil de Claude'
    'daemon:Gestionar el supervisor de sessions en segon pla'
    'auth:Gestionar autenticació'
    'auto-mode:Inspeccionar o restablir la configuració del classificador del mode automàtic'
    'gateway:Executar la passarel·la d'\''autenticació/telemetria empresarial'
    'self-hosted-runner:Allotjar sessions al núvol de Claude Code en aquesta màquina o contenidor'
    'import:Importar la configuració d'\''un altre agent de programació amb IA a Claude Code'
    'project:Gestionar l'\''estat del projecte de Claude Code'
    'purge:Eliminar tot l'\''estat de Claude Code d'\''un projecte (transcripcions, tasques, historial de fitxers, entrada de configuració)'
    'ultrareview:Executar una revisió de codi multi-agent allotjada al núvol i imprimir els resultats'
    'setup-token:Configurar token d'\''autenticació a llarg termini (requereix subscripció Claude)'
    'doctor:Comprovació d'\''integritat per a l'\''actualitzador automàtic de Claude Code'
    'update:Comprovar i instal·lar actualitzacions'
    'install:Instal·lar versió nativa de Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Activar mode depuració amb filtratge opcional per categoria (ex: "api,hooks" o "!statsig,!file")]:filter:'
    '--verbose[Substituir configuració de mode detallat del fitxer de configuració]'
    '(-p --print)'{-p,--print}'[Imprimir resposta i sortir (per a ús amb canonades). Nota: utilitzar només en directoris de confiança]'
    '--output-format[Format de sortida (amb --print): "text" (predeterminat), "json" (resultat únic), o "stream-json" (transmissió en temps real)]:format:(text json stream-json)'
    '--json-schema[Esquema JSON per a validació de sortida estructurada]:schema:'
    '--include-partial-messages[Incloure fragments de missatges parcials a mesura que arriben (amb --print i --output-format=stream-json)]'
    '--input-format[Format d'\''entrada (amb --print): "text" (predeterminat) o "stream-json" (entrada de transmissió en temps real)]:format:(text stream-json)'
    '--dangerously-skip-permissions[Ometre totes les comprovacions de permisos. Recomanat només per a entorns sandbox sense accés a Internet]'
    '--allow-dangerously-skip-permissions[Activar opció per ometre comprovacions de permisos sense activar-la per defecte]'
    '--restricted[Mode restringit: eliminar WebFetch i les eines que executen ordres o codi, ignorar la configuració user/project/local i limitar les eines de fitxers als directoris de treball]'
    '--max-budget-usd[Import màxim en dòlars a gastar en trucades API (només --print)]:amount:'
    '--max-turns[Limitar el nombre de torns agèntics (només --print)]:turns:'
    '--replay-user-messages[Reenviar missatges d'\''usuari des de stdin a stdout per a confirmació]'
    '--allowed-tools[Llista separada per comes o espais de noms d'\''eines permeses (ex: "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Llista separada per comes o espais de noms d'\''eines permeses (format camelCase)]:tools:'
    '--tools[Especificar llista d'\''eines disponibles del conjunt integrat. Només mode impressió]:tools:'
    '--disallowed-tools[Llista separada per comes o espais de noms d'\''eines no permeses (ex: "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Llista separada per comes o espais de noms d'\''eines no permeses (format camelCase)]:tools:'
    '--mcp-config[Carregar servidors MCP des d'\''un fitxer JSON o cadena (separats per espais)]:configs:'
    '--system-prompt[Indicació del sistema a utilitzar per a la sessió]:prompt:'
    '--system-prompt-file[Llegir la indicació del sistema des d'\''un fitxer]:file:_files'
    '--append-system-prompt[Afegir indicació del sistema a la indicació del sistema predeterminada]:prompt:'
    '--append-system-prompt-file[Llegir la indicació del sistema des d'\''un fitxer i afegir-la a la indicació del sistema predeterminada]:file:_files'
    '(--append-subagent-system-prompt-file)--append-subagent-system-prompt[Afegir text a la indicació del sistema de cada subagent (només --print)]:prompt:'
    '(--append-subagent-system-prompt)--append-subagent-system-prompt-file[Llegir text d’un fitxer i afegir-lo a les indicacions del sistema dels subagents (només --print)]:file:_files'
    '--system-prompt-snapshot[Registrar la indicació del sistema una vegada per conversa i reutilitzar-la literalment a cada petició i en reprendre (on, predeterminat) o generar-la de nou a cada petició (off)]:mode:(on off)'
    '--permission-mode[Mode de permisos a utilitzar per a la sessió]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Qui respon les sol·licituds de permís amb --print: "host" (l'\''amfitrió de l'\''SDK o --permission-prompt-tool) o "none" (es denega tot el que demanaria confirmació)]:target:(host none)'
    '--permission-prompt-tool[Eina MCP a utilitzar per a les sol·licituds de permís (només --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Continuar la conversa més recent]'
    '(-r --resume)'{-r,--resume}'[Reprendre una conversa - especificar ID de sessió o seleccionar interactivament]:sessionId:_claude_sessions'
    '--fork-session[Crear nou ID de sessió en lloc de reutilitzar l'\''ID de sessió original en reprendre (amb --resume o --continue)]'
    '--no-session-persistence[Desactivar persistència de sessió - les sessions no es desaran (només --print)]'
    '--model[Model per a la sessió actual. Especificar àlies per al model més recent (ex: '\''sonnet'\'' o '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agent per a la sessió actual. Substitueix la configuració '\''agent'\'']:agent:_claude_agent_names'
    '--betas[Capçaleres beta a incloure en peticions API (només usuaris amb clau API)]:betas:'
    '--fallback-model[Activar canvi automàtic al model especificat quan el model predeterminat està sobrecarregat (només --print)]:model:_claude_model_names'
    '--settings[Ruta a fitxer JSON de configuració o cadena JSON per carregar configuració addicional]:file-or-json:_files'
    '--add-dir[Directoris addicionals per permetre accés a eines]:directories:_directories'
    '--ide[Connexió automàtica a l'\''IDE a l'\''inici si exactament un IDE vàlid està disponible]'
    '--desktop[Obrir a l'\''aplicació Claude Desktop en lloc del terminal (amb --continue o --resume <id> per triar la sessió)]'
    '--strict-mcp-config[Utilitzar només servidors MCP de --mcp-config i ignorar tota la resta de configuració MCP]'
    '--session-id[ID de sessió específic a utilitzar per a la conversa (ha de ser UUID vàlid)]:uuid:'
    '--agents[Objecte JSON que defineix agents personalitzats]:json:'
    '--advisor[Activar l’eina d’assessor del costat del servidor per a aquesta sessió amb un àlies de model o un ID de model complet]:model:_claude_model_names'
    '--teammate-mode[Com es mostren els companys d’un equip d’agents]:mode:(in-process auto tmux iterm2)'
    '--setting-sources[Llista separada per comes de fonts de configuració a carregar (user, project, local)]:sources:'
    '--plugin-dir[Directori per carregar connectors només per a aquesta sessió (repetible)]:paths:_directories'
    '--disable-slash-commands[Desactivar totes les ordres de barra]'
    '(--bg --background)'{--bg,--background}'[Iniciar la sessió com a agent en segon pla i retornar immediatament]'
    '(-w --worktree)'{-w,--worktree}'[Crear un nou worktree de git per a aquesta sessió (opcionalment especificar un nom)]::name:'
    '--tmux=-[Crear una sessió tmux per al worktree (requereix --worktree). Utilitza panells natius d'\''iTerm2 quan estan disponibles; --tmux=classic per al tmux tradicional]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Definir un nom visible per a aquesta sessió]:name:'
    '--effort[Nivell d'\''esforç per a la sessió actual]:level:(low medium high xhigh max)'
    '--autocompact[Mida de la finestra de compactació automàtica (auto, o 100k-1M tokens)]:size:(auto)'
    '--debug-file[Escriure registres de depuració a una ruta de fitxer específica (activa implícitament el mode depuració)]:path:_files'
    '--from-pr[Reprendre una sessió vinculada a un PR per número/URL, o obrir el selector interactiu]::value:'
    '--teleport[Reprendre una sessió de teleport, opcionalment especificar l'\''ID de sessió]::session:'
    '(--remote)--cloud[Crear una sessió al núvol amb la descripció indicada, o connectar-se a una d'\''existent per ID de sessió o URL de claude.ai/code]::description-or-session:'
    '(--cloud)--remote[Àlies obsolet de --cloud]::description-or-session:'
    '--environment[Crear una nova sessió al núvol que s'\''executi a l'\''entorn autoallotjat indicat (ccpool_...)]:environment_id:'
    '--ref[Amb --environment: basar el checkout de la nova sessió en una ref amb nom en lloc del HEAD local]:branch:'
    '(--remote-control --rc)'{--remote-control,--rc}'[Iniciar una sessió interactiva amb Control Remot activat (opcionalment amb nom)]::name:'
    '--remote-control-session-name-prefix[Prefix per als noms de sessió de Control Remot generats automàticament]:prefix:'
    '--chrome[Activar la integració de Claude a Chrome]'
    '--no-chrome[Desactivar la integració de Claude a Chrome]'
    '--plugin-url[Obtenir un .zip de connector des d'\''una URL només per a aquesta sessió (repetible)]:url:'
    '--file[Recursos de fitxer a descarregar a l'\''inici (format: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Activar suggeriments d'\''indicacions (emet una predicció de la següent indicació en mode print/SDK)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Reenviar text i blocs de pensament del subagent com a missatges (amb --print i stream-json)]'
    '--include-hook-events[Incloure tots els esdeveniments del cicle de vida dels hooks al flux de sortida (amb stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Moure les seccions específiques de màquina al primer missatge d'\''usuari per millorar la reutilització de la memòria cau d'\''indicacions]'
    '--brief[Activar l'\''eina SendUserMessage per a la comunicació d'\''agent a usuari]'
    '*--channels[(Vista prèvia de recerca) Servidors MCP les notificacions de canal dels quals cal escoltar (plugin\:<name>@<marketplace>)]:entries:'
    '*--dangerously-load-development-channels[Activar canals que no són a la llista d’autoritzats aprovada, per a desenvolupament local (plugin\:<name>@<marketplace> o server\:<name>)]:entries:'
    '--init[Executar els hooks Setup amb el matcher init abans de la sessió (només --print)]'
    '--init-only[Executar els hooks Setup i SessionStart i després sortir sense iniciar cap conversa]'
    '--maintenance[Executar els hooks Setup amb el matcher maintenance abans de la sessió (només --print)]'
    '--safe-mode[Iniciar amb totes les personalitzacions desactivades (útil per resoldre problemes d'\''una configuració trencada)]'
    '--bare[Mode mínim: ometre hooks, LSP, sincronització de connectors, atribució, auto-memòria i descobriment automàtic de CLAUDE.md]'
    '--ax-screen-reader[Renderitzar sortida compatible amb lectors de pantalla (text pla, sense vores decoratives ni animacions)]'
    '(-v --version)'{-v,--version}'[Mostrar número de versió]'
    '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]'
  )

  # Stop at the first non-option word, so that the options after a command reach
  # that command's own specs instead of being consumed here
  _arguments -C -A '-*' \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandes claude' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin|plugins)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        remote-control|rc|remote|sync|bridge)
          _claude_remote_control
          ;;
        daemon)
          _claude_daemon
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        self-hosted-runner)
          _claude_self_hosted_runner
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        purge)
          _claude_purge
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update|upgrade)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]'
          ;;
        *)
          # Not a command but the prompt: options may still follow it
          _arguments \
            $main_options \
            '*: :'
          ;;
      esac
      ;;
  esac
  local ret=$?

  # The last step, such as listing commands for --r, can fail although options
  # were added before it. Report success then: on failure zsh moves on to the
  # next completers, and _correct or _approximate pile on corrections
  (( compstate[nmatches] > 0 )) || return $ret
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Iniciar un servidor MCP de Claude Code'
    'add:Afegir un servidor MCP a Claude Code'
    'remove:Eliminar un servidor MCP'
    'list:Llistar servidors MCP configurats'
    'get:Obtenir detalls del servidor MCP'
    'add-json:Afegir un servidor MCP (stdio o SSE) amb cadena JSON'
    'add-from-claude-desktop:Importar servidors MCP des de Claude Desktop (només Mac i WSL)'
    'reset-project-choices:Restablir tots els servidors d'\''àmbit de projecte (.mcp.json) aprovats/rebutjats en aquest projecte'
    'login:Autenticar-se amb un servidor MCP (HTTP, SSE o connector de claude.ai)'
    'logout:Esborrar les credencials OAuth emmagatzemades d'\''un servidor MCP'
    'help:Mostrar ajuda'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandes mcp' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Activar mode depuració]' \
            '--verbose[Substituir configuració de mode detallat del fitxer de configuració]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Àmbit de configuració (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Tipus de transport (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Definir variable d'\''entorn (ex: -e CLAU=valor)]:env:' \
            '(-H --header)'{-H,--header}'[Definir capçalera WebSocket]:header:' \
            '--client-id[ID de client OAuth per a servidors HTTP/SSE]:clientId:' \
            '--client-secret[Demanar el secret de client OAuth (o definir la variable d'\''entorn MCP_CLIENT_SECRET)]' \
            '--callback-port[Port fix per a la crida de retorn OAuth (per a servidors que requereixen URI de redirecció registrats prèviament)]:port:' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Àmbit de configuració (local, user, project) - eliminar de l'\''àmbit existent si no s'\''especifica]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Àmbit de configuració (local, user, project)]:scope:(local user project)' \
            '--client-secret[Demanar el secret de client OAuth (o definir la variable d'\''entorn MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Àmbit de configuració (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]'
          ;;
        login)
          _arguments \
            '--no-browser[Imprimir la URL d'\''autorització en lloc d'\''obrir un navegador (per a sessions SSH/sense interfície)]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Validar un connector o manifest de mercat'
    'marketplace:Gestionar mercats de Claude Code'
    'list:Llistar connectors instal·lats'
    'details:Mostrar l'\''inventari de components i el cost projectat de tokens d'\''un connector'
    'configure:Mostrar les opcions d'\''un connector i quines no estan definides, o desar valors des de stdin'
    'install:Instal·lar un connector dels mercats disponibles'
    'i:Instal·lar un connector dels mercats disponibles (forma curta d'\''install)'
    'init:Crear l'\''estructura d'\''un nou connector (es carrega automàticament la següent sessió)'
    'new:Generar l'\''estructura d'\''un nou connector (àlies per a init)'
    'uninstall:Desinstal·lar un connector instal·lat'
    'remove:Desinstal·lar un connector instal·lat (àlies per a uninstall)'
    'enable:Activar un connector desactivat'
    'disable:Desactivar un connector activat'
    'update:Actualitzar un connector a la darrera versió'
    'eval:Executar casos d'\''avaluació contra un connector i informar dels resultats puntuats'
    'prune:Eliminar dependències instal·lades automàticament que ja no calen'
    'autoremove:Eliminar dependències instal·lades automàticament que ja no calen (àlies per a prune)'
    'tag:Crear una etiqueta git {name}--v{version} per a una publicació de connector'
    'test:Executar les proves d'\''un mod'
    'help:Mostrar ajuda'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandes de connector' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Tractar els avisos com a errors (codi de sortida 1)]' \
            '--profile[Sortir també amb codi 1 quan el catàleg indicat rebutjaria un enviament del connector per una comprovació que executa aquesta ordre]:name:(directory)' \
            '--json[Generar l'\''informe de validació com a JSON (mateixos codis de sortida)]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Àmbit d'\''instal·lació]:scope:(user project local)' \
            '--accept-command[Acceptar l’ordre declarada pel mercat el sha256 de la qual una execució anterior amb --json va indicar com a shownCommand.sha256]:sha256:' \
            '*--config[Definir una opció userConfig declarada al manifest del connector (repetible)]:key=value:' \
            '--marketplace[Instal·lar el connector pel seu nom sol des del mercat d’aquesta font (owner/repo, URL git o https, o camí), afegint primer el mercat si cal]:source:' \
            '--registry[Per a una instal·lació package@npm: resoldre i baixar des d’aquest registre npm]:url:' \
            '(-y --yes)'{-y,--yes}'[Acceptar l'\''ordre mostrada declarada pel mercat sense la sol·licitud de confirmació]' \
            '--json[Imprimir una línia de resultat llegible per màquina en lloc del missatge per a humans]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Àmbit d'\''instal·lació]:scope:(user project local)' \
            '--keep-data[Conservar el directori de dades persistents del connector]' \
            '--prune[Eliminar també les dependències instal·lades automàticament que ja no calen]' \
            '(-y --yes)'{-y,--yes}'[Ometre la sol·licitud de confirmació de --prune]' \
            '--json[Imprimir una línia de resultat llegible per màquina en lloc del missatge per a humans (no amb --prune)]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Àmbit d'\''instal·lació]:scope:(user project local)' \
            '--json[Imprimir una línia de resultat llegible per màquina en lloc del missatge per a humans]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Desactivar tots els connectors activats]' \
            '(-s --scope)'{-s,--scope}'[Àmbit d'\''instal·lació]:scope:(user project local)' \
            '--json[Imprimir una línia de resultat llegible per màquina en lloc del missatge per a humans]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '--accept-command[Acceptar l’ordre declarada pel mercat el sha256 de la qual una execució anterior amb --json va indicar com a shownCommand.sha256]:sha256:' \
            '(-s --scope)'{-s,--scope}'[Àmbit d'\''instal·lació]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Acceptar l'\''ordre mostrada declarada pel mercat sense la sol·licitud de confirmació]' \
            '--json[Imprimir una línia de resultat llegible per màquina en lloc del missatge per a humans]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Sortida com a JSON]' \
            '--available[Incloure els connectors disponibles dels mercats (requereix --json)]' \
            '--data-size[Mesurar el directori de dades desades de cada connector instal·lat, o només del connector indicat (requereix --json)]::plugin:_claude_installed_plugins' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Netejar a l'\''àmbit]:scope:(user project local)' \
            '--dry-run[Llistar el que s'\''eliminaria sense eliminar res]' \
            '(-y --yes)'{-y,--yes}'[Ometre la sol·licitud de confirmació]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]'
          ;;
        configure)
          _arguments \
            '--json[Sortida com a JSON]' \
            '--values-stdin[Llegir els valors de les opcions des de stdin com un objecte JSON de cadenes d'\''una sola línia; les opcions omeses conserven els seus valors]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Descripció del manifest]:text:' \
            '--author[Nom de l'\''autor (predeterminat: git config user.name)]:name:' \
            '--author-email[Correu electrònic de l'\''autor (predeterminat: git config user.email)]:email:' \
            '--with[Components dels quals també cal generar l'\''estructura]:components:' \
            '(-f --force)'{-f,--force}'[Sobreescriure un .claude-plugin/ existent a la destinació]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '1:name:'
          ;;
        eval)
          if [[ $words[2] == init ]]; then
            _arguments \
              '--bare[Escriure una plantilla en blanc en lloc de fer l’entrevista]' \
              '--eval-dir[Directori sota el directori actual on escriure els casos]:dir:_directories' \
              '(-i --interactive)'{-i,--interactive}'[Fer l’entrevista d’autoria (requereix un terminal interactiu)]' \
              '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
              '::name:'
            return
          fi
          _arguments \
            '--case[Filtrar casos per patró glob de nom]:glob:' \
            '*--tag[Filtrar casos per etiqueta (repetible)]:tag:' \
            '--runs[Substituir el nombre d'\''execucions per cas (predeterminat: case.runs, si no 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Fer fins a n execucions d'\''agent alhora (1-8; predeterminat 1)]:n:' \
            '--model[Substituir el model per a tots els casos]:model:_claude_model_names' \
            '--judge-model[Substituir el model avaluador LLM (predeterminat: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Límit estricte de cost; si s'\''assoleix, avortar i informar dels resultats parcials (codi de sortida 2)]:usd:' \
            '--output-dir[Directori per a aggregate-result.json]:dir:_directories' \
            '--eval-dir[Nom del directori (dins del connector) que conté els casos d'\''avaluació]:dir:' \
            '--json[Imprimir el resultat complet de l'\''execució com a JSON a stdout, o escriure'\''l en aquest fitxer .json]::path:_files' \
            '--threshold[Sortir amb codi de sortida 1 si la puntuació d'\''algun cas és inferior a aquest llindar (predeterminat: 1.0)]:threshold:' \
            '*--allow-tools[Autorització de l'\''operador per a eines restringides (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '*--disallow-tools[Eines integrades que s’han de negar a Claude en tots els casos, encara que s’hagin concedit]:tools:' \
            '(--no-scaffold)--scaffold[Executar el scaffold_script de cada cas (executa bash proporcionat per l'\''autor en nom teu; desactivat per defecte)]' \
            '(--scaffold)--no-scaffold[Ometre explícitament scaffold_script]' \
            '--trust-plugin[Afirmar que confies en aquest connector i el seu conjunt d'\''avaluació, ometent la sol·licitud de confiança de la primera execució (per a CI)]' \
            '--ablation[Executar un grup de control de referència sense connector i informar de la diferència de puntuació]:mode:(none with-without)' \
            '--mocks[Simulacres que substitueixen servidors MCP, des de <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Amb --mocks record: iniciar també els processos reals de servidor MCP que no tenen simulacre]' \
            '--keep-temp[Conservar els directoris d'\''estructura per a depuració]' \
            '--verbose[Registrar esdeveniments de traça per missatge al registre de depuració]' \
            '--report[Escriure l'\''informe HTML autocontingut en aquesta ruta en lloc del directori de resultats]:path:_files' \
            '(--no-publish)--publish-report[Exigir també la publicació de l'\''informe a claude.ai]' \
            '(--publish-report)--no-publish[Mantenir l'\''informe HTML només en local; ometre la publicació a claude.ai]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '::target: _alternative "commands\:eval command\:(init)" "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Enviar l'\''etiqueta a --remote després de crear-la]' \
            '--dry-run[Imprimir el que s'\''etiquetaria sense crear l'\''etiqueta]' \
            '(-f --force)'{-f,--force}'[Ometre les comprovacions d'\''arbre de treball amb canvis i d'\''etiqueta ja existent]' \
            '(-m --message)'{-m,--message}'[Missatge d'\''anotació de l'\''etiqueta (utilitzar %s per a la versió)]:msg:' \
            '--remote[Remot al qual enviar amb --push]:name:' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Afegir un mercat des d'\''una URL, ruta o repositori GitHub'
    'list:Llistar mercats configurats'
    'remove:Eliminar un mercat configurat'
    'rm:Eliminar un mercat configurat (àlies per a remove)'
    'update:Actualitzar mercat des de la font - actualitzar tots si no s'\''especifica cap nom'
    'help:Mostrar ajuda'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandes de mercat' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Limitar el checkout a directoris específics mitjançant git sparse-checkout (per a monorepos)]:paths:' \
            '--scope[On declarar el mercat]:scope:(user project local)' \
            '--json[Imprimir una línia de resultat llegible per màquina com a última línia a stdout]' \
            '--claudeai[Afegir el mercat amb aquest nom que claude.ai allotja per a tu]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Sortida com a JSON]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Eliminar la declaració del mercat d'\''un àmbit de configuració específic (ometre per eliminar-la de tots els àmbits)]:scope:(user project local)' \
            '--json[Imprimir una línia de resultat llegible per màquina com a última línia a stdout]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '--json[Amb un nom de mercat: imprimir una línia de resultat llegible per màquina com a última línia a stdout]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Forçar instal·lació encara que ja estigui instal·lat]' \
    '(-h --help)'{-h,--help}'[Mostrar ajuda]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Directori addicional per permetre accés a eines en sessions despatxades]:directory:_directories' \
    '--agent[Agent predeterminat per a sessions despatxades des de la vista d'\''agents]:agent:_claude_agent_names' \
    '--all[Amb --json: incloure també les sessions en segon pla completades]' \
    '--allow-dangerously-skip-permissions[Fer disponible el mode d'\''ometre permisos a les sessions despatxades]' \
    '--cwd[Mostrar només les sessions en segon pla iniciades sota la ruta]:path:_directories' \
    '--dangerously-skip-permissions[Àlies per a --permission-mode bypassPermissions]' \
    '--effort[Nivell d'\''esforç predeterminat per a sessions despatxades]:level:(low medium high xhigh max)' \
    '--json[Imprimir les sessions actives com a matriu JSON i sortir]' \
    '*--mcp-config[Configuració del servidor MCP a aplicar a les sessions despatxades]:config:' \
    '--model[Model predeterminat per a sessions despatxades des de la vista d'\''agents]:model:_claude_model_names' \
    '--permission-mode[Mode de permisos predeterminat per a sessions despatxades]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Carregar connectors des del directori per a la vista d'\''agents i les sessions despatxades]:path:_directories' \
    '--setting-sources[Llista separada per comes de fonts de configuració a carregar (user, project, local)]:sources:' \
    '--settings[Fitxer de configuració o cadena JSON a aplicar]:file-or-json:_files' \
    '--strict-mcp-config[Utilitzar només servidors MCP de --mcp-config en sessions despatxades]' \
    '--restricted[Iniciar les sessions despatxades en mode restringit]' \
    '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Iniciar sessió al teu compte d'\''Anthropic'
    'logout:Tancar sessió del teu compte d'\''Anthropic'
    'status:Mostrar l'\''estat d'\''autenticació'
    'help:Mostrar ajuda'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandes auth' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Emplenar prèviament l'\''adreça de correu electrònic a la pàgina d'\''inici de sessió]:email:' \
            '--sso[Forçar el flux d'\''inici de sessió SSO]' \
            '(--claudeai)--console[Utilitzar Anthropic Console (facturació per ús de l'\''API) en lloc de la subscripció Claude]' \
            '(--console)--claudeai[Utilitzar la subscripció Claude (predeterminat)]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]'
          ;;
        status)
          _arguments \
            '(--text)--json[Sortida com a JSON (predeterminat)]' \
            '(--json)--text[Sortida com a text llegible per humans]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Imprimir la configuració efectiva del mode automàtic com a JSON'
    'critique:Obtenir comentaris d'\''IA sobre les teves regles personalitzades del mode automàtic'
    'defaults:Imprimir les regles predeterminades del mode automàtic com a JSON'
    'reset:Restablir la configuració del mode automàtic als valors predeterminats de fàbrica'
    'help:Mostrar ajuda'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandes auto-mode' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Substituir el model que s'\''utilitza]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]'
          ;;
        defaults)
          _arguments \
            '--label[Mostrar només les regles l'\''etiqueta de les quals comença amb aquest prefix (sense distingir majúscules i minúscules)]:prefix:' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Ometre la sol·licitud de confirmació]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Ruta al fitxer de configuració YAML de la passarel·la]:path:_files' \
    '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Eliminar tot l'\''estat de Claude Code d'\''un projecte (transcripcions, tasques, historial de fitxers, entrada de configuració)'
    'help:Mostrar ajuda'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandes project' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Llistar el que s'\''eliminaria sense eliminar res]' \
            '(-y --yes)'{-y,--yes}'[Ometre la sol·licitud de confirmació]' \
            '(-i --interactive)'{-i,--interactive}'[Demanar confirmació per a cada element abans d'\''eliminar-lo]' \
            '(1)--all[Eliminar l'\''estat de tots els projectes (mútuament excloent amb una ruta)]' \
            '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_purge() {
  _arguments \
    '--dry-run[Llistar el que s'\''eliminaria sense eliminar res]' \
    '(-y --yes)'{-y,--yes}'[Ometre la sol·licitud de confirmació]' \
    '(-i --interactive)'{-i,--interactive}'[Demanar confirmació per a cada element abans d'\''eliminar-lo]' \
    '(1)--all[Eliminar l'\''estat de tots els projectes (mútuament excloent amb una ruta)]' \
    '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]' \
    '(--all)::path:_directories'
}

_claude_ultrareview() {
  _arguments \
    '--json[Imprimir la càrrega útil bugs.json en brut en lloc dels resultats formatats]' \
    '--timeout[Minuts màxims a esperar que finalitzi la revisió (predeterminat: 45)]:minutes:' \
    '(--no-post)--post[Publicar les troballes de la revisió finalitzada al PR en nom teu (només per a objectius PR; un comentari simple, no una revisió)]' \
    '(--post)--no-post[No publicar les troballes al PR (predeterminat)]' \
    '--trust-workspace[Confiar en la carpeta actual només per a aquesta execució, sense preguntar (per a scripts i CI)]' \
    '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Reiniciar totes les sessions en segon pla en execució]' \
    '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Descartar també els commits no enviats i els canvis no confirmats del worktree (passar el commit@worktree-id que va indicar un claude rm anterior)]:commit@worktree-id:' \
    '--force-remove-worktree[Eliminar el directori del worktree encara que el hook WorktreeRemove o git no l'\''hagin pogut eliminar (passar el worktree-id que va indicar un claude rm anterior)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]' \
    '1:session:_claude_background_sessions'
}

_claude_self_hosted_runner() {
  _arguments \
    '--api-url[URL base de l’API (predeterminat: https://api.anthropic.com)]:url:' \
    '--environment-secret-file[Camí al fitxer de secret de l’entorn]:path:_files' \
    '--lock-to-account[Bloquejar el runner a un sol compte en el registre]:id:' \
    '--client-label[Etiqueta d’observabilitat enviada en el registre (predeterminat: hostname)]:label:' \
    '(--proxy-authorization-file --agent-proxy-url)--proxy-authorization-command[Ordre la sortida stdout de la qual és la capçalera Proxy-Authorization per als servidors intermediaris de sortida]:shell command:' \
    '(--proxy-authorization-command --agent-proxy-url)--proxy-authorization-file[Fitxer que conté la capçalera Proxy-Authorization per als servidors intermediaris de sortida]:path:_files' \
    '(--proxy-authorization-command --proxy-authorization-file)--agent-proxy-url[Encaminar totes les sessions a través del servidor intermediari d’agent en aquesta URL (només https)]:url:' \
    '--capacity[Màxim de sessions simultànies (predeterminat: 1)]:n:' \
    '--base-dir[Directori base per als checkouts de repositoris (predeterminat: /workspace)]:path:_directories' \
    '--exec-path[Binari que s’executa per a les sessions filles (predeterminat: aquest binari)]:path:_files' \
    '--hooks-dir[Directori dels scripts de hooks del cicle de vida (checkout, command, post-session)]:path:_directories' \
    '--session-stop-grace-sec[Quant de temps esperar una sortida neta després que acabi una sessió (predeterminat: 5)]:n:' \
    '--post-session-hook-timeout-sec[Temps màxim de SIGTERM per al hook post-session (predeterminat: 60)]:n:' \
    '--checkout-hook-timeout-min[Temps real màxim per a cada execució del hook checkout (predeterminat: 30; 0 ho desactiva)]:n:' \
    '--drain-wait-sec[En rebre SIGTERM/SIGINT, esperar fins a N segons la feina en curs (predeterminat: 0)]:n:' \
    '--drain-marker-file[Fitxer marcador amb què l’amfitrió anuncia un buidatge ordenat]:path:_files' \
    '*--git-ssh-rewrite[Reescriure les URL d’origen https://<host>/... a git@<host>:... (repetible)]:host:' \
    '*--git-host-rewrite[Reescriure les URL d’origen https://<f>/... a https://<t>/... (repetible)]:from=to:' \
    '--use-anthropic-git-proxy[Utilitzar git gestionat per Anthropic. ADVERTÈNCIA: elimina i substitueix la configuració de git a nivell de HOME, utilitzar només amb un compte dedicat]' \
    '--configure-git[Definir la identitat global de git i activar la signatura de commits mitjançant el servei de signatura d’Anthropic. Escriu ~/.gitconfig]' \
    '--push-outcome-on-release[Fer push de les branques de resultat seguides quan el runner acaba una sessió sense completar-la]' \
    '--trust-workspace[Predefinir la confiança persistent per als camins del repositori de cada sessió (predeterminat: true)]::bool:(true false)' \
    '--remove-session-state[Eliminar l’estat de cada sessió quan acaba (predeterminat: false)]::bool:(true false)' \
    '--diff-finds-nested-repository[Mostrar un repositori clonat en una subcarpeta al panell Changes; requereix --capacity 1 (predeterminat: false)]::bool:(true false)' \
    '--confine-repo-settings[Mode de la protecció de confinament de la configuració confirmada al repositori (predeterminat: warn)]:mode:(warn enforce off)' \
    '--server-auto-mode-lists[Quines llistes del classificador del mode auto del servidor pot rebre una sessió (predeterminat: no-allow)]:mode:(all no-allow none)' \
    '--host-config-snapshot[On es desa la instantània d’inici de la configuració de l’amfitrió (predeterminat: disk)]:mode:(disk memory)' \
    '--health-port[Port per a l’escoltador HTTP /healthz (predeterminat: 8080; 0 ho desactiva)]:port:' \
    '--log-level[Nivell de registre (predeterminat: info)]:level:(info debug)' \
    '--log-file[Copiar també els registres del runner a un fitxer en mode d’afegir (com tee)]:path:_files' \
    '--exit-if-unused-min[Sortir del runner si no se li assigna cap feina durant N minuts]:n:' \
    '--drain-grace-sec[Segons durant els quals continuar consultant si hi ha feina després que acabin les sessions actives (predeterminat: 0)]:n:' \
    '--retire-at[Retirar el runner en aquest temps Unix absolut, en segons]:epoch-seconds:' \
    '--defer-shutdown-max-min[Al primer SIGTERM/SIGINT, deixar d’acceptar feina i acabar l’aturada M minuts després (predeterminat: 0)]:m:' \
    '--release-idle-session-min[Alliberar una plaça de sessió després de N minuts sense entrada de l’usuari]:n:' \
    '--startup-timeout-min[Alliberar una plaça de sessió si el procés fill no ha acabat d’arrencar després de N minuts (predeterminat: 15; 0 ho desactiva)]:n:' \
    '--kill-session-after-min[Limitar la durada en temps real d’un procés fill de sessió a N minuts]:n:' \
    '--debug-token-dir[NOMÉS PER A DEPURACIÓ: escriu tokens actius al disc. No utilitzar en producció]:path:_directories' \
    '(-h --help)'{-h,--help}'[Mostrar aquest missatge d’ajuda]'
}

_claude_remote_control() {
  _arguments \
    '--name[Nom de la sessió (es mostra a claude.ai/code)]:name:' \
    '--remote-control-session-name-prefix[Prefix per als noms de sessió generats automàticament (predeterminat: hostname)]:prefix:' \
    '(-c --continue --session-id)'{-c,--continue}'[Tornar a connectar a la darrera sessió registrada per a aquest directori o un dels seus worktrees de git]' \
    '(-c --continue --session-id)--session-id[Tornar a connectar a una sessió concreta per ID]:id:' \
    '--permission-mode[Mode de permisos per a les sessions generades]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)' \
    '(--no-chrome)--chrome[Activar Claude in Chrome per a les sessions generades]' \
    '(--chrome)--no-chrome[Desactivar Claude in Chrome per a les sessions generades]' \
    '(-d --debug)'{-d,--debug}'[Activar mode depuració amb filtratge opcional per categoria]::filter:' \
    '--debug-file[Escriure els registres de depuració a un fitxer]:path:_files' \
    '(-v --verbose)'{-v,--verbose}'[Activar la sortida detallada]' \
    '--spawn[Mode de generació (predeterminat: same-dir)]:mode:(same-dir worktree session)' \
    '--capacity[Màxim de sessions simultànies en mode worktree o same-dir (predeterminat: 32)]:n:' \
    '(--no-create-session-in-dir)--create-session-in-dir[Crear prèviament una sessió al directori actual (predeterminat)]' \
    '(--create-session-in-dir)--no-create-session-in-dir[No crear prèviament una sessió al directori actual]' \
    '(-h --help)'{-h,--help}'[Mostrar aquesta ajuda]'
}

_claude_daemon() {
  local -a daemon_commands common_options
  daemon_commands=(
    'run:Executar el supervisor en primer pla'
    'status:Mostrar el pid, la versió i el temps d’activitat del daemon'
    'logs:Seguir el registre del daemon (Ctrl-C per aturar)'
    'uninstall:Eliminar el servei en segon pla (launchctl/systemd)'
    'stop:Aturar el supervisor i finalitzar les sessions en segon pla'
  )
  common_options=(
    '--json-path[Fitxer de configuració (predeterminat: ~/.claude/daemon.json)]:path:_files'
    '--log-file[Fitxer de registre (predeterminat: ~/.claude/daemon.log)]:path:_files'
    '(-h --help)'{-h,--help}'[Mostrar aquesta ajuda]'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    $common_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandes daemon' daemon_commands
      ;;
    args)
      case $words[1] in
        run)
          _arguments \
            $common_options \
            '::json-path:_files'
          ;;
        stop)
          _arguments \
            $common_options \
            '--any[Aturar també un daemon transitori (no servei)]' \
            '--keep-workers[Deixar les sessions desconnectades en execució]'
          ;;
        status|logs|uninstall)
          _arguments \
            $common_options
          ;;
      esac
      ;;
  esac
}

_claude_import() {
  _arguments \
    '--dry-run[Mostrar el que s'\''importaria sense escriure res]' \
    '--yes[Ometre el selector interactiu (en entorns sense interfície, passar --yes=<digest> de la previsualització de /import)]' \
    '(-h --help)'{-h,--help}'[Mostrar ajuda per a la comanda]' \
    '::source:(codex gemini cursor)'
}

# compinit autoloads this file, and that first call only defines the functions
# above: complete right away so the first TAB already works. Sourced directly,
# there is nothing to complete yet, only the registration.
if [[ $funcstack[1] == _claude ]]; then
  _claude "$@"
else
  (( $+_comps[claude] )) || compdef _claude claude
fi
