#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Configurâ e gjestî i servidôrs MCP'
    'plugin:Gjestî i plugin di Claude Code'
    'agents:Gjestî i agjents in sotfont'
    'attach:Vierzi une session in sotfont in chest terminâl'
    'logs:Stampâ la jessude resinte dal terminâl di une session in sotfont'
    'stop:Fermâ une session in sotfont (la sô conversazion e ven tignude)'
    'respawn:Tornâ a inviâ une session in sotfont par che e eseguissi la version atuâl di Claude Code'
    'rm:Eliminâ une session in sotfont, e il so worktree cuant che al è sigûr'
    'remote-control:Controlâ lis sessions locâls di claude.ai/code o de app mobile di Claude'
    'daemon:Gjestî il supervisôr des sessions in sotfont'
    'auth:Gjestî la autenticazion'
    'auto-mode:Ispezionâ o ristabilî la configurazion dal classificadôr de modalitât automatiche'
    'gateway:Eseguî il gateway di autenticazion/telemetrie enterprise'
    'self-hosted-runner:Ospitâ sessions cloud di Claude Code su cheste machine o container'
    'import:Impuartâ la configurazion di un altri agjent di programazion IA in Claude Code'
    'project:Gjestî il stât dal progjet di Claude Code'
    'purge:Eliminâ dut il stât di Claude Code par un progjet (trascrizions, ativitâts, storic dai file, vôs di configurazion)'
    'ultrareview:Eseguî une revision dal codiç multi-agjent ospitade in cloud e stampâ i risultâts'
    'setup-token:Configurâ il token di autenticazion a lungje scjadince (al covente un abonament Claude)'
    'doctor:Control di santâri pal inzornament automatic di Claude Code'
    'update:Verificâ e instalâ i inzornaments'
    'install:Instalâ la compilazion nativie di Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Ativâ la modalitât di debug cun filtrament opzionâl par categorie (es: "api,hooks" o "!statsig,!file")]:filter:'
    '--verbose[Sostituî la impostazion de modalitât detaiade dal file di configurazion]'
    '(-p --print)'{-p,--print}'[Stampâ la rispueste e jessî (par doprâ cui tubs). Note: doprâ dome in diretoriis fidâts]'
    '--output-format[Formât di jessude (cun --print): "text" (predefinît), "json" (risultât unic), o "stream-json" (trasmission in timp reâl)]:format:(text json stream-json)'
    '--json-schema[Scheme JSON par validazion di jessude struturade]:schema:'
    '--include-partial-messages[Includi i tocs di messaçs parziâi che a rivin (cun --print e --output-format=stream-json)]'
    '--input-format[Formât di jentrade (cun --print): "text" (predefinît) o "stream-json" (jentrade in trasmission timp reâl)]:format:(text stream-json)'
    '--dangerously-skip-permissions[Saltâ dutis lis verificazions di permès. Conseât dome pai sandbox cence acès a internet]'
    '--allow-dangerously-skip-permissions[Ativâ la opzion di saltâ lis verificazions di permès cence ativâle in automatic]'
    '--restricted[Modalitât limitade: gjavâ i struments che a eseguissin comants o codiç e WebFetch, ignorâ lis impostazions user/project/local e limitâ i struments dai file ai diretoriis di lavôr]'
    '--max-budget-usd[Impuart massim in dolars di spindi pes clamadis API (dome --print)]:amount:'
    '--max-turns[Limitâ il numar di turnis agjentics (dome --print)]:turns:'
    '--replay-user-messages[Tornâ a mandâ i messaçs utent di stdin a stdout par confermâ]'
    '--allowed-tools[Liste separade di virgulis o spazis dai nons dai struments permetûts (es: "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Liste separade di virgulis o spazis dai nons dai struments permetûts (formât camelCase)]:tools:'
    '--tools[Specificâ la liste dai struments disponibii dal insiemi integrât. Modalitât di stampe dome]:tools:'
    '--disallowed-tools[Liste separade di virgulis o spazis dai nons dai struments no permetûts (es: "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Liste separade di virgulis o spazis dai nons dai struments no permetûts (formât camelCase)]:tools:'
    '--mcp-config[Cjariâ i servidôrs MCP di un file JSON o une stringhe (separâts di spazis)]:configs:'
    '--system-prompt[Prompt di sisteme di doprâ pe session]:prompt:'
    '--system-prompt-file[Lei il prompt di sisteme di un file]:file:_files'
    '--append-system-prompt[Zontâ un prompt di sisteme al prompt di sisteme predefinît]:prompt:'
    '--append-system-prompt-file[Lei il prompt di sisteme di un file e zontâlu al prompt di sisteme predefinît]:file:_files'
    '(--append-subagent-system-prompt-file)--append-subagent-system-prompt[Zontâ test al prompt di sisteme di ogni sot-agjent (dome --print)]:prompt:'
    '(--append-subagent-system-prompt)--append-subagent-system-prompt-file[Lei test di un file e zontâlu ai prompts di sisteme dai sot-agjents (dome --print)]:file:_files'
    '--system-prompt-snapshot[Regjistrâ il prompt di sisteme une volte par conversazion e tornâ a doprâlu peraule par peraule a ogni richieste e ripristinament (on, il predefinît) o gjenerâlu di gnûf a ogni richieste (off)]:mode:(on off)'
    '--permission-mode[Modalitât di permès di doprâ pe session]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Cui che al rispuint aes domandis di permès cun --print: "host" (l'\''host SDK o --permission-prompt-tool) o "none" (dut ce che al domandarès al ven refudât)]:target:(host none)'
    '--permission-prompt-tool[Strument MCP di doprâ pes domandis di permès (dome --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Continuâ la conversazion plui resinte]'
    '(-r --resume)'{-r,--resume}'[Ripristinâ une conversazion - specificâ l'\''ID di session o sielzi in mût interatîf]:sessionId:_claude_sessions'
    '--fork-session[Creâ un gnûf ID di session invezit di tornâ a doprâ l'\''ID di session origjinâl cuant che si ripristine (cun --resume o --continue)]'
    '--no-session-persistence[Disativâ la persistence de session - lis session no vegnin salvadis (dome --print)]'
    '--model[Model pe session atuâl. Specificâ un alias pal model plui resint (es: '\''sonnet'\'' o '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agjent pe session atuâl. Al sostituìs la impostazion '\''agent'\'']:agent:_claude_agent_names'
    '--betas[Intestazions beta di includi tes richiestis API (dome utents cun clâf API)]:betas:'
    '--fallback-model[Ativâ il passaç automatic al model specificât cuant che il model predefinît al è sovracjariât (dome --print)]:model:_claude_model_names'
    '--settings[Percors a un file JSON di impostazions o une stringhe JSON par cjariâ impostazions adizionâls]:file-or-json:_files'
    '--add-dir[Diretoriis adizionâi par permetê l'\''acès ai struments]:directories:_directories'
    '--ide[Conession automatiche al IDE al inviament se dome un IDE vâlid al è disponibil]'
    '--desktop[Vierzi te aplicazion Claude Desktop invezit che tal terminâl (cun --continue o --resume <id> par sielzi la session)]'
    '--strict-mcp-config[Doprâ dome i servidôrs MCP di --mcp-config e ignorâ dutis lis altris impostazions MCP]'
    '--session-id[ID di session specific di doprâ pe conversazion (al à di jessi UUID vâlid)]:uuid:'
    '--agents[Ogjet JSON che al definìs agjents personalizâts]:json:'
    '--advisor[Ativâ il strument advisor de bande dal servidôr par cheste session cuntun alias di model o un ID di model complet]:model:_claude_model_names'
    '--teammate-mode[Cemût che a vegnin mostrâts i compagns di une scuadre di agjents]:mode:(in-process auto tmux iterm2)'
    '--setting-sources[Liste separade di virgulis di fonts di impostazions di cjariâ (user, project, local)]:sources:'
    '--plugin-dir[Diretori par cjariâ i plugin dome par cheste session (ripetibil)]:paths:_directories'
    '--disable-slash-commands[Disativâ ducj i comants slash]'
    '(--bg --background)'{--bg,--background}'[Inviâ la session come agjent in sotfont e tornâ daurman]'
    '(-w --worktree)'{-w,--worktree}'[Creâ un gnûf git worktree par cheste session (opzionalmentri specificâ un non)]::name:'
    '--tmux=-[Creâ une session tmux pal worktree (al covente --worktree). Al dopre i panei natîfs di iTerm2 cuant che a son disponibii; --tmux=classic pal tmux tradizionâl]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Stabilî un non di visualizazion par cheste session]:name:'
    '--effort[Nivel di sfuarç pe session atuâl]:level:(low medium high xhigh max)'
    '--autocompact[Dimension dal barcon pe compatazion automatiche (auto, o 100k-1M token)]:size:(auto)'
    '--debug-file[Scrivi i regjistris di debug suntun percors di file specific (al ative implicitementri la modalitât di debug)]:path:_files'
    '--from-pr[Ripristinâ une session leade a une PR par numar/URL, o vierzi il seletôr interatîf]::value:'
    '--teleport[Ripristinâ une session teleport, opzionalmentri specificâ l'\''ID di session]::session:'
    '(--remote)--cloud[Creâ une session cloud cu la descrizion dade, o tacâsi a une esistent par ID di session o URL claude.ai/code]::description-or-session:'
    '(--cloud)--remote[Alias deprecât di --cloud]::description-or-session:'
    '--environment[Creâ une gnove session cloud che e zire tal ambient autospitât indicât (ccpool_...)]:environment_id:'
    '--ref[Cun --environment: basâ il checkout de gnove session suntune ref cun non invezit che sul HEAD locâl]:branch:'
    '(--remote-control --rc)'{--remote-control,--rc}'[Inviâ une session interative cul Control Rimot ativât (opzionalmentri cun non)]::name:'
    '--remote-control-session-name-prefix[Prefìs pai nons di session dal Control Rimot gjenerâts in automatic]:prefix:'
    '--chrome[Ativâ la integrazion di Claude in Chrome]'
    '--no-chrome[Disativâ la integrazion di Claude in Chrome]'
    '--plugin-url[Recuperâ un .zip di plugin di une URL dome par cheste session (ripetibil)]:url:'
    '--file[Risorsis di file di discjariâ al inviament (formât: file_id:percors_relatîf)]:specs:'
    '--prompt-suggestions[Ativâ i sugjeriments di prompt (al emet un prompt sucessîf previodût in modalitât print/SDK)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Mandâ indenant il test e i blocs di pinsîr dal sot-agjent come messaçs (cun --print e stream-json)]'
    '--include-hook-events[Includi ducj i events dal cicli di vite dai hook tal flus di jessude (cun stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Spostâ lis sezions par machine tal prin messaç utent par miorâ il torna-doprâ de cache dal prompt]'
    '--brief[Ativâ il strument SendUserMessage pe comunicazion agjent-utent]'
    '*--channels[(Anteprime di ricercje) Servidôrs MCP che si scoltin lis lôr notifichis di canâl (plugin\:<name>@<marketplace>)]:entries:'
    '*--dangerously-load-development-channels[Ativâ canâi che no son te liste dai permetûts aprovade, pal disvilup locâl (plugin\:<name>@<marketplace> o server\:<name>)]:entries:'
    '--init[Eseguî i hook Setup cul matcher init prime de session (dome --print)]'
    '--init-only[Eseguî i hook Setup e SessionStart, po jessî cence tacâ une conversazion]'
    '--maintenance[Eseguî i hook Setup cul matcher maintenance prime de session (dome --print)]'
    '--safe-mode[Inviâ cun dutis lis personalizazions disativadis (util par risolvi une configurazion rote)]'
    '--bare[Modalitât minime: saltâ hooks, LSP, sincronizazion plugin, atribuzion, auto-memorie e la scuvierte automatiche di CLAUDE.md]'
    '--ax-screen-reader[Gjenerâ une jessude compatibile cui letôrs di schermi (test plat, cence ôrs decoratîfs o animazions)]'
    '(-v --version)'{-v,--version}'[Mostrâ il numar di version]'
    '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]'
  )

  # Stop at the first non-option word, so that the options after a command reach
  # that command's own specs instead of being consumed here
  _arguments -C -A '-*' \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comants claude' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin|plugins)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        remote-control|rc|remote|sync|bridge)
          _claude_remote_control
          ;;
        daemon)
          _claude_daemon
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        self-hosted-runner)
          _claude_self_hosted_runner
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        purge)
          _claude_purge
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update|upgrade)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]'
          ;;
        *)
          # Not a command but the prompt: options may still follow it
          _arguments \
            $main_options \
            '*: :'
          ;;
      esac
      ;;
  esac
  local ret=$?

  # The last step, such as listing commands for --r, can fail although options
  # were added before it. Report success then: on failure zsh moves on to the
  # next completers, and _correct or _approximate pile on corrections
  (( compstate[nmatches] > 0 )) || return $ret
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Inviâ un servidôr MCP di Claude Code'
    'add:Zontâ un servidôr MCP a Claude Code'
    'remove:Gjavâ un servidôr MCP'
    'list:Listâ i servidôrs MCP configurâts'
    'get:Otignî i detais dal servidôr MCP'
    'add-json:Zontâ un servidôr MCP (stdio o SSE) cuntune stringhe JSON'
    'add-from-claude-desktop:Impuartâ i servidôrs MCP di Claude Desktop (dome Mac e WSL)'
    'reset-project-choices:Ristabilî ducj i servidôrs di ambit dal progjet (.mcp.json) aprovâts/refudâts in chest progjet'
    'login:Autenticâsi cuntun servidôr MCP (HTTP, SSE o conetôr claude.ai)'
    'logout:Netâ lis credenziâls OAuth memorizadis par un servidôr MCP'
    'help:Mostrâ jutori'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comants mcp' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Ativâ la modalitât di debug]' \
            '--verbose[Sostituî la impostazion de modalitât detaiade dal file di configurazion]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambit di configurazion (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Gjenar di traspuart (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Stabilî une variabil di ambient (es: -e CLÂF=valôr)]:env:' \
            '(-H --header)'{-H,--header}'[Stabilî intestazion WebSocket]:header:' \
            '--client-id[ID dal client OAuth pai servidôrs HTTP/SSE]:clientId:' \
            '--client-secret[Domandâ il segret dal client OAuth (o stabilî la variabil di ambient MCP_CLIENT_SECRET)]' \
            '--callback-port[Puarte fisse pal callback OAuth (pai servidôrs che a domandin URI di redirezion regjistrâts prime)]:port:' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambit di configurazion (local, user, project) - gjavâ dal ambit esistent se no specificât]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambit di configurazion (local, user, project)]:scope:(local user project)' \
            '--client-secret[Domandâ il segret dal client OAuth (o stabilî la variabil di ambient MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambit di configurazion (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]'
          ;;
        login)
          _arguments \
            '--no-browser[Stampâ la URL di autorizazion invezit di vierzi un navigadôr (pes session SSH/cence interface grafiche)]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Validâ un plugin o un manifest di marcjât'
    'marketplace:Gjestî i marcjâts di Claude Code'
    'list:Listâ i plugin instalâts'
    'details:Mostrâ l'\''inventari dai components e il cost previodût in token par un plugin'
    'configure:Mostrâ lis opzions di un plugin e cualis che no son stabilidis, o salvâ i valôrs di stdin'
    'install:Instalâ un plugin dai marcjâts disponibii'
    'i:Instalâ un plugin dai marcjâts disponibii (forme curte di install)'
    'init:Impostâ un gnûf plugin (al ven cjariât in automatic te prossime session)'
    'new:Impostâ un gnûf plugin (alias par init)'
    'uninstall:Disinstalâ un plugin instalât'
    'remove:Disinstalâ un plugin instalât (alias par uninstall)'
    'enable:Ativâ un plugin disativât'
    'disable:Disativâ un plugin ativât'
    'update:Inzornâ un plugin ae ultime version'
    'eval:Eseguî i câs di eval cuintri di un plugin e riferî i risultâts valutâts'
    'prune:Gjavâ lis dipendencis instaladis in automatic che no coventin plui'
    'autoremove:Gjavâ lis dipendencis instaladis in automatic che no coventin plui (alias par prune)'
    'tag:Creâ un git tag {name}--v{version} par une publicazion di plugin'
    'test:Eseguî lis provis di une mod'
    'help:Mostrâ jutori'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comants di plugin' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Tratâ i avertiments come erôrs (codiç di jessude 1)]' \
            '--profile[Jessî cul codiç 1 ancje cuant che il catalic indicât al refudarès une proposte dal plugin suntune verifiche che chest comant al eseguìs]:name:(directory)' \
            '--json[Mandâ fûr il rapuart di validazion come JSON (stes codiçs di jessude)]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambit di instalazion]:scope:(user project local)' \
            '--accept-command[Acetâ il comant declarât dal marcjât che il so sha256 al è stât segnalât di une esecuzion --json di prime come shownCommand.sha256]:sha256:' \
            '*--config[Stabilî une opzion userConfig declarade tal manifest dal plugin (ripetibil)]:key=value:' \
            '--marketplace[Instalâ il plugin cul so non sempliç dal marcjât in cheste origjin (owner/repo, URL git o https, o percors), zontantlu prime se al covente]:source:' \
            '--registry[Par une instalazion package@npm: risolvi e discjamâ di chest regjistri npm]:url:' \
            '(-y --yes)'{-y,--yes}'[Acetâ il comant mostrât declarât dal marcjât cence la domande di conferme]' \
            '--json[Stampâ une rie di risultât leibile de machine invezit dal messaç pes personis]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambit di instalazion]:scope:(user project local)' \
            '--keep-data[Conservâ il diretori dai dâts persistents dal plugin]' \
            '--prune[Gjavâ ancje lis dipendencis instaladis in automatic che no coventin plui]' \
            '(-y --yes)'{-y,--yes}'[Saltâ la domande di conferme di --prune]' \
            '--json[Stampâ une rie di risultât leibile de machine invezit dal messaç pes personis (no cun --prune)]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambit di instalazion]:scope:(user project local)' \
            '--json[Stampâ une rie di risultât leibile de machine invezit dal messaç pes personis]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Disativâ ducj i plugin ativâts]' \
            '(-s --scope)'{-s,--scope}'[Ambit di instalazion]:scope:(user project local)' \
            '--json[Stampâ une rie di risultât leibile de machine invezit dal messaç pes personis]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '--accept-command[Acetâ il comant declarât dal marcjât che il so sha256 al è stât segnalât di une esecuzion --json di prime come shownCommand.sha256]:sha256:' \
            '(-s --scope)'{-s,--scope}'[Ambit di instalazion]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Acetâ il comant mostrât declarât dal marcjât cence la domande di conferme]' \
            '--json[Stampâ une rie di risultât leibile de machine invezit dal messaç pes personis]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Jessude come JSON]' \
            '--available[Includi i plugin disponibii dai marcjâts (al covente --json)]' \
            '--data-size[Misurâ la cartele dai dâts salvâts di ogni plugin instalât, o dome dal plugin indicât (al domande --json)]::plugin:_claude_installed_plugins' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Netâ tal ambit]:scope:(user project local)' \
            '--dry-run[Listâ ce che al vignarès gjavât cence gjavâ nuie]' \
            '(-y --yes)'{-y,--yes}'[Saltâ la domande di conferme]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]'
          ;;
        configure)
          _arguments \
            '--json[Jessude come JSON]' \
            '--values-stdin[Lei i valôrs des opzions di stdin come ogjet JSON di stringhis suntune rie; lis opzions lassadis fûr a tegnin i lôr valôrs]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Descrizion dal manifest]:text:' \
            '--author[Non dal autôr (predefinît: git config user.name)]:name:' \
            '--author-email[Email dal autôr (predefinît: git config user.email)]:email:' \
            '--with[Components di impostâ ancje]:components:' \
            '(-f --force)'{-f,--force}'[Sorescrivi un .claude-plugin/ esistent te destinazion]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '1:name:'
          ;;
        eval)
          if [[ $words[2] == init ]]; then
            _arguments \
              '--bare[Scrivi un model vueit invezit di eseguî la interviste]' \
              '--eval-dir[Cartele sot de cartele atuâl dulà scrivi i câs]:dir:_directories' \
              '(-i --interactive)'{-i,--interactive}'[Eseguî la interviste di creazion (al domande un terminâl interatîf)]' \
              '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
              '::name:'
            return
          fi
          _arguments \
            '--case[Filtrâ i câs par glob dal non]:glob:' \
            '*--tag[Filtrâ i câs par tag (ripetibil)]:tag:' \
            '--runs[Sostituî lis esecuzions par câs (predefinît: case.runs, se no 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Eseguî fin a n esecuzions di agjent in contemporani (1-8; predefinît 1)]:n:' \
            '--model[Sostituî il model par ducj i câs]:model:_claude_model_names' \
            '--judge-model[Sostituî il model dal valutadôr LLM (predefinît: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Limit massim di cost; interompi e riferî i risultâts parziâi se al ven tocjât (codiç di jessude 2)]:usd:' \
            '--output-dir[Diretori par aggregate-result.json]:dir:_directories' \
            '--eval-dir[Non dal diretori (sot dal plugin) che al ten i câs di eval]:dir:' \
            '--json[Stampâ il risultât complet de esecuzion come JSON su stdout, o scrivilu in chest file .json]::path:_files' \
            '--threshold[Jessî cul codiç di jessude 1 se il pontezi di cualsisei câs al è sot di cheste soglie (predefinît: 1.0)]:threshold:' \
            '*--allow-tools[Autorizazion dal operadôr pai struments protets (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '*--disallow-tools[Struments integrâts di tignî lontan di Claude in ducj i câs, ancje se concedûts]:tools:' \
            '(--no-scaffold)--scaffold[Eseguî il scaffold_script di ogni câs (al eseguìs bash furnît dal autôr a to non; disativât par predefinît)]' \
            '(--scaffold)--no-scaffold[Saltâ in mût esplicit scaffold_script]' \
            '--trust-plugin[Declarâ che tu ti fidis di chest plugin e de sô suite di eval, saltant la domande di fiducie de prime esecuzion (pe CI)]' \
            '--ablation[Eseguî un grup di control di riferiment cence plugin e riferî la diference di pontezi]:mode:(none with-without)' \
            '--mocks[Simulazions che a sostituissin i servidôrs MCP, di <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Cun --mocks record: inviâ ancje i procès dai servidôrs MCP reâi che no àn une simulazion]' \
            '--keep-temp[Conservâ i diretoriis di impostazion pal debug]' \
            '--verbose[Regjistrâ i events di traçament par messaç tal regjistri di debug]' \
            '--report[Scrivi il rapuart HTML autonom in chest percors invezit che tal diretori dai risultâts]:path:_files' \
            '(--no-publish)--publish-report[Domandâ ancje di publicâ il rapuart su claude.ai]' \
            '(--publish-report)--no-publish[Tignî il rapuart HTML dome in locâl; saltâ la publicazion su claude.ai]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '::target: _alternative "commands\:eval command\:(init)" "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Mandâ il tag a --remote dopo di vêlu creât]' \
            '--dry-run[Stampâ ce che al vignarès etichetât cence creâ il tag]' \
            '(-f --force)'{-f,--force}'[Saltâ lis verificazions di arbul di lavôr cun modifichis e di tag za esistent]' \
            '(-m --message)'{-m,--message}'[Messaç di anotazion dal tag (doprâ %s pe version)]:msg:' \
            '--remote[Remote li che mandâ cun --push]:name:' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Zontâ un marcjât di une URL, percors o repository GitHub'
    'list:Listâ i marcjâts configurâts'
    'remove:Gjavâ un marcjât configurât'
    'rm:Gjavâ un marcjât configurât (alias par remove)'
    'update:Inzornâ il marcjât de sorzint - inzornâ ducj se nissun non specificât'
    'help:Mostrâ jutori'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comants di marcjât' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Limitâ il checkout a diretoriis specifics midiant git sparse-checkout (pai monorepo)]:paths:' \
            '--scope[Dulà declarâ il marcjât]:scope:(user project local)' \
            '--json[Stampâ une rie di risultât leibile de machine come ultime rie su stdout]' \
            '--claudeai[Zontâ il marcjât cun chest non che claude.ai al ospite par te]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Jessude come JSON]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Gjavâ la declarazion dal marcjât di un ambit di impostazions specific (ometi par gjavâle di ducj i ambits)]:scope:(user project local)' \
            '--json[Stampâ une rie di risultât leibile de machine come ultime rie su stdout]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '--json[Cuntun non di marcjât: stampâ une rie di risultât leibile de machine come ultime rie su stdout]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Sfuarçâ la instalazion ancje se al è za instalât]' \
    '(-h --help)'{-h,--help}'[Mostrâ jutori]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Diretori adizionâl par permetê l'\''acès ai struments tes session inviadis]:directory:_directories' \
    '--agent[Agjent predefinît pes session inviadis de viodude agjents]:agent:_claude_agent_names' \
    '--all[Cun --json: includi ancje lis session in sotfont completadis]' \
    '--allow-dangerously-skip-permissions[Rindi disponibile la modalitât bypass-permissions pes session inviadis]' \
    '--cwd[Mostrâ dome lis session in sotfont inviadis sot il percors]:path:_directories' \
    '--dangerously-skip-permissions[Alias par --permission-mode bypassPermissions]' \
    '--effort[Nivel di sfuarç predefinît pes session inviadis]:level:(low medium high xhigh max)' \
    '--json[Stampâ lis session ativis come array JSON e jessî]' \
    '*--mcp-config[Configurazion dal servidôr MCP di aplicâ aes session inviadis]:config:' \
    '--model[Model predefinît pes session inviadis de viodude agjents]:model:_claude_model_names' \
    '--permission-mode[Modalitât di permès predefinide pes session inviadis]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Cjariâ i plugin dal diretori pe viodude agjents e lis session inviadis]:path:_directories' \
    '--setting-sources[Liste separade di virgulis di fonts di impostazions di cjariâ (user, project, local)]:sources:' \
    '--settings[File di impostazions o stringhe JSON di aplicâ]:file-or-json:_files' \
    '--strict-mcp-config[Doprâ dome i servidôrs MCP di --mcp-config tes session inviadis]' \
    '--restricted[Inviâ lis session inviadis in modalitât limitade]' \
    '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Jentrâ tal to account Anthropic'
    'logout:Jessî dal to account Anthropic'
    'status:Mostrâ il stât de autenticazion'
    'help:Mostrâ jutori'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comants auth' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Compilâ prime la direzion email te pagjine di acès]:email:' \
            '--sso[Sfuarçâ il flus di acès SSO]' \
            '(--claudeai)--console[Doprâ Anthropic Console (faturazion par ûs API) invezit dal abonament Claude]' \
            '(--console)--claudeai[Doprâ l'\''abonament Claude (predefinît)]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]'
          ;;
        status)
          _arguments \
            '(--text)--json[Jessude come JSON (predefinît)]' \
            '(--json)--text[Jessude come test leibil des personis]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Stampâ la configurazion efetive de modalitât automatiche come JSON'
    'critique:Otignî feedback de IA su lis tôs regulis personalizadis de modalitât automatiche'
    'defaults:Stampâ lis regulis predefinidis de modalitât automatiche come JSON'
    'reset:Ristabilî la configurazion de modalitât automatiche ai valôrs predefinîts di fabriche'
    'help:Mostrâ jutori'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comants auto-mode' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Sostituî il model doprât]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]'
          ;;
        defaults)
          _arguments \
            '--label[Mostrâ dome lis regulis che la lôr etichete e scomence cun chest prefìs (cence distinzion tra maiusculis e minusculis)]:prefix:' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Saltâ la domande di conferme]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Percors ae configurazion YAML dal gateway]:path:_files' \
    '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Eliminâ dut il stât di Claude Code par un progjet (trascrizions, ativitâts, storic dai file, vôs di configurazion)'
    'help:Mostrâ jutori'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comants project' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Listâ ce che al vignarès eliminât cence eliminâ nuie]' \
            '(-y --yes)'{-y,--yes}'[Saltâ la domande di conferme]' \
            '(-i --interactive)'{-i,--interactive}'[Domandâ par ogni element prime di eliminâ]' \
            '(1)--all[Eliminâ il stât di ogni progjet (esclusîf cun un percors)]' \
            '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_purge() {
  _arguments \
    '--dry-run[Listâ ce che al vignarès eliminât cence eliminâ nuie]' \
    '(-y --yes)'{-y,--yes}'[Saltâ la domande di conferme]' \
    '(-i --interactive)'{-i,--interactive}'[Domandâ par ogni element prime di eliminâ]' \
    '(1)--all[Eliminâ il stât di ogni progjet (esclusîf cun un percors)]' \
    '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]' \
    '(--all)::path:_directories'
}

_claude_ultrareview() {
  _arguments \
    '--json[Stampâ il payload grês bugs.json invezit dai risultâts formatâts]' \
    '--timeout[Minûts massims di spietâ che la revision e finissi (predefinît: 45)]:minutes:' \
    '(--no-post)--post[Publicâ i risultâts de revision finide te PR a to non (dome pes PR; un sempliç coment, no une revision)]' \
    '(--post)--no-post[No publicâ i risultâts te PR (il predefinît)]' \
    '--trust-workspace[Fidâsi de cartele atuâl dome par cheste esecuzion, cence domandâ (par scripts e CI)]' \
    '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Tornâ a inviâ dutis lis session in sotfont in esecuzion]' \
    '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Scartâ ancje i commit no mandâts e lis modifichis no confermadis dal worktree (passâ il commit@worktree-id indicât di un claude rm precedent)]:commit@worktree-id:' \
    '--force-remove-worktree[Eliminâ il diretori dal worktree ancje se il hook WorktreeRemove o git no son rivâts a gjavâlu (passâ il worktree-id indicât di un claude rm precedent)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]' \
    '1:session:_claude_background_sessions'
}

_claude_self_hosted_runner() {
  _arguments \
    '--api-url[URL di base de API (predefinît: https://api.anthropic.com)]:url:' \
    '--environment-secret-file[Percors al file segret dal ambient]:path:_files' \
    '--lock-to-account[Blocâ il runner suntun sôl account te regjistrazion]:id:' \
    '--client-label[Etichete di osservabilitât mandade te regjistrazion (predefinît: hostname)]:label:' \
    '(--proxy-authorization-file --agent-proxy-url)--proxy-authorization-command[Comant che il so stdout al è la intestazion Proxy-Authorization pai proxy in jessude]:shell command:' \
    '(--proxy-authorization-command --agent-proxy-url)--proxy-authorization-file[File che al conten la intestazion Proxy-Authorization pai proxy in jessude]:path:_files' \
    '(--proxy-authorization-command --proxy-authorization-file)--agent-proxy-url[Fâ passâ ogni session pal proxy di agjent a cheste URL (dome https)]:url:' \
    '--capacity[Massim di sessions simultaniis (predefinît: 1)]:n:' \
    '--base-dir[Cartele di base pai checkout dai repository (predefinît: /workspace)]:path:_directories' \
    '--exec-path[Binari di inviâ pes sessions fiis (predefinît: chest binari)]:path:_files' \
    '--hooks-dir[Cartele dai scripts dai hook dal cicli di vite (checkout, command, post-session)]:path:_directories' \
    '--session-stop-grace-sec[Trop spietâ une jessude nete dopo che une session e finìs (predefinît: 5)]:n:' \
    '--post-session-hook-timeout-sec[Limit di SIGTERM pal hook post-session (predefinît: 60)]:n:' \
    '--checkout-hook-timeout-min[Limit di timp reâl par ogni esecuzion dal hook checkout (predefinît: 30; 0 lu disative)]:n:' \
    '--drain-wait-sec[Cun SIGTERM/SIGINT, spietâ fin a N seconts il lavôr in cors (predefinît: 0)]:n:' \
    '--drain-marker-file[File marcadôr cul cuâl l’host al anuncie un svuedament ordenât]:path:_files' \
    '*--git-ssh-rewrite[Tornâ a scrivi lis URL di origjin https://<host>/... come git@<host>:... (ripetibil)]:host:' \
    '*--git-host-rewrite[Tornâ a scrivi lis URL di origjin https://<f>/... come https://<t>/... (ripetibil)]:from=to:' \
    '--use-anthropic-git-proxy[Doprâ git gjestît di Anthropic. AVÎS: al elimine e al sostituìs la configurazion git a nivel di HOME, doprâlu dome suntun account dedicât]' \
    '--configure-git[Stabilî la identitât git globâl e ativâ la firme dai commit midiant il servizi di firme di Anthropic. Al scrîf ~/.gitconfig]' \
    '--push-outcome-on-release[Fâ push dai rams di risultât tignûts di voli cuant che il runner al fâs finî une session no completade]' \
    '--trust-workspace[Inizializâ la fiducie persistente pai percors dai repository di ogni session (predefinît: true)]::bool:(true false)' \
    '--remove-session-state[Gjavâ il stât di ogni session cuant che une session e finìs (predefinît: false)]::bool:(true false)' \
    '--diff-finds-nested-repository[Mostrâ tal panel Changes un repository clonât intune sot-cartele; al domande --capacity 1 (predefinît: false)]::bool:(true false)' \
    '--confine-repo-settings[Modalitât de protezion che e confine lis impostazions comitadis tal repository (predefinît: warn)]:mode:(warn enforce off)' \
    '--server-auto-mode-lists[Ce listis dal classificadôr de modalitât automatiche che une session e pues ricevi dal servidôr (predefinît: no-allow)]:mode:(all no-allow none)' \
    '--host-config-snapshot[Dulà che e ven tignude la istantanie di inviament de configurazion dal host (predefinît: disk)]:mode:(disk memory)' \
    '--health-port[Puarte dal scoltadôr HTTP /healthz (predefinît: 8080; 0 lu disative)]:port:' \
    '--log-level[Nivel di regjistri (predefinît: info)]:level:(info debug)' \
    '--log-file[Copiâ ancje i regjistris dal runner intun file in modalitât di zonte]:path:_files' \
    '--exit-if-unused-min[Jessî dal runner se no i ven mai assegnât lavôr par N minûts]:n:' \
    '--drain-grace-sec[Seconts di continuâ a domandâ lavôr dopo che lis sessions ativis a finissin (predefinît: 0)]:n:' \
    '--retire-at[Ritirâ il runner a chest timp Unix assolût, in seconts]:epoch-seconds:' \
    '--defer-shutdown-max-min[Al prin SIGTERM/SIGINT, smeti di cjoli lavôr e finî di distudâsi M minûts plui tart (predefinît: 0)]:m:' \
    '--release-idle-session-min[Liberâ un puest di session dopo N minûts cence input dal utent]:n:' \
    '--startup-timeout-min[Liberâ un puest di session se il procès fi nol à finît di inviâsi dopo N minûts (predefinît: 15; 0 lu disative)]:n:' \
    '--kill-session-after-min[Limitâ la vite in timp reâl di un procès fi di session a N minûts]:n:' \
    '--debug-token-dir[DOME PAL DEBUG: al scrîf tokens vîfs sul disc. No doprâ in produzion]:path:_directories' \
    '(-h --help)'{-h,--help}'[Mostrâ chest messaç di jutori]'
}

_claude_remote_control() {
  _arguments \
    '--name[Non pe session (mostrât in claude.ai/code)]:name:' \
    '--remote-control-session-name-prefix[Prefìs pai nons di session gjenerâts in automatic (predefinît: hostname)]:prefix:' \
    '(-c --continue --session-id)'{-c,--continue}'[Tornâ a tacâsi ae ultime session regjistrade par cheste cartele o un dai siei worktree git]' \
    '(-c --continue --session-id)--session-id[Tornâ a tacâsi a une session specifiche par ID]:id:' \
    '--permission-mode[Modalitât di permès pes sessions inviadis]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)' \
    '(--no-chrome)--chrome[Ativâ Claude in Chrome pes sessions inviadis]' \
    '(--chrome)--no-chrome[Disativâ Claude in Chrome pes sessions inviadis]' \
    '(-d --debug)'{-d,--debug}'[Ativâ la modalitât di debug cun filtrament opzionâl par categorie]::filter:' \
    '--debug-file[Scrivi i regjistris di debug intun file]:path:_files' \
    '(-v --verbose)'{-v,--verbose}'[Ativâ la jessude detaiade]' \
    '--spawn[Modalitât di inviament (predefinît: same-dir)]:mode:(same-dir worktree session)' \
    '--capacity[Massim di sessions simultaniis in modalitât worktree o same-dir (predefinît: 32)]:n:' \
    '(--no-create-session-in-dir)--create-session-in-dir[Creâ in anticip une session te cartele atuâl (predefinît)]' \
    '(--create-session-in-dir)--no-create-session-in-dir[No creâ in anticip une session te cartele atuâl]' \
    '(-h --help)'{-h,--help}'[Mostrâ chest jutori]'
}

_claude_daemon() {
  local -a daemon_commands common_options
  daemon_commands=(
    'run:Eseguî il supervisôr in prin plan'
    'status:Mostrâ pid, version e timp di ativitât dal daemon'
    'logs:Seguî il regjistri dal daemon (Ctrl-C par fermâ)'
    'uninstall:Gjavâ il servizi in sotfont (launchctl/systemd)'
    'stop:Distudâ il supervisôr e terminâ lis sessions in sotfont'
  )
  common_options=(
    '--json-path[File di configurazion (predefinît: ~/.claude/daemon.json)]:path:_files'
    '--log-file[File di regjistri (predefinît: ~/.claude/daemon.log)]:path:_files'
    '(-h --help)'{-h,--help}'[Mostrâ chest jutori]'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    $common_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comants daemon' daemon_commands
      ;;
    args)
      case $words[1] in
        run)
          _arguments \
            $common_options \
            '::json-path:_files'
          ;;
        stop)
          _arguments \
            $common_options \
            '--any[Fermâ ancje un daemon transitori (no servizi)]' \
            '--keep-workers[Lassâ in esecuzion lis sessions distacadis]'
          ;;
        status|logs|uninstall)
          _arguments \
            $common_options
          ;;
      esac
      ;;
  esac
}

_claude_import() {
  _arguments \
    '--dry-run[Mostrâ ce che al vignarès impuartât cence scrivi nuie]' \
    '--yes[Saltâ il seletôr interatîf (su lis superficiis cence interface grafiche, passâ --yes=<digest> de anteprime di /import)]' \
    '(-h --help)'{-h,--help}'[Mostrâ jutori pal comant]' \
    '::source:(codex gemini cursor)'
}

# compinit autoloads this file, and that first call only defines the functions
# above: complete right away so the first TAB already works. Sourced directly,
# there is nothing to complete yet, only the registration.
if [[ $funcstack[1] == _claude ]]; then
  _claude "$@"
else
  (( $+_comps[claude] )) || compdef _claude claude
fi
