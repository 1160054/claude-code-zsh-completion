#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:پیکربندی و مدیریت سرورهای MCP'
    'plugin:مدیریت افزونه‌های Claude Code'
    'agents:مدیریت عامل‌های پس‌زمینه'
    'attach:باز کردن یک نشست پس‌زمینه در این ترمینال'
    'logs:چاپ خروجی اخیر ترمینال یک نشست پس‌زمینه'
    'stop:متوقف کردن یک نشست پس‌زمینه (گفتگوی آن حفظ می‌شود)'
    'respawn:راه‌اندازی مجدد یک نشست پس‌زمینه تا با نسخه فعلی Claude Code اجرا شود'
    'rm:حذف یک نشست پس‌زمینه، و درخت‌کار آن در صورتی که این کار ایمن باشد'
    'auth:مدیریت احراز هویت'
    'auto-mode:بررسی یا بازنشانی پیکربندی طبقه‌بند حالت خودکار'
    'gateway:اجرای دروازه احراز هویت/تله‌متری سازمانی'
    'import:وارد کردن پیکربندی از یک عامل کدنویسی هوش مصنوعی دیگر به Claude Code'
    'project:مدیریت وضعیت پروژه Claude Code'
    'ultrareview:اجرای بازبینی کد چندعاملی میزبانی‌شده در ابر و چاپ یافته‌ها'
    'setup-token:راه‌اندازی توکن احراز هویت بلندمدت (نیاز به اشتراک Claude)'
    'doctor:بررسی سلامت برای به‌روزرسان خودکار Claude Code'
    'update:بررسی و نصب به‌روزرسانی‌ها'
    'install:نصب ساخت بومی Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[فعال‌سازی حالت اشکال‌زدایی با فیلتر دسته‌بندی اختیاری (مثلاً "api,hooks" یا "!statsig,!file")]:filter:'
    '--verbose[نادیده گرفتن تنظیم حالت پرجزئیات از فایل پیکربندی]'
    '(-p --print)'{-p,--print}'[چاپ پاسخ و خروج (برای استفاده با لوله‌ها). توجه: فقط در دایرکتوری‌های قابل اعتماد استفاده کنید]'
    '--output-format[فرمت خروجی (با --print): "text" (پیش‌فرض)، "json" (نتیجه واحد)، یا "stream-json" (جریان لحظه‌ای)]:format:(text json stream-json)'
    '--json-schema[طرحواره JSON برای اعتبارسنجی خروجی ساختاریافته]:schema:'
    '--include-partial-messages[شامل قطعات پیام جزئی به محض ورود (با --print و --output-format=stream-json)]'
    '--input-format[فرمت ورودی (با --print): "text" (پیش‌فرض) یا "stream-json" (ورودی جریانی لحظه‌ای)]:format:(text stream-json)'
    '--mcp-debug[\[منسوخ شده. به‌جای آن از --debug استفاده کنید\] فعال‌سازی حالت اشکال‌زدایی MCP (نمایش خطاهای سرور MCP)]'
    '--dangerously-skip-permissions[دور زدن تمام بررسی‌های مجوز. فقط برای محیط‌های ایزوله بدون دسترسی اینترنت توصیه می‌شود]'
    '--allow-dangerously-skip-permissions[فعال‌سازی گزینه دور زدن بررسی مجوز بدون فعال‌سازی پیش‌فرض]'
    '--restricted[حالت محدود: حذف ابزارهایی که دستور یا کد اجرا می‌کنند و WebFetch، نادیده گرفتن تنظیمات user/project/local، و محدود کردن ابزارهای فایل به دایرکتوری‌های کاری]'
    '--max-budget-usd[حداکثر مبلغ دلاری برای صرف در فراخوانی‌های API (فقط --print)]:amount:'
    '--replay-user-messages[ارسال مجدد پیام‌های کاربر از stdin به stdout برای تأیید]'
    '--allowed-tools[لیست جداشده با کاما یا فاصله از نام ابزارهای مجاز (مثلاً "Bash(git:*) Edit")]:tools:'
    '--allowedTools[لیست جداشده با کاما یا فاصله از نام ابزارهای مجاز (فرمت camelCase)]:tools:'
    '--tools[مشخص کردن لیست ابزارهای موجود از مجموعه داخلی. فقط حالت چاپ]:tools:'
    '--disallowed-tools[لیست جداشده با کاما یا فاصله از نام ابزارهای غیرمجاز (مثلاً "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[لیست جداشده با کاما یا فاصله از نام ابزارهای غیرمجاز (فرمت camelCase)]:tools:'
    '--mcp-config[بارگذاری سرورهای MCP از فایل یا رشته JSON (جداشده با فاصله)]:configs:'
    '--system-prompt[پرامپت سیستم برای استفاده در نشست]:prompt:'
    '--system-prompt-file[خواندن پرامپت سیستم از یک فایل]:file:_files'
    '--append-system-prompt[افزودن پرامپت سیستم به پرامپت سیستم پیش‌فرض]:prompt:'
    '--append-system-prompt-file[خواندن پرامپت سیستم از یک فایل و افزودن آن به پرامپت سیستم پیش‌فرض]:file:_files'
    '--system-prompt-snapshot[ثبت پرامپت سیستم یک بار در هر گفتگو و استفاده مجدد عیناً از آن در هر درخواست و از سرگیری (on، پیش‌فرض) یا ساخت دوباره آن در هر درخواست (off)]:mode:(on off)'
    '--permission-mode[حالت مجوز برای استفاده در نشست]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[پاسخ‌دهنده به درخواست‌های مجوز با --print: "host" (میزبان SDK یا --permission-prompt-tool) یا "none" (هر چیزی که نیاز به درخواست مجوز داشته باشد رد می‌شود)]:target:(host none)'
    '--permission-prompt-tool[ابزار MCP برای استفاده در درخواست‌های مجوز (فقط --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[ادامه آخرین گفتگو]'
    '(-r --resume)'{-r,--resume}'[از سرگیری گفتگو - شناسه نشست را مشخص کنید یا به صورت تعاملی انتخاب کنید]:sessionId:_claude_sessions'
    '--fork-session[ایجاد شناسه نشست جدید به جای استفاده مجدد از شناسه نشست اصلی هنگام از سرگیری (با --resume یا --continue)]'
    '--no-session-persistence[غیرفعال‌سازی ماندگاری نشست - نشست‌ها ذخیره نخواهند شد (فقط --print)]'
    '--model[مدل برای نشست فعلی. نام مستعار را برای جدیدترین مدل مشخص کنید (مثلاً '\''sonnet'\'' یا '\''opus'\'')]:model:_claude_model_names'
    '--agent[عامل برای نشست فعلی. تنظیم '\''agent'\'' را نادیده می‌گیرد]:agent:_claude_agent_names'
    '--betas[هدرهای بتا برای گنجاندن در درخواست‌های API (فقط کاربران کلید API)]:betas:'
    '--fallback-model[فعال‌سازی بازگشت خودکار به مدل مشخص شده زمانی که مدل پیش‌فرض مشغول است (فقط --print)]:model:_claude_model_names'
    '--settings[مسیر فایل JSON تنظیمات یا رشته JSON برای بارگذاری تنظیمات اضافی]:file-or-json:_files'
    '--add-dir[دایرکتوری‌های اضافی برای مجوز دسترسی ابزار]:directories:_directories'
    '--ide[اتصال خودکار به IDE در شروع اگر دقیقاً یک IDE معتبر موجود باشد]'
    '--desktop[باز کردن در برنامه Claude Desktop به جای ترمینال (با --continue یا --resume <id> برای انتخاب نشست)]'
    '--strict-mcp-config[استفاده فقط از سرورهای MCP از --mcp-config و نادیده گرفتن تمام تنظیمات MCP دیگر]'
    '--session-id[شناسه نشست خاص برای استفاده در گفتگو (باید UUID معتبر باشد)]:uuid:'
    '--agents[شیء JSON تعریف‌کننده عوامل سفارشی]:json:'
    '--setting-sources[لیست جداشده با کاما از منابع تنظیمات برای بارگذاری (user, project, local)]:sources:'
    '--plugin-dir[دایرکتوری برای بارگذاری افزونه‌ها فقط برای این نشست (قابل تکرار)]:paths:_directories'
    '--disable-slash-commands[غیرفعال‌سازی تمام دستورات اسلش]'
    '(--bg --background)'{--bg,--background}'[شروع نشست به عنوان عامل پس‌زمینه و بازگشت فوری]'
    '(-w --worktree)'{-w,--worktree}'[ایجاد درخت‌کار git جدید برای این نشست (به صورت اختیاری یک نام مشخص کنید)]::name:'
    '--tmux=-[ایجاد نشست tmux برای درخت‌کار (نیاز به --worktree). در صورت امکان از پنل‌های بومی iTerm2 استفاده می‌کند؛ --tmux=classic برای tmux سنتی]::mode:(classic)'
    '(-n --name)'{-n,--name}'[تعیین نام نمایشی برای این نشست]:name:'
    '--effort[سطح تلاش برای نشست فعلی]:level:(low medium high xhigh max)'
    '--autocompact[اندازه پنجره فشرده‌سازی خودکار (auto، یا 100k تا 1M توکن)]:size:(auto)'
    '--debug-file[نوشتن گزارش‌های اشکال‌زدایی در مسیر فایل مشخص (به طور ضمنی حالت اشکال‌زدایی را فعال می‌کند)]:path:_files'
    '--from-pr[از سرگیری نشست مرتبط با یک PR بر اساس شماره/URL، یا باز کردن انتخابگر تعاملی]::value:'
    '--teleport[از سرگیری یک نشست teleport، به صورت اختیاری شناسه نشست را مشخص کنید]::session:'
    '--cloud[ایجاد یک نشست ابری با توضیح داده‌شده، یا اتصال به یک نشست موجود با شناسه نشست یا URL claude.ai/code]::description-or-session:'
    '--environment[ایجاد یک نشست ابری جدید که روی محیط خودمیزبان داده‌شده اجرا می‌شود (ccpool_...)]:environment_id:'
    '--remote-control[شروع نشست تعاملی با کنترل از راه دور فعال (به صورت اختیاری نام‌گذاری شده)]::name:'
    '--remote-control-session-name-prefix[پیشوند برای نام‌های نشست کنترل از راه دور تولیدشده خودکار]:prefix:'
    '--chrome[فعال‌سازی یکپارچه‌سازی Claude در Chrome]'
    '--no-chrome[غیرفعال‌سازی یکپارچه‌سازی Claude در Chrome]'
    '--plugin-url[دریافت فایل .zip افزونه از یک URL فقط برای این نشست (قابل تکرار)]:url:'
    '--file[منابع فایل برای دانلود در شروع (فرمت: file_id:relative_path)]:specs:'
    '--prompt-suggestions[فعال‌سازی پیشنهادهای پرامپت (یک پرامپت بعدی پیش‌بینی‌شده را در حالت print/SDK منتشر می‌کند)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[ارسال متن زیرعامل و بلوک‌های تفکر به عنوان پیام (با --print و stream-json)]'
    '--include-hook-events[گنجاندن تمام رویدادهای چرخه حیات هوک در جریان خروجی (با stream-json)]'
    '--exclude-dynamic-system-prompt-sections[انتقال بخش‌های مخصوص هر ماشین به اولین پیام کاربر برای بهبود استفاده مجدد از حافظه نهان پرامپت]'
    '--brief[فعال‌سازی ابزار SendUserMessage برای ارتباط عامل به کاربر]'
    '--safe-mode[شروع با غیرفعال بودن تمام سفارشی‌سازی‌ها (برای عیب‌یابی پیکربندی خراب مفید است)]'
    '--bare[حالت حداقلی: رد کردن هوک‌ها، LSP، همگام‌سازی افزونه، انتساب، حافظه خودکار، و کشف خودکار CLAUDE.md]'
    '--ax-screen-reader[ارائه خروجی سازگار با صفحه‌خوان (متن ساده، بدون حاشیه‌های تزئینی یا انیمیشن)]'
    '(-v --version)'{-v,--version}'[نمایش شماره نسخه]'
    '(-h --help)'{-h,--help}'[نمایش راهنما برای دستور]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude commands' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[نمایش راهنما برای دستور]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "no arguments"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:راه‌اندازی سرور MCP برای Claude Code'
    'add:افزودن سرور MCP به Claude Code'
    'remove:حذف سرور MCP'
    'list:نمایش لیست سرورهای MCP پیکربندی شده'
    'get:دریافت جزئیات سرور MCP'
    'add-json:افزودن سرور MCP (stdio یا SSE) با رشته JSON'
    'add-from-claude-desktop:وارد کردن سرورهای MCP از Claude Desktop (فقط Mac و WSL)'
    'reset-project-choices:بازنشانی تمام سرورهای تأیید/رد شده در محدوده پروژه (.mcp.json) در این پروژه'
    'login:احراز هویت با یک سرور MCP (HTTP، SSE، یا کانکتور claude.ai)'
    'logout:پاک کردن اعتبارنامه‌های OAuth ذخیره‌شده برای یک سرور MCP'
    'help:نمایش راهنما'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[نمایش راهنما]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp commands' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[فعال‌سازی حالت اشکال‌زدایی]' \
            '--verbose[نادیده گرفتن تنظیم حالت پرجزئیات از فایل پیکربندی]' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[محدوده پیکربندی (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[نوع انتقال (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[تنظیم متغیر محیطی (مثلاً -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[تنظیم هدر WebSocket]:header:' \
            '--client-id[شناسه کلاینت OAuth برای سرورهای HTTP/SSE]:clientId:' \
            '--client-secret[درخواست ورود رمز کلاینت OAuth (یا تنظیم متغیر محیطی MCP_CLIENT_SECRET)]' \
            '--callback-port[پورت ثابت برای callback OAuth (برای سرورهایی که به URIهای تغییر مسیر از پیش ثبت‌شده نیاز دارند)]:port:' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[محدوده پیکربندی (local, user, project) - در صورت عدم تعیین از محدوده موجود حذف شود]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[نمایش راهنما]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[محدوده پیکربندی (local, user, project)]:scope:(local user project)' \
            '--client-secret[درخواست ورود رمز کلاینت OAuth (یا تنظیم متغیر محیطی MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[محدوده پیکربندی (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[نمایش راهنما]'
          ;;
        login)
          _arguments \
            '--no-browser[چاپ URL مجوزدهی به جای باز کردن مرورگر (برای نشست‌های SSH/بدون رابط گرافیکی)]' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:اعتبارسنجی افزونه یا مانیفست بازار'
    'marketplace:مدیریت بازارهای Claude Code'
    'list:نمایش لیست افزونه‌های نصب‌شده'
    'details:نمایش فهرست اجزا و هزینه توکن پیش‌بینی‌شده برای یک افزونه'
    'configure:نمایش گزینه‌های یک افزونه و اینکه کدام‌ها تنظیم نشده‌اند، یا ذخیره مقادیر از stdin'
    'install:نصب افزونه از بازارهای موجود'
    'i:نصب افزونه از بازارهای موجود (میانبر install)'
    'init:ساخت داربست افزونه جدید (در نشست بعدی خودکار بارگذاری می‌شود)'
    'new:ساخت داربست افزونه جدید (نام مستعار init)'
    'uninstall:حذف نصب افزونه نصب شده'
    'remove:حذف نصب افزونه نصب شده (نام مستعار uninstall)'
    'enable:فعال‌سازی افزونه غیرفعال'
    'disable:غیرفعال‌سازی افزونه فعال'
    'update:به‌روزرسانی افزونه به آخرین نسخه'
    'eval:اجرای موارد ارزیابی روی یک افزونه و گزارش نتایج امتیازدهی‌شده'
    'prune:حذف وابستگی‌های نصب‌شده خودکار که دیگر مورد نیاز نیستند'
    'autoremove:حذف وابستگی‌های نصب‌شده خودکار که دیگر مورد نیاز نیستند (نام مستعار prune)'
    'tag:ایجاد برچسب git با فرمت {name}--v{version} برای انتشار افزونه'
    'test:اجرای تست‌های یک mod'
    'help:نمایش راهنما'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[نمایش راهنما]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin commands' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[در نظر گرفتن هشدارها به عنوان خطا (کد خروج 1)]' \
            '--json[خروجی گزارش اعتبارسنجی به صورت JSON (با همان کدهای خروج)]' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[محدوده نصب]:scope:(user project local)' \
            '*--config[تنظیم یک گزینه userConfig تعریف‌شده در مانیفست افزونه (قابل تکرار)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[پذیرش دستور نمایش‌داده‌شده که بازار تعریف کرده است، بدون درخواست تأیید]' \
            '--json[چاپ یک خط نتیجه قابل خواندن توسط ماشین به جای پیام برای انسان]' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[محدوده نصب]:scope:(user project local)' \
            '--keep-data[حفظ دایرکتوری داده‌های ماندگار افزونه]' \
            '--prune[همچنین حذف وابستگی‌های نصب‌شده خودکار که دیگر مورد نیاز نیستند]' \
            '(-y --yes)'{-y,--yes}'[رد کردن درخواست تأیید --prune]' \
            '--json[چاپ یک خط نتیجه قابل خواندن توسط ماشین به جای پیام برای انسان (نه با --prune)]' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[محدوده نصب]:scope:(user project local)' \
            '--json[چاپ یک خط نتیجه قابل خواندن توسط ماشین به جای پیام برای انسان]' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[غیرفعال‌سازی تمام افزونه‌های فعال]' \
            '(-s --scope)'{-s,--scope}'[محدوده نصب]:scope:(user project local)' \
            '--json[چاپ یک خط نتیجه قابل خواندن توسط ماشین به جای پیام برای انسان]' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[محدوده نصب]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[پذیرش دستور نمایش‌داده‌شده که بازار تعریف کرده است، بدون درخواست تأیید]' \
            '--json[چاپ یک خط نتیجه قابل خواندن توسط ماشین به جای پیام برای انسان]' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[خروجی به صورت JSON]' \
            '--available[شامل کردن افزونه‌های موجود از بازارها (نیاز به --json)]' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[پاک‌سازی در محدوده]:scope:(user project local)' \
            '--dry-run[فهرست کردن مواردی که حذف می‌شوند بدون حذف آن‌ها]' \
            '(-y --yes)'{-y,--yes}'[رد کردن درخواست تأیید]' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]'
          ;;
        configure)
          _arguments \
            '--json[خروجی به صورت JSON]' \
            '--values-stdin[خواندن مقادیر گزینه‌ها از stdin به صورت یک شیء JSON از رشته‌های تک‌خطی؛ گزینه‌هایی که ذکر نشوند مقادیر خود را حفظ می‌کنند]' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[توضیح مانیفست]:text:' \
            '--author[نام نویسنده (پیش‌فرض: git config user.name)]:name:' \
            '--author-email[ایمیل نویسنده (پیش‌فرض: git config user.email)]:email:' \
            '--with[اجزایی که داربست آن‌ها نیز ساخته شود]:components:' \
            '(-f --force)'{-f,--force}'[بازنویسی .claude-plugin/ موجود در مقصد]' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[فیلتر کردن موارد بر اساس الگوی glob نام]:glob:' \
            '*--tag[فیلتر کردن موارد بر اساس برچسب (قابل تکرار)]:tag:' \
            '--runs[جایگزینی تعداد اجراها برای هر مورد (پیش‌فرض: case.runs، در غیر این صورت 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[اجرای حداکثر n اجرای عامل به طور همزمان (1 تا 8؛ پیش‌فرض 1)]:n:' \
            '--model[جایگزینی مدل برای تمام موارد]:model:_claude_model_names' \
            '--judge-model[جایگزینی مدل ارزیاب LLM (پیش‌فرض: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[سقف قطعی هزینه؛ در صورت رسیدن به آن، توقف و گزارش نتایج جزئی (کد خروج 2)]:usd:' \
            '--output-dir[دایرکتوری برای aggregate-result.json]:dir:_directories' \
            '--eval-dir[نام دایرکتوری (زیر افزونه) که موارد ارزیابی را در خود دارد]:dir:' \
            '--json[چاپ نتیجه کامل اجرا به صورت JSON در stdout، یا نوشتن آن در این فایل .json]::path:_files' \
            '--threshold[خروج با کد خروج 1 اگر امتیاز هر موردی کمتر از این آستانه باشد (پیش‌فرض: 1.0)]:threshold:' \
            '*--allow-tools[مجوز اپراتور برای ابزارهای محافظت‌شده (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[اجرای scaffold_script هر مورد (bash ارائه‌شده توسط نویسنده را با حساب کاربری شما اجرا می‌کند؛ به طور پیش‌فرض خاموش)]' \
            '(--scaffold)--no-scaffold[رد کردن صریح scaffold_script]' \
            '--trust-plugin[تأیید اینکه به این افزونه و مجموعه ارزیابی آن اعتماد دارید، و رد کردن درخواست اعتماد اجرای اول (برای CI)]' \
            '--ablation[اجرای یک گروه مقایسه پایه بدون افزونه و گزارش اختلاف امتیاز]:mode:(none with-without)' \
            '--mocks[جایگزین‌های ساختگی (mock) برای سرورهای MCP، از <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[با --mocks record: همچنین راه‌اندازی فرایندهای واقعی سرور MCP که mock ندارند]' \
            '--keep-temp[حفظ دایرکتوری‌های داربست برای اشکال‌زدایی]' \
            '--verbose[ثبت رویدادهای ردیابی هر پیام در گزارش اشکال‌زدایی]' \
            '--report[نوشتن گزارش HTML خودکفا در این مسیر به جای دایرکتوری نتایج]:path:_files' \
            '(--no-publish)--publish-report[همچنین الزام به انتشار گزارش در claude.ai]' \
            '(--publish-report)--no-publish[نگه داشتن گزارش HTML فقط به صورت محلی؛ رد کردن انتشار آن در claude.ai]' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[push کردن برچسب به --remote پس از ایجاد آن]' \
            '--dry-run[چاپ آنچه برچسب‌گذاری می‌شود بدون ایجاد آن]' \
            '(-f --force)'{-f,--force}'[رد کردن بررسی‌های درخت کاری دارای تغییرات و وجود قبلی برچسب]' \
            '(-m --message)'{-m,--message}'[پیام توضیح برچسب (از %s برای نسخه استفاده کنید)]:msg:' \
            '--remote[remote مقصد برای push با --push]:name:' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:افزودن بازار از URL، مسیر، یا مخزن GitHub'
    'list:نمایش لیست بازارهای پیکربندی شده'
    'remove:حذف بازار پیکربندی شده'
    'rm:حذف بازار پیکربندی شده (نام مستعار remove)'
    'update:به‌روزرسانی بازار از منبع - به‌روزرسانی همه در صورت عدم تعیین نام'
    'help:نمایش راهنما'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[نمایش راهنما]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace commands' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[محدود کردن checkout به دایرکتوری‌های خاص از طریق git sparse-checkout (برای monorepoها)]:paths:' \
            '--scope[محل تعریف بازار]:scope:(user project local)' \
            '--claudeai[افزودن بازاری با این نام که claude.ai برای شما میزبانی می‌کند]' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[خروجی به صورت JSON]' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]'
          ;;
        remove|rm)
          _arguments \
            '--scope[حذف تعریف بازار از یک محدوده تنظیمات مشخص (در صورت عدم تعیین، از همه محدوده‌ها حذف می‌شود)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[نمایش راهنما]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[اجبار به نصب حتی اگر قبلاً نصب شده باشد]' \
    '(-h --help)'{-h,--help}'[نمایش راهنما]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[دایرکتوری اضافی برای مجوز دسترسی ابزار در نشست‌های ارسال‌شده]:directory:_directories' \
    '--agent[عامل پیش‌فرض برای نشست‌های ارسال‌شده از نمای عامل]:agent:_claude_agent_names' \
    '--all[با --json: همچنین نشست‌های پس‌زمینه تکمیل‌شده را نیز شامل شود]' \
    '--allow-dangerously-skip-permissions[در دسترس قرار دادن حالت دور زدن مجوزها برای نشست‌های ارسال‌شده]' \
    '--cwd[فقط نشست‌های پس‌زمینه شروع‌شده در مسیر را نمایش بده]:path:_directories' \
    '--dangerously-skip-permissions[نام مستعار برای --permission-mode bypassPermissions]' \
    '--effort[سطح تلاش پیش‌فرض برای نشست‌های ارسال‌شده]:level:(low medium high xhigh max)' \
    '--json[چاپ نشست‌های فعال به صورت آرایه JSON و خروج]' \
    '*--mcp-config[پیکربندی سرور MCP برای اعمال بر نشست‌های ارسال‌شده]:config:' \
    '--model[مدل پیش‌فرض برای نشست‌های ارسال‌شده از نمای عامل]:model:_claude_model_names' \
    '--permission-mode[حالت مجوز پیش‌فرض برای نشست‌های ارسال‌شده]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[بارگذاری افزونه‌ها از دایرکتوری برای نمای عامل و نشست‌های ارسال‌شده]:path:_directories' \
    '--setting-sources[لیست جداشده با کاما از منابع تنظیمات برای بارگذاری (user, project, local)]:sources:' \
    '--settings[فایل تنظیمات یا رشته JSON برای اعمال]:file-or-json:_files' \
    '--strict-mcp-config[فقط از سرورهای MCP از --mcp-config در نشست‌های ارسال‌شده استفاده کن]' \
    '--restricted[شروع نشست‌های ارسال‌شده در حالت محدود]' \
    '(-h --help)'{-h,--help}'[نمایش راهنما برای دستور]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:ورود به حساب Anthropic شما'
    'logout:خروج از حساب Anthropic شما'
    'status:نمایش وضعیت احراز هویت'
    'help:نمایش راهنما'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[نمایش راهنما برای دستور]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth commands' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[پر کردن پیشاپیش آدرس ایمیل در صفحه ورود]:email:' \
            '--sso[اجبار به روند ورود SSO]' \
            '(--claudeai)--console[استفاده از Anthropic Console (صورتحساب بر اساس مصرف API) به جای اشتراک Claude]' \
            '(--console)--claudeai[استفاده از اشتراک Claude (پیش‌فرض)]' \
            '(-h --help)'{-h,--help}'[نمایش راهنما برای دستور]'
          ;;
        status)
          _arguments \
            '(--text)--json[خروجی به صورت JSON (پیش‌فرض)]' \
            '(--json)--text[خروجی به صورت متن قابل خواندن برای انسان]' \
            '(-h --help)'{-h,--help}'[نمایش راهنما برای دستور]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[نمایش راهنما برای دستور]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:چاپ پیکربندی مؤثر حالت خودکار به صورت JSON'
    'critique:دریافت بازخورد هوش مصنوعی درباره قوانین سفارشی حالت خودکار شما'
    'defaults:چاپ قوانین پیش‌فرض حالت خودکار به صورت JSON'
    'reset:بازنشانی پیکربندی حالت خودکار به پیش‌فرض‌های ارائه‌شده'
    'help:نمایش راهنما'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[نمایش راهنما برای دستور]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode commands' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[جایگزینی مدل مورد استفاده]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[نمایش راهنما برای دستور]'
          ;;
        defaults)
          _arguments \
            '--label[نمایش فقط قوانینی که برچسب آن‌ها با این پیشوند شروع می‌شود (بدون حساسیت به حروف کوچک و بزرگ)]:prefix:' \
            '(-h --help)'{-h,--help}'[نمایش راهنما برای دستور]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[رد کردن درخواست تأیید]' \
            '(-h --help)'{-h,--help}'[نمایش راهنما برای دستور]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[نمایش راهنما برای دستور]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[مسیر فایل پیکربندی YAML دروازه]:path:_files' \
    '(-h --help)'{-h,--help}'[نمایش راهنما برای دستور]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:حذف تمام وضعیت Claude Code برای یک پروژه (رونوشت‌ها، وظایف، تاریخچه فایل، ورودی پیکربندی)'
    'help:نمایش راهنما'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[نمایش راهنما برای دستور]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project commands' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[فهرست کردن مواردی که حذف می‌شوند بدون حذف هیچ چیز]' \
            '(-y --yes)'{-y,--yes}'[رد کردن درخواست تأیید]' \
            '(-i --interactive)'{-i,--interactive}'[درخواست تأیید برای هر مورد پیش از حذف]' \
            '(1)--all[حذف وضعیت برای همه پروژه‌ها (با مشخص کردن مسیر ناسازگار است)]' \
            '(-h --help)'{-h,--help}'[نمایش راهنما برای دستور]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[چاپ داده خام bugs.json به جای یافته‌های قالب‌بندی‌شده]' \
    '--timeout[حداکثر زمان انتظار برای پایان بازبینی، به دقیقه (پیش‌فرض: 45)]:minutes:' \
    '(--no-post)--post[ارسال یافته‌های بازبینی تکمیل‌شده به PR با حساب کاربری شما (فقط وقتی هدف بازبینی یک PR است؛ یک کامنت ساده، نه یک بازبینی)]' \
    '(--post)--no-post[عدم ارسال یافته‌ها به PR (پیش‌فرض)]' \
    '(-h --help)'{-h,--help}'[نمایش راهنما برای دستور]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[راه‌اندازی مجدد تمام نشست‌های پس‌زمینه در حال اجرا]' \
    '(-h --help)'{-h,--help}'[نمایش راهنما برای دستور]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[همچنین دور ریختن کامیت‌های push نشده و تغییرات کامیت نشده درخت‌کار (commit@worktree-id گزارش‌شده توسط claude rm قبلی را بدهید)]:commit@worktree-id:' \
    '--force-remove-worktree[حذف دایرکتوری درخت‌کار حتی اگر هوک WorktreeRemove یا git نتوانسته باشد آن را حذف کند (worktree-id گزارش‌شده توسط claude rm قبلی را بدهید)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[نمایش راهنما برای دستور]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[نمایش آنچه وارد می‌شود بدون نوشتن هیچ چیز]' \
    '--yes[رد کردن انتخابگر تعاملی (در محیط‌های بدون رابط گرافیکی، --yes=<digest> را از پیش‌نمایش /import بدهید)]' \
    '(-h --help)'{-h,--help}'[نمایش راهنما برای دستور]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
