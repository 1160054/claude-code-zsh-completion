#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:הגדר ונהל שרתי MCP'
    'plugin:נהל תוספי Claude Code'
    'agents:נהל סוכני רקע'
    'attach:פתח הפעלת רקע בטרמינל זה'
    'logs:הדפס את פלט הטרמינל האחרון של הפעלת רקע'
    'stop:עצור הפעלת רקע (השיחה שלה נשמרת)'
    'respawn:הפעל מחדש הפעלת רקע כך שתרוץ על הגרסה הנוכחית של Claude Code'
    'rm:מחק הפעלת רקע, ואת ה-worktree שלה כאשר הדבר בטוח'
    'remote-control:שלוט בהפעלות מקומיות מ-claude.ai/code או מאפליקציית Claude לנייד'
    'daemon:נהל את המפקח של הפעלות הרקע'
    'auth:נהל אימות'
    'auto-mode:בדוק או אפס את הגדרות מסווג מצב אוטומטי'
    'gateway:הפעל את שער האימות/הטלמטריה הארגוני'
    'self-hosted-runner:ארח הפעלות ענן של Claude Code במכונה או בקונטיינר זה'
    'import:ייבא הגדרות מסוכן קוד AI אחר אל Claude Code'
    'project:נהל את מצב פרויקט Claude Code'
    'purge:מחק את כל מצב Claude Code עבור פרויקט (תמלולים, משימות, היסטוריית קבצים, רשומת הגדרות)'
    'ultrareview:הפעל סקירת קוד מרובת סוכנים המתארחת בענן והדפס את הממצאים'
    'setup-token:הגדר אסימון אימות ארוך טווח (דורש מנוי Claude)'
    'doctor:בדיקת תקינות למעדכן האוטומטי של Claude Code'
    'update:בדוק והתקן עדכונים'
    'install:התקן גרסה מקומית של Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[הפעל מצב ניפוי באגים עם סינון קטגוריות אופציונלי (למשל "api,hooks" או "!statsig,!file")]:filter:'
    '--verbose[עקוף הגדרת מצב מפורט מקובץ ההגדרות]'
    '(-p --print)'{-p,--print}'[הדפס תגובה וצא (לשימוש עם pipes). שים לב: השתמש רק בספריות מהימנות]'
    '--output-format[פורמט פלט (עם --print): "text" (ברירת מחדל), "json" (תוצאה יחידה), או "stream-json" (הזרמה בזמן אמת)]:format:(text json stream-json)'
    '--json-schema[סכמת JSON לאימות פלט מובנה]:schema:'
    '--include-partial-messages[כלול קטעי הודעה חלקיים כשהם מגיעים (עם --print ו-output-format=stream-json)]'
    '--input-format[פורמט קלט (עם --print): "text" (ברירת מחדל) או "stream-json" (קלט הזרמה בזמן אמת)]:format:(text stream-json)'
    '--dangerously-skip-permissions[עקוף את כל בדיקות ההרשאות. מומלץ רק עבור סביבות מבודדות ללא גישה לאינטרנט]'
    '--allow-dangerously-skip-permissions[אפשר אפשרות לעקיפת בדיקות הרשאות מבלי להפעיל כברירת מחדל]'
    '--restricted[מצב מוגבל: הסר את הכלים שמריצים פקודות או קוד ואת WebFetch, התעלם מהגדרות user/project/local, והגבל את כלי הקבצים לספריות העבודה]'
    '--max-budget-usd[הסכום המרבי בדולרים להוצאה על קריאות API (--print בלבד)]:amount:'
    '--max-turns[הגבל את מספר התורות הסוכניות (--print בלבד)]:turns:'
    '--replay-user-messages[שלח מחדש הודעות משתמש מ-stdin ל-stdout לאישור]'
    '--allowed-tools[רשימה מופרדת בפסיקים או רווחים של שמות כלים מותרים (למשל "Bash(git:*) Edit")]:tools:'
    '--allowedTools[רשימה מופרדת בפסיקים או רווחים של שמות כלים מותרים (פורמט camelCase)]:tools:'
    '--tools[ציין רשימת כלים זמינים מהסט המובנה. מצב הדפסה בלבד]:tools:'
    '--disallowed-tools[רשימה מופרדת בפסיקים או רווחים של שמות כלים אסורים (למשל "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[רשימה מופרדת בפסיקים או רווחים של שמות כלים אסורים (פורמט camelCase)]:tools:'
    '--mcp-config[טען שרתי MCP מקובץ JSON או מחרוזת (מופרדים ברווחים)]:configs:'
    '--system-prompt[פרומפט מערכת לשימוש בהפעלה]:prompt:'
    '--system-prompt-file[קרא פרומפט מערכת מקובץ]:file:_files'
    '--append-system-prompt[הוסף פרומפט מערכת לפרומפט מערכת ברירת המחדל]:prompt:'
    '--append-system-prompt-file[קרא פרומפט מערכת מקובץ והוסף אותו לפרומפט מערכת ברירת המחדל]:file:_files'
    '(--append-subagent-system-prompt-file)--append-subagent-system-prompt[הוסף טקסט לפרומפט המערכת של כל תת-סוכן (--print בלבד)]:prompt:'
    '(--append-subagent-system-prompt)--append-subagent-system-prompt-file[קרא טקסט מקובץ והוסף אותו לפרומפטי המערכת של תת-הסוכנים (--print בלבד)]:file:_files'
    '--system-prompt-snapshot[שמור את פרומפט המערכת פעם אחת לכל שיחה ועשה בו שימוש חוזר מילה במילה בכל בקשה ובכל חידוש (on, ברירת המחדל) או בנה אותו מחדש בכל בקשה (off)]:mode:(on off)'
    '--permission-mode[מצב הרשאות לשימוש בהפעלה]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[מי עונה לבקשות הרשאה עם --print: "host" (מארח ה-SDK או --permission-prompt-tool) או "none" (כל מה שהיה מבקש הרשאה נדחה)]:target:(host none)'
    '--permission-prompt-tool[כלי MCP לשימוש עבור בקשות הרשאה (--print בלבד)]:tool:'
    '(-c --continue)'{-c,--continue}'[המשך את השיחה האחרונה]'
    '(-r --resume)'{-r,--resume}'[חדש שיחה - ציין מזהה הפעלה או בחר באופן אינטראקטיבי]:sessionId:_claude_sessions'
    '--fork-session[צור מזהה הפעלה חדש במקום לעשות שימוש חוזר במזהה ההפעלה המקורי בעת חידוש (עם --resume או --continue)]'
    '--no-session-persistence[השבת שמירת הפעלות - הפעלות לא יישמרו (--print בלבד)]'
    '--model[מודל להפעלה נוכחית. ציין כינוי למודל העדכני ביותר (למשל '\''sonnet'\'' או '\''opus'\'')]:model:_claude_model_names'
    '--agent[סוכן להפעלה הנוכחית. עוקף את הגדרת '\''agent'\'']:agent:_claude_agent_names'
    '--betas[כותרות בטא לכלול בבקשות API (למשתמשי מפתח API בלבד)]:betas:'
    '--fallback-model[הפעל מעבר אוטומטי למודל שצוין כאשר המודל ברירת המחדל עמוס (--print בלבד)]:model:_claude_model_names'
    '--settings[נתיב לקובץ JSON הגדרות או מחרוזת JSON לטעינת הגדרות נוספות]:file-or-json:_files'
    '--add-dir[ספריות נוספות להרשאת גישת כלים]:directories:_directories'
    '--ide[התחבר אוטומטית ל-IDE בהפעלה אם זמין בדיוק IDE אחד תקף]'
    '--desktop[פתח באפליקציית Claude Desktop במקום בטרמינל (עם --continue או --resume <id> לבחירת ההפעלה)]'
    '--strict-mcp-config[השתמש רק בשרתי MCP מ-mcp-config-- והתעלם מכל הגדרות MCP אחרות]'
    '--session-id[מזהה הפעלה ספציפי לשימוש בשיחה (חייב להיות UUID תקף)]:uuid:'
    '--agents[אובייקט JSON המגדיר סוכנים מותאמים אישית]:json:'
    '--advisor[הפעל את כלי היועץ בצד השרת עבור הפעלה זו עם כינוי מודל או מזהה מודל מלא]:model:_claude_model_names'
    '--teammate-mode[אופן התצוגה של חברי צוות הסוכנים]:mode:(in-process auto tmux iterm2)'
    '--setting-sources[רשימה מופרדת בפסיקים של מקורות הגדרות לטעינה (user, project, local)]:sources:'
    '--plugin-dir[ספרייה לטעינת תוספים ממנה עבור הפעלה זו בלבד (ניתן לחזרה)]:paths:_directories'
    '--disable-slash-commands[השבת את כל פקודות הלוכסן]'
    '(--bg --background)'{--bg,--background}'[הפעל את ההפעלה כסוכן רקע וחזור מיד]'
    '(-w --worktree)'{-w,--worktree}'[צור git worktree חדש עבור הפעלה זו (ניתן לציין שם באופן אופציונלי)]::name:'
    '--tmux=-[צור הפעלת tmux עבור ה-worktree (דורש --worktree). משתמש בחלוניות המובנות של iTerm2 כאשר הן זמינות; --tmux=classic עבור tmux מסורתי]::mode:(classic)'
    '(-n --name)'{-n,--name}'[הגדר שם תצוגה להפעלה זו]:name:'
    '--effort[רמת מאמץ להפעלה הנוכחית]:level:(low medium high xhigh max)'
    '--autocompact[גודל חלון לדחיסה אוטומטית (auto, או 100k-1M טוקנים)]:size:(auto)'
    '--debug-file[כתוב יומני ניפוי באגים לנתיב קובץ ספציפי (מפעיל באופן מרומז את מצב ניפוי הבאגים)]:path:_files'
    '--from-pr[חדש הפעלה המקושרת ל-PR לפי מספר/URL, או פתח בורר אינטראקטיבי]::value:'
    '--teleport[חדש הפעלת teleport, ניתן לציין מזהה הפעלה באופן אופציונלי]::session:'
    '(--remote)--cloud[צור הפעלת ענן עם התיאור שצוין, או התחבר להפעלה קיימת לפי מזהה הפעלה או URL של claude.ai/code]::description-or-session:'
    '(--cloud)--remote[כינוי מיושן עבור --cloud]::description-or-session:'
    '--environment[צור הפעלת ענן חדשה שרצה בסביבה המתארחת עצמית שצוינה (ccpool_...)]:environment_id:'
    '--ref[עם --environment: בסס את ה-checkout של ההפעלה החדשה על ref בעל שם במקום על HEAD המקומי]:branch:'
    '(--remote-control --rc)'{--remote-control,--rc}'[הפעל הפעלה אינטראקטיבית עם שליטה מרחוק מופעלת (עם שם אופציונלי)]::name:'
    '--remote-control-session-name-prefix[קידומת לשמות הפעלות שליטה מרחוק שנוצרים אוטומטית]:prefix:'
    '--chrome[הפעל את שילוב Claude ב-Chrome]'
    '--no-chrome[השבת את שילוב Claude ב-Chrome]'
    '--plugin-url[הבא קובץ .zip של תוסף מ-URL עבור הפעלה זו בלבד (ניתן לחזרה)]:url:'
    '--file[משאבי קבצים להורדה בהפעלה (פורמט: file_id:relative_path)]:specs:'
    '--prompt-suggestions[הפעל הצעות פרומפט (פולט פרומפט הבא חזוי במצב print/SDK)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[העבר טקסט תת-סוכן ובלוקי חשיבה כהודעות (עם --print ו-stream-json)]'
    '--include-hook-events[כלול את כל אירועי מחזור החיים של ההוקים בזרם הפלט (עם stream-json)]'
    '--exclude-dynamic-system-prompt-sections[העבר קטעים ספציפיים למכונה להודעת המשתמש הראשונה כדי לשפר שימוש חוזר במטמון הפרומפט]'
    '--brief[הפעל את הכלי SendUserMessage לתקשורת מסוכן למשתמש]'
    '*--channels[(תצוגה מקדימה למחקר) שרתי MCP שיש להאזין להתראות הערוץ שלהם (plugin\:<name>@<marketplace>)]:entries:'
    '*--dangerously-load-development-channels[הפעל ערוצים שאינם ברשימת ההיתרים המאושרת, לפיתוח מקומי (plugin\:<name>@<marketplace> או server\:<name>)]:entries:'
    '--init[הרץ הוקי Setup עם ה-matcher init לפני ההפעלה (--print בלבד)]'
    '--init-only[הרץ הוקי Setup ו-SessionStart, ואז צא בלי להתחיל שיחה]'
    '--maintenance[הרץ הוקי Setup עם ה-matcher maintenance לפני ההפעלה (--print בלבד)]'
    '--safe-mode[התחל עם כל ההתאמות האישיות מושבתות (שימושי לפתרון בעיות בהגדרה תקולה)]'
    '--bare[מצב מינימלי: דלג על הוקים, LSP, סנכרון תוספים, ייחוס, זיכרון אוטומטי, וגילוי אוטומטי של CLAUDE.md]'
    '--ax-screen-reader[הצג פלט ידידותי לקורא מסך (טקסט שטוח, ללא גבולות דקורטיביים או אנימציות)]'
    '(-v --version)'{-v,--version}'[הצג מספר גרסה]'
    '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]'
  )

  # Stop at the first non-option word, so that the options after a command reach
  # that command's own specs instead of being consumed here
  _arguments -C -A '-*' \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude commands' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin|plugins)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        remote-control|rc|remote|sync|bridge)
          _claude_remote_control
          ;;
        daemon)
          _claude_daemon
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        self-hosted-runner)
          _claude_self_hosted_runner
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        purge)
          _claude_purge
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update|upgrade)
          _arguments \
            '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]'
          ;;
        *)
          # Not a command but the prompt: options may still follow it
          _arguments \
            $main_options \
            '*: :'
          ;;
      esac
      ;;
  esac
  local ret=$?

  # The last step, such as listing commands for --r, can fail although options
  # were added before it. Report success then: on failure zsh moves on to the
  # next completers, and _correct or _approximate pile on corrections
  (( compstate[nmatches] > 0 )) || return $ret
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:הפעל שרת MCP של Claude Code'
    'add:הוסף שרת MCP ל-Claude Code'
    'remove:הסר שרת MCP'
    'list:הצג רשימת שרתי MCP מוגדרים'
    'get:קבל פרטי שרת MCP'
    'add-json:הוסף שרת MCP (stdio או SSE) עם מחרוזת JSON'
    'add-from-claude-desktop:ייבא שרתי MCP מ-Claude Desktop (Mac ו-WSL בלבד)'
    'reset-project-choices:אפס את כל השרתים שאושרו/נדחו בהיקף פרויקט (.mcp.json) בפרויקט זה'
    'login:אמת מול שרת MCP (HTTP, SSE, או מחבר claude.ai)'
    'logout:נקה אישורי OAuth מאוחסנים עבור שרת MCP'
    'help:הצג עזרה'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[הצג עזרה]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp commands' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[הפעל מצב ניפוי באגים]' \
            '--verbose[עקוף הגדרת מצב מפורט מקובץ ההגדרות]' \
            '(-h --help)'{-h,--help}'[הצג עזרה]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[היקף הגדרות (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[סוג העברה (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[הגדר משתנה סביבה (למשל -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[הגדר כותרת WebSocket]:header:' \
            '--client-id[מזהה לקוח OAuth עבור שרתי HTTP/SSE]:clientId:' \
            '--client-secret[בקש את סוד לקוח OAuth (או הגדר את משתנה הסביבה MCP_CLIENT_SECRET)]' \
            '--callback-port[פורט קבוע עבור קריאה חוזרת של OAuth (לשרתים הדורשים כתובות URI להפניה שנרשמו מראש)]:port:' \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[היקף הגדרות (local, user, project) - הסר מהיקף קיים אם לא צוין]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[הצג עזרה]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[היקף הגדרות (local, user, project)]:scope:(local user project)' \
            '--client-secret[בקש את סוד לקוח OAuth (או הגדר את משתנה הסביבה MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[היקף הגדרות (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[הצג עזרה]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[הצג עזרה]'
          ;;
        login)
          _arguments \
            '--no-browser[הדפס את URL ההרשאה במקום לפתוח דפדפן (עבור הפעלות SSH/ללא ממשק)]' \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:אמת תוסף או מניפסט שוק'
    'marketplace:נהל שווקי Claude Code'
    'list:הצג רשימת תוספים מותקנים'
    'details:הצג מלאי רכיבים ועלות טוקנים צפויה עבור תוסף'
    'configure:הצג את האפשרויות של תוסף ואילו מהן לא הוגדרו, או שמור ערכים מ-stdin'
    'install:התקן תוסף מהשווקים הזמינים'
    'i:התקן תוסף מהשווקים הזמינים (קיצור ל-install)'
    'init:צור שלד לתוסף חדש (נטען אוטומטית בהפעלה הבאה)'
    'new:צור שלד לתוסף חדש (כינוי ל-init)'
    'uninstall:הסר התקנה של תוסף מותקן'
    'remove:הסר התקנה של תוסף מותקן (כינוי ל-uninstall)'
    'enable:הפעל תוסף מושבת'
    'disable:השבת תוסף מופעל'
    'update:עדכן תוסף לגרסה האחרונה'
    'eval:הפעל מקרי בדיקה מול תוסף ודווח תוצאות מנוקדות'
    'prune:הסר תלויות שהותקנו אוטומטית ואינן נחוצות עוד'
    'autoremove:הסר תלויות שהותקנו אוטומטית ואינן נחוצות עוד (כינוי ל-prune)'
    'tag:צור תגית git בפורמט {name}--v{version} עבור שחרור תוסף'
    'test:הרץ את הבדיקות של mod'
    'help:הצג עזרה'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[הצג עזרה]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin commands' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[התייחס לאזהרות כשגיאות (קוד יציאה 1)]' \
            '--profile[צא גם עם exit 1 כאשר הקטלוג שצוין היה דוחה הגשה של התוסף בבדיקה שפקודה זו מריצה]:name:(directory)' \
            '--json[הפק את דוח האימות כ-JSON (אותם קודי יציאה)]' \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[היקף התקנה]:scope:(user project local)' \
            '--accept-command[קבל את הפקודה שהוצהרה על ידי השוק שה-sha256 שלה דווח בהרצת --json קודמת כ-shownCommand.sha256]:sha256:' \
            '*--config[הגדר אפשרות userConfig שהוצהרה במניפסט התוסף (ניתן לחזרה)]:key=value:' \
            '--marketplace[התקן את התוסף לפי שמו החשוף מהשוק שבמקור זה (owner/repo, כתובת URL של git או https, או נתיב), והוסף אותו קודם אם צריך]:source:' \
            '--registry[עבור התקנת package@npm: פתור והורד ממאגר npm זה]:url:' \
            '(-y --yes)'{-y,--yes}'[קבל את הפקודה המוצגת שהוצהרה על ידי השוק ללא בקשת האישור]' \
            '--json[הדפס שורת תוצאה אחת קריאה למכונה במקום ההודעה לקריאה אנושית]' \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[היקף התקנה]:scope:(user project local)' \
            '--keep-data[שמור את ספריית הנתונים הקבועה של התוסף]' \
            '--prune[הסר גם תלויות שהותקנו אוטומטית ואינן נחוצות עוד]' \
            '(-y --yes)'{-y,--yes}'[דלג על בקשת האישור של --prune]' \
            '--json[הדפס שורת תוצאה אחת קריאה למכונה במקום ההודעה לקריאה אנושית (לא עם --prune)]' \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[היקף התקנה]:scope:(user project local)' \
            '--json[הדפס שורת תוצאה אחת קריאה למכונה במקום ההודעה לקריאה אנושית]' \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[השבת את כל התוספים המופעלים]' \
            '(-s --scope)'{-s,--scope}'[היקף התקנה]:scope:(user project local)' \
            '--json[הדפס שורת תוצאה אחת קריאה למכונה במקום ההודעה לקריאה אנושית]' \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '--accept-command[קבל את הפקודה שהוצהרה על ידי השוק שה-sha256 שלה דווח בהרצת --json קודמת כ-shownCommand.sha256]:sha256:' \
            '(-s --scope)'{-s,--scope}'[היקף התקנה]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[קבל את הפקודה המוצגת שהוצהרה על ידי השוק ללא בקשת האישור]' \
            '--json[הדפס שורת תוצאה אחת קריאה למכונה במקום ההודעה לקריאה אנושית]' \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[פלט כ-JSON]' \
            '--available[כלול תוספים זמינים מהשווקים (דורש --json)]' \
            '--data-size[מדוד את ספריית הנתונים השמורים של כל תוסף מותקן, או רק של התוסף שצוין (דורש --json)]::plugin:_claude_installed_plugins' \
            '(-h --help)'{-h,--help}'[הצג עזרה]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[נקה בהיקף]:scope:(user project local)' \
            '--dry-run[הצג רשימה של מה שהיה מוסר מבלי להסיר]' \
            '(-y --yes)'{-y,--yes}'[דלג על בקשת האישור]' \
            '(-h --help)'{-h,--help}'[הצג עזרה]'
          ;;
        configure)
          _arguments \
            '--json[פלט כ-JSON]' \
            '--values-stdin[קרא ערכי אפשרויות מ-stdin כאובייקט JSON של מחרוזות בשורה אחת; אפשרויות שלא נכללו שומרות על ערכיהן]' \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[תיאור המניפסט]:text:' \
            '--author[שם המחבר (ברירת מחדל: git config user.name)]:name:' \
            '--author-email[דוא"ל המחבר (ברירת מחדל: git config user.email)]:email:' \
            '--with[רכיבים ליצירת שלד גם עבורם]:components:' \
            '(-f --force)'{-f,--force}'[דרוס .claude-plugin/ קיים ביעד]' \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '1:name:'
          ;;
        eval)
          if [[ $words[2] == init ]]; then
            _arguments \
              '--bare[כתוב תבנית ריקה במקום להריץ את הראיון]' \
              '--eval-dir[ספרייה מתחת לספרייה הנוכחית שאליה ייכתבו המקרים]:dir:_directories' \
              '(-i --interactive)'{-i,--interactive}'[הרץ את ראיון הכתיבה (דורש טרמינל אינטראקטיבי)]' \
              '(-h --help)'{-h,--help}'[הצג עזרה]' \
              '::name:'
            return
          fi
          _arguments \
            '--case[סנן מקרי בדיקה לפי תבנית glob של שם]:glob:' \
            '*--tag[סנן מקרי בדיקה לפי תגית (ניתן לחזרה)]:tag:' \
            '--runs[עקוף את מספר ההרצות לכל מקרה בדיקה (ברירת מחדל: case.runs, אחרת 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[בצע עד n הרצות סוכן בו-זמנית (1-8; ברירת מחדל 1)]:n:' \
            '--model[עקוף את המודל עבור כל מקרי הבדיקה]:model:_claude_model_names' \
            '--judge-model[עקוף את מודל מעריך ה-LLM (ברירת מחדל: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[תקרת עלות קשיחה; אם הושגה, בטל ודווח תוצאות חלקיות (קוד יציאה 2)]:usd:' \
            '--output-dir[ספרייה עבור aggregate-result.json]:dir:_directories' \
            '--eval-dir[שם הספרייה (מתחת לתוסף) שמכילה את מקרי הבדיקה]:dir:' \
            '--json[הדפס את תוצאת ההרצה המלאה כ-JSON ל-stdout, או כתוב אותה לקובץ .json זה]::path:_files' \
            '--threshold[צא עם קוד יציאה 1 אם ציון של מקרה בדיקה כלשהו נמוך מסף זה (ברירת מחדל: 1.0)]:threshold:' \
            '*--allow-tools[הרשאת מפעיל עבור כלים מוגבלים (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '*--disallow-tools[כלים מובנים שיימנעו מ-Claude בכל מקרה, גם אם הורשו]:tools:' \
            '(--no-scaffold)--scaffold[הרץ את scaffold_script של כל מקרה בדיקה (מריץ bash שסופק על ידי המחבר תחת המשתמש שלך; כבוי כברירת מחדל)]' \
            '(--scaffold)--no-scaffold[דלג במפורש על scaffold_script]' \
            '--trust-plugin[אשר שאתה סומך על תוסף זה ועל חבילת הבדיקות שלו, תוך דילוג על בקשת האמון בהרצה הראשונה (עבור CI)]' \
            '--ablation[הרץ קבוצת ביקורת ללא התוסף ודווח את הפרש הציונים]:mode:(none with-without)' \
            '--mocks[תחליפי mock עבור שרתי MCP, מתוך <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[עם --mocks record: הפעל גם את תהליכי שרתי ה-MCP האמיתיים שאין להם mock]' \
            '--keep-temp[שמור את ספריות השלד לצורך ניפוי באגים]' \
            '--verbose[רשום אירועי מעקב לכל הודעה ביומן ניפוי הבאגים]' \
            '--report[כתוב את דוח ה-HTML העצמאי לנתיב זה במקום לספריית התוצאות]:path:_files' \
            '(--no-publish)--publish-report[דרוש גם פרסום של הדוח ב-claude.ai]' \
            '(--publish-report)--no-publish[שמור את דוח ה-HTML מקומית בלבד; דלג על פרסומו ב-claude.ai]' \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '::target: _alternative "commands\:eval command\:(init)" "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[דחוף את התגית אל --remote לאחר יצירתה]' \
            '--dry-run[הדפס מה היה מתויג מבלי ליצור את התגית]' \
            '(-f --force)'{-f,--force}'[דלג על הבדיקות של עץ עבודה עם שינויים ושל תגית שכבר קיימת]' \
            '(-m --message)'{-m,--message}'[הודעת הערה לתגית (השתמש ב-%s עבור הגרסה)]:msg:' \
            '--remote[ה-remote שאליו לדחוף עם --push]:name:' \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:הוסף שוק מ-URL, נתיב או מאגר GitHub'
    'list:הצג רשימת שווקים מוגדרים'
    'remove:הסר שוק מוגדר'
    'rm:הסר שוק מוגדר (כינוי ל-remove)'
    'update:עדכן שוק מהמקור - עדכן הכל אם לא צוין שם'
    'help:הצג עזרה'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[הצג עזרה]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace commands' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[הגבל את ה-checkout לספריות ספציפיות באמצעות git sparse-checkout (עבור monorepos)]:paths:' \
            '--scope[היכן להצהיר על השוק]:scope:(user project local)' \
            '--json[הדפס שורת תוצאה אחת קריאה למכונה כשורה האחרונה ב-stdout]' \
            '--claudeai[הוסף את השוק בשם זה ש-claude.ai מארח עבורך]' \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[פלט כ-JSON]' \
            '(-h --help)'{-h,--help}'[הצג עזרה]'
          ;;
        remove|rm)
          _arguments \
            '--scope[הסר את הצהרת השוק מהיקף הגדרות ספציפי (השמט כדי להסיר אותה מכל ההיקפים)]:scope:(user project local)' \
            '--json[הדפס שורת תוצאה אחת קריאה למכונה כשורה האחרונה ב-stdout]' \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '--json[עם שם שוק: הדפס שורת תוצאה אחת קריאה למכונה כשורה האחרונה ב-stdout]' \
            '(-h --help)'{-h,--help}'[הצג עזרה]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[אלץ התקנה גם אם כבר מותקן]' \
    '(-h --help)'{-h,--help}'[הצג עזרה]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[ספרייה נוספת להרשאת גישת כלים בהפעלות שנשלחו]:directory:_directories' \
    '--agent[סוכן ברירת מחדל להפעלות שנשלחו מתצוגת הסוכנים]:agent:_claude_agent_names' \
    '--all[עם --json: כלול גם הפעלות רקע שהושלמו]' \
    '--allow-dangerously-skip-permissions[הפוך מצב עקיפת הרשאות לזמין להפעלות שנשלחו]' \
    '--cwd[הצג רק הפעלות רקע שהתחילו תחת הנתיב]:path:_directories' \
    '--dangerously-skip-permissions[כינוי ל-permission-mode-- bypassPermissions]' \
    '--effort[רמת מאמץ ברירת מחדל להפעלות שנשלחו]:level:(low medium high xhigh max)' \
    '--json[הדפס הפעלות פעילות כמערך JSON וצא]' \
    '*--mcp-config[הגדרת שרת MCP להחלה על הפעלות שנשלחו]:config:' \
    '--model[מודל ברירת מחדל להפעלות שנשלחו מתצוגת הסוכנים]:model:_claude_model_names' \
    '--permission-mode[מצב הרשאות ברירת מחדל להפעלות שנשלחו]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[טען תוספים מספרייה עבור תצוגת הסוכנים והפעלות שנשלחו]:path:_directories' \
    '--setting-sources[רשימה מופרדת בפסיקים של מקורות הגדרות לטעינה (user, project, local)]:sources:' \
    '--settings[קובץ הגדרות או מחרוזת JSON להחלה]:file-or-json:_files' \
    '--strict-mcp-config[השתמש רק בשרתי MCP מ-mcp-config-- בהפעלות שנשלחו]' \
    '--restricted[התחל הפעלות שנשלחו במצב מוגבל]' \
    '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:התחבר לחשבון Anthropic שלך'
    'logout:התנתק מחשבון Anthropic שלך'
    'status:הצג את מצב האימות'
    'help:הצג עזרה'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth commands' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[מלא מראש את כתובת הדוא"ל בדף ההתחברות]:email:' \
            '--sso[אלץ תהליך התחברות SSO]' \
            '(--claudeai)--console[השתמש ב-Anthropic Console (חיוב לפי שימוש ב-API) במקום במנוי Claude]' \
            '(--console)--claudeai[השתמש במנוי Claude (ברירת מחדל)]' \
            '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]'
          ;;
        status)
          _arguments \
            '(--text)--json[פלט כ-JSON (ברירת מחדל)]' \
            '(--json)--text[פלט כטקסט קריא לאדם]' \
            '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:הדפס את הגדרות מצב אוטומטי האפקטיביות כ-JSON'
    'critique:קבל משוב AI על כללי מצב אוטומטי מותאמים אישית שלך'
    'defaults:הדפס את כללי מצב אוטומטי ברירת המחדל כ-JSON'
    'reset:אפס את הגדרות מצב אוטומטי לברירות המחדל שסופקו'
    'help:הצג עזרה'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode commands' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[עקוף את המודל שבשימוש]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]'
          ;;
        defaults)
          _arguments \
            '--label[הצג רק כללים שהתווית שלהם מתחילה בקידומת זו (ללא הבחנה בין אותיות רישיות לקטנות)]:prefix:' \
            '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[דלג על בקשת האישור]' \
            '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[נתיב לקובץ הגדרות YAML של השער]:path:_files' \
    '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:מחק את כל מצב Claude Code עבור פרויקט (תמלולים, משימות, היסטוריית קבצים, רשומת הגדרות)'
    'help:הצג עזרה'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project commands' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[הצג רשימה של מה שהיה נמחק מבלי למחוק דבר]' \
            '(-y --yes)'{-y,--yes}'[דלג על בקשת האישור]' \
            '(-i --interactive)'{-i,--interactive}'[בקש אישור עבור כל פריט לפני המחיקה]' \
            '(1)--all[מחק את המצב עבור כל הפרויקטים (לא ניתן לשלב עם נתיב)]' \
            '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_purge() {
  _arguments \
    '--dry-run[הצג רשימה של מה שהיה נמחק מבלי למחוק דבר]' \
    '(-y --yes)'{-y,--yes}'[דלג על בקשת האישור]' \
    '(-i --interactive)'{-i,--interactive}'[בקש אישור עבור כל פריט לפני המחיקה]' \
    '(1)--all[מחק את המצב עבור כל הפרויקטים (לא ניתן לשלב עם נתיב)]' \
    '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]' \
    '(--all)::path:_directories'
}

_claude_ultrareview() {
  _arguments \
    '--json[הדפס את מטען bugs.json הגולמי במקום ממצאים מעוצבים]' \
    '--timeout[מספר הדקות המרבי להמתנה לסיום הסקירה (ברירת מחדל: 45)]:minutes:' \
    '(--no-post)--post[פרסם את ממצאי הסקירה שהושלמה ב-PR בשמך (ליעדי PR בלבד; תגובה רגילה אחת, לא סקירה)]' \
    '(--post)--no-post[אל תפרסם את הממצאים ב-PR (ברירת המחדל)]' \
    '--trust-workspace[סמוך על התיקייה הנוכחית להרצה זו בלבד, בלי לשאול (עבור סקריפטים ו-CI)]' \
    '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[הפעל מחדש כל הפעלת רקע שרצה]' \
    '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[מחק גם את ה-commits שלא נדחפו ואת השינויים שלא בוצע להם commit ב-worktree (העבר את ה-commit@worktree-id שדווח על ידי claude rm קודם)]:commit@worktree-id:' \
    '--force-remove-worktree[מחק את ספריית ה-worktree גם אם ההוק WorktreeRemove או git לא הצליחו להסיר אותה (העבר את ה-worktree-id שדווח על ידי claude rm קודם)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]' \
    '1:session:_claude_background_sessions'
}

_claude_self_hosted_runner() {
  _arguments \
    '--api-url[כתובת URL בסיסית של ה-API (ברירת מחדל: https://api.anthropic.com)]:url:' \
    '--environment-secret-file[נתיב לקובץ הסודות של הסביבה]:path:_files' \
    '--lock-to-account[נעל את ה-runner לחשבון יחיד בעת הרישום]:id:' \
    '--client-label[תווית ניטור שנשלחת בעת הרישום (ברירת מחדל: hostname)]:label:' \
    '(--proxy-authorization-file --agent-proxy-url)--proxy-authorization-command[פקודה שה-stdout שלה הוא כותרת Proxy-Authorization עבור פרוקסי יציאה]:shell command:' \
    '(--proxy-authorization-command --agent-proxy-url)--proxy-authorization-file[קובץ המכיל את כותרת Proxy-Authorization עבור פרוקסי יציאה]:path:_files' \
    '(--proxy-authorization-command --proxy-authorization-file)--agent-proxy-url[נתב כל הפעלה דרך פרוקסי הסוכן בכתובת URL זו (https בלבד)]:url:' \
    '--capacity[מספר מרבי של הפעלות במקביל (ברירת מחדל: 1)]:n:' \
    '--base-dir[ספריית בסיס ל-checkouts של מאגרים (ברירת מחדל: /workspace)]:path:_directories' \
    '--exec-path[קובץ בינארי להפעלה עבור הפעלות צאצא (ברירת מחדל: הקובץ הבינארי הזה)]:path:_files' \
    '--hooks-dir[ספריית סקריפטים של הוקי מחזור חיים (checkout, command, post-session)]:path:_directories' \
    '--session-stop-grace-sec[כמה זמן להמתין ליציאה נקייה לאחר סיום הפעלה (ברירת מחדל: 5)]:n:' \
    '--post-session-hook-timeout-sec[תקציב SIGTERM עבור ההוק post-session (ברירת מחדל: 60)]:n:' \
    '--checkout-hook-timeout-min[תקציב זמן אמת לכל הרצה של ההוק checkout (ברירת מחדל: 30; 0 מבטל)]:n:' \
    '--drain-wait-sec[ב-SIGTERM/SIGINT, המתן עד N שניות לעבודה שבתהליך (ברירת מחדל: 0)]:n:' \
    '--drain-marker-file[קובץ סמן שבאמצעותו המארח מודיע על ריקון מסודר]:path:_files' \
    '*--git-ssh-rewrite[שכתב כתובות URL של מקור https://<host>/... ל-git@<host>:... (ניתן לחזרה)]:host:' \
    '*--git-host-rewrite[שכתב כתובות URL של מקור https://<f>/... ל-https://<t>/... (ניתן לחזרה)]:from=to:' \
    '--use-anthropic-git-proxy[השתמש ב-git המנוהל על ידי Anthropic. אזהרה: מוחק ומחליף את תצורת git ברמת HOME, השתמש רק תחת חשבון ייעודי]' \
    '--configure-git[הגדר את זהות git הגלובלית והפעל חתימת commits דרך שירות החתימה של Anthropic. כותב ~/.gitconfig]' \
    '--push-outcome-on-release[דחוף ענפי תוצאה במעקב כאשר ה-runner מסיים הפעלה שלא הושלמה]' \
    '--trust-workspace[אתחל אמון קבוע עבור נתיבי המאגר של כל הפעלה (ברירת מחדל: true)]::bool:(true false)' \
    '--remove-session-state[הסר מצב לכל הפעלה כאשר הפעלה מסתיימת (ברירת מחדל: false)]::bool:(true false)' \
    '--diff-finds-nested-repository[הצג מאגר שנשכפל לתת-תיקייה בחלונית Changes; דורש --capacity 1 (ברירת מחדל: false)]::bool:(true false)' \
    '--confine-repo-settings[מצב השמירה המגבילה הגדרות שבוצע להן commit במאגר (ברירת מחדל: warn)]:mode:(warn enforce off)' \
    '--server-auto-mode-lists[אילו רשימות מסווג של מצב אוטומטי מהשרת הפעלה רשאית לקבל (ברירת מחדל: no-allow)]:mode:(all no-allow none)' \
    '--host-config-snapshot[היכן נשמרת תמונת המצב של תצורת המארח בעת ההפעלה (ברירת מחדל: disk)]:mode:(disk memory)' \
    '--health-port[פורט עבור מאזין ה-HTTP של /healthz (ברירת מחדל: 8080; 0 מבטל)]:port:' \
    '--log-level[רמת יומן (ברירת מחדל: info)]:level:(info debug)' \
    '--log-file[העתק גם את יומני ה-runner לקובץ במצב הוספה]:path:_files' \
    '--exit-if-unused-min[צא מה-runner אם לא הוקצתה לו עבודה במשך N דקות]:n:' \
    '--drain-grace-sec[מספר השניות להמשיך לבדוק אם יש עבודה לאחר שההפעלות הפעילות מסתיימות (ברירת מחדל: 0)]:n:' \
    '--retire-at[הוצא את ה-runner משימוש בזמן Unix מוחלט זה, בשניות]:epoch-seconds:' \
    '--defer-shutdown-max-min[ב-SIGTERM/SIGINT הראשון, הפסק לקבל עבודה וסיים את הכיבוי M דקות לאחר מכן (ברירת מחדל: 0)]:m:' \
    '--release-idle-session-min[שחרר משבצת הפעלה לאחר N דקות ללא קלט משתמש]:n:' \
    '--startup-timeout-min[שחרר משבצת הפעלה אם תהליך הצאצא לא סיים לעלות לאחר N דקות (ברירת מחדל: 15; 0 מבטל)]:n:' \
    '--kill-session-after-min[הגבל את משך החיים בזמן אמת של תהליך צאצא של הפעלה ל-N דקות]:n:' \
    '--debug-token-dir[לניפוי באגים בלבד: כותב אסימונים חיים לדיסק. אין להשתמש בסביבת ייצור]:path:_directories' \
    '(-h --help)'{-h,--help}'[הצג הודעת עזרה זו]'
}

_claude_remote_control() {
  _arguments \
    '--name[שם עבור ההפעלה (מוצג ב-claude.ai/code)]:name:' \
    '--remote-control-session-name-prefix[קידומת לשמות הפעלות שנוצרים אוטומטית (ברירת מחדל: hostname)]:prefix:' \
    '(-c --continue --session-id)'{-c,--continue}'[התחבר מחדש להפעלה האחרונה שנרשמה עבור ספרייה זו או אחד מה-git worktrees שלה]' \
    '(-c --continue --session-id)--session-id[התחבר מחדש להפעלה ספציפית לפי מזהה]:id:' \
    '--permission-mode[מצב הרשאות עבור הפעלות שנוצרות]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)' \
    '(--no-chrome)--chrome[הפעל את Claude in Chrome עבור הפעלות שנוצרות]' \
    '(--chrome)--no-chrome[השבת את Claude in Chrome עבור הפעלות שנוצרות]' \
    '(-d --debug)'{-d,--debug}'[הפעל מצב ניפוי באגים עם סינון קטגוריות אופציונלי]::filter:' \
    '--debug-file[כתוב יומני ניפוי באגים לקובץ]:path:_files' \
    '(-v --verbose)'{-v,--verbose}'[הפעל פלט מפורט]' \
    '--spawn[מצב יצירה (ברירת מחדל: same-dir)]:mode:(same-dir worktree session)' \
    '--capacity[מספר מרבי של הפעלות במקביל במצב worktree או same-dir (ברירת מחדל: 32)]:n:' \
    '(--no-create-session-in-dir)--create-session-in-dir[צור מראש הפעלה בספרייה הנוכחית (ברירת מחדל)]' \
    '(--create-session-in-dir)--no-create-session-in-dir[אל תיצור מראש הפעלה בספרייה הנוכחית]' \
    '(-h --help)'{-h,--help}'[הצג עזרה זו]'
}

_claude_daemon() {
  local -a daemon_commands common_options
  daemon_commands=(
    'run:הרץ את המפקח בחזית'
    'status:הצג את ה-pid, הגרסה וזמן הפעולה של ה-daemon'
    'logs:עקוב אחר יומן ה-daemon (Ctrl-C לעצירה)'
    'uninstall:הסר את שירות הרקע (launchctl/systemd)'
    'stop:כבה את המפקח וסיים את הפעלות הרקע'
  )
  common_options=(
    '--json-path[קובץ הגדרות (ברירת מחדל: ~/.claude/daemon.json)]:path:_files'
    '--log-file[קובץ יומן (ברירת מחדל: ~/.claude/daemon.log)]:path:_files'
    '(-h --help)'{-h,--help}'[הצג עזרה זו]'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    $common_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'daemon commands' daemon_commands
      ;;
    args)
      case $words[1] in
        run)
          _arguments \
            $common_options \
            '::json-path:_files'
          ;;
        stop)
          _arguments \
            $common_options \
            '--any[עצור גם daemon זמני (שאינו שירות)]' \
            '--keep-workers[השאר הפעלות מנותקות פועלות]'
          ;;
        status|logs|uninstall)
          _arguments \
            $common_options
          ;;
      esac
      ;;
  esac
}

_claude_import() {
  _arguments \
    '--dry-run[הצג מה היה מיובא מבלי לכתוב דבר]' \
    '--yes[דלג על הבורר האינטראקטיבי (בממשקים ללא תצוגה, העבר --yes=<digest> מהתצוגה המקדימה של /import)]' \
    '(-h --help)'{-h,--help}'[הצג עזרה לפקודה]' \
    '::source:(codex gemini cursor)'
}

# compinit autoloads this file, and that first call only defines the functions
# above: complete right away so the first TAB already works. Sourced directly,
# there is nothing to complete yet, only the registration.
if [[ $funcstack[1] == _claude ]]; then
  _claude "$@"
else
  (( $+_comps[claude] )) || compdef _claude claude
fi
