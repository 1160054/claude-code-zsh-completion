#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Stilla og stjórna MCP-þjónum'
    'plugin:Stjórna Claude Code viðbótum'
    'agents:Stjórna bakgrunnsumboðsmönnum'
    'attach:Opna bakgrunnslotu í þessari útstöð'
    'logs:Prenta nýlegt útstöðvarúttak bakgrunnslotu'
    'stop:Stöðva bakgrunnslotu (samtalið er varðveitt)'
    'respawn:Endurræsa bakgrunnslotu svo hún keyri núverandi útgáfu af Claude Code'
    'rm:Eyða bakgrunnslotu, og worktree hennar þegar það er öruggt'
    'auth:Stjórna auðkenningu'
    'auto-mode:Skoða eða endurstilla stillingar auto mode flokkara'
    'gateway:Keyra fyrirtækja auðkennis-/fjarmælingargátt'
    'import:Flytja inn stillingar frá öðrum gervigreindar kóðunarumboðsmanni í Claude Code'
    'project:Stjórna stöðu Claude Code verkefnis'
    'ultrareview:Keyra skýhýsta fjölumboðsmanna kóðarýni og prenta niðurstöður'
    'setup-token:Stilla langtíma auðkenningarmerki (krefst Claude áskriftar)'
    'doctor:Heilsuathugun fyrir Claude Code sjálfvirka uppfæringar'
    'update:Leita að og setja upp uppfærslur'
    'install:Setja upp Claude Code native build'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Virkja kembihamur með valkvæðri flokkasíun (t.d. "api,hooks" eða "!statsig,!file")]:filter:'
    '--verbose[Hunsa ítarlegan ham frá stillingarskrá]'
    '(-p --print)'{-p,--print}'[Prenta svar og hætta (til notkunar með pípur). Athugið: nota aðeins í treystum möppum]'
    '--output-format[Úttak snið (með --print): "text" (sjálfgefið), "json" (stakt niðurstaða) eða "stream-json" (rauntíma streyming)]:format:(text json stream-json)'
    '--json-schema[JSON skema fyrir skipulagt úttak villuleit]:schema:'
    '--include-partial-messages[Taka með hluta skilaboða þegar þau berast (með --print og --output-format=stream-json)]'
    '--input-format[Inntak snið (með --print): "text" (sjálfgefið) eða "stream-json" (rauntíma streyming inntak)]:format:(text stream-json)'
    '--mcp-debug[\[Úrelt. Notaðu --debug í staðinn\] Virkja MCP kembiham (sýnir MCP-þjóns villur)]'
    '--dangerously-skip-permissions[Fara framhjá öllum heimildaathugunum. Mælt með aðeins fyrir sandkassa án netaðgangs]'
    '--allow-dangerously-skip-permissions[Virkja valkost til að fara framhjá heimildaathugunum án þess að virkja sem sjálfgefið]'
    '--restricted[Takmarkaður hamur: fjarlægja verkfæri sem keyra skipanir eða kóða og WebFetch, hunsa user/project/local stillingar og takmarka skráarverkfæri við vinnumöppurnar]'
    '--max-budget-usd[Hámarks dollaraupphæð til að eyða í API köll (aðeins --print)]:amount:'
    '--replay-user-messages[Endursenda notendarskilaboð frá stdin á stdout til staðfestingar]'
    '--allowed-tools[Komma eða bil aðskilinn listi yfir leyfileg verkfæranöfn (t.d. "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Komma eða bil aðskilinn listi yfir leyfileg verkfæranöfn (camelCase snið)]:tools:'
    '--tools[Tilgreina lista yfir tiltæk verkfæri úr innbyggðu setti. Aðeins prentham]:tools:'
    '--disallowed-tools[Komma eða bil aðskilinn listi yfir óleyfileg verkfæranöfn (t.d. "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Komma eða bil aðskilinn listi yfir óleyfileg verkfæranöfn (camelCase snið)]:tools:'
    '--mcp-config[Hlaða MCP-þjónum úr JSON skrá eða strengi (bil aðskilinn)]:configs:'
    '--system-prompt[Kerfis fyrirspurn til að nota fyrir lotu]:prompt:'
    '--system-prompt-file[Lesa kerfis fyrirspurn úr skrá]:file:_files'
    '--append-system-prompt[Bæta kerfis fyrirspurn við sjálfgefna kerfis fyrirspurn]:prompt:'
    '--append-system-prompt-file[Lesa kerfis fyrirspurn úr skrá og bæta henni við sjálfgefna kerfis fyrirspurn]:file:_files'
    '--system-prompt-snapshot[Skrá kerfis fyrirspurn einu sinni í hverju samtali og endurnýta hana orðrétt í hverri beiðni og við áframhald (on, sjálfgefið) eða mynda hana upp á nýtt í hverri beiðni (off)]:mode:(on off)'
    '--permission-mode[Heimildarhamur til að nota fyrir lotu]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Hver svarar heimildabeiðnum með --print: "host" (SDK hýsillinn eða --permission-prompt-tool) eða "none" (öllu sem myndi kalla á beiðni er hafnað)]:target:(host none)'
    '--permission-prompt-tool[MCP verkfæri til að nota fyrir heimildabeiðnir (aðeins --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Halda áfram nýjustu samtalinu]'
    '(-r --resume)'{-r,--resume}'[Halda áfram samtali - tilgreina lotu-auðkenni eða velja gagnvirkt]:sessionId:_claude_sessions'
    '--fork-session[Búa til nýtt lotu-auðkenni í stað þess að endurnýta upprunalegt lotu-auðkenni við áframhald (með --resume eða --continue)]'
    '--no-session-persistence[Slökkva á lotuvistun - lotur verða ekki vistaðar (aðeins --print)]'
    '--model[Líkan fyrir núverandi lotu. Tilgreina samnefni fyrir nýjasta líkan (t.d. '\''sonnet'\'' eða '\''opus'\'')]:model:_claude_model_names'
    '--agent[Umboðsmaður fyrir núverandi lotu. Hunsar '\''agent'\'' stillinguna]:agent:_claude_agent_names'
    '--betas[Beta hausar til að taka með í API beiðnum (aðeins fyrir API lyklanotendur)]:betas:'
    '--fallback-model[Virkja sjálfvirka varalíkan þegar sjálfgefið líkan er ofhlaðið (aðeins --print)]:model:_claude_model_names'
    '--settings[Slóð að stillingum JSON skrá eða JSON strengi til að hlaða viðbótar stillingum]:file-or-json:_files'
    '--add-dir[Viðbótar möppur til að leyfa verkfæra aðgang]:directories:_directories'
    '--ide[Tengja sjálfkrafa við IDE við ræsingu ef nákvæmlega eitt gilt IDE er tiltækt]'
    '--desktop[Opna í Claude Desktop forritinu í stað útstöðvarinnar (með --continue eða --resume <id> til að velja lotuna)]'
    '--strict-mcp-config[Nota aðeins MCP-þjóna frá --mcp-config og hunsa allar aðrar MCP stillingar]'
    '--session-id[Sérstakt lotu-auðkenni til að nota fyrir samtal (verður að vera gilt UUID)]:uuid:'
    '--agents[JSON hlutur sem skilgreinir sérsniðna umboðsmenn]:json:'
    '--setting-sources[Kommu aðskilinn listi yfir stillingarheimildir til að hlaða (user, project, local)]:sources:'
    '--plugin-dir[Mappa til að hlaða viðbótum frá aðeins fyrir þessa lotu (má endurtaka)]:paths:_directories'
    '--disable-slash-commands[Slökkva á öllum skástriksskipunum]'
    '(--bg --background)'{--bg,--background}'[Ræsa lotuna sem bakgrunnsumboðsmann og skila strax]'
    '(-w --worktree)'{-w,--worktree}'[Búa til nýtt git worktree fyrir þessa lotu (valkvætt tilgreina nafn)]::name:'
    '--tmux=-[Búa til tmux lotu fyrir worktree (krefst --worktree). Notar innbyggða iTerm2 glugga þegar tiltækt; --tmux=classic fyrir hefðbundið tmux]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Setja birtingarnafn fyrir þessa lotu]:name:'
    '--effort[Áreynslustig fyrir núverandi lotu]:level:(low medium high xhigh max)'
    '--autocompact[Gluggastærð sjálfvirkrar þjöppunar (auto, eða 100k-1M tákn)]:size:(auto)'
    '--debug-file[Skrifa kembilog í tiltekna skráarslóð (virkjar óbeint kembiham)]:path:_files'
    '--from-pr[Halda áfram lotu tengdri PR eftir númeri/URL, eða opna gagnvirkan valmynd]::value:'
    '--teleport[Halda áfram teleport lotu, valkvætt tilgreina lotu-auðkenni]::session:'
    '--cloud[Búa til skýlotu með gefinni lýsingu, eða tengjast fyrirliggjandi lotu eftir lotu-auðkenni eða claude.ai/code URL]::description-or-session:'
    '--environment[Búa til nýja skýlotu sem keyrir á gefnu sjálfhýstu umhverfi (ccpool_...)]:environment_id:'
    '--remote-control[Ræsa gagnvirka lotu með Remote Control virkt (valkvætt nefnt)]::name:'
    '--remote-control-session-name-prefix[Forskeyti fyrir sjálfvirkt mynduð Remote Control lotunöfn]:prefix:'
    '--chrome[Virkja Claude í Chrome samþættingu]'
    '--no-chrome[Slökkva á Claude í Chrome samþættingu]'
    '--plugin-url[Sækja viðbótar .zip frá URL aðeins fyrir þessa lotu (má endurtaka)]:url:'
    '--file[Skráar tilföng til að sækja við ræsingu (snið: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Virkja fyrirspurnartillögur (gefur spáða næstu fyrirspurn í print/SDK ham)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Áframsenda texta undirumboðsmanns og hugsanablokkir sem skilaboð (með --print og stream-json)]'
    '--include-hook-events[Taka með alla hook lífsferilsatburði í úttaksstraumnum (með stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Færa vélarsértæka hluta í fyrstu notendaskilaboðin til að bæta endurnýtingu fyrirspurnar-skyndiminnis]'
    '--brief[Virkja SendUserMessage verkfæri fyrir samskipti umboðsmanns við notanda]'
    '--safe-mode[Ræsa með allar sérstillingar óvirkar (gagnlegt við úrræðaleit á bilaðri stillingu)]'
    '--bare[Lágmarkshamur: sleppa hooks, LSP, viðbótasamstillingu, eignun, sjálfvirku minni og CLAUDE.md sjálfvirkri uppgötvun]'
    '--ax-screen-reader[Birta skjálesaravænt úttak (flatur texti, engir skreytingarrammar eða hreyfingar)]'
    '(-v --version)'{-v,--version}'[Sýna útgáfunúmer]'
    '(-h --help)'{-h,--help}'[Sýna hjálp fyrir skipun]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude skipanir' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Sýna hjálp fyrir skipun]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "engin viðfang"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Ræsa Claude Code MCP-þjón'
    'add:Bæta við MCP-þjóni við Claude Code'
    'remove:Fjarlægja MCP-þjón'
    'list:Sýna stillta MCP-þjóna'
    'get:Sækja MCP-þjóns upplýsingar'
    'add-json:Bæta við MCP-þjóni (stdio eða SSE) með JSON streng'
    'add-from-claude-desktop:Flytja inn MCP-þjóna frá Claude Desktop (aðeins Mac og WSL)'
    'reset-project-choices:Endurstilla alla samþykkta/hafnaða verkefnamiðaða (.mcp.json) þjóna í þessu verkefni'
    'login:Auðkenna við MCP-þjón (HTTP, SSE eða claude.ai tengil)'
    'logout:Hreinsa geymd OAuth auðkenni fyrir MCP-þjón'
    'help:Sýna hjálp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Sýna hjálp]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp skipanir' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Virkja kembiham]' \
            '--verbose[Hunsa ítarlegan ham frá stillingarskrá]' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Stillinga umfang (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Flutningsgerð (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Tilgreina umhverfisbreytu (t.d. -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Tilgreina WebSocket haus]:header:' \
            '--client-id[OAuth biðlaraauðkenni fyrir HTTP/SSE þjóna]:clientId:' \
            '--client-secret[Biðja um OAuth biðlaraleyndarmál (eða stilla MCP_CLIENT_SECRET umhverfisbreytu)]' \
            '--callback-port[Fast tengi fyrir OAuth svarkall (fyrir þjóna sem krefjast fyrirfram skráðra áframsendingar-URI)]:port:' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Stillinga umfang (local, user, project) - fjarlægja úr núverandi umfangi ef ótilgreint]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Sýna hjálp]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Stillinga umfang (local, user, project)]:scope:(local user project)' \
            '--client-secret[Biðja um OAuth biðlaraleyndarmál (eða stilla MCP_CLIENT_SECRET umhverfisbreytu)]' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Stillinga umfang (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Sýna hjálp]'
          ;;
        login)
          _arguments \
            '--no-browser[Prenta heimildar-URL í stað þess að opna vafra (fyrir SSH/skjálausar lotur)]' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Villuleita viðbót eða markaðstorgs lýsigögn'
    'marketplace:Stjórna Claude Code markaðstorgum'
    'list:Sýna uppsettar viðbætur'
    'details:Sýna íhlutaskrá og áætlaðan tákna kostnað fyrir viðbót'
    'configure:Sýna valkosti viðbótar og hverjir eru óstilltir, eða vista gildi frá stdin'
    'install:Setja upp viðbót úr tiltækum markaðstorgum'
    'i:Setja upp viðbót úr tiltækum markaðstorgum (stutt fyrir install)'
    'init:Beinagrind fyrir nýja viðbót (hleðst sjálfkrafa næstu lotu)'
    'new:Beinagrind fyrir nýja viðbót (samheiti fyrir init)'
    'uninstall:Fjarlægja uppsetta viðbót'
    'remove:Fjarlægja uppsetta viðbót (samheiti fyrir uninstall)'
    'enable:Virkja óvirka viðbót'
    'disable:Gera virka viðbót óvirka'
    'update:Uppfæra viðbót í nýjustu útgáfu'
    'eval:Keyra eval tilvik gegn viðbót og skila stigagefnum niðurstöðum'
    'prune:Fjarlægja sjálfvirkt uppsetta háða pakka sem er ekki lengur þörf á'
    'autoremove:Fjarlægja sjálfvirkt uppsetta háða pakka sem er ekki lengur þörf á (samheiti fyrir prune)'
    'tag:Búa til {name}--v{version} git merki fyrir viðbótarútgáfu'
    'test:Keyra prófanir mods'
    'help:Sýna hjálp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Sýna hjálp]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin skipanir' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Meðhöndla viðvaranir sem villur (útgangskóði 1)]' \
            '--json[Skila villuleitarskýrslunni sem JSON (sömu útgangskóðar)]' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Uppsetningar umfang]:scope:(user project local)' \
            '*--config[Stilla userConfig valkost sem er skilgreindur í lýsiskrá viðbótarinnar (má endurtaka)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Samþykkja birtu skipunina sem markaðstorgið skilgreinir án staðfestingarbeiðni]' \
            '--json[Prenta eina véllesanlega niðurstöðulínu í stað skilaboða fyrir menn]' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Uppsetningar umfang]:scope:(user project local)' \
            '--keep-data[Varðveita varanlega gagnamöppu viðbótarinnar]' \
            '--prune[Einnig fjarlægja sjálfvirkt uppsetta háða pakka sem er ekki lengur þörf á]' \
            '(-y --yes)'{-y,--yes}'[Sleppa --prune staðfestingarbeiðninni]' \
            '--json[Prenta eina véllesanlega niðurstöðulínu í stað skilaboða fyrir menn (ekki með --prune)]' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Uppsetningar umfang]:scope:(user project local)' \
            '--json[Prenta eina véllesanlega niðurstöðulínu í stað skilaboða fyrir menn]' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Gera allar virkar viðbætur óvirkar]' \
            '(-s --scope)'{-s,--scope}'[Uppsetningar umfang]:scope:(user project local)' \
            '--json[Prenta eina véllesanlega niðurstöðulínu í stað skilaboða fyrir menn]' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Uppsetningar umfang]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Samþykkja birtu skipunina sem markaðstorgið skilgreinir án staðfestingarbeiðni]' \
            '--json[Prenta eina véllesanlega niðurstöðulínu í stað skilaboða fyrir menn]' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Úttak sem JSON]' \
            '--available[Taka með tiltækar viðbætur úr markaðstorgum (krefst --json)]' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Hreinsa í umfangi]:scope:(user project local)' \
            '--dry-run[Sýna hvað yrði fjarlægt án þess að fjarlægja]' \
            '(-y --yes)'{-y,--yes}'[Sleppa staðfestingarbeiðninni]' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]'
          ;;
        configure)
          _arguments \
            '--json[Úttak sem JSON]' \
            '--values-stdin[Lesa valkostagildi frá stdin sem JSON hlut með einnar línu strengjum; valkostir sem sleppt er halda gildum sínum]' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Lýsing í lýsiskrá]:text:' \
            '--author[Nafn höfundar (sjálfgefið: git config user.name)]:name:' \
            '--author-email[Netfang höfundar (sjálfgefið: git config user.email)]:email:' \
            '--with[Íhlutir sem einnig á að búa til beinagrind fyrir]:components:' \
            '(-f --force)'{-f,--force}'[Skrifa yfir fyrirliggjandi .claude-plugin/ í markinu]' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Sía tilvik eftir nafnamynstri (glob)]:glob:' \
            '*--tag[Sía tilvik eftir merki (má endurtaka)]:tag:' \
            '--runs[Hnekkja fjölda keyrslna á hvert tilvik (sjálfgefið: case.runs, annars 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Keyra allt að n umboðsmannskeyrslur í einu (1-8; sjálfgefið 1)]:n:' \
            '--model[Hnekkja líkani fyrir öll tilvik]:model:_claude_model_names' \
            '--judge-model[Hnekkja líkani LLM-matsaðila (sjálfgefið: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Hart kostnaðarþak; hætta við og skila hlutaniðurstöðum ef því er náð (útgangskóði 2)]:usd:' \
            '--output-dir[Mappa fyrir aggregate-result.json]:dir:_directories' \
            '--eval-dir[Nafn möppu (undir viðbótinni) sem geymir eval tilvikin]:dir:' \
            '--json[Prenta alla keyrsluniðurstöðuna sem JSON á stdout, eða skrifa hana í þessa .json skrá]::path:_files' \
            '--threshold[Hætta með útgangskóða 1 ef stig einhvers tilviks eru undir þessum þröskuldi (sjálfgefið: 1.0)]:threshold:' \
            '*--allow-tools[Heimild rekstraraðila fyrir læst verkfæri (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Keyra scaffold_script hvers tilviks (keyrir bash frá höfundi í þínu nafni; óvirkt sjálfgefið)]' \
            '(--scaffold)--no-scaffold[Sleppa scaffold_script sérstaklega]' \
            '--trust-plugin[Staðfesta að þú treystir þessari viðbót og eval safni hennar, og sleppa traustbeiðni fyrstu keyrslu (fyrir CI)]' \
            '--ablation[Keyra viðmiðunarhóp án viðbótar og skila stigamuninum]:mode:(none with-without)' \
            '--mocks[Gervistaðgenglar fyrir MCP-þjóna, úr <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Með --mocks record: einnig ræsa raunverulegu MCP-þjónsferlin sem hafa engan gervistaðgengil]' \
            '--keep-temp[Varðveita beinagrindarmöppur til kembingar]' \
            '--verbose[Skrá rakningaratburði fyrir hver skilaboð í kembiloggið]' \
            '--report[Skrifa sjálfstæðu HTML skýrsluna á þessa slóð í stað niðurstöðumöppunnar]:path:_files' \
            '(--no-publish)--publish-report[Einnig krefjast þess að skýrslan sé birt á claude.ai]' \
            '(--publish-report)--no-publish[Halda HTML skýrslunni aðeins staðbundinni; sleppa því að birta hana á claude.ai]' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Ýta merkinu á --remote eftir að það er búið til]' \
            '--dry-run[Prenta hvað yrði merkt án þess að búa merkið til]' \
            '(-f --force)'{-f,--force}'[Sleppa athugunum á óhreinu vinnutré og hvort merkið sé þegar til]' \
            '(-m --message)'{-m,--message}'[Athugasemdaskilaboð merkis (nota %s fyrir útgáfuna)]:msg:' \
            '--remote[Fjargeymsla til að ýta á með --push]:name:' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Bæta við markaðstorgi frá URL, slóð eða GitHub geymslu'
    'list:Sýna stillt markaðstorg'
    'remove:Fjarlægja stillt markaðstorg'
    'rm:Fjarlægja stillt markaðstorg (samheiti fyrir remove)'
    'update:Uppfæra markaðstorg frá uppruna - uppfæra allt ef ekkert nafn er tilgreint'
    'help:Sýna hjálp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Sýna hjálp]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace skipanir' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Takmarka git checkout við tilteknar möppur með git sparse-checkout (fyrir monorepos)]:paths:' \
            '--scope[Hvar á að skilgreina markaðstorgið]:scope:(user project local)' \
            '--claudeai[Bæta við markaðstorginu með þessu nafni sem claude.ai hýsir fyrir þig]' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Úttak sem JSON]' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Fjarlægja skilgreiningu markaðstorgsins úr tilteknu stillinga umfangi (sleppa til að fjarlægja hana úr öllum umföngum)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Sýna hjálp]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Þvinga uppsetningu þótt þegar sé uppsett]' \
    '(-h --help)'{-h,--help}'[Sýna hjálp]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Viðbótar mappa til að leyfa verkfæra aðgang í útsendum lotum]:directory:_directories' \
    '--agent[Sjálfgefinn umboðsmaður fyrir lotur útsendar úr umboðsmannasýn]:agent:_claude_agent_names' \
    '--all[Með --json: einnig taka með kláraðar bakgrunnslotur]' \
    '--allow-dangerously-skip-permissions[Gera bypass-permissions ham tiltækan fyrir útsendar lotur]' \
    '--cwd[Sýna aðeins bakgrunnslotur sem hófust undir slóð]:path:_directories' \
    '--dangerously-skip-permissions[Samheiti fyrir --permission-mode bypassPermissions]' \
    '--effort[Sjálfgefið áreynslustig fyrir útsendar lotur]:level:(low medium high xhigh max)' \
    '--json[Prenta virkar lotur sem JSON fylki og hætta]' \
    '*--mcp-config[MCP-þjóns stilling til að beita á útsendar lotur]:config:' \
    '--model[Sjálfgefið líkan fyrir lotur útsendar úr umboðsmannasýn]:model:_claude_model_names' \
    '--permission-mode[Sjálfgefinn heimildarhamur fyrir útsendar lotur]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Hlaða viðbótum úr möppu fyrir umboðsmannasýn og útsendar lotur]:path:_directories' \
    '--setting-sources[Kommu aðskilinn listi yfir stillingarheimildir til að hlaða (user, project, local)]:sources:' \
    '--settings[Stillingaskrá eða JSON strengur til að beita]:file-or-json:_files' \
    '--strict-mcp-config[Nota aðeins MCP-þjóna frá --mcp-config í útsendum lotum]' \
    '--restricted[Ræsa útsendar lotur í takmörkuðum ham]' \
    '(-h --help)'{-h,--help}'[Sýna hjálp fyrir skipun]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Skrá inn á Anthropic reikninginn þinn'
    'logout:Skrá út af Anthropic reikningnum þínum'
    'status:Sýna auðkenningarstöðu'
    'help:Sýna hjálp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Sýna hjálp fyrir skipun]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth skipanir' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Forfylla netfang á innskráningarsíðunni]:email:' \
            '--sso[Þvinga SSO innskráningarferli]' \
            '(--claudeai)--console[Nota Anthropic Console (gjaldfærsla eftir API notkun) í stað Claude áskriftar]' \
            '(--console)--claudeai[Nota Claude áskrift (sjálfgefið)]' \
            '(-h --help)'{-h,--help}'[Sýna hjálp fyrir skipun]'
          ;;
        status)
          _arguments \
            '(--text)--json[Úttak sem JSON (sjálfgefið)]' \
            '(--json)--text[Úttak sem læsilegur texti]' \
            '(-h --help)'{-h,--help}'[Sýna hjálp fyrir skipun]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Sýna hjálp fyrir skipun]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Prenta virka auto mode stillingu sem JSON'
    'critique:Fá gervigreindarumsögn um sérsniðnu auto mode reglurnar þínar'
    'defaults:Prenta sjálfgefnar auto mode reglur sem JSON'
    'reset:Endurstilla auto mode stillingu í uppgefnar sjálfgefnar'
    'help:Sýna hjálp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Sýna hjálp fyrir skipun]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode skipanir' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Hnekkja hvaða líkan er notað]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Sýna hjálp fyrir skipun]'
          ;;
        defaults)
          _arguments \
            '--label[Sýna aðeins reglur þar sem merkimiðinn byrjar á þessu forskeyti (óháð há- og lágstöfum)]:prefix:' \
            '(-h --help)'{-h,--help}'[Sýna hjálp fyrir skipun]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Sleppa staðfestingarbeiðninni]' \
            '(-h --help)'{-h,--help}'[Sýna hjálp fyrir skipun]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Sýna hjálp fyrir skipun]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Slóð að gátt YAML stillingu]:path:_files' \
    '(-h --help)'{-h,--help}'[Sýna hjálp fyrir skipun]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Eyða allri Claude Code stöðu fyrir verkefni (afrit, verkefni, skráarsaga, stillingarfærsla)'
    'help:Sýna hjálp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Sýna hjálp fyrir skipun]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project skipanir' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Sýna hvað yrði eytt án þess að eyða neinu]' \
            '(-y --yes)'{-y,--yes}'[Sleppa staðfestingarbeiðninni]' \
            '(-i --interactive)'{-i,--interactive}'[Spyrja um hvert atriði áður en því er eytt]' \
            '(1)--all[Eyða stöðu fyrir öll verkefni (útilokar slóð)]' \
            '(-h --help)'{-h,--help}'[Sýna hjálp fyrir skipun]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Prenta hráa bugs.json gögnin í stað sniðinna niðurstaðna]' \
    '--timeout[Hámarks mínútur til að bíða eftir að rýnin ljúki (sjálfgefið: 45)]:minutes:' \
    '(--no-post)--post[Birta niðurstöður lokinnar rýni á PR í þínu nafni (aðeins þegar rýnt er í PR; ein venjuleg athugasemd, ekki rýni)]' \
    '(--post)--no-post[Ekki birta niðurstöðurnar á PR (sjálfgefið)]' \
    '(-h --help)'{-h,--help}'[Sýna hjálp fyrir skipun]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Endurræsa allar bakgrunnslotur í keyrslu]' \
    '(-h --help)'{-h,--help}'[Sýna hjálp fyrir skipun]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Einnig henda óýttum commits og óskráðum breytingum worktree (gefa upp commit@worktree-id sem fyrri claude rm tilkynnti)]:commit@worktree-id:' \
    '--force-remove-worktree[Eyða worktree möppunni þótt WorktreeRemove hook eða git hafi ekki getað fjarlægt hana (gefa upp worktree-id sem fyrri claude rm tilkynnti)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Sýna hjálp fyrir skipun]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Sýna hvað yrði flutt inn án þess að skrifa neitt]' \
    '--yes[Sleppa gagnvirka valinu (á skjálausum yfirborðum, gefa upp --yes=<digest> úr /import forskoðuninni)]' \
    '(-h --help)'{-h,--help}'[Sýna hjálp fyrir skipun]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
