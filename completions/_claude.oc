#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Configurar e gerir los servidors MCP'
    'plugin:Gerir los plugins Claude Code'
    'agents:Gerir los agents en rèireplan'
    'attach:Dobrir una session en rèireplan dins aqueste terminal'
    'logs:Afichar la sortida recenta del terminal d'\''una session en rèireplan'
    'stop:Arrestar una session en rèireplan (sa conversacion es conservada)'
    'respawn:Reaviar una session en rèireplan per que execute la version actuala de Claude Code'
    'rm:Suprimir una session en rèireplan, e son worktree quand es segur de o far'
    'remote-control:Pilotar las sessions localas dempuèi claude.ai/code o l’aplicacion mobila Claude'
    'daemon:Gerir lo supervisor de las sessions en rèireplan'
    'auth:Gerir l'\''autenticacion'
    'auto-mode:Inspectar o reïnicializar la configuracion del classificador del mòde automatic'
    'gateway:Executar la palanca d'\''autenticacion/telemetria d'\''entrepresa'
    'self-hosted-runner:Albergar de sessions nívol de Claude Code sus aquesta maquina o aqueste contenidor'
    'import:Importar la configuracion d'\''un autre agent de programacion IA dins Claude Code'
    'project:Gerir l'\''estat del projècte Claude Code'
    'purge:Suprimir tot l'\''estat Claude Code per un projècte (transcripcions, prètzfaches, istoric dels fichièrs, entrada de configuracion)'
    'ultrareview:Executar una revision de còde multi-agent albergada dins lo nívol e afichar los resultats'
    'setup-token:Configurar lo geton d'\''autenticacion a long tèrme (necessita abonament Claude)'
    'doctor:Verificacion de santat per l'\''actualizador automatic de Claude Code'
    'update:Verificar e installar las actualizacions'
    'install:Installar la compilacion nativa de Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Activar lo mòde de desbugatge amb filtratge opcional per categoria (ex: "api,hooks" o "!statsig,!file")]:filter:'
    '--verbose[Remplaçar lo paramètre de mòde detalhats del fichièr de configuracion]'
    '(-p --print)'{-p,--print}'[Imprimir la responsa e quitar (per utilizacion amb de pipes). Nòta: utilizar solament dins de directoris de confisança]'
    '--output-format[Format de sortida (amb --print): "text" (per defaut), "json" (resultat unic), o "stream-json" (difusion en temps real)]:format:(text json stream-json)'
    '--json-schema[Esquèma JSON per validacion de sortida estructurada]:schema:'
    '--include-partial-messages[Inclure los fragments de messatges parcials al fum e a mesura qu'\''arriban (amb --print e --output-format=stream-json)]'
    '--input-format[Format d'\''entrada (amb --print): "text" (per defaut) o "stream-json" (entrada en difusion temps real)]:format:(text stream-json)'
    '--dangerously-skip-permissions[Passar totas las verificacions de permissions. Recomandat solament per los sandboxes sens accès a Internet]'
    '--allow-dangerously-skip-permissions[Activar l'\''opcion de passar las verificacions de permissions sens l'\''activar per defaut]'
    '--restricted[Mòde restrench: levar las aisinas qu'\''executan de comandas o de còde e WebFetch, ignorar los paramètres user/project/local, e limitar las aisinas de fichièr als directoris de trabalh]'
    '--max-budget-usd[Montant maximal en dolars de despensar per las apèls API (--print solament)]:amount:'
    '--max-turns[Limitar lo nombre de torns agentics (--print solament)]:turns:'
    '--replay-user-messages[Remandar los messatges utilizaire dempuèi stdin vèrs stdout per confirmacion]'
    '--allowed-tools[Lista separada per virgulas o espacis de noms d'\''aisinas autorizadas (ex: "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Lista separada per virgulas o espacis de noms d'\''aisinas autorizadas (format camelCase)]:tools:'
    '--tools[Especificar la lista de las aisinas disponiblas de l'\''ensemble integrat. Mòde d'\''impression solament]:tools:'
    '--disallowed-tools[Lista separada per virgulas o espacis de noms d'\''aisinas pas autorizadas (ex: "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Lista separada per virgulas o espacis de noms d'\''aisinas pas autorizadas (format camelCase)]:tools:'
    '--mcp-config[Cargar los servidors MCP dempuèi un fichièr JSON o una cadena (separats per espacis)]:configs:'
    '--system-prompt[Invitacion sistèma d'\''utilizar per la session]:prompt:'
    '--system-prompt-file[Legir l'\''invitacion sistèma dempuèi un fichièr]:file:_files'
    '--append-system-prompt[Apondre una invitacion sistèma a l'\''invitacion sistèma per defaut]:prompt:'
    '--append-system-prompt-file[Legir l'\''invitacion sistèma dempuèi un fichièr e l'\''apondre a l'\''invitacion sistèma per defaut]:file:_files'
    '(--append-subagent-system-prompt-file)--append-subagent-system-prompt[Apondre de tèxte al prompt sistèma de cada sosagent (--print solament)]:prompt:'
    '(--append-subagent-system-prompt)--append-subagent-system-prompt-file[Legir de tèxte dins un fichièr e l’apondre als prompts sistèma dels sosagents (--print solament)]:file:_files'
    '--system-prompt-snapshot[Enregistrar l'\''invitacion sistèma un còp per conversacion e la reutilizar tala quala a cada requèsta e represa (on, per defaut) o la tornar generar a cada requèsta (off)]:mode:(on off)'
    '--permission-mode[Mòde de permissions d'\''utilizar per la session]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Qual respond a las demandas de permission amb --print: "host" (l'\''òste SDK o --permission-prompt-tool) o "none" (tot çò que demandariá una permission es refusat)]:target:(host none)'
    '--permission-prompt-tool[Aisina MCP d'\''utilizar per las demandas de permission (--print solament)]:tool:'
    '(-c --continue)'{-c,--continue}'[Contunhar la conversacion mai recenta]'
    '(-r --resume)'{-r,--resume}'[Reprendre una conversacion - especificar l'\''ID de session o seleccionar interactivament]:sessionId:_claude_sessions'
    '--fork-session[Crear un novèl ID de session al luòc de reutilizar l'\''ID de session d'\''origina en reprenant (amb --resume o --continue)]'
    '--no-session-persistence[Desactivar la persisténcia de session - las sessions seràn pas salvadas (--print solament)]'
    '--model[Modèl per la session actuala. Especificar un alias pel modèl mai recent (ex: '\''sonnet'\'' o '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agent per la session actuala. Remplaça lo paramètre '\''agent'\'']:agent:_claude_agent_names'
    '--betas[Entèstas beta d'\''inclure dins las requèstas API (utilizaires de clau API solament)]:betas:'
    '--fallback-model[Activar lo basculament automatic vèrs lo modèl especificat quand lo modèl per defaut es sobrecarregat (--print solament)]:model:_claude_model_names'
    '--settings[Camin vèrs un fichièr JSON de paramètres o una cadena JSON per cargar de paramètres suplementaris]:file-or-json:_files'
    '--add-dir[Directoris suplementaris per autorizar l'\''accès a las aisinas]:directories:_directories'
    '--ide[Connexion automatica a l'\''EDI al demarratge se exactament un EDI valid es disponible]'
    '--desktop[Dobrir dins l'\''aplicacion Claude Desktop al luòc del terminal (amb --continue o --resume <id> per causir la session)]'
    '--strict-mcp-config[Utilizar solament los servidors MCP de --mcp-config e ignorar totes los autres paramètres MCP]'
    '--session-id[ID de session especific d'\''utilizar per la conversacion (deu èsser un UUID valid)]:uuid:'
    '--agents[Objècte JSON que definís d'\''agents personalizats]:json:'
    '--advisor[Activar l’aisina conselhièra costat servidor per aquesta session amb un alias de modèl o un ID de modèl complet]:model:_claude_model_names'
    '--teammate-mode[Cossí s’afichan los companhs d’una equipa d’agents]:mode:(in-process auto tmux iterm2)'
    '--setting-sources[Lista separada per virgulas de fonts de paramètres de cargar (user, project, local)]:sources:'
    '--plugin-dir[Directòri per cargar los plugins solament per aquesta session (repetible)]:paths:_directories'
    '--disable-slash-commands[Desactivar totas las comandas amb barra oblica]'
    '(--bg --background)'{--bg,--background}'[Aviar la session coma un agent en rèireplan e tornar immediatament]'
    '(-w --worktree)'{-w,--worktree}'[Crear un novèl worktree git per aquesta session (opcionalament especificar un nom)]::name:'
    '--tmux=-[Crear una session tmux pel worktree (necessita --worktree). Utiliza los panèls natius d'\''iTerm2 quand son disponibles; --tmux=classic per tmux tradicional]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Definir un nom d'\''afichatge per aquesta session]:name:'
    '--effort[Nivèl d'\''esfòrç per la session actuala]:level:(low medium high xhigh max)'
    '--autocompact[Talha de la fenèstra de compactatge automatic (auto, o de 100k a 1M getons)]:size:(auto)'
    '--debug-file[Escriure los jornals de desbugatge dins un camin de fichièr especific (activa implicitament lo mòde de desbugatge)]:path:_files'
    '--from-pr[Reprendre una session ligada a una PR per numèro/URL, o dobrir lo selector interactiu]::value:'
    '--teleport[Reprendre una session teleport, opcionalament especificar l'\''ID de session]::session:'
    '(--remote)--cloud[Crear una session dins lo nívol amb la descripcion donada, o s'\''estacar a una session existenta per ID de session o URL claude.ai/code]::description-or-session:'
    '(--cloud)--remote[Alias obsolet per --cloud]::description-or-session:'
    '--environment[Crear una novèla session dins lo nívol que s'\''executa sus l'\''environament auto-albergat indicat (ccpool_...)]:environment_id:'
    '--ref[Amb --environment: basar lo checkout de la session novèla sus una ref nomenada allòc del HEAD local]:branch:'
    '(--remote-control --rc)'{--remote-control,--rc}'[Aviar una session interactiva amb Remote Control activat (opcionalament nomenada)]::name:'
    '--remote-control-session-name-prefix[Prefix pels noms de session Remote Control generats automaticament]:prefix:'
    '--chrome[Activar l'\''integracion Claude dins Chrome]'
    '--no-chrome[Desactivar l'\''integracion Claude dins Chrome]'
    '--plugin-url[Recuperar un .zip de plugin dempuèi una URL solament per aquesta session (repetible)]:url:'
    '--file[Ressorsas de fichièr de telecargar al demarratge (format: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Activar las suggestions d'\''invitacion (emet una invitacion seguenta predita en mòde print/SDK)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Transferir lo tèxte e los blòts de reflexion del sosagent coma messatges (amb --print e stream-json)]'
    '--include-hook-events[Inclure totes los eveniments del cicle de vida dels hooks dins lo fum de sortida (amb stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Desplaçar las seccions per maquina dins lo primièr messatge utilizaire per melhorar la reütilizacion del cache d'\''invitacion]'
    '--brief[Activar l'\''aisina SendUserMessage per la comunicacion agent-vèrs-utilizaire]'
    '*--channels[(Apercebut de recèrca) Servidors MCP que cal escotar lors notificacions de canal (plugin\:<name>@<marketplace>)]:entries:'
    '*--dangerously-load-development-channels[Activar de canals que son pas sus la lista d’autorizacion aprovada, pel desvolopament local (plugin\:<name>@<marketplace> o server\:<name>)]:entries:'
    '--init[Executar los hooks Setup amb lo matcher init abans la session (--print solament)]'
    '--init-only[Executar los hooks Setup e SessionStart, puèi sortir sens començar de conversacion]'
    '--maintenance[Executar los hooks Setup amb lo matcher maintenance abans la session (--print solament)]'
    '--safe-mode[Aviar amb totas las personalizacions desactivadas (util per depanar una configuracion copada)]'
    '--bare[Mòde minimal: ignorar los hooks, LSP, sincronizacion dels plugins, atribucion, auto-memòria e auto-descobèrta de CLAUDE.md]'
    '--ax-screen-reader[Afichar una sortida adaptada als lectors d'\''ecran (tèxte plan, sens bordaduras decorativas ni animacions)]'
    '(-v --version)'{-v,--version}'[Afichar lo numèro de version]'
    '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]'
  )

  # Stop at the first non-option word, so that the options after a command reach
  # that command's own specs instead of being consumed here
  _arguments -C -A '-*' \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandas claude' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin|plugins)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        remote-control|rc|remote|sync|bridge)
          _claude_remote_control
          ;;
        daemon)
          _claude_daemon
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        self-hosted-runner)
          _claude_self_hosted_runner
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        purge)
          _claude_purge
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update|upgrade)
          _arguments \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]'
          ;;
        *)
          # Not a command but the prompt: options may still follow it
          _arguments \
            $main_options \
            '*: :'
          ;;
      esac
      ;;
  esac
  local ret=$?

  # The last step, such as listing commands for --r, can fail although options
  # were added before it. Report success then: on failure zsh moves on to the
  # next completers, and _correct or _approximate pile on corrections
  (( compstate[nmatches] > 0 )) || return $ret
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Aviar un servidor MCP Claude Code'
    'add:Apondre un servidor MCP a Claude Code'
    'remove:Suprimir un servidor MCP'
    'list:Listar los servidors MCP configurats'
    'get:Obténer los detalhs del servidor MCP'
    'add-json:Apondre un servidor MCP (stdio o SSE) amb una cadena JSON'
    'add-from-claude-desktop:Importar los servidors MCP dempuèi Claude Desktop (Mac e WSL solament)'
    'reset-project-choices:Reïnicializar totes los servidors de portada de projècte (.mcp.json) aprovats/refusats dins aqueste projècte'
    'login:S'\''autenticar amb un servidor MCP (HTTP, SSE, o connector claude.ai)'
    'logout:Escafar los identificants OAuth emmagazinats per un servidor MCP'
    'help:Afichar l'\''ajuda'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandas mcp' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Activar lo mòde de desbugatge]' \
            '--verbose[Remplaçar lo paramètre de mòde detalhats del fichièr de configuracion]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Portada de configuracion (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Tipe de transpòrt (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Definir una variabla d'\''environament (ex: -e CLAU=valor)]:env:' \
            '(-H --header)'{-H,--header}'[Definir un entèsta WebSocket]:header:' \
            '--client-id[ID de client OAuth pels servidors HTTP/SSE]:clientId:' \
            '--client-secret[Demandar lo secret de client OAuth (o definir la variabla d'\''environament MCP_CLIENT_SECRET)]' \
            '--callback-port[Pòrt fixe pel rapèl OAuth (pels servidors que necessitan d'\''URI de redireccion pre-enregistradas)]:port:' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Portada de configuracion (local, user, project) - suprimir de la portada existenta se pas especificat]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Portada de configuracion (local, user, project)]:scope:(local user project)' \
            '--client-secret[Demandar lo secret de client OAuth (o definir la variabla d'\''environament MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Portada de configuracion (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]'
          ;;
        login)
          _arguments \
            '--no-browser[Afichar l'\''URL d'\''autorizacion al luòc de dobrir un navegador (per las sessions SSH/sens interfàcia)]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Validar un plugin o un manifèst de mercat'
    'marketplace:Gerir los mercats Claude Code'
    'list:Listar los plugins installats'
    'details:Afichar l'\''inventari dels components e lo còst estimat en gettons per un plugin'
    'configure:Afichar las opcions d'\''un plugin e las que son pas definidas, o salvar de valors dempuèi stdin'
    'install:Installar un plugin dempuèi los mercats disponibles'
    'i:Installar un plugin dempuèi los mercats disponibles (forma corta d'\''install)'
    'init:Bastir un novèl plugin (se carga automaticament a la session seguenta)'
    'new:Bastir un novèl plugin (alias per init)'
    'uninstall:Desinstallar un plugin installat'
    'remove:Desinstallar un plugin installat (alias per uninstall)'
    'enable:Activar un plugin desactivat'
    'disable:Desactivar un plugin activat'
    'update:Actualizar un plugin a la version mai recenta'
    'eval:Executar de cases d'\''avaloracion contra un plugin e reportar los resultats notats'
    'prune:Suprimir las dependéncias installadas automaticament que son pas mai necessàrias'
    'autoremove:Suprimir las dependéncias installadas automaticament que son pas mai necessàrias (alias per prune)'
    'tag:Crear una etiqueta git {name}--v{version} per una publicacion de plugin'
    'test:Executar los tèsts d'\''un mod'
    'help:Afichar l'\''ajuda'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandas de plugin' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Tractar los avertiments coma d'\''errors (còdi de sortida 1)]' \
            '--profile[Sortir tanben amb exit 1 quand lo catalòg nomenat refusariá una somission del plugin sus una verificacion qu’aquesta comanda executa]:name:(directory)' \
            '--json[Afichar lo rapòrt de validacion en JSON (meteisses còdis de sortida)]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Portada d'\''installacion]:scope:(user project local)' \
            '--accept-command[Acceptar la comanda declarada pel mercat que son sha256 foguèt senhalat per una execucion --json precedenta coma shownCommand.sha256]:sha256:' \
            '*--config[Definir una opcion userConfig declarada dins lo manifèst del plugin (repetible)]:key=value:' \
            '--marketplace[Installar lo plugin per son nom simple dempuèi lo mercat a aquesta font (owner/repo, URL git o https, o camin), en apondent lo mercat d’en primièr se cal]:source:' \
            '--registry[Per una installacion package@npm: resòlvre e telecargar dempuèi aqueste registre npm]:url:' \
            '(-y --yes)'{-y,--yes}'[Acceptar la comanda afichada declarada pel mercat sens la demanda de confirmacion]' \
            '--json[Afichar una linha de resultat legibla per maquina al luòc del messatge uman]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Portada d'\''installacion]:scope:(user project local)' \
            '--keep-data[Conservar lo directòri de donadas persistentas del plugin]' \
            '--prune[Suprimir tanben las dependéncias installadas automaticament que son pas mai necessàrias]' \
            '(-y --yes)'{-y,--yes}'[Passar la demanda de confirmacion de --prune]' \
            '--json[Afichar una linha de resultat legibla per maquina al luòc del messatge uman (pas amb --prune)]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Portada d'\''installacion]:scope:(user project local)' \
            '--json[Afichar una linha de resultat legibla per maquina al luòc del messatge uman]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Desactivar totes los plugins activats]' \
            '(-s --scope)'{-s,--scope}'[Portada d'\''installacion]:scope:(user project local)' \
            '--json[Afichar una linha de resultat legibla per maquina al luòc del messatge uman]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '--accept-command[Acceptar la comanda declarada pel mercat que son sha256 foguèt senhalat per una execucion --json precedenta coma shownCommand.sha256]:sha256:' \
            '(-s --scope)'{-s,--scope}'[Portada d'\''installacion]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Acceptar la comanda afichada declarada pel mercat sens la demanda de confirmacion]' \
            '--json[Afichar una linha de resultat legibla per maquina al luòc del messatge uman]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Sortida en JSON]' \
            '--available[Inclure los plugins disponibles dels mercats (necessita --json)]' \
            '--data-size[Mesurar lo directòri de donadas salvadas de cada plugin installat, o solament del plugin nomenat (necessita --json)]::plugin:_claude_installed_plugins' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Netejar a la portada]:scope:(user project local)' \
            '--dry-run[Listar çò que seriá suprimit sens suprimir]' \
            '(-y --yes)'{-y,--yes}'[Passar la demanda de confirmacion]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]'
          ;;
        configure)
          _arguments \
            '--json[Sortida en JSON]' \
            '--values-stdin[Legir las valors de las opcions dempuèi stdin coma un objècte JSON de cadenas d'\''una sola linha; las opcions omesas gardan lors valors]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Descripcion del manifèst]:text:' \
            '--author[Nom de l'\''autor (per defaut: git config user.name)]:name:' \
            '--author-email[Adreça electronica de l'\''autor (per defaut: git config user.email)]:email:' \
            '--with[Components de bastir tanben]:components:' \
            '(-f --force)'{-f,--force}'[Remplaçar un .claude-plugin/ existent a la cibla]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '1:name:'
          ;;
        eval)
          if [[ $words[2] == init ]]; then
            _arguments \
              '--bare[Escriure un modèl void allòc d’executar l’entrevista]' \
              '--eval-dir[Directòri jos lo directòri actual ont escriure los cases]:dir:_directories' \
              '(-i --interactive)'{-i,--interactive}'[Executar l’entrevista de redaccion (necessita un terminal interactiu)]' \
              '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
              '::name:'
            return
          fi
          _arguments \
            '--case[Filtrar los cases per motiu glob de nom]:glob:' \
            '*--tag[Filtrar los cases per etiqueta (repetible)]:tag:' \
            '--runs[Remplaçar lo nombre d'\''execucions per cas (per defaut: case.runs, siquenon 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Executar fins a n execucions d'\''agent a l'\''encòp (1-8; per defaut 1)]:n:' \
            '--model[Remplaçar lo modèl per totes los cases]:model:_claude_model_names' \
            '--judge-model[Remplaçar lo modèl LLM avaluador (per defaut: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Plafon de còst estricte; abandonar e reportar los resultats parcials se es atench (còdi de sortida 2)]:usd:' \
            '--output-dir[Directòri per aggregate-result.json]:dir:_directories' \
            '--eval-dir[Nom del directòri (jos lo plugin) que conten los cases d'\''avaloracion]:dir:' \
            '--json[Afichar lo resultat complet de l'\''execucion en JSON sus stdout, o l'\''escriure dins aqueste fichièr .json]::path:_files' \
            '--threshold[Quitar amb lo còdi de sortida 1 se la nòta d'\''un cas es jos aqueste lindal (per defaut: 1.0)]:threshold:' \
            '*--allow-tools[Autorizacion de l'\''operador per las aisinas restrenchas (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '*--disallow-tools[Aisinas integradas de téner luènh de Claude dins totes los cases, quitament se son autorizadas]:tools:' \
            '(--no-scaffold)--scaffold[Executar lo scaffold_script de cada cas (executa de bash provesit per l'\''autor en vòstre nom; desactivat per defaut)]' \
            '(--scaffold)--no-scaffold[Passar explicitament scaffold_script]' \
            '--trust-plugin[Afirmar que vos fisatz d'\''aqueste plugin e de sa seria d'\''avaloracion, en passant la demanda de confisança de la primièra execucion (per la CI)]' \
            '--ablation[Executar un grop de comparason de referéncia sens plugin e reportar l'\''escart de nòta]:mode:(none with-without)' \
            '--mocks[Simulacions en remplaçament dels servidors MCP, dempuèi <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Amb --mocks record: aviar tanben los processus de servidor MCP reals qu'\''an pas de simulacion]' \
            '--keep-temp[Conservar los directoris de bastiment per desbugatge]' \
            '--verbose[Enregistrar los eveniments de traça per messatge dins lo jornal de desbugatge]' \
            '--report[Escriure lo rapòrt HTML autonòm dins aqueste camin al luòc del directòri de resultats]:path:_files' \
            '(--no-publish)--publish-report[Exigir tanben la publicacion del rapòrt sus claude.ai]' \
            '(--publish-report)--no-publish[Gardar lo rapòrt HTML solament en local; passar sa publicacion sus claude.ai]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '::target: _alternative "commands\:eval command\:(init)" "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Mandar l'\''etiqueta vèrs --remote aprèp l'\''aver creada]' \
            '--dry-run[Afichar çò que seriá etiquetat sens crear l'\''etiqueta]' \
            '(-f --force)'{-f,--force}'[Passar las verificacions d'\''arbre de trabalh modificat e d'\''etiqueta ja existenta]' \
            '(-m --message)'{-m,--message}'[Messatge d'\''anotacion de l'\''etiqueta (utilizar %s per la version)]:msg:' \
            '--remote[Depaus distant ont mandar amb --push]:name:' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Apondre un mercat dempuèi una URL, un camin o un depaus GitHub'
    'list:Listar los mercats configurats'
    'remove:Suprimir un mercat configurat'
    'rm:Suprimir un mercat configurat (alias per remove)'
    'update:Actualizar lo mercat dempuèi la font - actualizar totes se cap de nom especificat'
    'help:Afichar l'\''ajuda'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandas de mercat' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Limitar l'\''extraccion a de directoris especifics via git sparse-checkout (pels monodepauses)]:paths:' \
            '--scope[Ont declarar lo mercat]:scope:(user project local)' \
            '--json[Afichar una linha de resultat legibla per maquina coma darrièra linha sus stdout]' \
            '--claudeai[Apondre lo mercat d'\''aqueste nom que claude.ai alberga per vos]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Sortida en JSON]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Suprimir la declaracion del mercat d'\''una portada de paramètres especifica (ometre per la suprimir de totas las portadas)]:scope:(user project local)' \
            '--json[Afichar una linha de resultat legibla per maquina coma darrièra linha sus stdout]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '--json[Amb un nom de mercat: afichar una linha de resultat legibla per maquina coma darrièra linha sus stdout]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Forçar l'\''installacion memben se ja installat]' \
    '(-h --help)'{-h,--help}'[Afichar l'\''ajuda]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Directòri suplementari per autorizar l'\''accès a las aisinas dins las sessions despachadas]:directory:_directories' \
    '--agent[Agent per defaut per las sessions despachadas dempuèi la vista d'\''agent]:agent:_claude_agent_names' \
    '--all[Amb --json: inclure tanben las sessions en rèireplan acabadas]' \
    '--allow-dangerously-skip-permissions[Rendre lo mòde bypass-permissions disponible per las sessions despachadas]' \
    '--cwd[Afichar solament las sessions en rèireplan aviadas jos lo camin]:path:_directories' \
    '--dangerously-skip-permissions[Alias per --permission-mode bypassPermissions]' \
    '--effort[Nivèl d'\''esfòrç per defaut per las sessions despachadas]:level:(low medium high xhigh max)' \
    '--json[Afichar las sessions activas coma un tablèu JSON e quitar]' \
    '*--mcp-config[Configuracion del servidor MCP d'\''aplicar a las sessions despachadas]:config:' \
    '--model[Modèl per defaut per las sessions despachadas dempuèi la vista d'\''agent]:model:_claude_model_names' \
    '--permission-mode[Mòde de permissions per defaut per las sessions despachadas]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Cargar los plugins dempuèi un directòri per la vista d'\''agent e las sessions despachadas]:path:_directories' \
    '--setting-sources[Lista separada per virgulas de fonts de paramètres de cargar (user, project, local)]:sources:' \
    '--settings[Fichièr de paramètres o cadena JSON d'\''aplicar]:file-or-json:_files' \
    '--strict-mcp-config[Utilizar solament los servidors MCP de --mcp-config dins las sessions despachadas]' \
    '--restricted[Aviar las sessions despachadas en mòde restrench]' \
    '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Se connectar a vòstre compte Anthropic'
    'logout:Se desconnectar de vòstre compte Anthropic'
    'status:Afichar l'\''estat de l'\''autenticacion'
    'help:Afichar l'\''ajuda'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandas auth' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Pre-emplenar l'\''adreça electronica sus la pagina de connexion]:email:' \
            '--sso[Forçar lo processus de connexion SSO]' \
            '(--claudeai)--console[Utilizar Anthropic Console (facturacion a l'\''utilizacion de l'\''API) al luòc de l'\''abonament Claude]' \
            '(--console)--claudeai[Utilizar l'\''abonament Claude (per defaut)]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]'
          ;;
        status)
          _arguments \
            '(--text)--json[Sortida en JSON (per defaut)]' \
            '(--json)--text[Sortida en tèxte legible per un uman]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Afichar la configuracion efectiva del mòde automatic en JSON'
    'critique:Obténer un retorn de l'\''IA sus vòstras règlas de mòde automatic personalizadas'
    'defaults:Afichar las règlas per defaut del mòde automatic en JSON'
    'reset:Reïnicializar la configuracion del mòde automatic als valors per defaut liuratas'
    'help:Afichar l'\''ajuda'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandas auto-mode' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Remplaçar lo modèl utilizat]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]'
          ;;
        defaults)
          _arguments \
            '--label[Afichar solament las règlas que lor etiqueta comença per aqueste prefix (sens distinccion de majusculas)]:prefix:' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Passar la demanda de confirmacion]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Camin vèrs la configuracion YAML de la palanca]:path:_files' \
    '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Suprimir tot l'\''estat Claude Code per un projècte (transcripcions, prètzfaches, istoric dels fichièrs, entrada de configuracion)'
    'help:Afichar l'\''ajuda'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandas project' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Listar çò que seriá suprimit sens res suprimir]' \
            '(-y --yes)'{-y,--yes}'[Passar la demanda de confirmacion]' \
            '(-i --interactive)'{-i,--interactive}'[Demandar confirmacion per cada element abans de suprimir]' \
            '(1)--all[Purgar l'\''estat de totes los projèctes (mutualament exclusiu amb un camin)]' \
            '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_purge() {
  _arguments \
    '--dry-run[Listar çò que seriá suprimit sens res suprimir]' \
    '(-y --yes)'{-y,--yes}'[Passar la demanda de confirmacion]' \
    '(-i --interactive)'{-i,--interactive}'[Demandar confirmacion per cada element abans de suprimir]' \
    '(1)--all[Purgar l'\''estat de totes los projèctes (mutualament exclusiu amb un camin)]' \
    '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]' \
    '(--all)::path:_directories'
}

_claude_ultrareview() {
  _arguments \
    '--json[Afichar la carga bugs.json bruta al luòc dels resultats formatats]' \
    '--timeout[Nombre maximal de minutas d'\''esperar que la revision s'\''acabe (per defaut: 45)]:minutes:' \
    '(--no-post)--post[Publicar las constatacions de la revision acabada sus la PR en vòstre nom (ciblas PR solament; un comentari simple, pas una revision)]' \
    '(--post)--no-post[Publicar pas las constatacions sus la PR (per defaut)]' \
    '--trust-workspace[Se fisar del dorsièr actual solament per aquesta execucion, sens demandar (per los scripts e la CI)]' \
    '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Reaviar totas las sessions en rèireplan en cors d'\''execucion]' \
    '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Abandonar tanben los commits pas mandats e las modificacions pas validadas del worktree (passar lo commit@worktree-id qu'\''un claude rm precedent a senhalat)]:commit@worktree-id:' \
    '--force-remove-worktree[Suprimir lo directòri del worktree memes se lo hook WorktreeRemove o git l'\''an pas pogut suprimir (passar lo worktree-id qu'\''un claude rm precedent a senhalat)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]' \
    '1:session:_claude_background_sessions'
}

_claude_self_hosted_runner() {
  _arguments \
    '--api-url[URL de basa de l’API (per defaut: https://api.anthropic.com)]:url:' \
    '--environment-secret-file[Camin vèrs lo fichièr secret de l’environament]:path:_files' \
    '--lock-to-account[Varrolhar lo runner sus un compte unic a l’enregistrament]:id:' \
    '--client-label[Etiqueta d’observabilitat mandada a l’enregistrament (per defaut: hostname)]:label:' \
    '(--proxy-authorization-file --agent-proxy-url)--proxy-authorization-command[Comanda que son stdout es l’entèsta Proxy-Authorization pels proxys de sortida]:shell command:' \
    '(--proxy-authorization-command --agent-proxy-url)--proxy-authorization-file[Fichièr que conten l’entèsta Proxy-Authorization pels proxys de sortida]:path:_files' \
    '(--proxy-authorization-command --proxy-authorization-file)--agent-proxy-url[Far passar cada session pel proxy d’agent a aquesta URL (https solament)]:url:' \
    '--capacity[Sessions simultanèas maximalas (per defaut: 1)]:n:' \
    '--base-dir[Directòri de basa pels checkouts de depaus (per defaut: /workspace)]:path:_directories' \
    '--exec-path[Binari d’aviar per las sessions enfant (per defaut: aqueste binari)]:path:_files' \
    '--hooks-dir[Directòri dels scripts de hook de cicle de vida (checkout, command, post-session)]:path:_directories' \
    '--session-stop-grace-sec[Temps d’espèra d’una sortida neta aprèp la fin d’una session (per defaut: 5)]:n:' \
    '--post-session-hook-timeout-sec[Budget SIGTERM pel hook post-session (per defaut: 60)]:n:' \
    '--checkout-hook-timeout-min[Budget de temps real per cada execucion del hook checkout (per defaut: 30; 0 desactiva)]:n:' \
    '--drain-wait-sec[Sus SIGTERM/SIGINT, esperar fins a N segondas lo trabalh en cors (per defaut: 0)]:n:' \
    '--drain-marker-file[Fichièr marcador amb lo qual l’òste anóncia un voidatge gracios (graceful drain)]:path:_files' \
    '*--git-ssh-rewrite[Reescriure las URL de font https://<host>/... en git@<host>:... (repetible)]:host:' \
    '*--git-host-rewrite[Reescriure las URL de font https://<f>/... en https://<t>/... (repetible)]:from=to:' \
    '--use-anthropic-git-proxy[Utilizar lo git gerit per Anthropic. AVERTIMENT: suprimís e remplaça la configuracion git al nivèl HOME, utilizar solament jos un compte dedicat]' \
    '--configure-git[Definir l’identitat git globala e activar la signatura dels commits via lo servici de signatura d’Anthropic. Escriu ~/.gitconfig]' \
    '--push-outcome-on-release[Pujar (push) las brancas de resultat seguidas a una fin de session non acabada iniciada pel runner]' \
    '--trust-workspace[Inicializar la fisança persistenta pels camins de depaus de cada session (per defaut: true)]::bool:(true false)' \
    '--remove-session-state[Suprimir l’estat per session quand una session s’acaba (per defaut: false)]::bool:(true false)' \
    '--diff-finds-nested-repository[Mostrar un depaus clonat dins un sosdorsièr dins lo panèl Changes; necessita --capacity 1 (per defaut: false)]::bool:(true false)' \
    '--confine-repo-settings[Mòde de proteccion que limita los paramètres comitats dins lo depaus (per defaut: warn)]:mode:(warn enforce off)' \
    '--server-auto-mode-lists[Quinas listas del classificador del mòde automatic una session pòt recebre del servidor (per defaut: no-allow)]:mode:(all no-allow none)' \
    '--host-config-snapshot[Ont es gardada la captura d’aviada de la configuracion de l’òste (per defaut: disk)]:mode:(disk memory)' \
    '--health-port[Pòrt per l’escotaire HTTP /healthz (per defaut: 8080; 0 desactiva)]:port:' \
    '--log-level[Nivèl de jornal (per defaut: info)]:level:(info debug)' \
    '--log-file[Copiar tanben los jornals del runner dins un fichièr en mòde ajust (tee)]:path:_files' \
    '--exit-if-unused-min[Sortir del runner se cap de trabalh es pas estat assignat pendent N minutas]:n:' \
    '--drain-grace-sec[Segondas de contunhar d’interrogar per de trabalh aprèp la fin de las sessions activas (per defaut: 0)]:n:' \
    '--retire-at[Retirar lo runner a aquesta ora Unix absoluda, en segondas]:epoch-seconds:' \
    '--defer-shutdown-max-min[Al primièr SIGTERM/SIGINT, arrestar de prene de trabalh e acabar l’arrèst M minutas pus tard (per defaut: 0)]:m:' \
    '--release-idle-session-min[Liberar un emplaçament de session aprèp N minutas sens entrada d’utilizaire]:n:' \
    '--startup-timeout-min[Liberar un emplaçament de session se l’enfant a pas acabat d’aviar aprèp N minutas (per defaut: 15; 0 desactiva)]:n:' \
    '--kill-session-after-min[Limitar la durada de vida en temps real d’un enfant de session a N minutas]:n:' \
    '--debug-token-dir[DESBUGATGE SOLAMENT: escriu de getons actius sul disc. Utilizar pas en produccion]:path:_directories' \
    '(-h --help)'{-h,--help}'[Afichar aqueste messatge d’ajuda]'
}

_claude_remote_control() {
  _arguments \
    '--name[Nom de la session (afichat dins claude.ai/code)]:name:' \
    '--remote-control-session-name-prefix[Prefix pels noms de session generats automaticament (per defaut: hostname)]:prefix:' \
    '(-c --continue --session-id)'{-c,--continue}'[Se tornar connectar a la darrièra session enregistrada per aqueste directòri o un de sos worktrees git]' \
    '(-c --continue --session-id)--session-id[Se tornar connectar a una session especifica per ID]:id:' \
    '--permission-mode[Mòde de permission per las sessions aviadas]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)' \
    '(--no-chrome)--chrome[Activar Claude in Chrome per las sessions aviadas]' \
    '(--chrome)--no-chrome[Desactivar Claude in Chrome per las sessions aviadas]' \
    '(-d --debug)'{-d,--debug}'[Activar lo mòde de desbugatge amb filtratge de categorias opcional]::filter:' \
    '--debug-file[Escriure los jornals de desbugatge dins un fichièr]:path:_files' \
    '(-v --verbose)'{-v,--verbose}'[Activar la sortida detalhada]' \
    '--spawn[Mòde d’aviada (per defaut: same-dir)]:mode:(same-dir worktree session)' \
    '--capacity[Sessions simultanèas maximalas en mòde worktree o same-dir (per defaut: 32)]:n:' \
    '(--no-create-session-in-dir)--create-session-in-dir[Precrear una session dins lo directòri actual (per defaut)]' \
    '(--create-session-in-dir)--no-create-session-in-dir[Precrear pas de session dins lo directòri actual]' \
    '(-h --help)'{-h,--help}'[Afichar aquesta ajuda]'
}

_claude_daemon() {
  local -a daemon_commands common_options
  daemon_commands=(
    'run:Executar lo supervisor al primièr plan'
    'status:Afichar lo pid, la version e lo temps de foncionament del daemon'
    'logs:Seguir lo jornal del daemon (Ctrl-C per arrestar)'
    'uninstall:Suprimir lo servici de rèireplan (launchctl/systemd)'
    'stop:Arrestar lo supervisor e terminar las sessions en rèireplan'
  )
  common_options=(
    '--json-path[Fichièr de configuracion (per defaut: ~/.claude/daemon.json)]:path:_files'
    '--log-file[Fichièr de jornal (per defaut: ~/.claude/daemon.log)]:path:_files'
    '(-h --help)'{-h,--help}'[Afichar aquesta ajuda]'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    $common_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'comandas daemon' daemon_commands
      ;;
    args)
      case $words[1] in
        run)
          _arguments \
            $common_options \
            '::json-path:_files'
          ;;
        stop)
          _arguments \
            $common_options \
            '--any[Arrestar tanben un daemon temporari (pas un servici)]' \
            '--keep-workers[Daissar las sessions destacadas en execucion]'
          ;;
        status|logs|uninstall)
          _arguments \
            $common_options
          ;;
      esac
      ;;
  esac
}

_claude_import() {
  _arguments \
    '--dry-run[Afichar çò que seriá importat sens res escriure]' \
    '--yes[Passar lo selector interactiu (sus las interfàcias sens afichatge, passar --yes=<digest> dempuèi l'\''apercebut de /import)]' \
    '(-h --help)'{-h,--help}'[Afichar l'\''ajuda per la comanda]' \
    '::source:(codex gemini cursor)'
}

# compinit autoloads this file, and that first call only defines the functions
# above: complete right away so the first TAB already works. Sourced directly,
# there is nothing to complete yet, only the registration.
if [[ $funcstack[1] == _claude ]]; then
  _claude "$@"
else
  (( $+_comps[claude] )) || compdef _claude claude
fi
