#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:MCP सर्व्हर कॉन्फिगर आणि व्यवस्थापित करा'
    'plugin:Claude Code प्लगइन व्यवस्थापित करा'
    'agents:पार्श्वभूमी एजंट व्यवस्थापित करा'
    'attach:या टर्मिनलमध्ये पार्श्वभूमी सत्र उघडा'
    'logs:पार्श्वभूमी सत्राचे अलीकडील टर्मिनल आउटपुट प्रिंट करा'
    'stop:पार्श्वभूमी सत्र थांबवा (त्याचे संभाषण जतन केले जाते)'
    'respawn:पार्श्वभूमी सत्र पुन्हा सुरू करा जेणेकरून ते सध्याची Claude Code आवृत्ती चालवेल'
    'rm:पार्श्वभूमी सत्र हटवा, आणि सुरक्षित असल्यास त्याचे worktree देखील'
    'auth:प्रमाणीकरण व्यवस्थापित करा'
    'auto-mode:ऑटो मोड क्लासिफायर कॉन्फिगरेशन तपासा किंवा रीसेट करा'
    'gateway:एंटरप्राइझ ऑथ/टेलिमेट्री गेटवे चालवा'
    'import:दुसऱ्या AI कोडिंग एजंटमधून Claude Code मध्ये कॉन्फिग आयात करा'
    'project:Claude Code प्रकल्प स्थिती व्यवस्थापित करा'
    'ultrareview:क्लाउड-होस्टेड मल्टी-एजंट कोड पुनरावलोकन चालवा आणि निष्कर्ष प्रिंट करा'
    'setup-token:दीर्घकालीन प्रमाणीकरण टोकन सेट करा (Claude सदस्यता आवश्यक)'
    'doctor:Claude Code ऑटो-अपडेटरसाठी आरोग्य तपासणी'
    'update:अद्यतने तपासा आणि इन्स्टॉल करा'
    'install:Claude Code नेटिव्ह बिल्ड इन्स्टॉल करा'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[पर्यायी श्रेणी फिल्टरिंगसह डीबग मोड सक्षम करा (उदा., "api,hooks" किंवा "!statsig,!file")]:filter:'
    '--verbose[कॉन्फिग फाइलवरील व्हर्बोज मोड सेटिंग ओव्हरराइड करा]'
    '(-p --print)'{-p,--print}'[प्रतिसाद प्रिंट करा आणि बाहेर पडा (पाईपसह वापरासाठी)। नोंद: केवळ विश्वासार्ह निर्देशिकांमध्ये वापरा]'
    '--output-format[आउटपुट स्वरूप (--print सह): "text" (डीफॉल्ट), "json" (एकल परिणाम), किंवा "stream-json" (रिअल-टाइम स्ट्रीमिंग)]:format:(text json stream-json)'
    '--json-schema[संरचित आउटपुट सत्यापनासाठी JSON स्कीमा]:schema:'
    '--include-partial-messages[आंशिक संदेश तुकडे समाविष्ट करा जसे ते येतात (--print आणि --output-format=stream-json सह)]'
    '--input-format[इनपुट स्वरूप (--print सह): "text" (डीफॉल्ट) किंवा "stream-json" (रिअल-टाइम स्ट्रीमिंग इनपुट)]:format:(text stream-json)'
    '--mcp-debug[\[बंद. त्याऐवजी --debug वापरा\] MCP डीबग मोड सक्षम करा (MCP सर्व्हर त्रुटी दर्शवते)]'
    '--dangerously-skip-permissions[सर्व परवानगी तपासण्या बायपास करा. इंटरनेट प्रवेशाशिवाय सँडबॉक्ससाठी फक्त शिफारस केली आहे]'
    '--allow-dangerously-skip-permissions[डीफॉल्टनुसार सक्षम न करता परवानगी तपासण्या बायपास करण्याचा पर्याय सक्षम करा]'
    '--restricted[प्रतिबंधित मोड: कमांड किंवा कोड चालवणारी साधने आणि WebFetch काढा, user/project/local सेटिंग्ज दुर्लक्षित करा, आणि फाइल साधने कार्यरत निर्देशिकांपुरती मर्यादित करा]'
    '--max-budget-usd[API कॉलवर खर्च करण्यासाठी कमाल डॉलर रक्कम (केवळ --print)]:amount:'
    '--replay-user-messages[पुष्टीसाठी stdin वरून stdout वर वापरकर्ता संदेश पुन्हा पाठवा]'
    '--allowed-tools[परवानगी असलेल्या साधन नावांची स्वल्पविराम किंवा स्पेस-विभाजित यादी (उदा., "Bash(git:*) Edit")]:tools:'
    '--allowedTools[परवानगी असलेल्या साधन नावांची स्वल्पविराम किंवा स्पेस-विभाजित यादी (camelCase स्वरूप)]:tools:'
    '--tools[अंतर्निहित संचामधून उपलब्ध साधनांची यादी निर्दिष्ट करा. केवळ प्रिंट मोड]:tools:'
    '--disallowed-tools[परवानगी नसलेल्या साधन नावांची स्वल्पविराम किंवा स्पेस-विभाजित यादी (उदा., "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[परवानगी नसलेल्या साधन नावांची स्वल्पविराम किंवा स्पेस-विभाजित यादी (camelCase स्वरूप)]:tools:'
    '--mcp-config[JSON फाइल किंवा स्ट्रिंगमधून MCP सर्व्हर लोड करा (स्पेस-विभाजित)]:configs:'
    '--system-prompt[सत्रासाठी वापरण्यासाठी सिस्टम प्रॉम्प्ट]:prompt:'
    '--system-prompt-file[फाइलमधून सिस्टम प्रॉम्प्ट वाचा]:file:_files'
    '--append-system-prompt[डीफॉल्ट सिस्टम प्रॉम्प्टमध्ये सिस्टम प्रॉम्प्ट जोडा]:prompt:'
    '--append-system-prompt-file[फाइलमधून सिस्टम प्रॉम्प्ट वाचा आणि डीफॉल्ट सिस्टम प्रॉम्प्टमध्ये जोडा]:file:_files'
    '--system-prompt-snapshot[प्रत्येक संभाषणात सिस्टम प्रॉम्प्ट एकदा नोंदवा आणि प्रत्येक विनंती व पुन्हा सुरू करताना तो जसाच्या तसा पुन्हा वापरा (on, डीफॉल्ट) किंवा प्रत्येक विनंतीवेळी तो नव्याने रेंडर करा (off)]:mode:(on off)'
    '--permission-mode[सत्रासाठी वापरण्यासाठी परवानगी मोड]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[--print सह परवानगी प्रॉम्प्टना कोण उत्तर देते: "host" (SDK होस्ट किंवा --permission-prompt-tool) किंवा "none" (प्रॉम्प्ट करणारी कोणतीही गोष्ट नाकारली जाते)]:target:(host none)'
    '--permission-prompt-tool[परवानगी प्रॉम्प्टसाठी वापरायचे MCP साधन (केवळ --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[सर्वात अलीकडील संभाषण सुरू ठेवा]'
    '(-r --resume)'{-r,--resume}'[संभाषण पुन्हा सुरू करा - सत्र ID निर्दिष्ट करा किंवा परस्पर निवडा]:sessionId:_claude_sessions'
    '--fork-session[पुन्हा सुरू करताना मूळ सत्र ID चा पुनर्वापर करण्याऐवजी नवीन सत्र ID तयार करा (--resume किंवा --continue सह)]'
    '--no-session-persistence[सत्र टिकवणे अक्षम करा - सत्रे जतन केली जाणार नाहीत (केवळ --print)]'
    '--model[सध्याच्या सत्रासाठी मॉडेल. नवीनतम मॉडेलसाठी उपनाम निर्दिष्ट करा (उदा., '\''sonnet'\'' किंवा '\''opus'\'')]:model:_claude_model_names'
    '--agent[सध्याच्या सत्रासाठी एजंट. '\''agent'\'' सेटिंग ओव्हरराइड करते]:agent:_claude_agent_names'
    '--betas[API विनंत्यांमध्ये समाविष्ट करण्यासाठी बीटा हेडर (केवळ API की वापरकर्ते)]:betas:'
    '--fallback-model[जेव्हा डीफॉल्ट मॉडेल ओव्हरलोड असेल तेव्हा निर्दिष्ट मॉडेलमध्ये स्वयंचलित फॉलबॅक सक्षम करा (केवळ --print)]:model:_claude_model_names'
    '--settings[सेटिंग्ज JSON फाइल किंवा अतिरिक्त सेटिंग्ज लोड करण्यासाठी JSON स्ट्रिंगचा मार्ग]:file-or-json:_files'
    '--add-dir[साधन प्रवेशास परवानगी देण्यासाठी अतिरिक्त निर्देशिका]:directories:_directories'
    '--ide[जर अचूक एक वैध IDE उपलब्ध असेल तर स्टार्टअपवर IDE शी स्वयं-कनेक्ट करा]'
    '--desktop[टर्मिनलऐवजी Claude Desktop अ‍ॅपमध्ये उघडा (सत्र निवडण्यासाठी --continue किंवा --resume <id> सह)]'
    '--strict-mcp-config[केवळ --mcp-config मधील MCP सर्व्हर वापरा आणि इतर सर्व MCP सेटिंग्ज दुर्लक्षित करा]'
    '--session-id[संभाषणासाठी वापरण्यासाठी विशिष्ट सत्र ID (वैध UUID असणे आवश्यक आहे)]:uuid:'
    '--agents[सानुकूल एजंट परिभाषित करणारा JSON ऑब्जेक्ट]:json:'
    '--setting-sources[लोड करण्यासाठी सेटिंग स्रोतांची स्वल्पविराम-विभाजित यादी (user, project, local)]:sources:'
    '--plugin-dir[केवळ या सत्रासाठी प्लगइन लोड करण्यासाठी निर्देशिका (पुनरावृत्ती करण्यायोग्य)]:paths:_directories'
    '--disable-slash-commands[सर्व स्लॅश कमांड अक्षम करा]'
    '(--bg --background)'{--bg,--background}'[सत्र पार्श्वभूमी एजंट म्हणून सुरू करा आणि लगेच परत या]'
    '(-w --worktree)'{-w,--worktree}'[या सत्रासाठी नवीन git worktree तयार करा (पर्यायाने नाव निर्दिष्ट करा)]::name:'
    '--tmux=-[worktree साठी tmux सत्र तयार करा (--worktree आवश्यक). उपलब्ध असल्यास iTerm2 नेटिव्ह पेन वापरते; पारंपारिक tmux साठी --tmux=classic]::mode:(classic)'
    '(-n --name)'{-n,--name}'[या सत्रासाठी प्रदर्शन नाव सेट करा]:name:'
    '--effort[सध्याच्या सत्रासाठी प्रयत्न पातळी]:level:(low medium high xhigh max)'
    '--autocompact[ऑटो-कॉम्पॅक्ट विंडो आकार (auto, किंवा 100k-1M टोकन)]:size:(auto)'
    '--debug-file[विशिष्ट फाइल मार्गावर डीबग लॉग लिहा (अप्रत्यक्षपणे डीबग मोड सक्षम करते)]:path:_files'
    '--from-pr[क्रमांक/URL द्वारे PR शी जोडलेले सत्र पुन्हा सुरू करा, किंवा परस्पर निवडक उघडा]::value:'
    '--teleport[teleport सत्र पुन्हा सुरू करा, पर्यायाने सत्र ID निर्दिष्ट करा]::session:'
    '--cloud[दिलेल्या वर्णनासह क्लाउड सत्र तयार करा, किंवा सत्र ID किंवा claude.ai/code URL द्वारे विद्यमान सत्राशी जोडा]::description-or-session:'
    '--environment[दिलेल्या सेल्फ-होस्टेड वातावरणावर चालणारे नवीन क्लाउड सत्र तयार करा (ccpool_...)]:environment_id:'
    '--remote-control[रिमोट कंट्रोल सक्षम करून परस्पर सत्र सुरू करा (पर्यायाने नाव दिलेले)]::name:'
    '--remote-control-session-name-prefix[स्वयं-निर्मित रिमोट कंट्रोल सत्र नावांसाठी उपसर्ग]:prefix:'
    '--chrome[Chrome मध्ये Claude एकीकरण सक्षम करा]'
    '--no-chrome[Chrome मध्ये Claude एकीकरण अक्षम करा]'
    '--plugin-url[केवळ या सत्रासाठी URL वरून प्लगइन .zip आणा (पुनरावृत्ती करण्यायोग्य)]:url:'
    '--file[स्टार्टअपवर डाउनलोड करण्यासाठी फाइल संसाधने (स्वरूप: file_id:relative_path)]:specs:'
    '--prompt-suggestions[प्रॉम्प्ट सूचना सक्षम करा (print/SDK मोडमध्ये अंदाजित पुढील प्रॉम्प्ट उत्सर्जित करते)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[सबएजंट मजकूर आणि विचार ब्लॉक संदेश म्हणून अग्रेषित करा (--print आणि stream-json सह)]'
    '--include-hook-events[आउटपुट प्रवाहात सर्व हुक जीवनचक्र घटना समाविष्ट करा (stream-json सह)]'
    '--exclude-dynamic-system-prompt-sections[प्रॉम्प्ट-कॅश पुनर्वापर सुधारण्यासाठी प्रति-मशीन विभाग पहिल्या वापरकर्ता संदेशात हलवा]'
    '--brief[एजंट-ते-वापरकर्ता संवादासाठी SendUserMessage साधन सक्षम करा]'
    '--safe-mode[सर्व सानुकूलने अक्षम करून प्रारंभ करा (तुटलेल्या कॉन्फिगरेशनचे निवारण करण्यासाठी उपयुक्त)]'
    '--bare[किमान मोड: हुक, LSP, प्लगइन सिंक, श्रेय, ऑटो-मेमरी, आणि CLAUDE.md स्वयं-शोध वगळा]'
    '--ax-screen-reader[स्क्रीन-रीडर अनुकूल आउटपुट रेंडर करा (सपाट मजकूर, सजावटीच्या सीमा किंवा अ‍ॅनिमेशन नाहीत)]'
    '(-v --version)'{-v,--version}'[आवृत्ती क्रमांक आउटपुट करा]'
    '(-h --help)'{-h,--help}'[कमांडसाठी मदत प्रदर्शित करा]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude commands' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[कमांडसाठी मदत प्रदर्शित करा]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "कोणतेही आर्ग्युमेंट नाहीत"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Claude Code MCP सर्व्हर प्रारंभ करा'
    'add:Claude Code मध्ये MCP सर्व्हर जोडा'
    'remove:MCP सर्व्हर काढा'
    'list:कॉन्फिगर केलेल्या MCP सर्व्हरची यादी करा'
    'get:MCP सर्व्हर तपशील मिळवा'
    'add-json:JSON स्ट्रिंगसह MCP सर्व्हर (stdio किंवा SSE) जोडा'
    'add-from-claude-desktop:Claude Desktop मधून MCP सर्व्हर आयात करा (केवळ Mac आणि WSL)'
    'reset-project-choices:या प्रकल्पातील सर्व मंजूर/नाकारलेले प्रकल्प-व्याप्ती (.mcp.json) सर्व्हर रीसेट करा'
    'login:MCP सर्व्हरसह प्रमाणीकरण करा (HTTP, SSE, किंवा claude.ai कनेक्टर)'
    'logout:MCP सर्व्हरसाठी संग्रहित OAuth क्रेडेन्शियल्स साफ करा'
    'help:मदत प्रदर्शित करा'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp commands' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[डीबग मोड सक्षम करा]' \
            '--verbose[कॉन्फिग फाइलवरील व्हर्बोज मोड सेटिंग ओव्हरराइड करा]' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[कॉन्फिग व्याप्ती (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[वाहतूक प्रकार (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[पर्यावरण व्हेरिएबल सेट करा (उदा., -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[WebSocket हेडर सेट करा]:header:' \
            '--client-id[HTTP/SSE सर्व्हरसाठी OAuth क्लायंट ID]:clientId:' \
            '--client-secret[OAuth क्लायंट सीक्रेटसाठी प्रॉम्प्ट करा (किंवा MCP_CLIENT_SECRET पर्यावरण व्हेरिएबल सेट करा)]' \
            '--callback-port[OAuth कॉलबॅकसाठी निश्चित पोर्ट (पूर्व-नोंदणीकृत रीडायरेक्ट URI आवश्यक असलेल्या सर्व्हरसाठी)]:port:' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[कॉन्फिग व्याप्ती (local, user, project) - अनिर्दिष्ट असल्यास विद्यमान व्याप्तीमधून काढा]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[कॉन्फिग व्याप्ती (local, user, project)]:scope:(local user project)' \
            '--client-secret[OAuth क्लायंट सीक्रेटसाठी प्रॉम्प्ट करा (किंवा MCP_CLIENT_SECRET पर्यावरण व्हेरिएबल सेट करा)]' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[कॉन्फिग व्याप्ती (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]'
          ;;
        login)
          _arguments \
            '--no-browser[ब्राउझर उघडण्याऐवजी अधिकृतता URL प्रिंट करा (SSH/हेडलेस सत्रांसाठी)]' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:प्लगइन किंवा मार्केटप्लेस मॅनिफेस्ट प्रमाणित करा'
    'marketplace:Claude Code मार्केटप्लेस व्यवस्थापित करा'
    'list:इन्स्टॉल केलेल्या प्लगइनची यादी करा'
    'details:प्लगइनसाठी घटक यादी आणि अंदाजित टोकन खर्च दर्शवा'
    'configure:प्लगइनचे पर्याय आणि कोणते सेट नाहीत ते दर्शवा, किंवा stdin वरून मूल्ये जतन करा'
    'install:उपलब्ध मार्केटप्लेसमधून प्लगइन इन्स्टॉल करा'
    'i:उपलब्ध मार्केटप्लेसमधून प्लगइन इन्स्टॉल करा (install साठी लहान)'
    'init:नवीन प्लगइन स्कॅफोल्ड करा (पुढील सत्रात स्वयं-लोड होते)'
    'new:नवीन प्लगइन स्कॅफोल्ड करा (init साठी उपनाम)'
    'uninstall:इन्स्टॉल केलेले प्लगइन अनइन्स्टॉल करा'
    'remove:इन्स्टॉल केलेले प्लगइन अनइन्स्टॉल करा (uninstall साठी उपनाम)'
    'enable:अक्षम केलेले प्लगइन सक्षम करा'
    'disable:सक्षम केलेले प्लगइन अक्षम करा'
    'update:प्लगइन नवीनतम आवृत्तीवर अद्यतनित करा'
    'eval:प्लगइनविरुद्ध eval प्रकरणे चालवा आणि गुणांकित निकाल नोंदवा'
    'prune:आता आवश्यक नसलेल्या स्वयं-इन्स्टॉल केलेल्या अवलंबित्वे काढा'
    'autoremove:आता आवश्यक नसलेली स्वयं-इन्स्टॉल केलेली अवलंबित्वे काढा (prune साठी उपनाम)'
    'tag:प्लगइन रिलीझसाठी {name}--v{version} git टॅग तयार करा'
    'test:mod च्या चाचण्या चालवा'
    'help:मदत प्रदर्शित करा'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin commands' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[चेतावण्यांना त्रुटी म्हणून हाताळा (exit code 1)]' \
            '--json[प्रमाणीकरण अहवाल JSON म्हणून आउटपुट करा (समान exit codes)]' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[इन्स्टॉलेशन व्याप्ती]:scope:(user project local)' \
            '*--config[प्लगइन मॅनिफेस्टमध्ये घोषित केलेला userConfig पर्याय सेट करा (पुनरावृत्ती करण्यायोग्य)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[मार्केटप्लेसने घोषित केलेली प्रदर्शित कमांड पुष्टी प्रॉम्प्टशिवाय स्वीकारा]' \
            '--json[मानवी संदेशाऐवजी एक मशीन-वाचनीय परिणाम ओळ प्रिंट करा]' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[इन्स्टॉलेशन व्याप्ती]:scope:(user project local)' \
            '--keep-data[प्लगइनची कायमस्वरूपी डेटा निर्देशिका जतन करा]' \
            '--prune[आता आवश्यक नसलेली स्वयं-इन्स्टॉल केलेली अवलंबित्वे देखील काढा]' \
            '(-y --yes)'{-y,--yes}'[--prune पुष्टी प्रॉम्प्ट वगळा]' \
            '--json[मानवी संदेशाऐवजी एक मशीन-वाचनीय परिणाम ओळ प्रिंट करा (--prune सह नाही)]' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[इन्स्टॉलेशन व्याप्ती]:scope:(user project local)' \
            '--json[मानवी संदेशाऐवजी एक मशीन-वाचनीय परिणाम ओळ प्रिंट करा]' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[सर्व सक्षम केलेले प्लगइन अक्षम करा]' \
            '(-s --scope)'{-s,--scope}'[इन्स्टॉलेशन व्याप्ती]:scope:(user project local)' \
            '--json[मानवी संदेशाऐवजी एक मशीन-वाचनीय परिणाम ओळ प्रिंट करा]' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[इन्स्टॉलेशन व्याप्ती]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[मार्केटप्लेसने घोषित केलेली प्रदर्शित कमांड पुष्टी प्रॉम्प्टशिवाय स्वीकारा]' \
            '--json[मानवी संदेशाऐवजी एक मशीन-वाचनीय परिणाम ओळ प्रिंट करा]' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[JSON म्हणून आउटपुट करा]' \
            '--available[मार्केटप्लेसमधील उपलब्ध प्लगइन समाविष्ट करा (--json आवश्यक)]' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[या व्याप्तीमध्ये prune करा]:scope:(user project local)' \
            '--dry-run[काढल्याशिवाय काय काढले जाईल त्याची यादी करा]' \
            '(-y --yes)'{-y,--yes}'[पुष्टी प्रॉम्प्ट वगळा]' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]'
          ;;
        configure)
          _arguments \
            '--json[JSON म्हणून आउटपुट करा]' \
            '--values-stdin[stdin वरून पर्याय मूल्ये एकल-ओळ स्ट्रिंगच्या JSON ऑब्जेक्ट म्हणून वाचा; वगळलेले पर्याय त्यांची मूल्ये कायम ठेवतात]' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[मॅनिफेस्ट वर्णन]:text:' \
            '--author[लेखकाचे नाव (डीफॉल्ट: git config user.name)]:name:' \
            '--author-email[लेखकाचा ईमेल (डीफॉल्ट: git config user.email)]:email:' \
            '--with[सोबत स्कॅफोल्ड करायचे घटक]:components:' \
            '(-f --force)'{-f,--force}'[लक्ष्यावरील विद्यमान .claude-plugin/ ओव्हरराइट करा]' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[नाव glob नुसार प्रकरणे फिल्टर करा]:glob:' \
            '*--tag[टॅगनुसार प्रकरणे फिल्टर करा (पुनरावृत्ती करण्यायोग्य)]:tag:' \
            '--runs[प्रति-प्रकरण रन संख्या ओव्हरराइड करा (डीफॉल्ट: case.runs, अन्यथा 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[एकाच वेळी जास्तीत जास्त n एजंट रन चालवा (1-8; डीफॉल्ट 1)]:n:' \
            '--model[सर्व प्रकरणांसाठी मॉडेल ओव्हरराइड करा]:model:_claude_model_names' \
            '--judge-model[LLM-ग्रेडर मॉडेल ओव्हरराइड करा (डीफॉल्ट: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[कठोर खर्च मर्यादा; गाठल्यास रद्द करा आणि आंशिक निकाल नोंदवा (exit code 2)]:usd:' \
            '--output-dir[aggregate-result.json साठी निर्देशिका]:dir:_directories' \
            '--eval-dir[eval प्रकरणे असलेल्या निर्देशिकेचे नाव (प्लगइनखाली)]:dir:' \
            '--json[संपूर्ण रन निकाल JSON म्हणून stdout वर प्रिंट करा, किंवा या .json फाइलमध्ये लिहा]::path:_files' \
            '--threshold[कोणत्याही प्रकरणाचा गुण या मर्यादेपेक्षा कमी असल्यास exit code 1 सह बाहेर पडा (डीफॉल्ट: 1.0)]:threshold:' \
            '*--allow-tools[प्रतिबंधित साधनांसाठी ऑपरेटर परवानगी (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[प्रत्येक प्रकरणाची scaffold_script चालवा (लेखकाने दिलेला bash तुमच्या खात्याने चालवते; डीफॉल्टनुसार बंद)]' \
            '(--scaffold)--no-scaffold[scaffold_script स्पष्टपणे वगळा]' \
            '--trust-plugin[तुम्ही या प्लगइनवर आणि त्याच्या eval संचावर विश्वास ठेवता असे नमूद करा, पहिल्या रनचा विश्वास प्रॉम्प्ट वगळून (CI साठी)]' \
            '--ablation[प्लगइनशिवाय बेसलाइन तुलना गट चालवा आणि गुणांमधील फरक नोंदवा]:mode:(none with-without)' \
            '--mocks[MCP सर्व्हरसाठी मॉक पर्याय, <eval dir>/mocks/ मधून]:mode:(record off)' \
            '--allow-real-servers[--mocks record सह: मॉक नसलेल्या खऱ्या MCP सर्व्हर प्रक्रिया देखील सुरू करा]' \
            '--keep-temp[डीबगिंगसाठी स्कॅफोल्ड निर्देशिका जतन करा]' \
            '--verbose[प्रति-संदेश ट्रेस घटना डीबग लॉगमध्ये नोंदवा]' \
            '--report[स्वयंपूर्ण HTML अहवाल निकाल निर्देशिकेऐवजी या मार्गावर लिहा]:path:_files' \
            '(--no-publish)--publish-report[अहवाल claude.ai वर प्रकाशित करणे देखील आवश्यक करा]' \
            '(--publish-report)--no-publish[HTML अहवाल केवळ स्थानिक ठेवा; तो claude.ai वर प्रकाशित करणे वगळा]' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[टॅग तयार केल्यानंतर तो --remote वर पुश करा]' \
            '--dry-run[टॅग तयार न करता काय टॅग केले जाईल ते प्रिंट करा]' \
            '(-f --force)'{-f,--force}'[अस्वच्छ वर्किंग ट्री आणि टॅग आधीच अस्तित्वात असल्याच्या तपासण्या वगळा]' \
            '(-m --message)'{-m,--message}'[टॅग भाष्य संदेश (आवृत्तीसाठी %s वापरा)]:msg:' \
            '--remote[--push सह पुश करण्यासाठी रिमोट]:name:' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:URL, मार्ग, किंवा GitHub रिपॉझिटरीमधून मार्केटप्लेस जोडा'
    'list:कॉन्फिगर केलेल्या मार्केटप्लेसची यादी करा'
    'remove:कॉन्फिगर केलेले मार्केटप्लेस काढा'
    'rm:कॉन्फिगर केलेले मार्केटप्लेस काढा (remove साठी उपनाम)'
    'update:स्रोतामधून मार्केटप्लेस अद्यतनित करा - नाव निर्दिष्ट नसल्यास सर्व अद्यतनित करा'
    'help:मदत प्रदर्शित करा'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace commands' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[git sparse-checkout द्वारे चेकआउट विशिष्ट निर्देशिकांपुरते मर्यादित करा (मोनोरेपोसाठी)]:paths:' \
            '--scope[मार्केटप्लेस कुठे घोषित करायचे]:scope:(user project local)' \
            '--claudeai[claude.ai तुमच्यासाठी होस्ट करत असलेले या नावाचे मार्केटप्लेस जोडा]' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[JSON म्हणून आउटपुट करा]' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]'
          ;;
        remove|rm)
          _arguments \
            '--scope[विशिष्ट सेटिंग्ज व्याप्तीमधून मार्केटप्लेस घोषणा काढा (प्रत्येक व्याप्तीमधून काढण्यासाठी वगळा)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[आधीच इन्स्टॉल असले तरीही फोर्स इन्स्टॉल करा]' \
    '(-h --help)'{-h,--help}'[मदत प्रदर्शित करा]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[पाठवलेल्या सत्रांमध्ये साधन प्रवेशास परवानगी देण्यासाठी अतिरिक्त निर्देशिका]:directory:_directories' \
    '--agent[एजंट दृश्यातून पाठवलेल्या सत्रांसाठी डीफॉल्ट एजंट]:agent:_claude_agent_names' \
    '--all[--json सह: पूर्ण झालेली पार्श्वभूमी सत्रे देखील समाविष्ट करा]' \
    '--allow-dangerously-skip-permissions[पाठवलेल्या सत्रांना bypass-permissions मोड उपलब्ध करा]' \
    '--cwd[मार्गाखाली सुरू केलेली फक्त पार्श्वभूमी सत्रे दर्शवा]:path:_directories' \
    '--dangerously-skip-permissions[--permission-mode bypassPermissions साठी उपनाम]' \
    '--effort[पाठवलेल्या सत्रांसाठी डीफॉल्ट प्रयत्न पातळी]:level:(low medium high xhigh max)' \
    '--json[सक्रिय सत्रे JSON अ‍ॅरे म्हणून प्रिंट करा आणि बाहेर पडा]' \
    '*--mcp-config[पाठवलेल्या सत्रांना लागू करण्यासाठी MCP सर्व्हर कॉन्फिगरेशन]:config:' \
    '--model[एजंट दृश्यातून पाठवलेल्या सत्रांसाठी डीफॉल्ट मॉडेल]:model:_claude_model_names' \
    '--permission-mode[पाठवलेल्या सत्रांसाठी डीफॉल्ट परवानगी मोड]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[एजंट दृश्य आणि पाठवलेल्या सत्रांसाठी निर्देशिकेतून प्लगइन लोड करा]:path:_directories' \
    '--setting-sources[लोड करण्यासाठी सेटिंग स्रोतांची स्वल्पविराम-विभाजित यादी (user, project, local)]:sources:' \
    '--settings[लागू करण्यासाठी सेटिंग्ज फाइल किंवा JSON स्ट्रिंग]:file-or-json:_files' \
    '--strict-mcp-config[पाठवलेल्या सत्रांमध्ये फक्त --mcp-config मधील MCP सर्व्हर वापरा]' \
    '--restricted[पाठवलेली सत्रे प्रतिबंधित मोडमध्ये सुरू करा]' \
    '(-h --help)'{-h,--help}'[कमांडसाठी मदत प्रदर्शित करा]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:तुमच्या Anthropic खात्यात साइन इन करा'
    'logout:तुमच्या Anthropic खात्यातून लॉग आउट करा'
    'status:प्रमाणीकरण स्थिती दर्शवा'
    'help:मदत प्रदर्शित करा'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[कमांडसाठी मदत प्रदर्शित करा]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth commands' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[लॉगिन पृष्ठावर ईमेल पत्ता आधीच भरा]:email:' \
            '--sso[SSO लॉगिन प्रवाह सक्तीने वापरा]' \
            '(--claudeai)--console[Claude सदस्यतेऐवजी Anthropic Console (API वापर बिलिंग) वापरा]' \
            '(--console)--claudeai[Claude सदस्यता वापरा (डीफॉल्ट)]' \
            '(-h --help)'{-h,--help}'[कमांडसाठी मदत प्रदर्शित करा]'
          ;;
        status)
          _arguments \
            '(--text)--json[JSON म्हणून आउटपुट करा (डीफॉल्ट)]' \
            '(--json)--text[मानवी-वाचनीय मजकूर म्हणून आउटपुट करा]' \
            '(-h --help)'{-h,--help}'[कमांडसाठी मदत प्रदर्शित करा]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[कमांडसाठी मदत प्रदर्शित करा]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:प्रभावी ऑटो मोड कॉन्फिग JSON म्हणून प्रिंट करा'
    'critique:तुमच्या सानुकूल ऑटो मोड नियमांवर AI अभिप्राय मिळवा'
    'defaults:डीफॉल्ट ऑटो मोड नियम JSON म्हणून प्रिंट करा'
    'reset:ऑटो मोड कॉन्फिगरेशन पाठवलेल्या डीफॉल्टवर रीसेट करा'
    'help:मदत प्रदर्शित करा'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[कमांडसाठी मदत प्रदर्शित करा]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode commands' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[कोणते मॉडेल वापरले जाते ते ओव्हरराइड करा]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[कमांडसाठी मदत प्रदर्शित करा]'
          ;;
        defaults)
          _arguments \
            '--label[ज्यांचे लेबल या उपसर्गाने सुरू होते असेच नियम दर्शवा (केस-असंवेदनशील)]:prefix:' \
            '(-h --help)'{-h,--help}'[कमांडसाठी मदत प्रदर्शित करा]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[पुष्टी प्रॉम्प्ट वगळा]' \
            '(-h --help)'{-h,--help}'[कमांडसाठी मदत प्रदर्शित करा]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[कमांडसाठी मदत प्रदर्शित करा]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[गेटवे YAML कॉन्फिगचा मार्ग]:path:_files' \
    '(-h --help)'{-h,--help}'[कमांडसाठी मदत प्रदर्शित करा]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:प्रकल्पासाठी सर्व Claude Code स्थिती हटवा (ट्रान्स्क्रिप्ट, कार्ये, फाइल इतिहास, कॉन्फिग नोंद)'
    'help:मदत प्रदर्शित करा'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[कमांडसाठी मदत प्रदर्शित करा]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project commands' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[काहीही न हटवता काय हटवले जाईल त्याची यादी करा]' \
            '(-y --yes)'{-y,--yes}'[पुष्टी प्रॉम्प्ट वगळा]' \
            '(-i --interactive)'{-i,--interactive}'[हटवण्यापूर्वी प्रत्येक आयटमसाठी प्रॉम्प्ट करा]' \
            '(1)--all[प्रत्येक प्रकल्पाची स्थिती पूर्णपणे हटवा (मार्गासह परस्पर अनन्य)]' \
            '(-h --help)'{-h,--help}'[कमांडसाठी मदत प्रदर्शित करा]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[स्वरूपित निष्कर्षांऐवजी कच्चा bugs.json पेलोड प्रिंट करा]' \
    '--timeout[पुनरावलोकन पूर्ण होण्याची वाट पाहण्यासाठी कमाल मिनिटे (डीफॉल्ट: 45)]:minutes:' \
    '(--no-post)--post[पूर्ण झालेल्या पुनरावलोकनाचे निष्कर्ष तुमच्या खात्याने PR वर पोस्ट करा (केवळ PR लक्ष्ये; एक साधी टिप्पणी, पुनरावलोकन नाही)]' \
    '(--post)--no-post[निष्कर्ष PR वर पोस्ट करू नका (डीफॉल्ट)]' \
    '(-h --help)'{-h,--help}'[कमांडसाठी मदत प्रदर्शित करा]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[चालू असलेले प्रत्येक पार्श्वभूमी सत्र पुन्हा सुरू करा]' \
    '(-h --help)'{-h,--help}'[कमांडसाठी मदत प्रदर्शित करा]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[worktree चे पुश न केलेले कमिट आणि कमिट न केलेले बदल देखील टाकून द्या (मागील claude rm ने नोंदवलेला commit@worktree-id द्या)]:commit@worktree-id:' \
    '--force-remove-worktree[WorktreeRemove हुक किंवा git ती काढू शकले नाहीत तरीही worktree निर्देशिका हटवा (मागील claude rm ने नोंदवलेला worktree-id द्या)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[कमांडसाठी मदत प्रदर्शित करा]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[काहीही न लिहिता काय आयात केले जाईल ते दर्शवा]' \
    '--yes[परस्पर निवडक वगळा (हेडलेस वातावरणात, /import पूर्वावलोकनातील --yes=<digest> द्या)]' \
    '(-h --help)'{-h,--help}'[कमांडसाठी मदत प्रदर्शित करा]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
