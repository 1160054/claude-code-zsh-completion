#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:MCP serverlarini sozlash va boshqarish'
    'plugin:Claude Code plaginlarini boshqarish'
    'agents:Fon agentlarini boshqarish'
    'attach:Fon sessiyasini ushbu terminalda ochish'
    'logs:Fon sessiyasining so'\''nggi terminal chiqishini chop etish'
    'stop:Fon sessiyasini to'\''xtatish (uning suhbati saqlanib qoladi)'
    'respawn:Fon sessiyasini joriy Claude Code versiyasida ishlashi uchun qayta ishga tushirish'
    'rm:Fon sessiyasini va xavfsiz bo'\''lsa uning worktree-ini o'\''chirish'
    'auth:Autentifikatsiyani boshqarish'
    'auto-mode:Avtomatik rejim klassifikatori konfiguratsiyasini tekshirish yoki qayta tiklash'
    'gateway:Korporativ autentifikatsiya/telemetriya shlyuzini ishga tushirish'
    'import:Boshqa AI kodlash agentidan konfiguratsiyani Claude Code-ga import qilish'
    'project:Claude Code loyiha holatini boshqarish'
    'ultrareview:Bulutda joylashgan ko'\''p agentli kod ko'\''rigini ishga tushirish va natijalarni chop etish'
    'setup-token:Uzoq muddatli autentifikatsiya tokenini sozlash (Claude obunasi kerak)'
    'doctor:Claude Code avtomatik yangilash uchun sog'\''liqni tekshirish'
    'update:Yangilanishlarni tekshirish va o'\''rnatish'
    'install:Claude Code mahalliy build-ini o'\''rnatish'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Kategoriya filtrlash bilan debug rejimini yoqish (masalan, "api,hooks" yoki "!statsig,!file")]:filter:'
    '--verbose[Konfiguratsiya faylidan batafsil rejim sozlamasini bekor qilish]'
    '(-p --print)'{-p,--print}'[Javobni chop etish va chiqish (quvurlar bilan foydalanish uchun). Eslatma: faqat ishonchli kataloglarda foydalaning]'
    '--output-format[Chiqish formati (--print bilan): "text" (standart), "json" (yagona natija), yoki "stream-json" (real vaqt oqimi)]:format:(text json stream-json)'
    '--json-schema[Strukturaviy chiqishni tekshirish uchun JSON sxemasi]:schema:'
    '--include-partial-messages[Qisman xabar bo'\''laklarini kelgan paytda qo'\''shish (--print va --output-format=stream-json bilan)]'
    '--input-format[Kirish formati (--print bilan): "text" (standart) yoki "stream-json" (real vaqt oqimi kirishi)]:format:(text stream-json)'
    '--mcp-debug[\[Eskirgan. O'\''rniga --debug ishlatilsin\] MCP debug rejimini yoqish (MCP server xatolarini ko'\''rsatadi)]'
    '--dangerously-skip-permissions[Barcha ruxsat tekshiruvlarini o'\''tkazib yuborish. Faqat internetga kirish imkoni bo'\''lmagan sandbox muhitlar uchun tavsiya etiladi]'
    '--allow-dangerously-skip-permissions[Sukut bo'\''yicha yoqmasdan ruxsat tekshiruvlarini o'\''tkazib yuborish imkoniyatini yoqish]'
    '--restricted[Cheklangan rejim: buyruq yoki kod ishga tushiradigan vositalarni va WebFetch-ni olib tashlash, user/project/local sozlamalarini e'\''tiborsiz qoldirish va fayl vositalarini ishchi kataloglar bilan cheklash]'
    '--max-budget-usd[API chaqiruvlariga sarflanadigan maksimal dollar miqdori (faqat --print)]:amount:'
    '--replay-user-messages[Tasdiqlash uchun stdin-dan stdout-ga foydalanuvchi xabarlarini qayta yuborish]'
    '--allowed-tools[Vergul yoki bo'\''sh joy bilan ajratilgan ruxsat etilgan vosita nomlari ro'\''yxati (masalan, "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Vergul yoki bo'\''sh joy bilan ajratilgan ruxsat etilgan vosita nomlari ro'\''yxati (camelCase formati)]:tools:'
    '--tools[Ichki to'\''plamdan mavjud vositalar ro'\''yxatini ko'\''rsatish. Faqat print rejimi]:tools:'
    '--disallowed-tools[Vergul yoki bo'\''sh joy bilan ajratilgan taqiqlangan vosita nomlari ro'\''yxati (masalan, "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Vergul yoki bo'\''sh joy bilan ajratilgan taqiqlangan vosita nomlari ro'\''yxati (camelCase formati)]:tools:'
    '--mcp-config[JSON faylidan yoki qatordan MCP serverlarini yuklash (bo'\''sh joy bilan ajratilgan)]:configs:'
    '--system-prompt[Sessiya uchun tizim prompti]:prompt:'
    '--system-prompt-file[Tizim promptini fayldan o'\''qish]:file:_files'
    '--append-system-prompt[Standart tizim promptiga tizim promptini qo'\''shish]:prompt:'
    '--append-system-prompt-file[Tizim promptini fayldan o'\''qish va standart tizim promptiga qo'\''shish]:file:_files'
    '--system-prompt-snapshot[Tizim promptini har bir suhbatda bir marta yozib olish va har bir so'\''rov va davom ettirishda aynan qayta ishlatish (on, standart) yoki har bir so'\''rovda uni yangidan hosil qilish (off)]:mode:(on off)'
    '--permission-mode[Sessiya uchun ruxsat rejimi]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[--print bilan ruxsat so'\''rovlariga kim javob beradi: "host" (SDK xosti yoki --permission-prompt-tool) yoki "none" (so'\''rov chiqaradigan har qanday narsa rad etiladi)]:target:(host none)'
    '--permission-prompt-tool[Ruxsat so'\''rovlari uchun ishlatiladigan MCP vositasi (faqat --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Eng so'\''nggi suhbatni davom ettirish]'
    '(-r --resume)'{-r,--resume}'[Suhbatni davom ettirish - sessiya identifikatorini ko'\''rsating yoki interaktiv tanlang]:sessionId:_claude_sessions'
    '--fork-session[Davom ettirayotganda asl sessiya identifikatorini qayta ishlatish o'\''rniga yangi sessiya identifikatorini yaratish (--resume yoki --continue bilan)]'
    '--no-session-persistence[Sessiya saqlanishini o'\''chirish - sessiyalar saqlanmaydi (faqat --print)]'
    '--model[Joriy sessiya uchun model. Eng yangi model uchun taxallusni ko'\''rsating (masalan, '\''sonnet'\'' yoki '\''opus'\'')]:model:_claude_model_names'
    '--agent[Joriy sessiya uchun agent. '\''agent'\'' sozlamasini bekor qiladi]:agent:_claude_agent_names'
    '--betas[API so'\''rovlariga kiritiladigan beta sarlavhalari (faqat API kaliti foydalanuvchilari)]:betas:'
    '--fallback-model[Standart model ortiqcha yuklangan bo'\''lganda ko'\''rsatilgan modelga avtomatik qaytishni yoqish (faqat --print)]:model:_claude_model_names'
    '--settings[Qo'\''shimcha sozlamalarni yuklash uchun sozlamalar JSON fayli yoki JSON qator yo'\''li]:file-or-json:_files'
    '--add-dir[Vosita kirishi uchun qo'\''shimcha kataloglar]:directories:_directories'
    '--ide[Ishga tushirishda aynan bitta yaroqli IDE mavjud bo'\''lsa, avtomatik ravishda IDE-ga ulanish]'
    '--desktop[Terminal o'\''rniga Claude Desktop ilovasida ochish (sessiyani tanlash uchun --continue yoki --resume <id> bilan)]'
    '--strict-mcp-config[Faqat --mcp-config-dan MCP serverlaridan foydalanish va barcha boshqa MCP sozlamalarini e'\''tiborsiz qoldirish]'
    '--session-id[Suhbat uchun maxsus sessiya identifikatori (yaroqli UUID bo'\''lishi kerak)]:uuid:'
    '--agents[Maxsus agentlarni aniqlash uchun JSON obyekti]:json:'
    '--setting-sources[Yuklash uchun vergul bilan ajratilgan sozlamalar manbalari ro'\''yxati (user, project, local)]:sources:'
    '--plugin-dir[Faqat ushbu sessiya uchun plaginlarni yuklash uchun katalog (takrorlanishi mumkin)]:paths:_directories'
    '--disable-slash-commands[Barcha slash buyruqlarini o'\''chirish]'
    '(--bg --background)'{--bg,--background}'[Sessiyani fon agenti sifatida boshlash va darhol qaytish]'
    '(-w --worktree)'{-w,--worktree}'[Ushbu sessiya uchun yangi git worktree yaratish (ixtiyoriy ravishda nom ko'\''rsating)]::name:'
    '--tmux=-[Worktree uchun tmux sessiyasini yaratish (--worktree talab qilinadi). Mavjud bo'\''lsa iTerm2 mahalliy panellaridan foydalanadi; an'\''anaviy tmux uchun --tmux=classic]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Ushbu sessiya uchun ko'\''rsatiladigan nom o'\''rnatish]:name:'
    '--effort[Joriy sessiya uchun harakat darajasi]:level:(low medium high xhigh max)'
    '--autocompact[Avto-ixchamlash oynasi o'\''lchami (auto yoki 100k-1M token)]:size:(auto)'
    '--debug-file[Debug loglarini muayyan fayl yo'\''liga yozish (debug rejimini yashirin ravishda yoqadi)]:path:_files'
    '--from-pr[Raqam/URL bo'\''yicha PR bilan bog'\''langan sessiyani davom ettirish yoki interaktiv tanlagichni ochish]::value:'
    '--teleport[Teleport sessiyasini davom ettirish, ixtiyoriy ravishda sessiya identifikatorini ko'\''rsating]::session:'
    '--cloud[Berilgan tavsif bilan bulut sessiyasini yaratish yoki sessiya identifikatori yoki claude.ai/code URL orqali mavjud sessiyaga ulanish]::description-or-session:'
    '--environment[Berilgan o'\''zingiz xostlaydigan muhitda (ccpool_...) ishlaydigan yangi bulut sessiyasini yaratish]:environment_id:'
    '--remote-control[Masofaviy boshqaruv yoqilgan interaktiv sessiyani boshlash (ixtiyoriy ravishda nomlangan)]::name:'
    '--remote-control-session-name-prefix[Avtomatik yaratilgan Masofaviy boshqaruv sessiya nomlari uchun prefiks]:prefix:'
    '--chrome[Chrome integratsiyasida Claude-ni yoqish]'
    '--no-chrome[Chrome integratsiyasida Claude-ni o'\''chirish]'
    '--plugin-url[Faqat ushbu sessiya uchun URL-dan plagin .zip faylini olish (takrorlanishi mumkin)]:url:'
    '--file[Ishga tushirishda yuklab olinadigan fayl resurslari (format: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Prompt takliflarini yoqish (print/SDK rejimida bashorat qilingan keyingi promptni chiqaradi)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Sub-agent matni va fikrlash bloklarini xabar sifatida yo'\''naltirish (--print va stream-json bilan)]'
    '--include-hook-events[Chiqish oqimiga barcha hook hayot davri hodisalarini kiritish (stream-json bilan)]'
    '--exclude-dynamic-system-prompt-sections[Prompt-kesh qayta ishlatishni yaxshilash uchun har bir mashina bo'\''limlarini birinchi foydalanuvchi xabariga ko'\''chirish]'
    '--brief[Agentdan foydalanuvchiga aloqa uchun SendUserMessage vositasini yoqish]'
    '--safe-mode[Barcha moslashtirishlar o'\''chirilgan holda boshlash (buzilgan konfiguratsiyani tuzatishda foydali)]'
    '--bare[Minimal rejim: hooklar, LSP, plagin sinxronizatsiyasi, atribut, avto-xotira va CLAUDE.md avto-aniqlashni o'\''tkazib yuborish]'
    '--ax-screen-reader[Ekran o'\''qiydigan qulay chiqishni ko'\''rsatish (tekis matn, bezakli chegaralar yoki animatsiyalar yo'\''q)]'
    '(-v --version)'{-v,--version}'[Versiya raqamini chiqarish]'
    '(-h --help)'{-h,--help}'[Buyruq uchun yordamni ko'\''rsatish]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude commands' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Buyruq uchun yordamni ko'\''rsatish]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "argumentlar yo'q"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Claude Code MCP serverini ishga tushirish'
    'add:Claude Code-ga MCP serverini qo'\''shish'
    'remove:MCP serverini o'\''chirish'
    'list:Sozlangan MCP serverlari ro'\''yxati'
    'get:MCP server tafsilotlarini olish'
    'add-json:JSON qatori bilan MCP serverini qo'\''shish (stdio yoki SSE)'
    'add-from-claude-desktop:Claude Desktop-dan MCP serverlarini import qilish (faqat Mac va WSL)'
    'reset-project-choices:Ushbu loyihadagi barcha tasdiqlangan/rad etilgan loyiha doirasidagi (.mcp.json) serverlarni qayta tiklash'
    'login:MCP serveri bilan autentifikatsiya qilish (HTTP, SSE yoki claude.ai konnektori)'
    'logout:MCP serveri uchun saqlangan OAuth hisob ma'\''lumotlarini tozalash'
    'help:Yordamni ko'\''rsatish'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp commands' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Debug rejimini yoqish]' \
            '--verbose[Konfiguratsiya faylidan batafsil rejim sozlamasini bekor qilish]' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfiguratsiya doirasi (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Transport turi (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Muhit o'\''zgaruvchisini sozlash (masalan, -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[WebSocket sarlavhasini sozlash]:header:' \
            '--client-id[HTTP/SSE serverlari uchun OAuth mijoz identifikatori]:clientId:' \
            '--client-secret[OAuth mijoz sirini so'\''rash (yoki MCP_CLIENT_SECRET muhit o'\''zgaruvchisini o'\''rnating)]' \
            '--callback-port[OAuth callback uchun qat'\''iy port (oldindan ro'\''yxatdan o'\''tkazilgan yo'\''naltirish URI-larini talab qiladigan serverlar uchun)]:port:' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfiguratsiya doirasi (local, user, project) - ko'\''rsatilmasa mavjud doiradan o'\''chirish]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfiguratsiya doirasi (local, user, project)]:scope:(local user project)' \
            '--client-secret[OAuth mijoz sirini so'\''rash (yoki MCP_CLIENT_SECRET muhit o'\''zgaruvchisini o'\''rnating)]' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfiguratsiya doirasi (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]'
          ;;
        login)
          _arguments \
            '--no-browser[Brauzerni ochish o'\''rniga avtorizatsiya URL-ini chop etish (SSH/headless sessiyalar uchun)]' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Plagin yoki bozor manifestini tekshirish'
    'marketplace:Claude Code bozorlarini boshqarish'
    'list:O'\''rnatilgan plaginlar ro'\''yxati'
    'details:Plagin uchun komponentlar ro'\''yxati va taxminiy token narxini ko'\''rsatish'
    'configure:Plagin parametrlarini va qaysilari o'\''rnatilmaganini ko'\''rsatish yoki qiymatlarni stdin-dan saqlash'
    'install:Mavjud bozorlardan plagin o'\''rnatish'
    'i:Mavjud bozorlardan plagin o'\''rnatish (install uchun qisqa)'
    'init:Yangi plagin yaratish (keyingi sessiyada avtomatik yuklanadi)'
    'new:Yangi plagin karkasini yaratish (init uchun taxallus)'
    'uninstall:O'\''rnatilgan plaginni o'\''chirish'
    'remove:O'\''rnatilgan plaginni o'\''chirish (uninstall uchun taxallus)'
    'enable:O'\''chirilgan plaginni yoqish'
    'disable:Yoqilgan plaginni o'\''chirish'
    'update:Plaginni eng so'\''nggi versiyaga yangilash'
    'eval:Plaginga qarshi eval holatlarini ishga tushirish va baholangan natijalar hisobotini berish'
    'prune:Endi kerak bo'\''lmagan avtomatik o'\''rnatilgan bog'\''liqliklarni o'\''chirish'
    'autoremove:Endi kerak bo'\''lmagan avtomatik o'\''rnatilgan bog'\''liqliklarni o'\''chirish (prune uchun taxallus)'
    'tag:Plagin relizi uchun {name}--v{version} git tegini yaratish'
    'test:Mod testlarini ishga tushirish'
    'help:Yordamni ko'\''rsatish'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin commands' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Ogohlantirishlarni xato deb hisoblash (chiqish kodi 1)]' \
            '--json[Tekshiruv hisobotini JSON sifatida chiqarish (chiqish kodlari bir xil)]' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[O'\''rnatish doirasi]:scope:(user project local)' \
            '*--config[Plagin manifestida e'\''lon qilingan userConfig parametrini o'\''rnatish (takrorlanishi mumkin)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Bozor tomonidan e'\''lon qilingan ko'\''rsatilgan buyruqni tasdiqlash so'\''rovisiz qabul qilish]' \
            '--json[Inson uchun xabar o'\''rniga mashina o'\''qiy oladigan bitta natija qatorini chop etish]' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[O'\''rnatish doirasi]:scope:(user project local)' \
            '--keep-data[Plaginning doimiy ma'\''lumotlar katalogini saqlab qolish]' \
            '--prune[Endi kerak bo'\''lmagan avtomatik o'\''rnatilgan bog'\''liqliklarni ham o'\''chirish]' \
            '(-y --yes)'{-y,--yes}'[--prune tasdiqlash so'\''rovini o'\''tkazib yuborish]' \
            '--json[Inson uchun xabar o'\''rniga mashina o'\''qiy oladigan bitta natija qatorini chop etish (--prune bilan emas)]' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[O'\''rnatish doirasi]:scope:(user project local)' \
            '--json[Inson uchun xabar o'\''rniga mashina o'\''qiy oladigan bitta natija qatorini chop etish]' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Barcha yoqilgan plaginlarni o'\''chirish]' \
            '(-s --scope)'{-s,--scope}'[O'\''rnatish doirasi]:scope:(user project local)' \
            '--json[Inson uchun xabar o'\''rniga mashina o'\''qiy oladigan bitta natija qatorini chop etish]' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[O'\''rnatish doirasi]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Bozor tomonidan e'\''lon qilingan ko'\''rsatilgan buyruqni tasdiqlash so'\''rovisiz qabul qilish]' \
            '--json[Inson uchun xabar o'\''rniga mashina o'\''qiy oladigan bitta natija qatorini chop etish]' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[JSON sifatida chiqarish]' \
            '--available[Bozorlardagi mavjud plaginlarni ham kiritish (--json talab qilinadi)]' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ko'\''rsatilgan doirada tozalash]:scope:(user project local)' \
            '--dry-run[O'\''chirmasdan nima o'\''chirilishini ro'\''yxatlash]' \
            '(-y --yes)'{-y,--yes}'[Tasdiqlash so'\''rovini o'\''tkazib yuborish]' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]'
          ;;
        configure)
          _arguments \
            '--json[JSON sifatida chiqarish]' \
            '--values-stdin[Parametr qiymatlarini stdin-dan bir qatorli satrlardan iborat JSON obyekti sifatida o'\''qish; ko'\''rsatilmagan parametrlar o'\''z qiymatlarini saqlab qoladi]' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Manifest tavsifi]:text:' \
            '--author[Muallif ismi (standart: git config user.name)]:name:' \
            '--author-email[Muallif elektron pochtasi (standart: git config user.email)]:email:' \
            '--with[Qo'\''shimcha ravishda karkasi yaratiladigan komponentlar]:components:' \
            '(-f --force)'{-f,--force}'[Maqsaddagi mavjud .claude-plugin/ ni ustiga yozish]' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Holatlarni nom glob naqshi bo'\''yicha filtrlash]:glob:' \
            '*--tag[Holatlarni teg bo'\''yicha filtrlash (takrorlanishi mumkin)]:tag:' \
            '--runs[Har bir holat uchun ishga tushirishlar sonini qayta belgilash (standart: case.runs, aks holda 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Bir vaqtning o'\''zida agentni n martagacha ishga tushirish (1-8; standart 1)]:n:' \
            '--model[Barcha holatlar uchun modelni qayta belgilash]:model:_claude_model_names' \
            '--judge-model[LLM-baholovchi modelini qayta belgilash (standart: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Qat'\''iy xarajat chegarasi; yetib borilsa to'\''xtatish va qisman natijalar hisobotini berish (chiqish kodi 2)]:usd:' \
            '--output-dir[aggregate-result.json uchun katalog]:dir:_directories' \
            '--eval-dir[Eval holatlarini saqlaydigan katalog nomi (plagin ichida)]:dir:' \
            '--json[To'\''liq ishga tushirish natijasini JSON sifatida stdout-ga chop etish yoki ushbu .json fayliga yozish]::path:_files' \
            '--threshold[Biror holat bali ushbu chegaradan past bo'\''lsa, chiqish kodi 1 bilan chiqish (standart: 1.0)]:threshold:' \
            '*--allow-tools[Cheklangan vositalar uchun operator ruxsati (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Har bir holatning scaffold_script-ini ishga tushirish (muallif bergan bash-ni sizning nomingizdan ishga tushiradi; standart bo'\''yicha o'\''chiq)]' \
            '(--scaffold)--no-scaffold[scaffold_script-ni aniq o'\''tkazib yuborish]' \
            '--trust-plugin[Ushbu plagin va uning eval to'\''plamiga ishonishingizni tasdiqlash, birinchi ishga tushirishdagi ishonch so'\''rovini o'\''tkazib yuborish (CI uchun)]' \
            '--ablation[Plaginsiz bazaviy taqqoslash guruhini ishga tushirish va ballar farqini hisobot qilish]:mode:(none with-without)' \
            '--mocks[MCP serverlari uchun mock o'\''rinbosarlar, <eval dir>/mocks/ dan]:mode:(record off)' \
            '--allow-real-servers[--mocks record bilan: mock-i bo'\''lmagan haqiqiy MCP server jarayonlarini ham ishga tushirish]' \
            '--keep-temp[Debug uchun karkas kataloglarini saqlab qolish]' \
            '--verbose[Har bir xabar bo'\''yicha trace hodisalarini debug logiga yozish]' \
            '--report[Mustaqil HTML hisobotni natijalar katalogi o'\''rniga ushbu yo'\''lga yozish]:path:_files' \
            '(--no-publish)--publish-report[Hisobotni claude.ai-ga nashr qilishni ham talab qilish]' \
            '(--publish-report)--no-publish[HTML hisobotni faqat mahalliy saqlash; uni claude.ai-ga nashr qilishni o'\''tkazib yuborish]' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Tegni yaratgandan keyin --remote-ga push qilish]' \
            '--dry-run[Yaratmasdan nima teglanishini chop etish]' \
            '(-f --force)'{-f,--force}'[Ishchi daraxt toza emasligi va teg allaqachon mavjudligi tekshiruvlarini o'\''tkazib yuborish]' \
            '(-m --message)'{-m,--message}'[Teg izoh xabari (versiya uchun %s dan foydalaning)]:msg:' \
            '--remote[--push bilan push qilinadigan remote]:name:' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:URL, yo'\''l yoki GitHub repositoriyasidan bozor qo'\''shish'
    'list:Sozlangan bozorlar ro'\''yxati'
    'remove:Sozlangan bozorni o'\''chirish'
    'rm:Sozlangan bozorni o'\''chirish (remove uchun taxallus)'
    'update:Manbadan bozorni yangilash - nomi ko'\''rsatilmasa hammasini yangilash'
    'help:Yordamni ko'\''rsatish'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace commands' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Checkout-ni git sparse-checkout orqali muayyan kataloglar bilan cheklash (monorepolar uchun)]:paths:' \
            '--scope[Bozorni qayerda e'\''lon qilish]:scope:(user project local)' \
            '--claudeai[claude.ai siz uchun joylashtirgan shu nomdagi bozorni qo'\''shish]' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[JSON sifatida chiqarish]' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Bozor e'\''lonini muayyan sozlamalar doirasidan o'\''chirish (barcha doiralardan o'\''chirish uchun ko'\''rsatmang)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Allaqachon o'\''rnatilgan bo'\''lsa ham majburan o'\''rnatish]' \
    '(-h --help)'{-h,--help}'[Yordamni ko'\''rsatish]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Yuborilgan sessiyalarda vosita kirishiga ruxsat berish uchun qo'\''shimcha katalog]:directory:_directories' \
    '--agent[Agent ko'\''rinishidan yuborilgan sessiyalar uchun standart agent]:agent:_claude_agent_names' \
    '--all[--json bilan: tugallangan fon sessiyalarini ham kiritish]' \
    '--allow-dangerously-skip-permissions[Yuborilgan sessiyalar uchun ruxsatlarni chetlab o'\''tish rejimini mavjud qilish]' \
    '--cwd[Faqat yo'\''l ostida boshlangan fon sessiyalarini ko'\''rsatish]:path:_directories' \
    '--dangerously-skip-permissions[--permission-mode bypassPermissions uchun taxallus]' \
    '--effort[Yuborilgan sessiyalar uchun standart harakat darajasi]:level:(low medium high xhigh max)' \
    '--json[Faol sessiyalarni JSON massivi sifatida chop etish va chiqish]' \
    '*--mcp-config[Yuborilgan sessiyalarga qo'\''llaniladigan MCP server konfiguratsiyasi]:config:' \
    '--model[Agent ko'\''rinishidan yuborilgan sessiyalar uchun standart model]:model:_claude_model_names' \
    '--permission-mode[Yuborilgan sessiyalar uchun standart ruxsat rejimi]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Agent ko'\''rinishi va yuborilgan sessiyalar uchun katalogdan plaginlarni yuklash]:path:_directories' \
    '--setting-sources[Yuklash uchun vergul bilan ajratilgan sozlamalar manbalari ro'\''yxati (user, project, local)]:sources:' \
    '--settings[Qo'\''llaniladigan sozlamalar fayli yoki JSON qatori]:file-or-json:_files' \
    '--strict-mcp-config[Yuborilgan sessiyalarda faqat --mcp-config-dan MCP serverlaridan foydalanish]' \
    '--restricted[Yuborilgan sessiyalarni cheklangan rejimda boshlash]' \
    '(-h --help)'{-h,--help}'[Buyruq uchun yordamni ko'\''rsatish]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Anthropic hisobingizga kirish'
    'logout:Anthropic hisobingizdan chiqish'
    'status:Autentifikatsiya holatini ko'\''rsatish'
    'help:Yordamni ko'\''rsatish'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Buyruq uchun yordamni ko'\''rsatish]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth commands' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Kirish sahifasida elektron pochta manzilini oldindan to'\''ldirish]:email:' \
            '--sso[SSO kirish jarayonini majburan ishlatish]' \
            '(--claudeai)--console[Claude obunasi o'\''rniga Anthropic Console-dan foydalanish (API foydalanishi bo'\''yicha hisob-kitob)]' \
            '(--console)--claudeai[Claude obunasidan foydalanish (standart)]' \
            '(-h --help)'{-h,--help}'[Buyruq uchun yordamni ko'\''rsatish]'
          ;;
        status)
          _arguments \
            '(--text)--json[JSON sifatida chiqarish (standart)]' \
            '(--json)--text[Inson o'\''qiy oladigan matn sifatida chiqarish]' \
            '(-h --help)'{-h,--help}'[Buyruq uchun yordamni ko'\''rsatish]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Buyruq uchun yordamni ko'\''rsatish]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Amaldagi avtomatik rejim konfiguratsiyasini JSON sifatida chop etish'
    'critique:Maxsus avtomatik rejim qoidalaringiz bo'\''yicha AI fikrini olish'
    'defaults:Standart avtomatik rejim qoidalarini JSON sifatida chop etish'
    'reset:Avtomatik rejim konfiguratsiyasini yetkazib berilgan standartlarga qayta tiklash'
    'help:Yordamni ko'\''rsatish'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Buyruq uchun yordamni ko'\''rsatish]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode commands' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Ishlatiladigan modelni qayta belgilash]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Buyruq uchun yordamni ko'\''rsatish]'
          ;;
        defaults)
          _arguments \
            '--label[Faqat yorlig'\''i ushbu prefiks bilan boshlanadigan qoidalarni ko'\''rsatish (katta-kichik harfga sezgir emas)]:prefix:' \
            '(-h --help)'{-h,--help}'[Buyruq uchun yordamni ko'\''rsatish]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Tasdiqlash so'\''rovini o'\''tkazib yuborish]' \
            '(-h --help)'{-h,--help}'[Buyruq uchun yordamni ko'\''rsatish]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Buyruq uchun yordamni ko'\''rsatish]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Shlyuz YAML konfiguratsiyasiga yo'\''l]:path:_files' \
    '(-h --help)'{-h,--help}'[Buyruq uchun yordamni ko'\''rsatish]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Loyiha uchun barcha Claude Code holatini o'\''chirish (transkriptlar, vazifalar, fayl tarixi, konfiguratsiya yozuvi)'
    'help:Yordamni ko'\''rsatish'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Buyruq uchun yordamni ko'\''rsatish]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project commands' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Hech narsani o'\''chirmasdan nima o'\''chirilishini ro'\''yxatlash]' \
            '(-y --yes)'{-y,--yes}'[Tasdiqlash so'\''rovini o'\''tkazib yuborish]' \
            '(-i --interactive)'{-i,--interactive}'[O'\''chirishdan oldin har bir element uchun so'\''rash]' \
            '(1)--all[Barcha loyihalar uchun holatni o'\''chirish (yo'\''l bilan birga ishlatib bo'\''lmaydi)]' \
            '(-h --help)'{-h,--help}'[Buyruq uchun yordamni ko'\''rsatish]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Formatlangan natijalar o'\''rniga xom bugs.json yukini chop etish]' \
    '--timeout[Ko'\''rik tugashini kutish uchun maksimal daqiqalar (standart: 45)]:minutes:' \
    '(--no-post)--post[Tugallangan ko'\''rik topilmalarini PR-ga sizning nomingizdan joylash (faqat PR maqsadlari; ko'\''rik emas, bitta oddiy izoh)]' \
    '(--post)--no-post[Topilmalarni PR-ga joylamaslik (standart)]' \
    '(-h --help)'{-h,--help}'[Buyruq uchun yordamni ko'\''rsatish]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Ishlayotgan barcha fon sessiyalarini qayta ishga tushirish]' \
    '(-h --help)'{-h,--help}'[Buyruq uchun yordamni ko'\''rsatish]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Worktree-ning push qilinmagan commitlari va commit qilinmagan o'\''zgarishlarini ham bekor qilish (oldingi claude rm xabar bergan commit@worktree-id ni bering)]:commit@worktree-id:' \
    '--force-remove-worktree[WorktreeRemove hooki yoki git uni o'\''chira olmagan bo'\''lsa ham worktree katalogini o'\''chirish (oldingi claude rm xabar bergan worktree-id ni bering)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Buyruq uchun yordamni ko'\''rsatish]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Hech narsa yozmasdan nima import qilinishini ko'\''rsatish]' \
    '--yes[Interaktiv tanlagichni o'\''tkazib yuborish (headless muhitlarda /import oldindan ko'\''rishidagi --yes=<digest> ni bering)]' \
    '(-h --help)'{-h,--help}'[Buyruq uchun yordamni ko'\''rsatish]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
