#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:MCP সার্ভারগুলি কনফিগার এবং পরিচালনা করুন'
    'plugin:Claude Code প্লাগইনগুলি পরিচালনা করুন'
    'agents:ব্যাকগ্রাউন্ড এজেন্ট পরিচালনা করুন'
    'attach:এই টার্মিনালে একটি ব্যাকগ্রাউন্ড সেশন খুলুন'
    'logs:একটি ব্যাকগ্রাউন্ড সেশনের সাম্প্রতিক টার্মিনাল আউটপুট প্রিন্ট করুন'
    'stop:একটি ব্যাকগ্রাউন্ড সেশন বন্ধ করুন (এর কথোপকথন রাখা হয়)'
    'respawn:একটি ব্যাকগ্রাউন্ড সেশন পুনরায় চালু করুন যাতে এটি বর্তমান Claude Code সংস্করণে চলে'
    'rm:একটি ব্যাকগ্রাউন্ড সেশন মুছুন, এবং নিরাপদ হলে এর worktree-ও মুছুন'
    'auth:প্রমাণীকরণ পরিচালনা করুন'
    'auto-mode:অটো মোড ক্লাসিফায়ার কনফিগারেশন পরিদর্শন বা রিসেট করুন'
    'gateway:এন্টারপ্রাইজ auth/telemetry গেটওয়ে চালান'
    'import:অন্য একটি AI কোডিং এজেন্ট থেকে Claude Code-এ কনফিগ আমদানি করুন'
    'project:Claude Code প্রকল্পের অবস্থা পরিচালনা করুন'
    'ultrareview:একটি ক্লাউড-হোস্টেড মাল্টি-এজেন্ট কোড পর্যালোচনা চালান এবং ফলাফল প্রিন্ট করুন'
    'setup-token:দীর্ঘমেয়াদী প্রমাণীকরণ টোকেন সেট করুন (Claude সাবস্ক্রিপশন প্রয়োজন)'
    'doctor:Claude Code অটো-আপডেটারের জন্য স্বাস্থ্য পরীক্ষা'
    'update:আপডেট পরীক্ষা করুন এবং ইনস্টল করুন'
    'install:Claude Code নেটিভ বিল্ড ইনস্টল করুন'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[ঐচ্ছিক ক্যাটাগরি ফিল্টারিং সহ ডিবাগ মোড সক্ষম করুন (যেমন, "api,hooks" বা "!statsig,!file")]:filter:'
    '--verbose[কনফিগ ফাইল থেকে ভার্বোস মোড সেটিং ওভাররাইড করুন]'
    '(-p --print)'{-p,--print}'[প্রতিক্রিয়া প্রিন্ট করুন এবং প্রস্থান করুন (পাইপের সাথে ব্যবহারের জন্য)। নোট: শুধুমাত্র বিশ্বস্ত ডিরেক্টরিতে ব্যবহার করুন]'
    '--output-format[আউটপুট ফরম্যাট (--print এর সাথে): "text" (ডিফল্ট), "json" (একক ফলাফল), বা "stream-json" (রিয়েল-টাইম স্ট্রিমিং)]:format:(text json stream-json)'
    '--json-schema[কাঠামোগত আউটপুট যাচাইকরণের জন্য JSON স্কিমা]:schema:'
    '--include-partial-messages[আংশিক বার্তা খণ্ডগুলি অন্তর্ভুক্ত করুন যেমন তারা আসে (--print এবং --output-format=stream-json এর সাথে)]'
    '--input-format[ইনপুট ফরম্যাট (--print এর সাথে): "text" (ডিফল্ট) বা "stream-json" (রিয়েল-টাইম স্ট্রিমিং ইনপুট)]:format:(text stream-json)'
    '--mcp-debug[\[অবচিত। পরিবর্তে --debug ব্যবহার করুন\] MCP ডিবাগ মোড সক্ষম করুন (MCP সার্ভার ত্রুটি দেখায়)]'
    '--dangerously-skip-permissions[সমস্ত অনুমতি পরীক্ষা বাইপাস করুন। ইন্টারনেট অ্যাক্সেস ছাড়া স্যান্ডবক্সের জন্য শুধুমাত্র সুপারিশ করা হয়]'
    '--allow-dangerously-skip-permissions[ডিফল্টভাবে সক্ষম না করে অনুমতি পরীক্ষা বাইপাস করার বিকল্পটি সক্ষম করুন]'
    '--restricted[সীমাবদ্ধ মোড: কমান্ড বা কোড চালায় এমন টুল এবং WebFetch সরান, user/project/local সেটিংস উপেক্ষা করুন, এবং ফাইল টুলগুলিকে কার্যকারী ডিরেক্টরিতে সীমাবদ্ধ রাখুন]'
    '--max-budget-usd[API কলে ব্যয় করার সর্বোচ্চ ডলার পরিমাণ (শুধুমাত্র --print)]:amount:'
    '--replay-user-messages[নিশ্চিতকরণের জন্য stdin থেকে stdout-এ ব্যবহারকারী বার্তাগুলি পুনরায় পাঠান]'
    '--allowed-tools[অনুমোদিত টুল নামের কমা বা স্পেস-বিভক্ত তালিকা (যেমন, "Bash(git:*) Edit")]:tools:'
    '--allowedTools[অনুমোদিত টুল নামের কমা বা স্পেস-বিভক্ত তালিকা (camelCase ফরম্যাট)]:tools:'
    '--tools[বিল্ট-ইন সেট থেকে উপলব্ধ টুলের তালিকা নির্দিষ্ট করুন। শুধুমাত্র প্রিন্ট মোড]:tools:'
    '--disallowed-tools[অনুমোদিত নয় এমন টুল নামের কমা বা স্পেস-বিভক্ত তালিকা (যেমন, "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[অনুমোদিত নয় এমন টুল নামের কমা বা স্পেস-বিভক্ত তালিকা (camelCase ফরম্যাট)]:tools:'
    '--mcp-config[JSON ফাইল বা স্ট্রিং থেকে MCP সার্ভার লোড করুন (স্পেস-বিভক্ত)]:configs:'
    '--system-prompt[সেশনের জন্য ব্যবহার করার জন্য সিস্টেম প্রম্পট]:prompt:'
    '--system-prompt-file[একটি ফাইল থেকে সিস্টেম প্রম্পট পড়ুন]:file:_files'
    '--append-system-prompt[ডিফল্ট সিস্টেম প্রম্পটে সিস্টেম প্রম্পট যুক্ত করুন]:prompt:'
    '--append-system-prompt-file[একটি ফাইল থেকে সিস্টেম প্রম্পট পড়ুন এবং ডিফল্ট সিস্টেম প্রম্পটে যুক্ত করুন]:file:_files'
    '--system-prompt-snapshot[প্রতি কথোপকথনে একবার সিস্টেম প্রম্পট রেকর্ড করুন এবং প্রতিটি অনুরোধ ও পুনরায় শুরুতে হুবহু পুনরায় ব্যবহার করুন (on, ডিফল্ট) অথবা প্রতিটি অনুরোধে নতুন করে রেন্ডার করুন (off)]:mode:(on off)'
    '--permission-mode[সেশনের জন্য ব্যবহার করার জন্য অনুমতি মোড]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[--print এর সাথে অনুমতি প্রম্পটের উত্তর কে দেবে: "host" (SDK হোস্ট বা --permission-prompt-tool) অথবা "none" (যা কিছু প্রম্পট করবে তা প্রত্যাখ্যাত হয়)]:target:(host none)'
    '--permission-prompt-tool[অনুমতি প্রম্পটের জন্য ব্যবহার করার MCP টুল (শুধুমাত্র --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[সবচেয়ে সাম্প্রতিক কথোপকথন চালিয়ে যান]'
    '(-r --resume)'{-r,--resume}'[একটি কথোপকথন পুনরায় শুরু করুন - সেশন ID নির্দিষ্ট করুন বা ইন্টারঅ্যাক্টিভভাবে নির্বাচন করুন]:sessionId:_claude_sessions'
    '--fork-session[পুনরায় শুরু করার সময় মূল সেশন ID পুনরায় ব্যবহার করার পরিবর্তে নতুন সেশন ID তৈরি করুন (--resume বা --continue এর সাথে)]'
    '--no-session-persistence[সেশন স্থায়িত্ব নিষ্ক্রিয় করুন - সেশনগুলি সংরক্ষণ করা হবে না (শুধুমাত্র --print)]'
    '--model[বর্তমান সেশনের জন্য মডেল। সর্বশেষ মডেলের জন্য উপনাম নির্দিষ্ট করুন (যেমন, '\''sonnet'\'' বা '\''opus'\'')]:model:_claude_model_names'
    '--agent[বর্তমান সেশনের জন্য এজেন্ট। '\''agent'\'' সেটিং ওভাররাইড করে]:agent:_claude_agent_names'
    '--betas[API অনুরোধে অন্তর্ভুক্ত করার জন্য বিটা হেডার (শুধুমাত্র API কী ব্যবহারকারী)]:betas:'
    '--fallback-model[যখন ডিফল্ট মডেল ওভারলোড হয় তখন নির্দিষ্ট মডেলে স্বয়ংক্রিয় ফলবাক সক্ষম করুন (শুধুমাত্র --print)]:model:_claude_model_names'
    '--settings[সেটিংস JSON ফাইল বা অতিরিক্ত সেটিংস লোড করার জন্য JSON স্ট্রিং এর পথ]:file-or-json:_files'
    '--add-dir[টুল অ্যাক্সেসের অনুমতি দেওয়ার জন্য অতিরিক্ত ডিরেক্টরি]:directories:_directories'
    '--ide[যদি ঠিক একটি বৈধ IDE উপলব্ধ থাকে তবে স্টার্টআপে IDE-তে অটো-সংযোগ করুন]'
    '--desktop[টার্মিনালের পরিবর্তে Claude Desktop অ্যাপে খুলুন (সেশন বেছে নিতে --continue বা --resume <id> এর সাথে)]'
    '--strict-mcp-config[শুধুমাত্র --mcp-config থেকে MCP সার্ভার ব্যবহার করুন এবং অন্যান্য সমস্ত MCP সেটিংস উপেক্ষা করুন]'
    '--session-id[কথোপকথনের জন্য ব্যবহার করার জন্য নির্দিষ্ট সেশন ID (বৈধ UUID হতে হবে)]:uuid:'
    '--agents[কাস্টম এজেন্ট সংজ্ঞায়িত করে JSON অবজেক্ট]:json:'
    '--setting-sources[লোড করার জন্য সেটিং উৎসের কমা-বিভক্ত তালিকা (user, project, local)]:sources:'
    '--plugin-dir[শুধুমাত্র এই সেশনের জন্য প্লাগইন লোড করার জন্য ডিরেক্টরি (পুনরাবৃত্তিযোগ্য)]:paths:_directories'
    '--disable-slash-commands[সমস্ত স্ল্যাশ কমান্ড নিষ্ক্রিয় করুন]'
    '(--bg --background)'{--bg,--background}'[ব্যাকগ্রাউন্ড এজেন্ট হিসাবে সেশন শুরু করুন এবং অবিলম্বে ফিরে আসুন]'
    '(-w --worktree)'{-w,--worktree}'[এই সেশনের জন্য একটি নতুন git worktree তৈরি করুন (ঐচ্ছিকভাবে একটি নাম নির্দিষ্ট করুন)]::name:'
    '--tmux=-[worktree-এর জন্য একটি tmux সেশন তৈরি করুন (--worktree প্রয়োজন)। উপলব্ধ থাকলে iTerm2 নেটিভ প্যান ব্যবহার করে; প্রচলিত tmux-এর জন্য --tmux=classic]::mode:(classic)'
    '(-n --name)'{-n,--name}'[এই সেশনের জন্য একটি প্রদর্শন নাম সেট করুন]:name:'
    '--effort[বর্তমান সেশনের জন্য প্রচেষ্টার স্তর]:level:(low medium high xhigh max)'
    '--autocompact[অটো-কমপ্যাক্ট উইন্ডোর আকার (auto, অথবা 100k-1M টোকেন)]:size:(auto)'
    '--debug-file[একটি নির্দিষ্ট ফাইল পথে ডিবাগ লগ লিখুন (অন্তর্নিহিতভাবে ডিবাগ মোড সক্ষম করে)]:path:_files'
    '--from-pr[নম্বর/URL দ্বারা একটি PR-এর সাথে সংযুক্ত সেশন পুনরায় শুরু করুন, বা ইন্টারঅ্যাক্টিভ পিকার খুলুন]::value:'
    '--teleport[একটি teleport সেশন পুনরায় শুরু করুন, ঐচ্ছিকভাবে সেশন ID নির্দিষ্ট করুন]::session:'
    '--cloud[প্রদত্ত বিবরণ সহ একটি ক্লাউড সেশন তৈরি করুন, অথবা সেশন ID বা claude.ai/code URL দ্বারা একটি বিদ্যমান সেশনে সংযুক্ত হন]::description-or-session:'
    '--environment[প্রদত্ত সেলফ-হোস্টেড পরিবেশে (ccpool_...) চলে এমন একটি নতুন ক্লাউড সেশন তৈরি করুন]:environment_id:'
    '--remote-control[Remote Control সক্ষম সহ একটি ইন্টারঅ্যাক্টিভ সেশন শুরু করুন (ঐচ্ছিকভাবে নামযুক্ত)]::name:'
    '--remote-control-session-name-prefix[স্বয়ংক্রিয়ভাবে তৈরি Remote Control সেশন নামের জন্য উপসর্গ]:prefix:'
    '--chrome[Chrome ইন্টিগ্রেশনে Claude সক্ষম করুন]'
    '--no-chrome[Chrome ইন্টিগ্রেশনে Claude নিষ্ক্রিয় করুন]'
    '--plugin-url[শুধুমাত্র এই সেশনের জন্য একটি URL থেকে একটি প্লাগইন .zip আনুন (পুনরাবৃত্তিযোগ্য)]:url:'
    '--file[স্টার্টআপে ডাউনলোড করার জন্য ফাইল রিসোর্স (ফরম্যাট: file_id:relative_path)]:specs:'
    '--prompt-suggestions[প্রম্পট পরামর্শ সক্ষম করুন (print/SDK মোডে একটি পূর্বাভাসিত পরবর্তী প্রম্পট নির্গত করে)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[সাবএজেন্ট টেক্সট এবং চিন্তা ব্লকগুলি বার্তা হিসাবে ফরওয়ার্ড করুন (--print এবং stream-json এর সাথে)]'
    '--include-hook-events[আউটপুট স্ট্রিমে সমস্ত হুক লাইফসাইকেল ইভেন্ট অন্তর্ভুক্ত করুন (stream-json এর সাথে)]'
    '--exclude-dynamic-system-prompt-sections[প্রম্পট-ক্যাশ পুনঃব্যবহার উন্নত করতে প্রতি-মেশিন বিভাগগুলি প্রথম ব্যবহারকারী বার্তায় সরান]'
    '--brief[এজেন্ট-থেকে-ব্যবহারকারী যোগাযোগের জন্য SendUserMessage টুল সক্ষম করুন]'
    '--safe-mode[সমস্ত কাস্টমাইজেশন নিষ্ক্রিয় করে শুরু করুন (একটি ভাঙা কনফিগারেশন সমস্যা সমাধানের জন্য উপযোগী)]'
    '--bare[ন্যূনতম মোড: হুক, LSP, প্লাগইন সিঙ্ক, অ্যাট্রিবিউশন, অটো-মেমরি, এবং CLAUDE.md অটো-আবিষ্কার এড়িয়ে যান]'
    '--ax-screen-reader[স্ক্রিন-রিডার বান্ধব আউটপুট রেন্ডার করুন (সমতল টেক্সট, কোনো আলংকারিক সীমানা বা অ্যানিমেশন নেই)]'
    '(-v --version)'{-v,--version}'[সংস্করণ নম্বর আউটপুট করুন]'
    '(-h --help)'{-h,--help}'[কমান্ডের জন্য সহায়তা প্রদর্শন করুন]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude commands' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[কমান্ডের জন্য সহায়তা প্রদর্শন করুন]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "no arguments"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:একটি Claude Code MCP সার্ভার শুরু করুন'
    'add:Claude Code-এ একটি MCP সার্ভার যুক্ত করুন'
    'remove:একটি MCP সার্ভার সরান'
    'list:কনফিগার করা MCP সার্ভারের তালিকা করুন'
    'get:MCP সার্ভার বিশদ পান'
    'add-json:JSON স্ট্রিং সহ একটি MCP সার্ভার (stdio বা SSE) যুক্ত করুন'
    'add-from-claude-desktop:Claude Desktop থেকে MCP সার্ভার আমদানি করুন (শুধুমাত্র Mac এবং WSL)'
    'reset-project-choices:এই প্রকল্পে সমস্ত অনুমোদিত/প্রত্যাখ্যাত প্রকল্প-স্কোপড (.mcp.json) সার্ভার রিসেট করুন'
    'login:একটি MCP সার্ভারের সাথে প্রমাণীকরণ করুন (HTTP, SSE, বা claude.ai কানেক্টর)'
    'logout:একটি MCP সার্ভারের জন্য সংরক্ষিত OAuth শংসাপত্র সাফ করুন'
    'help:সহায়তা প্রদর্শন করুন'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp commands' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[ডিবাগ মোড সক্ষম করুন]' \
            '--verbose[কনফিগ ফাইল থেকে ভার্বোস মোড সেটিং ওভাররাইড করুন]' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[কনফিগ স্কোপ (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[পরিবহন প্রকার (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[পরিবেশ ভেরিয়েবল সেট করুন (যেমন, -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[WebSocket হেডার সেট করুন]:header:' \
            '--client-id[HTTP/SSE সার্ভারের জন্য OAuth ক্লায়েন্ট ID]:clientId:' \
            '--client-secret[OAuth ক্লায়েন্ট সিক্রেটের জন্য প্রম্পট করুন (অথবা MCP_CLIENT_SECRET পরিবেশ ভেরিয়েবল সেট করুন)]' \
            '--callback-port[OAuth কলব্যাকের জন্য নির্দিষ্ট পোর্ট (পূর্ব-নিবন্ধিত রিডাইরেক্ট URI প্রয়োজন এমন সার্ভারের জন্য)]:port:' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[কনফিগ স্কোপ (local, user, project) - অনির্দিষ্ট থাকলে বিদ্যমান স্কোপ থেকে সরান]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[কনফিগ স্কোপ (local, user, project)]:scope:(local user project)' \
            '--client-secret[OAuth ক্লায়েন্ট সিক্রেটের জন্য প্রম্পট করুন (অথবা MCP_CLIENT_SECRET পরিবেশ ভেরিয়েবল সেট করুন)]' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[কনফিগ স্কোপ (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]'
          ;;
        login)
          _arguments \
            '--no-browser[ব্রাউজার খোলার পরিবর্তে অনুমোদন URL প্রিন্ট করুন (SSH/হেডলেস সেশনের জন্য)]' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:একটি প্লাগইন বা মার্কেটপ্লেস ম্যানিফেস্ট যাচাই করুন'
    'marketplace:Claude Code মার্কেটপ্লেস পরিচালনা করুন'
    'list:ইনস্টল করা প্লাগইনগুলির তালিকা করুন'
    'details:একটি প্লাগইনের জন্য কম্পোনেন্ট ইনভেন্টরি এবং প্রক্ষেপিত টোকেন খরচ দেখান'
    'configure:একটি প্লাগইনের অপশন এবং কোনগুলি সেট করা নেই তা দেখান, অথবা stdin থেকে মান সংরক্ষণ করুন'
    'install:উপলব্ধ মার্কেটপ্লেস থেকে একটি প্লাগইন ইনস্টল করুন'
    'i:উপলব্ধ মার্কেটপ্লেস থেকে একটি প্লাগইন ইনস্টল করুন (install এর সংক্ষিপ্ত)'
    'init:একটি নতুন প্লাগইন স্ক্যাফোল্ড করুন (পরবর্তী সেশনে অটো-লোড হয়)'
    'new:একটি নতুন প্লাগইন স্ক্যাফোল্ড করুন (init এর উপনাম)'
    'uninstall:একটি ইনস্টল করা প্লাগইন আনইনস্টল করুন'
    'remove:একটি ইনস্টল করা প্লাগইন আনইনস্টল করুন (uninstall এর উপনাম)'
    'enable:একটি নিষ্ক্রিয় প্লাগইন সক্ষম করুন'
    'disable:একটি সক্রিয় প্লাগইন নিষ্ক্রিয় করুন'
    'update:একটি প্লাগইন সর্বশেষ সংস্করণে আপডেট করুন'
    'eval:একটি প্লাগইনের বিরুদ্ধে eval কেস চালান এবং স্কোর করা ফলাফল রিপোর্ট করুন'
    'prune:আর প্রয়োজন নেই এমন অটো-ইনস্টল করা নির্ভরতা সরান'
    'autoremove:আর প্রয়োজন নেই এমন অটো-ইনস্টল করা নির্ভরতা সরান (prune এর উপনাম)'
    'tag:একটি প্লাগইন রিলিজের জন্য একটি {name}--v{version} git ট্যাগ তৈরি করুন'
    'test:একটি mod-এর পরীক্ষাগুলি চালান'
    'help:সহায়তা প্রদর্শন করুন'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin commands' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[সতর্কতাগুলিকে ত্রুটি হিসাবে গণ্য করুন (এক্সিট কোড 1)]' \
            '--json[যাচাইকরণ রিপোর্ট JSON হিসাবে আউটপুট করুন (একই এক্সিট কোড)]' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ইনস্টলেশন স্কোপ]:scope:(user project local)' \
            '*--config[প্লাগইন ম্যানিফেস্টে ঘোষিত একটি userConfig অপশন সেট করুন (পুনরাবৃত্তিযোগ্য)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[নিশ্চিতকরণ প্রম্পট ছাড়াই প্রদর্শিত মার্কেটপ্লেস-ঘোষিত কমান্ড গ্রহণ করুন]' \
            '--json[মানুষের জন্য বার্তার পরিবর্তে একটি মেশিন-পাঠযোগ্য ফলাফল লাইন প্রিন্ট করুন]' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ইনস্টলেশন স্কোপ]:scope:(user project local)' \
            '--keep-data[প্লাগইনের স্থায়ী ডেটা ডিরেক্টরি সংরক্ষণ করুন]' \
            '--prune[আর প্রয়োজন নেই এমন অটো-ইনস্টল করা নির্ভরতাগুলিও সরান]' \
            '(-y --yes)'{-y,--yes}'[--prune নিশ্চিতকরণ প্রম্পট এড়িয়ে যান]' \
            '--json[মানুষের জন্য বার্তার পরিবর্তে একটি মেশিন-পাঠযোগ্য ফলাফল লাইন প্রিন্ট করুন (--prune এর সাথে নয়)]' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ইনস্টলেশন স্কোপ]:scope:(user project local)' \
            '--json[মানুষের জন্য বার্তার পরিবর্তে একটি মেশিন-পাঠযোগ্য ফলাফল লাইন প্রিন্ট করুন]' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[সমস্ত সক্রিয় প্লাগইন নিষ্ক্রিয় করুন]' \
            '(-s --scope)'{-s,--scope}'[ইনস্টলেশন স্কোপ]:scope:(user project local)' \
            '--json[মানুষের জন্য বার্তার পরিবর্তে একটি মেশিন-পাঠযোগ্য ফলাফল লাইন প্রিন্ট করুন]' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ইনস্টলেশন স্কোপ]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[নিশ্চিতকরণ প্রম্পট ছাড়াই প্রদর্শিত মার্কেটপ্লেস-ঘোষিত কমান্ড গ্রহণ করুন]' \
            '--json[মানুষের জন্য বার্তার পরিবর্তে একটি মেশিন-পাঠযোগ্য ফলাফল লাইন প্রিন্ট করুন]' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[JSON হিসাবে আউটপুট করুন]' \
            '--available[মার্কেটপ্লেস থেকে উপলব্ধ প্লাগইনগুলি অন্তর্ভুক্ত করুন (--json প্রয়োজন)]' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[এই স্কোপে প্রুন করুন]:scope:(user project local)' \
            '--dry-run[না সরিয়ে কী সরানো হবে তার তালিকা করুন]' \
            '(-y --yes)'{-y,--yes}'[নিশ্চিতকরণ প্রম্পট এড়িয়ে যান]' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]'
          ;;
        configure)
          _arguments \
            '--json[JSON হিসাবে আউটপুট করুন]' \
            '--values-stdin[stdin থেকে একক-লাইন স্ট্রিংয়ের একটি JSON অবজেক্ট হিসাবে অপশনের মান পড়ুন; বাদ দেওয়া অপশনগুলি তাদের মান বজায় রাখে]' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[ম্যানিফেস্ট বিবরণ]:text:' \
            '--author[লেখকের নাম (ডিফল্ট: git config user.name)]:name:' \
            '--author-email[লেখকের ইমেল (ডিফল্ট: git config user.email)]:email:' \
            '--with[এর সাথে স্ক্যাফোল্ড করার জন্য কম্পোনেন্ট]:components:' \
            '(-f --force)'{-f,--force}'[লক্ষ্যে বিদ্যমান .claude-plugin/ ওভাররাইট করুন]' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[নামের glob দ্বারা কেস ফিল্টার করুন]:glob:' \
            '*--tag[ট্যাগ দ্বারা কেস ফিল্টার করুন (পুনরাবৃত্তিযোগ্য)]:tag:' \
            '--runs[প্রতি-কেস রানের সংখ্যা ওভাররাইড করুন (ডিফল্ট: case.runs, অন্যথায় 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[একসাথে সর্বোচ্চ n টি এজেন্ট রান চালান (1-8; ডিফল্ট 1)]:n:' \
            '--model[সমস্ত কেসের জন্য মডেল ওভাররাইড করুন]:model:_claude_model_names' \
            '--judge-model[LLM-গ্রেডার মডেল ওভাররাইড করুন (ডিফল্ট: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[খরচের কঠোর ঊর্ধ্বসীমা; পৌঁছালে বাতিল করুন এবং আংশিক ফলাফল রিপোর্ট করুন (এক্সিট কোড 2)]:usd:' \
            '--output-dir[aggregate-result.json এর জন্য ডিরেক্টরি]:dir:_directories' \
            '--eval-dir[eval কেসগুলি ধারণকারী ডিরেক্টরির নাম (প্লাগইনের অধীনে)]:dir:' \
            '--json[সম্পূর্ণ রানের ফলাফল JSON হিসাবে stdout-এ প্রিন্ট করুন, অথবা এই .json ফাইলে লিখুন]::path:_files' \
            '--threshold[কোনো কেসের স্কোর এই থ্রেশহোল্ডের নিচে হলে এক্সিট কোড 1 দিয়ে প্রস্থান করুন (ডিফল্ট: 1.0)]:threshold:' \
            '*--allow-tools[সুরক্ষিত টুলগুলির জন্য অপারেটর অনুমতি (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[প্রতিটি কেসের scaffold_script চালান (লেখক-প্রদত্ত bash আপনার নামে চালায়; ডিফল্টভাবে বন্ধ)]' \
            '(--scaffold)--no-scaffold[স্পষ্টভাবে scaffold_script এড়িয়ে যান]' \
            '--trust-plugin[নিশ্চিত করুন যে আপনি এই প্লাগইন এবং এর eval স্যুটকে বিশ্বাস করেন, প্রথম রানের বিশ্বাস প্রম্পট এড়িয়ে (CI-এর জন্য)]' \
            '--ablation[প্লাগইন ছাড়া একটি বেসলাইন তুলনামূলক গ্রুপ চালান এবং স্কোরের পার্থক্য রিপোর্ট করুন]:mode:(none with-without)' \
            '--mocks[MCP সার্ভারের জন্য মক বিকল্প, <eval dir>/mocks/ থেকে]:mode:(record off)' \
            '--allow-real-servers[--mocks record এর সাথে: মক নেই এমন আসল MCP সার্ভার প্রক্রিয়াগুলিও শুরু করুন]' \
            '--keep-temp[ডিবাগিংয়ের জন্য স্ক্যাফোল্ড ডিরেক্টরি সংরক্ষণ করুন]' \
            '--verbose[ডিবাগ লগে প্রতি-বার্তা ট্রেস ইভেন্ট লগ করুন]' \
            '--report[ফলাফল ডিরেক্টরির পরিবর্তে এই পথে স্বয়ংসম্পূর্ণ HTML রিপোর্ট লিখুন]:path:_files' \
            '(--no-publish)--publish-report[claude.ai-তে রিপোর্ট প্রকাশ করাও আবশ্যক করুন]' \
            '(--publish-report)--no-publish[HTML রিপোর্ট শুধুমাত্র স্থানীয় রাখুন; claude.ai-তে প্রকাশ করা এড়িয়ে যান]' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[তৈরি করার পরে ট্যাগটি --remote-এ পুশ করুন]' \
            '--dry-run[তৈরি না করে কী ট্যাগ করা হবে তা প্রিন্ট করুন]' \
            '(-f --force)'{-f,--force}'[অপরিচ্ছন্ন ওয়ার্কিং ট্রি এবং ট্যাগ-ইতিমধ্যে-বিদ্যমান পরীক্ষাগুলি এড়িয়ে যান]' \
            '(-m --message)'{-m,--message}'[ট্যাগ অ্যানোটেশন বার্তা (সংস্করণের জন্য %s ব্যবহার করুন)]:msg:' \
            '--remote[--push এর সাথে যে রিমোটে পুশ করা হবে]:name:' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:URL, পথ, বা GitHub রিপোজিটরি থেকে একটি মার্কেটপ্লেস যুক্ত করুন'
    'list:কনফিগার করা মার্কেটপ্লেসের তালিকা করুন'
    'remove:একটি কনফিগার করা মার্কেটপ্লেস সরান'
    'rm:একটি কনফিগার করা মার্কেটপ্লেস সরান (remove এর উপনাম)'
    'update:উৎস থেকে মার্কেটপ্লেস আপডেট করুন - কোনো নাম নির্দিষ্ট না থাকলে সব আপডেট করুন'
    'help:সহায়তা প্রদর্শন করুন'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace commands' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[git sparse-checkout এর মাধ্যমে নির্দিষ্ট ডিরেক্টরিতে চেকআউট সীমাবদ্ধ করুন (মনোরেপোর জন্য)]:paths:' \
            '--scope[মার্কেটপ্লেস কোথায় ঘোষণা করা হবে]:scope:(user project local)' \
            '--claudeai[claude.ai আপনার জন্য হোস্ট করে এমন এই নামের মার্কেটপ্লেস যুক্ত করুন]' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[JSON হিসাবে আউটপুট করুন]' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]'
          ;;
        remove|rm)
          _arguments \
            '--scope[একটি নির্দিষ্ট সেটিংস স্কোপ থেকে মার্কেটপ্লেস ঘোষণা সরান (প্রতিটি স্কোপ থেকে সরাতে বাদ দিন)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[আগে থেকে ইনস্টল থাকলেও ফোর্স ইনস্টল করুন]' \
    '(-h --help)'{-h,--help}'[সহায়তা প্রদর্শন করুন]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[প্রেরিত সেশনে টুল অ্যাক্সেসের অনুমতি দেওয়ার জন্য অতিরিক্ত ডিরেক্টরি]:directory:_directories' \
    '--agent[এজেন্ট ভিউ থেকে প্রেরিত সেশনের জন্য ডিফল্ট এজেন্ট]:agent:_claude_agent_names' \
    '--all[--json এর সাথে: সম্পন্ন ব্যাকগ্রাউন্ড সেশনগুলিও অন্তর্ভুক্ত করুন]' \
    '--allow-dangerously-skip-permissions[প্রেরিত সেশনে বাইপাস-অনুমতি মোড উপলব্ধ করুন]' \
    '--cwd[শুধুমাত্র পথের অধীনে শুরু হওয়া ব্যাকগ্রাউন্ড সেশন দেখান]:path:_directories' \
    '--dangerously-skip-permissions[--permission-mode bypassPermissions এর উপনাম]' \
    '--effort[প্রেরিত সেশনের জন্য ডিফল্ট প্রচেষ্টার স্তর]:level:(low medium high xhigh max)' \
    '--json[সক্রিয় সেশনগুলি একটি JSON অ্যারে হিসাবে প্রিন্ট করুন এবং প্রস্থান করুন]' \
    '*--mcp-config[প্রেরিত সেশনে প্রয়োগ করার জন্য MCP সার্ভার কনফিগারেশন]:config:' \
    '--model[এজেন্ট ভিউ থেকে প্রেরিত সেশনের জন্য ডিফল্ট মডেল]:model:_claude_model_names' \
    '--permission-mode[প্রেরিত সেশনের জন্য ডিফল্ট অনুমতি মোড]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[এজেন্ট ভিউ এবং প্রেরিত সেশনের জন্য ডিরেক্টরি থেকে প্লাগইন লোড করুন]:path:_directories' \
    '--setting-sources[লোড করার জন্য সেটিং উৎসের কমা-বিভক্ত তালিকা (user, project, local)]:sources:' \
    '--settings[প্রয়োগ করার জন্য সেটিংস ফাইল বা JSON স্ট্রিং]:file-or-json:_files' \
    '--strict-mcp-config[প্রেরিত সেশনে শুধুমাত্র --mcp-config থেকে MCP সার্ভার ব্যবহার করুন]' \
    '--restricted[প্রেরিত সেশনগুলি সীমাবদ্ধ মোডে শুরু করুন]' \
    '(-h --help)'{-h,--help}'[কমান্ডের জন্য সহায়তা প্রদর্শন করুন]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:আপনার Anthropic অ্যাকাউন্টে সাইন ইন করুন'
    'logout:আপনার Anthropic অ্যাকাউন্ট থেকে লগ আউট করুন'
    'status:প্রমাণীকরণ অবস্থা দেখান'
    'help:সহায়তা প্রদর্শন করুন'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[কমান্ডের জন্য সহায়তা প্রদর্শন করুন]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth commands' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[লগইন পৃষ্ঠায় ইমেল ঠিকানা আগে থেকে পূরণ করুন]:email:' \
            '--sso[SSO লগইন প্রবাহ বাধ্যতামূলক করুন]' \
            '(--claudeai)--console[Claude সাবস্ক্রিপশনের পরিবর্তে Anthropic Console (API ব্যবহার বিলিং) ব্যবহার করুন]' \
            '(--console)--claudeai[Claude সাবস্ক্রিপশন ব্যবহার করুন (ডিফল্ট)]' \
            '(-h --help)'{-h,--help}'[কমান্ডের জন্য সহায়তা প্রদর্শন করুন]'
          ;;
        status)
          _arguments \
            '(--text)--json[JSON হিসাবে আউটপুট করুন (ডিফল্ট)]' \
            '(--json)--text[মানুষের পাঠযোগ্য টেক্সট হিসাবে আউটপুট করুন]' \
            '(-h --help)'{-h,--help}'[কমান্ডের জন্য সহায়তা প্রদর্শন করুন]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[কমান্ডের জন্য সহায়তা প্রদর্শন করুন]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:কার্যকর অটো মোড কনফিগ JSON হিসাবে প্রিন্ট করুন'
    'critique:আপনার কাস্টম অটো মোড নিয়মগুলিতে AI প্রতিক্রিয়া পান'
    'defaults:ডিফল্ট অটো মোড নিয়মগুলি JSON হিসাবে প্রিন্ট করুন'
    'reset:অটো মোড কনফিগারেশন প্রেরিত ডিফল্টে রিসেট করুন'
    'help:সহায়তা প্রদর্শন করুন'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[কমান্ডের জন্য সহায়তা প্রদর্শন করুন]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode commands' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[কোন মডেল ব্যবহার করা হবে তা ওভাররাইড করুন]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[কমান্ডের জন্য সহায়তা প্রদর্শন করুন]'
          ;;
        defaults)
          _arguments \
            '--label[শুধুমাত্র সেই নিয়মগুলি দেখান যাদের লেবেল এই উপসর্গ দিয়ে শুরু হয় (কেস-অসংবেদনশীল)]:prefix:' \
            '(-h --help)'{-h,--help}'[কমান্ডের জন্য সহায়তা প্রদর্শন করুন]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[নিশ্চিতকরণ প্রম্পট এড়িয়ে যান]' \
            '(-h --help)'{-h,--help}'[কমান্ডের জন্য সহায়তা প্রদর্শন করুন]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[কমান্ডের জন্য সহায়তা প্রদর্শন করুন]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[গেটওয়ে YAML কনফিগের পথ]:path:_files' \
    '(-h --help)'{-h,--help}'[কমান্ডের জন্য সহায়তা প্রদর্শন করুন]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:একটি প্রকল্পের জন্য সমস্ত Claude Code অবস্থা মুছুন (ট্রান্সক্রিপ্ট, টাস্ক, ফাইল ইতিহাস, কনফিগ এন্ট্রি)'
    'help:সহায়তা প্রদর্শন করুন'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[কমান্ডের জন্য সহায়তা প্রদর্শন করুন]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project commands' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[কিছু না মুছে কী মুছে ফেলা হবে তার তালিকা করুন]' \
            '(-y --yes)'{-y,--yes}'[নিশ্চিতকরণ প্রম্পট এড়িয়ে যান]' \
            '(-i --interactive)'{-i,--interactive}'[মুছে ফেলার আগে প্রতিটি আইটেমের জন্য প্রম্পট করুন]' \
            '(1)--all[প্রতিটি প্রকল্পের অবস্থা মুছুন (একটি পথের সাথে পারস্পরিকভাবে একচেটিয়া)]' \
            '(-h --help)'{-h,--help}'[কমান্ডের জন্য সহায়তা প্রদর্শন করুন]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[ফরম্যাট করা ফলাফলের পরিবর্তে কাঁচা bugs.json পেলোড প্রিন্ট করুন]' \
    '--timeout[পর্যালোচনা শেষ হওয়ার জন্য অপেক্ষা করার সর্বোচ্চ মিনিট (ডিফল্ট: 45)]:minutes:' \
    '(--no-post)--post[সম্পন্ন পর্যালোচনার ফলাফল আপনার নামে PR-এ পোস্ট করুন (শুধুমাত্র PR লক্ষ্যের জন্য; একটি সাধারণ মন্তব্য, পর্যালোচনা নয়)]' \
    '(--post)--no-post[ফলাফল PR-এ পোস্ট করবেন না (ডিফল্ট)]' \
    '(-h --help)'{-h,--help}'[কমান্ডের জন্য সহায়তা প্রদর্শন করুন]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[চলমান প্রতিটি ব্যাকগ্রাউন্ড সেশন পুনরায় চালু করুন]' \
    '(-h --help)'{-h,--help}'[কমান্ডের জন্য সহায়তা প্রদর্শন করুন]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[worktree-এর পুশ না করা কমিট এবং কমিট না করা পরিবর্তনগুলিও বাতিল করুন (পূর্ববর্তী claude rm যে commit@worktree-id রিপোর্ট করেছে তা দিন)]:commit@worktree-id:' \
    '--force-remove-worktree[WorktreeRemove হুক বা git সরাতে না পারলেও worktree ডিরেক্টরি মুছুন (পূর্ববর্তী claude rm যে worktree-id রিপোর্ট করেছে তা দিন)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[কমান্ডের জন্য সহায়তা প্রদর্শন করুন]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[কিছু না লিখে কী আমদানি করা হবে তা দেখান]' \
    '--yes[ইন্টারঅ্যাক্টিভ পিকার এড়িয়ে যান (হেডলেস পরিবেশে, /import প্রিভিউ থেকে --yes=<digest> দিন)]' \
    '(-h --help)'{-h,--help}'[কমান্ডের জন্য সহায়তা প্রদর্শন করুন]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
