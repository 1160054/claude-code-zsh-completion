#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Konfiguro dhe menaxho serverët MCP'
    'plugin:Menaxho shtojcat e Claude Code'
    'agents:Menaxho agjentët në sfond'
    'attach:Hap një sesion në sfond në këtë terminal'
    'logs:Printo daljen e fundit të terminalit të një sesioni në sfond'
    'stop:Ndalo një sesion në sfond (biseda e tij ruhet)'
    'respawn:Rinis një sesion në sfond që të ekzekutojë versionin aktual të Claude Code'
    'rm:Fshi një sesion në sfond, dhe pemën e tij të punës kur kjo është e sigurt'
    'auth:Menaxho vërtetimin'
    'auto-mode:Inspekto ose rivendos konfigurimin e klasifikuesit të modalitetit automatik'
    'gateway:Ekzekuto portën e vërtetimit/telemetrisë së ndërmarrjes'
    'import:Importo konfigurimin nga një agjent tjetër kodimi me IA në Claude Code'
    'project:Menaxho gjendjen e projektit të Claude Code'
    'ultrareview:Ekzekuto një rishikim kodi me shumë agjentë të strehuar në re dhe printo gjetjet'
    'setup-token:Konfiguro token vërtetimi afatgjatë (kërkon abonim në Claude)'
    'doctor:Kontroll shëndeti për përditësuesin automatik të Claude Code'
    'update:Kontrollo dhe instalo përditësimet'
    'install:Instalo ndërtimin vendas të Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Aktivizo modalitetin e korrigjimit me filtrim opsional kategorish (p.sh., "api,hooks" ose "!statsig,!file")]:filter:'
    '--verbose[Anashkalo cilësimin e modalitetit të hollësishëm nga skedari i konfigurimit]'
    '(-p --print)'{-p,--print}'[Printo përgjigjen dhe dil (për përdorim me tuba). Shënim: përdor vetëm në direktori të besuara]'
    '--output-format[Formati i daljes (me --print): "text" (parazgjedhje), "json" (rezultat i vetëm), ose "stream-json" (transmetim në kohë reale)]:format:(text json stream-json)'
    '--json-schema[Skema JSON për vërtetimin e daljes së strukturuar]:schema:'
    '--include-partial-messages[Përfshi copat e pjesshme të mesazheve kur mbërrijnë (me --print dhe --output-format=stream-json)]'
    '--input-format[Formati i hyrjes (me --print): "text" (parazgjedhje) ose "stream-json" (hyrje transmetimi në kohë reale)]:format:(text stream-json)'
    '--mcp-debug[\[E vjetruar. Përdor --debug në vend të saj\] Aktivizo modalitetin e korrigjimit MCP (shfaq gabimet e serverit MCP)]'
    '--dangerously-skip-permissions[Anashkalo të gjitha kontrollet e lejeve. Rekomandohet vetëm për mjedise të izoluara pa qasje në internet]'
    '--allow-dangerously-skip-permissions[Aktivizo opsionin për të anashkaluar kontrollet e lejeve pa e aktivizuar si parazgjedhje]'
    '--restricted[Modaliteti i kufizuar: hiq mjetet që ekzekutojnë komanda ose kod dhe WebFetch, injoro cilësimet user/project/local, dhe kufizo mjetet e skedarëve në direktoritë e punës]'
    '--max-budget-usd[Shuma maksimale në dollarë për të shpenzuar në thirrjet API (vetëm --print)]:amount:'
    '--replay-user-messages[Ridërgo mesazhet e përdoruesit nga stdin në stdout për konfirmim]'
    '--allowed-tools[Listë e ndarë me presje ose hapësira e emrave të mjeteve të lejuara (p.sh., "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Listë e ndarë me presje ose hapësira e emrave të mjeteve të lejuara (formati camelCase)]:tools:'
    '--tools[Specifiko listën e mjeteve të disponueshme nga grupi i integruar. Vetëm modaliteti print]:tools:'
    '--disallowed-tools[Listë e ndarë me presje ose hapësira e emrave të mjeteve të palejuara (p.sh., "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Listë e ndarë me presje ose hapësira e emrave të mjeteve të palejuara (formati camelCase)]:tools:'
    '--mcp-config[Ngarko serverët MCP nga skedari ose vargu JSON (të ndara me hapësira)]:configs:'
    '--system-prompt[Kërkesa e sistemit për përdorim në sesion]:prompt:'
    '--system-prompt-file[Lexo kërkesën e sistemit nga një skedar]:file:_files'
    '--append-system-prompt[Shto kërkesën e sistemit te kërkesa e paracaktuar e sistemit]:prompt:'
    '--append-system-prompt-file[Lexo kërkesën e sistemit nga një skedar dhe shtoje te kërkesa e paracaktuar e sistemit]:file:_files'
    '--system-prompt-snapshot[Regjistro kërkesën e sistemit një herë për bisedë dhe ripërdore fjalë për fjalë në çdo kërkesë dhe rifillim (on, parazgjedhje) ose gjeneroje nga e para në çdo kërkesë (off)]:mode:(on off)'
    '--permission-mode[Modaliteti i lejeve për përdorim në sesion]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Kush u përgjigjet kërkesave për leje me --print: "host" (hosti SDK ose --permission-prompt-tool) ose "none" (çdo gjë që do të kërkonte leje refuzohet)]:target:(host none)'
    '--permission-prompt-tool[Mjeti MCP për përdorim në kërkesat për leje (vetëm --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Vazhdo bisedën më të fundit]'
    '(-r --resume)'{-r,--resume}'[Rifillo një bisedë - specifiko ID-në e sesionit ose zgjidh në mënyrë interaktive]:sessionId:_claude_sessions'
    '--fork-session[Krijo ID të re sesioni në vend të ripërdorimit të ID-së origjinale të sesionit gjatë rifillimit (me --resume ose --continue)]'
    '--no-session-persistence[Çaktivizo qëndrueshmërinë e sesionit - sesionet nuk do të ruhen (vetëm --print)]'
    '--model[Modeli për sesionin aktual. Specifiko pseudonimin për modelin më të fundit (p.sh., '\''sonnet'\'' ose '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agjenti për sesionin aktual. Anashkalon cilësimin '\''agent'\'']:agent:_claude_agent_names'
    '--betas[Kokat beta për përfshirje në kërkesat API (vetëm përdoruesit me çelës API)]:betas:'
    '--fallback-model[Aktivizo kthimin automatik te modeli i specifikuar kur modeli i paracaktuar është i mbingarkuar (vetëm --print)]:model:_claude_model_names'
    '--settings[Shtegu te skedari JSON i cilësimeve ose vargu JSON për ngarkimin e cilësimeve shtesë]:file-or-json:_files'
    '--add-dir[Direktori shtesë për të lejuar qasjen e mjeteve]:directories:_directories'
    '--ide[Lidhu automatikisht me IDE-në në nisje nëse është i disponueshëm saktësisht një IDE i vlefshëm]'
    '--desktop[Hap në aplikacionin Claude Desktop në vend të terminalit (me --continue ose --resume <id> për të zgjedhur sesionin)]'
    '--strict-mcp-config[Përdor vetëm serverët MCP nga --mcp-config dhe injoro të gjitha cilësimet e tjera MCP]'
    '--session-id[ID specifike sesioni për përdorim në bisedë (duhet të jetë UUID i vlefshëm)]:uuid:'
    '--agents[Objekt JSON që përcakton agjentë të personalizuar]:json:'
    '--setting-sources[Listë e ndarë me presje e burimeve të cilësimeve për ngarkim (user, project, local)]:sources:'
    '--plugin-dir[Direktoria nga e cila ngarkohen shtojcat vetëm për këtë sesion (e përsëritshme)]:paths:_directories'
    '--disable-slash-commands[Çaktivizo të gjitha komandat me vijë të pjerrët]'
    '(--bg --background)'{--bg,--background}'[Nis sesionin si agjent në sfond dhe kthehu menjëherë]'
    '(-w --worktree)'{-w,--worktree}'[Krijo një pemë pune git të re për këtë sesion (opsionalisht specifiko një emër)]::name:'
    '--tmux=-[Krijo një sesion tmux për pemën e punës (kërkon --worktree). Përdor panelet vendase të iTerm2 kur janë të disponueshme; --tmux=classic për tmux tradicional]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Vendos një emër shfaqjeje për këtë sesion]:name:'
    '--effort[Niveli i përpjekjes për sesionin aktual]:level:(low medium high xhigh max)'
    '--autocompact[Madhësia e dritares së ngjeshjes automatike (auto, ose 100k-1M token-a)]:size:(auto)'
    '--debug-file[Shkruaj regjistrat e korrigjimit në një shteg specifik skedari (aktivizon në mënyrë të nënkuptuar modalitetin e korrigjimit)]:path:_files'
    '--from-pr[Rifillo një sesion të lidhur me një PR sipas numrit/URL-së, ose hap zgjedhësin interaktiv]::value:'
    '--teleport[Rifillo një sesion teleport, opsionalisht specifiko ID-në e sesionit]::session:'
    '--cloud[Krijo një sesion në re me përshkrimin e dhënë, ose lidhu me një ekzistues sipas ID-së së sesionit ose URL-së claude.ai/code]::description-or-session:'
    '--environment[Krijo një sesion të ri në re që ekzekutohet në mjedisin e vetë-strehuar të dhënë (ccpool_...)]:environment_id:'
    '--remote-control[Nis një sesion interaktiv me Kontrollin në Distancë të aktivizuar (opsionalisht i emërtuar)]::name:'
    '--remote-control-session-name-prefix[Parashtesa për emrat e gjeneruar automatikisht të sesioneve të Kontrollit në Distancë]:prefix:'
    '--chrome[Aktivizo integrimin e Claude në Chrome]'
    '--no-chrome[Çaktivizo integrimin e Claude në Chrome]'
    '--plugin-url[Merr një .zip shtojce nga një URL vetëm për këtë sesion (e përsëritshme)]:url:'
    '--file[Burime skedarësh për shkarkim në nisje (formati: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Aktivizo sugjerimet e kërkesave (nxjerr një kërkesë të parashikuar të radhës në modalitetin print/SDK)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Përcill tekstin e nënagjentit dhe blloqet e menduar si mesazhe (me --print dhe stream-json)]'
    '--include-hook-events[Përfshi të gjitha ngjarjet e ciklit të jetës së hook-ut në rrjedhën e daljes (me stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Zhvendos seksionet për çdo makinë në mesazhin e parë të përdoruesit për të përmirësuar ripërdorimin e cache-it të kërkesave]'
    '--brief[Aktivizo mjetin SendUserMessage për komunikimin agjent-me-përdorues]'
    '--safe-mode[Nis me të gjitha personalizimet të çaktivizuara (i dobishëm për zgjidhjen e problemeve të një konfigurimi të prishur)]'
    '--bare[Modaliteti minimal: anashkalo hook-et, LSP, sinkronizimin e shtojcave, atribuimin, kujtesën automatike dhe zbulimin automatik të CLAUDE.md]'
    '--ax-screen-reader[Krijo dalje miqësore për lexuesin e ekranit (tekst i sheshtë, pa korniza dekorative ose animacione)]'
    '(-v --version)'{-v,--version}'[Nxjerr numrin e versionit]'
    '(-h --help)'{-h,--help}'[Shfaq ndihmën për komandën]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'komandat claude' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën për komandën]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "pa argumente"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Nis një server MCP të Claude Code'
    'add:Shto një server MCP në Claude Code'
    'remove:Hiq një server MCP'
    'list:Listo serverët MCP të konfiguruar'
    'get:Merr detajet e serverit MCP'
    'add-json:Shto një server MCP (stdio ose SSE) me varg JSON'
    'add-from-claude-desktop:Importo serverët MCP nga Claude Desktop (vetëm Mac dhe WSL)'
    'reset-project-choices:Rivendos të gjithë serverët e miratuar/refuzuar me shtrirje projekti (.mcp.json) në këtë projekt'
    'login:Vërteto me një server MCP (HTTP, SSE, ose lidhës claude.ai)'
    'logout:Pastro kredencialet OAuth të ruajtura për një server MCP'
    'help:Shfaq ndihmën'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'komandat mcp' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Aktivizo modalitetin e korrigjimit]' \
            '--verbose[Anashkalo cilësimin e modalitetit të hollësishëm nga skedari i konfigurimit]' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Shtrirja e konfigurimit (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Lloji i transportit (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Vendos variablën e mjedisit (p.sh., -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Vendos kokën WebSocket]:header:' \
            '--client-id[ID-ja e klientit OAuth për serverët HTTP/SSE]:clientId:' \
            '--client-secret[Kërko sekretin e klientit OAuth (ose vendos variablën e mjedisit MCP_CLIENT_SECRET)]' \
            '--callback-port[Port fiks për callback-un OAuth (për serverët që kërkojnë URI ridrejtimi të regjistruara paraprakisht)]:port:' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Shtrirja e konfigurimit (local, user, project) - hiq nga shtrirja ekzistuese nëse nuk specifikohet]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Shtrirja e konfigurimit (local, user, project)]:scope:(local user project)' \
            '--client-secret[Kërko sekretin e klientit OAuth (ose vendos variablën e mjedisit MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Shtrirja e konfigurimit (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]'
          ;;
        login)
          _arguments \
            '--no-browser[Printo URL-në e autorizimit në vend që të hapësh një shfletues (për sesione SSH/pa ndërfaqe grafike)]' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Vërteto një manifest shtojce ose tregu'
    'marketplace:Menaxho tregjet e Claude Code'
    'list:Listo shtojcat e instaluara'
    'details:Shfaq inventarin e komponentëve dhe koston e parashikuar të token-ave për një shtojcë'
    'configure:Shfaq opsionet e një shtojce dhe cilat nuk janë vendosur, ose ruaj vlerat nga stdin'
    'install:Instalo një shtojcë nga tregjet e disponueshme'
    'i:Instalo një shtojcë nga tregjet e disponueshme (shkurt për install)'
    'init:Skeletizo një shtojcë të re (ngarkohet automatikisht në sesionin e ardhshëm)'
    'new:Skeletizo një shtojcë të re (pseudonim për init)'
    'uninstall:Çinstalo një shtojcë të instaluar'
    'remove:Çinstalo një shtojcë të instaluar (pseudonim për uninstall)'
    'enable:Aktivizo një shtojcë të çaktivizuar'
    'disable:Çaktivizo një shtojcë të aktivizuar'
    'update:Përditëso një shtojcë në versionin më të fundit'
    'eval:Ekzekuto raste vlerësimi kundër një shtojce dhe raporto rezultatet e vlerësuara'
    'prune:Hiq varësitë e instaluara automatikisht që nuk nevojiten më'
    'autoremove:Hiq varësitë e instaluara automatikisht që nuk nevojiten më (pseudonim për prune)'
    'tag:Krijo një etiketë git {name}--v{version} për një lëshim shtojce'
    'test:Ekzekuto testet e një modi'
    'help:Shfaq ndihmën'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'komandat e shtojcave' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Trajto paralajmërimet si gabime (kodi i daljes 1)]' \
            '--json[Nxirr raportin e vërtetimit si JSON (të njëjtët kode daljeje)]' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Shtrirja e instalimit]:scope:(user project local)' \
            '*--config[Vendos një opsion userConfig të deklaruar në manifestin e shtojcës (e përsëritshme)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Prano komandën e shfaqur të deklaruar nga tregu pa kërkesën për konfirmim]' \
            '--json[Printo një rresht rezultati të lexueshëm nga makina në vend të mesazhit për njerëz]' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Shtrirja e instalimit]:scope:(user project local)' \
            '--keep-data[Ruaj direktorinë e të dhënave të qëndrueshme të shtojcës]' \
            '--prune[Hiq gjithashtu varësitë e instaluara automatikisht që nuk nevojiten më]' \
            '(-y --yes)'{-y,--yes}'[Anashkalo kërkesën për konfirmim të --prune]' \
            '--json[Printo një rresht rezultati të lexueshëm nga makina në vend të mesazhit për njerëz (jo me --prune)]' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Shtrirja e instalimit]:scope:(user project local)' \
            '--json[Printo një rresht rezultati të lexueshëm nga makina në vend të mesazhit për njerëz]' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Çaktivizo të gjitha shtojcat e aktivizuara]' \
            '(-s --scope)'{-s,--scope}'[Shtrirja e instalimit]:scope:(user project local)' \
            '--json[Printo një rresht rezultati të lexueshëm nga makina në vend të mesazhit për njerëz]' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Shtrirja e instalimit]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Prano komandën e shfaqur të deklaruar nga tregu pa kërkesën për konfirmim]' \
            '--json[Printo një rresht rezultati të lexueshëm nga makina në vend të mesazhit për njerëz]' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Nxirr si JSON]' \
            '--available[Përfshi shtojcat e disponueshme nga tregjet (kërkon --json)]' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Pastro në shtrirjen e dhënë]:scope:(user project local)' \
            '--dry-run[Listo çfarë do të hiqej pa hequr asgjë]' \
            '(-y --yes)'{-y,--yes}'[Anashkalo kërkesën për konfirmim]' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]'
          ;;
        configure)
          _arguments \
            '--json[Nxirr si JSON]' \
            '--values-stdin[Lexo vlerat e opsioneve nga stdin si objekt JSON me vargje njëreshtore; opsionet e lëna jashtë ruajnë vlerat e tyre]' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Përshkrimi i manifestit]:text:' \
            '--author[Emri i autorit (parazgjedhje: git config user.name)]:name:' \
            '--author-email[Email-i i autorit (parazgjedhje: git config user.email)]:email:' \
            '--with[Komponentët që të skeletizohen gjithashtu]:components:' \
            '(-f --force)'{-f,--force}'[Mbishkruaj një .claude-plugin/ ekzistues në objektiv]' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Filtro rastet sipas modelit glob të emrit]:glob:' \
            '*--tag[Filtro rastet sipas etiketës (e përsëritshme)]:tag:' \
            '--runs[Anashkalo numrin e ekzekutimeve për rast (parazgjedhje: case.runs, përndryshe 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Kryej deri në n ekzekutime agjenti njëkohësisht (1-8; parazgjedhje 1)]:n:' \
            '--model[Anashkalo modelin për të gjitha rastet]:model:_claude_model_names' \
            '--judge-model[Anashkalo modelin e vlerësuesit LLM (parazgjedhje: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Kufi i prerë kostoje; ndërprit dhe raporto rezultatet e pjesshme nëse arrihet (kodi i daljes 2)]:usd:' \
            '--output-dir[Direktoria për aggregate-result.json]:dir:_directories' \
            '--eval-dir[Emri i direktorisë (nën shtojcën) që përmban rastet e vlerësimit]:dir:' \
            '--json[Printo rezultatin e plotë të ekzekutimit si JSON në stdout, ose shkruaje në këtë skedar .json]::path:_files' \
            '--threshold[Dil me kodin e daljes 1 nëse rezultati i ndonjë rasti është nën këtë prag (parazgjedhje: 1.0)]:threshold:' \
            '*--allow-tools[Leje nga operatori për mjetet e kufizuara (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Ekzekuto scaffold_script të çdo rasti (ekzekuton bash të dhënë nga autori në emrin tënd; i çaktivizuar si parazgjedhje)]' \
            '(--scaffold)--no-scaffold[Anashkalo shprehimisht scaffold_script]' \
            '--trust-plugin[Konfirmo që i beson kësaj shtojce dhe grupit të saj të vlerësimit, duke anashkaluar kërkesën për besim në ekzekutimin e parë (për CI)]' \
            '--ablation[Ekzekuto një grup krahasues bazë pa shtojcë dhe raporto diferencën e rezultatit]:mode:(none with-without)' \
            '--mocks[Zëvendësues simulues për serverët MCP, nga <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Me --mocks record: nis gjithashtu proceset reale të serverëve MCP që nuk kanë simulim]' \
            '--keep-temp[Ruaj direktoritë e skeletit për korrigjim]' \
            '--verbose[Regjistro ngjarjet e gjurmimit për çdo mesazh në regjistrin e korrigjimit]' \
            '--report[Shkruaj raportin HTML të pavarur në këtë shteg në vend të direktorisë së rezultateve]:path:_files' \
            '(--no-publish)--publish-report[Kërko gjithashtu publikimin e raportit në claude.ai]' \
            '(--publish-report)--no-publish[Mbaje raportin HTML vetëm lokal; anashkalo publikimin e tij në claude.ai]' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Shtyje etiketën te --remote pasi ta krijosh]' \
            '--dry-run[Printo çfarë do të etiketohej pa e krijuar etiketën]' \
            '(-f --force)'{-f,--force}'[Anashkalo kontrollet për pemë pune me ndryshime të pakryera dhe për etiketë që ekziston tashmë]' \
            '(-m --message)'{-m,--message}'[Mesazhi i shënimit të etiketës (përdor %s për versionin)]:msg:' \
            '--remote[Depoja e largët ku shtyhet me --push]:name:' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Shto një treg nga URL, shteg, ose depo GitHub'
    'list:Listo tregjet e konfiguruar'
    'remove:Hiq një treg të konfiguruar'
    'rm:Hiq një treg të konfiguruar (pseudonim për remove)'
    'update:Përditëso tregun nga burimi - përditëso të gjitha nëse nuk specifikohet emri'
    'help:Shfaq ndihmën'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'komandat e tregut' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Kufizo checkout-in në direktori specifike përmes git sparse-checkout (për monorepo)]:paths:' \
            '--scope[Ku të deklarohet tregu]:scope:(user project local)' \
            '--claudeai[Shto tregun me këtë emër që claude.ai e strehon për ty]' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Nxirr si JSON]' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Hiq deklarimin e tregut nga një shtrirje specifike cilësimesh (lëre jashtë për ta hequr nga çdo shtrirje)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Detyro instalimin edhe nëse është instaluar tashmë]' \
    '(-h --help)'{-h,--help}'[Shfaq ndihmën]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Direktori shtesë për të lejuar qasjen e mjeteve në sesionet e dërguara]:directory:_directories' \
    '--agent[Agjenti i paracaktuar për sesionet e dërguara nga pamja e agjentit]:agent:_claude_agent_names' \
    '--all[Me --json: përfshi gjithashtu sesionet e përfunduara në sfond]' \
    '--allow-dangerously-skip-permissions[Bëje modalitetin e anashkalimit të lejeve të disponueshëm për sesionet e dërguara]' \
    '--cwd[Shfaq vetëm sesionet në sfond të nisura nën shteg]:path:_directories' \
    '--dangerously-skip-permissions[Pseudonim për --permission-mode bypassPermissions]' \
    '--effort[Niveli i paracaktuar i përpjekjes për sesionet e dërguara]:level:(low medium high xhigh max)' \
    '--json[Printo sesionet aktive si varg JSON dhe dil]' \
    '*--mcp-config[Konfigurimi i serverit MCP për zbatim në sesionet e dërguara]:config:' \
    '--model[Modeli i paracaktuar për sesionet e dërguara nga pamja e agjentit]:model:_claude_model_names' \
    '--permission-mode[Modaliteti i paracaktuar i lejeve për sesionet e dërguara]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Ngarko shtojcat nga direktoria për pamjen e agjentit dhe sesionet e dërguara]:path:_directories' \
    '--setting-sources[Listë e ndarë me presje e burimeve të cilësimeve për ngarkim (user, project, local)]:sources:' \
    '--settings[Skedar cilësimesh ose varg JSON për zbatim]:file-or-json:_files' \
    '--strict-mcp-config[Përdor vetëm serverët MCP nga --mcp-config në sesionet e dërguara]' \
    '--restricted[Nis sesionet e dërguara në modalitetin e kufizuar]' \
    '(-h --help)'{-h,--help}'[Shfaq ndihmën për komandën]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Hyr në llogarinë tënde Anthropic'
    'logout:Dil nga llogaria jote Anthropic'
    'status:Shfaq gjendjen e vërtetimit'
    'help:Shfaq ndihmën'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Shfaq ndihmën për komandën]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'komandat auth' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Plotëso paraprakisht adresën e email-it në faqen e hyrjes]:email:' \
            '--sso[Detyro rrjedhën e hyrjes SSO]' \
            '(--claudeai)--console[Përdor Anthropic Console (faturim sipas përdorimit të API-së) në vend të abonimit në Claude]' \
            '(--console)--claudeai[Përdor abonimin në Claude (parazgjedhje)]' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën për komandën]'
          ;;
        status)
          _arguments \
            '(--text)--json[Nxirr si JSON (parazgjedhje)]' \
            '(--json)--text[Nxirr si tekst i lexueshëm nga njerëzit]' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën për komandën]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën për komandën]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Printo konfigurimin efektiv të modalitetit automatik si JSON'
    'critique:Merr reagime nga IA për rregullat e tua të personalizuara të modalitetit automatik'
    'defaults:Printo rregullat e paracaktuara të modalitetit automatik si JSON'
    'reset:Rivendos konfigurimin e modalitetit automatik në parazgjedhjet e ofruara'
    'help:Shfaq ndihmën'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Shfaq ndihmën për komandën]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'komandat auto-mode' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Anashkalo modelin që përdoret]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën për komandën]'
          ;;
        defaults)
          _arguments \
            '--label[Shfaq vetëm rregullat, etiketa e të cilave fillon me këtë parashtesë (pa dallim shkronjash të mëdha/të vogla)]:prefix:' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën për komandën]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Anashkalo kërkesën për konfirmim]' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën për komandën]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën për komandën]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Shtegu te konfigurimi YAML i portës]:path:_files' \
    '(-h --help)'{-h,--help}'[Shfaq ndihmën për komandën]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Fshi të gjithë gjendjen e Claude Code për një projekt (transkriptet, detyrat, historikun e skedarëve, hyrjen e konfigurimit)'
    'help:Shfaq ndihmën'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Shfaq ndihmën për komandën]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'komandat project' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Listo çfarë do të fshihej pa fshirë asgjë]' \
            '(-y --yes)'{-y,--yes}'[Anashkalo kërkesën për konfirmim]' \
            '(-i --interactive)'{-i,--interactive}'[Kërko konfirmim për çdo element para fshirjes]' \
            '(1)--all[Fshi gjendjen për çdo projekt (përjashtuese reciproke me një shteg)]' \
            '(-h --help)'{-h,--help}'[Shfaq ndihmën për komandën]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Printo ngarkesën e papërpunuar bugs.json në vend të gjetjeve të formatuara]' \
    '--timeout[Minutat maksimale për të pritur që rishikimi të përfundojë (parazgjedhje: 45)]:minutes:' \
    '(--no-post)--post[Posto gjetjet e rishikimit të përfunduar në PR në emrin tënd (vetëm për objektiva PR; një koment i thjeshtë, jo një rishikim)]' \
    '(--post)--no-post[Mos i posto gjetjet në PR (parazgjedhje)]' \
    '(-h --help)'{-h,--help}'[Shfaq ndihmën për komandën]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Rinis çdo sesion në sfond që po ekzekutohet]' \
    '(-h --help)'{-h,--help}'[Shfaq ndihmën për komandën]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Hidh poshtë gjithashtu commit-et e pashtyra dhe ndryshimet e pakryera të pemës së punës (jep commit@worktree-id që raportoi një claude rm i mëparshëm)]:commit@worktree-id:' \
    '--force-remove-worktree[Fshi direktorinë e pemës së punës edhe pse hook-u WorktreeRemove ose git nuk mundën ta hiqnin (jep worktree-id që raportoi një claude rm i mëparshëm)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Shfaq ndihmën për komandën]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Shfaq çfarë do të importohej pa shkruar asgjë]' \
    '--yes[Anashkalo zgjedhësin interaktiv (në mjedise pa ndërfaqe grafike, jep --yes=<digest> nga pamja paraprake e /import)]' \
    '(-h --help)'{-h,--help}'[Shfaq ndihmën për komandën]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
