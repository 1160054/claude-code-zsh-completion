#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Konfigurá i manehá servidónan MCP'
    'plugin:Manehá pluginnan di Claude Code'
    'agents:Manehá agentenan di fondo'
    'attach:Habri un seshon di fondo den e terminal aki'
    'logs:Imprimí e salida resien di terminal di un seshon di fondo'
    'stop:Stop un seshon di fondo (su konbersashon ta keda wardá)'
    'respawn:Reinisiá un seshon di fondo pa e kore e vershon aktual di Claude Code'
    'rm:Eliminá un seshon di fondo, i su worktree ora esei ta sigur'
    'remote-control:Kontrolá seshonnan lokal for di claude.ai/code of e app móvil di Claude'
    'daemon:Maneha e supervisor di seshonnan den fondo'
    'auth:Manehá outentikashon'
    'auto-mode:Inspekshoná of resetiá konfigurashon di klasifikadó di modo outomátiko'
    'gateway:Kore e gateway di outentikashon/telemetria empresarial'
    'self-hosted-runner:Hospedá seshonnan den nube di Claude Code riba e máquina of container aki'
    'import:Importá konfigurashon for di otro agente di kodifikashon di AI den Claude Code'
    'project:Manehá estado di proyekto di Claude Code'
    'purge:Elimná tur estado di Claude Code pa un proyekto (transkripshon, tareanan, historia di archivo, entrada di konfigurashon)'
    'ultrareview:Kore un revishon di kódigo multi-agente den nube i imprimí e resultadonan'
    'setup-token:Konfigurá token di outentikashon di largu plazo (ta rekerí suskripshon di Claude)'
    'doctor:Chekeo di salú pa e outo-aktualisadó di Claude Code'
    'update:Buska i instalá aktualisashonnan'
    'install:Instalá e build nativo di Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Aktivá modo debug ku filtrahe di kategoria opshonal (p.e., "api,hooks" of "!statsig,!file")]:filter:'
    '--verbose[Anulá e konfigurashon di modo verboso for di e archivo di konfigurashon]'
    '(-p --print)'{-p,--print}'[Imprimí respuesta i sali (pa uzo ku pipes). Nota: uza solamente den direktorionan konfiabel]'
    '--output-format[Formato di salida (ku --print): "text" (predeterminá), "json" (un solo resultado), of "stream-json" (streaming na tempo real)]:format:(text json stream-json)'
    '--json-schema[Skema JSON pa validashon di salida strukturá]:schema:'
    '--include-partial-messages[Inkluí pida-pida di mensahe parsial segun nan ta yega (ku --print i --output-format=stream-json)]'
    '--input-format[Formato di entrada (ku --print): "text" (predeterminá) of "stream-json" (entrada streaming na tempo real)]:format:(text stream-json)'
    '--dangerously-skip-permissions[Pasa tur chekeo di permiso. Rekomendá solamente pa sandboxnan sin akseso na internet]'
    '--allow-dangerously-skip-permissions[Aktivá e opshon pa pasa chekeo di permiso sin aktivá esaki por defekto]'
    '--restricted[Modo restringí: kita e hèrmèntnan ku ta kore komando of kódigo i WebFetch, ignorá konfigurashon user/project/local, i limitá hèrmèntnan di archivo na e direktorionan di trabou]'
    '--max-budget-usd[Kantidat máksimo di dòler pa gasta na yamadanan API (--print so)]:amount:'
    '--max-turns[Limitá e kantidat di turnonan agéntiko (--print so)]:turns:'
    '--replay-user-messages[Manda mensahenan di uzuario di stdin bèk riba stdout pa konfirmashon]'
    '--allowed-tools[Lista di nòmbernan di hèrmènt permití separá ku koma of spasi (p.e., "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Lista di nòmbernan di hèrmènt permití separá ku koma of spasi (formato camelCase)]:tools:'
    '--tools[Spesifiká lista di hèrmèntnan disponibel for di e set inkorporá. Solamente modo print]:tools:'
    '--disallowed-tools[Lista di nòmbernan di hèrmènt no-permití separá ku koma of spasi (p.e., "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Lista di nòmbernan di hèrmènt no-permití separá ku koma of spasi (formato camelCase)]:tools:'
    '--mcp-config[Karga servidónan MCP for di un archivo of string JSON (separá ku spasi)]:configs:'
    '--system-prompt[Prompt di sistema pa uza pa e seshon]:prompt:'
    '--system-prompt-file[Lesa prompt di sistema for di un archivo]:file:_files'
    '--append-system-prompt[Agregá prompt di sistema na e prompt di sistema predeterminá]:prompt:'
    '--append-system-prompt-file[Lesa prompt di sistema for di un archivo i agregá e na e prompt di sistema predeterminá]:file:_files'
    '(--append-subagent-system-prompt-file)--append-subagent-system-prompt[Agregá teksto na e prompt di sistema di kada subagente (--print so)]:prompt:'
    '(--append-subagent-system-prompt)--append-subagent-system-prompt-file[Lesa teksto for di un archivo i agregá e na e promptnan di sistema di subagentenan (--print so)]:file:_files'
    '--system-prompt-snapshot[Graba e prompt di sistema un biaha pa konbersashon i reutilisá e palabra pa palabra na kada petishon i retomamentu (on, e predeterminá) of genera e di nobo na kada petishon (off)]:mode:(on off)'
    '--permission-mode[Modo di permiso pa uza pa e seshon]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Ken ta kontestá preguntanan di permiso ku --print: "host" (e host di SDK of --permission-prompt-tool) of "none" (tur loke lo a pidi permiso ta wòrdu nengá)]:target:(host none)'
    '--permission-prompt-tool[Hèrmènt MCP pa uza pa preguntanan di permiso (--print so)]:tool:'
    '(-c --continue)'{-c,--continue}'[Kontinuá e konbersashon mas resien]'
    '(-r --resume)'{-r,--resume}'[Retomá un konbersashon - spesifiká ID di seshon of selektá interaktivamente]:sessionId:_claude_sessions'
    '--fork-session[Krea un ID di seshon nobo en bes di reutilisá e ID di seshon original ora ta retomá (ku --resume of --continue)]'
    '--no-session-persistence[Desaktivá persistensia di seshon - seshonnan lo no wòrdu wardá (--print so)]'
    '--model[Modelo pa e seshon aktual. Spesifiká un alias pa e modelo mas resien (p.e., '\''sonnet'\'' of '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agente pa e seshon aktual. Ta anulá e konfigurashon '\''agent'\'']:agent:_claude_agent_names'
    '--betas[Headernan beta pa inkluí den petishonnan API (solamente uzuarionan di API key)]:betas:'
    '--fallback-model[Aktivá fallback outomátiko na e modelo spesifiká ora e modelo predeterminá ta sobrekargá (--print so)]:model:_claude_model_names'
    '--settings[Kaminda na e archivo JSON di konfigurashon of string JSON pa karga konfigurashonnan adishonal]:file-or-json:_files'
    '--add-dir[Direktorionan adishonal pa permití akseso di hèrmènt]:directories:_directories'
    '--ide[Konektá outomátikamente na IDE ora di start si tin eksaktamente un IDE válido disponibel]'
    '--desktop[Habri den e app Claude Desktop en bes di e terminal (ku --continue of --resume <id> pa skohe e seshon)]'
    '--strict-mcp-config[Uza solamente servidónan MCP for di --mcp-config i ignorá tur otro konfigurashon MCP]'
    '--session-id[ID di seshon spesífiko pa uza pa e konbersashon (mester ta un UUID válido)]:uuid:'
    '--agents[Opheto JSON ku ta definí agentenan personalisá]:json:'
    '--advisor[Aktivá e herment di konsehero na banda di servidó pa e seshon aki ku un alias di modelo of ID kompleto di modelo]:model:_claude_model_names'
    '--teammate-mode[Kon e kompañeronan di un tim di agente ta wòrdu mustrá]:mode:(in-process auto tmux iterm2)'
    '--setting-sources[Lista di fuentenan di konfigurashon pa karga separá ku koma (user, project, local)]:sources:'
    '--plugin-dir[Direktorio for di kua ta karga pluginnan pa e seshon aki so (repetibel)]:paths:_directories'
    '--disable-slash-commands[Desaktivá tur komando slash]'
    '(--bg --background)'{--bg,--background}'[Kuminsá e seshon komo un agente di fondo i bolbe mesora]'
    '(-w --worktree)'{-w,--worktree}'[Krea un git worktree nobo pa e seshon aki (opshonalmente spesifiká un nòmber)]::name:'
    '--tmux=-[Krea un seshon tmux pa e worktree (ta rekerí --worktree). Ta uza panelnan nativo di iTerm2 ora ta disponibel; --tmux=classic pa tmux tradishonal]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Pone un nòmber di mustra pa e seshon aki]:name:'
    '--effort[Nivel di esfuerso pa e seshon aktual]:level:(low medium high xhigh max)'
    '--autocompact[Tamaño di bentana pa kompaktashon outomátiko (auto, of 100k-1M token)]:size:(auto)'
    '--debug-file[Skirbi lognan di debug na un kaminda di archivo spesífiko (ta aktivá modo debug implísitamente)]:path:_files'
    '--from-pr[Retomá un seshon ligá na un PR pa number/URL, of habri e selektor interaktivo]::value:'
    '--teleport[Retomá un seshon di teleport, opshonalmente spesifiká ID di seshon]::session:'
    '(--remote)--cloud[Krea un seshon den nube ku e deskripshon duná, of konektá na un eksistente pa ID di seshon of URL di claude.ai/code]::description-or-session:'
    '(--cloud)--remote[Alias obsoleto pa --cloud]::description-or-session:'
    '--environment[Krea un seshon nobo den nube ku ta kore riba e ambiente self-hosted duná (ccpool_...)]:environment_id:'
    '--ref[Ku --environment: basá e checkout di e seshon nobo riba un ref ku nòmber en bes di HEAD lokal]:branch:'
    '(--remote-control --rc)'{--remote-control,--rc}'[Kuminsá un seshon interaktivo ku Remote Control aktivá (opshonalmente ku nòmber)]::name:'
    '--remote-control-session-name-prefix[Prefiho pa nòmbernan di seshon Remote Control generá outomátikamente]:prefix:'
    '--chrome[Aktivá e integrashon di Claude den Chrome]'
    '--no-chrome[Desaktivá e integrashon di Claude den Chrome]'
    '--plugin-url[Baha un .zip di plugin for di un URL pa e seshon aki so (repetibel)]:url:'
    '--file[Rekursonan di archivo pa baha ora di start (formato: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Aktivá sugerensianan di prompt (ta emití un siguiente prompt predisí den modo print/SDK)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Reenviá teksto di subagente i blòkinan di pensamentu komo mensahe (ku --print i stream-json)]'
    '--include-hook-events[Inkluí tur evento di siklo di bida di hook den e stream di salida (ku stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Move e sekshonnan pa kada mákina den e promé mensahe di uzuario pa mehorá reutilisashon di prompt-cache]'
    '--brief[Aktivá e hèrmènt SendUserMessage pa komunikashon di agente pa uzuario]'
    '*--channels[(Vista previa di investigashon) Servidónan MCP kuyo notifikashonnan di kanal mester skucha (plugin\:<name>@<marketplace>)]:entries:'
    '*--dangerously-load-development-channels[Aktivá kanalnan ku no ta riba e lista di permiso aprobá, pa desaroyo lokal (plugin\:<name>@<marketplace> of server\:<name>)]:entries:'
    '--init[Ehekutá hooknan Setup ku e matcher init promé ku e seshon (--print so)]'
    '--init-only[Ehekutá hooknan Setup i SessionStart, despues sali sin kuminsá un konbersashon]'
    '--maintenance[Ehekutá hooknan Setup ku e matcher maintenance promé ku e seshon (--print so)]'
    '--safe-mode[Kuminsá ku tur personalisashon desaktivá (útil pa resolvé un konfigurashon kibrá)]'
    '--bare[Modo mínimo: salta hooks, LSP, sinkronisashon di plugin, atribushon, auto-memory, i deskubrimentu outomátiko di CLAUDE.md]'
    '--ax-screen-reader[Mustra salida amigabel pa lektor di pantaya (teksto plat, sin borchi dekorativo of animashon)]'
    '(-v --version)'{-v,--version}'[Mustra number di vershon]'
    '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]'
  )

  # Stop at the first non-option word, so that the options after a command reach
  # that command's own specs instead of being consumed here
  _arguments -C -A '-*' \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'komandunan claude' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin|plugins)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        remote-control|rc|remote|sync|bridge)
          _claude_remote_control
          ;;
        daemon)
          _claude_daemon
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        self-hosted-runner)
          _claude_self_hosted_runner
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        purge)
          _claude_purge
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update|upgrade)
          _arguments \
            '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]'
          ;;
        *)
          # Not a command but the prompt: options may still follow it
          _arguments \
            $main_options \
            '*: :'
          ;;
      esac
      ;;
  esac
  local ret=$?

  # The last step, such as listing commands for --r, can fail although options
  # were added before it. Report success then: on failure zsh moves on to the
  # next completers, and _correct or _approximate pile on corrections
  (( compstate[nmatches] > 0 )) || return $ret
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Kuminsá un servidó MCP di Claude Code'
    'add:Agregá un servidó MCP na Claude Code'
    'remove:Kita un servidó MCP'
    'list:Lista e servidónan MCP konfigurá'
    'get:Optené detaye di servidó MCP'
    'add-json:Agregá un servidó MCP (stdio of SSE) ku un string JSON'
    'add-from-claude-desktop:Importá servidónan MCP for di Claude Desktop (solamente Mac i WSL)'
    'reset-project-choices:Resetiá tur servidó aprobá/rechasá di alkanse di proyekto (.mcp.json) den e proyekto aki'
    'login:Outentiká ku un servidó MCP (HTTP, SSE, of konektor di claude.ai)'
    'logout:Elimná kredensialnan OAuth wardá pa un servidó MCP'
    'help:Mustra yudansa'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mustra yudansa]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'komandunan mcp' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Aktivá modo debug]' \
            '--verbose[Anulá e konfigurashon di modo verboso for di e archivo di konfigurashon]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Alkanse di konfigurashon (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Tipo di transporte (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Pone variabel di ambiente (p.e., -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Pone header di WebSocket]:header:' \
            '--client-id[OAuth client ID pa servidónan HTTP/SSE]:clientId:' \
            '--client-secret[Pidi e OAuth client secret (of pone e variabel di ambiente MCP_CLIENT_SECRET)]' \
            '--callback-port[Port fiho pa OAuth callback (pa servidónan ku ta rekerí URI di redirekshon pre-registrá)]:port:' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Alkanse di konfigurashon (local, user, project) - kita for di e alkanse eksistente si no ta spesifiká]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Mustra yudansa]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Alkanse di konfigurashon (local, user, project)]:scope:(local user project)' \
            '--client-secret[Pidi e OAuth client secret (of pone e variabel di ambiente MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Alkanse di konfigurashon (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Mustra yudansa]'
          ;;
        login)
          _arguments \
            '--no-browser[Imprimí e URL di outorisashon en bes di habri un navegadó (pa seshonnan SSH/headless)]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Validá un manifest di plugin of merkado'
    'marketplace:Manehá merkadonan di Claude Code'
    'list:Lista e pluginnan instalá'
    'details:Mustra inventario di komponente i kosto di token proyektá pa un plugin'
    'configure:Mustra e opshonnan di un plugin i kua no ta poné, of warda valornan for di stdin'
    'install:Instalá un plugin for di merkadonan disponibel'
    'i:Instalá un plugin for di merkadonan disponibel (korto pa install)'
    'init:Krea struktura di un plugin nobo (ta karga outomátikamente den e siguiente seshon)'
    'new:Krea struktura di un plugin nobo (alias pa init)'
    'uninstall:Desinstalá un plugin instalá'
    'remove:Desinstalá un plugin instalá (alias pa uninstall)'
    'enable:Aktivá un plugin desaktivá'
    'disable:Desaktivá un plugin aktivá'
    'update:Aktualisá un plugin na e vershon mas resien'
    'eval:Kore kasonan di evaluashon kontra un plugin i reportá resultadonan puntuá'
    'prune:Kita dependensianan instalá outomátikamente ku no ta nesesario mas'
    'autoremove:Kita dependensianan instalá outomátikamente ku no ta nesesario mas (alias pa prune)'
    'tag:Krea un git tag {name}--v{version} pa un lansamentu di plugin'
    'test:Kore e testnan di un mod'
    'help:Mustra yudansa'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mustra yudansa]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'komandunan di plugin' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Trata avisonan komo eror (kódigo di salida 1)]' \
            '--profile[Tambe sali ku exit 1 ora e katálogo ku nòmber lo rechasá un entrega di e plugin riba un chèk ku e komando aki ta ehekutá]:name:(directory)' \
            '--json[Imprimí e reporte di validashon komo JSON (mesun kódigonan di salida)]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Alkanse di instalashon]:scope:(user project local)' \
            '--accept-command[Aseptá e komando deklará pa e merkado kuyo sha256 un ehekushon --json anterior a reportá komo shownCommand.sha256]:sha256:' \
            '*--config[Pone un opshon userConfig deklará den e manifest di plugin (repetibel)]:key=value:' \
            '--marketplace[Instalá e plugin ku su nòmber simpel for di e merkado na e fuente aki (owner/repo, URL git of https, of kaminda), agregando e merkado promé si ta nesesario]:source:' \
            '--registry[Pa un instalashon package@npm: resolvé i deskargá for di e registro npm aki]:url:' \
            '(-y --yes)'{-y,--yes}'[Aseptá e komando mustrá ku e merkado a deklará sin e pregunta di konfirmashon]' \
            '--json[Imprimí un liña di resultado lesabel pa mákina en bes di e mensahe pa hende]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Alkanse di instalashon]:scope:(user project local)' \
            '--keep-data[Preservá e direktorio di datonan persistente di e plugin]' \
            '--prune[Kita tambe dependensianan instalá outomátikamente ku no ta nesesario mas]' \
            '(-y --yes)'{-y,--yes}'[Salta e pregunta di konfirmashon di --prune]' \
            '--json[Imprimí un liña di resultado lesabel pa mákina en bes di e mensahe pa hende (no ku --prune)]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Alkanse di instalashon]:scope:(user project local)' \
            '--json[Imprimí un liña di resultado lesabel pa mákina en bes di e mensahe pa hende]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Desaktivá tur plugin aktivá]' \
            '(-s --scope)'{-s,--scope}'[Alkanse di instalashon]:scope:(user project local)' \
            '--json[Imprimí un liña di resultado lesabel pa mákina en bes di e mensahe pa hende]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '--accept-command[Aseptá e komando deklará pa e merkado kuyo sha256 un ehekushon --json anterior a reportá komo shownCommand.sha256]:sha256:' \
            '(-s --scope)'{-s,--scope}'[Alkanse di instalashon]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Aseptá e komando mustrá ku e merkado a deklará sin e pregunta di konfirmashon]' \
            '--json[Imprimí un liña di resultado lesabel pa mákina en bes di e mensahe pa hende]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Salida komo JSON]' \
            '--available[Inkluí pluginnan disponibel for di merkadonan (ta rekerí --json)]' \
            '--data-size[Midi e direktorio di data wardá di kada plugin instalá, of e plugin ku nòmber so (ta rekerí --json)]::plugin:_claude_installed_plugins' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Limpia den e alkanse]:scope:(user project local)' \
            '--dry-run[Lista loke lo wòrdu kitá sin kita nada]' \
            '(-y --yes)'{-y,--yes}'[Salta e pregunta di konfirmashon]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]'
          ;;
        configure)
          _arguments \
            '--json[Salida komo JSON]' \
            '--values-stdin[Lesa valornan di opshon for di stdin komo un opheto JSON di string di un solo liña; opshonnan no inkluí ta keda ku nan valor]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Deskripshon di manifest]:text:' \
            '--author[Nòmber di autor (predeterminá: git config user.name)]:name:' \
            '--author-email[Email di autor (predeterminá: git config user.email)]:email:' \
            '--with[Komponentenan pa krea struktura pa nan tambe]:components:' \
            '(-f --force)'{-f,--force}'[Sobreskirbi un .claude-plugin/ eksistente na e destino]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '1:name:'
          ;;
        eval)
          if [[ $words[2] == init ]]; then
            _arguments \
              '--bare[Skirbi un plantilla bashí en bes di hasi e entrevista]' \
              '--eval-dir[Direktorio bou di e direktorio aktual pa skirbi kasonan aden]:dir:_directories' \
              '(-i --interactive)'{-i,--interactive}'[Hasi e entrevista di redakshon (ta rekerí un terminal interaktivo)]' \
              '(-h --help)'{-h,--help}'[Mustra yudansa]' \
              '::name:'
            return
          fi
          _arguments \
            '--case[Filtrá kasonan pa glob di nòmber]:glob:' \
            '*--tag[Filtrá kasonan pa tag (repetibel)]:tag:' \
            '--runs[Anulá e kantidat di ehekushon pa kaso (predeterminá: case.runs, sino 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Kore te n ehekushon di agente na mes momento (1-8; predeterminá 1)]:n:' \
            '--model[Anulá e modelo pa tur kaso]:model:_claude_model_names' \
            '--judge-model[Anulá e modelo di evaluadó LLM (predeterminá: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Límite máksimo fiho di kosto; aborta i reportá resultadonan parsial si e ta wòrdu alkansá (kódigo di salida 2)]:usd:' \
            '--output-dir[Direktorio pa aggregate-result.json]:dir:_directories' \
            '--eval-dir[Nòmber di direktorio (bou di e plugin) ku ta kontené e kasonan di evaluashon]:dir:' \
            '--json[Imprimí e resultado kompleto di e ehekushon komo JSON na stdout, of skirbi e na e archivo .json aki]::path:_files' \
            '--threshold[Sali ku kódigo di salida 1 si e punto di kualke kaso ta bou di e límite aki (predeterminá: 1.0)]:threshold:' \
            '*--allow-tools[Permiso di operadó pa hèrmèntnan restringí (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '*--disallow-tools[Hermentnan integrá pa tene for di Claude den tur kaso, asta si nan a wòrdu otorgá]:tools:' \
            '(--no-scaffold)--scaffold[Kore e scaffold_script di kada kaso (ta kore bash duná pa e autor komo bo usuario; desaktivá predeterminadamente)]' \
            '(--scaffold)--no-scaffold[Salta scaffold_script eksplísitamente]' \
            '--trust-plugin[Konfirmá ku bo ta konfia e plugin aki i su suite di evaluashon, i salta e pregunta di konfiansa di promé ehekushon (pa CI)]' \
            '--ablation[Kore un grupo di kontrol sin plugin i reportá e diferensia di punto]:mode:(none with-without)' \
            '--mocks[Substitutonan simulá (mock) pa servidónan MCP, for di <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Ku --mocks record: kuminsá tambe e prosesonan real di servidó MCP ku no tin mock]' \
            '--keep-temp[Preservá direktorionan di struktura pa debug]' \
            '--verbose[Registrá eventonan di trace pa kada mensahe den e log di debug]' \
            '--report[Skirbi e reporte HTML outónomo na e kaminda aki en bes di e direktorio di resultado]:path:_files' \
            '(--no-publish)--publish-report[Rekerí tambe pa publiká e reporte na claude.ai]' \
            '(--publish-report)--no-publish[Tene e reporte HTML lokal so; salta publikashon na claude.ai]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '::target: _alternative "commands\:eval command\:(init)" "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Push e tag na --remote despues di krea e]' \
            '--dry-run[Imprimí loke lo wòrdu tagá sin krea e]' \
            '(-f --force)'{-f,--force}'[Salta e chekeonan di working tree sushi i di tag ku ya ta eksistí]' \
            '(-m --message)'{-m,--message}'[Mensahe di anotashon di tag (uza %s pa e vershon)]:msg:' \
            '--remote[Remote pa push na dje ku --push]:name:' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Agregá un merkado for di URL, kaminda, of repositorio di GitHub'
    'list:Lista e merkadonan konfigurá'
    'remove:Kita un merkado konfigurá'
    'rm:Kita un merkado konfigurá (alias pa remove)'
    'update:Aktualisá merkado for di fuente - aktualisá tur si no ta spesifiká nòmber'
    'help:Mustra yudansa'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mustra yudansa]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'komandunan di merkado' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Limitá checkout na direktorionan spesífiko via git sparse-checkout (pa monorepos)]:paths:' \
            '--scope[Unda pa deklará e merkado]:scope:(user project local)' \
            '--json[Imprimí un liña di resultado lesabel pa máquina komo e último liña riba stdout]' \
            '--claudeai[Agregá e merkado ku e nòmber aki ku claude.ai ta hospedá pa bo]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Salida komo JSON]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Kita e deklarashon di merkado for di un alkanse di konfigurashon spesífiko (laga afó pa kita e for di tur alkanse)]:scope:(user project local)' \
            '--json[Imprimí un liña di resultado lesabel pa máquina komo e último liña riba stdout]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '--json[Ku un nòmber di merkado: imprimí un liña di resultado lesabel pa máquina komo e último liña riba stdout]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Forsá instalashon asta si ta instalá kaba]' \
    '(-h --help)'{-h,--help}'[Mustra yudansa]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Direktorio adishonal pa permití akseso di hèrmènt den seshonnan despachá]:directory:_directories' \
    '--agent[Agente predeterminá pa seshonnan despachá for di e vista di agente]:agent:_claude_agent_names' \
    '--all[Ku --json: inkluí tambe seshonnan di fondo kompletá]' \
    '--allow-dangerously-skip-permissions[Hasi modo bypass-permissions disponibel pa seshonnan despachá]' \
    '--cwd[Mustra solamente seshonnan di fondo kuminsá bou di e kaminda]:path:_directories' \
    '--dangerously-skip-permissions[Alias pa --permission-mode bypassPermissions]' \
    '--effort[Nivel di esfuerso predeterminá pa seshonnan despachá]:level:(low medium high xhigh max)' \
    '--json[Imprimí seshonnan aktivo komo un array JSON i sali]' \
    '*--mcp-config[Konfigurashon di servidó MCP pa apliká na seshonnan despachá]:config:' \
    '--model[Modelo predeterminá pa seshonnan despachá for di e vista di agente]:model:_claude_model_names' \
    '--permission-mode[Modo di permiso predeterminá pa seshonnan despachá]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Karga pluginnan for di direktorio pa e vista di agente i seshonnan despachá]:path:_directories' \
    '--setting-sources[Lista di fuentenan di konfigurashon pa karga separá ku koma (user, project, local)]:sources:' \
    '--settings[Archivo di konfigurashon of string JSON pa apliká]:file-or-json:_files' \
    '--strict-mcp-config[Uza solamente servidónan MCP for di --mcp-config den seshonnan despachá]' \
    '--restricted[Kuminsá seshonnan despachá den modo restringí]' \
    '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Login den bo kuenta di Anthropic'
    'logout:Log out for di bo kuenta di Anthropic'
    'status:Mustra estado di outentikashon'
    'help:Mustra yudansa'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'komandunan di outentikashon' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Yena di antemano e adrès di email riba e página di login]:email:' \
            '--sso[Forsá e fluho di login SSO]' \
            '(--claudeai)--console[Uza Anthropic Console (fakturashon pa uzo di API) en bes di suskripshon di Claude]' \
            '(--console)--claudeai[Uza suskripshon di Claude (predeterminá)]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]'
          ;;
        status)
          _arguments \
            '(--text)--json[Salida komo JSON (predeterminá)]' \
            '(--json)--text[Salida komo teksto lesabel pa hende]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Imprimí e konfigurashon efektivo di modo outomátiko komo JSON'
    'critique:Optené feedback di AI riba bo reglanan personalisá di modo outomátiko'
    'defaults:Imprimí e reglanan predeterminá di modo outomátiko komo JSON'
    'reset:Resetiá konfigurashon di modo outomátiko na e valornan predeterminá original'
    'help:Mustra yudansa'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'komandunan auto-mode' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Anulá kua modelo ta wòrdu uzá]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]'
          ;;
        defaults)
          _arguments \
            '--label[Mustra solamente reglanan kuyo etiketa ta kuminsá ku e prefiho aki (sin distinguí mayúskula/minúskula)]:prefix:' \
            '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Salta e pregunta di konfirmashon]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Kaminda na e konfigurashon YAML di gateway]:path:_files' \
    '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Elimná tur estado di Claude Code pa un proyekto (transkripshon, tareanan, historia di archivo, entrada di konfigurashon)'
    'help:Mustra yudansa'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'komandunan di proyekto' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Lista loke lo wòrdu eliminá sin eliminá nada]' \
            '(-y --yes)'{-y,--yes}'[Salta e pregunta di konfirmashon]' \
            '(-i --interactive)'{-i,--interactive}'[Pidi konfirmashon pa kada elemento promé ku eliminá]' \
            '(1)--all[Eliminá estado pa tur proyekto (mutuamente eksklusivo ku un kaminda)]' \
            '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_purge() {
  _arguments \
    '--dry-run[Lista loke lo wòrdu eliminá sin eliminá nada]' \
    '(-y --yes)'{-y,--yes}'[Salta e pregunta di konfirmashon]' \
    '(-i --interactive)'{-i,--interactive}'[Pidi konfirmashon pa kada elemento promé ku eliminá]' \
    '(1)--all[Eliminá estado pa tur proyekto (mutuamente eksklusivo ku un kaminda)]' \
    '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]' \
    '(--all)::path:_directories'
}

_claude_ultrareview() {
  _arguments \
    '--json[Imprimí e payload bruto di bugs.json en bes di resultadonan formatiá]' \
    '--timeout[Máksimo di minüt pa spera te ora e revishon kaba (predeterminá: 45)]:minutes:' \
    '(--no-post)--post[Publiká e hayasgonan di e revishon kaba riba e PR na bo nòmber (PR so; un solo komentario simpel, no un review)]' \
    '(--post)--no-post[No publiká e hayasgonan riba e PR (e predeterminá)]' \
    '--trust-workspace[Konfia e mapa aktual pa e ehekushon aki so, sin puntra (pa scripts i CI)]' \
    '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Reinisiá tur seshon di fondo ku ta kore]' \
    '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Deskartá tambe e commitnan no pushá i kambionan no commitá di e worktree (pasa e commit@worktree-id ku un claude rm anterior a reportá)]:commit@worktree-id:' \
    '--force-remove-worktree[Eliminá e direktorio di worktree aunke e hook WorktreeRemove of git no por a kit'\''é (pasa e worktree-id ku un claude rm anterior a reportá)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]' \
    '1:session:_claude_background_sessions'
}

_claude_self_hosted_runner() {
  _arguments \
    '--api-url[URL base di API (predeterminá: https://api.anthropic.com)]:url:' \
    '--environment-secret-file[Kaminda na e archivo sekreto di e ambiente]:path:_files' \
    '--lock-to-account[Bloká e runner na un solo kuenta na momento di registrashon]:id:' \
    '--client-label[Etiketa di observabilidat mandá na momento di registrashon (predeterminá: hostname)]:label:' \
    '(--proxy-authorization-file --agent-proxy-url)--proxy-authorization-command[Komando kuyo stdout ta e header Proxy-Authorization pa proxynan di salida]:shell command:' \
    '(--proxy-authorization-command --agent-proxy-url)--proxy-authorization-file[Archivo ku ta kontené e header Proxy-Authorization pa proxynan di salida]:path:_files' \
    '(--proxy-authorization-command --proxy-authorization-file)--agent-proxy-url[Manda kada seshon pa medio di e proxy di agente na e URL aki (https so)]:url:' \
    '--capacity[Máksimo di seshonnan simultáneo (predeterminá: 1)]:n:' \
    '--base-dir[Direktorio base pa checkoutnan di repo (predeterminá: /workspace)]:path:_directories' \
    '--exec-path[Binario pa lansa pa seshonnan yu (predeterminá: e binario aki)]:path:_files' \
    '--hooks-dir[Direktorio di scriptnan di hook di siklo di bida (checkout, command, post-session)]:path:_directories' \
    '--session-stop-grace-sec[Kuantu tempu warda pa un salida limpi despues ku un seshon kaba (predeterminá: 5)]:n:' \
    '--post-session-hook-timeout-sec[Presupuesto di SIGTERM pa e hook post-session (predeterminá: 60)]:n:' \
    '--checkout-hook-timeout-min[Presupuesto di tempu real pa kada ehekushon di e hook checkout (predeterminá: 30; 0 ta desaktivá)]:n:' \
    '--drain-wait-sec[Na SIGTERM/SIGINT, warda te N sekonde pa trabou ku ta den proseso (predeterminá: 0)]:n:' \
    '--drain-marker-file[Archivo markadó ku kua e host ta anunsiá un drenahe ordená]:path:_files' \
    '*--git-ssh-rewrite[Reskirbi URLnan di fuente https://<host>/... na git@<host>:... (repetibel)]:host:' \
    '*--git-host-rewrite[Reskirbi URLnan di fuente https://<f>/... na https://<t>/... (repetibel)]:from=to:' \
    '--use-anthropic-git-proxy[Uza git manehá pa Anthropic. ATENSHON: ta eliminá i reemplasá e konfigurashon di git na nivel di HOME, uza bou di un kuenta dediká so]' \
    '--configure-git[Konfigurá e identidat global di git i aktivá firma di commit via e servisio di firma di Anthropic. Ta skirbi ~/.gitconfig]' \
    '--push-outcome-on-release[Push e branchnan di resultado rastreá ora un seshon kaba sin kompletá, inisiá pa e runner]' \
    '--trust-workspace[Registrá di antemano konfiansa persistente pa e kamindanan di repo di kada seshon (predeterminá: true)]::bool:(true false)' \
    '--remove-session-state[Kita e estado pa seshon ora un seshon kaba (predeterminá: false)]::bool:(true false)' \
    '--diff-finds-nested-repository[Mustra un repositorio klona den un submapa den e panel Changes; ta rekerí --capacity 1 (predeterminá: false)]::bool:(true false)' \
    '--confine-repo-settings[Modo di guardia ku ta limitá konfigurashonnan commitá den e repo (predeterminá: warn)]:mode:(warn enforce off)' \
    '--server-auto-mode-lists[Kua listanan di klasifikadó di modo outomátiko for di e servidó un seshon por risibí (predeterminá: no-allow)]:mode:(all no-allow none)' \
    '--host-config-snapshot[Unda e snapshot di arranke di e konfigurashon di host ta wòrdu wardá (predeterminá: disk)]:mode:(disk memory)' \
    '--health-port[Porta pa e listener HTTP /healthz (predeterminá: 8080; 0 ta desaktivá)]:port:' \
    '--log-level[Nivel di log (predeterminá: info)]:level:(info debug)' \
    '--log-file[Kopia tambe e lognan di runner den un archivo na modo di añadi (tee)]:path:_files' \
    '--exit-if-unused-min[Sali for di e runner si nunka no a asigná trabou durante N minüt]:n:' \
    '--drain-grace-sec[Sekondenan pa sigui chèk atrobe pa trabou despues ku seshonnan aktivo kaba (predeterminá: 0)]:n:' \
    '--retire-at[Retirá e runner na e tempu Unix absoluto aki, na sekonde]:epoch-seconds:' \
    '--defer-shutdown-max-min[Na e promé SIGTERM/SIGINT, stop di aseptá trabou i kaba di paga M minüt despues (predeterminá: 0)]:m:' \
    '--release-idle-session-min[Liberá un espasio di seshon despues di N minüt sin input di usuario]:n:' \
    '--startup-timeout-min[Liberá un espasio di seshon si e yu no a kaba di arranká despues di N minüt (predeterminá: 15; 0 ta desaktivá)]:n:' \
    '--kill-session-after-min[Limitá e bida den tempu real di un yu di seshon na N minüt]:n:' \
    '--debug-token-dir[PA DEBUG SO: ta skirbi tokennan bibo riba disko. No uza den produkshon]:path:_directories' \
    '(-h --help)'{-h,--help}'[Mustra e mensahe di yudansa aki]'
}

_claude_remote_control() {
  _arguments \
    '--name[Nòmber pa e seshon (mustrá den claude.ai/code)]:name:' \
    '--remote-control-session-name-prefix[Prefiho pa nòmbernan di seshon generá outomátikamente (predeterminá: hostname)]:prefix:' \
    '(-c --continue --session-id)'{-c,--continue}'[Konektá atrobe na e último seshon registrá pa e direktorio aki of un di su worktreenan di git]' \
    '(-c --continue --session-id)--session-id[Konektá atrobe na un seshon spesífiko pa ID]:id:' \
    '--permission-mode[Modo di permiso pa seshonnan lansá]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)' \
    '(--no-chrome)--chrome[Aktivá Claude in Chrome pa seshonnan lansá]' \
    '(--chrome)--no-chrome[Desaktivá Claude in Chrome pa seshonnan lansá]' \
    '(-d --debug)'{-d,--debug}'[Aktivá modo debug ku filtrashon opshonal pa kategoria]::filter:' \
    '--debug-file[Skirbi log di debug na archivo]:path:_files' \
    '(-v --verbose)'{-v,--verbose}'[Aktivá salida detayá]' \
    '--spawn[Modo di lansamentu (predeterminá: same-dir)]:mode:(same-dir worktree session)' \
    '--capacity[Máksimo di seshonnan simultáneo den modo worktree of same-dir (predeterminá: 32)]:n:' \
    '(--no-create-session-in-dir)--create-session-in-dir[Krea un seshon di antemano den e direktorio aktual (predeterminá)]' \
    '(--create-session-in-dir)--no-create-session-in-dir[No krea un seshon di antemano den e direktorio aktual]' \
    '(-h --help)'{-h,--help}'[Mustra e yudansa aki]'
}

_claude_daemon() {
  local -a daemon_commands common_options
  daemon_commands=(
    'run:Ehekutá e supervisor den primer plano'
    'status:Mustra pid, version i tempu aktivo di e daemon'
    'logs:Sigui e log di daemon (Ctrl-C pa stop)'
    'uninstall:Kita e servisio den fondo (launchctl/systemd)'
    'stop:Paga e supervisor i terminá seshonnan den fondo'
  )
  common_options=(
    '--json-path[Archivo di konfigurashon (predeterminá: ~/.claude/daemon.json)]:path:_files'
    '--log-file[Archivo di log (predeterminá: ~/.claude/daemon.log)]:path:_files'
    '(-h --help)'{-h,--help}'[Mustra e yudansa aki]'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    $common_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'komandunan daemon' daemon_commands
      ;;
    args)
      case $words[1] in
        run)
          _arguments \
            $common_options \
            '::json-path:_files'
          ;;
        stop)
          _arguments \
            $common_options \
            '--any[Tambe stop un daemon temporal (no servisio)]' \
            '--keep-workers[Laga seshonnan desconektá sigui kore]'
          ;;
        status|logs|uninstall)
          _arguments \
            $common_options
          ;;
      esac
      ;;
  esac
}

_claude_import() {
  _arguments \
    '--dry-run[Mustra loke lo wòrdu importá sin skirbi nada]' \
    '--yes[Salta e selektor interaktivo (riba superfisienan headless, pasa --yes=<digest> for di e vista previo di /import)]' \
    '(-h --help)'{-h,--help}'[Mustra yudansa pa e komando]' \
    '::source:(codex gemini cursor)'
}

# compinit autoloads this file, and that first call only defines the functions
# above: complete right away so the first TAB already works. Sourced directly,
# there is nothing to complete yet, only the registration.
if [[ $funcstack[1] == _claude ]]; then
  _claude "$@"
else
  (( $+_comps[claude] )) || compdef _claude claude
fi
