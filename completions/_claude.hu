#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:MCP-kiszolgálók beállítása és kezelése'
    'plugin:Claude Code bővítmények kezelése'
    'agents:Háttérügynökök kezelése'
    'attach:Háttérmunkamenet megnyitása ebben a terminálban'
    'logs:Egy háttérmunkamenet legutóbbi terminálkimenetének kiírása'
    'stop:Háttérmunkamenet leállítása (a beszélgetése megmarad)'
    'respawn:Háttérmunkamenet újraindítása, hogy az aktuális Claude Code verziót futtassa'
    'rm:Háttérmunkamenet és – ha ez biztonságos – a hozzá tartozó worktree törlése'
    'auth:Hitelesítés kezelése'
    'auto-mode:Az automatikus mód osztályozó konfigurációjának megtekintése vagy visszaállítása'
    'gateway:A vállalati hitelesítési/telemetriai átjáró futtatása'
    'import:Konfiguráció importálása egy másik MI-kódolóügynökből a Claude Code-ba'
    'project:Claude Code projektállapot kezelése'
    'ultrareview:Felhőben futó többügynökös kódellenőrzés futtatása és az eredmények kiírása'
    'setup-token:Hosszú távú hitelesítési token beállítása (Claude-előfizetés szükséges)'
    'doctor:A Claude Code automatikus frissítő állapotellenőrzése'
    'update:Frissítések keresése és telepítése'
    'install:A Claude Code natív build telepítése'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Hibakeresési mód engedélyezése opcionális kategóriaszűréssel (pl. "api,hooks" vagy "!statsig,!file")]:filter:'
    '--verbose[A részletes mód beállításának felülírása a konfigurációs fájlból]'
    '(-p --print)'{-p,--print}'[A válasz kiírása és kilépés (csővezetékekkel való használatra). Megjegyzés: csak megbízható könyvtárakban használja]'
    '--output-format[Kimeneti formátum (a --print mellett): "text" (alapértelmezett), "json" (egyetlen eredmény) vagy "stream-json" (valós idejű streamelés)]:format:(text json stream-json)'
    '--json-schema[JSON-séma a strukturált kimenet ellenőrzéséhez]:schema:'
    '--include-partial-messages[Részleges üzenetdarabok belefoglalása, ahogy megérkeznek (a --print és --output-format=stream-json mellett)]'
    '--input-format[Bemeneti formátum (a --print mellett): "text" (alapértelmezett) vagy "stream-json" (valós idejű streamelt bemenet)]:format:(text stream-json)'
    '--mcp-debug[\[Elavult. Használja helyette a --debug kapcsolót\] MCP hibakeresési mód engedélyezése (megjeleníti az MCP-kiszolgáló hibáit)]'
    '--dangerously-skip-permissions[Az összes engedélyellenőrzés megkerülése. Csak internet-hozzáférés nélküli homokozókhoz ajánlott]'
    '--allow-dangerously-skip-permissions[Az engedélyellenőrzések megkerülésének engedélyezése alapértelmezett bekapcsolás nélkül]'
    '--restricted[Korlátozott mód: a parancsokat vagy kódot futtató eszközök és a WebFetch eltávolítása, a user/project/local beállítások figyelmen kívül hagyása, és a fájleszközök a munkakönyvtárakra korlátozása]'
    '--max-budget-usd[Az API-hívásokra fordítható maximális dollárösszeg (csak --print)]:amount:'
    '--replay-user-messages[A felhasználói üzenetek újraküldése a stdin-ről a stdout-ra megerősítés céljából]'
    '--allowed-tools[Az engedélyezett eszköznevek vesszővel vagy szóközzel elválasztott listája (pl. "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Az engedélyezett eszköznevek vesszővel vagy szóközzel elválasztott listája (camelCase formátum)]:tools:'
    '--tools[Az elérhető eszközök listájának megadása a beépített készletből. Csak nyomtatási mód]:tools:'
    '--disallowed-tools[A tiltott eszköznevek vesszővel vagy szóközzel elválasztott listája (pl. "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[A tiltott eszköznevek vesszővel vagy szóközzel elválasztott listája (camelCase formátum)]:tools:'
    '--mcp-config[MCP-kiszolgálók betöltése JSON-fájlból vagy karakterláncból (szóközzel elválasztva)]:configs:'
    '--system-prompt[A munkamenethez használandó rendszerprompt]:prompt:'
    '--system-prompt-file[Rendszerprompt beolvasása fájlból]:file:_files'
    '--append-system-prompt[Rendszerprompt hozzáfűzése az alapértelmezett rendszerprompthoz]:prompt:'
    '--append-system-prompt-file[Rendszerprompt beolvasása fájlból és hozzáfűzése az alapértelmezett rendszerprompthoz]:file:_files'
    '--system-prompt-snapshot[A rendszerprompt rögzítése beszélgetésenként egyszer és szó szerinti újrafelhasználása minden kérésnél és folytatáskor (on, alapértelmezett), vagy újragenerálása minden kérésnél (off)]:mode:(on off)'
    '--permission-mode[A munkamenethez használandó engedélymód]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Ki válaszol az engedélykérésekre a --print mellett: "host" (az SDK-gazda vagy a --permission-prompt-tool) vagy "none" (minden, ami engedélykérést váltana ki, elutasításra kerül)]:target:(host none)'
    '--permission-prompt-tool[Az engedélykérésekhez használandó MCP-eszköz (csak --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[A legutóbbi beszélgetés folytatása]'
    '(-r --resume)'{-r,--resume}'[Beszélgetés folytatása – adja meg a munkamenet-azonosítót vagy válasszon interaktívan]:sessionId:_claude_sessions'
    '--fork-session[Új munkamenet-azonosító létrehozása az eredeti munkamenet-azonosító újrafelhasználása helyett folytatáskor (a --resume vagy --continue mellett)]'
    '--no-session-persistence[A munkamenet-megőrzés letiltása – a munkamenetek nem lesznek mentve (csak --print)]'
    '--model[Az aktuális munkamenet modellje. Adja meg a legújabb modell aliasát (pl. '\''sonnet'\'' vagy '\''opus'\'')]:model:_claude_model_names'
    '--agent[Az aktuális munkamenet ügynöke. Felülírja az '\''agent'\'' beállítást]:agent:_claude_agent_names'
    '--betas[Az API-kérésekbe belefoglalandó béta fejlécek (csak API-kulcsot használóknak)]:betas:'
    '--fallback-model[Automatikus visszaváltás engedélyezése a megadott modellre, ha az alapértelmezett modell túlterhelt (csak --print)]:model:_claude_model_names'
    '--settings[A beállítások JSON-fájljának elérési útja vagy JSON-karakterlánc további beállítások betöltéséhez]:file-or-json:_files'
    '--add-dir[További könyvtárak, amelyekhez engedélyezhető az eszközhozzáférés]:directories:_directories'
    '--ide[Automatikus csatlakozás az IDE-hez indításkor, ha pontosan egy érvényes IDE érhető el]'
    '--desktop[Megnyitás a Claude Desktop alkalmazásban a terminál helyett (a munkamenet kiválasztásához a --continue vagy --resume <id> mellett)]'
    '--strict-mcp-config[Csak a --mcp-config szerinti MCP-kiszolgálók használata, minden más MCP-beállítás figyelmen kívül hagyása]'
    '--session-id[A beszélgetéshez használandó konkrét munkamenet-azonosító (érvényes UUID kell legyen)]:uuid:'
    '--agents[Egyéni ügynököket meghatározó JSON-objektum]:json:'
    '--setting-sources[A betöltendő beállításforrások vesszővel elválasztott listája (user, project, local)]:sources:'
    '--plugin-dir[Könyvtár, amelyből bővítményeket kell betölteni csak ehhez a munkamenethez (ismételhető)]:paths:_directories'
    '--disable-slash-commands[Az összes perjeles parancs letiltása]'
    '(--bg --background)'{--bg,--background}'[A munkamenet indítása háttérügynökként és azonnali visszatérés]'
    '(-w --worktree)'{-w,--worktree}'[Új git worktree létrehozása ehhez a munkamenethez (opcionálisan adjon meg egy nevet)]::name:'
    '--tmux=-[tmux-munkamenet létrehozása a worktree-hez (--worktree szükséges). Ha elérhetők, az iTerm2 natív paneljeit használja; hagyományos tmuxhoz: --tmux=classic]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Megjelenítendő név beállítása ehhez a munkamenethez]:name:'
    '--effort[Az aktuális munkamenet erőfeszítési szintje]:level:(low medium high xhigh max)'
    '--autocompact[Az automatikus tömörítés ablakmérete (auto, vagy 100k-1M token)]:size:(auto)'
    '--debug-file[Hibakeresési naplók írása egy adott fájl elérési útjára (implicit módon engedélyezi a hibakeresési módot)]:path:_files'
    '--from-pr[Egy PR-hez kapcsolt munkamenet folytatása szám/URL alapján, vagy interaktív választó megnyitása]::value:'
    '--teleport[Teleport-munkamenet folytatása, opcionálisan a munkamenet-azonosító megadásával]::session:'
    '--cloud[Felhőmunkamenet létrehozása a megadott leírással, vagy csatlakozás egy meglévőhöz munkamenet-azonosító vagy claude.ai/code URL alapján]::description-or-session:'
    '--environment[Új felhőmunkamenet létrehozása, amely a megadott saját üzemeltetésű környezetben fut (ccpool_...)]:environment_id:'
    '--remote-control[Interaktív munkamenet indítása engedélyezett Remote Control funkcióval (opcionálisan elnevezve)]::name:'
    '--remote-control-session-name-prefix[Előtag az automatikusan generált Remote Control munkamenetnevekhez]:prefix:'
    '--chrome[A Claude Chrome-integráció engedélyezése]'
    '--no-chrome[A Claude Chrome-integráció letiltása]'
    '--plugin-url[Bővítmény .zip letöltése egy URL-ről csak ehhez a munkamenethez (ismételhető)]:url:'
    '--file[Indításkor letöltendő fájlerőforrások (formátum: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Promptjavaslatok engedélyezése (előrejelzett következő promptot bocsát ki print/SDK módban)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Alügynök szövegének és gondolkodási blokkjainak továbbítása üzenetekként (a --print és stream-json mellett)]'
    '--include-hook-events[Az összes hook életciklus-esemény belefoglalása a kimeneti streambe (a stream-json mellett)]'
    '--exclude-dynamic-system-prompt-sections[A gépenkénti szakaszok áthelyezése az első felhasználói üzenetbe a promptgyorsítótár újrafelhasználásának javítása érdekében]'
    '--brief[A SendUserMessage eszköz engedélyezése az ügynök-felhasználó kommunikációhoz]'
    '--safe-mode[Indítás az összes testreszabás letiltásával (hasznos egy hibás konfiguráció elhárításához)]'
    '--bare[Minimális mód: a hookok, az LSP, a bővítmény-szinkronizálás, az attribúció, az automatikus memória és a CLAUDE.md automatikus felderítésének kihagyása]'
    '--ax-screen-reader[Képernyőolvasó-barát kimenet megjelenítése (egyszerű szöveg, dekoratív keretek vagy animációk nélkül)]'
    '(-v --version)'{-v,--version}'[A verziószám kiírása]'
    '(-h --help)'{-h,--help}'[Súgó megjelenítése a parancshoz]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude parancsok' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése a parancshoz]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "nincs argumentum"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Claude Code MCP-kiszolgáló indítása'
    'add:MCP-kiszolgáló hozzáadása a Claude Code-hoz'
    'remove:MCP-kiszolgáló eltávolítása'
    'list:A beállított MCP-kiszolgálók listázása'
    'get:MCP-kiszolgáló részleteinek lekérése'
    'add-json:MCP-kiszolgáló (stdio vagy SSE) hozzáadása JSON-karakterlánccal'
    'add-from-claude-desktop:MCP-kiszolgálók importálása a Claude Desktopból (csak Mac és WSL)'
    'reset-project-choices:Az összes jóváhagyott/elutasított projektszintű (.mcp.json) kiszolgáló visszaállítása ebben a projektben'
    'login:Hitelesítés egy MCP-kiszolgálóval (HTTP, SSE vagy claude.ai összekötő)'
    'logout:Egy MCP-kiszolgáló tárolt OAuth-hitelesítő adatainak törlése'
    'help:Súgó megjelenítése'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp parancsok' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Hibakeresési mód engedélyezése]' \
            '--verbose[A részletes mód beállításának felülírása a konfigurációs fájlból]' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurációs hatókör (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Átviteli típus (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Környezeti változó beállítása (pl. -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[WebSocket fejléc beállítása]:header:' \
            '--client-id[OAuth-ügyfélazonosító HTTP/SSE-kiszolgálókhoz]:clientId:' \
            '--client-secret[Az OAuth-ügyféltitok bekérése (vagy állítsa be az MCP_CLIENT_SECRET környezeti változót)]' \
            '--callback-port[Rögzített port az OAuth-visszahíváshoz (előre regisztrált átirányítási URI-kat igénylő kiszolgálókhoz)]:port:' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurációs hatókör (local, user, project) – ha nincs megadva, eltávolítás a meglévő hatókörből]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurációs hatókör (local, user, project)]:scope:(local user project)' \
            '--client-secret[Az OAuth-ügyféltitok bekérése (vagy állítsa be az MCP_CLIENT_SECRET környezeti változót)]' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurációs hatókör (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]'
          ;;
        login)
          _arguments \
            '--no-browser[Az engedélyezési URL kiírása böngésző megnyitása helyett (SSH-/fej nélküli munkamenetekhez)]' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Egy bővítmény vagy piactér manifesztjének ellenőrzése'
    'marketplace:Claude Code piacterek kezelése'
    'list:A telepített bővítmények listázása'
    'details:Egy bővítmény összetevő-leltárának és becsült tokenköltségének megjelenítése'
    'configure:Egy bővítmény beállításainak és a be nem állítottaknak a megjelenítése, vagy értékek mentése a stdin-ről'
    'install:Bővítmény telepítése az elérhető piacterekről'
    'i:Bővítmény telepítése az elérhető piacterekről (az install rövidítése)'
    'init:Új bővítmény vázának létrehozása (a következő munkamenetben automatikusan betöltődik)'
    'new:Új bővítmény vázának létrehozása (az init aliasa)'
    'uninstall:Telepített bővítmény eltávolítása'
    'remove:Telepített bővítmény eltávolítása (az uninstall aliasa)'
    'enable:Letiltott bővítmény engedélyezése'
    'disable:Engedélyezett bővítmény letiltása'
    'update:Bővítmény frissítése a legújabb verzióra'
    'eval:Kiértékelési esetek futtatása egy bővítményen és a pontozott eredmények jelentése'
    'prune:A már nem szükséges, automatikusan telepített függőségek eltávolítása'
    'autoremove:A már nem szükséges, automatikusan telepített függőségek eltávolítása (a prune aliasa)'
    'tag:{name}--v{version} git címke létrehozása egy bővítmény kiadásához'
    'test:Egy mod tesztjeinek futtatása'
    'help:Súgó megjelenítése'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'bővítmény parancsok' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[A figyelmeztetések hibaként kezelése (1-es kilépési kód)]' \
            '--json[Az ellenőrzési jelentés kiírása JSON-ként (ugyanazokkal a kilépési kódokkal)]' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Telepítési hatókör]:scope:(user project local)' \
            '*--config[A bővítmény manifesztjében deklarált userConfig beállítás megadása (ismételhető)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[A megjelenített, piactér által deklarált parancs elfogadása megerősítő kérdés nélkül]' \
            '--json[Egyetlen géppel olvasható eredménysor kiírása az ember számára írt üzenet helyett]' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Telepítési hatókör]:scope:(user project local)' \
            '--keep-data[A bővítmény állandó adatkönyvtárának megőrzése]' \
            '--prune[A már nem szükséges, automatikusan telepített függőségek eltávolítása is]' \
            '(-y --yes)'{-y,--yes}'[A --prune megerősítő kérdésének kihagyása]' \
            '--json[Egyetlen géppel olvasható eredménysor kiírása az ember számára írt üzenet helyett (a --prune mellett nem)]' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Telepítési hatókör]:scope:(user project local)' \
            '--json[Egyetlen géppel olvasható eredménysor kiírása az ember számára írt üzenet helyett]' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Az összes engedélyezett bővítmény letiltása]' \
            '(-s --scope)'{-s,--scope}'[Telepítési hatókör]:scope:(user project local)' \
            '--json[Egyetlen géppel olvasható eredménysor kiírása az ember számára írt üzenet helyett]' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Telepítési hatókör]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[A megjelenített, piactér által deklarált parancs elfogadása megerősítő kérdés nélkül]' \
            '--json[Egyetlen géppel olvasható eredménysor kiírása az ember számára írt üzenet helyett]' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Kimenet JSON-ként]' \
            '--available[A piactereken elérhető bővítmények belefoglalása (--json szükséges)]' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Tisztítás a megadott hatókörben]:scope:(user project local)' \
            '--dry-run[Az eltávolítandó elemek listázása eltávolítás nélkül]' \
            '(-y --yes)'{-y,--yes}'[A megerősítő kérdés kihagyása]' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]'
          ;;
        configure)
          _arguments \
            '--json[Kimenet JSON-ként]' \
            '--values-stdin[A beállítások értékeinek beolvasása a stdin-ről egysoros karakterláncokat tartalmazó JSON-objektumként; a kihagyott beállítások megtartják értéküket]' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[A manifeszt leírása]:text:' \
            '--author[Szerző neve (alapértelmezett: git config user.name)]:name:' \
            '--author-email[Szerző e-mail-címe (alapértelmezett: git config user.email)]:email:' \
            '--with[További összetevők, amelyek vázát szintén létre kell hozni]:components:' \
            '(-f --force)'{-f,--force}'[A célhelyen meglévő .claude-plugin/ felülírása]' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Esetek szűrése névmintával (glob)]:glob:' \
            '*--tag[Esetek szűrése címke szerint (ismételhető)]:tag:' \
            '--runs[Az esetenkénti futtatások számának felülírása (alapértelmezett: case.runs, egyébként 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Legfeljebb n ügynökfuttatás egyidejű végrehajtása (1-8; alapértelmezett: 1)]:n:' \
            '--model[A modell felülírása az összes esetre]:model:_claude_model_names' \
            '--judge-model[Az LLM-értékelő modelljének felülírása (alapértelmezett: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Szigorú költségplafon; elérésekor megszakítás és a részleges eredmények jelentése (2-es kilépési kód)]:usd:' \
            '--output-dir[Az aggregate-result.json könyvtára]:dir:_directories' \
            '--eval-dir[A kiértékelési eseteket tartalmazó könyvtár neve (a bővítményen belül)]:dir:' \
            '--json[A teljes futtatási eredmény kiírása JSON-ként a stdout-ra, vagy írása ebbe a .json fájlba]::path:_files' \
            '--threshold[Kilépés 1-es kilépési kóddal, ha bármely eset pontszáma e küszöb alatt van (alapértelmezett: 1.0)]:threshold:' \
            '*--allow-tools[Üzemeltetői engedély a korlátozott eszközökhöz (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Az egyes esetek scaffold_script szkriptjének futtatása (a szerző által megadott bash-t az Ön nevében futtatja; alapértelmezés szerint kikapcsolva)]' \
            '(--scaffold)--no-scaffold[A scaffold_script kifejezett kihagyása]' \
            '--trust-plugin[Annak megerősítése, hogy megbízik ebben a bővítményben és kiértékelési készletében, az első futtatáskori bizalmi kérdés kihagyásával (CI-hoz)]' \
            '--ablation[Bővítmény nélküli kontrollcsoport (baseline) futtatása és a pontszámkülönbség jelentése]:mode:(none with-without)' \
            '--mocks[Mock helyettesítők az MCP-kiszolgálókhoz a <eval dir>/mocks/ könyvtárból]:mode:(record off)' \
            '--allow-real-servers[A --mocks record mellett: a mock nélküli valódi MCP-kiszolgáló-folyamatok elindítása is]' \
            '--keep-temp[A vázkönyvtárak megőrzése hibakereséshez]' \
            '--verbose[Üzenetenkénti nyomkövetési események naplózása a hibakeresési naplóba]' \
            '--report[Az önálló HTML-jelentés írása erre az elérési útra az eredménykönyvtár helyett]:path:_files' \
            '(--no-publish)--publish-report[A jelentés claude.ai-on való közzétételének megkövetelése is]' \
            '(--publish-report)--no-publish[A HTML-jelentés csak helyben tartása; a claude.ai-on való közzététel kihagyása]' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[A címke feltöltése a --remote által megadott távoli tárolóba a létrehozása után]' \
            '--dry-run[A címkézendő elem kiírása a címke létrehozása nélkül]' \
            '(-f --force)'{-f,--force}'[A módosított munkafa és a már létező címke ellenőrzésének kihagyása]' \
            '(-m --message)'{-m,--message}'[A címke annotációs üzenete (a verzióhoz használja a %s helyőrzőt)]:msg:' \
            '--remote[A --push mellett használt távoli tároló]:name:' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Piactér hozzáadása URL-ből, elérési útból vagy GitHub-tárolóból'
    'list:A beállított piacterek listázása'
    'remove:Egy beállított piactér eltávolítása'
    'rm:Egy beállított piactér eltávolítása (a remove aliasa)'
    'update:Piactér frissítése a forrásból – az összes frissítése, ha nincs név megadva'
    'help:Súgó megjelenítése'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'piactér parancsok' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[A checkout korlátozása adott könyvtárakra git sparse-checkout segítségével (monorepókhoz)]:paths:' \
            '--scope[Hol legyen deklarálva a piactér]:scope:(user project local)' \
            '--claudeai[Az ilyen nevű, a claude.ai által az Ön számára üzemeltetett piactér hozzáadása]' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Kimenet JSON-ként]' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]'
          ;;
        remove|rm)
          _arguments \
            '--scope[A piactér-deklaráció eltávolítása egy adott beállítási hatókörből (ha nincs megadva, eltávolítás minden hatókörből)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Telepítés kényszerítése akkor is, ha már telepítve van]' \
    '(-h --help)'{-h,--help}'[Súgó megjelenítése]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[További könyvtár, amelyhez engedélyezhető az eszközhozzáférés az elindított munkamenetekben]:directory:_directories' \
    '--agent[Az ügynöknézetből elindított munkamenetek alapértelmezett ügynöke]:agent:_claude_agent_names' \
    '--all[A --json mellett: a befejezett háttérmunkamenetek belefoglalása is]' \
    '--allow-dangerously-skip-permissions[Az engedélymegkerülő mód elérhetővé tétele az elindított munkamenetek számára]' \
    '--cwd[Csak a megadott útvonal alatt indított háttérmunkamenetek megjelenítése]:path:_directories' \
    '--dangerously-skip-permissions[A --permission-mode bypassPermissions aliasa]' \
    '--effort[Az elindított munkamenetek alapértelmezett erőfeszítési szintje]:level:(low medium high xhigh max)' \
    '--json[Az aktív munkamenetek kiírása JSON-tömbként és kilépés]' \
    '*--mcp-config[Az elindított munkamenetekre alkalmazandó MCP-kiszolgáló-konfiguráció]:config:' \
    '--model[Az ügynöknézetből elindított munkamenetek alapértelmezett modellje]:model:_claude_model_names' \
    '--permission-mode[Az elindított munkamenetek alapértelmezett engedélymódja]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Bővítmények betöltése egy könyvtárból az ügynöknézethez és az elindított munkamenetekhez]:path:_directories' \
    '--setting-sources[A betöltendő beállításforrások vesszővel elválasztott listája (user, project, local)]:sources:' \
    '--settings[Az alkalmazandó beállításfájl vagy JSON-karakterlánc]:file-or-json:_files' \
    '--strict-mcp-config[Csak a --mcp-config szerinti MCP-kiszolgálók használata az elindított munkamenetekben]' \
    '--restricted[A kiküldött munkamenetek indítása korlátozott módban]' \
    '(-h --help)'{-h,--help}'[Súgó megjelenítése a parancshoz]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Bejelentkezés az Anthropic-fiókjába'
    'logout:Kijelentkezés az Anthropic-fiókjából'
    'status:A hitelesítés állapotának megjelenítése'
    'help:Súgó megjelenítése'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Súgó megjelenítése a parancshoz]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth parancsok' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Az e-mail-cím előzetes kitöltése a bejelentkezési oldalon]:email:' \
            '--sso[SSO-bejelentkezési folyamat kényszerítése]' \
            '(--claudeai)--console[Az Anthropic Console használata (API-használat alapú számlázás) Claude-előfizetés helyett]' \
            '(--console)--claudeai[Claude-előfizetés használata (alapértelmezett)]' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése a parancshoz]'
          ;;
        status)
          _arguments \
            '(--text)--json[Kimenet JSON-ként (alapértelmezett)]' \
            '(--json)--text[Kimenet ember által olvasható szövegként]' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése a parancshoz]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése a parancshoz]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Az érvényes automatikus mód konfiguráció kiírása JSON-ként'
    'critique:MI-visszajelzés kérése az egyéni automatikus mód szabályairól'
    'defaults:Az alapértelmezett automatikus mód szabályok kiírása JSON-ként'
    'reset:Az automatikus mód konfigurációjának visszaállítása a szállított alapértelmezésekre'
    'help:Súgó megjelenítése'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Súgó megjelenítése a parancshoz]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode parancsok' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[A használt modell felülírása]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése a parancshoz]'
          ;;
        defaults)
          _arguments \
            '--label[Csak azon szabályok megjelenítése, amelyek címkéje ezzel az előtaggal kezdődik (kis- és nagybetűtől független)]:prefix:' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése a parancshoz]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[A megerősítő kérdés kihagyása]' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése a parancshoz]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése a parancshoz]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Az átjáró YAML-konfigurációjának elérési útja]:path:_files' \
    '(-h --help)'{-h,--help}'[Súgó megjelenítése a parancshoz]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Egy projekt összes Claude Code állapotának törlése (átiratok, feladatok, fájlelőzmények, konfigurációs bejegyzés)'
    'help:Súgó megjelenítése'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Súgó megjelenítése a parancshoz]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project parancsok' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[A törlendő elemek listázása, anélkül hogy bármi törlődne]' \
            '(-y --yes)'{-y,--yes}'[A megerősítő kérdés kihagyása]' \
            '(-i --interactive)'{-i,--interactive}'[Rákérdezés minden elemre törlés előtt]' \
            '(1)--all[Az állapot törlése minden projektre (elérési úttal együtt nem használható)]' \
            '(-h --help)'{-h,--help}'[Súgó megjelenítése a parancshoz]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[A nyers bugs.json adatküldemény kiírása a formázott eredmények helyett]' \
    '--timeout[A felülvizsgálat befejezésére való várakozás leghosszabb ideje percben (alapértelmezett: 45)]:minutes:' \
    '(--no-post)--post[A kész felülvizsgálat megállapításainak közzététele a PR-ben az Ön nevében (csak PR-célpontoknál; egyetlen egyszerű megjegyzés, nem felülvizsgálat)]' \
    '(--post)--no-post[A megállapítások közzétételének mellőzése a PR-ben (alapértelmezett)]' \
    '(-h --help)'{-h,--help}'[Súgó megjelenítése a parancshoz]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Az összes futó háttérmunkamenet újraindítása]' \
    '(-h --help)'{-h,--help}'[Súgó megjelenítése a parancshoz]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[A worktree fel nem töltött commitjainak és nem véglegesített módosításainak elvetése is (adja meg a korábbi claude rm által jelzett commit@worktree-id értéket)]:commit@worktree-id:' \
    '--force-remove-worktree[A worktree-könyvtár törlése akkor is, ha a WorktreeRemove hook vagy a git nem tudta eltávolítani (adja meg a korábbi claude rm által jelzett worktree-id értéket)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Súgó megjelenítése a parancshoz]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Az importálandó elemek megjelenítése, anélkül hogy bármi kiírásra kerülne]' \
    '--yes[Az interaktív választó kihagyása (fej nélküli felületeken adja meg a --yes=<digest> értéket az /import előnézetéből)]' \
    '(-h --help)'{-h,--help}'[Súgó megjelenítése a parancshoz]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
