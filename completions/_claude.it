#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Configura e gestisce i server MCP'
    'plugin:Gestisce i plugin di Claude Code'
    'agents:Gestisce gli agenti in background'
    'attach:Apre una sessione in background in questo terminale'
    'logs:Stampa l'\''output recente del terminale di una sessione in background'
    'stop:Ferma una sessione in background (la conversazione viene conservata)'
    'respawn:Riavvia una sessione in background perché usi la versione corrente di Claude Code'
    'rm:Elimina una sessione in background, e il suo worktree quando è sicuro farlo'
    'auth:Gestisce l'\''autenticazione'
    'auto-mode:Ispeziona o reimposta la configurazione del classificatore della modalità automatica'
    'gateway:Avvia il gateway aziendale di autenticazione/telemetria'
    'import:Importa la configurazione di un altro agente di coding IA in Claude Code'
    'project:Gestisce lo stato del progetto di Claude Code'
    'ultrareview:Esegue una revisione del codice multi-agente ospitata nel cloud e stampa i risultati'
    'setup-token:Configura il token di autenticazione a lungo termine (richiede abbonamento Claude)'
    'doctor:Verifica dello stato di salute dell'\''aggiornamento automatico di Claude Code'
    'update:Verifica e installa gli aggiornamenti'
    'install:Installa la build nativa di Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Attiva la modalità debug con filtraggio opzionale per categoria (es. "api,hooks" o "!statsig,!file")]:filter:'
    '--verbose[Sostituisce l'\''impostazione della modalità dettagliata dal file di configurazione]'
    '(-p --print)'{-p,--print}'[Stampa la risposta ed esce (per l'\''uso con pipe). Nota: utilizzare solo in directory affidabili]'
    '--output-format[Formato di output (con --print): "text" (predefinito), "json" (singolo risultato) o "stream-json" (streaming in tempo reale)]:format:(text json stream-json)'
    '--json-schema[Schema JSON per la validazione dell'\''output strutturato]:schema:'
    '--include-partial-messages[Include i frammenti parziali dei messaggi man mano che arrivano (con --print e --output-format=stream-json)]'
    '--input-format[Formato di input (con --print): "text" (predefinito) o "stream-json" (input streaming in tempo reale)]:format:(text stream-json)'
    '--mcp-debug[\[Deprecato. Utilizzare --debug invece\] Attiva la modalità debug MCP (mostra gli errori del server MCP)]'
    '--dangerously-skip-permissions[Ignora tutti i controlli dei permessi. Consigliato solo per ambienti sandbox senza accesso a Internet]'
    '--allow-dangerously-skip-permissions[Abilita l'\''opzione per ignorare i controlli dei permessi senza abilitarla per impostazione predefinita]'
    '--restricted[Modalità ristretta: rimuove gli strumenti che eseguono comandi o codice e WebFetch, ignora le impostazioni user/project/local e limita gli strumenti sui file alle directory di lavoro]'
    '--max-budget-usd[Importo massimo in dollari da spendere per le chiamate API (solo --print)]:amount:'
    '--replay-user-messages[Reinvia i messaggi utente da stdin su stdout per conferma]'
    '--allowed-tools[Lista separata da virgole o spazi degli strumenti consentiti (es. "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Lista separata da virgole o spazi degli strumenti consentiti (formato camelCase)]:tools:'
    '--tools[Specifica la lista degli strumenti disponibili dal set integrato. Solo modalità stampa]:tools:'
    '--disallowed-tools[Lista separata da virgole o spazi degli strumenti non consentiti (es. "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Lista separata da virgole o spazi degli strumenti non consentiti (formato camelCase)]:tools:'
    '--mcp-config[Carica i server MCP da file JSON o stringa (separati da spazi)]:configs:'
    '--system-prompt[Prompt di sistema da utilizzare per la sessione]:prompt:'
    '--system-prompt-file[Legge il prompt di sistema da un file]:file:_files'
    '--append-system-prompt[Aggiunge il prompt di sistema al prompt di sistema predefinito]:prompt:'
    '--append-system-prompt-file[Legge il prompt di sistema da un file e lo aggiunge al prompt di sistema predefinito]:file:_files'
    '--system-prompt-snapshot[Registra il prompt di sistema una volta per conversazione e lo riutilizza tale e quale a ogni richiesta e ripresa (on, predefinito) oppure lo rigenera a ogni richiesta (off)]:mode:(on off)'
    '--permission-mode[Modalità dei permessi da utilizzare per la sessione]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Chi risponde alle richieste di permesso con --print: "host" (l'\''host SDK o --permission-prompt-tool) oppure "none" (tutto ciò che chiederebbe conferma viene negato)]:target:(host none)'
    '--permission-prompt-tool[Strumento MCP da usare per le richieste di permesso (solo --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Continua la conversazione più recente]'
    '(-r --resume)'{-r,--resume}'[Riprende una conversazione - specifica l'\''ID sessione o seleziona interattivamente]:sessionId:_claude_sessions'
    '--fork-session[Crea un nuovo ID sessione invece di riutilizzare l'\''ID sessione originale durante la ripresa (con --resume o --continue)]'
    '--no-session-persistence[Disabilita la persistenza della sessione - le sessioni non verranno salvate (solo --print)]'
    '--model[Modello per la sessione corrente. Specifica un alias per l'\''ultimo modello (es. '\''sonnet'\'' o '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agente per la sessione corrente. Sostituisce l'\''impostazione '\''agent'\'']:agent:_claude_agent_names'
    '--betas[Header beta da includere nelle richieste API (solo per utenti con chiave API)]:betas:'
    '--fallback-model[Abilita il fallback automatico al modello specificato quando il modello predefinito è sovraccarico (solo --print)]:model:_claude_model_names'
    '--settings[Percorso al file JSON delle impostazioni o stringa JSON per caricare impostazioni aggiuntive]:file-or-json:_files'
    '--add-dir[Directory aggiuntive per consentire l'\''accesso agli strumenti]:directories:_directories'
    '--ide[Connette automaticamente all'\''IDE all'\''avvio se è disponibile esattamente un IDE valido]'
    '--strict-mcp-config[Utilizza solo i server MCP da --mcp-config e ignora tutte le altre impostazioni MCP]'
    '--session-id[ID sessione specifico da utilizzare per la conversazione (deve essere un UUID valido)]:uuid:'
    '--agents[Oggetto JSON che definisce gli agenti personalizzati]:json:'
    '--setting-sources[Lista separata da virgole delle fonti di impostazioni da caricare (user, project, local)]:sources:'
    '--plugin-dir[Directory da cui caricare i plugin solo per questa sessione (ripetibile)]:paths:_directories'
    '--disable-slash-commands[Disabilita tutti i comandi slash]'
    '(--bg --background)'{--bg,--background}'[Avvia la sessione come agente in background e ritorna immediatamente]'
    '(-w --worktree)'{-w,--worktree}'[Crea un nuovo git worktree per questa sessione (opzionalmente specifica un nome)]::name:'
    '--tmux=-[Crea una sessione tmux per il worktree (richiede --worktree). Usa i pannelli nativi di iTerm2 quando disponibili; --tmux=classic per il tmux tradizionale]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Imposta un nome visualizzato per questa sessione]:name:'
    '--effort[Livello di impegno per la sessione corrente]:level:(low medium high xhigh max)'
    '--autocompact[Dimensione della finestra di compattazione automatica (auto, oppure da 100k a 1M di token)]:size:(auto)'
    '--debug-file[Scrive i log di debug in un percorso di file specifico (attiva implicitamente la modalità debug)]:path:_files'
    '--from-pr[Riprende una sessione collegata a una PR per numero/URL, o apre il selettore interattivo]::value:'
    '--teleport[Riprende una sessione teleport, opzionalmente specificando l'\''ID di sessione]::session:'
    '--cloud[Crea una sessione cloud con la descrizione indicata, oppure si collega a una esistente tramite ID di sessione o URL claude.ai/code]::description-or-session:'
    '--environment[Crea una nuova sessione cloud eseguita nell'\''ambiente self-hosted indicato (ccpool_...)]:environment_id:'
    '--remote-control[Avvia una sessione interattiva con Remote Control abilitato (opzionalmente con nome)]::name:'
    '--remote-control-session-name-prefix[Prefisso per i nomi delle sessioni Remote Control generati automaticamente]:prefix:'
    '--chrome[Abilita l'\''integrazione di Claude in Chrome]'
    '--no-chrome[Disabilita l'\''integrazione di Claude in Chrome]'
    '--plugin-url[Recupera un file .zip di plugin da un URL solo per questa sessione (ripetibile)]:url:'
    '--file[Risorse file da scaricare all'\''avvio (formato: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Abilita i suggerimenti di prompt (emette un prompt successivo previsto in modalità print/SDK)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Inoltra il testo e i blocchi di ragionamento dei subagenti come messaggi (con --print e stream-json)]'
    '--include-hook-events[Include tutti gli eventi del ciclo di vita degli hook nel flusso di output (con stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Sposta le sezioni per-macchina nel primo messaggio utente per migliorare il riutilizzo della cache dei prompt]'
    '--brief[Abilita lo strumento SendUserMessage per la comunicazione agente-utente]'
    '--safe-mode[Avvia con tutte le personalizzazioni disabilitate (utile per risolvere una configurazione danneggiata)]'
    '--bare[Modalità minima: salta hook, LSP, sincronizzazione plugin, attribuzione, auto-memory e rilevamento automatico di CLAUDE.md]'
    '--ax-screen-reader[Genera output compatibile con gli screen reader (testo semplice, senza bordi decorativi o animazioni)]'
    '(-v --version)'{-v,--version}'[Mostra il numero di versione]'
    '(-h --help)'{-h,--help}'[Mostra la guida per il comando]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude commands' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostra la guida per il comando]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "no arguments"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Avvia un server MCP di Claude Code'
    'add:Aggiunge un server MCP a Claude Code'
    'remove:Rimuove un server MCP'
    'list:Elenca i server MCP configurati'
    'get:Ottiene i dettagli del server MCP'
    'add-json:Aggiunge un server MCP (stdio o SSE) con stringa JSON'
    'add-from-claude-desktop:Importa i server MCP da Claude Desktop (solo Mac e WSL)'
    'reset-project-choices:Reimposta tutti i server con ambito progetto (.mcp.json) approvati/rifiutati in questo progetto'
    'login:Autentica con un server MCP (HTTP, SSE o connettore claude.ai)'
    'logout:Cancella le credenziali OAuth memorizzate per un server MCP'
    'help:Mostra la guida'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostra la guida]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp commands' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Attiva la modalità debug]' \
            '--verbose[Sostituisce l'\''impostazione della modalità dettagliata dal file di configurazione]' \
            '(-h --help)'{-h,--help}'[Mostra la guida]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambito di configurazione (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Tipo di trasporto (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Imposta una variabile d'\''ambiente (es. -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Imposta l'\''header WebSocket]:header:' \
            '--client-id[ID client OAuth per i server HTTP/SSE]:clientId:' \
            '--client-secret[Chiede il client secret OAuth (oppure imposta la variabile d'\''ambiente MCP_CLIENT_SECRET)]' \
            '--callback-port[Porta fissa per il callback OAuth (per server che richiedono URI di redirect preregistrati)]:port:' \
            '(-h --help)'{-h,--help}'[Mostra la guida]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambito di configurazione (local, user, project) - rimuove dall'\''ambito esistente se non specificato]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Mostra la guida]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostra la guida]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostra la guida]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambito di configurazione (local, user, project)]:scope:(local user project)' \
            '--client-secret[Chiede il client secret OAuth (oppure imposta la variabile d'\''ambiente MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Mostra la guida]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambito di configurazione (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Mostra la guida]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostra la guida]'
          ;;
        login)
          _arguments \
            '--no-browser[Stampa l'\''URL di autorizzazione invece di aprire un browser (per sessioni SSH/headless)]' \
            '(-h --help)'{-h,--help}'[Mostra la guida]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostra la guida]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Valida un plugin o un manifesto del marketplace'
    'marketplace:Gestisce i marketplace di Claude Code'
    'list:Elenca i plugin installati'
    'details:Mostra l'\''inventario dei componenti e il costo previsto in token per un plugin'
    'install:Installa un plugin dai marketplace disponibili'
    'i:Installa un plugin dai marketplace disponibili (abbreviazione di install)'
    'init:Crea la struttura di un nuovo plugin (caricato automaticamente alla sessione successiva)'
    'new:Crea lo scheletro di un nuovo plugin (alias di init)'
    'uninstall:Disinstalla un plugin installato'
    'remove:Disinstalla un plugin installato (alias di uninstall)'
    'enable:Abilita un plugin disabilitato'
    'disable:Disabilita un plugin abilitato'
    'update:Aggiorna un plugin all'\''ultima versione'
    'eval:Esegue casi di valutazione su un plugin e riporta i risultati con punteggio'
    'prune:Rimuove le dipendenze installate automaticamente che non sono più necessarie'
    'autoremove:Rimuove le dipendenze installate automaticamente che non sono più necessarie (alias di prune)'
    'tag:Crea un tag git {name}--v{version} per il rilascio di un plugin'
    'help:Mostra la guida'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostra la guida]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin commands' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Tratta gli avvisi come errori (exit 1)]' \
            '--json[Stampa il rapporto di validazione in JSON (stessi codici di uscita)]' \
            '(-h --help)'{-h,--help}'[Mostra la guida]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambito di installazione]:scope:(user project local)' \
            '*--config[Imposta un'\''opzione userConfig dichiarata nel manifesto del plugin (ripetibile)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Accetta il comando dichiarato dal marketplace mostrato senza richiesta di conferma]' \
            '--json[Stampa una riga di risultato leggibile dalla macchina invece del messaggio per le persone]' \
            '(-h --help)'{-h,--help}'[Mostra la guida]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambito di installazione]:scope:(user project local)' \
            '--keep-data[Conserva la directory dei dati persistenti del plugin]' \
            '--prune[Rimuove anche le dipendenze installate automaticamente che non sono più necessarie]' \
            '(-y --yes)'{-y,--yes}'[Salta la richiesta di conferma di --prune]' \
            '--json[Stampa una riga di risultato leggibile dalla macchina invece del messaggio per le persone (non con --prune)]' \
            '(-h --help)'{-h,--help}'[Mostra la guida]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambito di installazione]:scope:(user project local)' \
            '--json[Stampa una riga di risultato leggibile dalla macchina invece del messaggio per le persone]' \
            '(-h --help)'{-h,--help}'[Mostra la guida]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Disabilita tutti i plugin abilitati]' \
            '(-s --scope)'{-s,--scope}'[Ambito di installazione]:scope:(user project local)' \
            '--json[Stampa una riga di risultato leggibile dalla macchina invece del messaggio per le persone]' \
            '(-h --help)'{-h,--help}'[Mostra la guida]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambito di installazione]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Accetta il comando dichiarato dal marketplace mostrato senza richiesta di conferma]' \
            '--json[Stampa una riga di risultato leggibile dalla macchina invece del messaggio per le persone]' \
            '(-h --help)'{-h,--help}'[Mostra la guida]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Output in JSON]' \
            '--available[Include i plugin disponibili nei marketplace (richiede --json)]' \
            '(-h --help)'{-h,--help}'[Mostra la guida]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Ambito in cui ripulire]:scope:(user project local)' \
            '--dry-run[Elenca cosa verrebbe rimosso senza rimuovere nulla]' \
            '(-y --yes)'{-y,--yes}'[Salta la richiesta di conferma]' \
            '(-h --help)'{-h,--help}'[Mostra la guida]'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostra la guida]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Descrizione del manifesto]:text:' \
            '--author[Nome dell'\''autore (predefinito: git config user.name)]:name:' \
            '--author-email[Email dell'\''autore (predefinito: git config user.email)]:email:' \
            '--with[Componenti da generare in aggiunta]:components:' \
            '(-f --force)'{-f,--force}'[Sovrascrive un .claude-plugin/ esistente nella destinazione]' \
            '(-h --help)'{-h,--help}'[Mostra la guida]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Filtra i casi per glob del nome]:glob:' \
            '*--tag[Filtra i casi per tag (ripetibile)]:tag:' \
            '--runs[Sovrascrive le esecuzioni per caso (predefinito: case.runs, altrimenti 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Esegue fino a n agenti contemporaneamente (1-8; predefinito 1)]:n:' \
            '--model[Sovrascrive il modello per tutti i casi]:model:_claude_model_names' \
            '--judge-model[Sovrascrive il modello del valutatore LLM (predefinito: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Tetto massimo di costo; interrompe e riporta i risultati parziali se raggiunto (exit 2)]:usd:' \
            '--output-dir[Directory per aggregate-result.json]:dir:_directories' \
            '--eval-dir[Nome della directory (sotto il plugin) che contiene i casi di valutazione]:dir:' \
            '--json[Stampa il risultato completo dell'\''esecuzione in JSON su stdout, oppure lo scrive in questo file .json]::path:_files' \
            '--threshold[Esce con 1 se il punteggio di un caso è sotto questa soglia (predefinito: 1.0)]:threshold:' \
            '*--allow-tools[Autorizzazione dell'\''operatore per gli strumenti soggetti a controllo (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Esegue lo scaffold_script di ogni caso (esegue bash fornito dall'\''autore con il tuo utente; disattivato per impostazione predefinita)]' \
            '(--scaffold)--no-scaffold[Salta esplicitamente scaffold_script]' \
            '--trust-plugin[Dichiara che ti fidi di questo plugin e della sua suite di valutazione, saltando la richiesta di fiducia alla prima esecuzione (per la CI)]' \
            '--ablation[Esegue anche una baseline senza plugin e riporta la differenza di punteggio]:mode:(none with-without)' \
            '--mocks[Sostituti simulati dei server MCP, da <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Con --mocks record: avvia anche i processi reali dei server MCP privi di mock]' \
            '--keep-temp[Conserva le directory di scaffold per il debug]' \
            '--verbose[Registra gli eventi di traccia per messaggio nel log di debug]' \
            '--report[Scrive il rapporto HTML autonomo in questo percorso invece che nella directory dei risultati]:path:_files' \
            '(--no-publish)--publish-report[Richiede anche la pubblicazione del rapporto su claude.ai]' \
            '(--publish-report)--no-publish[Mantiene il rapporto HTML solo in locale; non lo pubblica su claude.ai]' \
            '(-h --help)'{-h,--help}'[Mostra la guida]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Esegue il push del tag su --remote dopo averlo creato]' \
            '--dry-run[Stampa cosa verrebbe taggato senza creare il tag]' \
            '(-f --force)'{-f,--force}'[Salta i controlli su albero di lavoro modificato e tag già esistente]' \
            '(-m --message)'{-m,--message}'[Messaggio di annotazione del tag (usa %s per la versione)]:msg:' \
            '--remote[Remote su cui fare push con --push]:name:' \
            '(-h --help)'{-h,--help}'[Mostra la guida]' \
            '::path:_files'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Aggiunge un marketplace da URL, percorso o repository GitHub'
    'list:Elenca i marketplace configurati'
    'remove:Rimuove un marketplace configurato'
    'rm:Rimuove un marketplace configurato (alias di remove)'
    'update:Aggiorna il marketplace dalla sorgente - aggiorna tutti se non viene specificato un nome'
    'help:Mostra la guida'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostra la guida]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace commands' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Limita il checkout a directory specifiche tramite git sparse-checkout (per i monorepo)]:paths:' \
            '--scope[Dove dichiarare il marketplace]:scope:(user project local)' \
            '--claudeai[Aggiunge il marketplace con questo nome che claude.ai ospita per te]' \
            '(-h --help)'{-h,--help}'[Mostra la guida]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Output in JSON]' \
            '(-h --help)'{-h,--help}'[Mostra la guida]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Rimuove la dichiarazione del marketplace da un ambito di impostazioni specifico (ometti per rimuoverla da tutti)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Mostra la guida]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostra la guida]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Forza l'\''installazione anche se già installato]' \
    '(-h --help)'{-h,--help}'[Mostra la guida]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Directory aggiuntiva per consentire l'\''accesso agli strumenti nelle sessioni avviate]:directory:_directories' \
    '--agent[Agente predefinito per le sessioni avviate dalla vista agenti]:agent:_claude_agent_names' \
    '--all[Con --json: include anche le sessioni in background completate]' \
    '--allow-dangerously-skip-permissions[Rende disponibile la modalità bypass-permissions alle sessioni avviate]' \
    '--cwd[Mostra solo le sessioni in background avviate sotto il percorso]:path:_directories' \
    '--dangerously-skip-permissions[Alias di --permission-mode bypassPermissions]' \
    '--effort[Livello di impegno predefinito per le sessioni avviate]:level:(low medium high xhigh max)' \
    '--json[Stampa le sessioni attive come array JSON ed esce]' \
    '*--mcp-config[Configurazione del server MCP da applicare alle sessioni avviate]:config:' \
    '--model[Modello predefinito per le sessioni avviate dalla vista agenti]:model:_claude_model_names' \
    '--permission-mode[Modalità dei permessi predefinita per le sessioni avviate]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Carica i plugin dalla directory per la vista agenti e le sessioni avviate]:path:_directories' \
    '--setting-sources[Lista separata da virgole delle fonti di impostazioni da caricare (user, project, local)]:sources:' \
    '--settings[File delle impostazioni o stringa JSON da applicare]:file-or-json:_files' \
    '--strict-mcp-config[Utilizza solo i server MCP da --mcp-config nelle sessioni avviate]' \
    '--restricted[Avvia le sessioni lanciate in modalità ristretta]' \
    '(-h --help)'{-h,--help}'[Mostra la guida per il comando]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Accedi al tuo account Anthropic'
    'logout:Disconnetti dal tuo account Anthropic'
    'status:Mostra lo stato dell'\''autenticazione'
    'help:Mostra la guida'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostra la guida per il comando]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth commands' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Precompila l'\''indirizzo email nella pagina di accesso]:email:' \
            '--sso[Forza il flusso di accesso SSO]' \
            '(--claudeai)--console[Usa Anthropic Console (fatturazione a consumo API) invece dell'\''abbonamento Claude]' \
            '(--console)--claudeai[Usa l'\''abbonamento Claude (predefinito)]' \
            '(-h --help)'{-h,--help}'[Mostra la guida per il comando]'
          ;;
        status)
          _arguments \
            '(--text)--json[Output in JSON (predefinito)]' \
            '(--json)--text[Output come testo leggibile]' \
            '(-h --help)'{-h,--help}'[Mostra la guida per il comando]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostra la guida per il comando]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Stampa la configurazione effettiva della modalità automatica come JSON'
    'critique:Ottieni feedback AI sulle tue regole personalizzate della modalità automatica'
    'defaults:Stampa le regole predefinite della modalità automatica come JSON'
    'reset:Reimposta la configurazione della modalità automatica ai valori predefiniti di fabbrica'
    'help:Mostra la guida'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostra la guida per il comando]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode commands' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Sovrascrive il modello utilizzato]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Mostra la guida per il comando]'
          ;;
        defaults)
          _arguments \
            '--label[Mostra solo le regole la cui etichetta inizia con questo prefisso (senza distinzione tra maiuscole e minuscole)]:prefix:' \
            '(-h --help)'{-h,--help}'[Mostra la guida per il comando]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Salta la richiesta di conferma]' \
            '(-h --help)'{-h,--help}'[Mostra la guida per il comando]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Mostra la guida per il comando]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Percorso al file di configurazione YAML del gateway]:path:_files' \
    '(-h --help)'{-h,--help}'[Mostra la guida per il comando]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Elimina tutto lo stato di Claude Code per un progetto (trascrizioni, task, cronologia dei file, voce di configurazione)'
    'help:Mostra la guida'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Mostra la guida per il comando]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project commands' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Elenca cosa verrebbe eliminato senza eliminare nulla]' \
            '(-y --yes)'{-y,--yes}'[Salta la richiesta di conferma]' \
            '(-i --interactive)'{-i,--interactive}'[Chiede conferma per ogni elemento prima di eliminarlo]' \
            '(1)--all[Elimina lo stato di tutti i progetti (incompatibile con un percorso)]' \
            '(-h --help)'{-h,--help}'[Mostra la guida per il comando]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Stampa il payload grezzo bugs.json invece dei risultati formattati]' \
    '--timeout[Minuti massimi di attesa per il completamento della revisione (predefinito: 45)]:minutes:' \
    '(--no-post)--post[Pubblica i risultati della revisione completata sulla PR a tuo nome (solo destinazioni PR; un semplice commento, non una review)]' \
    '(--post)--no-post[Non pubblica i risultati sulla PR (predefinito)]' \
    '(-h --help)'{-h,--help}'[Mostra la guida per il comando]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Riavvia tutte le sessioni in background in esecuzione]' \
    '(-h --help)'{-h,--help}'[Mostra la guida per il comando]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Scarta anche i commit non inviati e le modifiche non committate del worktree (passa il commit@worktree-id riportato da un precedente claude rm)]:commit@worktree-id:' \
    '--force-remove-worktree[Elimina la directory del worktree anche se l'\''hook WorktreeRemove o git non sono riusciti a rimuoverla (passa il worktree-id riportato da un precedente claude rm)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Mostra la guida per il comando]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Mostra cosa verrebbe importato senza scrivere nulla]' \
    '--yes[Salta la selezione interattiva (in ambienti headless, passa --yes=<digest> dall'\''anteprima di /import)]' \
    '(-h --help)'{-h,--help}'[Mostra la guida per il comando]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
