#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Konfiguriranje i upravljanje MCP poslužiteljima'
    'plugin:Upravljanje dodacima Claude Code'
    'agents:Upravljanje pozadinskim agentima'
    'attach:Otvori pozadinsku sesiju u ovom terminalu'
    'logs:Ispiši nedavni izlaz terminala pozadinske sesije'
    'stop:Zaustavi pozadinsku sesiju (njezin razgovor se zadržava)'
    'respawn:Ponovno pokreni pozadinsku sesiju kako bi koristila trenutnu verziju Claude Code'
    'rm:Izbriši pozadinsku sesiju, a i njezino radno stablo kada je to sigurno'
    'remote-control:Upravljaj lokalnim sesijama s claude.ai/code ili iz mobilne aplikacije Claude'
    'daemon:Upravljanje nadzornikom pozadinskih sesija'
    'auth:Upravljanje autentifikacijom'
    'auto-mode:Pregledaj ili resetiraj konfiguraciju klasifikatora automatskog načina'
    'gateway:Pokreni enterprise pristupnik za autentifikaciju/telemetriju'
    'self-hosted-runner:Ugošćuj sesije Claude Code u oblaku na ovom računalu ili spremniku'
    'import:Uvezi konfiguraciju iz drugog AI agenta za programiranje u Claude Code'
    'project:Upravljanje stanjem projekta Claude Code'
    'purge:Izbriši sve stanje Claude Code za projekt (transkripti, zadaci, povijest datoteka, unos konfiguracije)'
    'ultrareview:Pokreni višeagentski pregled koda u oblaku i ispiši nalaze'
    'setup-token:Postavljanje tokena za dugotrajnu autentifikaciju (zahtijeva Claude pretplatu)'
    'doctor:Provjera zdravlja sustava automatskih ažuriranja Claude Code'
    'update:Provjera i instalacija ažuriranja'
    'install:Instalacija izvorne verzije Claude Code'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Uključi način otklanjanja pogrešaka s opcionalnim filtriranjem kategorija (npr. "api,hooks" ili "!statsig,!file")]:filter:'
    '--verbose[Prepiši postavku detaljnog načina iz konfiguracijske datoteke]'
    '(-p --print)'{-p,--print}'[Ispiši odgovor i izlaz (za korištenje s pipe). Napomena: koristite samo u pouzdanim direktorijima]'
    '--output-format[Format izlaza (s --print): "text" (zadano), "json" (jedan rezultat), ili "stream-json" (streamanje u stvarnom vremenu)]:format:(text json stream-json)'
    '--json-schema[JSON shema za validaciju strukturiranog izlaza]:schema:'
    '--include-partial-messages[Uključi djelomične fragmente poruka prilikom njihovog dolaska (s --print i --output-format=stream-json)]'
    '--input-format[Format ulaza (s --print): "text" (zadano) ili "stream-json" (streamani unos u stvarnom vremenu)]:format:(text stream-json)'
    '--dangerously-skip-permissions[Zaobiđi sve provjere dozvola. Preporučeno samo za sandbox okruženja bez pristupa internetu]'
    '--allow-dangerously-skip-permissions[Omogući opciju zaobilaženja provjera dozvola bez omogućavanja po zadanom]'
    '--restricted[Ograničeni način: ukloni alate koji pokreću naredbe ili kod te WebFetch, zanemari user/project/local postavke i ograniči datotečne alate na radne direktorije]'
    '--max-budget-usd[Maksimalni iznos u dolarima za potrošnju na API pozive (samo --print)]:amount:'
    '--max-turns[Ograniči broj agentskih koraka (samo --print)]:turns:'
    '--replay-user-messages[Ponovno pošalji korisničke poruke iz stdin na stdout za potvrdu]'
    '--allowed-tools[Popis dopuštenih imena alata odvojenih zarezom ili razmakom (npr. "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Popis dopuštenih imena alata odvojenih zarezom ili razmakom (format camelCase)]:tools:'
    '--tools[Navedi popis dostupnih alata iz ugrađenog skupa. Samo u načinu print]:tools:'
    '--disallowed-tools[Popis zabranjenih imena alata odvojenih zarezom ili razmakom (npr. "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Popis zabranjenih imena alata odvojenih zarezom ili razmakom (format camelCase)]:tools:'
    '--mcp-config[Učitaj MCP poslužitelje iz JSON datoteke ili niza (odvojeni razmacima)]:configs:'
    '--system-prompt[Sistemski prompt za korištenje u sesiji]:prompt:'
    '--system-prompt-file[Učitaj sistemski prompt iz datoteke]:file:_files'
    '--append-system-prompt[Dodaj sistemski prompt zadanom sistemskom promptu]:prompt:'
    '--append-system-prompt-file[Učitaj sistemski prompt iz datoteke i dodaj ga zadanom sistemskom promptu]:file:_files'
    '(--append-subagent-system-prompt-file)--append-subagent-system-prompt[Dodaj tekst sistemskom promptu svakog podagenta (samo --print)]:prompt:'
    '(--append-subagent-system-prompt)--append-subagent-system-prompt-file[Učitaj tekst iz datoteke i dodaj ga sistemskim promptovima podagenata (samo --print)]:file:_files'
    '--system-prompt-snapshot[Zabilježi sistemski prompt jednom po razgovoru i ponovno ga koristi doslovno pri svakom zahtjevu i nastavku (on, zadano) ili ga generiraj iznova pri svakom zahtjevu (off)]:mode:(on off)'
    '--permission-mode[Način dozvola za korištenje u sesiji]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Tko odgovara na upite za dozvole s --print: "host" (SDK host ili --permission-prompt-tool) ili "none" (sve što bi zatražilo upit se odbija)]:target:(host none)'
    '--permission-prompt-tool[MCP alat za upite za dozvole (samo --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Nastavi zadnji razgovor]'
    '(-r --resume)'{-r,--resume}'[Nastavi razgovor - navedite identifikator sesije ili odaberite interaktivno]:sessionId:_claude_sessions'
    '--fork-session[Stvori novi identifikator sesije umjesto ponovne uporabe izvornog prilikom nastavka (s --resume ili --continue)]'
    '--no-session-persistence[Onemogući trajnost sesija - sesije se neće spremati (samo --print)]'
    '--model[Model za trenutnu sesiju. Navedite nadimak za najnoviji model (npr. '\''sonnet'\'' ili '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agent za trenutnu sesiju. Nadjačava postavku '\''agent'\'']:agent:_claude_agent_names'
    '--betas[Beta zaglavlja za uključivanje u API zahtjeve (samo za korisnike API ključa)]:betas:'
    '--fallback-model[Omogući automatsko prebacivanje na navedeni model kada je zadani model preopterećen (samo --print)]:model:_claude_model_names'
    '--settings[Put do JSON datoteke s postavkama ili JSON niz za učitavanje dodatnih postavki]:file-or-json:_files'
    '--add-dir[Dodatni direktoriji za pružanje pristupa alatima]:directories:_directories'
    '--ide[Automatski se poveži s IDE prilikom pokretanja ako je dostupan točno jedan valjani IDE]'
    '--desktop[Otvori u aplikaciji Claude Desktop umjesto u terminalu (s --continue ili --resume <id> za odabir sesije)]'
    '--strict-mcp-config[Koristi samo MCP poslužitelje iz --mcp-config i zanemari sve druge MCP postavke]'
    '--session-id[Određeni identifikator sesije za korištenje u razgovoru (mora biti valjani UUID)]:uuid:'
    '--agents[JSON objekt koji definira prilagođene agente]:json:'
    '--advisor[Omogući savjetnički alat na strani poslužitelja za ovu sesiju s aliasom modela ili punim ID-om modela]:model:_claude_model_names'
    '--teammate-mode[Način prikaza članova tima agenata]:mode:(in-process auto tmux iterm2)'
    '--setting-sources[Popis izvora postavki odvojenih zarezom za učitavanje (user, project, local)]:sources:'
    '--plugin-dir[Direktorij za učitavanje dodataka samo za ovu sesiju (može se ponavljati)]:paths:_directories'
    '--disable-slash-commands[Onemogući sve slash naredbe]'
    '(--bg --background)'{--bg,--background}'[Pokreni sesiju kao pozadinski agent i odmah se vrati]'
    '(-w --worktree)'{-w,--worktree}'[Stvori novo git radno stablo za ovu sesiju (opcionalno navedite ime)]::name:'
    '--tmux=-[Stvori tmux sesiju za radno stablo (zahtijeva --worktree). Koristi izvorna okna iTerm2 kada su dostupna; --tmux=classic za tradicionalni tmux]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Postavi prikazano ime za ovu sesiju]:name:'
    '--effort[Razina truda za trenutnu sesiju]:level:(low medium high xhigh max)'
    '--autocompact[Veličina prozora za automatsko sažimanje (auto ili 100k-1M tokena)]:size:(auto)'
    '--debug-file[Zapiši dnevnike otklanjanja pogrešaka u određenu datoteku (implicitno omogućuje način otklanjanja pogrešaka)]:path:_files'
    '--from-pr[Nastavi sesiju povezanu s PR-om po broju/URL-u ili otvori interaktivni izbornik]::value:'
    '--teleport[Nastavi teleport sesiju, opcionalno navedite identifikator sesije]::session:'
    '(--remote)--cloud[Stvori sesiju u oblaku s navedenim opisom ili se poveži s postojećom putem identifikatora sesije ili URL-a claude.ai/code]::description-or-session:'
    '(--cloud)--remote[Zastarjeli alias za --cloud]::description-or-session:'
    '--environment[Stvori novu sesiju u oblaku koja se izvodi u navedenom samostalno hostanom okruženju (ccpool_...)]:environment_id:'
    '--ref[Uz --environment: temelji checkout nove sesije na imenovanom refu umjesto na lokalnom HEAD-u]:branch:'
    '(--remote-control --rc)'{--remote-control,--rc}'[Pokreni interaktivnu sesiju s omogućenim daljinskim upravljanjem (opcionalno imenovanu)]::name:'
    '--remote-control-session-name-prefix[Prefiks za automatski generirana imena sesija daljinskog upravljanja]:prefix:'
    '--chrome[Omogući integraciju Claude u Chrome]'
    '--no-chrome[Onemogući integraciju Claude u Chrome]'
    '--plugin-url[Dohvati .zip dodatka s URL-a samo za ovu sesiju (može se ponavljati)]:url:'
    '--file[Datotečni resursi za preuzimanje pri pokretanju (format: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Omogući prijedloge promptova (emitira predviđeni sljedeći prompt u print/SDK načinu)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Proslijedi tekst i blokove razmišljanja podagenta kao poruke (s --print i stream-json)]'
    '--include-hook-events[Uključi sve događaje životnog ciklusa hookova u izlazni tok (s stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Premjesti odjeljke specifične za pojedini stroj u prvu korisničku poruku radi boljeg ponovnog korištenja predmemorije prompta]'
    '--brief[Omogući alat SendUserMessage za komunikaciju agenta s korisnikom]'
    '*--channels[(Istraživački pregled) MCP poslužitelji čije obavijesti kanala treba slušati (plugin\:<name>@<marketplace>)]:entries:'
    '*--dangerously-load-development-channels[Omogući kanale koji nisu na odobrenom popisu dopuštenih, za lokalni razvoj (plugin\:<name>@<marketplace> ili server\:<name>)]:entries:'
    '--init[Pokreni Setup hookove s matcherom init prije sesije (samo --print)]'
    '--init-only[Pokreni Setup i SessionStart hookove, zatim izađi bez pokretanja razgovora]'
    '--maintenance[Pokreni Setup hookove s matcherom maintenance prije sesije (samo --print)]'
    '--safe-mode[Pokreni sa svim onemogućenim prilagodbama (korisno za rješavanje problema neispravne konfiguracije)]'
    '--bare[Minimalni način: preskoči hookove, LSP, sinkronizaciju dodataka, atribuciju, automatsko pamćenje i automatsko otkrivanje CLAUDE.md]'
    '--ax-screen-reader[Prikaži izlaz prilagođen čitačima zaslona (ravni tekst, bez dekorativnih obruba ili animacija)]'
    '(-v --version)'{-v,--version}'[Ispiši broj verzije]'
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
  )

  # Stop at the first non-option word, so that the options after a command reach
  # that command's own specs instead of being consumed here
  _arguments -C -A '-*' \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'naredbe claude' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin|plugins)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        remote-control|rc|remote|sync|bridge)
          _claude_remote_control
          ;;
        daemon)
          _claude_daemon
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        self-hosted-runner)
          _claude_self_hosted_runner
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        purge)
          _claude_purge
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update|upgrade)
          _arguments \
            '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
          ;;
        *)
          # Not a command but the prompt: options may still follow it
          _arguments \
            $main_options \
            '*: :'
          ;;
      esac
      ;;
  esac
  local ret=$?

  # The last step, such as listing commands for --r, can fail although options
  # were added before it. Report success then: on failure zsh moves on to the
  # next completers, and _correct or _approximate pile on corrections
  (( compstate[nmatches] > 0 )) || return $ret
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Pokreni MCP poslužitelj Claude Code'
    'add:Dodaj MCP poslužitelj u Claude Code'
    'remove:Ukloni MCP poslužitelj'
    'list:Prikaži popis konfiguriranih MCP poslužitelja'
    'get:Dohvati detalje MCP poslužitelja'
    'add-json:Dodaj MCP poslužitelj (stdio ili SSE) s JSON nizom'
    'add-from-claude-desktop:Uvezi MCP poslužitelje iz Claude Desktop (samo Mac i WSL)'
    'reset-project-choices:Resetiraj sve odobrene/odbijene poslužitelje s opsegom projekta (.mcp.json) u ovom projektu'
    'login:Autentificiraj se s MCP poslužiteljem (HTTP, SSE ili claude.ai konektor)'
    'logout:Obriši pohranjene OAuth vjerodajnice za MCP poslužitelj'
    'help:Prikaži pomoć'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'naredbe mcp' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Uključi način otklanjanja pogrešaka]' \
            '--verbose[Prepiši postavku detaljnog načina iz konfiguracijske datoteke]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Opseg konfiguracije (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Vrsta prijenosa (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Postavi varijablu okoline (npr. -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Postavi WebSocket zaglavlje]:header:' \
            '--client-id[OAuth ID klijenta za HTTP/SSE poslužitelje]:clientId:' \
            '--client-secret[Zatraži unos OAuth tajne klijenta (ili postavite varijablu okoline MCP_CLIENT_SECRET)]' \
            '--callback-port[Fiksni port za OAuth povratni poziv (za poslužitelje koji zahtijevaju unaprijed registrirane URI-je za preusmjeravanje)]:port:' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Opseg konfiguracije (local, user, project) - ukloni iz postojećeg opsega ako nije navedeno]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Opseg konfiguracije (local, user, project)]:scope:(local user project)' \
            '--client-secret[Zatraži unos OAuth tajne klijenta (ili postavite varijablu okoline MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Opseg konfiguracije (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]'
          ;;
        login)
          _arguments \
            '--no-browser[Ispiši URL za autorizaciju umjesto otvaranja preglednika (za SSH/headless sesije)]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Validiraj dodatak ili manifest tržišta'
    'marketplace:Upravljanje tržištima Claude Code'
    'list:Prikaži popis instaliranih dodataka'
    'details:Prikaži inventar komponenti i procijenjeni trošak tokena za dodatak'
    'configure:Prikaži opcije dodatka i koje od njih nisu postavljene ili spremi vrijednosti iz stdin'
    'install:Instaliraj dodatak iz dostupnih tržišta'
    'i:Instaliraj dodatak iz dostupnih tržišta (kratica za install)'
    'init:Izradi kostur novog dodatka (automatski se učitava u sljedećoj sesiji)'
    'new:Izradi kostur novog dodatka (nadimak za init)'
    'uninstall:Deinstaliraj instalirani dodatak'
    'remove:Deinstaliraj instalirani dodatak (nadimak za uninstall)'
    'enable:Omogući onemogućeni dodatak'
    'disable:Onemogući omogućeni dodatak'
    'update:Ažuriraj dodatak na najnoviju verziju'
    'eval:Pokreni eval slučajeve nad dodatkom i prijavi ocijenjene rezultate'
    'prune:Ukloni automatski instalirane ovisnosti koje više nisu potrebne'
    'autoremove:Ukloni automatski instalirane ovisnosti koje više nisu potrebne (nadimak za prune)'
    'tag:Stvori git oznaku {name}--v{version} za izdanje dodatka'
    'test:Pokreni testove moda'
    'help:Prikaži pomoć'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'naredbe plugin' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Tretiraj upozorenja kao pogreške (izlazni kod 1)]' \
            '--profile[Izađi s exit 1 i kada bi navedeni katalog odbio prijavu dodatka na provjeri koju ova naredba izvodi]:name:(directory)' \
            '--json[Ispiši izvješće o validaciji kao JSON (isti izlazni kodovi)]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Opseg instalacije]:scope:(user project local)' \
            '--accept-command[Prihvati naredbu koju je deklariralo tržište, a čiji je sha256 prethodno pokretanje s --json prijavilo kao shownCommand.sha256]:sha256:' \
            '*--config[Postavi opciju userConfig deklariranu u manifestu dodatka (može se ponavljati)]:key=value:' \
            '--marketplace[Instaliraj dodatak po samom imenu s tržišta na ovom izvoru (owner/repo, git ili https URL, ili putanja) i po potrebi ga najprije dodaj]:source:' \
            '--registry[Za instalaciju package@npm: razriješi i preuzmi iz ovog npm registra]:url:' \
            '(-y --yes)'{-y,--yes}'[Prihvati prikazanu naredbu deklariranu u tržištu bez upita za potvrdu]' \
            '--json[Ispiši jedan strojno čitljiv redak rezultata umjesto poruke za ljude]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Opseg instalacije]:scope:(user project local)' \
            '--keep-data[Zadrži direktorij trajnih podataka dodatka]' \
            '--prune[Ukloni i automatski instalirane ovisnosti koje više nisu potrebne]' \
            '(-y --yes)'{-y,--yes}'[Preskoči upit za potvrdu --prune]' \
            '--json[Ispiši jedan strojno čitljiv redak rezultata umjesto poruke za ljude (ne s --prune)]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Opseg instalacije]:scope:(user project local)' \
            '--json[Ispiši jedan strojno čitljiv redak rezultata umjesto poruke za ljude]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Onemogući sve omogućene dodatke]' \
            '(-s --scope)'{-s,--scope}'[Opseg instalacije]:scope:(user project local)' \
            '--json[Ispiši jedan strojno čitljiv redak rezultata umjesto poruke za ljude]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '--accept-command[Prihvati naredbu koju je deklariralo tržište, a čiji je sha256 prethodno pokretanje s --json prijavilo kao shownCommand.sha256]:sha256:' \
            '(-s --scope)'{-s,--scope}'[Opseg instalacije]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Prihvati prikazanu naredbu deklariranu u tržištu bez upita za potvrdu]' \
            '--json[Ispiši jedan strojno čitljiv redak rezultata umjesto poruke za ljude]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Ispiši kao JSON]' \
            '--available[Uključi dostupne dodatke iz tržišta (zahtijeva --json)]' \
            '--data-size[Izmjeri direktorij spremljenih podataka svakog instaliranog dodatka ili samo navedenog dodatka (zahtijeva --json)]::plugin:_claude_installed_plugins' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Očisti u opsegu]:scope:(user project local)' \
            '--dry-run[Prikaži popis onoga što bi bilo uklonjeno bez uklanjanja]' \
            '(-y --yes)'{-y,--yes}'[Preskoči upit za potvrdu]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]'
          ;;
        configure)
          _arguments \
            '--json[Ispiši kao JSON]' \
            '--values-stdin[Učitaj vrijednosti opcija iz stdin kao JSON objekt jednorednih nizova; izostavljene opcije zadržavaju svoje vrijednosti]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Opis manifesta]:text:' \
            '--author[Ime autora (zadano: git config user.name)]:name:' \
            '--author-email[E-pošta autora (zadano: git config user.email)]:email:' \
            '--with[Komponente za koje se također izrađuje kostur]:components:' \
            '(-f --force)'{-f,--force}'[Prepiši postojeći .claude-plugin/ na odredištu]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:name:'
          ;;
        eval)
          if [[ $words[2] == init ]]; then
            _arguments \
              '--bare[Zapiši prazan predložak umjesto provođenja intervjua]' \
              '--eval-dir[Direktorij ispod trenutnog direktorija u koji se zapisuju slučajevi]:dir:_directories' \
              '(-i --interactive)'{-i,--interactive}'[Provedi intervju za izradu (zahtijeva interaktivni terminal)]' \
              '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
              '::name:'
            return
          fi
          _arguments \
            '--case[Filtriraj slučajeve po glob uzorku imena]:glob:' \
            '*--tag[Filtriraj slučajeve po oznaci (može se ponavljati)]:tag:' \
            '--runs[Nadjačaj broj pokretanja po slučaju (zadano: case.runs, inače 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Izvodi do n pokretanja agenta istovremeno (1-8; zadano 1)]:n:' \
            '--model[Nadjačaj model za sve slučajeve]:model:_claude_model_names' \
            '--judge-model[Nadjačaj model LLM ocjenjivača (zadano: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Čvrsta gornja granica troška; ako se dosegne, prekini i prijavi djelomične rezultate (izlazni kod 2)]:usd:' \
            '--output-dir[Direktorij za aggregate-result.json]:dir:_directories' \
            '--eval-dir[Ime direktorija (unutar dodatka) koji sadrži eval slučajeve]:dir:' \
            '--json[Ispiši potpuni rezultat pokretanja kao JSON na stdout ili ga zapiši u ovu .json datoteku]::path:_files' \
            '--threshold[Izađi s izlaznim kodom 1 ako je ocjena bilo kojeg slučaja ispod ovog praga (zadano: 1.0)]:threshold:' \
            '*--allow-tools[Dopuštenje operatera za ograničene alate (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '*--disallow-tools[Ugrađeni alati koji se Claudeu uskraćuju u svakom slučaju, čak i ako su dopušteni]:tools:' \
            '(--no-scaffold)--scaffold[Pokreni scaffold_script svakog slučaja (izvodi bash koji je dao autor u vaše ime; isključeno po zadanom)]' \
            '(--scaffold)--no-scaffold[Izričito preskoči scaffold_script]' \
            '--trust-plugin[Potvrdite da vjerujete ovom dodatku i njegovom skupu evala, preskačući upit o povjerenju pri prvom pokretanju (za CI)]' \
            '--ablation[Pokreni kontrolnu skupinu bez dodatka i prijavi razliku u ocjeni]:mode:(none with-without)' \
            '--mocks[Lažne zamjene (mockovi) za MCP poslužitelje, iz <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Uz --mocks record: pokreni i stvarne procese MCP poslužitelja koji nemaju mock]' \
            '--keep-temp[Zadrži direktorije kostura za otklanjanje pogrešaka]' \
            '--verbose[Zapiši događaje praćenja za svaku poruku u dnevnik otklanjanja pogrešaka]' \
            '--report[Zapiši samostalno HTML izvješće na ovu putanju umjesto u direktorij rezultata]:path:_files' \
            '(--no-publish)--publish-report[Zahtijevaj i objavljivanje izvješća na claude.ai]' \
            '(--publish-report)--no-publish[Zadrži HTML izvješće samo lokalno; preskoči objavljivanje na claude.ai]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '::target: _alternative "commands\:eval command\:(init)" "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Pošalji oznaku na --remote nakon što je stvorena]' \
            '--dry-run[Ispiši što bi bilo označeno bez stvaranja oznake]' \
            '(-f --force)'{-f,--force}'[Preskoči provjere nečistog radnog stabla i već postojeće oznake]' \
            '(-m --message)'{-m,--message}'[Poruka anotacije oznake (koristite %s za verziju)]:msg:' \
            '--remote[Udaljeni repozitorij na koji se šalje s --push]:name:' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Dodaj tržište iz URL, putanje ili GitHub repozitorija'
    'list:Prikaži popis konfiguriranih tržišta'
    'remove:Ukloni konfigurirano tržište'
    'rm:Ukloni konfigurirano tržište (nadimak za remove)'
    'update:Ažuriraj tržište iz izvora - ažuriraj sve ako ime nije navedeno'
    'help:Prikaži pomoć'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'naredbe marketplace' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Ograniči checkout na određene direktorije putem git sparse-checkout (za monorepozitorije)]:paths:' \
            '--scope[Gdje deklarirati tržište]:scope:(user project local)' \
            '--json[Ispiši jedan strojno čitljiv redak rezultata kao posljednji redak na stdout]' \
            '--claudeai[Dodaj tržište s ovim imenom koje claude.ai hostira za vas]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Ispiši kao JSON]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Ukloni deklaraciju tržišta iz određenog opsega postavki (izostavite za uklanjanje iz svih opsega)]:scope:(user project local)' \
            '--json[Ispiši jedan strojno čitljiv redak rezultata kao posljednji redak na stdout]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '--json[S imenom tržišta: ispiši jedan strojno čitljiv redak rezultata kao posljednji redak na stdout]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Prisilna instalacija čak i ako je već instalirano]' \
    '(-h --help)'{-h,--help}'[Prikaži pomoć]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Dodatni direktorij za pružanje pristupa alatima u dispečiranim sesijama]:directory:_directories' \
    '--agent[Zadani agent za sesije dispečirane iz prikaza agenata]:agent:_claude_agent_names' \
    '--all[Uz --json: uključi i dovršene pozadinske sesije]' \
    '--allow-dangerously-skip-permissions[Učini način zaobilaženja dozvola dostupnim dispečiranim sesijama]' \
    '--cwd[Prikaži samo pozadinske sesije pokrenute pod putanjom]:path:_directories' \
    '--dangerously-skip-permissions[Nadimak za --permission-mode bypassPermissions]' \
    '--effort[Zadana razina truda za dispečirane sesije]:level:(low medium high xhigh max)' \
    '--json[Ispiši aktivne sesije kao JSON polje i izađi]' \
    '*--mcp-config[Konfiguracija MCP poslužitelja za primjenu na dispečirane sesije]:config:' \
    '--model[Zadani model za sesije dispečirane iz prikaza agenata]:model:_claude_model_names' \
    '--permission-mode[Zadani način dozvola za dispečirane sesije]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Učitaj dodatke iz direktorija za prikaz agenata i dispečirane sesije]:path:_directories' \
    '--setting-sources[Popis izvora postavki odvojenih zarezom za učitavanje (user, project, local)]:sources:' \
    '--settings[Datoteka postavki ili JSON niz za primjenu]:file-or-json:_files' \
    '--strict-mcp-config[Koristi samo MCP poslužitelje iz --mcp-config u dispečiranim sesijama]' \
    '--restricted[Pokreni dispečirane sesije u ograničenom načinu]' \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Prijavi se u svoj Anthropic račun'
    'logout:Odjavi se iz svog Anthropic računa'
    'status:Prikaži status autentifikacije'
    'help:Prikaži pomoć'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'naredbe auth' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Unaprijed ispuni adresu e-pošte na stranici za prijavu]:email:' \
            '--sso[Prisili SSO tijek prijave]' \
            '(--claudeai)--console[Koristi Anthropic Console (naplata prema korištenju API-ja) umjesto Claude pretplate]' \
            '(--console)--claudeai[Koristi Claude pretplatu (zadano)]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
          ;;
        status)
          _arguments \
            '(--text)--json[Ispiši kao JSON (zadano)]' \
            '(--json)--text[Ispiši kao tekst čitljiv ljudima]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Ispiši efektivnu konfiguraciju automatskog načina kao JSON'
    'critique:Dobij AI povratnu informaciju o svojim prilagođenim pravilima automatskog načina'
    'defaults:Ispiši zadana pravila automatskog načina kao JSON'
    'reset:Resetiraj konfiguraciju automatskog načina na isporučene zadane vrijednosti'
    'help:Prikaži pomoć'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'naredbe auto-mode' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Nadjačaj model koji se koristi]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
          ;;
        defaults)
          _arguments \
            '--label[Prikaži samo pravila čija oznaka počinje ovim prefiksom (neovisno o veličini slova)]:prefix:' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Preskoči upit za potvrdu]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Put do YAML konfiguracije pristupnika]:path:_files' \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Izbriši sve stanje Claude Code za projekt (transkripti, zadaci, povijest datoteka, unos konfiguracije)'
    'help:Prikaži pomoć'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'naredbe project' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Prikaži popis onoga što bi bilo izbrisano bez brisanja ičega]' \
            '(-y --yes)'{-y,--yes}'[Preskoči upit za potvrdu]' \
            '(-i --interactive)'{-i,--interactive}'[Zatraži potvrdu za svaku stavku prije brisanja]' \
            '(1)--all[Izbriši stanje za svaki projekt (međusobno isključivo s putanjom)]' \
            '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_purge() {
  _arguments \
    '--dry-run[Prikaži popis onoga što bi bilo izbrisano bez brisanja ičega]' \
    '(-y --yes)'{-y,--yes}'[Preskoči upit za potvrdu]' \
    '(-i --interactive)'{-i,--interactive}'[Zatraži potvrdu za svaku stavku prije brisanja]' \
    '(1)--all[Izbriši stanje za svaki projekt (međusobno isključivo s putanjom)]' \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
    '(--all)::path:_directories'
}

_claude_ultrareview() {
  _arguments \
    '--json[Ispiši sirovi bugs.json sadržaj umjesto formatiranih nalaza]' \
    '--timeout[Maksimalan broj minuta za čekanje na dovršetak pregleda (zadano: 45)]:minutes:' \
    '(--no-post)--post[Objavi nalaze dovršenog pregleda na PR u vaše ime (samo za PR ciljeve; jedan običan komentar, ne pregled)]' \
    '(--post)--no-post[Ne objavljuj nalaze na PR (zadano)]' \
    '--trust-workspace[Vjeruj trenutnoj mapi samo za ovo pokretanje, bez pitanja (za skripte i CI)]' \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Ponovno pokreni svaku aktivnu pozadinsku sesiju]' \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Odbaci i neposlane commitove i necommitane promjene radnog stabla (proslijedite commit@worktree-id koji je prijavio prethodni claude rm)]:commit@worktree-id:' \
    '--force-remove-worktree[Izbriši direktorij radnog stabla iako ga hook WorktreeRemove ili git nisu mogli ukloniti (proslijedite worktree-id koji je prijavio prethodni claude rm)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
    '1:session:_claude_background_sessions'
}

_claude_self_hosted_runner() {
  _arguments \
    '--api-url[Osnovni URL API-ja (zadano: https://api.anthropic.com)]:url:' \
    '--environment-secret-file[Putanja do datoteke s tajnama okruženja]:path:_files' \
    '--lock-to-account[Zaključaj runner na jedan račun prilikom registracije]:id:' \
    '--client-label[Oznaka za praćenje poslana prilikom registracije (zadano: hostname)]:label:' \
    '(--proxy-authorization-file --agent-proxy-url)--proxy-authorization-command[Naredba čiji je stdout zaglavlje Proxy-Authorization za izlazne proxyje]:shell command:' \
    '(--proxy-authorization-command --agent-proxy-url)--proxy-authorization-file[Datoteka sa zaglavljem Proxy-Authorization za izlazne proxyje]:path:_files' \
    '(--proxy-authorization-command --proxy-authorization-file)--agent-proxy-url[Usmjeri svaku sesiju kroz proxy agenta na ovom URL-u (samo https)]:url:' \
    '--capacity[Najveći broj istodobnih sesija (zadano: 1)]:n:' \
    '--base-dir[Osnovni direktorij za checkoute repozitorija (zadano: /workspace)]:path:_directories' \
    '--exec-path[Binarna datoteka koja se pokreće za podređene sesije (zadano: ova binarna datoteka)]:path:_files' \
    '--hooks-dir[Direktorij skripti hookova životnog ciklusa (checkout, command, post-session)]:path:_directories' \
    '--session-stop-grace-sec[Koliko dugo čekati na čist izlazak nakon završetka sesije (zadano: 5)]:n:' \
    '--post-session-hook-timeout-sec[SIGTERM proračun za hook post-session (zadano: 60)]:n:' \
    '--checkout-hook-timeout-min[Proračun stvarnog vremena za svako pokretanje hooka checkout (zadano: 30; 0 onemogućuje)]:n:' \
    '--drain-wait-sec[Na SIGTERM/SIGINT čekaj do N sekundi na posao u tijeku (zadano: 0)]:n:' \
    '--drain-marker-file[Datoteka oznake kojom host najavljuje uredno pražnjenje]:path:_files' \
    '*--git-ssh-rewrite[Prepiši izvorne URL-ove https://<host>/... u git@<host>:... (može se ponavljati)]:host:' \
    '*--git-host-rewrite[Prepiši izvorne URL-ove https://<f>/... u https://<t>/... (može se ponavljati)]:from=to:' \
    '--use-anthropic-git-proxy[Koristi git kojim upravlja Anthropic. UPOZORENJE: briše i zamjenjuje git konfiguraciju na razini HOME, koristi samo pod namjenskim računom]' \
    '--configure-git[Postavi globalni git identitet i omogući potpisivanje commitova putem Anthropic usluge potpisivanja. Zapisuje ~/.gitconfig]' \
    '--push-outcome-on-release[Pošalji praćene grane ishoda kada runner završi sesiju koja nije dovršena]' \
    '--trust-workspace[Unaprijed postavi trajno povjerenje za putanje repozitorija svake sesije (zadano: true)]::bool:(true false)' \
    '--remove-session-state[Ukloni stanje pojedine sesije kada sesija završi (zadano: false)]::bool:(true false)' \
    '--diff-finds-nested-repository[Prikaži repozitorij kloniran u podmapu u oknu Changes; zahtijeva --capacity 1 (zadano: false)]::bool:(true false)' \
    '--confine-repo-settings[Način zaštite koja ograničava postavke commitane u repozitorij (zadano: warn)]:mode:(warn enforce off)' \
    '--server-auto-mode-lists[Koje popise klasifikatora automatskog načina sa poslužitelja sesija smije primiti (zadano: no-allow)]:mode:(all no-allow none)' \
    '--host-config-snapshot[Gdje se drži snimka konfiguracije hosta pri pokretanju (zadano: disk)]:mode:(disk memory)' \
    '--health-port[Port za HTTP slušatelj /healthz (zadano: 8080; 0 onemogućuje)]:port:' \
    '--log-level[Razina zapisivanja (zadano: info)]:level:(info debug)' \
    '--log-file[Zapisuj dnevnike runnera i u datoteku u načinu dodavanja]:path:_files' \
    '--exit-if-unused-min[Zatvori runner ako mu N minuta nije dodijeljen nikakav posao]:n:' \
    '--drain-grace-sec[Sekunde nastavka provjeravanja posla nakon završetka aktivnih sesija (zadano: 0)]:n:' \
    '--retire-at[Umirovi runner u ovo apsolutno Unix vrijeme, u sekundama]:epoch-seconds:' \
    '--defer-shutdown-max-min[Na prvi SIGTERM/SIGINT prestani primati posao i dovrši gašenje M minuta kasnije (zadano: 0)]:m:' \
    '--release-idle-session-min[Oslobodi mjesto sesije nakon N minuta bez korisničkog unosa]:n:' \
    '--startup-timeout-min[Oslobodi mjesto sesije ako podređeni proces nije završio pokretanje nakon N minuta (zadano: 15; 0 onemogućuje)]:n:' \
    '--kill-session-after-min[Ograniči stvarno trajanje podređenog procesa sesije na N minuta]:n:' \
    '--debug-token-dir[SAMO ZA OTKLANJANJE POGREŠAKA: zapisuje aktivne tokene na disk. Ne koristiti u produkciji]:path:_directories' \
    '(-h --help)'{-h,--help}'[Prikaži ovu poruku pomoći]'
}

_claude_remote_control() {
  _arguments \
    '--name[Naziv sesije (prikazuje se u claude.ai/code)]:name:' \
    '--remote-control-session-name-prefix[Prefiks za automatski generirane nazive sesija (zadano: hostname)]:prefix:' \
    '(-c --continue --session-id)'{-c,--continue}'[Ponovno se poveži sa sesijom zadnjom zabilježenom za ovaj direktorij ili jedno od njegovih git radnih stabala]' \
    '(-c --continue --session-id)--session-id[Ponovno se poveži s određenom sesijom prema ID-u]:id:' \
    '--permission-mode[Način dozvola za pokrenute sesije]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)' \
    '(--no-chrome)--chrome[Omogući Claude in Chrome za pokrenute sesije]' \
    '(--chrome)--no-chrome[Onemogući Claude in Chrome za pokrenute sesije]' \
    '(-d --debug)'{-d,--debug}'[Uključi način otklanjanja pogrešaka s opcionalnim filtriranjem kategorija]::filter:' \
    '--debug-file[Zapiši dnevnike otklanjanja pogrešaka u datoteku]:path:_files' \
    '(-v --verbose)'{-v,--verbose}'[Omogući detaljan ispis]' \
    '--spawn[Način pokretanja (zadano: same-dir)]:mode:(same-dir worktree session)' \
    '--capacity[Najveći broj istodobnih sesija u načinu worktree ili same-dir (zadano: 32)]:n:' \
    '(--no-create-session-in-dir)--create-session-in-dir[Unaprijed stvori sesiju u trenutnom direktoriju (zadano)]' \
    '(--create-session-in-dir)--no-create-session-in-dir[Nemoj unaprijed stvoriti sesiju u trenutnom direktoriju]' \
    '(-h --help)'{-h,--help}'[Prikaži ovu pomoć]'
}

_claude_daemon() {
  local -a daemon_commands common_options
  daemon_commands=(
    'run:Pokreni nadzornika u prednjem planu'
    'status:Prikaži pid, verziju i vrijeme rada daemona'
    'logs:Prati dnevnik daemona (Ctrl-C za zaustavljanje)'
    'uninstall:Ukloni pozadinsku uslugu (launchctl/systemd)'
    'stop:Ugasi nadzornika i prekini pozadinske sesije'
  )
  common_options=(
    '--json-path[Konfiguracijska datoteka (zadano: ~/.claude/daemon.json)]:path:_files'
    '--log-file[Datoteka dnevnika (zadano: ~/.claude/daemon.log)]:path:_files'
    '(-h --help)'{-h,--help}'[Prikaži ovu pomoć]'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    $common_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'naredbe daemon' daemon_commands
      ;;
    args)
      case $words[1] in
        run)
          _arguments \
            $common_options \
            '::json-path:_files'
          ;;
        stop)
          _arguments \
            $common_options \
            '--any[Zaustavi i privremeni daemon (koji nije usluga)]' \
            '--keep-workers[Ostavi odvojene sesije pokrenutima]'
          ;;
        status|logs|uninstall)
          _arguments \
            $common_options
          ;;
      esac
      ;;
  esac
}

_claude_import() {
  _arguments \
    '--dry-run[Prikaži što bi bilo uvezeno bez zapisivanja ičega]' \
    '--yes[Preskoči interaktivni izbornik (na headless sučeljima proslijedite --yes=<digest> iz pregleda /import)]' \
    '(-h --help)'{-h,--help}'[Prikaži pomoć za naredbu]' \
    '::source:(codex gemini cursor)'
}

# compinit autoloads this file, and that first call only defines the functions
# above: complete right away so the first TAB already works. Sourced directly,
# there is nothing to complete yet, only the registration.
if [[ $funcstack[1] == _claude ]]; then
  _claude "$@"
else
  (( $+_comps[claude] )) || compdef _claude claude
fi
