#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Stel MCP-bedieners op en bestuur hulle'
    'plugin:Bestuur Claude Code-inproppe'
    'agents:Bestuur agtergrondagente'
    'attach:Open '\''n agtergrondsessie in hierdie terminaal'
    'logs:Druk die onlangse terminaalafvoer van '\''n agtergrondsessie'
    'stop:Stop '\''n agtergrondsessie (die gesprek daarvan word behou)'
    'respawn:Herbegin '\''n agtergrondsessie sodat dit die huidige Claude Code-weergawe laat loop'
    'rm:Skrap '\''n agtergrondsessie, en die werkboom daarvan wanneer dit veilig is'
    'remote-control:Beheer plaaslike sessies vanaf claude.ai/code of die Claude-selfoontoep'
    'daemon:Bestuur die toesighouer vir agtergrondsessies'
    'auth:Bestuur verifikasie'
    'auto-mode:Inspekteer of herstel die outomatiese-modus-klassifiseerder se konfigurasie'
    'gateway:Laat die onderneming se verifikasie-/telemetrie-poort loop'
    'self-hosted-runner:Huisves Claude Code-wolksessies op hierdie masjien of houer'
    'import:Voer konfigurasie van '\''n ander KI-koderingsagent in Claude Code in'
    'project:Bestuur Claude Code-projektoestand'
    'purge:Vee alle Claude Code-toestand vir '\''n projek uit (transkripsies, take, lêergeskiedenis, konfigurasie-inskrywing)'
    'ultrareview:Laat '\''n wolk-gehuisveste multi-agent-kodehersiening loop en druk die bevindinge'
    'setup-token:Stel '\''n langtermyn-verifikasietoken op (vereis '\''n Claude-intekening)'
    'doctor:Gesondheidskontrole vir Claude Code se outo-bywerker'
    'update:Kontroleer vir en installeer opdaterings'
    'install:Installeer die inheemse Claude Code-bou'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Aktiveer ontfoutmodus met opsionele kategoriefiltrering (bv. "api,hooks" of "!statsig,!file")]:filter:'
    '--verbose[Oorheers die uitvoerige-modus-instelling van die konfigurasielêer]'
    '(-p --print)'{-p,--print}'[Druk die antwoord en sluit af (vir gebruik met pype). Let wel: gebruik slegs in vertroude gidse]'
    '--output-format[Afvoerformaat (met --print): "text" (verstek), "json" (enkele resultaat), of "stream-json" (intydse stroom)]:format:(text json stream-json)'
    '--json-schema[JSON-skema vir gestruktureerde afvoervalidering]:schema:'
    '--include-partial-messages[Sluit gedeeltelike boodskapstukke in soos hulle aankom (met --print en --output-format=stream-json)]'
    '--input-format[Toevoerformaat (met --print): "text" (verstek) of "stream-json" (intydse stroomtoevoer)]:format:(text stream-json)'
    '--dangerously-skip-permissions[Omseil alle toestemmingskontroles. Word slegs aanbeveel vir sandput-omgewings sonder internettoegang]'
    '--allow-dangerously-skip-permissions[Aktiveer die opsie om toestemmingskontroles te omseil sonder om dit by verstek te aktiveer]'
    '--restricted[Beperkte modus: verwyder die gereedskap wat bevele of kode laat loop en WebFetch, ignoreer user/project/local-instellings, en beperk lêergereedskap tot die werkgidse]'
    '--max-budget-usd[Maksimum dollarbedrag om aan API-oproepe te bestee (slegs --print)]:amount:'
    '--max-turns[Beperk die aantal agentiese beurte (slegs --print)]:turns:'
    '--replay-user-messages[Stuur gebruikersboodskappe van stdin weer op stdout vir bevestiging]'
    '--allowed-tools[Komma- of spasiegeskeide lys van toegelate gereedskapname (bv. "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Komma- of spasiegeskeide lys van toegelate gereedskapname (camelCase-formaat)]:tools:'
    '--tools[Spesifiseer die lys van beskikbare gereedskap uit die ingeboude stel. Slegs drukmodus]:tools:'
    '--disallowed-tools[Komma- of spasiegeskeide lys van verbode gereedskapname (bv. "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Komma- of spasiegeskeide lys van verbode gereedskapname (camelCase-formaat)]:tools:'
    '--mcp-config[Laai MCP-bedieners uit '\''n JSON-lêer of -string (spasiegeskei)]:configs:'
    '--system-prompt[Stelselopdrag om vir die sessie te gebruik]:prompt:'
    '--system-prompt-file[Lees die stelselopdrag uit '\''n lêer]:file:_files'
    '--append-system-prompt[Voeg stelselopdrag by die verstek-stelselopdrag]:prompt:'
    '--append-system-prompt-file[Lees die stelselopdrag uit '\''n lêer en voeg dit by die verstek-stelselopdrag]:file:_files'
    '(--append-subagent-system-prompt-file)--append-subagent-system-prompt[Voeg teks by die stelselopdrag van elke subagent (slegs --print)]:prompt:'
    '(--append-subagent-system-prompt)--append-subagent-system-prompt-file[Lees teks uit ’n lêer en voeg dit by subagent-stelselopdragte (slegs --print)]:file:_files'
    '--system-prompt-snapshot[Teken die stelselopdrag een keer per gesprek aan en hergebruik dit woordeliks by elke versoek en hervatting (on, die verstek) of stel dit by elke versoek opnuut saam (off)]:mode:(on off)'
    '--permission-mode[Toestemmingsmodus om vir die sessie te gebruik]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Wie toestemmingsvrae met --print beantwoord: "host" (die SDK-gasheer of --permission-prompt-tool) of "none" (enigiets wat sou vra, word geweier)]:target:(host none)'
    '--permission-prompt-tool[MCP-gereedskap om vir toestemmingsvrae te gebruik (slegs --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Sit die mees onlangse gesprek voort]'
    '(-r --resume)'{-r,--resume}'[Hervat '\''n gesprek - spesifiseer die sessie-ID of kies interaktief]:sessionId:_claude_sessions'
    '--fork-session[Skep '\''n nuwe sessie-ID in plaas daarvan om die oorspronklike sessie-ID te hergebruik wanneer jy hervat (met --resume of --continue)]'
    '--no-session-persistence[Deaktiveer sessievolharding - sessies sal nie gestoor word nie (slegs --print)]'
    '--model[Model vir die huidige sessie. Spesifiseer '\''n alias vir die nuutste model (bv. '\''sonnet'\'' of '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agent vir die huidige sessie. Oorheers die '\''agent'\''-instelling]:agent:_claude_agent_names'
    '--betas[Beta-opskrifte om in API-versoeke in te sluit (slegs API-sleutelgebruikers)]:betas:'
    '--fallback-model[Aktiveer outomatiese terugval na die gespesifiseerde model wanneer die verstekmodel oorlaai is (slegs --print)]:model:_claude_model_names'
    '--settings[Pad na '\''n instellings-JSON-lêer of JSON-string om bykomende instellings te laai]:file-or-json:_files'
    '--add-dir[Bykomende gidse om gereedskaptoegang toe te laat]:directories:_directories'
    '--ide[Koppel outomaties aan die IDE met aanvang as presies een geldige IDE beskikbaar is]'
    '--desktop[Open in die Claude Desktop-toep in plaas van die terminaal (met --continue of --resume <id> om die sessie te kies)]'
    '--strict-mcp-config[Gebruik slegs MCP-bedieners van --mcp-config en ignoreer alle ander MCP-instellings]'
    '--session-id[Spesifieke sessie-ID om vir die gesprek te gebruik (moet '\''n geldige UUID wees)]:uuid:'
    '--agents[JSON-objek wat pasgemaakte agente definieer]:json:'
    '--advisor[Aktiveer die bedienerkant-adviseurgereedskap vir hierdie sessie met ’n modelalias of volledige model-ID]:model:_claude_model_names'
    '--teammate-mode[Hoe spanmaats in ’n agentspan vertoon word]:mode:(in-process auto tmux iterm2)'
    '--setting-sources[Kommageskeide lys van instellingsbronne om te laai (user, project, local)]:sources:'
    '--plugin-dir[Gids om inproppe slegs vir hierdie sessie uit te laai (herhaalbaar)]:paths:_directories'
    '--disable-slash-commands[Deaktiveer alle skuinsstreepbevele]'
    '(--bg --background)'{--bg,--background}'[Begin die sessie as '\''n agtergrondagent en keer onmiddellik terug]'
    '(-w --worktree)'{-w,--worktree}'[Skep '\''n nuwe git-werkboom vir hierdie sessie (spesifiseer opsioneel '\''n naam)]::name:'
    '--tmux=-[Skep '\''n tmux-sessie vir die werkboom (vereis --worktree). Gebruik iTerm2 se inheemse panele indien beskikbaar; --tmux=classic vir tradisionele tmux]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Stel '\''n vertoonnaam vir hierdie sessie]:name:'
    '--effort[Inspanningsvlak vir die huidige sessie]:level:(low medium high xhigh max)'
    '--autocompact[Venstergrootte vir outo-kompaktering (auto, of 100k-1M tokens)]:size:(auto)'
    '--debug-file[Skryf ontfoutlogboeke na '\''n spesifieke lêerpad (aktiveer implisiet die ontfoutmodus)]:path:_files'
    '--from-pr[Hervat '\''n sessie wat aan '\''n PR gekoppel is volgens nommer/URL, of open die interaktiewe kieser]::value:'
    '--teleport[Hervat '\''n teleport-sessie, spesifiseer opsioneel die sessie-ID]::session:'
    '(--remote)--cloud[Skep '\''n wolksessie met die gegewe beskrywing, of koppel aan '\''n bestaande een volgens sessie-ID of claude.ai/code-URL]::description-or-session:'
    '(--cloud)--remote[Verouderde alias vir --cloud]::description-or-session:'
    '--environment[Skep '\''n nuwe wolksessie wat op die gegewe self-gehuisveste omgewing loop (ccpool_...)]:environment_id:'
    '--ref[Met --environment: baseer die uitcheck van die nuwe sessie op ’n benoemde ref in plaas van plaaslike HEAD]:branch:'
    '(--remote-control --rc)'{--remote-control,--rc}'[Begin '\''n interaktiewe sessie met Afstandsbeheer geaktiveer (opsioneel benoem)]::name:'
    '--remote-control-session-name-prefix[Voorvoegsel vir outomaties gegenereerde Afstandsbeheer-sessiename]:prefix:'
    '--chrome[Aktiveer Claude-in-Chrome-integrasie]'
    '--no-chrome[Deaktiveer Claude-in-Chrome-integrasie]'
    '--plugin-url[Haal '\''n inprop-.zip van '\''n URL slegs vir hierdie sessie (herhaalbaar)]:url:'
    '--file[Lêerhulpbronne om met aanvang af te laai (formaat: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Aktiveer opdragvoorstelle (gee '\''n voorspelde volgende opdrag in druk-/SDK-modus af)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Stuur subagent-teks en denkblokke as boodskappe aan (met --print en stream-json)]'
    '--include-hook-events[Sluit alle haak-lewensiklusgebeurtenisse in die afvoerstroom in (met stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Skuif per-masjien-afdelings na die eerste gebruikersboodskap om opdragkas-hergebruik te verbeter]'
    '--brief[Aktiveer die SendUserMessage-gereedskap vir agent-tot-gebruiker-kommunikasie]'
    '*--channels[(Navorsingsvoorskou) MCP-bedieners wie se kanaalkennisgewings gevolg moet word (plugin\:<name>@<marketplace>)]:entries:'
    '*--dangerously-load-development-channels[Aktiveer kanale wat nie op die goedgekeurde toelaatlys is nie, vir plaaslike ontwikkeling (plugin\:<name>@<marketplace> of server\:<name>)]:entries:'
    '--init[Laat Setup-hake met die init-passer voor die sessie loop (slegs --print)]'
    '--init-only[Laat Setup- en SessionStart-hake loop en sluit dan af sonder om ’n gesprek te begin]'
    '--maintenance[Laat Setup-hake met die maintenance-passer voor die sessie loop (slegs --print)]'
    '--safe-mode[Begin met alle aanpassings gedeaktiveer (nuttig om '\''n gebroke konfigurasie op te los)]'
    '--bare[Minimale modus: slaan hake, LSP, inpropsinkronisasie, toeskrywing, outo-geheue en CLAUDE.md-outo-ontdekking oor]'
    '--ax-screen-reader[Lewer skermleser-vriendelike afvoer (plat teks, geen dekoratiewe rande of animasies nie)]'
    '(-v --version)'{-v,--version}'[Voer die weergawenommer uit]'
    '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]'
  )

  # Stop at the first non-option word, so that the options after a command reach
  # that command's own specs instead of being consumed here
  _arguments -C -A '-*' \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude-bevele' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin|plugins)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        remote-control|rc|remote|sync|bridge)
          _claude_remote_control
          ;;
        daemon)
          _claude_daemon
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        self-hosted-runner)
          _claude_self_hosted_runner
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        purge)
          _claude_purge
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update|upgrade)
          _arguments \
            '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]'
          ;;
        *)
          # Not a command but the prompt: options may still follow it
          _arguments \
            $main_options \
            '*: :'
          ;;
      esac
      ;;
  esac
  local ret=$?

  # The last step, such as listing commands for --r, can fail although options
  # were added before it. Report success then: on failure zsh moves on to the
  # next completers, and _correct or _approximate pile on corrections
  (( compstate[nmatches] > 0 )) || return $ret
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Begin '\''n Claude Code MCP-bediener'
    'add:Voeg '\''n MCP-bediener by Claude Code'
    'remove:Verwyder '\''n MCP-bediener'
    'list:Lys opgestelde MCP-bedieners'
    'get:Kry MCP-bedienerbesonderhede'
    'add-json:Voeg '\''n MCP-bediener (stdio of SSE) met '\''n JSON-string by'
    'add-from-claude-desktop:Voer MCP-bedieners uit Claude Desktop in (slegs Mac en WSL)'
    'reset-project-choices:Herstel alle goedgekeurde/verwerpte projek-omvang (.mcp.json) bedieners in hierdie projek'
    'login:Verifieer met '\''n MCP-bediener (HTTP, SSE, of claude.ai-verbinder)'
    'logout:Vee gestoorde OAuth-legitimasie vir '\''n MCP-bediener uit'
    'help:Vertoon hulp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Vertoon hulp]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp-bevele' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Aktiveer ontfoutmodus]' \
            '--verbose[Oorheers die uitvoerige-modus-instelling van die konfigurasielêer]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurasie-omvang (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Vervoertipe (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Stel '\''n omgewingsveranderlike (bv. -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Stel '\''n WebSocket-opskrif]:header:' \
            '--client-id[OAuth-kliënt-ID vir HTTP/SSE-bedieners]:clientId:' \
            '--client-secret[Vra vir die OAuth-kliëntgeheim (of stel die omgewingsveranderlike MCP_CLIENT_SECRET)]' \
            '--callback-port[Vaste poort vir die OAuth-terugroep (vir bedieners wat vooraf geregistreerde herleidings-URI'\''s vereis)]:port:' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurasie-omvang (local, user, project) - verwyder uit bestaande omvang indien nie gespesifiseer nie]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Vertoon hulp]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurasie-omvang (local, user, project)]:scope:(local user project)' \
            '--client-secret[Vra vir die OAuth-kliëntgeheim (of stel die omgewingsveranderlike MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurasie-omvang (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Vertoon hulp]'
          ;;
        login)
          _arguments \
            '--no-browser[Druk die magtigings-URL in plaas daarvan om '\''n blaaier oop te maak (vir SSH-/koplose sessies)]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Valideer '\''n inprop- of markplein-manifes'
    'marketplace:Bestuur Claude Code-markpleine'
    'list:Lys geïnstalleerde inproppe'
    'details:Wys die komponentinventaris en geprojekteerde tokenkoste vir '\''n inprop'
    'configure:Wys '\''n inprop se opsies en watter nie gestel is nie, of stoor waardes vanaf stdin'
    'install:Installeer '\''n inprop uit beskikbare markpleine'
    'i:Installeer '\''n inprop uit beskikbare markpleine (kort vir install)'
    'init:Steier '\''n nuwe inprop (laai outomaties in die volgende sessie)'
    'new:Steier '\''n nuwe inprop (alias vir init)'
    'uninstall:Deïnstalleer '\''n geïnstalleerde inprop'
    'remove:Deïnstalleer '\''n geïnstalleerde inprop (alias vir uninstall)'
    'enable:Aktiveer '\''n gedeaktiveerde inprop'
    'disable:Deaktiveer '\''n geaktiveerde inprop'
    'update:Werk '\''n inprop by na die nuutste weergawe'
    'eval:Laat evalueringsgevalle teen '\''n inprop loop en rapporteer die getelde resultate'
    'prune:Verwyder outo-geïnstalleerde afhanklikhede wat nie meer nodig is nie'
    'autoremove:Verwyder outo-geïnstalleerde afhanklikhede wat nie meer nodig is nie (alias vir prune)'
    'tag:Skep '\''n {name}--v{version} git-etiket vir '\''n inpropvrystelling'
    'test:Laat '\''n mod se toetse loop'
    'help:Vertoon hulp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Vertoon hulp]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'inprop-bevele' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Hanteer waarskuwings as foute (uittreekode 1)]' \
            '--profile[Gee ook uittreekode 1 wanneer die benoemde katalogus ’n indiening van die inprop sou weier op ’n kontrole wat hierdie bevel uitvoer]:name:(directory)' \
            '--json[Voer die valideringsverslag as JSON uit (dieselfde uittreekodes)]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Installasie-omvang]:scope:(user project local)' \
            '--accept-command[Aanvaar die markplein-verklaarde bevel waarvan ’n vorige --json-lopie die sha256 as shownCommand.sha256 gerapporteer het]:sha256:' \
            '*--config[Stel '\''n userConfig-opsie wat in die inprop-manifes verklaar is (herhaalbaar)]:key=value:' \
            '--marketplace[Installeer die inprop volgens sy kaal naam vanaf die markplein by hierdie bron (owner/repo, git- of https-URL, of pad), en voeg dit eers by indien nodig]:source:' \
            '--registry[Vir ’n package@npm-installasie: los op en laai af vanaf hierdie npm-register]:url:' \
            '(-y --yes)'{-y,--yes}'[Aanvaar die vertoonde bevel wat deur die markplein verklaar is sonder die bevestigingsvraag]' \
            '--json[Druk een masjienleesbare resultaatreël in plaas van die mensleesbare boodskap]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Installasie-omvang]:scope:(user project local)' \
            '--keep-data[Behou die inprop se gids vir volhardende data]' \
            '--prune[Verwyder ook outo-geïnstalleerde afhanklikhede wat nie meer nodig is nie]' \
            '(-y --yes)'{-y,--yes}'[Slaan die --prune-bevestigingsvraag oor]' \
            '--json[Druk een masjienleesbare resultaatreël in plaas van die mensleesbare boodskap (nie met --prune nie)]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Installasie-omvang]:scope:(user project local)' \
            '--json[Druk een masjienleesbare resultaatreël in plaas van die mensleesbare boodskap]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Deaktiveer alle geaktiveerde inproppe]' \
            '(-s --scope)'{-s,--scope}'[Installasie-omvang]:scope:(user project local)' \
            '--json[Druk een masjienleesbare resultaatreël in plaas van die mensleesbare boodskap]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '--accept-command[Aanvaar die markplein-verklaarde bevel waarvan ’n vorige --json-lopie die sha256 as shownCommand.sha256 gerapporteer het]:sha256:' \
            '(-s --scope)'{-s,--scope}'[Installasie-omvang]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Aanvaar die vertoonde bevel wat deur die markplein verklaar is sonder die bevestigingsvraag]' \
            '--json[Druk een masjienleesbare resultaatreël in plaas van die mensleesbare boodskap]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Voer uit as JSON]' \
            '--available[Sluit beskikbare inproppe uit markpleine in (vereis --json)]' \
            '--data-size[Meet die gids met gestoorde data van elke geïnstalleerde inprop, of slegs die benoemde inprop (vereis --json)]::plugin:_claude_installed_plugins' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Omvang waarin gesnoei word]:scope:(user project local)' \
            '--dry-run[Lys wat verwyder sou word sonder om te verwyder]' \
            '(-y --yes)'{-y,--yes}'[Slaan die bevestigingsvraag oor]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]'
          ;;
        configure)
          _arguments \
            '--json[Voer uit as JSON]' \
            '--values-stdin[Lees opsiewaardes vanaf stdin as '\''n JSON-objek van enkelreël-stringe; weggelate opsies behou hul waardes]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Manifesbeskrywing]:text:' \
            '--author[Outeursnaam (verstek: git config user.name)]:name:' \
            '--author-email[Outeur-e-posadres (verstek: git config user.email)]:email:' \
            '--with[Komponente om ook te steier]:components:' \
            '(-f --force)'{-f,--force}'[Oorskryf '\''n bestaande .claude-plugin/ by die teiken]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '1:name:'
          ;;
        eval)
          if [[ $words[2] == init ]]; then
            _arguments \
              '--bare[Skryf ’n leë sjabloon in plaas daarvan om die onderhoud te voer]' \
              '--eval-dir[Gids onder die huidige gids om gevalle in te skryf]:dir:_directories' \
              '(-i --interactive)'{-i,--interactive}'[Voer die outeursonderhoud (vereis ’n interaktiewe terminaal)]' \
              '(-h --help)'{-h,--help}'[Vertoon hulp]' \
              '::name:'
            return
          fi
          _arguments \
            '--case[Filtreer gevalle volgens naam-glob]:glob:' \
            '*--tag[Filtreer gevalle volgens etiket (herhaalbaar)]:tag:' \
            '--runs[Oorheers die aantal lopies per geval (verstek: case.runs, anders 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Laat tot n agentlopies gelyktydig loop (1-8; verstek 1)]:n:' \
            '--model[Oorheers die model vir alle gevalle]:model:_claude_model_names' \
            '--judge-model[Oorheers die LLM-beoordelaarmodel (verstek: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Harde kosteplafon; staak en rapporteer gedeeltelike resultate as dit bereik word (uittreekode 2)]:usd:' \
            '--output-dir[Gids vir aggregate-result.json]:dir:_directories' \
            '--eval-dir[Gidsnaam (onder die inprop) wat die evalueringsgevalle bevat]:dir:' \
            '--json[Druk die volledige lopieresultaat as JSON na stdout, of skryf dit na hierdie .json-lêer]::path:_files' \
            '--threshold[Sluit af met uittreekode 1 as enige geval se telling onder hierdie drempel is (verstek: 1.0)]:threshold:' \
            '*--allow-tools[Operateurstoestemming vir beheerde gereedskap (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '*--disallow-tools[Ingeboude gereedskap wat in elke geval van Claude weerhou word, selfs as dit toegestaan is]:tools:' \
            '(--no-scaffold)--scaffold[Laat elke geval se scaffold_script loop (laat deur die outeur verskafte bash onder jou rekening loop; by verstek af)]' \
            '(--scaffold)--no-scaffold[Slaan scaffold_script uitdruklik oor]' \
            '--trust-plugin[Bevestig dat jy hierdie inprop en sy evalueringsreeks vertrou, en slaan die vertrouensvraag by die eerste lopie oor (vir CI)]' \
            '--ablation[Laat '\''n basislyn-vergelykingsgroep sonder inprop loop en rapporteer die tellingverskil]:mode:(none with-without)' \
            '--mocks[Nagemaakte plaasvervangers vir MCP-bedieners, uit <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Met --mocks record: begin ook die regte MCP-bedienerprosesse wat geen nabootsing het nie]' \
            '--keep-temp[Behou steiergidse vir ontfouting]' \
            '--verbose[Teken spoorgebeurtenisse per boodskap in die ontfoutlogboek aan]' \
            '--report[Skryf die selfstandige HTML-verslag na hierdie pad in plaas van die resultategids]:path:_files' \
            '(--no-publish)--publish-report[Vereis ook dat die verslag na claude.ai gepubliseer word]' \
            '(--publish-report)--no-publish[Hou die HTML-verslag slegs plaaslik; slaan publisering na claude.ai oor]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '::target: _alternative "commands\:eval command\:(init)" "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Stoot die etiket na --remote nadat dit geskep is]' \
            '--dry-run[Druk wat geëtiketteer sou word sonder om dit te skep]' \
            '(-f --force)'{-f,--force}'[Slaan die kontroles vir '\''n vuil werkboom en '\''n reeds bestaande etiket oor]' \
            '(-m --message)'{-m,--message}'[Etiket-annotasieboodskap (gebruik %s vir die weergawe)]:msg:' \
            '--remote[Afgeleë bewaarplek om na te stoot met --push]:name:' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Voeg '\''n markplein by vanaf '\''n URL, pad, of GitHub-bewaarplek'
    'list:Lys opgestelde markpleine'
    'remove:Verwyder '\''n opgestelde markplein'
    'rm:Verwyder '\''n opgestelde markplein (alias vir remove)'
    'update:Werk markplein by vanaf bron - werk almal by as geen naam gespesifiseer is nie'
    'help:Vertoon hulp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Vertoon hulp]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'markplein-bevele' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Beperk die checkout tot spesifieke gidse via git sparse-checkout (vir monobewaarplekke)]:paths:' \
            '--scope[Waar om die markplein te verklaar]:scope:(user project local)' \
            '--json[Druk een masjienleesbare resultaatreël as die laaste reël op stdout]' \
            '--claudeai[Voeg die markplein met hierdie naam by wat claude.ai vir jou huisves]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Voer uit as JSON]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Verwyder die markpleinverklaring uit '\''n spesifieke instellingsomvang (laat weg om dit uit elke omvang te verwyder)]:scope:(user project local)' \
            '--json[Druk een masjienleesbare resultaatreël as die laaste reël op stdout]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '--json[Met ’n markpleinnaam: druk een masjienleesbare resultaatreël as die laaste reël op stdout]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Forseer installasie selfs al is dit reeds geïnstalleer]' \
    '(-h --help)'{-h,--help}'[Vertoon hulp]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Bykomende gids om gereedskaptoegang toe te laat in versonde sessies]:directory:_directories' \
    '--agent[Verstekagent vir sessies wat vanaf die agentaansig versend word]:agent:_claude_agent_names' \
    '--all[Met --json: sluit ook voltooide agtergrondsessies in]' \
    '--allow-dangerously-skip-permissions[Maak omseil-toestemmings-modus beskikbaar vir versonde sessies]' \
    '--cwd[Wys slegs agtergrondsessies wat onder die pad begin is]:path:_directories' \
    '--dangerously-skip-permissions[Alias vir --permission-mode bypassPermissions]' \
    '--effort[Verstek-inspanningsvlak vir versonde sessies]:level:(low medium high xhigh max)' \
    '--json[Druk aktiewe sessies as '\''n JSON-skikking en sluit af]' \
    '*--mcp-config[MCP-bedienerkonfigurasie om op versonde sessies toe te pas]:config:' \
    '--model[Verstekmodel vir sessies wat vanaf die agentaansig versend word]:model:_claude_model_names' \
    '--permission-mode[Verstek-toestemmingsmodus vir versonde sessies]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Laai inproppe uit die gids vir die agentaansig en versonde sessies]:path:_directories' \
    '--setting-sources[Kommageskeide lys van instellingsbronne om te laai (user, project, local)]:sources:' \
    '--settings[Instellingslêer of JSON-string om toe te pas]:file-or-json:_files' \
    '--strict-mcp-config[Gebruik slegs MCP-bedieners van --mcp-config in versonde sessies]' \
    '--restricted[Begin versonde sessies in beperkte modus]' \
    '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Meld by jou Anthropic-rekening aan'
    'logout:Meld by jou Anthropic-rekening af'
    'status:Wys verifikasiestatus'
    'help:Vertoon hulp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth-bevele' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Vul die e-posadres vooraf op die aanmeldbladsy in]:email:' \
            '--sso[Forseer die SSO-aanmeldvloei]' \
            '(--claudeai)--console[Gebruik Anthropic Console (API-gebruiksfakturering) in plaas van '\''n Claude-intekening]' \
            '(--console)--claudeai[Gebruik '\''n Claude-intekening (verstek)]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]'
          ;;
        status)
          _arguments \
            '(--text)--json[Voer uit as JSON (verstek)]' \
            '(--json)--text[Voer uit as mensleesbare teks]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Druk die effektiewe outomatiese-modus-konfigurasie as JSON'
    'critique:Kry KI-terugvoer oor jou pasgemaakte outomatiese-modus-reëls'
    'defaults:Druk die verstek-outomatiese-modus-reëls as JSON'
    'reset:Herstel die outomatiese-modus-konfigurasie na die verskeepte verstekwaardes'
    'help:Vertoon hulp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'outo-modus-bevele' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Oorheers watter model gebruik word]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]'
          ;;
        defaults)
          _arguments \
            '--label[Wys slegs reëls waarvan die etiket met hierdie voorvoegsel begin (hoofletter-onsensitief)]:prefix:' \
            '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Slaan die bevestigingsvraag oor]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Pad na die poort se YAML-konfigurasie]:path:_files' \
    '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Vee alle Claude Code-toestand vir '\''n projek uit (transkripsies, take, lêergeskiedenis, konfigurasie-inskrywing)'
    'help:Vertoon hulp'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'projek-bevele' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Lys wat geskrap sou word sonder om enigiets te skrap]' \
            '(-y --yes)'{-y,--yes}'[Slaan die bevestigingsvraag oor]' \
            '(-i --interactive)'{-i,--interactive}'[Vra vir elke item voordat dit geskrap word]' \
            '(1)--all[Vee die toestand vir elke projek uit (wedersyds uitsluitend met '\''n pad)]' \
            '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_purge() {
  _arguments \
    '--dry-run[Lys wat geskrap sou word sonder om enigiets te skrap]' \
    '(-y --yes)'{-y,--yes}'[Slaan die bevestigingsvraag oor]' \
    '(-i --interactive)'{-i,--interactive}'[Vra vir elke item voordat dit geskrap word]' \
    '(1)--all[Vee die toestand vir elke projek uit (wedersyds uitsluitend met '\''n pad)]' \
    '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]' \
    '(--all)::path:_directories'
}

_claude_ultrareview() {
  _arguments \
    '--json[Druk die rou bugs.json-loonvrag in plaas van geformatteerde bevindinge]' \
    '--timeout[Maksimum minute om te wag vir die hersiening om te voltooi (verstek: 45)]:minutes:' \
    '(--no-post)--post[Plaas die voltooide hersieningsbevindinge onder jou naam op die PR (slegs PR-teikens; een gewone opmerking, nie '\''n hersiening nie)]' \
    '(--post)--no-post[Moenie die bevindinge op die PR plaas nie (die verstek)]' \
    '--trust-workspace[Vertrou die huidige gids slegs vir hierdie lopie, sonder om te vra (vir skripte en CI)]' \
    '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Herbegin elke lopende agtergrondsessie]' \
    '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Gooi ook die ongestote commits en ongecommitte veranderinge van die werkboom weg (gee die commit@worktree-id wat '\''n vorige claude rm gerapporteer het)]:commit@worktree-id:' \
    '--force-remove-worktree[Skrap die werkboomgids al kon die WorktreeRemove-haak of git dit nie verwyder nie (gee die worktree-id wat '\''n vorige claude rm gerapporteer het)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]' \
    '1:session:_claude_background_sessions'
}

_claude_self_hosted_runner() {
  _arguments \
    '--api-url[API-basis-URL (verstek: https://api.anthropic.com)]:url:' \
    '--environment-secret-file[Pad na die geheimelêer van die omgewing]:path:_files' \
    '--lock-to-account[Sluit die loper by registrasie aan ’n enkele rekening vas]:id:' \
    '--client-label[Waarneembaarheidsetiket wat by registrasie gestuur word (verstek: hostname)]:label:' \
    '(--proxy-authorization-file --agent-proxy-url)--proxy-authorization-command[Bevel waarvan die stdout die Proxy-Authorization-kopskrif vir uitgaande instaanbedieners is]:shell command:' \
    '(--proxy-authorization-command --agent-proxy-url)--proxy-authorization-file[Lêer wat die Proxy-Authorization-kopskrif vir uitgaande instaanbedieners bevat]:path:_files' \
    '(--proxy-authorization-command --proxy-authorization-file)--agent-proxy-url[Lei elke sessie deur die agent-instaanbediener by hierdie URL (slegs https)]:url:' \
    '--capacity[Maks. gelyktydige sessies (verstek: 1)]:n:' \
    '--base-dir[Basisgids vir repo-uitchecks (verstek: /workspace)]:path:_directories' \
    '--exec-path[Binêre lêer om vir kindsessies te begin (verstek: hierdie binêre lêer)]:path:_files' \
    '--hooks-dir[Gids met lewensiklus-haakskripte (checkout, command, post-session)]:path:_directories' \
    '--session-stop-grace-sec[Hoe lank om na ’n skoon afsluiting te wag nadat ’n sessie eindig (verstek: 5)]:n:' \
    '--post-session-hook-timeout-sec[SIGTERM-tydsbegroting vir die post-session-haak (verstek: 60)]:n:' \
    '--checkout-hook-timeout-min[Muurklok-tydsbegroting vir elke lopie van die checkout-haak (verstek: 30; 0 deaktiveer)]:n:' \
    '--drain-wait-sec[Wag by SIGTERM/SIGINT tot N sekondes vir lopende werk (verstek: 0)]:n:' \
    '--drain-marker-file[Merkerlêer waarmee die gasheer ’n ordelike leegmaak aankondig]:path:_files' \
    '*--git-ssh-rewrite[Herskryf https://<host>/...-bron-URL’s na git@<host>:... (herhaalbaar)]:host:' \
    '*--git-host-rewrite[Herskryf https://<f>/...-bron-URL’s na https://<t>/... (herhaalbaar)]:from=to:' \
    '--use-anthropic-git-proxy[Gebruik Anthropic-bestuurde git. WAARSKUWING: skrap en vervang die git-konfigurasie op HOME-vlak, gebruik slegs onder ’n toegewyde rekening]' \
    '--configure-git[Stel die globale git-identiteit in en aktiveer commit-ondertekening via die Anthropic-ondertekeningsdiens. Skryf ~/.gitconfig]' \
    '--push-outcome-on-release[Stoot gevolgde uitkomstakke by ’n nie-voltooide sessie-einde wat deur die loper begin is]' \
    '--trust-workspace[Saai blywende vertroue vir die repo-paaie van elke sessie (verstek: true)]::bool:(true false)' \
    '--remove-session-state[Verwyder per-sessie-toestand wanneer ’n sessie eindig (verstek: false)]::bool:(true false)' \
    '--diff-finds-nested-repository[Wys ’n repository wat in ’n subgids gekloon is in die Changes-paneel; vereis --capacity 1 (verstek: false)]::bool:(true false)' \
    '--confine-repo-settings[Beperkingswagmodus vir instellings wat in die repo gecommit is (verstek: warn)]:mode:(warn enforce off)' \
    '--server-auto-mode-lists[Watter outo-modus-klassifiseerderlyste van die bediener ’n sessie mag ontvang (verstek: no-allow)]:mode:(all no-allow none)' \
    '--host-config-snapshot[Waar die opstart-momentopname van die gasheerkonfigurasie gehou word (verstek: disk)]:mode:(disk memory)' \
    '--health-port[Poort vir die /healthz-HTTP-luisteraar (verstek: 8080; 0 deaktiveer)]:port:' \
    '--log-level[Logvlak (verstek: info)]:level:(info debug)' \
    '--log-file[Kopieer loperlogs ook na ’n lêer in aanvoegmodus (soos tee)]:path:_files' \
    '--exit-if-unused-min[Sluit die loper af as dit vir N minute nooit werk toegeken word nie]:n:' \
    '--drain-grace-sec[Sekondes om aan te hou soek na werk nadat aktiewe sessies klaar is (verstek: 0)]:n:' \
    '--retire-at[Stel die loper permanent buite diens op hierdie absolute Unix-tyd, in sekondes]:epoch-seconds:' \
    '--defer-shutdown-max-min[Hou by die eerste SIGTERM/SIGINT op om werk te neem en voltooi die afsluiting M minute later (verstek: 0)]:m:' \
    '--release-idle-session-min[Stel ’n sessieplek vry na N minute sonder gebruikersinvoer]:n:' \
    '--startup-timeout-min[Stel ’n sessieplek vry as die kind na N minute nog nie klaar opgestart het nie (verstek: 15; 0 deaktiveer)]:n:' \
    '--kill-session-after-min[Beperk die muurkloklewe van ’n sessiekind tot N minute]:n:' \
    '--debug-token-dir[SLEGS VIR ONTFOUTING: skryf lewendige tokens na skyf. Moenie in produksie gebruik nie]:path:_directories' \
    '(-h --help)'{-h,--help}'[Wys hierdie hulpboodskap]'
}

_claude_remote_control() {
  _arguments \
    '--name[Naam vir die sessie (gewys in claude.ai/code)]:name:' \
    '--remote-control-session-name-prefix[Voorvoegsel vir outomaties gegenereerde sessiename (verstek: hostname)]:prefix:' \
    '(-c --continue --session-id)'{-c,--continue}'[Heg weer aan die sessie wat laaste vir hierdie gids of een van sy git-werkbome aangeteken is]' \
    '(-c --continue --session-id)--session-id[Heg weer aan ’n spesifieke sessie volgens ID]:id:' \
    '--permission-mode[Toestemmingsmodus vir voortgebringde sessies]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)' \
    '(--no-chrome)--chrome[Aktiveer Claude in Chrome vir voortgebringde sessies]' \
    '(--chrome)--no-chrome[Deaktiveer Claude in Chrome vir voortgebringde sessies]' \
    '(-d --debug)'{-d,--debug}'[Aktiveer ontfoutmodus met opsionele kategoriefiltrering]::filter:' \
    '--debug-file[Skryf ontfoutlogboeke na ’n lêer]:path:_files' \
    '(-v --verbose)'{-v,--verbose}'[Aktiveer uitvoerige afvoer]' \
    '--spawn[Voortbringmodus (verstek: same-dir)]:mode:(same-dir worktree session)' \
    '--capacity[Maks. gelyktydige sessies in worktree- of same-dir-modus (verstek: 32)]:n:' \
    '(--no-create-session-in-dir)--create-session-in-dir[Skep vooraf ’n sessie in die huidige gids (verstek)]' \
    '(--create-session-in-dir)--no-create-session-in-dir[Moenie vooraf ’n sessie in die huidige gids skep nie]' \
    '(-h --help)'{-h,--help}'[Wys hierdie hulp]'
}

_claude_daemon() {
  local -a daemon_commands common_options
  daemon_commands=(
    'run:Laat die toesighouer op die voorgrond loop'
    'status:Wys daemon-pid, weergawe, looptyd'
    'logs:Volg die daemon-log (Ctrl-C om te stop)'
    'uninstall:Verwyder die agtergronddiens (launchctl/systemd)'
    'stop:Sluit die toesighouer af en beëindig agtergrondsessies'
  )
  common_options=(
    '--json-path[Konfigurasielêer (verstek: ~/.claude/daemon.json)]:path:_files'
    '--log-file[Loglêer (verstek: ~/.claude/daemon.log)]:path:_files'
    '(-h --help)'{-h,--help}'[Wys hierdie hulp]'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    $common_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'daemon-bevele' daemon_commands
      ;;
    args)
      case $words[1] in
        run)
          _arguments \
            $common_options \
            '::json-path:_files'
          ;;
        stop)
          _arguments \
            $common_options \
            '--any[Stop ook ’n tydelike (nie-diens) daemon]' \
            '--keep-workers[Laat losgemaakte sessies aanhou loop]'
          ;;
        status|logs|uninstall)
          _arguments \
            $common_options
          ;;
      esac
      ;;
  esac
}

_claude_import() {
  _arguments \
    '--dry-run[Wys wat ingevoer sou word sonder om enigiets te skryf]' \
    '--yes[Slaan die interaktiewe kieser oor (op koplose oppervlakke, gee --yes=<digest> uit die /import-voorskou)]' \
    '(-h --help)'{-h,--help}'[Vertoon hulp vir die bevel]' \
    '::source:(codex gemini cursor)'
}

# compinit autoloads this file, and that first call only defines the functions
# above: complete right away so the first TAB already works. Sourced directly,
# there is nothing to complete yet, only the registration.
if [[ $funcstack[1] == _claude ]]; then
  _claude "$@"
else
  (( $+_comps[claude] )) || compdef _claude claude
fi
