#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Konfigurēt un pārvaldīt MCP serverus'
    'plugin:Pārvaldīt Claude Code spraudņus'
    'agents:Pārvaldīt fona aģentus'
    'attach:Atvērt fona sesiju šajā terminālī'
    'logs:Izdrukāt fona sesijas neseno termināļa izvadi'
    'stop:Apturēt fona sesiju (tās saruna tiek saglabāta)'
    'respawn:Restartēt fona sesiju, lai tā darbotos ar pašreizējo Claude Code versiju'
    'rm:Dzēst fona sesiju un, ja tas ir droši, arī tās worktree'
    'auth:Pārvaldīt autentifikāciju'
    'auto-mode:Pārbaudīt vai atiestatīt automātiskā režīma klasifikatora konfigurāciju'
    'gateway:Palaist uzņēmuma autentifikācijas/telemetrijas vārteju'
    'import:Importēt konfigurāciju no cita AI programmēšanas aģenta uz Claude Code'
    'project:Pārvaldīt Claude Code projekta stāvokli'
    'ultrareview:Palaist mākonī mitinātu daudzaģentu koda pārskatīšanu un izdrukāt atradumus'
    'setup-token:Iestatīt ilgtermiņa autentifikācijas pilnvaru (nepieciešams Claude abonements)'
    'doctor:Pārbaudīt Claude Code automātiskās atjaunināšanas sistēmas darbspēju'
    'update:Pārbaudīt un instalēt atjauninājumus'
    'install:Instalēt vietējo Claude Code versiju'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Ieslēgt atkļūdošanas režīmu ar izvēles kategoriju filtrēšanu (piem., "api,hooks" vai "!statsig,!file")]:filter:'
    '--verbose[Pārrakstīt detalizētā režīma iestatījumu no konfigurācijas faila]'
    '(-p --print)'{-p,--print}'[Izdrukāt atbildi un iziet (lietošanai ar pipe). Piezīme: izmantojiet tikai uzticamās direktorijās]'
    '--output-format[Izvades formāts (ar --print): "text" (noklusējuma), "json" (viens rezultāts), vai "stream-json" (straumēšana reālajā laikā)]:format:(text json stream-json)'
    '--json-schema[JSON shēma strukturētas izvades validācijai]:schema:'
    '--include-partial-messages[Iekļaut daļējos ziņojumu fragmentus to ierašanās laikā (ar --print un --output-format=stream-json)]'
    '--input-format[Ievades formāts (ar --print): "text" (noklusējuma) vai "stream-json" (straumēta ievade reālajā laikā)]:format:(text stream-json)'
    '--mcp-debug[\[Novecojis. Izmantojiet --debug tā vietā\] Ieslēgt MCP atkļūdošanas režīmu (rāda MCP servera kļūdas)]'
    '--dangerously-skip-permissions[Apiet visas atļauju pārbaudes. Ieteicams tikai smilškastēm bez interneta piekļuves]'
    '--allow-dangerously-skip-permissions[Iespējot atļauju pārbaužu apiešanas opciju bez iespējošanas pēc noklusējuma]'
    '--restricted[Ierobežotais režīms: noņemt rīkus, kas izpilda komandas vai kodu, un WebFetch, ignorēt user/project/local iestatījumus un ierobežot failu rīkus ar darba direktorijām]'
    '--max-budget-usd[Maksimālā dolāru summa, ko tērēt API izsaukumiem (tikai --print)]:amount:'
    '--replay-user-messages[Atkārtoti nosūtīt lietotāja ziņojumus no stdin uz stdout apstiprinājumam]'
    '--allowed-tools[Atļauto rīku nosaukumu saraksts, atdalīts ar komatiem vai atstarpēm (piem., "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Atļauto rīku nosaukumu saraksts, atdalīts ar komatiem vai atstarpēm (camelCase formāts)]:tools:'
    '--tools[Norādīt pieejamo rīku sarakstu no iebūvētā komplekta. Tikai print režīmā]:tools:'
    '--disallowed-tools[Neatļauto rīku nosaukumu saraksts, atdalīts ar komatiem vai atstarpēm (piem., "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Neatļauto rīku nosaukumu saraksts, atdalīts ar komatiem vai atstarpēm (camelCase formāts)]:tools:'
    '--mcp-config[Ielādēt MCP serverus no JSON faila vai virknes (atdalīti ar atstarpēm)]:configs:'
    '--system-prompt[Sistēmas uzvedne lietošanai sesijā]:prompt:'
    '--system-prompt-file[Nolasīt sistēmas uzvedni no faila]:file:_files'
    '--append-system-prompt[Pievienot sistēmas uzvedni noklusējuma sistēmas uzvednei]:prompt:'
    '--append-system-prompt-file[Nolasīt sistēmas uzvedni no faila un pievienot to noklusējuma sistēmas uzvednei]:file:_files'
    '--system-prompt-snapshot[Ierakstīt sistēmas uzvedni vienreiz katrai sarunai un atkārtoti izmantot to burtiski katrā pieprasījumā un atsākšanā (on, noklusējuma) vai katram pieprasījumam veidot to no jauna (off)]:mode:(on off)'
    '--permission-mode[Atļauju režīms lietošanai sesijā]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Kas atbild uz atļauju uzvednēm ar --print: "host" (SDK resursdators vai --permission-prompt-tool) vai "none" (viss, kam būtu nepieciešama uzvedne, tiek noraidīts)]:target:(host none)'
    '--permission-prompt-tool[MCP rīks, ko izmantot atļauju uzvednēm (tikai --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Turpināt pēdējo sarunu]'
    '(-r --resume)'{-r,--resume}'[Atsākt sarunu - norādiet sesijas identifikatoru vai izvēlieties interaktīvi]:sessionId:_claude_sessions'
    '--fork-session[Izveidot jaunu sesijas identifikatoru, nevis atkārtoti izmantot oriģinālo, atsākot (ar --resume vai --continue)]'
    '--no-session-persistence[Atspējot sesijas saglabāšanu - sesijas netiks saglabātas (tikai --print)]'
    '--model[Modelis pašreizējai sesijai. Norādiet aizstājvārdu jaunākajam modelim (piem., '\''sonnet'\'' vai '\''opus'\'')]:model:_claude_model_names'
    '--agent[Aģents pašreizējai sesijai. Pārraksta '\''agent'\'' iestatījumu]:agent:_claude_agent_names'
    '--betas[Beta galvenes iekļaušanai API pieprasījumos (tikai API atslēgas lietotājiem)]:betas:'
    '--fallback-model[Iespējot automātisko pārslēgšanos uz norādīto modeli, kad noklusējuma modelis ir pārslogots (tikai --print)]:model:_claude_model_names'
    '--settings[Ceļš uz JSON iestatījumu failu vai JSON virkni papildu iestatījumu ielādei]:file-or-json:_files'
    '--add-dir[Papildu direktorijas rīku piekļuves nodrošināšanai]:directories:_directories'
    '--ide[Automātiski savienoties ar IDE startēšanas laikā, ja ir pieejams tieši viens derīgs IDE]'
    '--desktop[Atvērt Claude Desktop lietotnē termināļa vietā (ar --continue vai --resume <id>, lai izvēlētos sesiju)]'
    '--strict-mcp-config[Izmantot tikai MCP serverus no --mcp-config un ignorēt visus citus MCP iestatījumus]'
    '--session-id[Konkrēts sesijas identifikators lietošanai sarunā (jābūt derīgam UUID)]:uuid:'
    '--agents[JSON objekts, kas definē pielāgotus aģentus]:json:'
    '--setting-sources[Iestatījumu avotu saraksts, atdalīts ar komatiem, ielādei (user, project, local)]:sources:'
    '--plugin-dir[Direktorija spraudņu ielādei tikai šai sesijai (var atkārtot)]:paths:_directories'
    '--disable-slash-commands[Atspējot visas slīpsvītras komandas]'
    '(--bg --background)'{--bg,--background}'[Palaist sesiju kā fona aģentu un nekavējoties atgriezties]'
    '(-w --worktree)'{-w,--worktree}'[Izveidot jaunu git worktree šai sesijai (pēc izvēles norādīt nosaukumu)]::name:'
    '--tmux=-[Izveidot tmux sesiju worktree (nepieciešams --worktree). Izmanto iTerm2 iebūvētos paneļus, ja pieejami; --tmux=classic tradicionālajam tmux]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Iestatīt attēlojamo nosaukumu šai sesijai]:name:'
    '--effort[Piepūles līmenis pašreizējai sesijai]:level:(low medium high xhigh max)'
    '--autocompact[Automātiskās saspiešanas loga izmērs (auto vai 100k-1M marķieru)]:size:(auto)'
    '--debug-file[Rakstīt atkļūdošanas žurnālus uz noteiktu faila ceļu (netieši ieslēdz atkļūdošanas režīmu)]:path:_files'
    '--from-pr[Atsākt ar PR saistītu sesiju pēc numura/URL vai atvērt interaktīvo atlasītāju]::value:'
    '--teleport[Atsākt teleport sesiju, pēc izvēles norādot sesijas identifikatoru]::session:'
    '--cloud[Izveidot mākoņa sesiju ar norādīto aprakstu vai pievienoties esošai pēc sesijas identifikatora vai claude.ai/code URL]::description-or-session:'
    '--environment[Izveidot jaunu mākoņa sesiju, kas darbojas norādītajā pašmitinātajā vidē (ccpool_...)]:environment_id:'
    '--remote-control[Sākt interaktīvu sesiju ar iespējotu Remote Control (pēc izvēles ar nosaukumu)]::name:'
    '--remote-control-session-name-prefix[Prefikss automātiski ģenerētiem Remote Control sesiju nosaukumiem]:prefix:'
    '--chrome[Iespējot Claude in Chrome integrāciju]'
    '--no-chrome[Atspējot Claude in Chrome integrāciju]'
    '--plugin-url[Iegūt spraudņa .zip no URL tikai šai sesijai (var atkārtot)]:url:'
    '--file[Failu resursi lejupielādei startēšanas laikā (formāts: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Iespējot uzvednes ieteikumus (izvada prognozēto nākamo uzvedni print/SDK režīmā)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Pārsūtīt apakšaģenta tekstu un domāšanas blokus kā ziņojumus (ar --print un stream-json)]'
    '--include-hook-events[Iekļaut visus āķu dzīves cikla notikumus izvades straumē (ar stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Pārvietot katras iekārtas sadaļas uz pirmo lietotāja ziņojumu, lai uzlabotu uzvednes kešatmiņas atkārtotu izmantošanu]'
    '--brief[Iespējot SendUserMessage rīku aģenta-lietotāja saziņai]'
    '--safe-mode[Sākt ar atspējotiem visiem pielāgojumiem (noderīgi bojātas konfigurācijas problēmu novēršanai)]'
    '--bare[Minimālais režīms: izlaist āķus, LSP, spraudņu sinhronizāciju, attiecinājumu, automātisko atmiņu un CLAUDE.md automātisko atklāšanu]'
    '--ax-screen-reader[Attēlot ekrāna lasītājam draudzīgu izvadi (vienkāršs teksts, bez dekoratīvām robežām vai animācijām)]'
    '(-v --version)'{-v,--version}'[Izvadīt versijas numuru]'
    '(-h --help)'{-h,--help}'[Rādīt palīdzību komandai]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude komandas' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību komandai]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "bez argumentiem"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Palaist Claude Code MCP serveri'
    'add:Pievienot MCP serveri Claude Code'
    'remove:Noņemt MCP serveri'
    'list:Rādīt konfigurēto MCP serveru sarakstu'
    'get:Iegūt MCP servera informāciju'
    'add-json:Pievienot MCP serveri (stdio vai SSE) ar JSON virkni'
    'add-from-claude-desktop:Importēt MCP serverus no Claude Desktop (tikai Mac un WSL)'
    'reset-project-choices:Atiestatīt visus apstiprinātos/noraidītos projekta apjoma (.mcp.json) serverus šajā projektā'
    'login:Autentificēties ar MCP serveri (HTTP, SSE vai claude.ai savienotājs)'
    'logout:Notīrīt saglabātos OAuth akreditācijas datus MCP serverim'
    'help:Rādīt palīdzību'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp komandas' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Ieslēgt atkļūdošanas režīmu]' \
            '--verbose[Pārrakstīt detalizētā režīma iestatījumu no konfigurācijas faila]' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurācijas apjoms (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Transporta tips (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Iestatīt vides mainīgo (piem., -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Iestatīt WebSocket galveni]:header:' \
            '--client-id[OAuth klienta ID HTTP/SSE serveriem]:clientId:' \
            '--client-secret[Pieprasīt OAuth klienta noslēpumu (vai iestatiet vides mainīgo MCP_CLIENT_SECRET)]' \
            '--callback-port[Fiksēts ports OAuth atzvanam (serveriem, kuriem nepieciešami iepriekš reģistrēti novirzīšanas URI)]:port:' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurācijas apjoms (local, user, project) - noņemt no esošā apjoma, ja nav norādīts]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurācijas apjoms (local, user, project)]:scope:(local user project)' \
            '--client-secret[Pieprasīt OAuth klienta noslēpumu (vai iestatiet vides mainīgo MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigurācijas apjoms (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]'
          ;;
        login)
          _arguments \
            '--no-browser[Izdrukāt autorizācijas URL, nevis atvērt pārlūku (SSH/bezgalvas sesijām)]' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Validēt spraudni vai tirgus manifestu'
    'marketplace:Pārvaldīt Claude Code tirgus'
    'list:Rādīt instalēto spraudņu sarakstu'
    'details:Rādīt komponentu inventāru un prognozēto marķieru izmaksu spraudnim'
    'configure:Rādīt spraudņa opcijas un to, kuras nav iestatītas, vai saglabāt vērtības no stdin'
    'install:Instalēt spraudni no pieejamajiem tirgiem'
    'i:Instalēt spraudni no pieejamajiem tirgiem (install saīsinājums)'
    'init:Izveidot jauna spraudņa sagatavi (automātiski ielādējas nākamajā sesijā)'
    'new:Izveidot jauna spraudņa sagatavi (init sinonīms)'
    'uninstall:Noņemt instalēto spraudni'
    'remove:Noņemt instalēto spraudni (uninstall sinonīms)'
    'enable:Iespējot atspējotu spraudni'
    'disable:Atspējot iespējotu spraudni'
    'update:Atjaunināt spraudni uz jaunāko versiju'
    'eval:Palaist novērtēšanas gadījumus pret spraudni un ziņot novērtētos rezultātus'
    'prune:Noņemt automātiski instalētās atkarības, kas vairs nav nepieciešamas'
    'autoremove:Noņemt automātiski instalētās atkarības, kas vairs nav nepieciešamas (prune sinonīms)'
    'tag:Izveidot {name}--v{version} git tagu spraudņa laidienam'
    'test:Palaist moda (spraudņa) testus'
    'help:Rādīt palīdzību'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin komandas' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Uzskatīt brīdinājumus par kļūdām (izejas kods 1)]' \
            '--json[Izvadīt validācijas atskaiti kā JSON (tie paši izejas kodi)]' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Instalācijas apjoms]:scope:(user project local)' \
            '*--config[Iestatīt spraudņa manifestā deklarētu userConfig opciju (var atkārtot)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Pieņemt parādīto tirgus deklarēto komandu bez apstiprinājuma uzvednes]' \
            '--json[Izdrukāt vienu mašīnlasāmu rezultāta rindu cilvēkam paredzētā ziņojuma vietā]' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Instalācijas apjoms]:scope:(user project local)' \
            '--keep-data[Saglabāt spraudņa pastāvīgo datu direktoriju]' \
            '--prune[Noņemt arī automātiski instalētās atkarības, kas vairs nav nepieciešamas]' \
            '(-y --yes)'{-y,--yes}'[Izlaist --prune apstiprinājuma uzvedni]' \
            '--json[Izdrukāt vienu mašīnlasāmu rezultāta rindu cilvēkam paredzētā ziņojuma vietā (ne ar --prune)]' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Instalācijas apjoms]:scope:(user project local)' \
            '--json[Izdrukāt vienu mašīnlasāmu rezultāta rindu cilvēkam paredzētā ziņojuma vietā]' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Atspējot visus iespējotos spraudņus]' \
            '(-s --scope)'{-s,--scope}'[Instalācijas apjoms]:scope:(user project local)' \
            '--json[Izdrukāt vienu mašīnlasāmu rezultāta rindu cilvēkam paredzētā ziņojuma vietā]' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Instalācijas apjoms]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Pieņemt parādīto tirgus deklarēto komandu bez apstiprinājuma uzvednes]' \
            '--json[Izdrukāt vienu mašīnlasāmu rezultāta rindu cilvēkam paredzētā ziņojuma vietā]' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Izvadīt kā JSON]' \
            '--available[Iekļaut pieejamos spraudņus no tirgiem (nepieciešams --json)]' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Tīrīt norādītajā apjomā]:scope:(user project local)' \
            '--dry-run[Uzskaitīt, kas tiktu noņemts, neko nenoņemot]' \
            '(-y --yes)'{-y,--yes}'[Izlaist apstiprinājuma uzvedni]' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]'
          ;;
        configure)
          _arguments \
            '--json[Izvadīt kā JSON]' \
            '--values-stdin[Nolasīt opciju vērtības no stdin kā JSON objektu ar vienrindas virknēm; neiekļautās opcijas saglabā savas vērtības]' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Manifesta apraksts]:text:' \
            '--author[Autora vārds (noklusējums: git config user.name)]:name:' \
            '--author-email[Autora e-pasts (noklusējums: git config user.email)]:email:' \
            '--with[Komponenti, kuru sagatavi izveidot papildus]:components:' \
            '(-f --force)'{-f,--force}'[Pārrakstīt esošo .claude-plugin/ mērķī]' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Filtrēt gadījumus pēc nosaukuma glob šablona]:glob:' \
            '*--tag[Filtrēt gadījumus pēc taga (var atkārtot)]:tag:' \
            '--runs[Pārrakstīt palaišanu skaitu katram gadījumam (noklusējums: case.runs, citādi 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Izpildīt līdz n aģenta palaišanām vienlaikus (1-8; noklusējums 1)]:n:' \
            '--model[Pārrakstīt modeli visiem gadījumiem]:model:_claude_model_names' \
            '--judge-model[Pārrakstīt LLM vērtētāja modeli (noklusējums: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Stingri izmaksu griesti; tos sasniedzot, pārtraukt un ziņot daļējos rezultātus (izejas kods 2)]:usd:' \
            '--output-dir[Direktorija failam aggregate-result.json]:dir:_directories' \
            '--eval-dir[Direktorijas nosaukums (spraudņa iekšienē), kurā atrodas novērtēšanas gadījumi]:dir:' \
            '--json[Izdrukāt pilnu palaišanas rezultātu kā JSON uz stdout vai ierakstīt to šajā .json failā]::path:_files' \
            '--threshold[Iziet ar izejas kodu 1, ja kāda gadījuma vērtējums ir zem šī sliekšņa (noklusējums: 1.0)]:threshold:' \
            '*--allow-tools[Operatora atļauja ierobežotajiem rīkiem (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Palaist katra gadījuma scaffold_script (izpilda autora sniegto bash jūsu vārdā; pēc noklusējuma izslēgts)]' \
            '(--scaffold)--no-scaffold[Skaidri izlaist scaffold_script]' \
            '--trust-plugin[Apliecināt, ka uzticaties šim spraudnim un tā novērtēšanas komplektam, izlaižot pirmās palaišanas uzticamības uzvedni (CI vajadzībām)]' \
            '--ablation[Palaist bāzlīnijas salīdzinājuma grupu bez spraudņa un ziņot vērtējuma starpību]:mode:(none with-without)' \
            '--mocks[Imitācijas aizstājēji MCP serveriem no <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Ar --mocks record: palaist arī īstos MCP serveru procesus, kuriem nav imitācijas]' \
            '--keep-temp[Saglabāt sagatavju direktorijas atkļūdošanai]' \
            '--verbose[Reģistrēt katra ziņojuma izsekošanas notikumus atkļūdošanas žurnālā]' \
            '--report[Ierakstīt pašpietiekamo HTML atskaiti šajā ceļā, nevis rezultātu direktorijā]:path:_files' \
            '(--no-publish)--publish-report[Pieprasīt arī atskaites publicēšanu claude.ai]' \
            '(--publish-report)--no-publish[Paturēt HTML atskaiti tikai lokāli; izlaist tās publicēšanu claude.ai]' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Nosūtīt tagu uz --remote pēc tā izveides]' \
            '--dry-run[Izdrukāt, kas tiktu atzīmēts ar tagu, to neizveidojot]' \
            '(-f --force)'{-f,--force}'[Izlaist neiesūtītu izmaiņu darba kokā un jau esoša taga pārbaudes]' \
            '(-m --message)'{-m,--message}'[Taga anotācijas ziņojums (izmantojiet %s versijai)]:msg:' \
            '--remote[Attālā krātuve, uz kuru nosūtīt ar --push]:name:' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Pievienot tirgu no URL, ceļa vai GitHub krātuves'
    'list:Rādīt konfigurēto tirgu sarakstu'
    'remove:Noņemt konfigurēto tirgu'
    'rm:Noņemt konfigurēto tirgu (remove sinonīms)'
    'update:Atjaunināt tirgu no avota - atjaunināt visus, ja nosaukums nav norādīts'
    'help:Rādīt palīdzību'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace komandas' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Ierobežot izgūšanu ar noteiktām direktorijām, izmantojot git sparse-checkout (monorepozitorijiem)]:paths:' \
            '--scope[Kur deklarēt tirgu]:scope:(user project local)' \
            '--claudeai[Pievienot šī nosaukuma tirgu, ko claude.ai mitina jums]' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Izvadīt kā JSON]' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Noņemt tirgus deklarāciju no konkrēta iestatījumu apjoma (izlaidiet, lai noņemtu to no visiem apjomiem)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Piespiedu instalācija, pat ja jau instalēts]' \
    '(-h --help)'{-h,--help}'[Rādīt palīdzību]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Papildu direktorija rīku piekļuves nodrošināšanai nosūtītajās sesijās]:directory:_directories' \
    '--agent[Noklusējuma aģents sesijām, kas nosūtītas no aģentu skata]:agent:_claude_agent_names' \
    '--all[Ar --json: iekļaut arī pabeigtās fona sesijas]' \
    '--allow-dangerously-skip-permissions[Padarīt atļauju apiešanas režīmu pieejamu nosūtītajām sesijām]' \
    '--cwd[Rādīt tikai fona sesijas, kas sāktas zem ceļa]:path:_directories' \
    '--dangerously-skip-permissions[Aizstājvārds --permission-mode bypassPermissions]' \
    '--effort[Noklusējuma piepūles līmenis nosūtītajām sesijām]:level:(low medium high xhigh max)' \
    '--json[Izdrukāt aktīvās sesijas kā JSON masīvu un iziet]' \
    '*--mcp-config[MCP servera konfigurācija, ko piemērot nosūtītajām sesijām]:config:' \
    '--model[Noklusējuma modelis sesijām, kas nosūtītas no aģentu skata]:model:_claude_model_names' \
    '--permission-mode[Noklusējuma atļauju režīms nosūtītajām sesijām]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Ielādēt spraudņus no direktorijas aģentu skatam un nosūtītajām sesijām]:path:_directories' \
    '--setting-sources[Iestatījumu avotu saraksts, atdalīts ar komatiem, ielādei (user, project, local)]:sources:' \
    '--settings[Iestatījumu fails vai JSON virkne, ko piemērot]:file-or-json:_files' \
    '--strict-mcp-config[Izmantot tikai MCP serverus no --mcp-config nosūtītajās sesijās]' \
    '--restricted[Sākt nosūtītās sesijas ierobežotajā režīmā]' \
    '(-h --help)'{-h,--help}'[Rādīt palīdzību komandai]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Pierakstīties savā Anthropic kontā'
    'logout:Izrakstīties no sava Anthropic konta'
    'status:Rādīt autentifikācijas statusu'
    'help:Rādīt palīdzību'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Rādīt palīdzību komandai]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth komandas' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Iepriekš aizpildīt e-pasta adresi pieteikšanās lapā]:email:' \
            '--sso[Piespiedu kārtā izmantot SSO pieteikšanās plūsmu]' \
            '(--claudeai)--console[Izmantot Anthropic Console (norēķini par API lietojumu) Claude abonementa vietā]' \
            '(--console)--claudeai[Izmantot Claude abonementu (noklusējuma)]' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību komandai]'
          ;;
        status)
          _arguments \
            '(--text)--json[Izvadīt kā JSON (noklusējuma)]' \
            '(--json)--text[Izvadīt kā cilvēkam lasāmu tekstu]' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību komandai]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību komandai]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Izdrukāt spēkā esošo automātiskā režīma konfigurāciju kā JSON'
    'critique:Saņemt AI atsauksmes par jūsu pielāgotajiem automātiskā režīma noteikumiem'
    'defaults:Izdrukāt noklusējuma automātiskā režīma noteikumus kā JSON'
    'reset:Atiestatīt automātiskā režīma konfigurāciju uz piegādātajiem noklusējumiem'
    'help:Rādīt palīdzību'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Rādīt palīdzību komandai]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode komandas' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Pārrakstīt izmantojamo modeli]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību komandai]'
          ;;
        defaults)
          _arguments \
            '--label[Rādīt tikai noteikumus, kuru etiķete sākas ar šo prefiksu (reģistrnejutīgi)]:prefix:' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību komandai]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Izlaist apstiprinājuma uzvedni]' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību komandai]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību komandai]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Ceļš uz vārtejas YAML konfigurāciju]:path:_files' \
    '(-h --help)'{-h,--help}'[Rādīt palīdzību komandai]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Dzēst visu Claude Code stāvokli projektam (transkripti, uzdevumi, failu vēsture, konfigurācijas ieraksts)'
    'help:Rādīt palīdzību'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Rādīt palīdzību komandai]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project komandas' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Uzskaitīt, kas tiktu dzēsts, neko nedzēšot]' \
            '(-y --yes)'{-y,--yes}'[Izlaist apstiprinājuma uzvedni]' \
            '(-i --interactive)'{-i,--interactive}'[Vaicāt par katru vienumu pirms dzēšanas]' \
            '(1)--all[Dzēst stāvokli visiem projektiem (savstarpēji izslēdzošs ar ceļu)]' \
            '(-h --help)'{-h,--help}'[Rādīt palīdzību komandai]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Izdrukāt neapstrādāto bugs.json kravu formatētu atradumu vietā]' \
    '--timeout[Maksimālais minūšu skaits, cik gaidīt pārskatīšanas pabeigšanu (noklusējums: 45)]:minutes:' \
    '(--no-post)--post[Publicēt pabeigtās pārskatīšanas atradumus PR jūsu vārdā (tikai PR mērķiem; viens vienkāršs komentārs, nevis pārskatīšana)]' \
    '(--post)--no-post[Nepublicēt atradumus PR (noklusējuma)]' \
    '(-h --help)'{-h,--help}'[Rādīt palīdzību komandai]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Restartēt katru darbojošos fona sesiju]' \
    '(-h --help)'{-h,--help}'[Rādīt palīdzību komandai]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Atmest arī worktree nenosūtītās iesūtes un neiesūtītās izmaiņas (norādiet commit@worktree-id, ko ziņoja iepriekšējā claude rm izpilde)]:commit@worktree-id:' \
    '--force-remove-worktree[Dzēst worktree direktoriju, pat ja WorktreeRemove āķis vai git to nevarēja noņemt (norādiet worktree-id, ko ziņoja iepriekšējā claude rm izpilde)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Rādīt palīdzību komandai]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Rādīt, kas tiktu importēts, neko neierakstot]' \
    '--yes[Izlaist interaktīvo atlasītāju (bezgalvas vidēs norādiet --yes=<digest> no /import priekšskatījuma)]' \
    '(-h --help)'{-h,--help}'[Rādīt palīdzību komandai]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
