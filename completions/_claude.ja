#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:MCPサーバーの設定と管理'
    'plugin:Claude Codeプラグインの管理'
    'agents:バックグラウンドエージェントの管理'
    'attach:バックグラウンドセッションをこのターミナルで開く'
    'logs:バックグラウンドセッションの最近のターミナル出力を表示'
    'stop:バックグラウンドセッションを停止（会話は保持される）'
    'respawn:バックグラウンドセッションを再起動して現在のClaude Codeバージョンで動かす'
    'rm:バックグラウンドセッションを削除（安全な場合はそのworktreeも）'
    'auth:認証の管理'
    'auto-mode:自動モード分類器の設定を確認またはリセット'
    'gateway:エンタープライズ認証/テレメトリゲートウェイを実行'
    'import:他のAIコーディングエージェントの設定をClaude Codeに取り込む'
    'project:Claude Codeプロジェクトの状態を管理'
    'ultrareview:クラウドホスト型のマルチエージェントコードレビューを実行し、指摘結果を出力'
    'setup-token:長期認証トークンの設定（Claude サブスクリプション必要）'
    'doctor:Claude Code自動アップデーターの健全性チェック'
    'update:アップデートの確認とインストール'
    'install:Claude Codeネイティブビルドのインストール'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[オプションのカテゴリフィルタリング付きデバッグモード有効化（例："api,hooks" または "!statsig,!file"）]:filter:'
    '--verbose[設定ファイルの詳細モード設定を上書き]'
    '(-p --print)'{-p,--print}'[レスポンスを出力して終了（パイプで使用可）。注：信頼できるディレクトリのみで使用]'
    '--output-format[出力フォーマット（--printと併用）："text"（デフォルト）、"json"（単一結果）、"stream-json"（リアルタイムストリーミング）]:format:(text json stream-json)'
    '--json-schema[構造化出力検証用JSONスキーマ]:schema:'
    '--include-partial-messages[到着時に部分的なメッセージチャンクを含める（--printと--output-format=stream-jsonと併用）]'
    '--input-format[入力フォーマット（--printと併用）："text"（デフォルト）、または "stream-json"（リアルタイムストリーミング入力）]:format:(text stream-json)'
    '--mcp-debug[\[非推奨。代わりに--debugを使用\] MCPデバッグモード有効化（MCPサーバーエラーを表示）]'
    '--dangerously-skip-permissions[すべての権限チェックをバイパス。インターネットアクセスのないサンドボックスのみ推奨]'
    '--allow-dangerously-skip-permissions[デフォルトで有効にせず、権限チェックのバイパスをオプションとして有効化]'
    '--restricted[制限モード：コマンドやコードを実行するツールとWebFetchを外し、user/project/local設定を無視し、ファイルツールを作業ディレクトリに限定]'
    '--max-budget-usd[API呼び出しに費やす最大金額（ドル）（--printのみ）]:amount:'
    '--replay-user-messages[stdinからのユーザーメッセージをstdoutで確認のため再送信]'
    '--allowed-tools[許可するツール名のカンマまたはスペース区切りリスト（例："Bash(git:*) Edit"）]:tools:'
    '--allowedTools[許可するツール名のカンマまたはスペース区切りリスト（キャメルケース形式）]:tools:'
    '--tools[組み込みセットから利用可能なツールのリストを指定。--printモードのみ]:tools:'
    '--disallowed-tools[拒否するツール名のカンマまたはスペース区切りリスト（例："Bash(git:*) Edit"）]:tools:'
    '--disallowedTools[拒否するツール名のカンマまたはスペース区切りリスト（キャメルケース形式）]:tools:'
    '--mcp-config[JSONファイルまたは文字列からMCPサーバーを読み込む（スペース区切り）]:configs:'
    '--system-prompt[セッションで使用するシステムプロンプト]:prompt:'
    '--system-prompt-file[システムプロンプトをファイルから読み込む]:file:_files'
    '--append-system-prompt[デフォルトのシステムプロンプトにシステムプロンプトを追加]:prompt:'
    '--append-system-prompt-file[システムプロンプトをファイルから読み込み、デフォルトのシステムプロンプトに追加]:file:_files'
    '--system-prompt-snapshot[システムプロンプトを会話ごとに1回記録し、以後のリクエストと再開で毎回そのまま再利用する（on、デフォルト）か、毎回生成し直す（off）]:mode:(on off)'
    '--permission-mode[セッションで使用する権限モード]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[--print時に権限プロンプトへ誰が答えるか："host"（SDKホストまたは--permission-prompt-tool）か"none"（プロンプトになるものはすべて拒否）]:target:(host none)'
    '--permission-prompt-tool[権限プロンプトに使うMCPツール（--printのみ）]:tool:'
    '(-c --continue)'{-c,--continue}'[最新の会話を続ける]'
    '(-r --resume)'{-r,--resume}'[会話を再開 - セッションIDを指定するか、対話的に選択]:sessionId:_claude_sessions'
    '--fork-session[再開時、元のセッションIDを再利用せず新しいセッションIDを作成（--resumeまたは--continueと併用）]'
    '--no-session-persistence[セッションの永続化を無効化 - セッションは保存されない（--printのみ）]'
    '--model[現在のセッション用モデル。最新モデルのエイリアス（例：'\''sonnet'\''または'\''opus'\''）を指定]:model:_claude_model_names'
    '--agent[現在のセッション用エージェント。'\''agent'\''設定を上書き]:agent:_claude_agent_names'
    '--betas[APIリクエストに含めるベータヘッダー（APIキーユーザーのみ）]:betas:'
    '--fallback-model[デフォルトモデルが過負荷時に指定モデルへ自動フォールバック有効化（--printのみ）]:model:_claude_model_names'
    '--settings[設定JSONファイルへのパスまたは追加設定を読み込むJSON文字列]:file-or-json:_files'
    '--add-dir[ツールアクセスを許可する追加ディレクトリ]:directories:_directories'
    '--ide[正確に1つの有効なIDEが利用可能な場合、起動時に自動接続]'
    '--strict-mcp-config[--mcp-configのMCPサーバーのみ使用し、他のすべてのMCP設定を無視]'
    '--session-id[会話で使用する特定のセッションID（有効なUUIDである必要あり）]:uuid:'
    '--agents[カスタムエージェントを定義するJSONオブジェクト]:json:'
    '--setting-sources[読み込む設定ソースのカンマ区切りリスト（user, project, local）]:sources:'
    '--plugin-dir[このセッションのみプラグインを読み込むディレクトリ（繰り返し可能）]:paths:_directories'
    '--disable-slash-commands[すべてのスラッシュコマンドを無効化]'
    '(--bg --background)'{--bg,--background}'[セッションをバックグラウンドエージェントとして開始し、すぐに戻る]'
    '(-w --worktree)'{-w,--worktree}'[このセッション用に新しいgit worktreeを作成（オプションで名前を指定可能）]::name:'
    '--tmux=-[worktree用のtmuxセッションを作成（--worktreeが必要）。可能ならiTerm2ネイティブペインを使用。従来のtmuxは--tmux=classic]::mode:(classic)'
    '(-n --name)'{-n,--name}'[このセッションの表示名を設定]:name:'
    '--effort[現在のセッションの努力レベル]:level:(low medium high xhigh max)'
    '--autocompact[自動コンパクトのウィンドウサイズ（auto、または100k〜1Mトークン）]:size:(auto)'
    '--debug-file[デバッグログを特定のファイルパスに書き込む（暗黙的にデバッグモードを有効化）]:path:_files'
    '--from-pr[番号/URLでPRにリンクされたセッションを再開、または対話的なピッカーを開く]::value:'
    '--teleport[テレポートセッションを再開（オプションでセッションIDを指定）]::session:'
    '--cloud[指定した説明でクラウドセッションを作成、またはセッションIDかclaude.ai/code URLで既存のものにアタッチ]::description-or-session:'
    '--environment[指定したセルフホスト環境（ccpool_...）で動く新しいクラウドセッションを作成]:environment_id:'
    '--remote-control[Remote Controlを有効にした対話セッションを開始（オプションで名前指定可能）]::name:'
    '--remote-control-session-name-prefix[自動生成されるRemote Controlセッション名のプレフィックス]:prefix:'
    '--chrome[Claude in Chrome統合を有効化]'
    '--no-chrome[Claude in Chrome統合を無効化]'
    '--plugin-url[このセッションのみURLからプラグインの.zipを取得（繰り返し可能）]:url:'
    '--file[起動時にダウンロードするファイルリソース（形式：file_id:relative_path）]:specs:'
    '--prompt-suggestions[プロンプト候補を有効化（print/SDKモードで予測される次のプロンプトを出力）]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[サブエージェントのテキストと思考ブロックをメッセージとして転送（--printとstream-jsonと併用）]'
    '--include-hook-events[すべてのフックライフサイクルイベントを出力ストリームに含める（stream-jsonと併用）]'
    '--exclude-dynamic-system-prompt-sections[マシンごとのセクションを最初のユーザーメッセージに移動し、プロンプトキャッシュの再利用を改善]'
    '--brief[エージェントからユーザーへの通信用SendUserMessageツールを有効化]'
    '--safe-mode[すべてのカスタマイズを無効にして開始（壊れた設定のトラブルシューティングに有用）]'
    '--bare[最小モード：フック、LSP、プラグイン同期、属性表示、自動メモリ、CLAUDE.md自動検出をスキップ]'
    '--ax-screen-reader[スクリーンリーダーに適した出力を表示（フラットテキスト、装飾的な枠線やアニメーションなし）]'
    '(-v --version)'{-v,--version}'[バージョン番号を出力]'
    '(-h --help)'{-h,--help}'[コマンドのヘルプを表示]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claudeコマンド' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[コマンドのヘルプを表示]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "引数なし"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Claude Code MCPサーバーを起動'
    'add:MCPサーバーをClaude Codeに追加'
    'remove:MCPサーバーを削除'
    'list:設定済みMCPサーバーを一覧表示'
    'get:MCPサーバーの詳細を取得'
    'add-json:JSON文字列でMCPサーバー（stdioまたはSSE）を追加'
    'add-from-claude-desktop:Claude DesktopからMCPサーバーをインポート（MacとWSLのみ）'
    'reset-project-choices:このプロジェクト内のすべての承認済み・拒否済みプロジェクトスコープ（.mcp.json）サーバーをリセット'
    'login:MCPサーバーで認証（HTTP、SSE、またはclaude.aiコネクタ）'
    'logout:MCPサーバーの保存済みOAuth認証情報をクリア'
    'help:ヘルプを表示'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ヘルプを表示]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp コマンド' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[デバッグモードを有効化]' \
            '--verbose[設定ファイルの詳細モード設定を上書き]' \
            '(-h --help)'{-h,--help}'[ヘルプを表示]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[設定スコープ（local, user, project）]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[トランスポートタイプ（stdio, sse, http）]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[環境変数を設定（例：-e KEY=value）]:env:' \
            '(-H --header)'{-H,--header}'[WebSocketヘッダーを設定]:header:' \
            '--client-id[HTTP/SSEサーバー用のOAuthクライアントID]:clientId:' \
            '--client-secret[OAuthクライアントシークレットを入力させる（または環境変数MCP_CLIENT_SECRETを設定）]' \
            '--callback-port[OAuthコールバック用の固定ポート（リダイレクトURIの事前登録が必要なサーバー向け）]:port:' \
            '(-h --help)'{-h,--help}'[ヘルプを表示]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[設定スコープ（local, user, project） - 未指定の場合は存在するスコープから削除]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[ヘルプを表示]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[ヘルプを表示]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[ヘルプを表示]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[設定スコープ（local, user, project）]:scope:(local user project)' \
            '--client-secret[OAuthクライアントシークレットを入力させる（または環境変数MCP_CLIENT_SECRETを設定）]' \
            '(-h --help)'{-h,--help}'[ヘルプを表示]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[設定スコープ（local, user, project）]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[ヘルプを表示]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[ヘルプを表示]'
          ;;
        login)
          _arguments \
            '--no-browser[ブラウザを開かず認可URLを表示（SSH/ヘッドレスセッション向け）]' \
            '(-h --help)'{-h,--help}'[ヘルプを表示]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[ヘルプを表示]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:プラグインまたはマーケットプレイスマニフェストを検証'
    'marketplace:Claude Codeマーケットプレイスを管理'
    'list:インストール済みプラグインを一覧表示'
    'details:プラグインのコンポーネント一覧と予測トークンコストを表示'
    'install:利用可能なマーケットプレイスからプラグインをインストール'
    'i:利用可能なマーケットプレイスからプラグインをインストール（installの短縮形）'
    'init:新しいプラグインの雛形を作成（次のセッションで自動読み込み）'
    'new:新しいプラグインの雛形を作成（initのエイリアス）'
    'uninstall:インストール済みプラグインをアンインストール'
    'remove:インストール済みプラグインをアンインストール（uninstallのエイリアス）'
    'enable:無効化されたプラグインを有効化'
    'disable:有効化されたプラグインを無効化'
    'update:プラグインを最新バージョンに更新'
    'eval:プラグインに対してevalケースを実行し、スコア付き結果を報告'
    'prune:不要になった自動インストール済み依存関係を削除'
    'autoremove:不要になった自動インストール済み依存関係を削除（pruneのエイリアス）'
    'tag:プラグインリリース用に{name}--v{version}のgitタグを作成'
    'help:ヘルプを表示'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ヘルプを表示]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin コマンド' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[警告をエラーとして扱う（終了コード1）]' \
            '--json[検証レポートをJSONで出力（終了コードは同じ）]' \
            '(-h --help)'{-h,--help}'[ヘルプを表示]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[インストールスコープ]:scope:(user project local)' \
            '*--config[プラグインマニフェストで宣言されたuserConfigオプションを設定（繰り返し可）]:key=value:' \
            '(-y --yes)'{-y,--yes}'[表示されたマーケットプレイス宣言のコマンドを確認なしで受け入れる]' \
            '--json[人向けのメッセージの代わりに機械可読な結果を1行出力]' \
            '(-h --help)'{-h,--help}'[ヘルプを表示]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[インストールスコープ]:scope:(user project local)' \
            '--keep-data[プラグインの永続データディレクトリを残す]' \
            '--prune[不要になった自動インストール済み依存関係も削除]' \
            '(-y --yes)'{-y,--yes}'[--pruneの確認プロンプトをスキップ]' \
            '--json[人向けのメッセージの代わりに機械可読な結果を1行出力（--pruneとは併用不可）]' \
            '(-h --help)'{-h,--help}'[ヘルプを表示]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[インストールスコープ]:scope:(user project local)' \
            '--json[人向けのメッセージの代わりに機械可読な結果を1行出力]' \
            '(-h --help)'{-h,--help}'[ヘルプを表示]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[有効なプラグインをすべて無効化]' \
            '(-s --scope)'{-s,--scope}'[インストールスコープ]:scope:(user project local)' \
            '--json[人向けのメッセージの代わりに機械可読な結果を1行出力]' \
            '(-h --help)'{-h,--help}'[ヘルプを表示]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[インストールスコープ]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[表示されたマーケットプレイス宣言のコマンドを確認なしで受け入れる]' \
            '--json[人向けのメッセージの代わりに機械可読な結果を1行出力]' \
            '(-h --help)'{-h,--help}'[ヘルプを表示]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[JSONで出力]' \
            '--available[マーケットプレイスで利用可能なプラグインも含める（--jsonが必要）]' \
            '(-h --help)'{-h,--help}'[ヘルプを表示]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[このスコープで整理]:scope:(user project local)' \
            '--dry-run[削除せずに削除対象を一覧表示]' \
            '(-y --yes)'{-y,--yes}'[確認プロンプトをスキップ]' \
            '(-h --help)'{-h,--help}'[ヘルプを表示]'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[ヘルプを表示]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[マニフェストの説明]:text:' \
            '--author[作者名（デフォルト：git config user.name）]:name:' \
            '--author-email[作者のメールアドレス（デフォルト：git config user.email）]:email:' \
            '--with[併せて雛形を作るコンポーネント]:components:' \
            '(-f --force)'{-f,--force}'[対象に既存の.claude-plugin/があれば上書き]' \
            '(-h --help)'{-h,--help}'[ヘルプを表示]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[ケースを名前のglobで絞り込む]:glob:' \
            '*--tag[ケースをタグで絞り込む（繰り返し可）]:tag:' \
            '--runs[ケースごとの実行回数を上書き（デフォルト：case.runs、なければ3）]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[エージェント実行を最大n個同時に走らせる（1〜8、デフォルト1）]:n:' \
            '--model[全ケースのモデルを上書き]:model:_claude_model_names' \
            '--judge-model[LLM採点者のモデルを上書き（デフォルト：haiku）]:model:_claude_model_names' \
            '--max-cost-usd[コスト上限。到達したら中断して部分結果を報告（終了コード2）]:usd:' \
            '--output-dir[aggregate-result.jsonの出力ディレクトリ]:dir:_directories' \
            '--eval-dir[評価ケースを置くディレクトリ名（プラグイン配下）]:dir:' \
            '--json[実行結果全体をJSONで標準出力に出す、またはこの.jsonファイルに書き出す]::path:_files' \
            '--threshold[いずれかのケースのスコアがこのしきい値未満なら終了コード1（デフォルト：1.0）]:threshold:' \
            '*--allow-tools[制限付きツール（Bash、Write、Edit、WebFetch、mcp__*）の実行者による許可]:tools:' \
            '(--no-scaffold)--scaffold[各ケースのscaffold_scriptを実行（作者提供のbashをあなたの権限で実行。デフォルトはオフ）]' \
            '(--scaffold)--no-scaffold[scaffold_scriptを明示的にスキップ]' \
            '--trust-plugin[このプラグインと評価スイートを信頼すると宣言し、初回の信頼確認をスキップ（CI向け）]' \
            '--ablation[プラグインなしのベースラインも実行してスコア差を報告]:mode:(none with-without)' \
            '--mocks[MCPサーバーのモック代替（<eval dir>/mocks/から）]:mode:(record off)' \
            '--allow-real-servers[--mocks record時、モックのないMCPサーバーは実プロセスも起動]' \
            '--keep-temp[デバッグ用にscaffoldディレクトリを残す]' \
            '--verbose[メッセージごとのトレースイベントをデバッグログに記録]' \
            '--report[自己完結型HTMLレポートを結果ディレクトリではなくこのパスに書き出す]:path:_files' \
            '(--no-publish)--publish-report[レポートのclaude.aiへの公開も必須にする]' \
            '(--publish-report)--no-publish[HTMLレポートをローカルのみに留め、claude.aiへ公開しない]' \
            '(-h --help)'{-h,--help}'[ヘルプを表示]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[作成後にタグを--remoteへプッシュ]' \
            '--dry-run[タグを作成せずに対象を表示]' \
            '(-f --force)'{-f,--force}'[作業ツリーの未コミット確認とタグ重複確認をスキップ]' \
            '(-m --message)'{-m,--message}'[タグの注釈メッセージ（%sはバージョンに置換）]:msg:' \
            '--remote[--pushでプッシュする先のリモート]:name:' \
            '(-h --help)'{-h,--help}'[ヘルプを表示]' \
            '::path:_files'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:URL、パス、GitHubリポジトリからマーケットプレイスを追加'
    'list:設定済みマーケットプレイスを一覧表示'
    'remove:設定済みマーケットプレイスを削除'
    'rm:設定済みマーケットプレイスを削除（removeのエイリアス）'
    'update:ソースからマーケットプレイスを更新 - 名前未指定の場合はすべて更新'
    'help:ヘルプを表示'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ヘルプを表示]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace コマンド' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[git sparse-checkoutで特定ディレクトリのみチェックアウト（モノレポ向け）]:paths:' \
            '--scope[マーケットプレイスを宣言する場所]:scope:(user project local)' \
            '--claudeai[claude.aiがホストするこの名前のマーケットプレイスを追加]' \
            '(-h --help)'{-h,--help}'[ヘルプを表示]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[JSONで出力]' \
            '(-h --help)'{-h,--help}'[ヘルプを表示]'
          ;;
        remove|rm)
          _arguments \
            '--scope[特定の設定スコープからマーケットプレイス宣言を削除（省略時はすべてのスコープから削除）]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[ヘルプを表示]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[ヘルプを表示]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[すでにインストール済みでも強制的にインストール]' \
    '(-h --help)'{-h,--help}'[ヘルプを表示]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[ディスパッチされたセッションでツールアクセスを許可する追加ディレクトリ]:directory:_directories' \
    '--agent[エージェントビューからディスパッチされるセッションのデフォルトエージェント]:agent:_claude_agent_names' \
    '--all[--jsonと併用：完了したバックグラウンドセッションも含める]' \
    '--allow-dangerously-skip-permissions[ディスパッチされたセッションでbypass-permissionsモードを利用可能にする]' \
    '--cwd[指定したパス配下で開始されたバックグラウンドセッションのみ表示]:path:_directories' \
    '--dangerously-skip-permissions[--permission-mode bypassPermissionsのエイリアス]' \
    '--effort[ディスパッチされたセッションのデフォルト努力レベル]:level:(low medium high xhigh max)' \
    '--json[アクティブなセッションをJSON配列として出力して終了]' \
    '*--mcp-config[ディスパッチされたセッションに適用するMCPサーバー設定]:config:' \
    '--model[エージェントビューからディスパッチされるセッションのデフォルトモデル]:model:_claude_model_names' \
    '--permission-mode[ディスパッチされたセッションのデフォルト権限モード]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[エージェントビューとディスパッチされたセッション用にディレクトリからプラグインを読み込む]:path:_directories' \
    '--setting-sources[読み込む設定ソースのカンマ区切りリスト（user, project, local）]:sources:' \
    '--settings[適用する設定ファイルまたはJSON文字列]:file-or-json:_files' \
    '--strict-mcp-config[ディスパッチされたセッションで--mcp-configのMCPサーバーのみ使用]' \
    '--restricted[ディスパッチされるセッションを制限モードで開始]' \
    '(-h --help)'{-h,--help}'[コマンドのヘルプを表示]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Anthropicアカウントにサインイン'
    'logout:Anthropicアカウントからログアウト'
    'status:認証ステータスを表示'
    'help:ヘルプを表示'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[コマンドのヘルプを表示]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth コマンド' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[ログインページにメールアドレスをあらかじめ入力]:email:' \
            '--sso[SSOログインフローを強制]' \
            '(--claudeai)--console[ClaudeサブスクリプションではなくAnthropic Console（API従量課金）を使用]' \
            '(--console)--claudeai[Claudeサブスクリプションを使用（デフォルト）]' \
            '(-h --help)'{-h,--help}'[コマンドのヘルプを表示]'
          ;;
        status)
          _arguments \
            '(--text)--json[JSONで出力（デフォルト）]' \
            '(--json)--text[人が読めるテキストで出力]' \
            '(-h --help)'{-h,--help}'[コマンドのヘルプを表示]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[コマンドのヘルプを表示]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:有効な自動モード設定をJSONとして出力'
    'critique:カスタム自動モードルールに対するAIフィードバックを取得'
    'defaults:デフォルトの自動モードルールをJSONとして出力'
    'reset:自動モード設定を出荷時のデフォルトにリセット'
    'help:ヘルプを表示'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[コマンドのヘルプを表示]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode コマンド' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[使用するモデルを上書き]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[コマンドのヘルプを表示]'
          ;;
        defaults)
          _arguments \
            '--label[ラベルがこの接頭辞で始まるルールのみ表示（大文字小文字を区別しない）]:prefix:' \
            '(-h --help)'{-h,--help}'[コマンドのヘルプを表示]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[確認プロンプトをスキップ]' \
            '(-h --help)'{-h,--help}'[コマンドのヘルプを表示]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[コマンドのヘルプを表示]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[ゲートウェイYAML設定へのパス]:path:_files' \
    '(-h --help)'{-h,--help}'[コマンドのヘルプを表示]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:プロジェクトのすべてのClaude Code状態を削除（トランスクリプト、タスク、ファイル履歴、設定エントリ）'
    'help:ヘルプを表示'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[コマンドのヘルプを表示]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project コマンド' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[何も削除せずに削除対象を一覧表示]' \
            '(-y --yes)'{-y,--yes}'[確認プロンプトをスキップ]' \
            '(-i --interactive)'{-i,--interactive}'[削除前に項目ごとに確認]' \
            '(1)--all[すべてのプロジェクトの状態を消去（パスとは併用不可）]' \
            '(-h --help)'{-h,--help}'[コマンドのヘルプを表示]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[整形された指摘の代わりに生のbugs.jsonペイロードを出力]' \
    '--timeout[レビュー完了を待つ最大分数（デフォルト：45）]:minutes:' \
    '(--no-post)--post[完了したレビューの指摘をあなたとしてPRに投稿（PR対象のみ。レビューではなく通常コメント1件）]' \
    '(--post)--no-post[指摘をPRに投稿しない（デフォルト）]' \
    '(-h --help)'{-h,--help}'[コマンドのヘルプを表示]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[実行中のバックグラウンドセッションをすべて再起動]' \
    '(-h --help)'{-h,--help}'[コマンドのヘルプを表示]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[worktreeの未プッシュコミットと未コミット変更も破棄（前回のclaude rmが表示したcommit@worktree-idを渡す）]:commit@worktree-id:' \
    '--force-remove-worktree[WorktreeRemoveフックやgitが削除できなくてもworktreeディレクトリを削除（前回のclaude rmが表示したworktree-idを渡す）]:worktree-id:' \
    '(-h --help)'{-h,--help}'[コマンドのヘルプを表示]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[何も書き込まずに取り込み対象を表示]' \
    '--yes[対話的な選択をスキップ（ヘッドレス環境では/importプレビューの--yes=<digest>を渡す）]' \
    '(-h --help)'{-h,--help}'[コマンドのヘルプを表示]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
