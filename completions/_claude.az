#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session by the name it was given (/rename or --name),
        # else by the first thing you typed in it. A name is appended near the
        # end of the transcript and the first message sits at the start, so
        # only those ends are read - these files grow into the megabytes.
        summary=$(tail -c 100000 "$session_file" 2>/dev/null | \
          grep -o '"customTitle":"[^"]*"' 2>/dev/null | tail -1 | \
          sed 's/^"customTitle":"//; s/"$//')
        if [[ -z $summary ]]; then
          summary=$(head -c 200000 "$session_file" 2>/dev/null | \
            grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
            sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        fi
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:MCP serverlərini konfiqurasiya et və idarə et'
    'plugin:Claude Code əlavələrini idarə et'
    'agents:Fon agentlərini idarə et'
    'attach:Fon sessiyasını bu terminalda aç'
    'logs:Fon sessiyasının son terminal çıxışını çap et'
    'stop:Fon sessiyasını dayandır (söhbəti saxlanılır)'
    'respawn:Fon sessiyasını cari Claude Code versiyası ilə işləməsi üçün yenidən başlat'
    'rm:Fon sessiyasını, təhlükəsiz olduqda isə onun worktree-sini də sil'
    'auth:Autentifikasiyanı idarə et'
    'auto-mode:Avtomatik rejim təsnifatçısı konfiqurasiyasını yoxla və ya sıfırla'
    'gateway:Enterprise autentifikasiya/telemetriya şlüzünü işə sal'
    'import:Başqa AI kodlaşdırma agentindən konfiqurasiyanı Claude Code-a idxal et'
    'project:Claude Code layihə vəziyyətini idarə et'
    'ultrareview:Bulud əsaslı çoxagentli kod nəzərdən keçirməsini işə sal və nəticələri çap et'
    'setup-token:Uzunmüddətli autentifikasiya tokeni qur (Claude abunəliyi tələb olunur)'
    'doctor:Claude Code avtomatik yeniləyici üçün sağlamlıq yoxlaması'
    'update:Yeniləmələri yoxla və quraşdır'
    'install:Claude Code native qurulmasını quraşdır'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Kateqoriya filtrasiyası ilə debug rejimini aktivləşdir (məsələn, "api,hooks" və ya "!statsig,!file")]:filter:'
    '--verbose[Konfiqurasiya faylından verbose rejim parametrini ləğv et]'
    '(-p --print)'{-p,--print}'[Cavabı çap et və çıx (pipe-lar ilə istifadə üçün). Qeyd: yalnız etibarlı qovluqlarda istifadə edin]'
    '--output-format[Çıxış formatı (--print ilə): "text" (standart), "json" (tək nəticə), və ya "stream-json" (real vaxt axını)]:format:(text json stream-json)'
    '--json-schema[Strukturlaşdırılmış çıxış yoxlaması üçün JSON sxemi]:schema:'
    '--include-partial-messages[Gələn qismən mesaj fraqmentlərini daxil et (--print və --output-format=stream-json ilə)]'
    '--input-format[Giriş formatı (--print ilə): "text" (standart) və ya "stream-json" (real vaxt axını girişi)]:format:(text stream-json)'
    '--mcp-debug[\[Köhnəlmiş. Əvəzinə --debug istifadə edin\] MCP debug rejimini aktivləşdir (MCP server xətalarını göstərir)]'
    '--dangerously-skip-permissions[Bütün icazə yoxlamalarını keç. Yalnız internetə çıxışı olmayan sandbox mühitlər üçün tövsiyə olunur]'
    '--allow-dangerously-skip-permissions[İcazə yoxlamalarını keçmə seçimini standart olaraq aktivləşdirmədən aktivləşdir]'
    '--restricted[Məhdud rejim: əmr və ya kod işə salan alətləri və WebFetch-i çıxar, user/project/local parametrlərini nəzərə alma və fayl alətlərini iş qovluqları ilə məhdudlaşdır]'
    '--max-budget-usd[API çağırışlarına xərclənəcək maksimum dollar məbləği (yalnız --print)]:amount:'
    '--replay-user-messages[Təsdiq üçün stdin-dən stdout-a istifadəçi mesajlarını yenidən göndər]'
    '--allowed-tools[Vergül və ya boşluqla ayrılmış icazə verilən alət adları siyahısı (məsələn, "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Vergül və ya boşluqla ayrılmış icazə verilən alət adları siyahısı (camelCase formatı)]:tools:'
    '--tools[Daxili dəstdən mövcud alətlərin siyahısını təyin et. Yalnız print rejimi]:tools:'
    '--disallowed-tools[Vergül və ya boşluqla ayrılmış qadağan edilmiş alət adları siyahısı (məsələn, "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Vergül və ya boşluqla ayrılmış qadağan edilmiş alət adları siyahısı (camelCase formatı)]:tools:'
    '--mcp-config[JSON faylından və ya sətirdən MCP serverlərini yüklə (boşluqla ayrılmış)]:configs:'
    '--system-prompt[Sessiya üçün sistem promptu]:prompt:'
    '--system-prompt-file[Sistem promptunu fayldan oxu]:file:_files'
    '--append-system-prompt[Standart sistem promptuna sistem promptu əlavə et]:prompt:'
    '--append-system-prompt-file[Sistem promptunu fayldan oxu və standart sistem promptuna əlavə et]:file:_files'
    '--system-prompt-snapshot[Sistem promptunu hər söhbət üçün bir dəfə qeyd et və hər sorğuda və davam etmədə hərfi-hərfinə təkrar istifadə et (on, standart) və ya hər sorğuda yenidən yarat (off)]:mode:(on off)'
    '--permission-mode[Sessiya üçün icazə rejimi]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[--print ilə icazə sorğularını kim cavablandırır: "host" (SDK hostu və ya --permission-prompt-tool) və ya "none" (sorğu tələb edəcək hər şey rədd edilir)]:target:(host none)'
    '--permission-prompt-tool[İcazə sorğuları üçün istifadə ediləcək MCP aləti (yalnız --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Ən son söhbəti davam et]'
    '(-r --resume)'{-r,--resume}'[Söhbətə davam et - sessiya ID-ni təyin et və ya interaktiv seç]:sessionId:_claude_sessions'
    '--fork-session[Davam edərkən orijinal sessiya ID-ni yenidən istifadə etmək əvəzinə yeni sessiya ID yarat (--resume və ya --continue ilə)]'
    '--no-session-persistence[Sessiya davamlılığını deaktiv et - sessiyalar saxlanılmayacaq (yalnız --print)]'
    '--model[Cari sessiya üçün model. Ən son model üçün təxəllüs təyin edin (məsələn, '\''sonnet'\'' və ya '\''opus'\'')]:model:_claude_model_names'
    '--agent[Cari sessiya üçün agent. '\''agent'\'' parametrini ləğv edir]:agent:_claude_agent_names'
    '--betas[API sorğularına daxil ediləcək beta başlıqları (yalnız API açarı istifadəçiləri)]:betas:'
    '--fallback-model[Standart model yüklənmiş olduqda təyin edilmiş modelə avtomatik keçidi aktivləşdir (yalnız --print)]:model:_claude_model_names'
    '--settings[Əlavə parametrləri yükləmək üçün parametrlər JSON faylı və ya JSON sətri yolu]:file-or-json:_files'
    '--add-dir[Alət girişinə icazə vermək üçün əlavə qovluqlar]:directories:_directories'
    '--ide[Başlanğıcda dəqiq bir etibarlı IDE mövcud olduqda avtomatik IDE-yə qoşul]'
    '--desktop[Terminal əvəzinə Claude Desktop tətbiqində aç (sessiyanı seçmək üçün --continue və ya --resume <id> ilə)]'
    '--strict-mcp-config[Yalnız --mcp-config-dən MCP serverlərini istifadə et və digər MCP parametrlərini nəzərə alma]'
    '--session-id[Söhbət üçün xüsusi sessiya ID (etibarlı UUID olmalıdır)]:uuid:'
    '--agents[Fərdi agentləri təyin edən JSON obyekti]:json:'
    '--setting-sources[Yükləmək üçün vergüllə ayrılmış parametr mənbələri siyahısı (user, project, local)]:sources:'
    '--plugin-dir[Yalnız bu sessiya üçün əlavələri yükləmək üçün qovluq (təkrarlana bilər)]:paths:_directories'
    '--disable-slash-commands[Bütün slash əmrlərini deaktiv et]'
    '(--bg --background)'{--bg,--background}'[Sessiyanı fon agenti kimi başlat və dərhal geri qayıt]'
    '(-w --worktree)'{-w,--worktree}'[Bu sessiya üçün yeni git worktree yarat (istəyə görə ad təyin edin)]::name:'
    '--tmux=-[Worktree üçün tmux sessiyası yarat (--worktree tələb edir). Mövcud olduqda iTerm2 native panellərindən istifadə edir; ənənəvi tmux üçün --tmux=classic]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Bu sessiya üçün göstərilən ad təyin et]:name:'
    '--effort[Cari sessiya üçün səy səviyyəsi]:level:(low medium high xhigh max)'
    '--autocompact[Avtomatik sıxlaşdırma pəncərəsinin ölçüsü (auto və ya 100k-1M token)]:size:(auto)'
    '--debug-file[Debug loglarını xüsusi fayl yoluna yaz (debug rejimini dolayısı ilə aktivləşdirir)]:path:_files'
    '--from-pr[Nömrə/URL ilə PR-a bağlı sessiyaya davam et, və ya interaktiv seçici aç]::value:'
    '--teleport[Teleport sessiyasına davam et, istəyə görə sessiya ID təyin et]::session:'
    '--cloud[Verilmiş təsvirlə bulud sessiyası yarat və ya sessiya ID ya da claude.ai/code URL ilə mövcud sessiyaya qoşul]::description-or-session:'
    '--environment[Verilmiş öz-hostlu mühitdə (ccpool_...) işləyən yeni bulud sessiyası yarat]:environment_id:'
    '--remote-control[Remote Control aktiv edilmiş interaktiv sessiya başlat (istəyə görə adlandırılmış)]::name:'
    '--remote-control-session-name-prefix[Avtomatik yaradılan Remote Control sessiya adları üçün prefiks]:prefix:'
    '--chrome[Chrome-da Claude inteqrasiyasını aktivləşdir]'
    '--no-chrome[Chrome-da Claude inteqrasiyasını deaktiv et]'
    '--plugin-url[Yalnız bu sessiya üçün URL-dən plugin .zip yüklə (təkrarlana bilər)]:url:'
    '--file[Başlanğıcda yüklənəcək fayl resursları (format: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Prompt təkliflərini aktivləşdir (print/SDK rejimində proqnozlaşdırılan növbəti promptu yayır)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Subagent mətnini və düşüncə bloklarını mesaj kimi ötür (--print və stream-json ilə)]'
    '--include-hook-events[Bütün hook həyat dövrü hadisələrini çıxış axınına daxil et (stream-json ilə)]'
    '--exclude-dynamic-system-prompt-sections[Prompt-keş təkrar istifadəsini yaxşılaşdırmaq üçün maşına xas bölmələri ilk istifadəçi mesajına köçür]'
    '--brief[Agent-istifadəçi ünsiyyəti üçün SendUserMessage alətini aktivləşdir]'
    '--safe-mode[Bütün fərdiləşdirmələr deaktiv edilmiş halda başlat (pozulmuş konfiqurasiyanın aradan qaldırılması üçün faydalıdır)]'
    '--bare[Minimal rejim: hook-lar, LSP, plugin sinxronizasiyası, atribusiya, avtomatik yaddaş və CLAUDE.md avtomatik aşkarlanmasını keç]'
    '--ax-screen-reader[Ekran oxuyucusuna uyğun çıxış göstər (düz mətn, dekorativ sərhədlər və ya animasiyalar olmadan)]'
    '(-v --version)'{-v,--version}'[Versiya nömrəsini göstər]'
    '(-h --help)'{-h,--help}'[Əmr üçün kömək göstər]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude commands' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Əmr üçün kömək göstər]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "arqument yoxdur"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Claude Code MCP serverini başlat'
    'add:Claude Code-a MCP serveri əlavə et'
    'remove:MCP serverini sil'
    'list:Konfiqurasiya edilmiş MCP serverlərinin siyahısı'
    'get:MCP server təfərrüatlarını əldə et'
    'add-json:JSON sətri ilə MCP serveri əlavə et (stdio və ya SSE)'
    'add-from-claude-desktop:Claude Desktop-dan MCP serverlərini idxal et (yalnız Mac və WSL)'
    'reset-project-choices:Bu layihədə bütün təsdiq edilmiş/rədd edilmiş layihə səviyyəli (.mcp.json) serverləri sıfırla'
    'login:MCP serveri ilə autentifikasiya et (HTTP, SSE, və ya claude.ai konnektoru)'
    'logout:MCP serveri üçün saxlanılmış OAuth kimlik məlumatlarını təmizlə'
    'help:Kömək göstər'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Kömək göstər]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp commands' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Debug rejimini aktivləşdir]' \
            '--verbose[Konfiqurasiya faylından verbose rejim parametrini ləğv et]' \
            '(-h --help)'{-h,--help}'[Kömək göstər]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfiqurasiya əhatəsi (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Nəqliyyat növü (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Mühit dəyişənini təyin et (məsələn, -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[WebSocket başlığını təyin et]:header:' \
            '--client-id[HTTP/SSE serverləri üçün OAuth müştəri ID]:clientId:' \
            '--client-secret[OAuth müştəri sirrini soruş (və ya MCP_CLIENT_SECRET mühit dəyişənini təyin et)]' \
            '--callback-port[OAuth callback üçün sabit port (əvvəlcədən qeydiyyatdan keçmiş yönləndirmə URI-ləri tələb edən serverlər üçün)]:port:' \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfiqurasiya əhatəsi (local, user, project) - təyin edilməzsə mövcud əhatədən sil]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Kömək göstər]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfiqurasiya əhatəsi (local, user, project)]:scope:(local user project)' \
            '--client-secret[OAuth müştəri sirrini soruş (və ya MCP_CLIENT_SECRET mühit dəyişənini təyin et)]' \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfiqurasiya əhatəsi (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Kömək göstər]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Kömək göstər]'
          ;;
        login)
          _arguments \
            '--no-browser[Brauzer açmaq əvəzinə avtorizasiya URL-ni çap et (SSH/headless sessiyalar üçün)]' \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Əlavə və ya marketplace manifestini yoxla'
    'marketplace:Claude Code marketplace-lərini idarə et'
    'list:Quraşdırılmış əlavələrin siyahısı'
    'details:Əlavə üçün komponent inventarını və proqnozlaşdırılan token dəyərini göstər'
    'configure:Əlavənin seçimlərini və hansılarının təyin edilmədiyini göstər, və ya dəyərləri stdin-dən saxla'
    'install:Mövcud marketplace-lərdən əlavə quraşdır'
    'i:Mövcud marketplace-lərdən əlavə quraşdır (install üçün qısa)'
    'init:Yeni əlavə skeleti yarat (növbəti sessiyada avtomatik yüklənir)'
    'new:Yeni əlavə skeleti yarat (init üçün təxəllüs)'
    'uninstall:Quraşdırılmış əlavəni sil'
    'remove:Quraşdırılmış əlavəni sil (uninstall üçün təxəllüs)'
    'enable:Deaktiv əlavəni aktivləşdir'
    'disable:Aktiv əlavəni deaktivləşdir'
    'update:Əlavəni ən son versiyaya yenilə'
    'eval:Əlavəyə qarşı eval hallarını işə sal və qiymətləndirilmiş nəticələri bildir'
    'prune:Artıq lazım olmayan avtomatik quraşdırılmış asılılıqları sil'
    'autoremove:Artıq lazım olmayan avtomatik quraşdırılmış asılılıqları sil (prune üçün təxəllüs)'
    'tag:Əlavə buraxılışı üçün {name}--v{version} git etiketi yarat'
    'test:Modun testlərini işə sal'
    'help:Kömək göstər'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Kömək göstər]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin commands' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Xəbərdarlıqları xəta kimi qəbul et (çıxış kodu 1)]' \
            '--json[Yoxlama hesabatını JSON kimi çıxar (eyni çıxış kodları)]' \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Quraşdırma əhatəsi]:scope:(user project local)' \
            '*--config[Əlavə manifestində elan edilmiş userConfig seçimini təyin et (təkrarlana bilər)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Göstərilən, marketplace tərəfindən elan edilmiş əmri təsdiq sorğusu olmadan qəbul et]' \
            '--json[İnsan üçün mesaj əvəzinə maşın tərəfindən oxuna bilən bir nəticə sətri çap et]' \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Quraşdırma əhatəsi]:scope:(user project local)' \
            '--keep-data[Əlavənin daimi məlumat qovluğunu saxla]' \
            '--prune[Artıq lazım olmayan avtomatik quraşdırılmış asılılıqları da sil]' \
            '(-y --yes)'{-y,--yes}'[--prune təsdiq sorğusunu keç]' \
            '--json[İnsan üçün mesaj əvəzinə maşın tərəfindən oxuna bilən bir nəticə sətri çap et (--prune ilə deyil)]' \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Quraşdırma əhatəsi]:scope:(user project local)' \
            '--json[İnsan üçün mesaj əvəzinə maşın tərəfindən oxuna bilən bir nəticə sətri çap et]' \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Bütün aktiv əlavələri deaktivləşdir]' \
            '(-s --scope)'{-s,--scope}'[Quraşdırma əhatəsi]:scope:(user project local)' \
            '--json[İnsan üçün mesaj əvəzinə maşın tərəfindən oxuna bilən bir nəticə sətri çap et]' \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Quraşdırma əhatəsi]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Göstərilən, marketplace tərəfindən elan edilmiş əmri təsdiq sorğusu olmadan qəbul et]' \
            '--json[İnsan üçün mesaj əvəzinə maşın tərəfindən oxuna bilən bir nəticə sətri çap et]' \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[JSON kimi çıxar]' \
            '--available[Marketplace-lərdən mövcud əlavələri daxil et (--json tələb edir)]' \
            '(-h --help)'{-h,--help}'[Kömək göstər]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Göstərilən əhatədə təmizlə]:scope:(user project local)' \
            '--dry-run[Silmədən nəyin silinəcəyini siyahıla]' \
            '(-y --yes)'{-y,--yes}'[Təsdiq sorğusunu keç]' \
            '(-h --help)'{-h,--help}'[Kömək göstər]'
          ;;
        configure)
          _arguments \
            '--json[JSON kimi çıxar]' \
            '--values-stdin[Seçim dəyərlərini stdin-dən birsətirli mətn dəyərlərindən ibarət JSON obyekti kimi oxu; daxil edilməyən seçimlər öz dəyərlərini saxlayır]' \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Manifest təsviri]:text:' \
            '--author[Müəllif adı (standart: git config user.name)]:name:' \
            '--author-email[Müəllif e-poçtu (standart: git config user.email)]:email:' \
            '--with[Skeleti də yaradılacaq komponentlər]:components:' \
            '(-f --force)'{-f,--force}'[Hədəfdə mövcud .claude-plugin/ qovluğunun üzərinə yaz]' \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Halları ad glob-u ilə filtrlə]:glob:' \
            '*--tag[Halları teqə görə filtrlə (təkrarlana bilər)]:tag:' \
            '--runs[Hər hal üçün icra sayını ləğv et (standart: case.runs, əks halda 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Eyni anda n-ə qədər agent icrası işə sal (1-8; standart 1)]:n:' \
            '--model[Bütün hallar üçün modeli ləğv et]:model:_claude_model_names' \
            '--judge-model[LLM qiymətləndirici modelini ləğv et (standart: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Sərt xərc həddi; çatıldıqda dayandır və qismən nəticələri bildir (çıxış kodu 2)]:usd:' \
            '--output-dir[aggregate-result.json üçün qovluq]:dir:_directories' \
            '--eval-dir[Eval hallarını saxlayan qovluğun adı (əlavənin altında)]:dir:' \
            '--json[Tam icra nəticəsini JSON kimi stdout-a çap et və ya bu .json faylına yaz]::path:_files' \
            '--threshold[Hər hansı halın balı bu həddən aşağı olarsa, 1 çıxış kodu ilə çıx (standart: 1.0)]:threshold:' \
            '*--allow-tools[Məhdudlaşdırılmış alətlər üçün operator icazəsi (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Hər halın scaffold_script-ini işə sal (müəllifin verdiyi bash-ı sizin adınızdan işə salır; standart olaraq söndürülüb)]' \
            '(--scaffold)--no-scaffold[scaffold_script-i açıq şəkildə keç]' \
            '--trust-plugin[Bu əlavəyə və onun eval dəstinə etibar etdiyinizi təsdiqlə, ilk işə salmada etibar sorğusunu keç (CI üçün)]' \
            '--ablation[Əlavəsiz baza müqayisə qrupunu işə sal və bal fərqini bildir]:mode:(none with-without)' \
            '--mocks[MCP serverləri üçün mock əvəzləyicilər, <eval dir>/mocks/ qovluğundan]:mode:(record off)' \
            '--allow-real-servers[--mocks record ilə: mock-u olmayan real MCP server proseslərini də başlat]' \
            '--keep-temp[Debug üçün skelet qovluqlarını saxla]' \
            '--verbose[Hər mesaj üçün izləmə hadisələrini debug loguna yaz]' \
            '--report[Müstəqil HTML hesabatını nəticələr qovluğu əvəzinə bu yola yaz]:path:_files' \
            '(--no-publish)--publish-report[Hesabatın claude.ai-da dərc edilməsini də tələb et]' \
            '(--publish-report)--no-publish[HTML hesabatını yalnız lokal saxla; claude.ai-da dərc etməni keç]' \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Etiketi yaratdıqdan sonra --remote-a push et]' \
            '--dry-run[Etiket yaratmadan nəyin etiketlənəcəyini çap et]' \
            '(-f --force)'{-f,--force}'[Təmiz olmayan iş ağacı və artıq mövcud etiket yoxlamalarını keç]' \
            '(-m --message)'{-m,--message}'[Etiket annotasiya mesajı (versiya üçün %s istifadə edin)]:msg:' \
            '--remote[--push ilə push ediləcək remote]:name:' \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:URL, yol və ya GitHub deposundan marketplace əlavə et'
    'list:Konfiqurasiya edilmiş marketplace-lərin siyahısı'
    'remove:Konfiqurasiya edilmiş marketplace-i sil'
    'rm:Konfiqurasiya edilmiş marketplace-i sil (remove üçün təxəllüs)'
    'update:Mənbədən marketplace-i yenilə - ad təyin edilməzsə hamısını yenilə'
    'help:Kömək göstər'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Kömək göstər]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace commands' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Checkout-u git sparse-checkout vasitəsilə müəyyən qovluqlarla məhdudlaşdır (monorepolar üçün)]:paths:' \
            '--scope[Marketplace-in harada elan ediləcəyi]:scope:(user project local)' \
            '--claudeai[claude.ai-ın sizin üçün host etdiyi bu adlı marketplace-i əlavə et]' \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[JSON kimi çıxar]' \
            '(-h --help)'{-h,--help}'[Kömək göstər]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Marketplace elanını müəyyən parametrlər əhatəsindən sil (bütün əhatələrdən silmək üçün göstərməyin)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Kömək göstər]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Artıq quraşdırılmış olsa belə məcburi quraşdır]' \
    '(-h --help)'{-h,--help}'[Kömək göstər]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Göndərilən sessiyalarda alət girişinə icazə vermək üçün əlavə qovluq]:directory:_directories' \
    '--agent[Agent görünüşündən göndərilən sessiyalar üçün standart agent]:agent:_claude_agent_names' \
    '--all[--json ilə: tamamlanmış fon sessiyalarını da daxil et]' \
    '--allow-dangerously-skip-permissions[bypass-permissions rejimini göndərilən sessiyalar üçün əlçatan et]' \
    '--cwd[Yalnız yol altında başladılmış fon sessiyalarını göstər]:path:_directories' \
    '--dangerously-skip-permissions[--permission-mode bypassPermissions üçün təxəllüs]' \
    '--effort[Göndərilən sessiyalar üçün standart səy səviyyəsi]:level:(low medium high xhigh max)' \
    '--json[Aktiv sessiyaları JSON massivi kimi çap et və çıx]' \
    '*--mcp-config[Göndərilən sessiyalara tətbiq ediləcək MCP server konfiqurasiyası]:config:' \
    '--model[Agent görünüşündən göndərilən sessiyalar üçün standart model]:model:_claude_model_names' \
    '--permission-mode[Göndərilən sessiyalar üçün standart icazə rejimi]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Agent görünüşü və göndərilən sessiyalar üçün qovluqdan əlavələr yüklə]:path:_directories' \
    '--setting-sources[Yükləmək üçün vergüllə ayrılmış parametr mənbələri siyahısı (user, project, local)]:sources:' \
    '--settings[Tətbiq ediləcək parametrlər faylı və ya JSON sətri]:file-or-json:_files' \
    '--strict-mcp-config[Göndərilən sessiyalarda yalnız --mcp-config-dən MCP serverlərini istifadə et]' \
    '--restricted[Göndərilən sessiyaları məhdud rejimdə başlat]' \
    '(-h --help)'{-h,--help}'[Əmr üçün kömək göstər]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Anthropic hesabınıza daxil olun'
    'logout:Anthropic hesabınızdan çıxın'
    'status:Autentifikasiya vəziyyətini göstər'
    'help:Kömək göstər'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Əmr üçün kömək göstər]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth commands' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Giriş səhifəsində e-poçt ünvanını əvvəlcədən doldur]:email:' \
            '--sso[SSO giriş axınını məcburi et]' \
            '(--claudeai)--console[Claude abunəliyi əvəzinə Anthropic Console istifadə et (API istifadəsinə görə ödəniş)]' \
            '(--console)--claudeai[Claude abunəliyindən istifadə et (standart)]' \
            '(-h --help)'{-h,--help}'[Əmr üçün kömək göstər]'
          ;;
        status)
          _arguments \
            '(--text)--json[JSON kimi çıxar (standart)]' \
            '(--json)--text[İnsan tərəfindən oxuna bilən mətn kimi çıxar]' \
            '(-h --help)'{-h,--help}'[Əmr üçün kömək göstər]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Əmr üçün kömək göstər]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Effektiv avtomatik rejim konfiqurasiyasını JSON kimi çap et'
    'critique:Fərdi avtomatik rejim qaydalarınız üçün AI rəyi alın'
    'defaults:Standart avtomatik rejim qaydalarını JSON kimi çap et'
    'reset:Avtomatik rejim konfiqurasiyasını gələn standartlara sıfırla'
    'help:Kömək göstər'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Əmr üçün kömək göstər]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode commands' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[İstifadə olunan modeli ləğv et]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Əmr üçün kömək göstər]'
          ;;
        defaults)
          _arguments \
            '--label[Yalnız etiketi bu prefikslə başlayan qaydaları göstər (böyük/kiçik hərfə həssas deyil)]:prefix:' \
            '(-h --help)'{-h,--help}'[Əmr üçün kömək göstər]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Təsdiq sorğusunu keç]' \
            '(-h --help)'{-h,--help}'[Əmr üçün kömək göstər]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Əmr üçün kömək göstər]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Şlüz YAML konfiqurasiyasına yol]:path:_files' \
    '(-h --help)'{-h,--help}'[Əmr üçün kömək göstər]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Layihə üçün bütün Claude Code vəziyyətini sil (transkriptlər, tapşırıqlar, fayl tarixçəsi, konfiqurasiya qeydi)'
    'help:Kömək göstər'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Əmr üçün kömək göstər]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project commands' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Heç nə silmədən nəyin silinəcəyini siyahıla]' \
            '(-y --yes)'{-y,--yes}'[Təsdiq sorğusunu keç]' \
            '(-i --interactive)'{-i,--interactive}'[Silməzdən əvvəl hər element üçün soruş]' \
            '(1)--all[Bütün layihələr üçün vəziyyəti sil (yol ilə birlikdə istifadə edilə bilməz)]' \
            '(-h --help)'{-h,--help}'[Əmr üçün kömək göstər]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Formatlanmış nəticələr əvəzinə xam bugs.json yükünü çap et]' \
    '--timeout[Nəzərdən keçirmənin bitməsini gözləmək üçün maksimum dəqiqə (standart: 45)]:minutes:' \
    '(--no-post)--post[Tamamlanmış nəzərdən keçirmə nəticələrini PR-a sizin adınızdan göndər (yalnız PR hədəfləri; review deyil, bir sadə şərh)]' \
    '(--post)--no-post[Nəticələri PR-a göndərmə (standart)]' \
    '(-h --help)'{-h,--help}'[Əmr üçün kömək göstər]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[İşləyən bütün fon sessiyalarını yenidən başlat]' \
    '(-h --help)'{-h,--help}'[Əmr üçün kömək göstər]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Worktree-nin push edilməmiş commit-lərini və commit edilməmiş dəyişikliklərini də ləğv et (əvvəlki claude rm-in bildirdiyi commit@worktree-id-ni ötür)]:commit@worktree-id:' \
    '--force-remove-worktree[WorktreeRemove hook-u və ya git onu silə bilməsə belə worktree qovluğunu sil (əvvəlki claude rm-in bildirdiyi worktree-id-ni ötür)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Əmr üçün kömək göstər]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Heç nə yazmadan nəyin idxal ediləcəyini göstər]' \
    '--yes[İnteraktiv seçicini keç (headless mühitlərdə /import önizləməsindən --yes=<digest> ötür)]' \
    '(-h --help)'{-h,--help}'[Əmr üçün kömək göstər]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
