#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Konfigureeri ja halda MCP servereid'
    'plugin:Halda Claude Code pluginaid'
    'agents:Halda taustaagente'
    'attach:Ava taustsessioon selles terminalis'
    'logs:Prindi taustsessiooni hiljutine terminaliväljund'
    'stop:Peata taustsessioon (selle vestlus säilitatakse)'
    'respawn:Taaskäivita taustsessioon, et see kasutaks Claude Code praegust versiooni'
    'rm:Kustuta taustsessioon ja selle worktree, kui see on ohutu'
    'auth:Halda autentimist'
    'auto-mode:Kontrolli või lähtesta automaatrežiimi klassifikaatori konfiguratsioon'
    'gateway:Käivita ettevõtte autentimise/telemeetria lüüs'
    'import:Impordi konfiguratsioon teisest AI kodeerimisagendist Claude Code-i'
    'project:Halda Claude Code projekti olekut'
    'ultrareview:Käivita pilves majutatud mitmeagendiline koodiülevaatus ja prindi leiud'
    'setup-token:Seadista pikaajaline autentimismärk (nõuab Claude tellingut)'
    'doctor:Kontrolli Claude Code automaatse uuendamise süsteemi tervist'
    'update:Kontrolli ja installi uuendused'
    'install:Installi Claude Code natiivne versioon'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Lülita sisse silumisrežiim valikulise kategooriate filtreerimisega (nt "api,hooks" või "!statsig,!file")]:filter:'
    '--verbose[Kirjuta üle üksikasjaliku režiimi seade konfiguratsioonifailist]'
    '(-p --print)'{-p,--print}'[Prindi vastus ja välju (kasutamiseks pipe-ga). Märkus: kasuta ainult usaldusväärsetes kataloogides]'
    '--output-format[Väljundi formaat (koos --print): "text" (vaikimisi), "json" (üks tulemus), või "stream-json" (voogedastus reaalajas)]:format:(text json stream-json)'
    '--json-schema[JSON skeem struktureeritud väljundi valideerimiseks]:schema:'
    '--include-partial-messages[Kaasa osalised sõnumifragmendid nende saabudes (koos --print ja --output-format=stream-json)]'
    '--input-format[Sisendi formaat (koos --print): "text" (vaikimisi) või "stream-json" (voogedastatud sisend reaalajas)]:format:(text stream-json)'
    '--mcp-debug[\[Aegunud. Kasuta selle asemel --debug\] Lülita sisse MCP silumisrežiim (näitab MCP serveri vigu)]'
    '--dangerously-skip-permissions[Mööduge kõigist loarekontrollidest. Soovitatav ainult liivakastidele ilma internetiühenduseta]'
    '--allow-dangerously-skip-permissions[Võimalda loarekontrollide möödumise valik ilma vaikimisi lubamiseta]'
    '--restricted[Piiratud režiim: eemalda käske või koodi käivitavad tööriistad ja WebFetch, ignoreeri user/project/local seadeid ning piira failitööriistad töökataloogidega]'
    '--max-budget-usd[Maksimaalne dollarisumma API-kutsetele kulutamiseks (ainult --print)]:amount:'
    '--replay-user-messages[Saada kasutaja sõnumid uuesti stdin-ist stdout-i kinnitamiseks]'
    '--allowed-tools[Lubatud tööriistanimed komadega või tühikutega eraldatuna (nt "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Lubatud tööriistanimed komadega või tühikutega eraldatuna (camelCase formaat)]:tools:'
    '--tools[Määra saadaolevate tööriistade loend sisseehitatud komplektist. Ainult print režiimis]:tools:'
    '--disallowed-tools[Keelatud tööriistanimed komadega või tühikutega eraldatuna (nt "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Keelatud tööriistanimed komadega või tühikutega eraldatuna (camelCase formaat)]:tools:'
    '--mcp-config[Laadi MCP serverid JSON failist või stringist (tühikutega eraldatud)]:configs:'
    '--system-prompt[Süsteemipäring sessioonis kasutamiseks]:prompt:'
    '--system-prompt-file[Loe süsteemipäring failist]:file:_files'
    '--append-system-prompt[Lisa süsteemipäring vaikimisi süsteemipäringule]:prompt:'
    '--append-system-prompt-file[Loe süsteemipäring failist ja lisa see vaikimisi süsteemipäringule]:file:_files'
    '--system-prompt-snapshot[Salvesta süsteemipäring üks kord vestluse kohta ja taaskasuta seda sõna-sõnalt igas päringus ja jätkamisel (on, vaikimisi) või koosta see igas päringus uuesti (off)]:mode:(on off)'
    '--permission-mode[Loarežiim sessioonis kasutamiseks]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Kes vastab loaküsimustele koos --print: "host" (SDK host või --permission-prompt-tool) või "none" (kõik, mis vajaks küsimist, keelatakse)]:target:(host none)'
    '--permission-prompt-tool[MCP tööriist loaküsimuste jaoks (ainult --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Jätka viimasest vestlusest]'
    '(-r --resume)'{-r,--resume}'[Jätka vestlust - määra sessiooni identifikaator või vali interaktiivselt]:sessionId:_claude_sessions'
    '--fork-session[Loo uus sessiooni identifikaator jätkamisel originaali taaskasutamise asemel (koos --resume või --continue)]'
    '--no-session-persistence[Keela sessiooni püsivus - sessioone ei salvestata (ainult --print)]'
    '--model[Mudel praeguseks sessiooniks. Määra hüüdnimi uusimale mudelile (nt '\''sonnet'\'' või '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agent praeguseks sessiooniks. Kirjutab üle '\''agent'\'' seade]:agent:_claude_agent_names'
    '--betas[Beeta päised API päringutesse kaasamiseks (ainult API võtme kasutajad)]:betas:'
    '--fallback-model[Võimalda automaatne üleminek määratud mudelile, kui vaikemudel on ülekoormatud (ainult --print)]:model:_claude_model_names'
    '--settings[Tee JSON seadete failini või JSON string lisaseadete laadimiseks]:file-or-json:_files'
    '--add-dir[Lisaks kataloogid tööriistadele juurdepääsu võimaldamiseks]:directories:_directories'
    '--ide[Ühenda käivitamisel automaatselt IDE-ga, kui saadaval on täpselt üks kehtiv IDE]'
    '--desktop[Ava terminali asemel Claude Desktop rakenduses (sessiooni valimiseks koos --continue või --resume <id>)]'
    '--strict-mcp-config[Kasuta ainult MCP servereid --mcp-config-ist ja ignoreeri kõiki teisi MCP seadeid]'
    '--session-id[Konkreetne sessiooni identifikaator vestluses kasutamiseks (peab olema kehtiv UUID)]:uuid:'
    '--agents[JSON objekt, mis määratleb kohandatud agendid]:json:'
    '--setting-sources[Seadete allikate loend komadega eraldatuna laadimiseks (user, project, local)]:sources:'
    '--plugin-dir[Kataloog pluginate laadimiseks ainult selle sessiooni jaoks (võib korda korda)]:paths:_directories'
    '--disable-slash-commands[Keela kõik kaldkriipsukäsud]'
    '(--bg --background)'{--bg,--background}'[Käivita sessioon taustaagendina ja naase kohe]'
    '(-w --worktree)'{-w,--worktree}'[Loo selle sessiooni jaoks uus git worktree (valikuliselt määra nimi)]::name:'
    '--tmux=-[Loo worktree jaoks tmux sessioon (nõuab --worktree). Kasutab võimalusel iTerm2 natiivseid paane; traditsioonilise tmux-i jaoks --tmux=classic]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Määra selle sessiooni kuvatav nimi]:name:'
    '--effort[Pingutuse tase praeguseks sessiooniks]:level:(low medium high xhigh max)'
    '--autocompact[Automaatse tihendamise akna suurus (auto või 100k-1M tokenit)]:size:(auto)'
    '--debug-file[Kirjuta silumislogid konkreetsesse failiteesse (lubab kaudselt silumisrežiimi)]:path:_files'
    '--from-pr[Jätka PR-iga seotud sessioon numbri/URL-i järgi või ava interaktiivne valija]::value:'
    '--teleport[Jätka teleport-sessiooni, valikuliselt määra sessiooni ID]::session:'
    '--cloud[Loo antud kirjeldusega pilvesessioon või ühendu olemasolevaga sessiooni ID või claude.ai/code URL-i järgi]::description-or-session:'
    '--environment[Loo uus pilvesessioon, mis töötab antud isemajutatud keskkonnas (ccpool_...)]:environment_id:'
    '--remote-control[Käivita interaktiivne sessioon lubatud kaugjuhtimisega (valikuliselt nimega)]::name:'
    '--remote-control-session-name-prefix[Eesliide automaatselt genereeritud kaugjuhtimise sessiooninimedele]:prefix:'
    '--chrome[Luba Claude Chrome'\''i integratsioon]'
    '--no-chrome[Keela Claude Chrome'\''i integratsioon]'
    '--plugin-url[Hangi plugina .zip URL-ist ainult selle sessiooni jaoks (korratav)]:url:'
    '--file[Failiressursid käivitamisel allalaadimiseks (formaat: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Luba päringu soovitused (väljastab prognoositud järgmise päringu print/SDK režiimis)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Edasta alamagendi tekst ja mõtlemisplokid sõnumitena (koos --print ja stream-json)]'
    '--include-hook-events[Kaasa kõik hooki elutsükli sündmused väljundvoogu (koos stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Teisalda masinapõhised sektsioonid esimesse kasutaja sõnumisse, et parandada päringu vahemälu taaskasutust]'
    '--brief[Luba SendUserMessage tööriist agendi-kasutaja suhtluseks]'
    '--safe-mode[Käivita kõigi kohanduste keelatuna (kasulik katkise konfiguratsiooni tõrkeotsinguks)]'
    '--bare[Minimaalne režiim: jäta vahele hookid, LSP, plugina sünkroonimine, omistamine, automaatmälu ja CLAUDE.md automaatavastus]'
    '--ax-screen-reader[Renderda ekraanilugejasõbralik väljund (lameda tekst, ilma dekoratiivsete äärte või animatsioonideta)]'
    '(-v --version)'{-v,--version}'[Väljasta versiooninumber]'
    '(-h --help)'{-h,--help}'[Kuva abi käsule]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude käsud' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Kuva abi käsule]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "argumentideta"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Käivita Claude Code MCP server'
    'add:Lisa MCP server Claude Code-i'
    'remove:Eemalda MCP server'
    'list:Kuva konfigureeritud MCP serverite loend'
    'get:Hangi MCP serveri üksikasjad'
    'add-json:Lisa MCP server (stdio või SSE) JSON stringiga'
    'add-from-claude-desktop:Impordi MCP serverid Claude Desktopist (ainult Mac ja WSL)'
    'reset-project-choices:Lähtesta kõik heaks kiidetud/tagasi lükatud projekti ulatusega (.mcp.json) serverid selles projektis'
    'login:Autendi MCP serveriga (HTTP, SSE või claude.ai konnektor)'
    'logout:Kustuta MCP serveri salvestatud OAuth mandaadid'
    'help:Kuva abi'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Kuva abi]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp käsud' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Lülita sisse silumisrežiim]' \
            '--verbose[Kirjuta üle üksikasjaliku režiimi seade konfiguratsioonifailist]' \
            '(-h --help)'{-h,--help}'[Kuva abi]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfiguratsiooni ulatus (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Transpordi tüüp (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Määra keskkonnamuutuja (nt -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Määra WebSocket päis]:header:' \
            '--client-id[OAuth kliendi ID HTTP/SSE serverite jaoks]:clientId:' \
            '--client-secret[Küsi OAuth kliendi saladust (või määra keskkonnamuutuja MCP_CLIENT_SECRET)]' \
            '--callback-port[Fikseeritud port OAuth tagasikutse jaoks (serveritele, mis nõuavad eelregistreeritud ümbersuunamise URI-sid)]:port:' \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfiguratsiooni ulatus (local, user, project) - eemalda olemasolevast ulatusest, kui määramata]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Kuva abi]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfiguratsiooni ulatus (local, user, project)]:scope:(local user project)' \
            '--client-secret[Küsi OAuth kliendi saladust (või määra keskkonnamuutuja MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfiguratsiooni ulatus (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Kuva abi]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Kuva abi]'
          ;;
        login)
          _arguments \
            '--no-browser[Prindi autoriseerimise URL brauseri avamise asemel (SSH/peata sessioonide jaoks)]' \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Valideeri plugin või turuplatsimanigest'
    'marketplace:Halda Claude Code turuplatse'
    'list:Kuva installitud pluginate loend'
    'details:Näita plugina komponentide loendit ja prognoositud tokenikulu'
    'configure:Näita plugina valikuid ja seda, millised pole määratud, või salvesta väärtused stdin-ist'
    'install:Installi plugin saadaolevatelt turuplatsdelt'
    'i:Installi plugin saadaolevatelt turuplatsdelt (install lühend)'
    'init:Genereeri uue plugina alusstruktuur (laadib automaatselt järgmisel sessioonil)'
    'new:Genereeri uue plugina alusstruktuur (init sünonüüm)'
    'uninstall:Eemalda installitud plugin'
    'remove:Eemalda installitud plugin (uninstall sünonüüm)'
    'enable:Luba keelatud plugin'
    'disable:Keela lubatud plugin'
    'update:Uuenda plugin uusimale versioonile'
    'eval:Käivita plugina hindamisjuhtumid ja raporteeri hinnatud tulemused'
    'prune:Eemalda automaatselt installitud sõltuvused, mida enam ei vajata'
    'autoremove:Eemalda automaatselt installitud sõltuvused, mida enam ei vajata (prune sünonüüm)'
    'tag:Loo plugina väljalaske jaoks {name}--v{version} git silt'
    'test:Käivita modi testid'
    'help:Kuva abi'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Kuva abi]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin käsud' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Käsitle hoiatusi vigadena (väljumiskood 1)]' \
            '--json[Väljasta valideerimisraport JSON-ina (samad väljumiskoodid)]' \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Installimise ulatus]:scope:(user project local)' \
            '*--config[Määra plugina manifestis deklareeritud userConfig valik (korratav)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Nõustu kuvatud turuplatsi deklareeritud käsuga ilma kinnitusküsimuseta]' \
            '--json[Prindi inimloetava sõnumi asemel üks masinloetav tulemusrida]' \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Installimise ulatus]:scope:(user project local)' \
            '--keep-data[Säilita plugina püsiandmete kataloog]' \
            '--prune[Eemalda ka automaatselt installitud sõltuvused, mida enam ei vajata]' \
            '(-y --yes)'{-y,--yes}'[Jäta --prune kinnitusküsimus vahele]' \
            '--json[Prindi inimloetava sõnumi asemel üks masinloetav tulemusrida (mitte koos --prune)]' \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Installimise ulatus]:scope:(user project local)' \
            '--json[Prindi inimloetava sõnumi asemel üks masinloetav tulemusrida]' \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Keela kõik lubatud pluginad]' \
            '(-s --scope)'{-s,--scope}'[Installimise ulatus]:scope:(user project local)' \
            '--json[Prindi inimloetava sõnumi asemel üks masinloetav tulemusrida]' \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Installimise ulatus]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Nõustu kuvatud turuplatsi deklareeritud käsuga ilma kinnitusküsimuseta]' \
            '--json[Prindi inimloetava sõnumi asemel üks masinloetav tulemusrida]' \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Väljasta JSON-ina]' \
            '--available[Kaasa turuplatside saadaolevad pluginad (nõuab --json)]' \
            '(-h --help)'{-h,--help}'[Kuva abi]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Puhasta antud ulatuses]:scope:(user project local)' \
            '--dry-run[Loetle, mis eemaldataks, ilma eemaldamata]' \
            '(-y --yes)'{-y,--yes}'[Jäta kinnitusküsimus vahele]' \
            '(-h --help)'{-h,--help}'[Kuva abi]'
          ;;
        configure)
          _arguments \
            '--json[Väljasta JSON-ina]' \
            '--values-stdin[Loe valikute väärtused stdin-ist üherealiste stringide JSON objektina; välja jäetud valikud säilitavad oma väärtused]' \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Manifesti kirjeldus]:text:' \
            '--author[Autori nimi (vaikimisi: git config user.name)]:name:' \
            '--author-email[Autori e-post (vaikimisi: git config user.email)]:email:' \
            '--with[Komponendid, mille alusstruktuur samuti genereerida]:components:' \
            '(-f --force)'{-f,--force}'[Kirjuta sihtkohas olemasolev .claude-plugin/ üle]' \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Filtreeri juhtumeid nime glob-mustri järgi]:glob:' \
            '*--tag[Filtreeri juhtumeid sildi järgi (korratav)]:tag:' \
            '--runs[Kirjuta üle käivituste arv juhtumi kohta (vaikimisi: case.runs, muidu 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Käivita korraga kuni n agendikäivitust (1-8; vaikimisi 1)]:n:' \
            '--model[Kirjuta üle mudel kõigi juhtumite jaoks]:model:_claude_model_names' \
            '--judge-model[Kirjuta üle LLM-hindaja mudel (vaikimisi: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Range kululagi; selle ületamisel katkesta ja raporteeri osalised tulemused (väljumiskood 2)]:usd:' \
            '--output-dir[Kataloog faili aggregate-result.json jaoks]:dir:_directories' \
            '--eval-dir[Kataloogi nimi (plugina all), mis sisaldab hindamisjuhtumeid]:dir:' \
            '--json[Prindi kogu käivituse tulemus JSON-ina stdout-i või kirjuta see sellesse .json faili]::path:_files' \
            '--threshold[Välju koodiga 1, kui mõne juhtumi skoor on sellest lävest madalam (vaikimisi: 1.0)]:threshold:' \
            '*--allow-tools[Operaatori luba piiratud tööriistadele (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Käivita iga juhtumi scaffold_script (käivitab autori antud bashi sinu nimel; vaikimisi väljas)]' \
            '(--scaffold)--no-scaffold[Jäta scaffold_script selgesõnaliselt vahele]' \
            '--trust-plugin[Kinnita, et usaldad seda pluginat ja selle hindamiskomplekti, jättes esimese käivituse usaldusküsimuse vahele (CI jaoks)]' \
            '--ablation[Käivita pluginata võrdlusrühm (baseline) ja raporteeri skooride erinevus]:mode:(none with-without)' \
            '--mocks[MCP serverite mock-asendajad kataloogist <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Koos --mocks record: käivita ka päris MCP serveri protsessid, millel pole mock-asendajat]' \
            '--keep-temp[Säilita alusstruktuuri kataloogid silumiseks]' \
            '--verbose[Logi sõnumipõhised jälitussündmused silumislogisse]' \
            '--report[Kirjuta iseseisev HTML-raport tulemuste kataloogi asemel sellele teele]:path:_files' \
            '(--no-publish)--publish-report[Nõua ka raporti avaldamist claude.ai-s]' \
            '(--publish-report)--no-publish[Hoia HTML-raport ainult kohalikuna; jäta claude.ai-s avaldamine vahele]' \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Lükka silt pärast loomist --remote'\''i]' \
            '--dry-run[Prindi, mis sildistataks, ilma silti loomata]' \
            '(-f --force)'{-f,--force}'[Jäta vahele muudetud tööpuu ja juba olemasoleva sildi kontrollid]' \
            '(-m --message)'{-m,--message}'[Sildi annotatsiooni sõnum (kasuta versiooni jaoks %s)]:msg:' \
            '--remote[Remote, kuhu --push korral lükata]:name:' \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Lisa turuplats URL-ist, teest või GitHub repositooriumist'
    'list:Kuva konfigureeritud turuplatsid'
    'remove:Eemalda konfigureeritud turuplats'
    'rm:Eemalda konfigureeritud turuplats (remove sünonüüm)'
    'update:Uuenda turuplats allikast - uuenda kõiki, kui nimi on määramata'
    'help:Kuva abi'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Kuva abi]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace käsud' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Piira checkout kindlate kataloogidega git sparse-checkout abil (monorepode jaoks)]:paths:' \
            '--scope[Kus turuplats deklareerida]:scope:(user project local)' \
            '--claudeai[Lisa selle nimega turuplats, mida claude.ai sinu jaoks majutab]' \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Väljasta JSON-ina]' \
            '(-h --help)'{-h,--help}'[Kuva abi]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Eemalda turuplatsi deklaratsioon konkreetsest seadete ulatusest (jäta määramata, et eemaldada see kõigist ulatustest)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Kuva abi]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Sunniviisiline installimine isegi kui juba installitud]' \
    '(-h --help)'{-h,--help}'[Kuva abi]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Lisakataloog tööriistade juurdepääsu võimaldamiseks lähetatud sessioonides]:directory:_directories' \
    '--agent[Vaikeagent agendivaatest lähetatud sessioonidele]:agent:_claude_agent_names' \
    '--all[Koos --json: kaasa ka lõpetatud taustsessioonid]' \
    '--allow-dangerously-skip-permissions[Tee loarekontrollide möödumise režiim kättesaadavaks lähetatud sessioonidele]' \
    '--cwd[Näita ainult tee all alustatud taustsessioone]:path:_directories' \
    '--dangerously-skip-permissions[--permission-mode bypassPermissions sünonüüm]' \
    '--effort[Vaikimisi pingutuse tase lähetatud sessioonidele]:level:(low medium high xhigh max)' \
    '--json[Prindi aktiivsed sessioonid JSON massiivina ja välju]' \
    '*--mcp-config[MCP serveri konfiguratsioon lähetatud sessioonidele rakendamiseks]:config:' \
    '--model[Vaikemudel agendivaatest lähetatud sessioonidele]:model:_claude_model_names' \
    '--permission-mode[Vaikimisi loarežiim lähetatud sessioonidele]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Laadi pluginad kataloogist agendivaatele ja lähetatud sessioonidele]:path:_directories' \
    '--setting-sources[Seadete allikate loend komadega eraldatuna laadimiseks (user, project, local)]:sources:' \
    '--settings[Rakendatav seadete fail või JSON string]:file-or-json:_files' \
    '--strict-mcp-config[Kasuta lähetatud sessioonides ainult MCP servereid --mcp-config-ist]' \
    '--restricted[Käivita lähetatud sessioonid piiratud režiimis]' \
    '(-h --help)'{-h,--help}'[Kuva abi käsule]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Logi sisse oma Anthropic kontole'
    'logout:Logi välja oma Anthropic kontolt'
    'status:Näita autentimise olekut'
    'help:Kuva abi'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Kuva abi käsule]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth käsud' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Täida sisselogimislehel e-posti aadress eelnevalt]:email:' \
            '--sso[Kasuta sunniviisiliselt SSO sisselogimisvoogu]' \
            '(--claudeai)--console[Kasuta Claude tellimuse asemel Anthropic Console'\''i (API kasutuspõhine arveldus)]' \
            '(--console)--claudeai[Kasuta Claude tellimust (vaikimisi)]' \
            '(-h --help)'{-h,--help}'[Kuva abi käsule]'
          ;;
        status)
          _arguments \
            '(--text)--json[Väljasta JSON-ina (vaikimisi)]' \
            '(--json)--text[Väljasta inimloetava tekstina]' \
            '(-h --help)'{-h,--help}'[Kuva abi käsule]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Kuva abi käsule]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Prindi kehtiv automaatrežiimi konfiguratsioon JSON-ina'
    'critique:Saa AI tagasiside oma kohandatud automaatrežiimi reeglitele'
    'defaults:Prindi vaikimisi automaatrežiimi reeglid JSON-ina'
    'reset:Lähtesta automaatrežiimi konfiguratsioon tarnitud vaikeväärtustele'
    'help:Kuva abi'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Kuva abi käsule]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode käsud' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Kirjuta üle kasutatav mudel]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Kuva abi käsule]'
          ;;
        defaults)
          _arguments \
            '--label[Näita ainult reegleid, mille silt algab selle eesliitega (tõstutundetu)]:prefix:' \
            '(-h --help)'{-h,--help}'[Kuva abi käsule]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Jäta kinnitusküsimus vahele]' \
            '(-h --help)'{-h,--help}'[Kuva abi käsule]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Kuva abi käsule]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Tee lüüsi YAML konfiguratsioonini]:path:_files' \
    '(-h --help)'{-h,--help}'[Kuva abi käsule]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Kustuta projekti kogu Claude Code olek (transkriptsioonid, ülesanded, failiajalugu, konfiguratsioonikirje)'
    'help:Kuva abi'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Kuva abi käsule]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project käsud' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Loetle, mis kustutataks, ilma midagi kustutamata]' \
            '(-y --yes)'{-y,--yes}'[Jäta kinnitusküsimus vahele]' \
            '(-i --interactive)'{-i,--interactive}'[Küsi iga üksuse kohta enne kustutamist]' \
            '(1)--all[Kustuta kõigi projektide olek (välistab tee määramise)]' \
            '(-h --help)'{-h,--help}'[Kuva abi käsule]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Prindi töötlemata bugs.json andmed vormindatud leidude asemel]' \
    '--timeout[Maksimaalne minutite arv ülevaatuse lõppemise ootamiseks (vaikimisi: 45)]:minutes:' \
    '(--no-post)--post[Postita lõpetatud ülevaatuse leiud PR-i sinu nimel (ainult PR-sihtmärkide puhul; üks lihtne kommentaar, mitte ülevaatus)]' \
    '(--post)--no-post[Ära postita leide PR-i (vaikimisi)]' \
    '(-h --help)'{-h,--help}'[Kuva abi käsule]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Taaskäivita kõik töötavad taustsessioonid]' \
    '(-h --help)'{-h,--help}'[Kuva abi käsule]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Hülga ka worktree lükkamata commitid ja commitimata muudatused (anna eelmise claude rm teatatud commit@worktree-id)]:commit@worktree-id:' \
    '--force-remove-worktree[Kustuta worktree kataloog ka siis, kui WorktreeRemove hook või git ei suutnud seda eemaldada (anna eelmise claude rm teatatud worktree-id)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Kuva abi käsule]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Näita, mis imporditaks, ilma midagi kirjutamata]' \
    '--yes[Jäta interaktiivne valija vahele (peata keskkondades anna /import eelvaatest --yes=<digest>)]' \
    '(-h --help)'{-h,--help}'[Kuva abi käsule]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
