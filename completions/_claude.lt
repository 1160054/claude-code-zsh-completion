#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:Konfigūruoti ir valdyti MCP serverius'
    'plugin:Valdyti Claude Code papildinius'
    'agents:Valdyti foninius agentus'
    'attach:Atidaryti foninį seansą šiame terminale'
    'logs:Atspausdinti naujausią foninio seanso terminalo išvestį'
    'stop:Sustabdyti foninį seansą (jo pokalbis išsaugomas)'
    'respawn:Iš naujo paleisti foninį seansą, kad jis veiktų su dabartine Claude Code versija'
    'rm:Ištrinti foninį seansą ir, kai tai saugu, jo darbo medį'
    'auth:Valdyti autentifikaciją'
    'auto-mode:Peržiūrėti arba iš naujo nustatyti automatinio režimo klasifikatoriaus konfigūraciją'
    'gateway:Paleisti įmonės autentifikacijos/telemetrijos tinklų sietuvą'
    'import:Importuoti konfigūraciją iš kito DI programavimo agento į Claude Code'
    'project:Valdyti Claude Code projekto būseną'
    'ultrareview:Paleisti debesyje talpinamą daugiaagentę kodo peržiūrą ir atspausdinti radinius'
    'setup-token:Nustatyti ilgalaikės autentifikacijos prieigos raktą (reikalinga Claude prenumerata)'
    'doctor:Patikrinti Claude Code automatinio atnaujinimo sistemos būklę'
    'update:Patikrinti ir įdiegti atnaujinimus'
    'install:Įdiegti vietinę Claude Code versiją'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[Įjungti derinimo režimą su papildomu kategorijų fitravimu (pvz., "api,hooks" arba "!statsig,!file")]:filter:'
    '--verbose[Perrašyti išsamaus režimo nustatymą iš konfigūracijos failo]'
    '(-p --print)'{-p,--print}'[Spausdinti atsakymą ir išeiti (naudojimui su pipe). Pastaba: naudokite tik patikimuose kataloguose]'
    '--output-format[Išvesties formatas (su --print): "text" (numatytasis), "json" (vienas rezultatas), arba "stream-json" (srautinis perdavimas realiuoju laiku)]:format:(text json stream-json)'
    '--json-schema[JSON schema struktūruotos išvesties tikrinimui]:schema:'
    '--include-partial-messages[Įtraukti dalinius pranešimų fragmentus jiems atvykstant (su --print ir --output-format=stream-json)]'
    '--input-format[Įvesties formatas (su --print): "text" (numatytasis) arba "stream-json" (srautinis įvedimas realiuoju laiku)]:format:(text stream-json)'
    '--mcp-debug[\[Pasenęs. Naudokite --debug vietoj to\] Įjungti MCP derinimo režimą (rodo MCP serverio klaidas)]'
    '--dangerously-skip-permissions[Apeiti visas leidimų patikras. Rekomenduojama tik smėlio dėžėms be interneto prieigos]'
    '--allow-dangerously-skip-permissions[Įgalinti leidimų patikrų apėjimo parinktį be įgalinimo pagal numatytuosius nustatymus]'
    '--restricted[Apribotas režimas: pašalinti įrankius, kurie vykdo komandas ar kodą, ir WebFetch, nepaisyti user/project/local nustatymų ir apriboti failų įrankius darbiniais katalogais]'
    '--max-budget-usd[Maksimali dolerių suma API iškvietimams (tik --print)]:amount:'
    '--replay-user-messages[Pakartotinai išsiųsti vartotojo pranešimus iš stdin į stdout patvirtinimui]'
    '--allowed-tools[Leidžiamų įrankių pavadinimų sąrašas atskirtas kableliais arba tarpais (pvz., "Bash(git:*) Edit")]:tools:'
    '--allowedTools[Leidžiamų įrankių pavadinimų sąrašas atskirtas kableliais arba tarpais (camelCase formatas)]:tools:'
    '--tools[Nurodyti prieinamų įrankių sąrašą iš įmontuoto rinkinio. Tik print režime]:tools:'
    '--disallowed-tools[Neleidžiamų įrankių pavadinimų sąrašas atskirtas kableliais arba tarpais (pvz., "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[Neleidžiamų įrankių pavadinimų sąrašas atskirtas kableliais arba tarpais (camelCase formatas)]:tools:'
    '--mcp-config[Įkelti MCP serverius iš JSON failo arba eilutės (atskirti tarpais)]:configs:'
    '--system-prompt[Sisteminė užklausa naudojimui seanse]:prompt:'
    '--system-prompt-file[Nuskaityti sisteminę užklausą iš failo]:file:_files'
    '--append-system-prompt[Pridėti sisteminę užklausą prie numatytosios sisteminės užklausos]:prompt:'
    '--append-system-prompt-file[Nuskaityti sisteminę užklausą iš failo ir pridėti ją prie numatytosios sisteminės užklausos]:file:_files'
    '--system-prompt-snapshot[Įrašyti sisteminę užklausą vieną kartą per pokalbį ir pažodžiui naudoti ją pakartotinai kiekvienoje užklausoje ir atnaujinant (on, numatytasis) arba kiekvienai užklausai generuoti ją iš naujo (off)]:mode:(on off)'
    '--permission-mode[Leidimų režimas naudojimui seanse]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[Kas atsako į leidimų užklausas su --print: "host" (SDK host arba --permission-prompt-tool) arba "none" (viskas, kas reikalautų užklausos, atmetama)]:target:(host none)'
    '--permission-prompt-tool[MCP įrankis, naudojamas leidimų užklausoms (tik --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[Tęsti paskutinį pokalbį]'
    '(-r --resume)'{-r,--resume}'[Atnaujinti pokalbį - nurodykite seanso identifikatorių arba pasirinkite interaktyviai]:sessionId:_claude_sessions'
    '--fork-session[Sukurti naują seanso identifikatorių vietoj originalaus pakartotinio naudojimo atnaujinant (su --resume arba --continue)]'
    '--no-session-persistence[Išjungti seanso išsaugojimą - seansai nebus išsaugoti (tik --print)]'
    '--model[Modelis dabartiniam seansui. Nurodykite slapyvardį naujausiajam modeliui (pvz., '\''sonnet'\'' arba '\''opus'\'')]:model:_claude_model_names'
    '--agent[Agentas dabartiniam seansui. Perrašo '\''agent'\'' nustatymą]:agent:_claude_agent_names'
    '--betas[Beta antraštės įtraukimui į API užklausas (tik API rakto vartotojams)]:betas:'
    '--fallback-model[Įgalinti automatinį perjungimą į nurodytą modelį, kai numatytasis modelis perkrautas (tik --print)]:model:_claude_model_names'
    '--settings[Kelias į JSON nustatymų failą arba JSON eilutę papildomų nustatymų įkėlimui]:file-or-json:_files'
    '--add-dir[Papildomi katalogai įrankių prieigai suteikti]:directories:_directories'
    '--ide[Automatiškai prisijungti prie IDE paleidžiant, jei yra prieinama tiksliai viena galiojanti IDE]'
    '--desktop[Atidaryti Claude Desktop programėlėje vietoj terminalo (su --continue arba --resume <id> seansui pasirinkti)]'
    '--strict-mcp-config[Naudoti tik MCP serverius iš --mcp-config ir nepaisyti visų kitų MCP nustatymų]'
    '--session-id[Konkretus seanso identifikatorius naudojimui pokalbyje (turi būti galiojantis UUID)]:uuid:'
    '--agents[JSON objektas, apibrėžiantis pasirinktus agentus]:json:'
    '--setting-sources[Nustatymų šaltinių sąrašas atskirtas kableliais įkėlimui (user, project, local)]:sources:'
    '--plugin-dir[Katalogas papildinių įkėlimui tik šiam seansui (galima kartoti)]:paths:_directories'
    '--disable-slash-commands[Išjungti visas pasvirojo brūkšnio komandas]'
    '(--bg --background)'{--bg,--background}'[Paleisti seansą kaip foninį agentą ir nedelsiant grįžti]'
    '(-w --worktree)'{-w,--worktree}'[Sukurti naują git darbo medį šiam seansui (galima nurodyti pavadinimą)]::name:'
    '--tmux=-[Sukurti tmux seansą darbo medžiui (reikalauja --worktree). Naudoja iTerm2 vietinius skydelius, kai jie prieinami; --tmux=classic tradiciniam tmux]::mode:(classic)'
    '(-n --name)'{-n,--name}'[Nustatyti šio seanso rodomą pavadinimą]:name:'
    '--effort[Pastangų lygis dabartiniam seansui]:level:(low medium high xhigh max)'
    '--autocompact[Automatinio glaudinimo lango dydis (auto arba 100k-1M žetonų)]:size:(auto)'
    '--debug-file[Rašyti derinimo žurnalus į konkretų failo kelią (netiesiogiai įjungia derinimo režimą)]:path:_files'
    '--from-pr[Atnaujinti seansą, susietą su PR pagal numerį/URL, arba atidaryti interaktyvų parinkiklį]::value:'
    '--teleport[Atnaujinti teleport seansą, galima nurodyti seanso identifikatorių]::session:'
    '--cloud[Sukurti debesies seansą su nurodytu aprašymu arba prisijungti prie esamo pagal seanso identifikatorių ar claude.ai/code URL]::description-or-session:'
    '--environment[Sukurti naują debesies seansą, veikiantį nurodytoje savarankiškai talpinamoje aplinkoje (ccpool_...)]:environment_id:'
    '--remote-control[Paleisti interaktyvų seansą su įjungtu nuotoliniu valdymu (galima nurodyti pavadinimą)]::name:'
    '--remote-control-session-name-prefix[Automatiškai generuojamų nuotolinio valdymo seansų pavadinimų priešdėlis]:prefix:'
    '--chrome[Įjungti Claude in Chrome integraciją]'
    '--no-chrome[Išjungti Claude in Chrome integraciją]'
    '--plugin-url[Atsisiųsti papildinio .zip iš URL tik šiam seansui (galima kartoti)]:url:'
    '--file[Failų ištekliai atsisiuntimui paleidžiant (formatas: file_id:relative_path)]:specs:'
    '--prompt-suggestions[Įgalinti užklausų pasiūlymus (pateikia numatytą kitą užklausą print/SDK režime)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[Persiųsti subagento tekstą ir mąstymo blokus kaip pranešimus (su --print ir stream-json)]'
    '--include-hook-events[Įtraukti visus kabliuko gyvavimo ciklo įvykius į išvesties srautą (su stream-json)]'
    '--exclude-dynamic-system-prompt-sections[Perkelti kiekvienam įrenginiui skirtus skyrius į pirmą vartotojo pranešimą, kad pagerėtų užklausų talpyklos pakartotinis naudojimas]'
    '--brief[Įgalinti SendUserMessage įrankį agento ir vartotojo komunikacijai]'
    '--safe-mode[Paleisti su visais išjungtais pritaikymais (naudinga sprendžiant sugadintos konfigūracijos problemas)]'
    '--bare[Minimalus režimas: praleisti kabliukus, LSP, papildinių sinchronizavimą, priskyrimą, automatinę atmintį ir CLAUDE.md automatinį aptikimą]'
    '--ax-screen-reader[Pateikti ekrano skaitytuvui pritaikytą išvestį (paprastas tekstas, be dekoratyvinių rėmelių ar animacijų)]'
    '(-v --version)'{-v,--version}'[Išvesti versijos numerį]'
    '(-h --help)'{-h,--help}'[Rodyti pagalbą komandai]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude komandos' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą komandai]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "be argumentų"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Paleisti Claude Code MCP serverį'
    'add:Pridėti MCP serverį į Claude Code'
    'remove:Pašalinti MCP serverį'
    'list:Rodyti sukonfigūruotų MCP serverių sąrašą'
    'get:Gauti MCP serverio informaciją'
    'add-json:Pridėti MCP serverį (stdio arba SSE) su JSON eilute'
    'add-from-claude-desktop:Importuoti MCP serverius iš Claude Desktop (tik Mac ir WSL)'
    'reset-project-choices:Iš naujo nustatyti visus patvirtintus/atmestus projekto apimties (.mcp.json) serverius šiame projekte'
    'login:Autentifikuotis su MCP serveriu (HTTP, SSE arba claude.ai jungtimi)'
    'logout:Išvalyti išsaugotus OAuth kredencialus MCP serveriui'
    'help:Rodyti pagalbą'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp komandos' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Įjungti derinimo režimą]' \
            '--verbose[Perrašyti išsamaus režimo nustatymą iš konfigūracijos failo]' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigūracijos apimtis (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Transporto tipas (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[Nustatyti aplinkos kintamąjį (pvz., -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[Nustatyti WebSocket antraštę]:header:' \
            '--client-id[OAuth kliento ID HTTP/SSE serveriams]:clientId:' \
            '--client-secret[Paprašyti įvesti OAuth kliento paslaptį (arba nustatyti aplinkos kintamąjį MCP_CLIENT_SECRET)]' \
            '--callback-port[Fiksuotas prievadas OAuth atgaliniam iškvietimui (serveriams, reikalaujantiems iš anksto užregistruotų peradresavimo URI)]:port:' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigūracijos apimtis (local, user, project) - pašalinti iš esamos apimties, jei nenurodyta]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigūracijos apimtis (local, user, project)]:scope:(local user project)' \
            '--client-secret[Paprašyti įvesti OAuth kliento paslaptį (arba nustatyti aplinkos kintamąjį MCP_CLIENT_SECRET)]' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Konfigūracijos apimtis (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]'
          ;;
        login)
          _arguments \
            '--no-browser[Atspausdinti autorizacijos URL vietoj naršyklės atidarymo (SSH/be grafinės sąsajos seansams)]' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:Tikrinti papildinį arba rinkos manifestą'
    'marketplace:Valdyti Claude Code rinkas'
    'list:Rodyti įdiegtų papildinių sąrašą'
    'details:Rodyti komponentų inventorių ir numatomą prieigos raktų sąnaudą papildiniui'
    'configure:Rodyti papildinio parinktis ir kurios iš jų nenustatytos, arba išsaugoti reikšmes iš stdin'
    'install:Įdiegti papildinį iš prieinamų rinkų'
    'i:Įdiegti papildinį iš prieinamų rinkų (sutrumpinimas install)'
    'init:Sukurti naujo papildinio karkasą (automatiškai įkeliamas kitą seansą)'
    'new:Sukurti naujo papildinio karkasą (init sinonimas)'
    'uninstall:Pašalinti įdiegtą papildinį'
    'remove:Pašalinti įdiegtą papildinį (uninstall sinonimas)'
    'enable:Įgalinti išjungtą papildinį'
    'disable:Išjungti įgalintą papildinį'
    'update:Atnaujinti papildinį iki naujausios versijos'
    'eval:Paleisti vertinimo atvejus prieš papildinį ir pateikti įvertintus rezultatus'
    'prune:Pašalinti automatiškai įdiegtas priklausomybes, kurių nebereikia'
    'autoremove:Pašalinti automatiškai įdiegtas priklausomybes, kurių nebereikia (prune sinonimas)'
    'tag:Sukurti {name}--v{version} git žymą papildinio leidimui'
    'test:Paleisti modifikacijos (mod) testus'
    'help:Rodyti pagalbą'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin komandos' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[Laikyti įspėjimus klaidomis (išėjimo kodas 1)]' \
            '--json[Išvesti tikrinimo ataskaitą kaip JSON (tie patys išėjimo kodai)]' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Diegimo apimtis]:scope:(user project local)' \
            '*--config[Nustatyti papildinio manifeste deklaruotą userConfig parinktį (galima kartoti)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[Priimti rodomą rinkos deklaruotą komandą be patvirtinimo užklausos]' \
            '--json[Atspausdinti vieną mašininiu būdu nuskaitomą rezultato eilutę vietoj žmogui skirto pranešimo]' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Diegimo apimtis]:scope:(user project local)' \
            '--keep-data[Išsaugoti papildinio nuolatinių duomenų katalogą]' \
            '--prune[Taip pat pašalinti automatiškai įdiegtas priklausomybes, kurių nebereikia]' \
            '(-y --yes)'{-y,--yes}'[Praleisti --prune patvirtinimo užklausą]' \
            '--json[Atspausdinti vieną mašininiu būdu nuskaitomą rezultato eilutę vietoj žmogui skirto pranešimo (ne su --prune)]' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Diegimo apimtis]:scope:(user project local)' \
            '--json[Atspausdinti vieną mašininiu būdu nuskaitomą rezultato eilutę vietoj žmogui skirto pranešimo]' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[Išjungti visus įgalintus papildinius]' \
            '(-s --scope)'{-s,--scope}'[Diegimo apimtis]:scope:(user project local)' \
            '--json[Atspausdinti vieną mašininiu būdu nuskaitomą rezultato eilutę vietoj žmogui skirto pranešimo]' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Diegimo apimtis]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[Priimti rodomą rinkos deklaruotą komandą be patvirtinimo užklausos]' \
            '--json[Atspausdinti vieną mašininiu būdu nuskaitomą rezultato eilutę vietoj žmogui skirto pranešimo]' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[Išvesti kaip JSON]' \
            '--available[Įtraukti prieinamus papildinius iš rinkų (reikalauja --json)]' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Valyti nurodytoje apimtyje]:scope:(user project local)' \
            '--dry-run[Išvardyti, kas būtų pašalinta, nieko nepašalinant]' \
            '(-y --yes)'{-y,--yes}'[Praleisti patvirtinimo užklausą]' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]'
          ;;
        configure)
          _arguments \
            '--json[Išvesti kaip JSON]' \
            '--values-stdin[Nuskaityti parinkčių reikšmes iš stdin kaip JSON objektą su vienos eilutės tekstinėmis reikšmėmis; nenurodytos parinktys išlaiko savo reikšmes]' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[Manifesto aprašymas]:text:' \
            '--author[Autoriaus vardas (numatytasis: git config user.name)]:name:' \
            '--author-email[Autoriaus el. paštas (numatytasis: git config user.email)]:email:' \
            '--with[Komponentai, kurių karkasą taip pat sukurti]:components:' \
            '(-f --force)'{-f,--force}'[Perrašyti esamą .claude-plugin/ paskirties vietoje]' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[Filtruoti atvejus pagal pavadinimo glob šabloną]:glob:' \
            '*--tag[Filtruoti atvejus pagal žymą (galima kartoti)]:tag:' \
            '--runs[Perrašyti vykdymų skaičių kiekvienam atvejui (numatytasis: case.runs, kitaip 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[Vienu metu vykdyti iki n agento vykdymų (1-8; numatytasis 1)]:n:' \
            '--model[Perrašyti modelį visiems atvejams]:model:_claude_model_names' \
            '--judge-model[Perrašyti LLM vertintojo modelį (numatytasis: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[Griežta išlaidų riba; ją pasiekus nutraukti ir pateikti dalinius rezultatus (išėjimo kodas 2)]:usd:' \
            '--output-dir[Katalogas failui aggregate-result.json]:dir:_directories' \
            '--eval-dir[Katalogo pavadinimas (papildinio viduje), kuriame laikomi vertinimo atvejai]:dir:' \
            '--json[Atspausdinti visą vykdymo rezultatą kaip JSON į stdout arba įrašyti jį į šį .json failą]::path:_files' \
            '--threshold[Išeiti su išėjimo kodu 1, jei kurio nors atvejo įvertinimas žemesnis už šią ribą (numatytasis: 1.0)]:threshold:' \
            '*--allow-tools[Operatoriaus leidimas ribojamiems įrankiams (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[Vykdyti kiekvieno atvejo scaffold_script (vykdo autoriaus pateiktą bash jūsų vardu; pagal numatytuosius nustatymus išjungta)]' \
            '(--scaffold)--no-scaffold[Aiškiai praleisti scaffold_script]' \
            '--trust-plugin[Patvirtinti, kad pasitikite šiuo papildiniu ir jo vertinimo rinkiniu, praleidžiant pirmojo paleidimo pasitikėjimo užklausą (CI)]' \
            '--ablation[Vykdyti bazinę palyginamąją grupę be papildinio ir pateikti įvertinimų skirtumą]:mode:(none with-without)' \
            '--mocks[Imitaciniai MCP serverių pakaitalai iš <eval dir>/mocks/]:mode:(record off)' \
            '--allow-real-servers[Su --mocks record: taip pat paleisti tikrus MCP serverių procesus, kurie neturi imitacijos]' \
            '--keep-temp[Išsaugoti karkaso katalogus derinimui]' \
            '--verbose[Registruoti kiekvieno pranešimo sekimo įvykius derinimo žurnale]' \
            '--report[Įrašyti savarankišką HTML ataskaitą šiuo keliu vietoj rezultatų katalogo]:path:_files' \
            '(--no-publish)--publish-report[Taip pat reikalauti paskelbti ataskaitą claude.ai]' \
            '(--publish-report)--no-publish[Laikyti HTML ataskaitą tik vietoje; praleisti jos paskelbimą claude.ai]' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[Sukūrus išsiųsti žymą į --remote]' \
            '--dry-run[Atspausdinti, kas būtų pažymėta, nesukuriant žymos]' \
            '(-f --force)'{-f,--force}'[Praleisti neįrašytų darbinio medžio pakeitimų ir jau egzistuojančios žymos patikras]' \
            '(-m --message)'{-m,--message}'[Žymos anotacijos pranešimas (naudokite %s versijai)]:msg:' \
            '--remote[Nuotolinė saugykla, į kurią siųsti su --push]:name:' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:Pridėti rinką iš URL, kelio arba GitHub saugyklos'
    'list:Rodyti sukonfigūruotų rinkų sąrašą'
    'remove:Pašalinti sukonfigūruotą rinką'
    'rm:Pašalinti sukonfigūruotą rinką (remove sinonimas)'
    'update:Atnaujinti rinką iš šaltinio - atnaujinti visas, jei pavadinimas nenurodytas'
    'help:Rodyti pagalbą'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace komandos' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[Apriboti checkout konkrečiais katalogais per git sparse-checkout (monorepozitorijoms)]:paths:' \
            '--scope[Kur deklaruoti rinką]:scope:(user project local)' \
            '--claudeai[Pridėti šio pavadinimo rinką, kurią claude.ai talpina jums]' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[Išvesti kaip JSON]' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]'
          ;;
        remove|rm)
          _arguments \
            '--scope[Pašalinti rinkos deklaraciją iš konkrečios nustatymų apimties (nenurodžius pašalinama iš visų apimčių)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[Priverstinis diegimas, net jei jau įdiegta]' \
    '(-h --help)'{-h,--help}'[Rodyti pagalbą]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[Papildomas katalogas įrankių prieigai suteikti išsiųstuose seansuose]:directory:_directories' \
    '--agent[Numatytasis agentas seansams, išsiųstiems iš agentų rodinio]:agent:_claude_agent_names' \
    '--all[Su --json: taip pat įtraukti užbaigtus foninius seansus]' \
    '--allow-dangerously-skip-permissions[Padaryti leidimų apėjimo režimą prieinamą išsiųstiems seansams]' \
    '--cwd[Rodyti tik foninius seansus, pradėtus nurodytame kelyje]:path:_directories' \
    '--dangerously-skip-permissions[Sinonimas --permission-mode bypassPermissions]' \
    '--effort[Numatytasis pastangų lygis išsiųstiems seansams]:level:(low medium high xhigh max)' \
    '--json[Atspausdinti aktyvius seansus kaip JSON masyvą ir išeiti]' \
    '*--mcp-config[MCP serverio konfigūracija, taikoma išsiųstiems seansams]:config:' \
    '--model[Numatytasis modelis seansams, išsiųstiems iš agentų rodinio]:model:_claude_model_names' \
    '--permission-mode[Numatytasis leidimų režimas išsiųstiems seansams]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[Įkelti papildinius iš katalogo agentų rodiniui ir išsiųstiems seansams]:path:_directories' \
    '--setting-sources[Nustatymų šaltinių sąrašas atskirtas kableliais įkėlimui (user, project, local)]:sources:' \
    '--settings[Nustatymų failas arba JSON eilutė taikymui]:file-or-json:_files' \
    '--strict-mcp-config[Naudoti tik MCP serverius iš --mcp-config išsiųstuose seansuose]' \
    '--restricted[Paleisti išsiųstus seansus apribotu režimu]' \
    '(-h --help)'{-h,--help}'[Rodyti pagalbą komandai]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:Prisijungti prie savo Anthropic paskyros'
    'logout:Atsijungti nuo savo Anthropic paskyros'
    'status:Rodyti autentifikacijos būseną'
    'help:Rodyti pagalbą'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Rodyti pagalbą komandai]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth komandos' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[Iš anksto užpildyti el. pašto adresą prisijungimo puslapyje]:email:' \
            '--sso[Priverstinai naudoti SSO prisijungimo eigą]' \
            '(--claudeai)--console[Naudoti Anthropic Console (atsiskaitymas pagal API naudojimą) vietoj Claude prenumeratos]' \
            '(--console)--claudeai[Naudoti Claude prenumeratą (numatytasis)]' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą komandai]'
          ;;
        status)
          _arguments \
            '(--text)--json[Išvesti kaip JSON (numatytasis)]' \
            '(--json)--text[Išvesti kaip žmogui skaitomą tekstą]' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą komandai]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą komandai]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:Atspausdinti galiojančią automatinio režimo konfigūraciją kaip JSON'
    'critique:Gauti DI atsiliepimą apie savo pasirinktas automatinio režimo taisykles'
    'defaults:Atspausdinti numatytąsias automatinio režimo taisykles kaip JSON'
    'reset:Iš naujo nustatyti automatinio režimo konfigūraciją į pristatytus numatytuosius nustatymus'
    'help:Rodyti pagalbą'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Rodyti pagalbą komandai]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode komandos' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[Perrašyti naudojamą modelį]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą komandai]'
          ;;
        defaults)
          _arguments \
            '--label[Rodyti tik taisykles, kurių etiketė prasideda šiuo priešdėliu (neskiriant didžiųjų ir mažųjų raidžių)]:prefix:' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą komandai]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Praleisti patvirtinimo užklausą]' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą komandai]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą komandai]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[Kelias į tinklų sietuvo YAML konfigūraciją]:path:_files' \
    '(-h --help)'{-h,--help}'[Rodyti pagalbą komandai]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:Ištrinti visą Claude Code būseną projektui (nuorašai, užduotys, failų istorija, konfigūracijos įrašas)'
    'help:Rodyti pagalbą'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Rodyti pagalbą komandai]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project komandos' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[Išvardyti, kas būtų ištrinta, nieko neištrinant]' \
            '(-y --yes)'{-y,--yes}'[Praleisti patvirtinimo užklausą]' \
            '(-i --interactive)'{-i,--interactive}'[Klausti dėl kiekvieno elemento prieš ištrinant]' \
            '(1)--all[Ištrinti būseną visiems projektams (negalima naudoti kartu su keliu)]' \
            '(-h --help)'{-h,--help}'[Rodyti pagalbą komandai]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[Atspausdinti neapdorotą bugs.json turinį vietoj suformatuotų radinių]' \
    '--timeout[Maksimalus minučių skaičius laukti, kol peržiūra bus baigta (numatytasis: 45)]:minutes:' \
    '(--no-post)--post[Paskelbti baigtos peržiūros radinius PR jūsų vardu (tik PR tikslams; vienas paprastas komentaras, ne peržiūra)]' \
    '(--post)--no-post[Neskelbti radinių PR (numatytasis)]' \
    '(-h --help)'{-h,--help}'[Rodyti pagalbą komandai]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[Iš naujo paleisti visus veikiančius foninius seansus]' \
    '(-h --help)'{-h,--help}'[Rodyti pagalbą komandai]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[Taip pat atmesti neišsiųstus komitus ir nekomituotus darbo medžio pakeitimus (perduokite commit@worktree-id, kurį pranešė ankstesnis claude rm)]:commit@worktree-id:' \
    '--force-remove-worktree[Ištrinti darbo medžio katalogą, net jei WorktreeRemove kabliukas ar git negalėjo jo pašalinti (perduokite worktree-id, kurį pranešė ankstesnis claude rm)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[Rodyti pagalbą komandai]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[Rodyti, kas būtų importuota, nieko neįrašant]' \
    '--yes[Praleisti interaktyvų parinkiklį (aplinkose be grafinės sąsajos perduokite --yes=<digest> iš /import peržiūros)]' \
    '(-h --help)'{-h,--help}'[Rodyti pagalbą komandai]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
