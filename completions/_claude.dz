            '--json[གཡོག་བཀོལ་གྲུབ་འབྲས་ཧྲིལ་བུ་JSON སྦེ་stdout ལུ་དཔར་བསྐྲུན་འབད, ཡང་ན་.json ཡིག་ཆ་འདི་ནང་བྲིས]::path:_files' \
            '--threshold[case གང་རུང་གི་སྐུགས་ཐོབ་ཚད་གཞི་འདི་ལས་དམའ་བ་ཅིན་ཕྱིར་ཐོན་ཨང་རྟགས 1 (སྔོན་སྒྲིག: 1.0)]:threshold:' \
            '*--allow-tools[ཚད་བཀག་ཡོད་པའི་ལག་ཆས་ཚུ་གི་དོན་ལུ་བཀོལ་སྤྱོད་པའི་གནང་བ (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[case རེ་རེའི་scaffold_script གཡོག་བཀོལ (རྩོམ་པ་པོས་བྱིན་མི་bash ཁྱོད་ཀྱི་མིང་ཐོག་ལས་གཡོག་བཀོལཝ་ཨིན; སྔོན་སྒྲིག་ཐོག་ལས་off)]' \
            '(--scaffold)--no-scaffold[scaffold_script གསལ་ཏོག་ཏོ་སྦེ་ཟུར་བཤོལ]' \
            '--trust-plugin[པ་ལག་འདི་དང་དེ་གི་eval suite ལུ་ཡིད་ཆེས་ཡོདཔ་ཁས་ལེན་འབད་དེ་གཡོག་བཀོལ་དང་པའི་ཡིད་ཆེས་prompt ཟུར་བཤོལ (CI གི་དོན་ལུ)]' \
            '--ablation[པ་ལག་མེད་པའི་གཞི་རྟེན་བསྡུར་ཞིབ་སྡེ་ཚན་ཅིག་གཡོག་བཀོལ་ཞིནམ་ལས་སྐུགས་ཐོབ་ཀྱི་ཁྱད་པར་སྙན་ཞུ་འབད]:mode:(none with-without)' \
            '--mocks[MCP སར་བར་ཚུ་གི་ཚབ་ཀྱི་mock ཚུ, <eval dir>/mocks/ ནང་ལས]:mode:(record off)' \
            '--allow-real-servers[--mocks record དང་གཅིག་ཁར: mock མེད་པའི་MCP སར་བར་ངོ་མའི་ལས་སྦྱོར་ཚུ་ཡང་འགོ་བཙུགས]' \
            '--keep-temp[རྙོག་སེལ་གྱི་དོན་ལུ་scaffold ཡིག་སྣོད་ཚུ་སྲུང་བཞག་འབད]' \
            '--verbose[འཕྲིན་དོན་རེ་རེའི་trace བྱུང་ལས་ཚུ་རྙོག་སེལ་log ནང་ཐོ་བཀོད་འབད]' \
            '--report[རང་རྐྱ་ཚང་བའི་HTML སྙན་ཞུ་གྲུབ་འབྲས་ཡིག་སྣོད་ཀྱི་ཚབ་ལུ་འགྲོ་ལམ་འདི་ལུ་བྲིས]:path:_files' \
            '(--no-publish)--publish-report[སྙན་ཞུ་claude.ai ལུ་འགྲེམ་སྤེལ་འབད་ནི་ཡང་དགོཔ་བཟོ]' \
            '(--publish-report)--no-publish[HTML སྙན་ཞུ་ས་གནས་ནང་རྐྱངམ་ཅིག་བཞག; claude.ai ལུ་འགྲེམ་སྤེལ་ཟུར་བཤོལ]' \
            '(-h --help)'{-h,--help}'[རོགས་རམ་སྟོན]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[tag གསར་བསྐྲུན་འབད་ཞིནམ་ལས་ --remote ལུ་push འབད]' \
            '--dry-run[tag གསར་བསྐྲུན་མ་འབད་བར་tag བཀལ་ནི་ཡོད་མི་དཔར་བསྐྲུན་འབད]' \
            '(-f --force)'{-f,--force}'[dirty working tree དང་tag ཧེ་མ་ལས་ཡོད་པའི་ཞིབ་དཔྱད་ཚུ་ཟུར་བཤོལ]' \
            '(-m --message)'{-m,--message}'[tag མཆན་འགྲེལ་འཕྲིན་དོན (ཐོན་རིམ་གྱི་དོན་ལུ་%s ལག་ལེན་འཐབ)]:msg:' \
            '--remote[--push དང་གཅིག་ཁར་push འབད་སའི་remote]:name:' \
            '(-h --help)'{-h,--help}'[རོགས་རམ་སྟོན]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[རོགས་རམ་སྟོན]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:URL, འགྲོ་ལམ, ཡང་ན་GitHub repository ནང་ལས་ཚོང་ཁང་ཅིག་ཁ་སྐོང'
    'list:རིམ་སྒྲིག་འབད་མི་ཚོང་ཁང་ཚུ་ཐོ་བཀོད'
    'remove:རིམ་སྒྲིག་འབད་མི་ཚོང་ཁང་ཅིག་རྩ་བསྐྲད་གཏང'
    'rm:རིམ་སྒྲིག་འབད་མི་ཚོང་ཁང་ཅིག་རྩ་བསྐྲད་གཏང (remove གྱི་མིང་ཚབ)'
    'update:འབྱུང་ཁུངས་ནང་ལས་ཚོང་ཁང་དུས་མཐུན་བཟོ - མིང་གསལ་བཀོད་མ་འབད་བ་ཅིན་ཆ་མཉམ་དུས་མཐུན་བཟོ'
    'help:རོགས་རམ་སྟོན'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[རོགས་རམ་སྟོན]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'ཚོང་ཁང་བརྡ་བཀོད' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[git sparse-checkout བརྒྱུད་དེ་checkout ཡིག་སྣོད་དམིགས་བསལ་ཚུ་ལུ་ཚད་འཛིན་འབད (monorepo ཚུ་གི་དོན་ལུ)]:paths:' \
            '--scope[ཚོང་ཁང་གསལ་བསྒྲགས་འབད་ས]:scope:(user project local)' \
            '--claudeai[claude.ai གིས་ཁྱོད་ཀྱི་དོན་ལུ་host འབད་མི་མིང་འདི་གི་ཚོང་ཁང་ཁ་སྐོང]' \
            '(-h --help)'{-h,--help}'[རོགས་རམ་སྟོན]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[JSON སྦེ་ཐོན་སྐྱེད་འབད]' \
            '(-h --help)'{-h,--help}'[རོགས་རམ་སྟོན]'
          ;;
        remove|rm)
          _arguments \
            '--scope[སྒྲིག་སྟངས་ཁྱབ་ཚད་དམིགས་བསལ་ཅིག་ནང་ལས་ཚོང་ཁང་གི་གསལ་བསྒྲགས་རྩ་བསྐྲད་གཏང (བཀོད་མེད་པ་ཅིན་ཁྱབ་ཚད་ཆ་མཉམ་ནང་ལས་རྩ་བསྐྲད་གཏང)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[རོགས་རམ་སྟོན]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[རོགས་རམ་སྟོན]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[ཧེ་མ་ལས་སྒྲིག་བཞག་འབད་ཡོད་རུང་བཙན་གྱིས་སྒྲིག་བཞག་འབད]' \
    '(-h --help)'{-h,--help}'[རོགས་རམ་སྟོན]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[གཏང་བའི་ལས་ཐེངས་ཚུ་ནང་ལག་ཆས་འཛུལ་སྤྱོད་ཆོག་ནིའི་ཡིག་སྣོད་ཁ་སྐོང]:directory:_directories' \
    '--agent[ལས་བྱེད་མཐོང་སྣང་ནང་ལས་གཏང་བའི་ལས་ཐེངས་ཚུ་གི་དོན་ལུ་སྔོན་སྒྲིག་ལས་བྱེད]:agent:_claude_agent_names' \
    '--all[--json དང་གཅིག་ཁར: མཇུག་བསྡུ་བའི་རྒྱབ་གཞིའི་ལས་ཐེངས་ཚུ་ཡང་ཚུད་བཅུག]' \
    '--allow-dangerously-skip-permissions[གཏང་བའི་ལས་ཐེངས་ཚུ་ལུ་bypass-permissions ཐབས་ལམ་འཐོབ་ཚུགས་བཟོ]' \
    '--cwd[འགྲོ་ལམ་འོག་ལུ་འགོ་བཙུགས་མི་རྒྱབ་གཞིའི་ལས་ཐེངས་ཚུ་རྐྱངམ་ཅིག་སྟོན]:path:_directories' \
    '--dangerously-skip-permissions[--permission-mode bypassPermissions གྱི་མིང་ཚབ]' \
    '--effort[གཏང་བའི་ལས་ཐེངས་ཚུ་གི་དོན་ལུ་སྔོན་སྒྲིག་འབད་བརྩོན་གནས་རིམ]:level:(low medium high xhigh max)' \
    '--json[ལས་ཐེངས་ཤུགས་ལྡན་ཚུ་JSON array སྦེ་དཔར་བསྐྲུན་འབད་ཞིནམ་ལས་ཕྱིར་ཐོན]' \
    '*--mcp-config[གཏང་བའི་ལས་ཐེངས་ཚུ་ལུ་འཇུག་སྤྱོད་འབད་ནིའི་MCP སར་བར་རིམ་སྒྲིག]:config:' \
    '--model[ལས་བྱེད་མཐོང་སྣང་ནང་ལས་གཏང་བའི་ལས་ཐེངས་ཚུ་གི་དོན་ལུ་སྔོན་སྒྲིག་དཔེ་གཞི]:model:_claude_model_names' \
    '--permission-mode[གཏང་བའི་ལས་ཐེངས་ཚུ་གི་དོན་ལུ་སྔོན་སྒྲིག་གནང་བའི་ཐབས་ལམ]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[ལས་བྱེད་མཐོང་སྣང་དང་གཏང་བའི་ལས་ཐེངས་ཚུ་གི་དོན་ལུ་ཡིག་སྣོད་ནང་ལས་པ་ལག་ཚུ་མངོན་གསལ་འབད]:path:_directories' \
    '--setting-sources[མངོན་གསལ་འབད་ནིའི་སྒྲིག་སྟངས་འབྱུང་ཁུངས་ཀྱི་ཐོ་ཡིག་comma གིས་སོ་སོར (user, project, local)]:sources:' \
    '--settings[འཇུག་སྤྱོད་འབད་ནིའི་སྒྲིག་སྟངས་ཡིག་ཆ་ཡང་ན་JSON string]:file-or-json:_files' \
    '--strict-mcp-config[གཏང་བའི་ལས་ཐེངས་ཚུ་ནང་--mcp-config ནང་ལས་MCP སར་བར་རྐྱངམ་ཅིག་ལག་ལེན་འཐབ]' \
    '--restricted[གཏང་བའི་ལས་ཐེངས་ཚུ་ཚད་བཀག་ཐབས་ལམ་ནང་འགོ་བཙུགས]' \
    '(-h --help)'{-h,--help}'[བརྡ་བཀོད་ཀྱི་དོན་ལུ་རོགས་རམ་སྟོན]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:ཁྱོད་ཀྱི་Anthropic account ནང་ཐོ་བཀོད་འབད'
    'logout:ཁྱོད་ཀྱི་Anthropic account ནང་ལས་ཕྱིར་བསྐྱོད'
    'status:བདེན་དཔྱད་ཀྱི་གནས་སྟངས་སྟོན'
    'help:རོགས་རམ་སྟོན'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[བརྡ་བཀོད་ཀྱི་དོན་ལུ་རོགས་རམ་སྟོན]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth བརྡ་བཀོད' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[ནང་བསྐྱོད་ཤོག་ལེབ་གུ་email ཁ་བྱང་སྔོན་ལས་བཀང]:email:' \
            '--sso[SSO ནང་བསྐྱོད་ཀྱི་རིམ་པ་བཙན་གྱིས་ལག་ལེན་འཐབ]' \
            '(--claudeai)--console[Claude མངགས་ཉོ་གི་ཚབ་ལུ་Anthropic Console (API ལག་ལེན་གྱི་གླ་འཐུས) ལག་ལེན་འཐབ]' \
            '(--console)--claudeai[Claude མངགས་ཉོ་ལག་ལེན་འཐབ (སྔོན་སྒྲིག)]' \
            '(-h --help)'{-h,--help}'[བརྡ་བཀོད་ཀྱི་དོན་ལུ་རོགས་རམ་སྟོན]'
          ;;
        status)
          _arguments \
            '(--text)--json[JSON སྦེ་ཐོན་སྐྱེད་འབད (སྔོན་སྒྲིག)]' \
            '(--json)--text[མི་གིས་ལྷག་ཚུགས་པའི་ཚིག་ཡིག་སྦེ་ཐོན་སྐྱེད་འབད]' \
            '(-h --help)'{-h,--help}'[བརྡ་བཀོད་ཀྱི་དོན་ལུ་རོགས་རམ་སྟོན]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[བརྡ་བཀོད་ཀྱི་དོན་ལུ་རོགས་རམ་སྟོན]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:ནུས་ལྡན་རང་བཞིན་ཐབས་ལམ་config JSON སྦེ་དཔར་བསྐྲུན་འབད'
    'critique:ཁྱོད་ཀྱི་སྲོལ་སྒྲིག་རང་བཞིན་ཐབས་ལམ་གྱི་ལམ་ལུགས་ཚུ་གུ་AI གི་བསམ་ལན་ལེན'
    'defaults:སྔོན་སྒྲིག་རང་བཞིན་ཐབས་ལམ་གྱི་ལམ་ལུགས་ཚུ་JSON སྦེ་དཔར་བསྐྲུན་འབད'
    'reset:རང་བཞིན་ཐབས་ལམ་རིམ་སྒྲིག་སྔོན་སྒྲིག་ཚུ་ལུ་སླར་སྒྲིག་འབད'
    'help:རོགས་རམ་སྟོན'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[བརྡ་བཀོད་ཀྱི་དོན་ལུ་རོགས་རམ་སྟོན]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode བརྡ་བཀོད' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[ལག་ལེན་འཐབ་མི་དཔེ་གཞི་ཚབ་བཙུགས]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[བརྡ་བཀོད་ཀྱི་དོན་ལུ་རོགས་རམ་སྟོན]'
          ;;
        defaults)
          _arguments \
            '--label[ཁ་ཡིག་སྔོན་ཚིག་འདི་གིས་འགོ་བཙུགས་མི་ལམ་ལུགས་ཚུ་རྐྱངམ་ཅིག་སྟོན (ཡིག་འབྲུ་ཆེ་ཆུང་ཁྱད་པར་མེད)]:prefix:' \
            '(-h --help)'{-h,--help}'[བརྡ་བཀོད་ཀྱི་དོན་ལུ་རོགས་རམ་སྟོན]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[ངེས་དཔྱད་prompt ཟུར་བཤོལ]' \
            '(-h --help)'{-h,--help}'[བརྡ་བཀོད་ཀྱི་དོན་ལུ་རོགས་རམ་སྟོན]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[བརྡ་བཀོད་ཀྱི་དོན་ལུ་རོགས་རམ་སྟོན]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[gateway YAML config གྱི་འགྲོ་ལམ]:path:_files' \
    '(-h --help)'{-h,--help}'[བརྡ་བཀོད་ཀྱི་དོན་ལུ་རོགས་རམ་སྟོན]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:ལས་འགུལ་ཅིག་གི་དོན་ལུ་Claude Code གནས་སྟངས་ཆ་མཉམ་བཏོན་གཏང (transcripts, tasks, ཡིག་ཆའི་ལོ་རྒྱུས, config entry)'
    'help:རོགས་རམ་སྟོན'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[བརྡ་བཀོད་ཀྱི་དོན་ལུ་རོགས་རམ་སྟོན]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project བརྡ་བཀོད' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[ག་ནི་ཡང་མ་བཏོན་བར་བཏོན་གཏང་ནི་ཡོད་མི་ཚུ་ཐོ་བཀོད]' \
            '(-y --yes)'{-y,--yes}'[ངེས་དཔྱད་prompt ཟུར་བཤོལ]' \
            '(-i --interactive)'{-i,--interactive}'[བཏོན་གཏང་མ་ཚུགས་པའི་ཧེ་མ་རྣམ་གྲངས་རེ་རེ་གི་དོན་ལུ་འདྲི]' \
            '(1)--all[ལས་འགུལ་ཆ་མཉམ་གྱི་གནས་སྟངས་བཏོན་གཏང (འགྲོ་ལམ་དང་གཅིག་ཁར་ལག་ལེན་འཐབ་མི་ཚུགས)]' \
            '(-h --help)'{-h,--help}'[བརྡ་བཀོད་ཀྱི་དོན་ལུ་རོགས་རམ་སྟོན]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[རྣམ་གཞག་བཟོ་མི་ཐོབ་གྲུབ་ཚུ་གི་ཚབ་ལུ་bugs.json payload རགས་པ་དཔར་བསྐྲུན་འབད]' \
    '--timeout[བསྐྱར་ཞིབ་མཇུག་བསྡུ་ནི་ལུ་བསྒུག་ནིའི་སྐར་མ་མང་མཐའ (སྔོན་སྒྲིག: 45)]:minutes:' \
    '(--no-post)--post[མཇུག་བསྡུ་བའི་བསྐྱར་ཞིབ་ཐོབ་གྲུབ་ཚུ་ཁྱོད་ཀྱི་མིང་ཐོག་ལས་PR ལུ་བཙུགས (PR དམིགས་ཚད་རྐྱངམ་ཅིག; བསྐྱར་ཞིབ་མེན་པར་མཆན་འགྲེལ་སྤྱིར་བཏང་གཅིག)]' \
    '(--post)--no-post[ཐོབ་གྲུབ་ཚུ་PR ལུ་མ་བཙུགས (སྔོན་སྒྲིག)]' \
    '(-h --help)'{-h,--help}'[བརྡ་བཀོད་ཀྱི་དོན་ལུ་རོགས་རམ་སྟོན]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[གཡོག་བཀོལ་བའི་བསྒང་ཡོད་པའི་རྒྱབ་གཞིའི་ལས་ཐེངས་ཆ་མཉམ་སླར་འགོ་བཙུགས]' \
    '(-h --help)'{-h,--help}'[བརྡ་བཀོད་ཀྱི་དོན་ལུ་རོགས་རམ་སྟོན]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[worktree གི་push མ་འབད་བའི་commit ཚུ་དང་commit མ་འབད་བའི་བསྒྱུར་བཅོས་ཚུ་ཡང་བཏོན་བཀོག (ཧེ་མའི་claude rm གིས་སྙན་ཞུ་འབད་མི་commit@worktree-id སྤྲོད)]:commit@worktree-id:' \
    '--force-remove-worktree[WorktreeRemove hook ཡང་ན་git གིས་རྩ་བསྐྲད་གཏང་མ་ཚུགས་རུང་worktree ཡིག་སྣོད་བཏོན་གཏང (ཧེ་མའི་claude rm གིས་སྙན་ཞུ་འབད་མི་worktree-id སྤྲོད)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[བརྡ་བཀོད་ཀྱི་དོན་ལུ་རོགས་རམ་སྟོན]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[ག་ནི་ཡང་མ་བྲིས་བར་ནང་འདྲེན་འབད་ནི་ཡོད་མི་ཚུ་སྟོན]' \
    '--yes[ཕན་ཚུན་འབྲེལ་ལམ་སེལ་འཐུ་པ་ཟུར་བཤོལ (headless ཁ་ཐོག་ཚུ་གུ་ /import སྔོན་ལྟ་ནང་ལས་ --yes=<digest> སྤྲོད)]' \
    '(-h --help)'{-h,--help}'[བརྡ་བཀོད་ཀྱི་དོན་ལུ་རོགས་རམ་སྟོན]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
