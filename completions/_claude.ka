#compdef claude

# Dynamic completion functions

# Directories Claude Code keeps its state in (agents, plugins, sessions).
# CLAUDE_CONFIG_DIR replaces the default location when it is set.
_claude_state_dirs() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -r -- "$CLAUDE_CONFIG_DIR"
  else
    print -l -- "$HOME/.claude" "$HOME/.config/claude"
  fi
}

# JSON files that may hold MCP server definitions.
_claude_config_files() {
  if [[ -n "$CLAUDE_CONFIG_DIR" ]]; then
    print -l -- "$CLAUDE_CONFIG_DIR/.claude.json" "$CLAUDE_CONFIG_DIR/mcp.json"
  else
    print -l -- "$HOME/.claude.json" "$HOME/.claude/mcp.json" "$HOME/.config/claude/mcp.json"
  fi
}

_claude_mcp_servers() {
  local config_file
  local -a server_list

  # Parse config files using grep/sed (no external dependencies)
  for config_file in ${(f)"$(_claude_config_files)"}; do
    [[ -f "$config_file" ]] || continue
    # Find entries with "command", "type", or "url" (MCP server signature)
    server_list+=(${(f)"$(grep -B 1 -E '"(command|type|url)"[[:space:]]*:' "$config_file" 2>/dev/null | \
      grep -E '"[^"]+": \{' | sed 's/.*"\([^"]*\)".*/\1/' | grep -v '/')"})
  done
  server_list=(${(u)server_list})

  # Fallback to claude mcp list
  if [[ ${#server_list[@]} -eq 0 ]]; then
    server_list=(${(f)"$(claude mcp list 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p' | grep -v '^Checking')"})
  fi

  compadd -a server_list
}

_claude_installed_plugins() {
  local -a plugins
  local state_dir manifest

  # Installed plugins are "name@marketplace" keys in
  # plugins/installed_plugins.json - the directories beside it are caches.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    manifest="$state_dir/plugins/installed_plugins.json"
    [[ -f "$manifest" ]] || continue
    plugins+=(${(f)"$(grep -oE '"[^"]+@[^"]+"[[:space:]]*:' "$manifest" 2>/dev/null | \
      sed 's/[[:space:]]*:$//; s/"//g')"})
  done

  plugins=(${(u)plugins})

  compadd -a plugins
}

_claude_sessions() {
  setopt localoptions extendedglob

  local -a sessions project_dirs
  local state_dir project_dir cwd session_file uuid summary

  # Sessions live under <config>/projects/<cwd with / and . turned into ->.
  # A symlinked working directory is recorded under its resolved path, so
  # try that as well as the one the shell reports.
  for cwd in "$PWD" "${PWD:A}"; do
    project_dirs+=(${${cwd//\//-}//./-})
  done
  project_dirs=(${(u)project_dirs})

  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    for project_dir in $project_dirs; do
      [[ -d "$state_dir/projects/$project_dir" ]] || continue

      # Newest first, capped so completion stays instant on long-lived projects
      for session_file in ${state_dir}/projects/${project_dir}/*.jsonl(Nom[1,20]); do
        uuid=${session_file:t:r}
        [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || continue

        # Describe each session with the first thing you typed in it. Only the
        # head of the transcript is read - these files grow into the megabytes.
        summary=$(head -c 200000 "$session_file" 2>/dev/null | \
          grep -m 1 -o '"role":"user","content":"[^"]\{1,60\}' 2>/dev/null | \
          sed 's/.*"content":"//; s/\\n/ /g; s/\\*$//')
        sessions+=("${uuid}:${summary:-no description}")
      done
    done
  done

  _describe -t sessions 'session' sessions
}

_claude_agent_names() {
  local -a agents agent_dirs
  local state_dir agent_dir agent_file name

  # User-level and project-level agent definitions
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    agent_dirs+=("$state_dir/agents")
  done
  agent_dirs+=(.claude/agents)

  for agent_dir in $agent_dirs; do
    [[ -d "$agent_dir" ]] || continue

    for agent_file in ${agent_dir}/*.md(N); do
      # Prefer the name declared in the front matter, fall back to the filename
      name=$(sed -n '1,10{s/^name:[[:space:]]*\([^[:space:]]*\).*/\1/p;}' "$agent_file" 2>/dev/null | head -1)
      agents+=(${name:-${agent_file:t:r}})
    done
  done

  agents=(${(u)agents})

  compadd -a agents
}

_claude_background_sessions() {
  local -a sessions state_files
  local -A names states
  local state_dir state_file line id rest

  # Background sessions (`claude --bg`) live in <config>/jobs/<id>/, where
  # <id> is the short id that attach, logs, stop, respawn and rm take.
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    # Newest first
    state_files=(${state_dir}/jobs/*/state.json(Nom))
    (( ${#state_files} )) || continue

    # One grep for all of them; the first "name" and "state" it reports for a
    # file are that file's top-level ones
    names=() states=()
    for line in ${(f)"$(grep -HoE '"(name|state)"[[:space:]]*:[[:space:]]*"[^"]*"' $state_files 2>/dev/null)"}; do
      id=${${line%%/state.json:*}:t}
      rest=${line#*/state.json:}
      case $rest in
        \"name\"*)  [[ -z $names[$id] ]]  && names[$id]=${${rest#*:*\"}%\"} ;;
        \"state\"*) [[ -z $states[$id] ]] && states[$id]=${${rest#*:*\"}%\"} ;;
      esac
    done

    for state_file in $state_files; do
      id=${state_file:h:t}
      sessions+=("${id}:${names[$id]:-no name}${states[$id]:+ (${states[$id]})}")
    done
  done

  _describe -t sessions 'background session' sessions
}

_claude_model_names() {
  local -a models config_files
  local state_dir config_file

  # Aliases always resolve to the latest model of that family
  models=(default fable opus sonnet haiku)

  # Full model names the user has already configured
  for state_dir in ${(f)"$(_claude_state_dirs)"}; do
    config_files+=("$state_dir/settings.json" "$state_dir/settings.local.json")
  done
  config_files+=(${(f)"$(_claude_config_files)"})

  for config_file in $config_files; do
    [[ -f "$config_file" ]] || continue
    models+=(${(f)"$(grep -oE '"(model|fallbackModel)"[[:space:]]*:[[:space:]]*"[^"]+"' "$config_file" 2>/dev/null | \
      sed 's/.*:[[:space:]]*"\([^"]*\)"/\1/')"})
  done

  # Remove duplicates
  models=(${(u)models})

  compadd -a models
}

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a main_commands
  main_commands=(
    'mcp:MCP სერვერების კონფიგურაცია და მართვა'
    'plugin:Claude Code დამატებების მართვა'
    'agents:ფონური აგენტების მართვა'
    'attach:ფონური სესიის გახსნა ამ ტერმინალში'
    'logs:ფონური სესიის ბოლო ტერმინალური გამოტანის დაბეჭდვა'
    'stop:ფონური სესიის შეჩერება (მისი საუბარი ინახება)'
    'respawn:ფონური სესიის გადატვირთვა, რათა გაეშვას Claude Code-ის მიმდინარე ვერსია'
    'rm:ფონური სესიის და, როცა ეს უსაფრთხოა, მისი worktree-ის წაშლა'
    'auth:ავთენტიფიკაციის მართვა'
    'auto-mode:ავტო რეჟიმის კლასიფიკატორის კონფიგურაციის დათვალიერება ან გადატვირთვა'
    'gateway:საწარმოო ავთენტიფიკაცია/ტელემეტრიის gateway-ის გაშვება'
    'import:კონფიგურაციის იმპორტი სხვა AI კოდირების აგენტიდან Claude Code-ში'
    'project:Claude Code პროექტის მდგომარეობის მართვა'
    'ultrareview:ღრუბელზე მასპინძლებული მრავალაგენტიანი კოდის მიმოხილვის გაშვება და შედეგების დაბეჭდვა'
    'setup-token:გრძელვადიანი ავთენტიფიკაციის ტოკენის დაყენება (საჭიროებს Claude გამოწერას)'
    'doctor:Claude Code ავტომატური განახლების ჯანმრთელობის შემოწმება'
    'update:განახლებების შემოწმება და ინსტალაცია'
    'install:Claude Code ნატიურ ბილდის ინსტალაცია'
  )

  local -a main_options
  main_options=(
    '(-d --debug)'{-d,--debug}'[დებაგ რეჟიმის ჩართვა კატეგორიების ფილტრაციით (მაგ., "api,hooks" ან "!statsig,!file")]:filter:'
    '--verbose[ვერბოზ რეჟიმის პარამეტრის გადაფარვა კონფიგურაციის ფაილიდან]'
    '(-p --print)'{-p,--print}'[პასუხის დაბეჭდვა და გასვლა (pipe-ებთან გამოსაყენებლად). შენიშვნა: გამოიყენეთ მხოლოდ სანდო დირექტორიებში]'
    '--output-format[გამოტანის ფორმატი (--print-თან): "text" (ნაგულისხმევი), "json" (ცალკე შედეგი), ან "stream-json" (რეალურ დროში სტრიმინგი)]:format:(text json stream-json)'
    '--json-schema[JSON სქემა სტრუქტურირებული გამოტანის ვალიდაციისთვის]:schema:'
    '--include-partial-messages[ნაწილობრივი შეტყობინებების ჩართვა (--print და --output-format=stream-json-თან)]'
    '--input-format[შეტანის ფორმატი (--print-თან): "text" (ნაგულისხმევი) ან "stream-json" (რეალურ დროში სტრიმინგი)]:format:(text stream-json)'
    '--mcp-debug[\[მოძველებული. გამოიყენეთ --debug\] MCP დებაგ რეჟიმის ჩართვა (აჩვენებს MCP სერვერის შეცდომებს)]'
    '--dangerously-skip-permissions[ყველა ნებართვის შემოწმების გვერდის ავლა. რეკომენდებულია მხოლოდ ინტერნეტის გარეშე sandbox გარემოებისთვის]'
    '--allow-dangerously-skip-permissions[ნებართვის შემოწმების გვერდის ავლის ოფციის ჩართვა ნაგულისხმევად გააქტიურების გარეშე]'
    '--restricted[შეზღუდული რეჟიმი: ბრძანებების ან კოდის გამშვები ინსტრუმენტებისა და WebFetch-ის მოშორება, user/project/local პარამეტრების იგნორირება და ფაილის ინსტრუმენტების სამუშაო დირექტორიებით შემოფარგვლა]'
    '--max-budget-usd[მაქსიმალური დოლარის ოდენობა API გამოძახებებზე დასახარჯად (მხოლოდ --print)]:amount:'
    '--replay-user-messages[მომხმარებლის შეტყობინებების ხელახალი გაგზავნა stdin-დან stdout-ზე დასადასტურებლად]'
    '--allowed-tools[მძიმით ან სივრცით გამოყოფილი დაშვებული ინსტრუმენტების სია (მაგ., "Bash(git:*) Edit")]:tools:'
    '--allowedTools[მძიმით ან სივრცით გამოყოფილი დაშვებული ინსტრუმენტების სია (camelCase ფორმატი)]:tools:'
    '--tools[ხელმისაწვდომი ინსტრუმენტების სიის მითითება ჩაშენებული ნაკრებიდან. მხოლოდ print რეჟიმი]:tools:'
    '--disallowed-tools[მძიმით ან სივრცით გამოყოფილი აკრძალული ინსტრუმენტების სია (მაგ., "Bash(git:*) Edit")]:tools:'
    '--disallowedTools[მძიმით ან სივრცით გამოყოფილი აკრძალული ინსტრუმენტების სია (camelCase ფორმატი)]:tools:'
    '--mcp-config[MCP სერვერების ჩატვირთვა JSON ფაილიდან ან სტრიქონიდან (სივრცით გამოყოფილი)]:configs:'
    '--system-prompt[სისტემური prompt სესიისთვის]:prompt:'
    '--system-prompt-file[სისტემური prompt-ის წაკითხვა ფაილიდან]:file:_files'
    '--append-system-prompt[სისტემური prompt-ის დართვა ნაგულისხმევ სისტემურ prompt-ზე]:prompt:'
    '--append-system-prompt-file[სისტემური prompt-ის წაკითხვა ფაილიდან და დართვა ნაგულისხმევ სისტემურ prompt-ზე]:file:_files'
    '--system-prompt-snapshot[სისტემური prompt-ის ჩაწერა ერთხელ თითო საუბარზე და მისი სიტყვასიტყვით ხელახალი გამოყენება ყოველ მოთხოვნასა და განახლებაზე (on, ნაგულისხმევი) ან მისი თავიდან რენდერი ყოველ მოთხოვნაზე (off)]:mode:(on off)'
    '--permission-mode[ნებართვის რეჟიმი სესიისთვის]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts[ვინ პასუხობს ნებართვის მოთხოვნებს --print-თან: "host" (SDK ჰოსტი ან --permission-prompt-tool) ან "none" (ყველაფერი, რაც მოთხოვნას გამოიწვევდა, უარყოფილია)]:target:(host none)'
    '--permission-prompt-tool[MCP ინსტრუმენტი ნებართვის მოთხოვნებისთვის (მხოლოდ --print)]:tool:'
    '(-c --continue)'{-c,--continue}'[ბოლო საუბრის გაგრძელება]'
    '(-r --resume)'{-r,--resume}'[საუბრის განახლება - მიუთითეთ სესიის ID ან აირჩიეთ ინტერაქტიულად]:sessionId:_claude_sessions'
    '--fork-session[ახალი სესიის ID-ის შექმნა ორიგინალის ხელახლა გამოყენების ნაცვლად (--resume ან --continue-თან)]'
    '--no-session-persistence[სესიის შენახვის გამორთვა - სესიები არ შეინახება (მხოლოდ --print)]'
    '--model[მოდელი მიმდინარე სესიისთვის. მიუთითეთ ალიასი უახლესი მოდელისთვის (მაგ., '\''sonnet'\'' ან '\''opus'\'')]:model:_claude_model_names'
    '--agent[აგენტი მიმდინარე სესიისთვის. გადაფარავს '\''agent'\'' პარამეტრს]:agent:_claude_agent_names'
    '--betas[ბეტა header-ები API მოთხოვნებში ჩასართავად (მხოლოდ API გასაღების მომხმარებლებისთვის)]:betas:'
    '--fallback-model[ავტომატური გადასვლის ჩართვა მითითებულ მოდელზე როცა ნაგულისხმევი მოდელი გადატვირთულია (მხოლოდ --print)]:model:_claude_model_names'
    '--settings[პარამეტრების JSON ფაილის ან JSON სტრიქონის გზა დამატებითი პარამეტრების ჩასატვირთად]:file-or-json:_files'
    '--add-dir[დამატებითი დირექტორიები ინსტრუმენტების წვდომისთვის]:directories:_directories'
    '--ide[ავტომატური დაკავშირება IDE-სთან გაშვებისას თუ ხელმისაწვდომია ზუსტად ერთი ვალიდური IDE]'
    '--desktop[გახსნა Claude Desktop აპში ტერმინალის ნაცვლად (--continue-თან ან --resume <id>-თან სესიის ასარჩევად)]'
    '--strict-mcp-config[გამოიყენეთ მხოლოდ MCP სერვერები --mcp-config-დან და იგნორირება სხვა MCP პარამეტრების]'
    '--session-id[სპეციფიკური სესიის ID საუბრისთვის (უნდა იყოს ვალიდური UUID)]:uuid:'
    '--agents[JSON ობიექტი რომელიც განსაზღვრავს მორგებულ აგენტებს]:json:'
    '--setting-sources[მძიმით გამოყოფილი პარამეტრების წყაროების სია ჩასატვირთად (user, project, local)]:sources:'
    '--plugin-dir[დირექტორია დამატებების ჩასატვირთად მხოლოდ ამ სესიისთვის (განმეორებადი)]:paths:_directories'
    '--disable-slash-commands[ყველა slash ბრძანების გამორთვა]'
    '(--bg --background)'{--bg,--background}'[სესიის გაშვება ფონურ აგენტად და დაუყოვნებლივ დაბრუნება]'
    '(-w --worktree)'{-w,--worktree}'[ახალი git worktree-ის შექმნა ამ სესიისთვის (სურვილისამებრ მიუთითეთ სახელი)]::name:'
    '--tmux=-[tmux სესიის შექმნა worktree-სთვის (საჭიროებს --worktree). იყენებს iTerm2-ის ნატიურ პანელებს, თუ ხელმისაწვდომია; --tmux=classic ტრადიციული tmux-ისთვის]::mode:(classic)'
    '(-n --name)'{-n,--name}'[ამ სესიისთვის საჩვენებელი სახელის დაყენება]:name:'
    '--effort[ძალისხმევის დონე მიმდინარე სესიისთვის]:level:(low medium high xhigh max)'
    '--autocompact[ავტო-შეკუმშვის ფანჯრის ზომა (auto, ან 100k-1M ტოკენი)]:size:(auto)'
    '--debug-file[დებაგ ლოგების ჩაწერა კონკრეტულ ფაილში (ავტომატურად რთავს დებაგ რეჟიმს)]:path:_files'
    '--from-pr[PR-თან დაკავშირებული სესიის განახლება ნომრით/URL-ით, ან ინტერაქტიული ამრჩევის გახსნა]::value:'
    '--teleport[teleport სესიის განახლება, სურვილისამებრ მიუთითეთ სესიის ID]::session:'
    '--cloud[ღრუბლოვანი სესიის შექმნა მოცემული აღწერით, ან არსებულთან მიერთება სესიის ID-ით ან claude.ai/code URL-ით]::description-or-session:'
    '--environment[ახალი ღრუბლოვანი სესიის შექმნა, რომელიც მუშაობს მოცემულ თვითმასპინძლობის გარემოზე (ccpool_...)]:environment_id:'
    '--remote-control[ინტერაქტიული სესიის დაწყება ჩართული Remote Control-ით (სურვილისამებრ დასახელებული)]::name:'
    '--remote-control-session-name-prefix[პრეფიქსი ავტომატურად გენერირებული Remote Control სესიის სახელებისთვის]:prefix:'
    '--chrome[Claude in Chrome ინტეგრაციის ჩართვა]'
    '--no-chrome[Claude in Chrome ინტეგრაციის გამორთვა]'
    '--plugin-url[დამატების .zip-ის მოტანა URL-დან მხოლოდ ამ სესიისთვის (განმეორებადი)]:url:'
    '--file[ფაილის რესურსები გაშვებისას ჩამოსატვირთად (ფორმატი: file_id:relative_path)]:specs:'
    '--prompt-suggestions[prompt-ის შემოთავაზებების ჩართვა (გამოსცემს პროგნოზირებულ შემდეგ prompt-ს print/SDK რეჟიმში)]::value:(true false 1 0 yes no on off)'
    '--forward-subagent-text[ქვეაგენტის ტექსტისა და ფიქრის ბლოკების გადაგზავნა შეტყობინებებად (--print და stream-json-თან)]'
    '--include-hook-events[ყველა hook სასიცოცხლო ციკლის მოვლენის ჩართვა გამოტანის სტრიმში (stream-json-თან)]'
    '--exclude-dynamic-system-prompt-sections[თითოეული მანქანის სექციების გადატანა პირველ მომხმარებლის შეტყობინებაში prompt-cache-ის ხელახალი გამოყენების გასაუმჯობესებლად]'
    '--brief[SendUserMessage ინსტრუმენტის ჩართვა აგენტი-მომხმარებელი კომუნიკაციისთვის]'
    '--safe-mode[გაშვება ყველა მორგების გამორთვით (სასარგებლოა გატეხილი კონფიგურაციის პრობლემების მოსაგვარებლად)]'
    '--bare[მინიმალური რეჟიმი: hooks-ის, LSP-ის, დამატებების სინქრონიზაციის, ატრიბუციის, ავტო-მეხსიერების და CLAUDE.md ავტო-აღმოჩენის გამოტოვება]'
    '--ax-screen-reader[ეკრანის წამკითხველისთვის მოსახერხებელი გამოტანის რენდერი (ბრტყელი ტექსტი, დეკორატიული ჩარჩოებისა და ანიმაციების გარეშე)]'
    '(-v --version)'{-v,--version}'[ვერსიის ნომრის გამოტანა]'
    '(-h --help)'{-h,--help}'[ბრძანების დახმარების ჩვენება]'
  )

  _arguments -C \
    $main_options \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'claude commands' main_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _claude_mcp
          ;;
        plugin)
          _claude_plugin
          ;;
        install)
          _claude_install
          ;;
        agents)
          _claude_agents
          ;;
        attach|logs|stop|kill)
          _arguments \
            '(-h --help)'{-h,--help}'[ბრძანების დახმარების ჩვენება]' \
            '1:session:_claude_background_sessions'
          ;;
        respawn)
          _claude_respawn
          ;;
        rm)
          _claude_rm
          ;;
        auth)
          _claude_auth
          ;;
        auto-mode)
          _claude_auto_mode
          ;;
        gateway)
          _claude_gateway
          ;;
        import)
          _claude_import
          ;;
        project)
          _claude_project
          ;;
        ultrareview)
          _claude_ultrareview
          ;;
        setup-token|doctor|update)
          _message "არგუმენტების გარეშე"
          ;;
      esac
      ;;
  esac
}

_claude_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'serve:Claude Code MCP სერვერის გაშვება'
    'add:MCP სერვერის დამატება Claude Code-ში'
    'remove:MCP სერვერის წაშლა'
    'list:კონფიგურირებული MCP სერვერების სია'
    'get:MCP სერვერის დეტალების მიღება'
    'add-json:MCP სერვერის დამატება (stdio ან SSE) JSON სტრიქონით'
    'add-from-claude-desktop:MCP სერვერების იმპორტი Claude Desktop-დან (მხოლოდ Mac და WSL)'
    'reset-project-choices:პროექტის დონის (.mcp.json) ყველა დამტკიცებული/უარყოფილი სერვერის გადატვირთვა ამ პროექტში'
    'login:ავთენტიფიკაცია MCP სერვერთან (HTTP, SSE, ან claude.ai კონექტორი)'
    'logout:MCP სერვერისთვის შენახული OAuth მონაცემების გასუფთავება'
    'help:დახმარების ჩვენება'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'mcp commands' mcp_commands
      ;;
    args)
      case $words[1] in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[დებაგ რეჟიმის ჩართვა]' \
            '--verbose[ვერბოზ რეჟიმის პარამეტრის გადაფარვა კონფიგურაციის ფაილიდან]' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]'
          ;;
        add)
          _arguments \
            '(-s --scope)'{-s,--scope}'[კონფიგურაციის არეალი (local, user, project)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[ტრანსპორტის ტიპი (stdio, sse, http)]:transport:(stdio sse http)' \
            '(-e --env)'{-e,--env}'[გარემოს ცვლადის დაყენება (მაგ., -e KEY=value)]:env:' \
            '(-H --header)'{-H,--header}'[WebSocket header-ის დაყენება]:header:' \
            '--client-id[OAuth კლიენტის ID HTTP/SSE სერვერებისთვის]:clientId:' \
            '--client-secret[OAuth კლიენტის საიდუმლოს მოთხოვნა (ან დააყენეთ MCP_CLIENT_SECRET გარემოს ცვლადი)]' \
            '--callback-port[ფიქსირებული პორტი OAuth callback-ისთვის (სერვერებისთვის, რომლებიც წინასწარ რეგისტრირებულ გადამისამართების URI-ებს საჭიროებენ)]:port:' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '1:name:' \
            '2:commandOrUrl:' \
            '*:args:'
          ;;
        remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[კონფიგურაციის არეალი (local, user, project) - არსებული არეალიდან წაშლა თუ არ არის მითითებული]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '1:name:_claude_mcp_servers'
          ;;
        list)
          _arguments \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '1:name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[კონფიგურაციის არეალი (local, user, project)]:scope:(local user project)' \
            '--client-secret[OAuth კლიენტის საიდუმლოს მოთხოვნა (ან დააყენეთ MCP_CLIENT_SECRET გარემოს ცვლადი)]' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '1:name:' \
            '2:json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-s --scope)'{-s,--scope}'[კონფიგურაციის არეალი (local, user, project)]:scope:(local user project)' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]'
          ;;
        reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]'
          ;;
        login)
          _arguments \
            '--no-browser[ავტორიზაციის URL-ის დაბეჭდვა ბრაუზერის გახსნის ნაცვლად (SSH/headless სესიებისთვის)]' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '1:name:_claude_mcp_servers'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '1:name:_claude_mcp_servers'
          ;;
      esac
      ;;
  esac
}

_claude_plugin() {
  local -a plugin_commands
  plugin_commands=(
    'validate:დამატების ან marketplace მანიფესტის ვალიდაცია'
    'marketplace:Claude Code marketplace-ების მართვა'
    'list:დაინსტალირებული დამატებების სია'
    'details:დამატების კომპონენტების ინვენტარისა და პროგნოზირებული ტოკენების ღირებულების ჩვენება'
    'configure:დამატების პარამეტრებისა და დაუყენებელი პარამეტრების ჩვენება, ან მნიშვნელობების შენახვა stdin-დან'
    'install:დამატების ინსტალაცია ხელმისაწვდომი marketplace-ებიდან'
    'i:დამატების ინსტალაცია ხელმისაწვდომი marketplace-ებიდან (install-ის შემოკლება)'
    'init:ახალი დამატების ჩარჩოს შექმნა (ავტომატურად იტვირთება შემდეგ სესიაზე)'
    'new:ახალი დამატების ჩარჩოს შექმნა (init-ის ალიასი)'
    'uninstall:დაინსტალირებული დამატების წაშლა'
    'remove:დაინსტალირებული დამატების წაშლა (uninstall-ის ალიასი)'
    'enable:გამორთული დამატების ჩართვა'
    'disable:ჩართული დამატების გამორთვა'
    'update:დამატების განახლება უახლეს ვერსიამდე'
    'eval:eval შემთხვევების გაშვება დამატებაზე და შეფასებული შედეგების მოხსენება'
    'prune:ავტომატურად დაინსტალირებული აღარ საჭირო დამოკიდებულებების წაშლა'
    'autoremove:ავტომატურად დაინსტალირებული აღარ საჭირო დამოკიდებულებების წაშლა (prune-ის ალიასი)'
    'tag:{name}--v{version} git ტეგის შექმნა დამატების რელიზისთვის'
    'test:mod-ის ტესტების გაშვება'
    'help:დახმარების ჩვენება'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'plugin commands' plugin_commands
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--strict[გაფრთხილებების შეცდომებად მიჩნევა (გასვლის კოდი 1)]' \
            '--json[ვალიდაციის ანგარიშის გამოტანა JSON-ად (იგივე გასვლის კოდები)]' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '1:path:_files'
          ;;
        marketplace)
          _claude_plugin_marketplace
          ;;
        install|i)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ინსტალაციის არეალი]:scope:(user project local)' \
            '*--config[დამატების მანიფესტში გამოცხადებული userConfig პარამეტრის დაყენება (განმეორებადი)]:key=value:' \
            '(-y --yes)'{-y,--yes}'[ნაჩვენები, marketplace-ის მიერ გამოცხადებული ბრძანების მიღება დადასტურების მოთხოვნის გარეშე]' \
            '--json[ერთი მანქანით წაკითხვადი შედეგის სტრიქონის დაბეჭდვა ადამიანისთვის განკუთვნილი შეტყობინების ნაცვლად]' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '1:plugin:'
          ;;
        uninstall|remove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ინსტალაციის არეალი]:scope:(user project local)' \
            '--keep-data[დამატების მუდმივი მონაცემების დირექტორიის შენარჩუნება]' \
            '--prune[ასევე ავტომატურად დაინსტალირებული აღარ საჭირო დამოკიდებულებების წაშლა]' \
            '(-y --yes)'{-y,--yes}'[--prune-ის დადასტურების მოთხოვნის გამოტოვება]' \
            '--json[ერთი მანქანით წაკითხვადი შედეგის სტრიქონის დაბეჭდვა ადამიანისთვის განკუთვნილი შეტყობინების ნაცვლად (არა --prune-თან)]' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        enable)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ინსტალაციის არეალი]:scope:(user project local)' \
            '--json[ერთი მანქანით წაკითხვადი შედეგის სტრიქონის დაბეჭდვა ადამიანისთვის განკუთვნილი შეტყობინების ნაცვლად]' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all)'{-a,--all}'[ყველა ჩართული დამატების გამორთვა]' \
            '(-s --scope)'{-s,--scope}'[ინსტალაციის არეალი]:scope:(user project local)' \
            '--json[ერთი მანქანით წაკითხვადი შედეგის სტრიქონის დაბეჭდვა ადამიანისთვის განკუთვნილი შეტყობინების ნაცვლად]' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '::plugin:_claude_installed_plugins'
          ;;
        update)
          _arguments \
            '(-s --scope)'{-s,--scope}'[ინსტალაციის არეალი]:scope:(user project local managed)' \
            '(-y --yes)'{-y,--yes}'[ნაჩვენები, marketplace-ის მიერ გამოცხადებული ბრძანების მიღება დადასტურების მოთხოვნის გარეშე]' \
            '--json[ერთი მანქანით წაკითხვადი შედეგის სტრიქონის დაბეჭდვა ადამიანისთვის განკუთვნილი შეტყობინების ნაცვლად]' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        list)
          _arguments \
            '--json[გამოტანა JSON-ად]' \
            '--available[marketplace-ებიდან ხელმისაწვდომი დამატებების ჩართვა (საჭიროებს --json)]' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]'
          ;;
        prune|autoremove)
          _arguments \
            '(-s --scope)'{-s,--scope}'[გასუფთავება მითითებულ არეალში]:scope:(user project local)' \
            '--dry-run[იმის ჩამოთვლა, რაც წაიშლებოდა, წაშლის გარეშე]' \
            '(-y --yes)'{-y,--yes}'[დადასტურების მოთხოვნის გამოტოვება]' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]'
          ;;
        configure)
          _arguments \
            '--json[გამოტანა JSON-ად]' \
            '--values-stdin[პარამეტრების მნიშვნელობების წაკითხვა stdin-დან ერთსტრიქონიანი სტრიქონების JSON ობიექტად; გამოტოვებული პარამეტრები ინარჩუნებენ თავიანთ მნიშვნელობებს]' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '1:plugin:_claude_installed_plugins'
          ;;
        init|new)
          _arguments \
            '--description[მანიფესტის აღწერა]:text:' \
            '--author[ავტორის სახელი (ნაგულისხმევი: git config user.name)]:name:' \
            '--author-email[ავტორის ელფოსტა (ნაგულისხმევი: git config user.email)]:email:' \
            '--with[კომპონენტები, რომელთა ჩარჩოც ასევე შეიქმნება]:components:' \
            '(-f --force)'{-f,--force}'[სამიზნეში არსებული .claude-plugin/-ის გადაწერა]' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '1:name:'
          ;;
        eval)
          _arguments \
            '--case[შემთხვევების ფილტრაცია სახელის glob-ით]:glob:' \
            '*--tag[შემთხვევების ფილტრაცია ტეგით (განმეორებადი)]:tag:' \
            '--runs[თითო შემთხვევის გაშვებების რაოდენობის გადაფარვა (ნაგულისხმევი: case.runs, სხვაგვარად 3)]:n:' \
            '(-j --concurrency)'{-j,--concurrency}'[აგენტის არაუმეტეს n გაშვების ერთდროულად შესრულება (1-8; ნაგულისხმევი 1)]:n:' \
            '--model[მოდელის გადაფარვა ყველა შემთხვევისთვის]:model:_claude_model_names' \
            '--judge-model[LLM-შემფასებლის მოდელის გადაფარვა (ნაგულისხმევი: haiku)]:model:_claude_model_names' \
            '--max-cost-usd[ხარჯის მკაცრი ზღვარი; მიღწევისას შეწყვეტა და ნაწილობრივი შედეგების მოხსენება (გასვლის კოდი 2)]:usd:' \
            '--output-dir[დირექტორია aggregate-result.json-ისთვის]:dir:_directories' \
            '--eval-dir[დირექტორიის სახელი (დამატების ქვეშ), რომელიც eval შემთხვევებს შეიცავს]:dir:' \
            '--json[გაშვების სრული შედეგის დაბეჭდვა JSON-ად stdout-ზე, ან მისი ჩაწერა ამ .json ფაილში]::path:_files' \
            '--threshold[გასვლა კოდით 1, თუ რომელიმე შემთხვევის ქულა ამ ზღვარზე დაბალია (ნაგულისხმევი: 1.0)]:threshold:' \
            '*--allow-tools[ოპერატორის ნებართვა შეზღუდული ინსტრუმენტებისთვის (Bash, Write, Edit, WebFetch, mcp__*)]:tools:' \
            '(--no-scaffold)--scaffold[თითოეული შემთხვევის scaffold_script-ის გაშვება (უშვებს ავტორის მიერ მოწოდებულ bash-ს თქვენი სახელით; ნაგულისხმევად გამორთულია)]' \
            '(--scaffold)--no-scaffold[scaffold_script-ის აშკარად გამოტოვება]' \
            '--trust-plugin[იმის დადასტურება, რომ ენდობით ამ დამატებას და მის eval ნაკრებს, პირველი გაშვების ნდობის მოთხოვნის გამოტოვებით (CI-სთვის)]' \
            '--ablation[დამატების გარეშე საბაზისო საკონტროლო ჯგუფის გაშვება და ქულების სხვაობის მოხსენება]:mode:(none with-without)' \
            '--mocks[MCP სერვერების mock შემცვლელები <eval dir>/mocks/-დან]:mode:(record off)' \
            '--allow-real-servers[--mocks record-თან: ასევე იმ რეალური MCP სერვერის პროცესების გაშვება, რომლებსაც mock არ აქვთ]' \
            '--keep-temp[scaffold დირექტორიების შენარჩუნება დებაგისთვის]' \
            '--verbose[თითო შეტყობინების trace მოვლენების ჩაწერა დებაგ ლოგში]' \
            '--report[თვითკმარი HTML ანგარიშის ჩაწერა ამ გზაზე შედეგების დირექტორიის ნაცვლად]:path:_files' \
            '(--no-publish)--publish-report[ასევე ანგარიშის claude.ai-ზე გამოქვეყნების მოთხოვნა]' \
            '(--publish-report)--no-publish[HTML ანგარიშის მხოლოდ ლოკალურად შენახვა; claude.ai-ზე გამოქვეყნების გამოტოვება]' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '::target: _alternative "plugins\:installed plugin\:_claude_installed_plugins" "files\:path\:_files"'
          ;;
        tag)
          _arguments \
            '--push[ტეგის push --remote-ზე მისი შექმნის შემდეგ]' \
            '--dry-run[იმის დაბეჭდვა, რაც მოინიშნებოდა ტეგით, მისი შექმნის გარეშე]' \
            '(-f --force)'{-f,--force}'[ბინძური სამუშაო ხისა და უკვე არსებული ტეგის შემოწმებების გამოტოვება]' \
            '(-m --message)'{-m,--message}'[ტეგის ანოტაციის შეტყობინება (გამოიყენეთ %s ვერსიისთვის)]:msg:' \
            '--remote[remote, რომელზეც --push-ით ხდება push]:name:' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '::dir:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_plugin_marketplace() {
  local -a marketplace_commands
  marketplace_commands=(
    'add:marketplace-ის დამატება URL-დან, გზიდან ან GitHub რეპოზიტორიიდან'
    'list:კონფიგურირებული marketplace-ების სია'
    'remove:კონფიგურირებული marketplace-ის წაშლა'
    'rm:კონფიგურირებული marketplace-ის წაშლა (remove-ის ალიასი)'
    'update:marketplace-ის განახლება წყაროდან - ყველას განახლება თუ სახელი არ არის მითითებული'
    'help:დახმარების ჩვენება'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'marketplace commands' marketplace_commands
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--sparse[checkout-ის შეზღუდვა კონკრეტული დირექტორიებით git sparse-checkout-ის მეშვეობით (მონორეპოებისთვის)]:paths:' \
            '--scope[სად გამოცხადდეს marketplace]:scope:(user project local)' \
            '--claudeai[ამ სახელის მქონე marketplace-ის დამატება, რომელსაც claude.ai თქვენთვის მასპინძლობს]' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '1:source:'
          ;;
        list)
          _arguments \
            '--json[გამოტანა JSON-ად]' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]'
          ;;
        remove|rm)
          _arguments \
            '--scope[marketplace-ის გამოცხადების წაშლა პარამეტრების კონკრეტული არეალიდან (გამოტოვეთ ყველა არეალიდან წასაშლელად)]:scope:(user project local)' \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '1:name:'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
            '::name:'
          ;;
      esac
      ;;
  esac
}

_claude_install() {
  _arguments \
    '--force[იძულებითი ინსტალაცია თუ უკვე დაინსტალირებულია]' \
    '(-h --help)'{-h,--help}'[დახმარების ჩვენება]' \
    '::target:(stable latest)'
}

_claude_agents() {
  _arguments \
    '*--add-dir[დამატებითი დირექტორია ინსტრუმენტების წვდომისთვის გაშვებულ სესიებში]:directory:_directories' \
    '--agent[ნაგულისხმევი აგენტი აგენტების ხედიდან გაშვებული სესიებისთვის]:agent:_claude_agent_names' \
    '--all[--json-თან: ასევე დასრულებული ფონური სესიების ჩართვა]' \
    '--allow-dangerously-skip-permissions[bypass-permissions რეჟიმის ხელმისაწვდომობა გაშვებული სესიებისთვის]' \
    '--cwd[მხოლოდ მითითებული გზის ქვეშ დაწყებული ფონური სესიების ჩვენება]:path:_directories' \
    '--dangerously-skip-permissions[--permission-mode bypassPermissions-ის ალიასი]' \
    '--effort[ნაგულისხმევი ძალისხმევის დონე გაშვებული სესიებისთვის]:level:(low medium high xhigh max)' \
    '--json[აქტიური სესიების დაბეჭდვა JSON მასივად და გასვლა]' \
    '*--mcp-config[MCP სერვერის კონფიგურაცია გაშვებულ სესიებზე გამოსაყენებლად]:config:' \
    '--model[ნაგულისხმევი მოდელი აგენტების ხედიდან გაშვებული სესიებისთვის]:model:_claude_model_names' \
    '--permission-mode[ნაგულისხმევი ნებართვის რეჟიმი გაშვებული სესიებისთვის]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
    '*--plugin-dir[დამატებების ჩატვირთვა დირექტორიიდან აგენტების ხედისა და გაშვებული სესიებისთვის]:path:_directories' \
    '--setting-sources[მძიმით გამოყოფილი პარამეტრების წყაროების სია ჩასატვირთად (user, project, local)]:sources:' \
    '--settings[პარამეტრების ფაილი ან JSON სტრიქონი გამოსაყენებლად]:file-or-json:_files' \
    '--strict-mcp-config[მხოლოდ --mcp-config-დან MCP სერვერების გამოყენება გაშვებულ სესიებში]' \
    '--restricted[გაშვებული სესიების დაწყება შეზღუდულ რეჟიმში]' \
    '(-h --help)'{-h,--help}'[ბრძანების დახმარების ჩვენება]'
}

_claude_auth() {
  local -a auth_commands
  auth_commands=(
    'login:თქვენს Anthropic ანგარიშში შესვლა'
    'logout:თქვენი Anthropic ანგარიშიდან გამოსვლა'
    'status:ავთენტიფიკაციის სტატუსის ჩვენება'
    'help:დახმარების ჩვენება'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ბრძანების დახმარების ჩვენება]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auth commands' auth_commands
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '--email[ელფოსტის მისამართის წინასწარ შევსება შესვლის გვერდზე]:email:' \
            '--sso[SSO შესვლის პროცესის იძულებითი გამოყენება]' \
            '(--claudeai)--console[Anthropic Console-ის გამოყენება (API გამოყენების ბილინგი) Claude გამოწერის ნაცვლად]' \
            '(--console)--claudeai[Claude გამოწერის გამოყენება (ნაგულისხმევი)]' \
            '(-h --help)'{-h,--help}'[ბრძანების დახმარების ჩვენება]'
          ;;
        status)
          _arguments \
            '(--text)--json[გამოტანა JSON-ად (ნაგულისხმევი)]' \
            '(--json)--text[გამოტანა ადამიანისთვის წაკითხვად ტექსტად]' \
            '(-h --help)'{-h,--help}'[ბრძანების დახმარების ჩვენება]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[ბრძანების დახმარების ჩვენება]'
          ;;
      esac
      ;;
  esac
}

_claude_auto_mode() {
  local -a auto_mode_commands
  auto_mode_commands=(
    'config:მოქმედი ავტო რეჟიმის კონფიგურაციის დაბეჭდვა JSON-ად'
    'critique:AI უკუკავშირის მიღება თქვენს მორგებულ ავტო რეჟიმის წესებზე'
    'defaults:ნაგულისხმევი ავტო რეჟიმის წესების დაბეჭდვა JSON-ად'
    'reset:ავტო რეჟიმის კონფიგურაციის გადატვირთვა ქარხნულ ნაგულისხმევ პარამეტრებზე'
    'help:დახმარების ჩვენება'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ბრძანების დახმარების ჩვენება]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'auto-mode commands' auto_mode_commands
      ;;
    args)
      case $words[1] in
        critique)
          _arguments \
            '--model[გამოსაყენებელი მოდელის გადაფარვა]:model:_claude_model_names' \
            '(-h --help)'{-h,--help}'[ბრძანების დახმარების ჩვენება]'
          ;;
        defaults)
          _arguments \
            '--label[მხოლოდ იმ წესების ჩვენება, რომელთა ლეიბლი ამ პრეფიქსით იწყება (რეგისტრის გაუთვალისწინებლად)]:prefix:' \
            '(-h --help)'{-h,--help}'[ბრძანების დახმარების ჩვენება]'
          ;;
        reset)
          _arguments \
            '(-y --yes)'{-y,--yes}'[დადასტურების მოთხოვნის გამოტოვება]' \
            '(-h --help)'{-h,--help}'[ბრძანების დახმარების ჩვენება]'
          ;;
        config)
          _arguments \
            '(-h --help)'{-h,--help}'[ბრძანების დახმარების ჩვენება]'
          ;;
      esac
      ;;
  esac
}

_claude_gateway() {
  _arguments \
    '--config[gateway YAML კონფიგურაციის გზა]:path:_files' \
    '(-h --help)'{-h,--help}'[ბრძანების დახმარების ჩვენება]'
}

_claude_project() {
  local -a project_commands
  project_commands=(
    'purge:პროექტის მთელი Claude Code მდგომარეობის წაშლა (ტრანსკრიპტები, დავალებები, ფაილების ისტორია, კონფიგურაციის ჩანაწერი)'
    'help:დახმარების ჩვენება'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[ბრძანების დახმარების ჩვენება]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'project commands' project_commands
      ;;
    args)
      case $words[1] in
        purge)
          _arguments \
            '--dry-run[იმის ჩამოთვლა, რაც წაიშლებოდა, არაფრის წაშლის გარეშე]' \
            '(-y --yes)'{-y,--yes}'[დადასტურების მოთხოვნის გამოტოვება]' \
            '(-i --interactive)'{-i,--interactive}'[დადასტურების მოთხოვნა თითოეულ ელემენტზე წაშლამდე]' \
            '(1)--all[მდგომარეობის წაშლა ყველა პროექტისთვის (ურთიერთგამომრიცხავია გზასთან)]' \
            '(-h --help)'{-h,--help}'[ბრძანების დახმარების ჩვენება]' \
            '(--all)::path:_directories'
          ;;
      esac
      ;;
  esac
}

_claude_ultrareview() {
  _arguments \
    '--json[დაუმუშავებელი bugs.json payload-ის დაბეჭდვა ფორმატირებული შედეგების ნაცვლად]' \
    '--timeout[მაქსიმალური წუთები მიმოხილვის დასრულებამდე მოსაცდელად (ნაგულისხმევი: 45)]:minutes:' \
    '(--no-post)--post[დასრულებული მიმოხილვის მიგნებების გამოქვეყნება PR-ში თქვენი სახელით (მხოლოდ PR სამიზნეებისთვის; ერთი ჩვეულებრივი კომენტარი, არა მიმოხილვა)]' \
    '(--post)--no-post[მიგნებების PR-ში არგამოქვეყნება (ნაგულისხმევი)]' \
    '(-h --help)'{-h,--help}'[ბრძანების დახმარების ჩვენება]' \
    '1:target:'
}

_claude_respawn() {
  _arguments \
    '(1)--all[ყველა მომუშავე ფონური სესიის გადატვირთვა]' \
    '(-h --help)'{-h,--help}'[ბრძანების დახმარების ჩვენება]' \
    '(--all)::session:_claude_background_sessions'
}

_claude_rm() {
  _arguments \
    '--discard-unpushed[ასევე worktree-ის push-ის გარეშე დარჩენილი commit-ებისა და დაუ-commit-ებელი ცვლილებების გაუქმება (გადაეცით commit@worktree-id, რომელიც წინა claude rm-მა მოგახსენათ)]:commit@worktree-id:' \
    '--force-remove-worktree[worktree-ის დირექტორიის წაშლა მაშინაც, როცა WorktreeRemove hook-მა ან git-მა ვერ წაშალა (გადაეცით worktree-id, რომელიც წინა claude rm-მა მოგახსენათ)]:worktree-id:' \
    '(-h --help)'{-h,--help}'[ბრძანების დახმარების ჩვენება]' \
    '1:session:_claude_background_sessions'
}

_claude_import() {
  _arguments \
    '--dry-run[იმის ჩვენება, რაც დაიმპორტდებოდა, არაფრის ჩაწერის გარეშე]' \
    '--yes[ინტერაქტიული ამრჩევის გამოტოვება (headless გარემოებში გადაეცით --yes=<digest> /import-ის გადახედვიდან)]' \
    '(-h --help)'{-h,--help}'[ბრძანების დახმარების ჩვენება]' \
    '::source:(codex gemini cursor)'
}

(( $+_comps[claude] )) || compdef _claude claude
